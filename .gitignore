# Firma de Android. El keystore de release y sus contrasenas NUNCA se comitean:
# quien tenga el .jks + password puede publicar actualizaciones que Android
# acepta como legitimas. En CI entra por secreto (ANDROID_KEYSTORE_BASE64).
*.jks
*.keystore
android/key.properties

