#!/bin/sh
# Puerta de formato local, espejo exacto de .github/workflows/ci.yml:34
# ("Check formatting"). Existe porque esa puerta tumbo main dos veces
# seguidas (8fec781 y el run 33448386711, que murio en 26s y dejo sin
# ejecutar todo deploy_production): el hook de Claude Code
# (.claude/hooks/format-dart.js) solo reacciona a las herramientas
# Edit|Write, asi que un archivo escrito por Bash (sed, heredoc) o por un
# subagente llega sin formatear al commit y no se descubre hasta el CI.
#
# Se activa con:  git config core.hooksPath .githooks
# Se salta con:   git commit --no-verify
#
# Se comprueba el arbol entero, no solo lo indexado, porque eso es lo que
# hace el CI: un archivo sin formatear que ya estaba en HEAD tambien
# rompe el pipeline.

if ! command -v dart >/dev/null 2>&1; then
  echo "pre-commit: 'dart' no esta en el PATH; me salto la comprobacion de formato." >&2
  echo "            El CI si la hara (.github/workflows/ci.yml:34)." >&2
  exit 0
fi

salida=$(dart format --output=none --set-exit-if-changed . 2>&1)
if [ $? -eq 0 ]; then
  exit 0
fi

# `dart format .` MUERE —no falla: muere— recorriendo `landing-web/node_modules`
# en cuanto se ha hecho `pnpm install` en el worktree: pnpm anida rutas mas
# largas de lo que Windows admite y salta una PathNotFoundException. El hook
# leia ese exit distinto de cero como "hay Dart sin formatear" y detenia el
# commit con un mensaje falso, que ademas no listaba ni un archivo. En el CI no
# pasa porque el checkout es limpio, asi que esto solo se ve en local.
#
# Cuando es eso, se reintenta sobre las tres raices de Dart del repo
# (`git ls-files '*.dart'` no devuelve ninguna otra).
if printf '%s' "$salida" | grep -q 'PathNotFoundException'; then
  salida=$(dart format --output=none --set-exit-if-changed lib test integration_test 2>&1)
  if [ $? -eq 0 ]; then
    exit 0
  fi
fi

echo "" >&2
echo "  Commit detenido: hay Dart sin formatear." >&2
echo "" >&2
printf '%s
' "$salida" | grep '^Changed' >&2
echo "" >&2
echo "  Arreglalo con:  dart format ." >&2
echo "  Saltatelo con:  git commit --no-verify" >&2
echo "" >&2
exit 1
