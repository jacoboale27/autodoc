# Firebase Web
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID_WEB=
FIREBASE_MEASUREMENT_ID=

# Firebase Android
FIREBASE_ANDROID_API_KEY=
FIREBASE_APP_ID_ANDROID=

# Firebase iOS
FIREBASE_IOS_API_KEY=
FIREBASE_APP_ID_IOS=
FIREBASE_IOS_CLIENT_ID=
FIREBASE_IOS_BUNDLE_ID=

# Shared Firebase
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=


# Google Maps & Translation API Key
# GOOGLE_MAPS_API_KEY: clave *Browser* — la usa el build de web via
# --dart-define-from-file y tambien la API de traduccion.
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY_ANDROID: clave *Android* — la lee
# android/app/build.gradle.kts para el manifest. Si falta, gradle cae a
# GOOGLE_MAPS_API_KEY, que en web es la Browser y no vale en el movil.
GOOGLE_MAPS_API_KEY_ANDROID=

# Google Custom Search API
VEHICLE_IMAGE_API_KEY=

# Google Sign-In (web) — Client ID OAuth 2.0 de tipo "Aplicación web"
GOOGLE_SIGNIN_CLIENT_ID_WEB=

# App Check — clave de sitio de reCAPTCHA Enterprise (web)
RECAPTCHA_SITE_KEY=

# SHA-1 del certificado de firma Android (keytool -list -v -keystore ...)
ANDROID_CERT_SHA1=
