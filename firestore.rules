rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES AUXILIARES ---
    
    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario actual es dueño del documento por UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Obtiene los datos del perfil del usuario actual de la colección 'usuarios'
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Verifica si el usuario actual tiene rol de Administrador
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol in ['Administrador', 'admin'];
    }

    // Verifica si el usuario actual tiene rol de Mecánico
    function isMecanico() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol in ['Mecanico', 'Taller'];
    }

    // Obtiene el propietario de un vehículo
    function getVehicleOwner(vehiculoId) {
      return get(/databases/$(database)/documents/vehiculos/$(vehiculoId)).data.id_propietario;
    }

    // Verifica si el usuario es propietario de un vehículo dado
    function isVehicleOwner(vehiculoId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/vehiculos/$(vehiculoId)) &&
        getVehicleOwner(vehiculoId) == request.auth.uid;
    }

    // Verifica que el usuario es un mecanico cuyo taller esta vinculado al vehiculo.
    function isVinculadoAlVehiculo(vehiculoId) {
      return isMecanico() &&
        exists(/databases/$(database)/documents/vehiculos/$(vehiculoId)) &&
        get(/databases/$(database)/documents/vehiculos/$(vehiculoId))
          .data.get('talleres_vinculados', []).hasAny([request.auth.uid]);
    }


    // --- REGLAS POR COLECCIÓN ---

    // 1. Tabla de Usuarios
    match /usuarios/{userId} {
      // Cada usuario lee unicamente su propio documento. El perfil publico de
      // los talleres vive en la coleccion `talleres`, proyectado por la Cloud
      // Function publishTallerProfile.
      allow read: if isOwner(userId) || isAdmin();

      // Permitir la creación de su propio perfil de usuario durante registro/onboarding
      allow create: if isOwner(userId) && request.resource.data.rol == 'Propietario';
      
      // El usuario puede editar su propio perfil básico, pero no puede tocar
      // 'rol' (escalamiento de privilegios) ni las métricas agregadas de
      // reputación, que solo debe escribir el backend (aggregateRatings).
      // Los administradores tienen acceso completo para cambiar roles o estados.
      // 'estado' tambien queda excluido: es el campo que el directorio publico
      // de talleres usa para filtrar por 'aprobado' (ver publishTallerProfile),
      // asi que un mecanico no puede autoaprobarse saltandose admin_service.
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['rol', 'calificacion_promedio', 'total_resenias', 'estado']))
                    || isAdmin();
      
      allow delete: if isAdmin();
    }

    // 2. Tabla de Talleres
    match /talleres/{tallerId} {
      // El directorio de talleres es de lectura publica.
      allow read: if true;

      // Solo la Cloud Function publishTallerProfile (Admin SDK) escribe aqui.
      allow create, update: if isAdmin();

      allow delete: if isAdmin();
    }

    // 3. Tabla de Vehículos
    match /vehiculos/{vehiculoId} {
      // Un mecánico solo puede leer el vehículo si su taller ya tiene una
      // relación de servicio con él (talleres_vinculados, poblado por la
      // Cloud Function requestReviewOnServiceComplete al crear un servicio).
      // La búsqueda de vehículos nuevos por placa NO usa esta regla: pasa
      // por la Cloud Function callable buscarVehiculoPorPlaca, que devuelve
      // solo datos identificatorios sin exponer el documento completo.
      allow read: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid
        || isAdmin()
        || (isMecanico() && resource.data.get('talleres_vinculados', []).hasAny([request.auth.uid]))
      );

      // Solo el propietario registrado del vehículo puede crearlo o eliminarlo
      allow create: if isAuthenticated() && request.resource.data.id_propietario == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.id_propietario == request.auth.uid;

      // El propietario puede modificar todo su vehículo.
      // Un mecánico de un taller ya vinculado puede actualizar el vehículo
      // únicamente para reportar el 'kilometraje_actual'.
      allow update: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid
        || (isMecanico()
            && resource.data.get('talleres_vinculados', []).hasAny([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kilometraje_actual']))
        || isAdmin()
      );
    }

    // 4. Tabla de Servicios (Historial de Mantenimiento)
    match /servicios/{servicioId} {
      allow create: if isAuthenticated() && (isAdmin() || (isMecanico() && request.resource.data.id_taller == request.auth.uid));
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
        || (isMecanico() && resource.data.id_taller == request.auth.uid)
      );
      allow update: if isAuthenticated() && (isAdmin() || (isMecanico() && resource.data.id_taller == request.auth.uid));
      
      allow delete: if isAdmin();
    }

    // 5. Tabla de Alertas y Recordatorios
    // Restringido: solo el propietario del vehículo vinculado o admin puede gestionar alertas
    match /alertas/{alertaId} {
      // Lectura: propietario del vehículo vinculado, mecánico con relación, o admin
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      // Creación: propietario del vehículo o admin
      allow create: if isAuthenticated() && (
        isVehicleOwner(request.resource.data.id_vehiculo)
        || isAdmin()
      );

      // Actualización: propietario del vehículo o admin
      allow update: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );

      // Eliminación: propietario del vehículo o admin
      allow delete: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );
    }

    // 6. Tabla de Reseñas
    match /resenias/{reseniaId} {
      allow read: if isAuthenticated();

      // Solo se puede resenar un servicio real, propio, y una sola vez, y el
      // id_taller debe coincidir con el taller real del servicio (el cliente
      // no puede apuntar la resenia a un taller arbitrario).
      allow create: if isAuthenticated()
        && request.resource.data.id_usuario == request.auth.uid
        && exists(/databases/$(database)/documents/servicios/$(request.resource.data.id_servicio))
        && isVehicleOwner(
             get(/databases/$(database)/documents/servicios/$(request.resource.data.id_servicio))
               .data.id_vehiculo)
        && request.resource.data.id_taller ==
             get(/databases/$(database)/documents/servicios/$(request.resource.data.id_servicio))
               .data.id_taller;

      // El autor puede corregir su texto, puntuacion y la marca de tiempo de
      // edicion (fecha_resenia, que ReviewService.updateReview siempre reescribe).
      allow update: if isAuthenticated()
        && resource.data.id_usuario == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['comentario', 'estrellas', 'fecha_resenia']);

      // El autor original o el administrador (moderación de comentarios ofensivos) pueden eliminarla
      allow delete: if isAuthenticated() && (resource.data.id_usuario == request.auth.uid || isAdmin());
    }

    // 7. Tabla de Conversaciones
    // Restringido: solo los participantes de la conversación pueden leer/crear/actualizar
    match /conversaciones/{convId} {
      allow read: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid ||
        resource.data.id_mecanico == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.id_propietario == request.auth.uid ||
        request.resource.data.id_mecanico == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid ||
        resource.data.id_mecanico == request.auth.uid ||
        isAdmin()
      );

      // Subcolección de mensajes — solo participantes de la conversación padre
      match /mensajes/{msgId} {
        allow read, create, update: if isAuthenticated() &&
          (get(/databases/$(database)/documents/conversaciones/$(convId)).data
            .id_propietario == request.auth.uid ||
          get(/databases/$(database)/documents/conversaciones/$(convId)).data
            .id_mecanico == request.auth.uid);

        allow delete: if isAuthenticated() &&
          (get(/databases/$(database)/documents/conversaciones/$(convId)).data
            .id_propietario == request.auth.uid ||
          get(/databases/$(database)/documents/conversaciones/$(convId)).data
            .id_mecanico == request.auth.uid);
      }
    }

    // 8. Tabla de Reservas
    match /reservas/{reservaId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid ||
         isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.id_propietario == request.auth.uid;
      // El mecanico solo puede actualizar la reserva que le corresponde a el
      // (mismo patron que 'cotizaciones'); antes cualquier mecanico
      // autenticado podia modificar la reserva de cualquier otro.
      allow update: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid ||
        resource.data.id_mecanico == request.auth.uid ||
        isAdmin()
      );
    }

    // 9. Tabla de Cotizaciones
    match /cotizaciones/{cotizacionId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid ||
         isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.id_mecanico == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid);
    }

    // 10. Tabla de Mantenimientos (tareas de mantenimiento programadas)
    // Solo el propietario del vehículo puede leer/crear/actualizar/eliminar
    // Mecánicos pueden leer y actualizar (registrar km, marcar completado)
    match /mantenimientos/{mantenimientoId} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      allow create: if isAuthenticated() && (
        isVehicleOwner(request.resource.data.id_vehiculo)
        || isAdmin()
      );

      allow update: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      allow delete: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );
    }

    // 11. Tabla de Historial de Mantenimientos
    // Lectura: propietario del vehículo o mecánico del servicio
    // Escritura: mecánico o admin
    match /historial_mantenimientos/{historialId} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      allow create: if isAuthenticated() && (
        (isVinculadoAlVehiculo(request.resource.data.id_vehiculo)
          && request.resource.data.id_taller == request.auth.uid)
        || isAdmin()
      );

      allow update: if isAuthenticated() && (
        (isVinculadoAlVehiculo(resource.data.id_vehiculo)
          && resource.data.id_taller == request.auth.uid)
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // 12. Admin Logs — audit trail
    // Lectura: solo administradores
    // Escritura: solo vía Admin SDK (Cloud Functions) o admin autenticado
    // Los clientes normales NO pueden escribir en esta colección
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      
      // Solo admin puede crear logs desde el cliente
      // Cloud Functions usan Admin SDK que bypasea estas reglas
      allow create: if isAdmin();
      
      allow update, delete: if false; // Logs son inmutables
    }

    // 13. Notificaciones in-app (para centro de notificaciones)
    match /notificaciones/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId); // marcar como leída
      allow create: if false; // Solo vía Cloud Functions (Admin SDK)
      allow delete: if isOwner(userId) || isAdmin();
    }


  }
}
