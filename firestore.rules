rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES AUXILIARES ---
    
    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario actual es dueño del documento por UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Obtiene los datos del perfil del usuario actual de la colección 'usuarios'
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Verifica si el usuario actual tiene rol de Administrador o Propietario principal
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol in ['Administrador', 'admin', 'Propietario'];
    }

    // Verifica si el usuario actual tiene rol de Mecánico
    function isMecanico() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol == 'Mecanico';
    }


    // --- REGLAS POR COLECCIÓN ---

    // 1. Tabla de Usuarios
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      
      // Permitir la creación de su propio perfil de usuario durante registro/onboarding
      allow create: if isOwner(userId);
      
      // El usuario puede editar su propio perfil básico (excepto el campo 'rol' para evitar escalamiento de privilegios)
      // Los administradores tienen acceso completo para cambiar roles o estados
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']))
                    || isAdmin();
      
      allow delete: if isAdmin();
    }

    // 2. Tabla de Talleres
    match /talleres/{tallerId} {
      // El directorio de talleres es de lectura pública
      allow read: if true;
      
      // Mecánicos y Administradores pueden registrar talleres
      allow create: if isAuthenticated() && (isMecanico() || isAdmin());
      
      // Mecánicos pueden actualizar la información de su taller; los admins tienen acceso total
      allow update: if isAuthenticated() && (isMecanico() || isAdmin());
      
      allow delete: if isAdmin();
    }

    // 3. Tabla de Vehículos
    match /vehiculos/{vehiculoId} {
      allow read: if isAuthenticated();
      
      // Solo el propietario registrado del vehículo puede crearlo o eliminarlo
      allow create: if isAuthenticated() && request.resource.data.id_propietario == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.id_propietario == request.auth.uid;
      
      // El propietario puede modificar todo su vehículo. 
      // Un Mecánico puede actualizar el vehículo únicamente para reportar el 'kilometraje_actual'
      allow update: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid 
        || (isMecanico() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kilometraje_actual']))
        || isAdmin()
      );
    }

    // 4. Tabla de Servicios (Historial de Mantenimiento)
    match /servicios/{servicioId} {
      allow read: if isAuthenticated();
      
      // Solo mecánicos y administradores pueden registrar nuevos servicios/mantenimientos
      allow create: if isAuthenticated() && (isMecanico() || isAdmin());
      
      allow update: if isAuthenticated() && (isMecanico() || isAdmin());
      
      allow delete: if isAdmin();
    }

    // 5. Tabla de Alertas y Recordatorios
    match /alertas/{alertaId} {
      allow read: if isAuthenticated();
      
      // Cualquier usuario autenticado (dueños o mecánicos autorizados) puede gestionar alertas
      allow create, update, delete: if isAuthenticated();
    }

    // 6. Tabla de Reseñas
    match /resenias/{reseniaId} {
      // Las reseñas son de lectura pública para alimentar el directorio de talleres
      allow read: if true;
      
      // Solo el usuario autor de la reseña puede crearla
      allow create: if isAuthenticated() && request.resource.data.id_usuario == request.auth.uid;
      
      // Solo el autor original puede editar su comentario/estrellas
      allow update: if isAuthenticated() && resource.data.id_usuario == request.auth.uid;
      
      // El autor original o el administrador (moderación de comentarios ofensivos) pueden eliminarla
      allow delete: if isAuthenticated() && (resource.data.id_usuario == request.auth.uid || isAdmin());
    }

    // 7. Tabla de Conversaciones
    match /conversaciones/{convId} {
      allow read, update, create: if isAuthenticated();
      
      match /mensajes/{msgId} {
        allow read, create, update: if isAuthenticated() &&
          (get(/databases/$(database)/documents/conversaciones/$(convId)).data
            .id_propietario == request.auth.uid ||
          get(/databases/$(database)/documents/conversaciones/$(convId)).data
            .id_mecanico == request.auth.uid);
      }
    }

    // 8. Tabla de Reservas
    match /reservas/{reservaId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.id_propietario == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid ||
        isMecanico() || isAdmin()
      );
    }

    // 9. Tabla de Cotizaciones
    match /cotizaciones/{cotizacionId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.id_mecanico == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid);
    }

    // Regla de respaldo
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
