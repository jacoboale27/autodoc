rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario es administrador
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/Usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'admin'];
    }

    // Reglas para Usuarios
    match /Usuarios/{userId} {
      allow read: if request.auth != null;
      // Solo el dueño puede editar su perfil básico
      // Solo un admin puede editar el campo 'rol' o 'estado'
      // Cualquier usuario autenticado puede actualizar solo métricas de reseñas
      allow update: if (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'estado']))
                    || isAdmin()
                    || (request.auth != null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['calificacion_promedio', 'total_resenias']));
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Reglas para Talleres
    match /Talleres/{tallerId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Solo admins pueden aprobar/suspender (cambiar estado)
      allow update, delete: if isAdmin();
    }

    // Reglas para Reseñas
    match /Resenias/{reseniaId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.id_usuario == request.auth.uid;
      // Solo el autor puede editar su reseña, solo admin puede borrarla
      allow update: if request.auth != null && resource.data.id_usuario == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Reglas para Logs Administrativos
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      // Solo el sistema (vía app) puede crear logs si el usuario es admin
      allow create: if isAdmin();
      allow update, delete: if false; // Los logs son inmutables
    }

    // Reglas generales para el resto de colecciones (Vehiculos, Servicios, Alertas)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
