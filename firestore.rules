rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES AUXILIARES ---
    
    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario actual es dueño del documento por UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Obtiene los datos del perfil del usuario actual de la colección 'usuarios'
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Verifica si el usuario actual tiene rol de Administrador o Superusuario
    // (Superusuario hereda todos los permisos de Administrador en cualquier
    // regla que use isAdmin(); sus permisos EXCLUSIVOS, como crear
    // Administradores o hacer hard-delete de cuentas, se controlan aparte
    // con isSuperUser()).
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol in ['Administrador', 'admin', 'Superusuario'];
    }

    // Verifica si el usuario actual tiene rol de Superusuario, el nivel por
    // encima de Administrador (crear Administradores/Superusuarios, hard
    // delete de cuentas).
    function isSuperUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol == 'Superusuario';
    }

    // Verifica si el usuario actual tiene rol de Mecánico APROBADO. Un taller
    // pendiente de aprobacion no accede a datos: el bloqueo del enrutador no
    // basta, la API es accesible directamente.
    function isMecanico() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol in ['Mecanico', 'Taller'] &&
        getUserData().get('estado', 'pendiente') in ['aprobado', 'activo'];
    }

    // Obtiene el propietario de un vehículo
    function getVehicleOwner(vehiculoId) {
      return get(/databases/$(database)/documents/vehiculos/$(vehiculoId)).data.id_propietario;
    }

    // Verifica si el usuario es propietario de un vehículo dado
    function isVehicleOwner(vehiculoId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/vehiculos/$(vehiculoId)) &&
        getVehicleOwner(vehiculoId) == request.auth.uid;
    }

    // Identidad "de taller" del usuario autenticado: su propio uid si opera
    // como dueño, o el uid del taller dueño si es una sub-cuenta de empleado
    // (usuarios/{uid}.id_taller_propietario) — mismo criterio que
    // actuaPorTaller(), pero expresado como valor en vez de predicado para
    // poder compararlo contra 'talleres_vinculados' (que siempre guarda el
    // uid del DUEÑO, nunca el del empleado que hizo el servicio).
    function idTallerActor() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          .data.get('id_taller_propietario', null) != null
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
            .data.get('id_taller_propietario', null)
        : request.auth.uid;
    }

    // Verifica que el usuario es un mecanico cuyo taller esta vinculado al vehiculo.
    //
    // Usa idTallerActor() (no request.auth.uid directo) para que una
    // sub-cuenta de empleado tambien cuente como vinculada cuando el DUEÑO
    // del taller ya lo esta: antes de este fix, cualquier empleado que
    // finalizaba un servicio de un cliente que regresaba se topaba con
    // permission-denied en 'mantenimientos'/'historial_mantenimientos' /
    // 'alertas', porque 'talleres_vinculados' guarda el uid del dueño y esta
    // funcion comparaba contra el uid del empleado.
    function isVinculadoAlVehiculo(vehiculoId) {
      return isMecanico() &&
        exists(/databases/$(database)/documents/vehiculos/$(vehiculoId)) &&
        get(/databases/$(database)/documents/vehiculos/$(vehiculoId))
          .data.get('talleres_vinculados', []).hasAny([idTallerActor()]);
    }

    // Igual que isVinculadoAlVehiculo, pero ademas deja pasar el walk-in:
    // un cliente que llega sin cita y cuyo vehiculo NUNCA ha tenido ningun
    // taller vinculado (mismo carve-out que ya usan 'servicios'/
    // 'reparaciones' create — ver el hallazgo C1). Sin este carve-out,
    // finalizar el PRIMER servicio de un cliente nuevo fallaba en
    // 'mantenimientos'.update (paso 1 de AlertProvider.tallerUpdateService)
    // antes siquiera de llegar a crear el 'servicios' que si lo permitia.
    function puedeMecanicoAtenderVehiculo(vehiculoId) {
      return isMecanico() &&
        exists(/databases/$(database)/documents/vehiculos/$(vehiculoId)) &&
        (
          get(/databases/$(database)/documents/vehiculos/$(vehiculoId))
            .data.get('talleres_vinculados', []).size() == 0
          || isVinculadoAlVehiculo(vehiculoId)
        );
    }

    // Verifica que un servicio ya finalizado pertenezca al taller indicado
    // y que el vehículo de ese servicio sea propiedad del usuario autenticado.
    // Esto es lo que garantiza que solo se pueda reseñar un servicio real y propio.
    function isOwnFinishedService(servicioId, tallerId) {
      let servicio = get(/databases/$(database)/documents/servicios/$(servicioId)).data;
      return servicio.id_taller == tallerId && isVehicleOwner(servicio.id_vehiculo);
    }

    // Verifica si el uid autenticado actua legitimamente en nombre del
    // taller `tallerId` (fix de integracion de sub-cuentas de empleado,
    // ronda final de la Tarea "panel mecanico 100%"): o bien es el propio
    // dueño (mismo uid que `tallerId`) o bien es una sub-cuenta de empleado
    // cuyo `usuarios/{auth.uid}.id_taller_propietario` apunta a ese taller
    // (ver crearEmpleadoTaller / UserModel.idTallerPropietario /
    // UserModel.idTallerEfectivo, que en el cliente hace que
    // reparaciones/catalogo_servicios se escriban con el uid del DUEÑO como
    // id_taller/tallerId, nunca con el propio uid del empleado). El `||`
    // corta en corto: para el caso dueño (el camino mas comun) nunca se
    // ejecuta el get() de la segunda condicion. Se usa `get()` directo (no
    // getUserData(), que solo lee request.auth.uid) porque aqui se necesita
    // leer el doc de usuarios del llamante para comparar su
    // id_taller_propietario, exactamente igual al patron ya usado en el
    // create de 'usuarios' de arriba para excluir ese mismo campo.
    function actuaPorTaller(tallerId) {
      return request.auth.uid == tallerId ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
           .data.get('id_taller_propietario', null) == tallerId);
    }


    // ¿Es `url` un enlace a un objeto del Storage de ESTE proyecto, bajo la
    // ruta `prefijoRuta`?
    //
    // Existe porque `talleres/{uid}` es de lectura ANONIMA y se alimenta de
    // `usuarios/{uid}` via publishTallerProfile. Cualquier campo de URL que el
    // cliente pueda escribir libremente acaba siendo una URL elegida por el
    // taller que la app de CADA visitante del directorio va a descargar: eso
    // no es una imagen rota, es cosecha de IP y User-Agent de todo el que abra
    // el listado, servida por un tercero.
    //
    // Se ancla el HOST, que es donde esta la amenaza. El segmento del bucket
    // se deja abierto a proposito: el nombre real del bucket es un valor de
    // entorno (FIREBASE_STORAGE_BUCKET) que no vive en el repositorio, y
    // clavarlo aqui obligaria a mantener sincronizados dos sitios sin ganar
    // gran cosa. Lo que queda permitido apuntando a otro bucket de Firebase es
    // contenido, no telemetria: la peticion sigue yendo a un host de Google,
    // nunca a un servidor del atacante.
    //
    // La cadena de consulta se deja libre (`.*`): el token de descarga que
    // añade getDownloadURL() es un detalle del formato de Firebase, y atarlo
    // aqui convertiria un cambio de formato en subidas denegadas.
    function esUrlDeStoragePropia(url, prefijoRuta) {
      return url is string
        && url.size() < 2000
        && url.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/[^/]+/o/' + prefijoRuta + '.*');
    }

    // La foto de perfil solo puede apuntar al objeto del propio usuario en
    // `perfiles/` (ver UserService.uploadProfilePhoto, que sube a
    // `perfiles/{uid}.jpg`). Ausente o vacia tambien vale: no todo el mundo
    // tiene foto.
    function fotoDePerfilValida(userId) {
      return !('foto_perfil_url' in request.resource.data)
        || request.resource.data.foto_perfil_url == null
        || request.resource.data.foto_perfil_url == ''
        || esUrlDeStoragePropia(request.resource.data.foto_perfil_url, 'perfiles%2F' + userId);
    }

    // La galeria comercial NO guarda URLs, guarda nombres de hueco ('logo',
    // 'local-1'...). La ruta de Storage se reconstruye a partir del uid y del
    // hueco, los dos de confianza, asi que por construccion no hay ninguna URL
    // que un taller pueda elegir. Ver GaleriaTaller.
    //
    // Aqui solo se acota el tamaño: sin tope, un taller podria escribir una
    // lista enorme que publishTallerProfile copiaria tal cual al documento
    // publico. Que los nombres sean validos lo resuelve el parseo del modelo,
    // que descarta cualquier hueco fuera del whitelist.
    function galeriaValida() {
      return !('galeria' in request.resource.data)
        || (request.resource.data.galeria is list
            && request.resource.data.galeria.size() <= 6);
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. Tabla de Usuarios
    match /usuarios/{userId} {
      // Cada usuario lee unicamente su propio documento. El perfil publico de
      // los talleres vive en la coleccion `talleres`, proyectado por la Cloud
      // Function publishTallerProfile.
      allow read: if isOwner(userId) || isAdmin();

      // Permitir la creación de su propio perfil de usuario durante registro/onboarding.
      // Ademas de exigir rol == 'Propietario' (ningun rol privilegiado por
      // auto-registro):
      // - 'id_taller_propietario' queda bloqueado por completo: no tiene un
      //   valor por defecto seguro y el cliente (UserModel) nunca lo escribe,
      //   asi que un create que lo incluya solo puede ser un intento de
      //   auto-vincularse a un taller ajeno.
      // - 'estado' / 'calificacion_promedio' / 'total_resenias' SI viajan en
      //   el payload real del cliente (UserModel.toMap() siempre los incluye
      //   con sus valores por defecto: 'activo', 0.0, 0 — ver
      //   user_service.dart createUserData(), rama de usuario nuevo), asi que
      //   bloquearlos por completo rompe el registro real. En su lugar se
      //   permiten solo con su valor por defecto inofensivo: eso deja pasar
      //   el registro legitimo pero sigue bloqueando que alguien se plante
      //   un estado 'aprobado' o una reputacion no nula desde el create.
      //
      // AMPLIACION (alta de mecanico): el auto-registro tambien admite
      // rol == 'Mecanico', pero SOLO con estado == 'pendiente'. Antes solo se
      // aceptaba 'Propietario', asi que elegir "Mecanico" en profile_setup
      // moria en permission-denied: updateProfile() devolvia false, userData
      // seguia null y resolveRedirect() rebotaba a /profile_setup una y otra
      // vez (bucle de registro).
      // 'pendiente' NO esta en estadosMecanicoAprobado ({'aprobado','activo'},
      // ver app_router.dart e isMecanico() aqui abajo), asi que la cuenta
      // recien creada queda retenida en /mechanic_pending sin ningun acceso de
      // taller hasta que un admin la apruebe. Y como 'estado' esta excluido del
      // allow update del propio usuario, el mecanico no puede autoaprobarse
      // despues: el unico camino a 'activo'/'aprobado' pasa por AdminService.
      //
      // Los accesos a 'rol' y 'estado' van guardados con `in` / `.get()` a
      // proposito. Sin el guarda, un create sin 'rol' no se DENIEGA: revienta
      // con "Property rol is undefined on object", que es un error de
      // evaluacion. El efecto neto sobre ese write es el mismo (no pasa), pero
      // el modo de fallo es peor: el mensaje no dice que regla fallo, no se
      // puede razonar sobre el como sobre un `false`, y en cuanto esta
      // condicion se meta dentro de un `||` el error se propaga y tumba
      // tambien la rama que si deberia conceder. Se prefiere denegar limpio.
      allow create: if isOwner(userId)
                    && !('id_taller_propietario' in request.resource.data)
                    && (!('calificacion_promedio' in request.resource.data) || request.resource.data.calificacion_promedio == 0)
                    && (!('total_resenias' in request.resource.data) || request.resource.data.total_resenias == 0)
                    && 'rol' in request.resource.data
                    && fotoDePerfilValida(userId)
                    && galeriaValida()
                    && (
                         (request.resource.data.rol == 'Propietario'
                            && request.resource.data.get('estado', 'activo') == 'activo')
                         || (request.resource.data.rol == 'Mecanico'
                            && request.resource.data.get('estado', '') == 'pendiente')
                       );
      
      // El usuario puede editar su propio perfil básico, pero no puede tocar
      // 'rol' (escalamiento de privilegios) ni las métricas agregadas de
      // reputación, que solo debe escribir el backend (aggregateRatings, ya
      // escribe en 'usuarios' con Admin SDK y por tanto no necesita ningún
      // permiso de cliente aquí: el hueco de "cualquier autenticado puede
      // parchear calificacion_promedio/total_resenias" que existía en la
      // rama del colaborador para su recálculo client-side ya no aplica).
      // Los administradores tienen acceso completo para cambiar roles o estados.
      // 'estado' tambien queda excluido: es el campo que el directorio publico
      // de talleres usa para filtrar por 'aprobado' (ver publishTallerProfile),
      // asi que un mecanico no puede autoaprobarse saltandose admin_service.
      // 'id_taller_propietario' tambien queda excluido: es el campo que
      // vincula a un empleado con su taller dueño (ver crearEmpleadoTaller,
      // que lo fija con Admin SDK al crear la cuenta). Sin esta exclusion,
      // cualquier usuario podria auto-asignarse como empleado de un taller
      // ajeno con un solo update.
      // Un Administrador conserva acceso total salvo para asignar el propio
      // rol 'Administrador' o 'Superusuario': eso queda exclusivo de
      // isSuperUser(). Solo se bloquea cuando el update efectivamente toca
      // 'rol' Y el valor resultante es uno de esos dos — así un Administrador
      // sigue pudiendo aprobar/suspender/reasignar a Propietario/Mecanico
      // sin restricciones nuevas.
      //
      // fotoDePerfilValida/galeriaValida se aplican a la rama del PROPIO
      // usuario y no a la de administracion: el vector es el taller que se
      // publica a si mismo una URL ajena en un documento de lectura anonima.
      // Un administrador que escriba una URL rara es un problema distinto —y
      // ya tiene permisos para mucho mas—, y ademas es quien tiene que poder
      // corregir a mano un dato heredado que no case con el formato nuevo.
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['rol', 'calificacion_promedio', 'total_resenias', 'estado', 'id_taller_propietario', 'suma_estrellas'])
                          && fotoDePerfilValida(userId)
                          && galeriaValida())
                    || isSuperUser()
                    || (isAdmin() && !(
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']) &&
                         request.resource.data.rol in ['Administrador', 'Superusuario']
                       ));

      // Hard delete de cuentas es exclusivo de Superusuario (ver
      // superUserDeleteAccount en functions/index.js, que además borra la
      // cuenta de Firebase Auth vía Admin SDK — este delete de Firestore
      // por sí solo nunca lo hace).
      allow delete: if isSuperUser();
    }

    // 2. Tabla de Talleres
    match /talleres/{tallerId} {
      // El directorio de talleres es de lectura publica.
      allow read: if true;

      // Solo la Cloud Function publishTallerProfile (Admin SDK) escribe aqui.
      // El flujo de calificaciones del colaborador (mecanico/cualquier
      // autenticado escribiendo calificacion_promedio/total_resenias) no
      // aplica: esos campos viven en 'usuarios', no en 'talleres' (ver
      // aggregateRatings en functions/index.js), y el editor de perfil del
      // taller (workshop_settings_screen.dart) escribe en 'usuarios' via
      // UserService, nunca en esta colección.
      allow create, update: if isAdmin();

      allow delete: if isAdmin();

      // Sub-cuentas de empleados del taller (Tarea 8, EmpleadoRepository).
      // Las reglas no se heredan de la coleccion padre, asi que esta
      // subcoleccion necesita su propio match aunque 'talleres/{tallerId}'
      // ya tenga reglas arriba.
      match /empleados/{empleadoId} {
        // Solo el dueño del taller (tallerId == su propio uid) o un admin
        // pueden ver la lista de empleados; ni siquiera el empleado mismo
        // necesita leer esta subcoleccion (EmpleadosScreen la usa solo
        // desde la vista del dueño).
        allow read: if isAuthenticated() && (request.auth.uid == tallerId || isAdmin());

        // El unico write de cliente real es EmpleadoRepository.desactivarEmpleado(),
        // que solo cambia 'activo'. crearRegistroEmpleado() (Tarea 6) nunca
        // se invoca en la app: crearEmpleadoTaller (Cloud Function) crea el
        // documento con el Admin SDK, que bypassea estas reglas por completo.
        allow update: if isAuthenticated() && request.auth.uid == tallerId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo']);

        allow create, delete: if isAdmin();
      }

      // Catálogo de servicios/repuestos rápidos del taller (Tarea 9,
      // CatalogoRepository). Igual que 'empleados', esta subcoleccion
      // necesita su propio match aunque 'talleres/{tallerId}' ya tenga
      // reglas arriba.
      match /catalogo_servicios/{itemId} {
        allow read: if true;
        // Ampliado (fix de integracion de empleados) para aceptar tambien a
        // una sub-cuenta de empleado actuando en nombre de `tallerId` via
        // actuaPorTaller(): antes solo `request.auth.uid == tallerId`
        // (el dueño real) podia escribir, dejando al empleado sin poder
        // gestionar el catalogo aunque `initiate_service_screen.dart` /
        // `catalogo_servicios_screen.dart` ya resuelven el id efectivo del
        // taller (dueño) y no el propio uid del empleado.
        allow create, update, delete: if isAuthenticated() && actuaPorTaller(tallerId);
      }
    }

    // 2.b Expedientes de verificacion de taller
    //
    // Contrapartida PRIVADA de 'talleres': ahi vive la ficha publica
    // (allow read: if true), aqui el tramite. Nunca se mezclan — este
    // documento guarda el motivo de un rechazo, quien reviso y el rastro de
    // los documentos de identidad del negocio, y publishTallerProfile ni
    // siquiera mira esta coleccion, asi que una fuga por descuido de
    // CAMPOS_PUBLICOS es estructuralmente imposible.
    //
    // Ojo con los dos ejes: 'estado_verificacion' NO concede acceso. Quien
    // opera lo sigue diciendo usuarios/{uid}.estado via isMecanico(), que no
    // se toca. Este campo solo gobierna el flujo de onboarding.
    match /verificaciones/{tallerId} {
      allow read: if isAuthenticated() && (request.auth.uid == tallerId || isAdmin());

      // Un taller solo puede dejar SU expediente en 'listo_para_revision', o
      // no tocar el estado en absoluto (subir evidencia). 'en_revision'
      // (tomar el caso) y 'aprobada'/'rechazada' (resolverlo) son exclusivos
      // de isAdmin(): sin esto un taller se autoverifica con un solo write,
      // que es el mismo agujero que ya cierra la exclusion de 'estado' en el
      // allow update de 'usuarios'.
      //
      // 'perfil_incompleto' TAMPOCO lo puede escribir el taller, aunque sea un
      // estado "menor". Nada en la app lo escribe —es solo el valor por
      // defecto al leer un expediente que no existe— y dejarselo escribir
      // abria la puerta de atras de la re-revision: un taller aprobado edita
      // su direccion, la Cloud Function le devuelve el expediente a la cola, y
      // el se autodegrada a 'perfil_incompleto' para desaparecer de la bandeja
      // del administrador conservando la cuenta activa. La condicion se
      // escribe sobre la AUSENCIA de la clave para que un write que no habla
      // del estado (subir evidencia, incluida la creacion del expediente con
      // el primer archivo) siga pasando.
      //
      // Los tres campos de resolucion (motivo_rechazo, revisado_por,
      // fecha_revision) no pueden ESTAR en el documento resultante de un
      // write del taller. Se comprueba sobre el resultado y no sobre el diff
      // a proposito: asi el taller puede BORRARLOS al reenviar tras un
      // rechazo —que es justo lo que hace copyWith(limpiarMotivoRechazo:
      // true)— pero no puede escribirlos. El historial de la resolucion no se
      // pierde: queda en admin_logs, igual que el resto de acciones de
      // administracion.
      //
      // Lo que estas reglas NO validan es que el perfil este realmente
      // completo cuando el taller escribe 'listo_para_revision': exigiria un
      // get() de usuarios/{uid} y replicar aqui la lista de campos de
      // AppEstadoVerificacion.camposFaltantes, duplicando una fuente de
      // verdad por un chequeo que no protege nada — un expediente enviado en
      // falso solo consigue que un administrador lo mire y lo rechace.
      function esWriteDeTaller() {
        return request.auth.uid == tallerId
          && (!('estado_verificacion' in request.resource.data)
              || request.resource.data.estado_verificacion == 'listo_para_revision')
          && !request.resource.data.keys().hasAny(['motivo_rechazo', 'revisado_por', 'fecha_revision']);
      }

      // 'reapertura' la escribe la Cloud Function con SDK de Admin y dice POR
      // QUE un expediente ya aprobado volvio a la cola. Es lo unico que el
      // administrador tiene para saber que mirar, asi que el taller no puede
      // borrarla de un set(merge:false). No se exige que sea inmutable —solo
      // que siga estando—: quien la escribe salta estas reglas de todas
      // formas, y lo que hay que impedir es el borrado.
      function conservaLaReapertura() {
        return !('reapertura' in resource.data)
          || 'reapertura' in request.resource.data;
      }

      allow create: if isAuthenticated() && (esWriteDeTaller() || isAdmin());
      allow update: if isAuthenticated()
                    && ((esWriteDeTaller() && conservaLaReapertura()) || isAdmin());

      // El expediente es el rastro de la verificacion: solo un admin lo borra.
      allow delete: if isAdmin();
    }

    // 3. Tabla de Vehículos
    match /vehiculos/{vehiculoId} {
      // Un mecánico solo puede leer el vehículo si su taller ya tiene una
      // relación de servicio con él (talleres_vinculados, poblado por la
      // Cloud Function requestReviewOnServiceComplete al crear un servicio).
      // La búsqueda de vehículos nuevos por placa NO usa esta regla: pasa
      // por la Cloud Function callable buscarVehiculoPorPlaca, que devuelve
      // solo datos identificatorios sin exponer el documento completo.
      //
      // `resource == null` (documento inexistente) se permite explicitamente.
      // Sin esa rama, un get() sobre un id que aun no existe no devuelve "no
      // existe": evalua `resource.data.id_propietario` sobre null, lo que es
      // un error de evaluacion y se traduce en PERMISSION_DENIED. Eso rompia
      // VehicleImageService.getVehicleImage(), que consulta el vehiculo ANTES
      // de que addVehicle() lo escriba: la excepcion tumbaba la funcion entera
      // y ningun vehiculo nuevo llegaba a buscar su foto.
      // No filtra nada: un documento inexistente no tiene datos que exponer, y
      // los ids son UUID, no enumerables.
      allow read: if isAuthenticated() && (
        resource == null
        || resource.data.id_propietario == request.auth.uid
        || isAdmin()
        || (isMecanico() && resource.data.get('talleres_vinculados', []).hasAny([request.auth.uid]))
        // Usuarios con quien el propietario comparte el vehiculo (ver
        // share_vehicle_sheet.dart) obtienen SOLO lectura aqui; a proposito
        // esto NO se agrega a isVehicleOwner(), que sigue significando "es
        // el dueño real" para isOwnFinishedService/servicios/reseñas.
        || resource.data.get('shared_with', []).hasAny([request.auth.uid])
      );

      // Solo el propietario registrado del vehículo puede crearlo o eliminarlo
      allow create: if isAuthenticated() && request.resource.data.id_propietario == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.id_propietario == request.auth.uid;

      // El propietario puede modificar todo su vehículo.
      // Un mecánico de un taller ya vinculado puede actualizar el vehículo
      // únicamente para reportar el 'kilometraje_actual'.
      allow update: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid
        || (isMecanico()
            && resource.data.get('talleres_vinculados', []).hasAny([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kilometraje_actual']))
        || isAdmin()
      );

      // Galeria de fotos del vehiculo (VehiclePhotoService: streamPhotos /
      // addPhoto / deletePhoto sobre vehiculos/{id}/fotos/{fotoId}).
      // Las reglas NO se heredan de la coleccion padre, asi que sin este match
      // anidado tanto el stream como el set() morian en permission-denied y la
      // galeria aparecia siempre vacia y sin poder subir nada.
      //
      // Lectura: el mismo publico que ya puede leer el vehiculo (dueño,
      // taller vinculado, alguien con quien se compartio, admin). Se
      // reevalua contra el documento padre en vez de duplicar la condicion,
      // para que no se desincronicen.
      // Escritura: solo el dueño real (o admin). Un taller vinculado puede
      // ver las fotos pero no añadir ni borrar: la galeria es del propietario.
      match /fotos/{fotoId} {
        function vehiculo() {
          return get(/databases/$(database)/documents/vehiculos/$(vehiculoId)).data;
        }
        function puedeVerVehiculo() {
          return isAuthenticated()
            && exists(/databases/$(database)/documents/vehiculos/$(vehiculoId))
            && (
                 vehiculo().id_propietario == request.auth.uid
                 || isAdmin()
                 || (isMecanico() && vehiculo().get('talleres_vinculados', []).hasAny([request.auth.uid]))
                 || vehiculo().get('shared_with', []).hasAny([request.auth.uid])
               );
        }
        allow read: if puedeVerVehiculo();
        allow create, update, delete: if isAuthenticated()
          && (isVehicleOwner(vehiculoId) || isAdmin());
      }
    }

    // 4. Tabla de Servicios (Historial de Mantenimiento)
    match /servicios/{servicioId} {
      // MITIGACION PARCIAL (hallazgo critico C1 de la revision adversarial de
      // Fase C): la version anterior permitia a cualquier mecanico crear un
      // 'servicios' para CUALQUIER id_vehiculo con solo poner su propio uid
      // en id_taller, lo que el trigger requestReviewOnServiceComplete
      // traducia automaticamente en un talleres_vinculados permanente sobre
      // el vehiculo de otro, reabriendo exactamente la fuga que la Tarea 9
      // cerro (ver isVinculadoAlVehiculo). No existe hoy en el modelo de
      // datos un campo fiable de "reserva o cotizacion aceptada" referenciado
      // desde 'servicios' que las reglas puedan verificar con get()/exists():
      // ni reservas ni cotizaciones se referencian por id desde el documento
      // de servicio, y la busqueda de vehiculo por placa (Cloud Function
      // buscarVehiculoPorPlaca) esta deliberadamente abierta a cualquier
      // mecanico para soportar el flujo real de "cliente que llega sin cita"
      // (ver vehicle_search_screen.dart -> initiate_service_screen.dart),
      // que por diseno no tiene ninguna relacion previa que verificar.
      // Como mitigacion NO rompe ese flujo legitimo: reduce el alcance de la
      // fuga de "cualquier vehiculo, en cualquier momento" a "solo vehiculos
      // que ningun taller ha atendido todavia". Un vehiculo que ya tiene un
      // taller vinculado deja de poder ser secuestrado por uno distinto sin
      // pasar por el mismo taller.
      //
      // CIERRE COMPLETO (tarea C1-cierre): ya implementado. El trigger
      // requestReviewOnServiceComplete (functions/index.js) ya NO otorga
      // talleres_vinculados automaticamente cuando el vehiculo nunca tuvo
      // taller vinculado: en su lugar marca taller_pendiente_confirmacion
      // en el vehiculo y notifica al propietario (writeNotification + FCM).
      // El vinculo permanente solo se otorga cuando el propietario confirma
      // explicitamente desde su panel (VehicleService.confirmarVinculoTaller
      // / rechazarVinculoTaller), una escritura directa sobre su propio
      // /vehiculos ya permitida por la clausula de "allow update" de abajo
      // (resource.data.id_propietario == request.auth.uid, sin restriccion
      // de campos) — no requirio ningun cambio de regla nueva. La regla de
      // 'servicios' create de aqui abajo sigue siendo necesaria tal cual
      // esta: permite crear el servicio del walk-in (que dispara el
      // trigger), porque el vinculo permanente ahora depende de ese paso
      // posterior fuera de esta coleccion.
      //
      // RAMA DEL PROPIETARIO (mantenimiento hecho por uno mismo): la version
      // anterior solo admitia admin o mecanico, pero el flujo real de
      // task_complete_screen.dart -> AlertProvider.userCompleteTask() lo
      // ejecuta el PROPIETARIO del vehiculo, con el centinela
      // id_taller == 'Manual (Propietario)'. Sin esta rama, completar un
      // servicio manual moria en permission-denied despues de haber subido ya
      // la factura a Storage, dejando el archivo huerfano.
      // No reabre el hallazgo C1: el centinela no es el uid de ningun taller y
      // el trigger requestReviewOnServiceComplete descarta explicitamente los
      // id_taller que contienen 'Manual' (functions/index.js), asi que este
      // create no puede otorgar talleres_vinculados a nadie.
      // Nota (fix de integracion de empleados, mismo patron ya aplicado a
      // 'reparaciones'): las 3 comparaciones de abajo usan actuaPorTaller()
      // en vez de `== request.auth.uid` directo, y el carve-out de walk-in
      // compara 'talleres_vinculados' contra id_taller (el uid del DUEÑO,
      // que es lo que InitiateServiceScreen ya resuelve via
      // UserModel.idTallerEfectivo) en vez de contra request.auth.uid — sin
      // esto, una sub-cuenta de empleado no podia finalizar el servicio de
      // NINGUN cliente que ya tuviera vinculo (talleres_vinculados guarda el
      // uid del dueño, nunca el del empleado que atiende).
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isVehicleOwner(request.resource.data.id_vehiculo)
          && request.resource.data.id_taller == 'Manual (Propietario)') ||
        (isMecanico() && actuaPorTaller(request.resource.data.id_taller)
          && exists(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
          && (
            get(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
              .data.get('talleres_vinculados', []).size() == 0
            || get(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
                 .data.get('talleres_vinculados', []).hasAny([request.resource.data.id_taller])
          ))
      );
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
        || (isMecanico() && actuaPorTaller(resource.data.id_taller))
      );
      // Un mecanico puede seguir actualizando su propio servicio (costo,
      // descripcion, materiales, etc.) pero NO puede reescribir id_vehiculo
      // ni id_taller: sin esta exclusion, un taller podia crear un servicio
      // legitimo en un vehiculo propio y luego, via update, apuntarlo al
      // vehiculo de una victima, inyectando un registro de servicio falso
      // en su historial (hallazgo Important, revision de la 2a ronda de
      // Fase C; adyacente a C1, no es un bypass de talleres_vinculados
      // porque ese trigger es solo onCreate).
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isMecanico() && actuaPorTaller(resource.data.id_taller)
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['id_vehiculo', 'id_taller']))
      );

      allow delete: if isAdmin();
    }

    // 5. Tabla de Alertas y Recordatorios
    // Restringido: solo el propietario del vehículo vinculado o admin puede gestionar alertas
    match /alertas/{alertaId} {
      // Lectura: propietario del vehículo vinculado, mecánico con relación, o admin
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      // Creación: propietario del vehículo o admin
      allow create: if isAuthenticated() && (
        isVehicleOwner(request.resource.data.id_vehiculo)
        || isAdmin()
      );

      // Actualización: propietario del vehículo o admin
      allow update: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );

      // Eliminación: propietario del vehículo o admin
      allow delete: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );
    }

    // 6. Tabla de Reseñas
    match /resenias/{reseniaId} {
      // Las reseñas son de lectura pública para alimentar el directorio de talleres.
      allow read: if true;

      // Solo el usuario autor puede crearla, y solo si referencia un servicio
      // real, del taller indicado y de un vehículo de su propiedad (evita
      // reseñas sin haber recibido un servicio); ver isOwnFinishedService.
      allow create: if isAuthenticated()
        && request.resource.data.id_usuario == request.auth.uid
        && request.resource.data.id_servicio is string
        && request.resource.data.id_servicio.size() > 0
        && exists(/databases/$(database)/documents/servicios/$(request.resource.data.id_servicio))
        && isOwnFinishedService(request.resource.data.id_servicio, request.resource.data.id_taller);

      // El autor puede corregir su texto, puntuacion, fotos y la marca de tiempo
      // de edicion (fecha_resenia, que ReviewService.updateReview siempre
      // reescribe); no se permite reasignar id_servicio/id_taller/id_usuario.
      //
      // El taller dueño de la reseña puede escribir unicamente respuesta_taller
      // (derecho a réplica), sin poder tocar el contenido original.
      //
      // Cualquier usuario autenticado puede marcar is_reported=true (reportar),
      // pero no puede usar ese mismo update para tocar ningun otro campo, ni
      // puede revertirlo a false (solo el admin puede des-reportar, vía delete
      // o mediante el propio panel de moderación que solo expone "eliminar").
      //
      // El admin puede moderar (p.ej. corregir comentario) pero, igual que
      // el autor, no puede reasignar id_servicio/id_taller/id_usuario vía
      // update: esa reasignación sigue prohibida sin excepción alguna.
      allow update: if isAuthenticated() && (
        (resource.data.id_usuario == request.auth.uid
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['comentario', 'estrellas', 'fecha_resenia', 'fotos']))
        || (actuaPorTaller(resource.data.id_taller)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['respuesta_taller']))
        || (request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['is_reported'])
            && request.resource.data.is_reported == true)
        || (isAdmin()
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['id_servicio', 'id_taller', 'id_usuario']))
      );

      // El autor original o el administrador (moderación de comentarios ofensivos) pueden eliminarla
      allow delete: if isAuthenticated() && (resource.data.id_usuario == request.auth.uid || isAdmin());
    }

    // 7. Tabla de Conversaciones
    // Restringido: solo los participantes de la conversación pueden leer/crear/actualizar
    match /conversaciones/{convId} {
      allow read: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid ||
        resource.data.id_mecanico == request.auth.uid ||
        isAdmin()
      );

      // Revision de rama completa (hallazgo C2): antes, cualquier cuenta
      // autenticada podia crear una conversacion nombrandose a si misma
      // como id_mecanico y a CUALQUIER victima como id_propietario, sin
      // relacion previa ni comprobacion de rol. `obtenerPerfilPublico`
      // confia en que "existe una conversacion" implica una relacion
      // legitima (ver functions/src/obtenerPerfilPublico.js,
      // compartenConversacion); esa confianza era auto-emitible por quien
      // llama. Ahora: el propietario siempre puede crear una conversacion
      // sobre si mismo (inicia el chat desde el directorio, workshop_
      // directory_screen.dart), y el mecanico solo puede crear una
      // conversacion en nombre de SU PROPIO taller (actuaPorTaller,
      // service_finalized_screen.dart) — nunca en nombre de un taller
      // ajeno ni sin ese vinculo. Verificado que ChatProvider.
      // iniciarOCrearConversacion es el UNICO sitio de 'lib/' que crea
      // conversaciones (grep de crearConversacion/collection('conversaciones')
      // .add|.doc) y que sus dos call sites (workshop_directory_screen.dart,
      // service_finalized_screen.dart) siempre pasan id_taller.
      //
      // `&& isMecanico()` es la mitigacion residual del propio hallazgo C2:
      // sin ella, un cliente cualquiera podia nombrarse id_mecanico == su
      // propio uid Y id_taller == su propio uid, y `actuaPorTaller` deja
      // pasar ese caso (su primera rama es `request.auth.uid == tallerId`,
      // que no comprueba rol). Eso seguia fabricando la conversacion que
      // `compartenConversacion` exige; el callable lo bloquea aparte con
      // `llamanteEsMecanico` (segunda barrera independiente), pero la regla
      // debe cerrar tambien su propio hueco en vez de depender solo de eso.
      allow create: if isAuthenticated() && (
        request.resource.data.id_propietario == request.auth.uid ||
        (request.resource.data.id_mecanico == request.auth.uid
          && isMecanico()
          && actuaPorTaller(request.resource.data.id_taller))
      );

      allow update: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid ||
        resource.data.id_mecanico == request.auth.uid ||
        isAdmin()
      );

      // Subcolección de mensajes — solo participantes de la conversación padre
      match /mensajes/{msgId} {
        function esParticipante() {
          return get(/databases/$(database)/documents/conversaciones/$(convId)).data
              .id_propietario == request.auth.uid ||
            get(/databases/$(database)/documents/conversaciones/$(convId)).data
              .id_mecanico == request.auth.uid;
        }

        allow read: if isAuthenticated() && esParticipante();

        // Revisión de Tarea 11 (C4b), hallazgo R1: la regla original de
        // `create` no comprobaba `request.resource.data` en absoluto — solo
        // exigía ser participante. Cualquier participante podía forjar
        // `id_remitente` con el uid del OTRO participante; como
        // `chat_screen.dart` calcula `isMe = msg.idRemitente == userId`, el
        // mensaje forjado se renderizaba como si el otro lo hubiera escrito
        // (p.ej. el taller hace que aparezca "Acepto pagar 2.000.000" en
        // boca del propietario). Se auditó cada `create` real
        // (`ChatRepository.enviarMensaje`, único punto de escritura, y su
        // único llamador `ChatProvider.enviarMensaje`/`enviarCotizacion`):
        // todos pasan `remitenteId: userId` (el uid autenticado de quien
        // envía) — ninguna escritura legítima, de cliente ni de Cloud
        // Functions (el trigger `notifyOnNewChatMessage` solo lee, no
        // escribe mensajes), depende de poder fijar un `id_remitente`
        // distinto al propio.
        allow create: if isAuthenticated() && esParticipante() &&
          request.resource.data.id_remitente == request.auth.uid;

        // Tarea 11b (C4), revisada en la ronda C4b: la regla original
        // permitía reescribir CUALQUIER campo de un mensaje ajeno — el
        // emisor, el tipo, el precio de una cotización ya aceptada — sin
        // verificar autoría ni acotar los campos tocados. Se cierra a
        // cuatro escrituras concretas, cada una ya usada por la app hoy:
        //   1. Editar el propio texto: solo el autor, solo mensajes de tipo
        //      'texto' (una cotización o reserva editada cambiaría lo que
        //      la otra parte ya aceptó/leyó), solo puede tocar `contenido`
        //      y `editado`. `hasOnly` impide colar `id_remitente` o `tipo`.
        //      Hallazgo R3 (revisión C4b): la rama original no exigía
        //      `editado == true` — `update({contenido: 'x'})` a secas, o
        //      con `editado: false`, pasaba el `hasOnly` igual, permitiendo
        //      reescribir el texto sin dejar la marca "(editado)" que es la
        //      única señal visible del cambio. Ahora se exige
        //      `request.resource.data.editado == true` explícitamente.
        //   2. Marcar como visto (`ChatRepository.marcarComoLeidos`): el
        //      receptor actualiza el `estado` de un mensaje que NO escribió
        //      — sigue siendo cualquier participante, solo ese campo.
        //   3. Metadata de tarjetas interactivas (reserva/cotización/reseña,
        //      `actualizarMetadatosMensaje`): la acción (aceptar, rechazar,
        //      calificar) la dispara la contraparte del emisor, así que
        //      también se mantiene abierto a cualquier participante, solo
        //      ese campo.
        //   4. Borrado lógico (`ChatRepository.deleteMensaje`, is_deleted +
        //      contenido): usa `update`, no `delete` — se acota aquí al
        //      autor, igual que el `delete` físico de abajo. Hallazgo R2
        //      (revisión C4b): la rama original no fijaba el valor de
        //      `contenido` ni exigía que `is_deleted` pasara de false→true,
        //      así que servía como reescritura de `contenido` disfrazada de
        //      borrado — dos escrituras (borrar con un `contenido`
        //      inventado, luego "revivir" con `is_deleted: false`) dejaban
        //      un mensaje vivo con el texto reescrito y sin marca de
        //      editado, incluso en una `cotizacion_card`. Ahora es un
        //      tombstone de una sola dirección: exige
        //      `resource.data.is_deleted != true` (no se puede volver a
        //      "borrar" ni, más importante, revertir desde `true`),
        //      `request.resource.data.is_deleted == true`, y fija
        //      `contenido` al valor EXACTO que escribe
        //      `ChatRepository.deleteMensaje` — no es localizable ni
        //      configurable, es un literal en el repositorio.
        allow update: if isAuthenticated() && esParticipante() && (
          (resource.data.id_remitente == request.auth.uid &&
            resource.data.tipo == 'texto' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['contenido', 'editado']) &&
            request.resource.data.editado == true)
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado'])
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['metadata'])
          || (resource.data.id_remitente == request.auth.uid &&
            resource.data.get('is_deleted', false) != true &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['is_deleted', 'contenido']) &&
            request.resource.data.is_deleted == true &&
            request.resource.data.contenido == 'Este mensaje ha sido eliminado')
        );

        // Borrado: solo el autor del mensaje, y solo si sigue siendo
        // participante de la conversación (defensa en profundidad,
        // hallazgo R4 — el resto de reglas de esta subcolección ya exige
        // `esParticipante()`, esta no lo hacía). La regla original permitía
        // a cualquier participante borrar el mensaje del otro — un permiso
        // heredado sin que nadie lo decidiera, no una elección de diseño
        // (ver informe de Tarea 11).
        allow delete: if isAuthenticated() && esParticipante() &&
          resource.data.id_remitente == request.auth.uid;
      }
    }

    // 8. Tabla de Reservas
    match /reservas/{reservaId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid ||
         isAdmin());
      // Tanto el propietario como el mecánico pueden proponer una cita desde
      // el chat (chat_screen.dart _mostrarSelectorFecha, flujo de
      // cotizacion+agenda integrado): cualquiera de los dos puede ser quien
      // crea el documento, con tal de que se asigne a sí mismo en su propio
      // campo (id_propietario/id_mecanico). Restringir esto a solo
      // propietario, como hacia la version anterior de esta regla, rompe la
      // mitad del flujo (el mecanico proponiendo fecha). Nota: al igual que
      // en la version anterior, no se valida aqui que exista una relacion
      // previa (conversacion) entre ambos uid — riesgo residual conocido,
      // sin escalar respecto al comportamiento previo a este merge.
      allow create: if isAuthenticated() &&
        (request.resource.data.id_propietario == request.auth.uid ||
         request.resource.data.id_mecanico == request.auth.uid);
      // Tras crearse, solo estado/fecha_hora_confirmada/fecha_hora_propuesta
      // son escribibles (ver ReservaRepository.actualizarEstadoReserva y
      // .reprogramarReserva, los unicos dos flujos reales de escritura):
      // sin este acotado, cualquiera de los dos participantes podia
      // reescribir id_propietario/id_mecanico/id_vehiculo/id_taller despues
      // de creada la reserva (hallazgo M1).
      allow update: if isAuthenticated() && (
        isAdmin() || (
          (resource.data.id_propietario == request.auth.uid ||
           resource.data.id_mecanico == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'fecha_hora_confirmada', 'fecha_hora_propuesta', 'id_proponente']) &&
          (
            (
              // Reprogramar: mueve fecha_hora_propuesta y vuelve a
              // 'pendiente'. Se detecta por fecha_hora_propuesta, no por
              // 'estado' en affectedKeys() — si la reserva ya estaba
              // 'pendiente', reescribir el mismo valor no cuenta como campo
              // afectado en diff(), y el chequeo de transición de abajo
              // quedaría bypaseado por completo (permitía reprogramar sin
              // id_proponente propio).
              'fecha_hora_propuesta' in request.resource.data.diff(resource.data).affectedKeys() &&
              request.resource.data.estado == 'pendiente' &&
              request.resource.data.id_proponente == request.auth.uid
            ) ||
            (
              !('fecha_hora_propuesta' in request.resource.data.diff(resource.data).affectedKeys()) &&
              !('id_proponente' in request.resource.data.diff(resource.data).affectedKeys()) &&
              (
                !('estado' in request.resource.data.diff(resource.data).affectedKeys()) ||
                (
                  request.resource.data.estado in ['confirmada', 'rechazada'] &&
                  request.auth.uid != resource.data.get('id_proponente', resource.data.id_propietario)
                ) ||
                (
                  request.resource.data.estado == 'cancelada_por_propietario' &&
                  request.auth.uid == resource.data.id_propietario
                ) ||
                (
                  request.resource.data.estado == 'cancelada_por_taller' &&
                  request.auth.uid == resource.data.id_mecanico
                ) ||
                (
                  request.resource.data.estado == 'cancelada'
                ) ||
                (
                  request.resource.data.estado in ['completada', 'cotizada']
                )
              )
            )
          )
        )
      );
    }

    // 9. Tabla de Cotizaciones
    match /cotizaciones/{cotizacionId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid ||
         isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.id_mecanico == request.auth.uid;
      // Solo el campo 'estado' es escribible tras la creacion, y cada parte
      // solo puede escribir el valor que su propio flujo real produce: el
      // propietario acepta/rechaza (cotizacion_chat_card.dart, via
      // actualizarEstadoCotizacion) y el mecanico la marca 'finalizada'
      // (initiate_service_screen.dart). Verificado por grep que ningun otro
      // sitio escribe 'estado' sobre esta coleccion.
      //
      // Revision de rama completa (hallazgo C1): antes de esto, CUALQUIERA
      // de las dos partes podia escribir CUALQUIER valor de 'estado'. Eso
      // dejaba que el mecanico se auto-aceptara su propia cotizacion sobre
      // un vehiculo ajeno, cumpliendo asi por su cuenta la unica condicion
      // que el trigger `onCotizacionAceptada` (5. reparaciones) exige para
      // abrir un ticket. Separar por rol Y por valor cierra esa via.
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
        (
          (resource.data.id_propietario == request.auth.uid
            && request.resource.data.estado in ['aceptada', 'rechazada'])
          || (resource.data.id_mecanico == request.auth.uid
            && request.resource.data.estado == 'finalizada')
        );

      // Beneficio por renglon (ver CotizacionItem.beneficio en el cliente):
      // documento privado fuera del doc principal porque 'cotizaciones' es
      // de lectura compartida con el propietario, y el beneficio del
      // mecanico nunca debe ser visible para el cliente (hallazgo H2).
      match /privado/{docId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.id_mecanico == request.auth.uid
          || isAdmin()
        );
        allow write: if isAuthenticated() &&
          get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.id_mecanico == request.auth.uid;
      }
    }

    // 10. Tabla de Mantenimientos (tareas de mantenimiento programadas)
    // Solo el propietario del vehículo puede leer/crear/actualizar/eliminar
    // Mecánicos pueden leer y actualizar (registrar km, marcar completado)
    match /mantenimientos/{mantenimientoId} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      allow create: if isAuthenticated() && (
        isVehicleOwner(request.resource.data.id_vehiculo)
        || isAdmin()
      );

      // puedeMecanicoAtenderVehiculo (no isVinculadoAlVehiculo a secas): un
      // mecanico que cierra el PRIMER servicio de un cliente walk-in todavia
      // no aparece en 'talleres_vinculados' en este punto — ese vinculo se
      // otorga recien despues, al crear el 'servicios' correspondiente — asi
      // que sin el carve-out este update (paso 1 de tallerUpdateService)
      // fallaba con permission-denied antes de llegar a esa escritura.
      allow update: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || puedeMecanicoAtenderVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      allow delete: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );
    }

    // 11. Tabla de Historial de Mantenimientos
    // Lectura: propietario del vehículo o mecánico del servicio
    // Escritura: mecánico o admin
    match /historial_mantenimientos/{historialId} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      // actuaPorTaller() (no request.auth.uid directo) para aceptar tambien
      // a un empleado; carve-out de walk-in igual que 'mantenimientos'.update
      // y 'servicios'.create, porque este create es el paso 4 del mismo
      // tallerUpdateService que ya necesita esos dos.
      allow create: if isAuthenticated() && (
        (isMecanico() && actuaPorTaller(request.resource.data.id_taller)
          && exists(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
          && (
            get(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
              .data.get('talleres_vinculados', []).size() == 0
            || get(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
                 .data.get('talleres_vinculados', []).hasAny([request.resource.data.id_taller])
          ))
        || isAdmin()
      );

      allow update: if isAuthenticated() && (
        (isMecanico() && actuaPorTaller(resource.data.id_taller))
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // 12. Admin Logs — audit trail
    // Lectura: solo administradores
    // Escritura: solo vía Admin SDK (Cloud Functions) o admin autenticado
    // Los clientes normales NO pueden escribir en esta colección
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      
      // El log SI se escribe desde el cliente: AdminService._logAction lo
      // emite tras cada accion de administracion (aprobar, suspender, cambiar
      // rol...) via AdminRepository.registrarLog. Cerrar este create tumbaria
      // todo el panel de administracion, no solo la auditoria.
      //
      // Lo que si se cierra es la ATRIBUCION: 'admin_uid' viaja en el payload
      // del cliente (AdminLogModel.toMap), asi que sin este chequeo un
      // administrador podia firmar una entrada con el uid de OTRO
      // administrador y ensuciarle el historial. Todas las llamadas reales
      // pasan `currentUid` (ver admin_usuarios_screen / admin_talleres_screen),
      // asi que exigir que coincida con el llamante no rompe ningun flujo.
      //
      // LIMITE CONOCIDO, y es estructural: esto garantiza que un log escrito
      // sea autentico, no que la accion quede logueada. La accion y su log son
      // dos writes independientes del cliente; un administrador que omita el
      // segundo actua sin dejar rastro, y 'fecha' es un DateTime.now() del
      // cliente, o sea antedatable. La unica cura real es mover las acciones de
      // administracion a Cloud Functions y que el log lo escriba el Admin SDK
      // en la misma transaccion. Fuera del alcance de esta tanda.
      allow create: if isAdmin()
                    && request.resource.data.get('admin_uid', '') == request.auth.uid;

      allow update, delete: if false; // Logs son inmutables
    }

    // 13. Notificaciones in-app (para centro de notificaciones)
    match /notificaciones/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId); // marcar como leída
      allow create: if false; // Solo vía Cloud Functions (Admin SDK)
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 14. Tabla de Reparaciones (kanban de estado de reparación, panel mecánico)
    // Lectura: propietario del vehículo, taller asignado o admin
    // Escritura: solo el taller vinculado al vehículo (mismo patrón que
    // 'servicios'/'historial_mantenimientos'): create exige isMecanico() +
    // isVinculadoAlVehiculo(id_vehiculo) — o, igual que en 'servicios'
    // (walk-in: cliente sin cita previa, ver vehicle_search_screen.dart ->
    // initiate_service_screen.dart -> _iniciarTicketReparacion), que el
    // vehículo aún no tenga ningún taller vinculado — y que id_propietario
    // coincida con el dueño real del vehículo (evita inyectar una
    // reparación falsa en el vehículo de una víctima); update bloquea
    // reasignar id_vehiculo/id_taller/id_propietario tras la creación
    // (mismo hallazgo ya corregido en 'servicios').
    // Nota (fix de integracion de empleados): las 3 comparaciones de uid de
    // abajo (read/create/update) usan actuaPorTaller() en vez de
    // `== request.auth.uid` directo, para aceptar tambien a una sub-cuenta
    // de empleado actuando en nombre del taller dueño — ver
    // InitiateServiceScreen._iniciarTicketReparacion, que ya resuelve
    // `idTaller` al uid del dueño (UserModel.idTallerEfectivo), no al
    // propio uid del empleado. El resto de las condiciones (isMecanico(),
    // isVinculadoAlVehiculo, el carve-out de walk-in, el bloqueo de campos
    // en update) queda intacto: solo se amplia QUIEN puede ser "el taller",
    // no se relaja ninguna otra proteccion.
    match /reparaciones/{reparacionId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         actuaPorTaller(resource.data.id_taller) || isAdmin());

      // A4b: ya nadie crea reparaciones desde el cliente. El unico creador es
      // el trigger `onCotizacionAceptada` (Admin SDK, que se salta las
      // reglas), que abre el ticket en 'pendiente_recepcion' cuando el cliente
      // acepta la cotizacion. Que el mecanico pudiera crearlo a mano era
      // justamente lo que dejaba recibir un vehiculo sin cotizacion aceptada
      // (A3/B2).
      //
      // El callable `iniciarReparacionPorVehiculo` tambien corre con Admin
      // SDK y por tanto tampoco pasa por esta regla: sigue pudiendo escribir
      // en esta coleccion pese al `if false` de abajo. NO es una via
      // deliberadamente permisiva por diseno: es un hueco que este `if false`
      // no cierra. Se mitiga del lado del propio callable, que replica a mano
      // las comprobaciones que esta regla haria (vinculo del taller al
      // vehiculo y, ahora tambien, cotizacion aceptada) — ver
      // `functions/src/iniciarReparacionPorVehiculo.js` y el hallazgo 1 de la
      // revision de la Tarea 4. Cualquier otro callable o trigger que se
      // añada sobre /reparaciones tiene que hacer lo mismo: este `if false`
      // no lo protege.
      allow create: if false;

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (actuaPorTaller(resource.data.id_taller)
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['id_vehiculo', 'id_taller', 'id_propietario']))
      );

      allow delete: if isAdmin();
    }

  }
}
