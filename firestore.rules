rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES AUXILIARES ---
    
    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario actual es dueño del documento por UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Obtiene los datos del perfil del usuario actual de la colección 'usuarios'
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Verifica si el usuario actual tiene rol de Administrador o Superusuario
    // (Superusuario hereda todos los permisos de Administrador en cualquier
    // regla que use isAdmin(); sus permisos EXCLUSIVOS, como crear
    // Administradores o hacer hard-delete de cuentas, se controlan aparte
    // con isSuperUser()).
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol in ['Administrador', 'admin', 'Superusuario'];
    }

    // Verifica si el usuario actual tiene rol de Superusuario, el nivel por
    // encima de Administrador (crear Administradores/Superusuarios, hard
    // delete de cuentas).
    function isSuperUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol == 'Superusuario';
    }

    // Verifica si el usuario actual tiene rol de Mecánico APROBADO. Un taller
    // pendiente de aprobacion no accede a datos: el bloqueo del enrutador no
    // basta, la API es accesible directamente.
    function isMecanico() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol in ['Mecanico', 'Taller'] &&
        getUserData().get('estado', 'pendiente') in ['aprobado', 'activo'];
    }

    // Igual que isMecanico(), pero sobre un uid CUALQUIERA y no sobre el
    // llamante. Hace falta para validar a la contraparte que un documento
    // nombra, no a quien escribe.
    function esMecanicoAprobado(uid) {
      return exists(/databases/$(database)/documents/usuarios/$(uid)) &&
        get(/databases/$(database)/documents/usuarios/$(uid)).data.rol
          in ['Mecanico', 'Taller'] &&
        get(/databases/$(database)/documents/usuarios/$(uid)).data
          .get('estado', 'pendiente') in ['aprobado', 'activo'];
    }

    // Obtiene el propietario de un vehículo
    function getVehicleOwner(vehiculoId) {
      return get(/databases/$(database)/documents/vehiculos/$(vehiculoId)).data.id_propietario;
    }

    // Verifica si el usuario es propietario de un vehículo dado
    function isVehicleOwner(vehiculoId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/vehiculos/$(vehiculoId)) &&
        getVehicleOwner(vehiculoId) == request.auth.uid;
    }

    // Identidad "de taller" del usuario autenticado: su propio uid si opera
    // como dueño, o el uid del taller dueño si es una sub-cuenta de empleado
    // (usuarios/{uid}.id_taller_propietario) — mismo criterio que
    // actuaPorTaller(), pero expresado como valor en vez de predicado para
    // poder compararlo contra 'talleres_vinculados' (que siempre guarda el
    // uid del DUEÑO, nunca el del empleado que hizo el servicio).
    function idTallerActor() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          .data.get('id_taller_propietario', null) != null
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
            .data.get('id_taller_propietario', null)
        : request.auth.uid;
    }

    // Verifica que el usuario es un mecanico cuyo taller esta vinculado al vehiculo.
    //
    // Usa idTallerActor() (no request.auth.uid directo) para que una
    // sub-cuenta de empleado tambien cuente como vinculada cuando el DUEÑO
    // del taller ya lo esta: antes de este fix, cualquier empleado que
    // finalizaba un servicio de un cliente que regresaba se topaba con
    // permission-denied en 'mantenimientos'/'historial_mantenimientos' /
    // 'alertas', porque 'talleres_vinculados' guarda el uid del dueño y esta
    // funcion comparaba contra el uid del empleado.
    function isVinculadoAlVehiculo(vehiculoId) {
      return isMecanico() &&
        exists(/databases/$(database)/documents/vehiculos/$(vehiculoId)) &&
        get(/databases/$(database)/documents/vehiculos/$(vehiculoId))
          .data.get('talleres_vinculados', []).hasAny([idTallerActor()]);
    }

    // Igual que isVinculadoAlVehiculo, pero ademas deja pasar el walk-in:
    // un cliente que llega sin cita y cuyo vehiculo NUNCA ha tenido ningun
    // taller vinculado (mismo carve-out que ya usan 'servicios'/
    // 'reparaciones' create — ver el hallazgo C1). Sin este carve-out,
    // finalizar el PRIMER servicio de un cliente nuevo fallaba en
    // 'mantenimientos'.update (paso 1 de AlertProvider.tallerUpdateService)
    // antes siquiera de llegar a crear el 'servicios' que si lo permitia.
    // Estados de `reparaciones` que cierran la visita. Espejo de
    // ESTADOS_TICKET_CERRADO (functions/src/aceptarCotizacion.js) y de
    // estadosReparacionCerrados (lib/core/models/reparacion_model.dart). Las
    // tres copias tienen que decir lo mismo.
    function estadosTicketCerrado() {
      return ['entregado', 'cancelado'];
    }

    // Todos los estados que un ticket puede tener: las cinco columnas del
    // tablero mas los dos terminales. Es una lista BLANCA a proposito, ver la
    // regla de update de /reparaciones.
    function estadosTicketValidos() {
      return ['pendiente_recepcion', 'recibido', 'en_revision',
              'esperando_repuestos', 'listo_para_entrega',
              'entregado', 'cancelado'];
    }

    // Estados en los que el coche esta FISICAMENTE en el taller. Espejo de
    // ESTADOS_VEHICULO_EN_TALLER / estadosVehiculoEnTaller.
    function estadosVehiculoEnTaller() {
      return ['recibido', 'en_revision', 'esperando_repuestos',
              'listo_para_entrega'];
    }

    // Los tickets legados (anteriores a A4b) no traen `estado`; nacian en
    // 'recibido'. Mismo defecto que aplican el cliente y las functions.
    function estadoTicket(datos) {
      return datos.get('estado', 'recibido');
    }

    // ¿Este ticket queda ABIERTO? Espejo de `ticketAbierto`
    // (lib/core/models/reparacion_model.dart) y de su gemelo en
    // functions/src/aceptarCotizacion.js. Las tres copias tienen que decir lo
    // mismo: es el campo que el tablero consulta por igualdad (gap 9.1).
    function ticketAbierto(datos) {
      return !(estadoTicket(datos) in estadosTicketCerrado());
    }

    // ¿Este taller ha tenido este vehiculo alguna vez?
    //
    // `talleres_conocidos` es append-only: se escribe al recibir el vehiculo
    // (`recibirTicketYVincular`, Admin SDK) y NO se revoca nunca, a diferencia
    // de `talleres_vinculados`, que significa "lo tiene AHORA" y muere con la
    // visita. La distincion existe por el hallazgo de la revision adversarial
    // de la ronda 6: el carve-out de walk-in miraba `talleres_vinculados`,
    // asi que cuando la ronda 5 empezo a REVOCAR ese array, "sin taller
    // vinculado" dejo de significar "coche que nadie ha atendido nunca" y paso
    // a ser el estado de reposo de TODO coche ya entregado. Cualquier taller
    // podia entonces inyectar un `servicios` falso en el historial de
    // cualquier coche que no estuviera fisicamente en un taller en ese
    // momento. Comprobado contra el emulador.
    function tallerConoceElVehiculo(vehiculoId) {
      return isMecanico() &&
        get(/databases/$(database)/documents/vehiculos/$(vehiculoId))
          .data.get('talleres_conocidos', []).hasAny([idTallerActor()]);
    }

    function puedeMecanicoAtenderVehiculo(vehiculoId) {
      return isMecanico() &&
        exists(/databases/$(database)/documents/vehiculos/$(vehiculoId)) &&
        (
          // Walk-in de verdad: un vehiculo por el que no ha pasado NINGUN
          // taller todavia. Exige los DOS arrays vacios, y esa segunda mitad
          // no es redundante: `talleres_conocidos` nace en la migracion de la
          // ronda 6, asi que un vehiculo legado tiene vinculo vivo y ningun
          // conocido. Mirando solo `talleres_conocidos`, ese coche —que SI
          // esta siendo atendido por un taller— quedaba abierto a cualquier
          // otro. Lo cazaron dos tests que ya existian
          // (servicios.test.js y mecanico-scope.test.js).
          (get(/databases/$(database)/documents/vehiculos/$(vehiculoId))
             .data.get('talleres_conocidos', []).size() == 0
           && get(/databases/$(database)/documents/vehiculos/$(vehiculoId))
                .data.get('talleres_vinculados', []).size() == 0)
          || isVinculadoAlVehiculo(vehiculoId)
          || tallerConoceElVehiculo(vehiculoId)
        );
    }

    // Verifica que un servicio ya finalizado pertenezca al taller indicado
    // y que el vehículo de ese servicio sea propiedad del usuario autenticado.
    // Esto es lo que garantiza que solo se pueda reseñar un servicio real y propio.
    function isOwnFinishedService(servicioId, tallerId) {
      let servicio = get(/databases/$(database)/documents/servicios/$(servicioId)).data;
      return servicio.id_taller == tallerId && isVehicleOwner(servicio.id_vehiculo);
    }

    // Verifica si el uid autenticado actua legitimamente en nombre del
    // taller `tallerId` (fix de integracion de sub-cuentas de empleado,
    // ronda final de la Tarea "panel mecanico 100%"): o bien es el propio
    // dueño (mismo uid que `tallerId`) o bien es una sub-cuenta de empleado
    // cuyo `usuarios/{auth.uid}.id_taller_propietario` apunta a ese taller
    // (ver crearEmpleadoTaller / UserModel.idTallerPropietario /
    // UserModel.idTallerEfectivo, que en el cliente hace que
    // reparaciones/catalogo_servicios se escriban con el uid del DUEÑO como
    // id_taller/tallerId, nunca con el propio uid del empleado). El `||`
    // corta en corto: para el caso dueño (el camino mas comun) nunca se
    // ejecuta el get() de la segunda condicion. Se usa `get()` directo (no
    // getUserData(), que solo lee request.auth.uid) porque aqui se necesita
    // leer el doc de usuarios del llamante para comparar su
    // id_taller_propietario, exactamente igual al patron ya usado en el
    // create de 'usuarios' de arriba para excluir ese mismo campo.
    function actuaPorTaller(tallerId) {
      return request.auth.uid == tallerId ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
           .data.get('id_taller_propietario', null) == tallerId);
    }


    // ¿Es `url` un enlace a un objeto del Storage de ESTE proyecto, bajo la
    // ruta `prefijoRuta`?
    //
    // Existe porque `talleres/{uid}` es de lectura ANONIMA y se alimenta de
    // `usuarios/{uid}` via publishTallerProfile. Cualquier campo de URL que el
    // cliente pueda escribir libremente acaba siendo una URL elegida por el
    // taller que la app de CADA visitante del directorio va a descargar: eso
    // no es una imagen rota, es cosecha de IP y User-Agent de todo el que abra
    // el listado, servida por un tercero.
    //
    // Se ancla el HOST, que es donde esta la amenaza. El segmento del bucket
    // se deja abierto a proposito: el nombre real del bucket es un valor de
    // entorno (FIREBASE_STORAGE_BUCKET) que no vive en el repositorio, y
    // clavarlo aqui obligaria a mantener sincronizados dos sitios sin ganar
    // gran cosa. Lo que queda permitido apuntando a otro bucket de Firebase es
    // contenido, no telemetria: la peticion sigue yendo a un host de Google,
    // nunca a un servidor del atacante.
    //
    // La cadena de consulta se deja libre (`.*`): el token de descarga que
    // añade getDownloadURL() es un detalle del formato de Firebase, y atarlo
    // aqui convertiria un cambio de formato en subidas denegadas.
    function esUrlDeStoragePropia(url, prefijoRuta) {
      return url is string
        && url.size() < 2000
        && url.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/[^/]+/o/' + prefijoRuta + '.*');
    }

    // Las fotos de una resenia son URLs que escribe el CLIENTE en un documento
    // de lectura ANONIMA (`allow read: if true`), asi que el argumento de
    // esUrlDeStoragePropia aplica aqui con una audiencia aun mayor que en
    // `talleres`: sin filtro, el autor de una resenia legitima puede apuntar a
    // un servidor propio y cosechar IP y User-Agent de todo el que abra la
    // ficha del taller, incluido el visitante de la landing.
    //
    // Importa desde FUNC-01: hasta entonces el cliente no escribia `fotos` en
    // un update, y ahora reescribe la lista entera al editar la resenia.
    //
    // El bucle se desenrolla porque las reglas no iteran; el tope de 3
    // (ReviewService.maxFotos) lo hace tratable y de paso acota el tamano de
    // un documento que cualquiera puede leer.
    function fotosBajoServicio(fotos, idServicio) {
      let prefijo = 'resenia_fotos%2F' + idServicio + '%2F';
      return fotos is list
        && fotos.size() <= 3
        && (fotos.size() < 1 || esUrlDeStoragePropia(fotos[0], prefijo))
        && (fotos.size() < 2 || esUrlDeStoragePropia(fotos[1], prefijo))
        && (fotos.size() < 3 || esUrlDeStoragePropia(fotos[2], prefijo));
    }

    // En un update se valida SOLO si `fotos` cambia. `request.resource.data` es
    // el documento resultante, asi que una resenia ya publicada con una URL
    // heredada que no pase el filtro quedaria ineditable —ni siquiera para
    // corregir el texto— si se validara siempre.
    function fotosDeReseniaValidasEnUpdate() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['fotos'])
        || fotosBajoServicio(
             request.resource.data.fotos,
             resource.data.id_servicio,
           );
    }

    // La foto de un vehiculo solo puede apuntar a nuestro propio Storage.
    //
    // Mismo argumento que `fotosBajoServicio`, y con la misma historia detras.
    // `foto_url` la lee todo el que puede leer el vehiculo: el taller
    // vinculado, SUS EMPLEADOS (la regla resuelve por `idTallerActor()`, no
    // por el uid de la sesion), aquel con quien el dueño lo comparta y el
    // admin. Un enlace a un servidor ajeno le entrega a ese tercero la IP y el
    // User-Agent de cada uno de ellos.
    //
    // NO la lee quien recibe un pase de historial, aunque lo pareciera:
    // `leerHistorial` proyecta una allowlist explicita
    // (functions/src/historialCompartido.js:319-327) que no incluye este
    // campo. La audiencia de arriba ya justifica la regla de sobra; se anota
    // para que la proxima auditoria no herede una premisa falsa.
    //
    // Y aqui no era teorico: hasta 2026-09-17 la app RELLENABA este campo sola
    // con enlaces raspados de Google Imagenes (VehicleImageService, retirado),
    // asi que la fuga estaba encendida por defecto en cada vehiculo creado.
    //
    // Vacio o ausente vale: un vehiculo sin foto es lo normal ahora, y la app
    // pinta un placeholder local. `assets/` tambien vale por los documentos
    // heredados que guardaron la ruta del asset como si fuera una URL.
    function fotoDeVehiculoValida(vehiculoId) {
      return !('foto_url' in request.resource.data)
        || request.resource.data.foto_url == null
        || request.resource.data.foto_url == ''
        || request.resource.data.foto_url == 'assets/images/default_vehicle.jpg'
        || esUrlDeStoragePropia(
             request.resource.data.foto_url,
             'vehiculos%2F' + vehiculoId + '%2F',
           );
    }

    // En un update se valida SOLO si `foto_url` cambia, por el mismo motivo
    // que `fotosDeReseniaValidasEnUpdate`: si se validara siempre, los
    // vehiculos que ya tienen guardado un enlace raspado quedarian
    // INEDITABLES —ni el kilometraje, ni el color, ni la revocacion de un
    // taller—, que es cambiar una fuga por una averia. El backfill
    // `functions/backfill_foto_url_ajena.js` los limpia; mientras tanto, esta
    // regla garantiza que no nazca ninguno nuevo.
    function fotoDeVehiculoValidaEnUpdate(vehiculoId) {
      return !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['foto_url'])
        || fotoDeVehiculoValida(vehiculoId);
    }

    // La foto de perfil solo puede apuntar al objeto del propio usuario en
    // `perfiles/` (ver UserService.uploadProfilePhoto, que sube a
    // `perfiles/{uid}.jpg`). Ausente o vacia tambien vale: no todo el mundo
    // tiene foto.
    function fotoDePerfilValida(userId) {
      return !('foto_perfil_url' in request.resource.data)
        || request.resource.data.foto_perfil_url == null
        || request.resource.data.foto_perfil_url == ''
        || esUrlDeStoragePropia(request.resource.data.foto_perfil_url, 'perfiles%2F' + userId);
    }

    // La galeria comercial NO guarda URLs, guarda nombres de hueco ('logo',
    // 'local-1'...). La ruta de Storage se reconstruye a partir del uid y del
    // hueco, los dos de confianza, asi que por construccion no hay ninguna URL
    // que un taller pueda elegir. Ver GaleriaTaller.
    //
    // Aqui solo se acota el tamaño: sin tope, un taller podria escribir una
    // lista enorme que publishTallerProfile copiaria tal cual al documento
    // publico. Que los nombres sean validos lo resuelve el parseo del modelo,
    // que descarta cualquier hueco fuera del whitelist.
    function galeriaValida() {
      return !('galeria' in request.resource.data)
        || (request.resource.data.galeria is list
            && request.resource.data.galeria.size() <= 7);
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. Tabla de Usuarios
    match /usuarios/{userId} {
      // Cada usuario lee unicamente su propio documento. El perfil publico de
      // los talleres vive en la coleccion `talleres`, proyectado por la Cloud
      // Function publishTallerProfile.
      allow read: if isOwner(userId) || isAdmin();

      // Permitir la creación de su propio perfil de usuario durante registro/onboarding.
      // Ademas de exigir rol == 'Propietario' (ningun rol privilegiado por
      // auto-registro):
      // - 'id_taller_propietario' queda bloqueado por completo: no tiene un
      //   valor por defecto seguro y el cliente (UserModel) nunca lo escribe,
      //   asi que un create que lo incluya solo puede ser un intento de
      //   auto-vincularse a un taller ajeno.
      // - 'estado' / 'calificacion_promedio' / 'total_resenias' SI viajan en
      //   el payload real del cliente (UserModel.toMap() siempre los incluye
      //   con sus valores por defecto: 'activo', 0.0, 0 — ver
      //   user_service.dart createUserData(), rama de usuario nuevo), asi que
      //   bloquearlos por completo rompe el registro real. En su lugar se
      //   permiten solo con su valor por defecto inofensivo: eso deja pasar
      //   el registro legitimo pero sigue bloqueando que alguien se plante
      //   un estado 'aprobado' o una reputacion no nula desde el create.
      //
      // AMPLIACION (alta de mecanico): el auto-registro tambien admite
      // rol == 'Mecanico', pero SOLO con estado == 'pendiente'. Antes solo se
      // aceptaba 'Propietario', asi que elegir "Mecanico" en profile_setup
      // moria en permission-denied: updateProfile() devolvia false, userData
      // seguia null y resolveRedirect() rebotaba a /profile_setup una y otra
      // vez (bucle de registro).
      // 'pendiente' NO esta en estadosMecanicoAprobado ({'aprobado','activo'},
      // ver app_router.dart e isMecanico() aqui abajo), asi que la cuenta
      // recien creada queda retenida en /mechanic_pending sin ningun acceso de
      // taller hasta que un admin la apruebe. Y como 'estado' esta excluido del
      // allow update del propio usuario, el mecanico no puede autoaprobarse
      // despues: el unico camino a 'activo'/'aprobado' pasa por AdminService.
      //
      // Los accesos a 'rol' y 'estado' van guardados con `in` / `.get()` a
      // proposito. Sin el guarda, un create sin 'rol' no se DENIEGA: revienta
      // con "Property rol is undefined on object", que es un error de
      // evaluacion. El efecto neto sobre ese write es el mismo (no pasa), pero
      // el modo de fallo es peor: el mensaje no dice que regla fallo, no se
      // puede razonar sobre el como sobre un `false`, y en cuanto esta
      // condicion se meta dentro de un `||` el error se propaga y tumba
      // tambien la rama que si deberia conceder. Se prefiere denegar limpio.
      allow create: if isOwner(userId)
                    && !('id_taller_propietario' in request.resource.data)
                    && (!('calificacion_promedio' in request.resource.data) || request.resource.data.calificacion_promedio == 0)
                    && (!('total_resenias' in request.resource.data) || request.resource.data.total_resenias == 0)
                    && 'rol' in request.resource.data
                    && fotoDePerfilValida(userId)
                    && galeriaValida()
                    && (
                         (request.resource.data.rol == 'Propietario'
                            && request.resource.data.get('estado', 'activo') == 'activo')
                         || (request.resource.data.rol == 'Mecanico'
                            && request.resource.data.get('estado', '') == 'pendiente')
                       );
      
      // El usuario puede editar su propio perfil básico, pero no puede tocar
      // 'rol' (escalamiento de privilegios) ni las métricas agregadas de
      // reputación, que solo debe escribir el backend (aggregateRatings, ya
      // escribe en 'usuarios' con Admin SDK y por tanto no necesita ningún
      // permiso de cliente aquí: el hueco de "cualquier autenticado puede
      // parchear calificacion_promedio/total_resenias" que existía en la
      // rama del colaborador para su recálculo client-side ya no aplica).
      // Los administradores tienen acceso completo para cambiar roles o estados.
      // 'estado' tambien queda excluido: es el campo que el directorio publico
      // de talleres usa para filtrar por 'aprobado' (ver publishTallerProfile),
      // asi que un mecanico no puede autoaprobarse saltandose admin_service.
      // 'id_taller_propietario' tambien queda excluido: es el campo que
      // vincula a un empleado con su taller dueño (ver crearEmpleadoTaller,
      // que lo fija con Admin SDK al crear la cuenta). Sin esta exclusion,
      // cualquier usuario podria auto-asignarse como empleado de un taller
      // ajeno con un solo update.
      // Un Administrador conserva acceso total salvo para asignar el propio
      // rol 'Administrador' o 'Superusuario': eso queda exclusivo de
      // isSuperUser(). Solo se bloquea cuando el update efectivamente toca
      // 'rol' Y el valor resultante es uno de esos dos — así un Administrador
      // sigue pudiendo aprobar/suspender/reasignar a Propietario/Mecanico
      // sin restricciones nuevas.
      //
      // fotoDePerfilValida/galeriaValida se aplican a la rama del PROPIO
      // usuario y no a la de administracion: el vector es el taller que se
      // publica a si mismo una URL ajena en un documento de lectura anonima.
      // Un administrador que escriba una URL rara es un problema distinto —y
      // ya tiene permisos para mucho mas—, y ademas es quien tiene que poder
      // corregir a mano un dato heredado que no case con el formato nuevo.
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['rol', 'calificacion_promedio', 'total_resenias', 'estado', 'id_taller_propietario', 'suma_estrellas'])
                          && fotoDePerfilValida(userId)
                          && galeriaValida())
                    || isSuperUser()
                    || (isAdmin() && !(
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']) &&
                         request.resource.data.rol in ['Administrador', 'Superusuario']
                       ));

      // Hard delete de cuentas es exclusivo de Superusuario (ver
      // superUserDeleteAccount en functions/index.js, que además borra la
      // cuenta de Firebase Auth vía Admin SDK — este delete de Firestore
      // por sí solo nunca lo hace).
      allow delete: if isSuperUser();
    }

    // 2. Tabla de Talleres
    match /talleres/{tallerId} {
      // El directorio de talleres es de lectura publica.
      allow read: if true;

      // Solo la Cloud Function publishTallerProfile (Admin SDK) escribe aqui.
      // El flujo de calificaciones del colaborador (mecanico/cualquier
      // autenticado escribiendo calificacion_promedio/total_resenias) no
      // aplica: esos campos viven en 'usuarios', no en 'talleres' (ver
      // aggregateRatings en functions/index.js), y el editor de perfil del
      // taller (workshop_settings_screen.dart) escribe en 'usuarios' via
      // UserService, nunca en esta colección.
      allow create, update: if isAdmin();

      allow delete: if isAdmin();

      // Sub-cuentas de empleados del taller (Tarea 8, EmpleadoRepository).
      // Las reglas no se heredan de la coleccion padre, asi que esta
      // subcoleccion necesita su propio match aunque 'talleres/{tallerId}'
      // ya tenga reglas arriba.
      match /empleados/{empleadoId} {
        // Solo el dueño del taller (tallerId == su propio uid) o un admin
        // pueden ver la lista de empleados; ni siquiera el empleado mismo
        // necesita leer esta subcoleccion (EmpleadosScreen la usa solo
        // desde la vista del dueño).
        allow read: if isAuthenticated() && (request.auth.uid == tallerId || isAdmin());

        // El unico write de cliente real es EmpleadoRepository.desactivarEmpleado(),
        // que solo cambia 'activo'. crearRegistroEmpleado() (Tarea 6) nunca
        // se invoca en la app: crearEmpleadoTaller (Cloud Function) crea el
        // documento con el Admin SDK, que bypassea estas reglas por completo.
        allow update: if isAuthenticated() && request.auth.uid == tallerId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo']);

        allow create, delete: if isAdmin();
      }

      // Invitaciones a unirse al taller como empleado (observaciones del
      // 2026-09-19): las crea `crearEmpleadoTaller` cuando el correo ya tiene
      // cuenta, y solo `responderInvitacionEmpleo` las resuelve — los dos con
      // Admin SDK. Van en su propia subcoleccion y NO en `empleados` a
      // proposito: `desactivarEmpleadoTaller` trata un documento de
      // `empleados` como prueba de que la cuenta es del taller, y una
      // invitacion todavia no lo es.
      match /invitaciones/{invitadoId} {
        // Solo el taller (y admin). La persona invitada NO: la app le da todo
        // lo que necesita en la notificacion, y leer el documento le
        // ensenaria el telefono y el nombre que tecleo el taller aunque
        // hubiera registrado ese correo sin ser su dueno (revision del
        // 2026-09-19). Tampoco los empleados del taller: gestionar la
        // plantilla es cosa del dueno, igual que en `empleados`.
        allow read: if isAuthenticated() &&
          (request.auth.uid == tallerId || isAdmin());
        // El taller puede retirar una invitacion que ya no quiere.
        allow delete: if isAuthenticated() && (request.auth.uid == tallerId || isAdmin());
        allow create, update: if false;
      }

      // Catálogo de servicios/repuestos rápidos del taller (Tarea 9,
      // CatalogoRepository). Igual que 'empleados', esta subcoleccion
      // necesita su propio match aunque 'talleres/{tallerId}' ya tenga
      // reglas arriba.
      match /catalogo_servicios/{itemId} {
        allow read: if true;
        // Ampliado (fix de integracion de empleados) para aceptar tambien a
        // una sub-cuenta de empleado actuando en nombre de `tallerId` via
        // actuaPorTaller(): antes solo `request.auth.uid == tallerId`
        // (el dueño real) podia escribir, dejando al empleado sin poder
        // gestionar el catalogo aunque `initiate_service_screen.dart` /
        // `catalogo_servicios_screen.dart` ya resuelven el id efectivo del
        // taller (dueño) y no el propio uid del empleado.
        allow create, update, delete: if isAuthenticated() && actuaPorTaller(tallerId);
      }
    }

    // 2.b Expedientes de verificacion de taller
    //
    // Contrapartida PRIVADA de 'talleres': ahi vive la ficha publica
    // (allow read: if true), aqui el tramite. Nunca se mezclan — este
    // documento guarda el motivo de un rechazo, quien reviso y el rastro de
    // los documentos de identidad del negocio, y publishTallerProfile ni
    // siquiera mira esta coleccion, asi que una fuga por descuido de
    // CAMPOS_PUBLICOS es estructuralmente imposible.
    //
    // Ojo con los dos ejes: 'estado_verificacion' NO concede acceso. Quien
    // opera lo sigue diciendo usuarios/{uid}.estado via isMecanico(), que no
    // se toca. Este campo solo gobierna el flujo de onboarding.
    match /verificaciones/{tallerId} {
      allow read: if isAuthenticated() && (request.auth.uid == tallerId || isAdmin());

      // Un taller solo puede dejar SU expediente en 'listo_para_revision', o
      // no tocar el estado en absoluto (subir evidencia). 'en_revision'
      // (tomar el caso) y 'aprobada'/'rechazada' (resolverlo) son exclusivos
      // de isAdmin(): sin esto un taller se autoverifica con un solo write,
      // que es el mismo agujero que ya cierra la exclusion de 'estado' en el
      // allow update de 'usuarios'.
      //
      // 'perfil_incompleto' TAMPOCO lo puede escribir el taller, aunque sea un
      // estado "menor". Nada en la app lo escribe —es solo el valor por
      // defecto al leer un expediente que no existe— y dejarselo escribir
      // abria la puerta de atras de la re-revision: un taller aprobado edita
      // su direccion, la Cloud Function le devuelve el expediente a la cola, y
      // el se autodegrada a 'perfil_incompleto' para desaparecer de la bandeja
      // del administrador conservando la cuenta activa. La condicion se
      // escribe sobre la AUSENCIA de la clave para que un write que no habla
      // del estado (subir evidencia, incluida la creacion del expediente con
      // el primer archivo) siga pasando.
      //
      // Los tres campos de resolucion (motivo_rechazo, revisado_por,
      // fecha_revision) no pueden ESTAR en el documento resultante de un
      // write del taller. Se comprueba sobre el resultado y no sobre el diff
      // a proposito: asi el taller puede BORRARLOS al reenviar tras un
      // rechazo —que es justo lo que hace copyWith(limpiarMotivoRechazo:
      // true)— pero no puede escribirlos. El historial de la resolucion no se
      // pierde: queda en admin_logs, igual que el resto de acciones de
      // administracion.
      //
      // Lo que estas reglas NO validan es que el perfil este realmente
      // completo cuando el taller escribe 'listo_para_revision': exigiria un
      // get() de usuarios/{uid} y replicar aqui la lista de campos de
      // AppEstadoVerificacion.camposFaltantes, duplicando una fuente de
      // verdad por un chequeo que no protege nada — un expediente enviado en
      // falso solo consigue que un administrador lo mire y lo rechace.
      function esWriteDeTaller() {
        return request.auth.uid == tallerId
          && (!('estado_verificacion' in request.resource.data)
              || request.resource.data.estado_verificacion == 'listo_para_revision')
          && !request.resource.data.keys().hasAny(['motivo_rechazo', 'revisado_por', 'fecha_revision']);
      }

      // 'reapertura' la escribe la Cloud Function con SDK de Admin y dice POR
      // QUE un expediente ya aprobado volvio a la cola. Es lo unico que el
      // administrador tiene para saber que mirar, asi que el taller no puede
      // borrarla de un set(merge:false). No se exige que sea inmutable —solo
      // que siga estando—: quien la escribe salta estas reglas de todas
      // formas, y lo que hay que impedir es el borrado.
      function conservaLaReapertura() {
        return !('reapertura' in resource.data)
          || 'reapertura' in request.resource.data;
      }

      allow create: if isAuthenticated() && (esWriteDeTaller() || isAdmin());
      allow update: if isAuthenticated()
                    && ((esWriteDeTaller() && conservaLaReapertura()) || isAdmin());

      // El expediente es el rastro de la verificacion: solo un admin lo borra.
      allow delete: if isAdmin();
    }

    // 3. Tabla de Vehículos
    match /vehiculos/{vehiculoId} {
      // Un mecánico solo puede leer el vehículo si su taller ya tiene una
      // relación de servicio con él (talleres_vinculados, poblado por la
      // Cloud Function requestReviewOnServiceComplete al crear un servicio).
      // La búsqueda de vehículos nuevos por placa NO usa esta regla: pasa
      // por la Cloud Function callable buscarVehiculoPorPlaca, que devuelve
      // solo datos identificatorios sin exponer el documento completo.
      //
      // `resource == null` (documento inexistente) se permite explicitamente.
      // Sin esa rama, un get() sobre un id que aun no existe no devuelve "no
      // existe": evalua `resource.data.id_propietario` sobre null, lo que es
      // un error de evaluacion y se traduce en PERMISSION_DENIED. La rama se
      // escribio para VehicleImageService (retirado el 2026-09-17), que
      // consultaba el vehiculo ANTES de que addVehicle() lo escribiera; se
      // conserva porque la propiedad sigue siendo la correcta y su ausencia
      // vuelve a convertir "no existe" en "prohibido".
      // No filtra nada: un documento inexistente no tiene datos que exponer, y
      // los ids son UUID, no enumerables.
      allow read: if isAuthenticated() && (
        resource == null
        || resource.data.id_propietario == request.auth.uid
        || isAdmin()
        // `idTallerActor()` y no `request.auth.uid`: `talleres_vinculados`
        // guarda SIEMPRE el uid del DUEÑO del taller, asi que comparar contra
        // el uid de la sesion dejaba a los EMPLEADOS sin poder leer el
        // vehiculo de un coche que su propio taller esta atendiendo.
        || (isMecanico() && resource.data.get('talleres_vinculados', []).hasAny([idTallerActor()]))
        // Usuarios con quien el propietario comparte el vehiculo (ver
        // share_vehicle_sheet.dart) obtienen SOLO lectura aqui; a proposito
        // esto NO se agrega a isVehicleOwner(), que sigue significando "es
        // el dueño real" para isOwnFinishedService/servicios/reseñas.
        || resource.data.get('shared_with', []).hasAny([request.auth.uid])
      );

      // Solo el propietario registrado del vehículo puede crearlo o eliminarlo
      allow create: if isAuthenticated()
        && request.resource.data.id_propietario == request.auth.uid
        && fotoDeVehiculoValida(vehiculoId);
      allow delete: if isAuthenticated() && resource.data.id_propietario == request.auth.uid;

      // El propietario puede modificar todo su vehículo MENOS de quién es:
      // esta rama autoriza con `resource.data.id_propietario` (el documento
      // viejo) y no acotaba campos, así que el dueño podía REGALAR el coche
      // reescribiendo ese mismo campo. El vehículo aparecía en el panel de la
      // víctima como suyo, con su historial y sus alertas colgando de él, y
      // el atacante ya no podía deshacerlo: el update que le quitaba el
      // permiso era el último que las reglas le permitían.
      // `talleres_conocidos` también se congela, y por un motivo distinto: la
      // cabecera de este archivo (ver tallerConoceElVehiculo) declara que es
      // append-only y que solo lo escribe recibirTicketYVincular con Admin
      // SDK, pero nada lo hacía cumplir. Vaciarlo junto con
      // `talleres_vinculados` devuelve el vehículo al estado que la rama de
      // walk-in de puedeMecanicoAtenderVehiculo lee como "coche que ningún
      // taller ha atendido jamás", y ese estado lo abre a CUALQUIER mecánico:
      // es el agujero que cerró la ronda 6, reabierto desde el lado del
      // propietario. Ningún flujo de cliente escribe este array.
      // `talleres_vinculados`, en cambio, se deja fuera del acotado a
      // propósito — es la primitiva de consentimiento que el propio dueño
      // escribe desde VehicleService.confirmarVinculoTaller /
      // .rechazarVinculoTaller / .revocarAccesoTaller
      // (vehicle_service.dart:57-127); congelarla rompería el modelo de
      // vínculos de las rondas 5/6.
      // Un mecánico de un taller ya vinculado puede actualizar el vehículo
      // únicamente para reportar el 'kilometraje_actual'.
      // `fotoDeVehiculoValidaEnUpdate` va FUERA de la disyuncion, igual que
      // `fotosDeReseniaValidasEnUpdate` en /resenias: dentro de la rama del
      // propietario, el `|| isAdmin()` del final la esquivaba entera, y un
      // admin podia plantar un enlace ajeno en el vehiculo de cualquiera sin
      // dejar rastro en `admin_logs` (ese update no pasa por admin_service).
      // Sacarla no rompe la rama del mecanico: con `hasOnly(['kilometraje_
      // actual'])` `foto_url` nunca esta en `affectedKeys()`, asi que la
      // funcion devuelve true por su primera clausula y un vehiculo con
      // enlace heredado sigue aceptando el reporte de kilometraje.
      allow update: if isAuthenticated()
        && fotoDeVehiculoValidaEnUpdate(vehiculoId)
        && (
        (resource.data.id_propietario == request.auth.uid
          && !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['id_propietario', 'talleres_conocidos']))
        // Mismo motivo que en la lectura: comparar contra idTallerActor(),
        // no contra el uid de la sesion, para que un empleado del taller
        // vinculado pueda reportar el kilometraje.
        || (isMecanico()
            && resource.data.get('talleres_vinculados', []).hasAny([idTallerActor()])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kilometraje_actual']))
        || isAdmin()
      );

      // Galeria de fotos del vehiculo (VehiclePhotoService: streamPhotos /
      // addPhoto / deletePhoto sobre vehiculos/{id}/fotos/{fotoId}).
      // Las reglas NO se heredan de la coleccion padre, asi que sin este match
      // anidado tanto el stream como el set() morian en permission-denied y la
      // galeria aparecia siempre vacia y sin poder subir nada.
      //
      // Lectura: el mismo publico que ya puede leer el vehiculo (dueño,
      // taller vinculado, alguien con quien se compartio, admin). Se
      // reevalua contra el documento padre en vez de duplicar la condicion,
      // para que no se desincronicen.
      // Escritura: solo el dueño real (o admin). Un taller vinculado puede
      // ver las fotos pero no añadir ni borrar: la galeria es del propietario.
      match /fotos/{fotoId} {
        function vehiculo() {
          return get(/databases/$(database)/documents/vehiculos/$(vehiculoId)).data;
        }
        function puedeVerVehiculo() {
          return isAuthenticated()
            && exists(/databases/$(database)/documents/vehiculos/$(vehiculoId))
            && (
                 vehiculo().id_propietario == request.auth.uid
                 || isAdmin()
                 // `idTallerActor()`, no `request.auth.uid`: mismo criterio
                 // que la regla del vehiculo padre (arriba). La ronda
                 // anterior cambio el padre y dejo esta copia atras, que es
                 // justo lo que el comentario de encima decia que no debia
                 // pasar: un EMPLEADO de un taller vinculado podia leer el
                 // vehiculo pero recibia permission-denied en su galeria, asi
                 // que la ficha del servicio le salia sin fotos.
                 || (isMecanico() && vehiculo().get('talleres_vinculados', []).hasAny([idTallerActor()]))
                 || vehiculo().get('shared_with', []).hasAny([request.auth.uid])
               );
        }
        allow read: if puedeVerVehiculo();

        // `url` es una URL que elige el CLIENTE, y sus lectores son los
        // mismos que los de `foto_url` del vehiculo padre: el taller
        // vinculado, sus empleados, aquel con quien se comparta el coche y el
        // admin. Sin este filtro, el dueño de un vehiculo podia escribir aqui
        // `{url: 'https://servidor-propio/pixel.jpg'}` SIN subir nada a
        // Storage y cosechar la IP y el User-Agent de todos ellos cada vez que
        // abrieran la ficha. Es el mismo agujero que se cierra un nivel mas
        // arriba, por la puerta de al lado, y lo levanto el gate de revision.
        //
        // El prefijo encaja con lo que sube `VehiclePhotoService.addPhoto`:
        // `vehiculos/{id}/fotos/{uuid}.jpg`.
        //
        // El `delete` va en su PROPIO allow y no agrupado con los otros dos:
        // en un delete `request.resource` es null, asi que validar el
        // documento resultante denegaria todo borrado. Es el mismo error de
        // agrupar verbos que GAPS-05 anoto para las facturas en Storage.
        allow create, update: if isAuthenticated()
          && (isVehicleOwner(vehiculoId) || isAdmin())
          && esUrlDeStoragePropia(
               request.resource.data.get('url', ''),
               'vehiculos%2F' + vehiculoId + '%2Ffotos%2F',
             );
        allow delete: if isAuthenticated()
          && (isVehicleOwner(vehiculoId) || isAdmin());
      }
    }

    // 4. Tabla de Servicios (Historial de Mantenimiento)
    match /servicios/{servicioId} {
      // MITIGACION PARCIAL (hallazgo critico C1 de la revision adversarial de
      // Fase C): la version anterior permitia a cualquier mecanico crear un
      // 'servicios' para CUALQUIER id_vehiculo con solo poner su propio uid
      // en id_taller, lo que el trigger requestReviewOnServiceComplete
      // traducia automaticamente en un talleres_vinculados permanente sobre
      // el vehiculo de otro, reabriendo exactamente la fuga que la Tarea 9
      // cerro (ver isVinculadoAlVehiculo). No existe hoy en el modelo de
      // datos un campo fiable de "reserva o cotizacion aceptada" referenciado
      // desde 'servicios' que las reglas puedan verificar con get()/exists():
      // ni reservas ni cotizaciones se referencian por id desde el documento
      // de servicio, y la busqueda de vehiculo por placa (Cloud Function
      // buscarVehiculoPorPlaca) esta deliberadamente abierta a cualquier
      // mecanico para soportar el flujo real de "cliente que llega sin cita"
      // (ver vehicle_search_screen.dart -> initiate_service_screen.dart),
      // que por diseno no tiene ninguna relacion previa que verificar.
      // Como mitigacion NO rompe ese flujo legitimo: reduce el alcance de la
      // fuga de "cualquier vehiculo, en cualquier momento" a "solo vehiculos
      // que ningun taller ha atendido todavia". Un vehiculo que ya tiene un
      // taller vinculado deja de poder ser secuestrado por uno distinto sin
      // pasar por el mismo taller.
      //
      // CIERRE COMPLETO (tarea C1-cierre): ya implementado. El trigger
      // requestReviewOnServiceComplete (functions/index.js) ya NO otorga
      // talleres_vinculados automaticamente cuando el vehiculo nunca tuvo
      // taller vinculado: en su lugar marca taller_pendiente_confirmacion
      // en el vehiculo y notifica al propietario (writeNotification + FCM).
      // El vinculo permanente solo se otorga cuando el propietario confirma
      // explicitamente desde su panel (VehicleService.confirmarVinculoTaller
      // / rechazarVinculoTaller), una escritura directa sobre su propio
      // /vehiculos ya permitida por la clausula de "allow update" de abajo
      // (resource.data.id_propietario == request.auth.uid, sin restriccion
      // de campos) — no requirio ningun cambio de regla nueva. La regla de
      // 'servicios' create de aqui abajo sigue siendo necesaria tal cual
      // esta: permite crear el servicio del walk-in (que dispara el
      // trigger), porque el vinculo permanente ahora depende de ese paso
      // posterior fuera de esta coleccion.
      //
      // RAMA DEL PROPIETARIO (mantenimiento hecho por uno mismo): la version
      // anterior solo admitia admin o mecanico, pero el flujo real de
      // task_complete_screen.dart -> AlertProvider.userCompleteTask() lo
      // ejecuta el PROPIETARIO del vehiculo, con el centinela
      // id_taller == 'Manual (Propietario)'. Sin esta rama, completar un
      // servicio manual moria en permission-denied despues de haber subido ya
      // la factura a Storage, dejando el archivo huerfano.
      // No reabre el hallazgo C1: el centinela no es el uid de ningun taller y
      // el trigger requestReviewOnServiceComplete descarta explicitamente los
      // id_taller que contienen 'Manual' (functions/index.js), asi que este
      // create no puede otorgar talleres_vinculados a nadie.
      // Nota (fix de integracion de empleados, mismo patron ya aplicado a
      // 'reparaciones'): las 3 comparaciones de abajo usan actuaPorTaller()
      // en vez de `== request.auth.uid` directo, y el carve-out de walk-in
      // compara 'talleres_vinculados' contra id_taller (el uid del DUEÑO,
      // que es lo que InitiateServiceScreen ya resuelve via
      // UserModel.idTallerEfectivo) en vez de contra request.auth.uid — sin
      // esto, una sub-cuenta de empleado no podia finalizar el servicio de
      // NINGUN cliente que ya tuviera vinculo (talleres_vinculados guarda el
      // uid del dueño, nunca el del empleado que atiende).
      // La condicion del mecanico se delega en puedeMecanicoAtenderVehiculo()
      // en vez de repetirse aqui: estaba duplicada palabra por palabra en tres
      // reglas ('servicios'.create, 'historial_mantenimientos'.create y
      // 'mantenimientos'.update) y la revision adversarial encontro que
      // arreglar el carve-out en una sola de ellas no cerraba nada. Ahora hay
      // un unico sitio donde cambiarlo.
      // `actuaPorTaller(id_taller)` se conserva aparte: ata el id_taller
      // ESCRITO al actor, que es lo que impide suplantar a otro taller, y el
      // helper solo razona sobre idTallerActor().
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isVehicleOwner(request.resource.data.id_vehiculo)
          && request.resource.data.id_taller == 'Manual (Propietario)') ||
        (isMecanico() && actuaPorTaller(request.resource.data.id_taller)
          && puedeMecanicoAtenderVehiculo(request.resource.data.id_vehiculo))
      );
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
        || (isMecanico() && actuaPorTaller(resource.data.id_taller))
      );
      // Un mecanico puede seguir actualizando su propio servicio (costo,
      // descripcion, materiales, etc.) pero NO puede reescribir id_vehiculo
      // ni id_taller: sin esta exclusion, un taller podia crear un servicio
      // legitimo en un vehiculo propio y luego, via update, apuntarlo al
      // vehiculo de una victima, inyectando un registro de servicio falso
      // en su historial (hallazgo Important, revision de la 2a ronda de
      // Fase C; adyacente a C1, no es un bypass de talleres_vinculados
      // porque ese trigger es solo onCreate).
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isMecanico() && actuaPorTaller(resource.data.id_taller)
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['id_vehiculo', 'id_taller']))
      );

      allow delete: if isAdmin();
    }

    // Inventario de campos legitimos de /alertas, en un solo sitio para que el
    // create y el update no puedan divergir. Espejo de `AlertModel.toMap()`
    // (lib/core/models/alert_model.dart:57-71).
    function camposDeAlerta() {
      return [
        'id_alerta', 'id_vehiculo', 'tipo_alerta', 'titulo', 'descripcion',
        'fecha_limite', 'kilometraje_objetivo', 'estado', 'prioridad',
        'metadata', 'avisos_pendientes'
      ];
    }

    // Los mismos menos `id_vehiculo` y menos `id_alerta`, que son identidad.
    //
    // `id_vehiculo`, porque reasignar una alerta a otro vehiculo no es una
    // operacion legitima (ver el comentario del update).
    //
    // `id_alerta`, porque es un espejo del id del documento y la app lo usa
    // como DESTINO de la escritura al completar la alerta
    // (`alert_provider.dart:296-307`). Dejarlo mutable —como quedo en el primer
    // intento de esta regla— permite al propietario reescribirlo a un id con
    // uno de los prefijos sinteticos (`soat_`, `task_`...), que hacen que ese
    // write se salte en silencio: la alerta se pinta completada y sigue
    // `Pendiente` en el servidor, avisando por push para siempre. No cruza el
    // limite de usuario, asi que es integridad, no IDOR — pero no hay ningun
    // flujo que actualice el campo, asi que cerrarlo es gratis. Lo encontro el
    // gate de revision de reglas.
    function camposMutablesDeAlerta() {
      return [
        'tipo_alerta', 'titulo', 'descripcion', 'fecha_limite',
        'kilometraje_objetivo', 'estado', 'prioridad', 'metadata'
      ];
    }

    // 5. Tabla de Alertas y Recordatorios
    // Restringido: solo el propietario del vehículo vinculado o admin puede gestionar alertas
    match /alertas/{alertaId} {
      // Lectura: propietario del vehículo vinculado, mecánico con relación, o admin
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      // Creación: propietario del vehículo o admin.
      //
      // El acotado de los campos del servidor tiene que estar también aquí, y
      // no solo en el update: sin él, el propietario crea la alerta **ya
      // silenciada** (`ultimo_aviso: 'vencida'`) y el barrido no la avisa
      // nunca, ni por vencer ni vencida. Que la interfaz actual no lo haga no
      // es una compuerta: cualquier cliente autenticado escribe por SDK o por
      // REST. Y es irreversible desde el cliente, porque el `allow update` de
      // abajo bloquea justamente esa clave.
      //
      // Va con `keys()` y no con `diff()` porque en un create no hay
      // `resource.data` contra el que comparar.
      //
      // Y va por ALLOWLIST (`hasOnly`), no por denylist
      // (`hasAny`), que es como estaba. Una denylist enumera lo prohibido, asi
      // que cubre los campos de servidor que existian el dia que se escribio y
      // deja nacer escribible cualquiera posterior. Ahi mismo llego el
      // hallazgo de SEC-04 —se podia crear la alerta ya silenciada— y el
      // `avisos_pendientes` que traera la denormalizacion del barrido seria el
      // siguiente. El inventario sale de `AlertModel.toMap()`
      // (lib/core/models/alert_model.dart:57-71): si el modelo gana un campo,
      // este `hasOnly` tiene que ganarlo tambien, y quien lo obliga es el
      // centinela `test/alertas_campos_test.dart`, que cruza las dos listas en
      // las dos direcciones. Sin el, un campo nuevo del modelo se denegaria
      // solo en produccion.
      allow create: if isAuthenticated() && (
        isVehicleOwner(request.resource.data.id_vehiculo)
        || isAdmin()
      //
      // GAPS-05 anade `hasAll` al `hasOnly`. `hasOnly` acota por ARRIBA (nada
      // fuera de la lista) y admitia cualquier subconjunto, incluido el vacio:
      // se podia crear una alerta SIN `estado`, y el barrido diario filtra por
      // `where('estado','==','Pendiente')` (`alertasVencidas.js:97`), asi que
      // esa alerta no avisa nunca. Es auto-silenciarse, y es irreversible en la
      // practica porque nadie vuelve a mirar un documento que no sale en
      // ninguna consulta.
      //
      // Exigir el documento entero no rompe la app: en `lib/` **no hay ningun
      // creador cliente de /alertas**. Los cuatro accesos a la coleccion son
      // dos `snapshots()`, un borrado en lote y un `update({'estado': ...})`;
      // las alertas las crea el servidor con Admin SDK, que no pasa por aqui.
      //
      // El tipo de `estado` se ata porque un numero o un booleano no casan con
      // la igualdad de la consulta: seria el mismo silencio por otra via.
      //
      // Y el VALOR de `estado` se pinea al inicial, no solo su tipo: el filtro
      // del barrido es `== 'Pendiente'`, asi que nacer 'Completada' es tan
      // invisible como nacer sin el campo. `hasAll` cerraba una de las tres
      // formas de auto-silenciarse; esta es la segunda. (La tercera va en el
      // `update`, con `fecha_limite`.)
      ) && request.resource.data.keys().hasOnly(camposDeAlerta())
        && request.resource.data.keys().hasAll(camposDeAlerta())
        && request.resource.data.estado == 'Pendiente'
      //
      // `avisos_pendientes` se pinea a `true` por el mismo motivo que `estado`,
      // y es la tercera forma de auto-silenciarse que se cierra. Es la
      // denormalizacion que el barrido consulta desde GAPS-05
      // (`alertasVencidas.js`): nacer con `false` deja la alerta fuera de la
      // consulta diaria desde el minuto uno, igual de invisible que nacer sin
      // `estado`. El servidor es el unico que puede apagarlo, y solo al
      // consumir el ultimo escalon.
        && request.resource.data.avisos_pendientes == true
      //
      // `id_alerta` atado al id del documento. El update ya lo saca de los
      // mutables porque reescribirlo a un prefijo sintetico (`soat_`, `task_`)
      // hace que `completeAlert` se salte la escritura en silencio y la alerta
      // quede pintada como completada y `Pendiente` en el servidor. Ese mismo
      // estado se alcanzaba **de nacimiento**, porque el create no ataba el
      // campo. Lo levanto el gate de revision de GAPS-05; cerrarlo es una
      // linea, y sin ella el acotado del update solo cubre la mitad.
        && request.resource.data.id_alerta == alertaId;

      // Actualización: propietario del vehículo o admin.
      // El acotado va FUERA del paréntesis a propósito, así que ata también a
      // isAdmin() — al contrario que en /servicios y /reparaciones, donde el
      // admin queda exento del guard equivalente. Reasignar un registro al
      // vehículo de otra persona no es una operación legítima de moderación:
      // una corrección real de ese tipo se hace con Admin SDK, que no pasa
      // por estas reglas. Mismo criterio en /mantenimientos y
      // /historial_mantenimientos.
      // `id_vehiculo` es inmutable: la autorización de arriba mira el
      // documento VIEJO (resource.data), así que sin este acotado el dueño de
      // v1 podía reescribir id_vehiculo a v2 y colar la alerta en el coche de
      // otra persona — un update legítimo sobre un documento propio que acaba
      // escribiendo sobre datos ajenos. Ningún flujo real reasigna una alerta
      // de vehículo: se borra y se crea.
      //
      // `ultimo_aviso` y `fecha_ultimo_aviso` son contabilidad del servidor
      // (OPS-01): el barrido diario los usa para no reenviar el mismo aviso
      // cada 24 h. Los escribe `checkAlertsDaily` con Admin SDK, que no pasa
      // por estas reglas; un cliente que pudiera borrarlos o retrasarlos se
      // devolvería a sí mismo el push diario que el arreglo elimina. Se atan
      // por `affectedKeys()` y no por valor a propósito: atar el valor deja
      // pasar un `FieldValue.delete()`, que es cómo se esquivó una regla
      // equivalente en la tanda de drenaje anterior.
      //
      // Como el create, va por allowlist: la lista de abajo son los campos del
      // modelo MENOS `id_vehiculo`, que es inmutable por el parrafo anterior.
      // `ultimo_aviso` y `fecha_ultimo_aviso` quedan fuera por no estar
      // dentro, que es justo la propiedad que la denylist no tenia.
      allow update: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      //
      // Y `estado` no se puede QUITAR ni cambiar de tipo: cerrar el create y
      // dejar el update abierto deja llegar al mismo sitio en dos pasos, con un
      // `FieldValue.delete()`. Es la leccion de `abierto` en GAPS-02 — se podia
      // borrar aunque no se pudiera falsear.
      //
      // Se escribe como «si lo tenia, lo sigue teniendo» y NO como «tiene que
      // tenerlo», a proposito: exigirlo a secas dejaria sin poder editar —ni
      // completar— cualquier alerta heredada que naciera sin el campo. Es la
      // misma trampa que el `orderBy` que excluye documentos sin el campo, y
      // aqui se puede evitar sin backfill.
      ) && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(camposMutablesDeAlerta())
        && (!('estado' in resource.data)
            || ('estado' in request.resource.data
                && request.resource.data.estado is string))
      //
      // Y `fecha_limite`, que SI es mutable, no puede quedar en un tipo que el
      // barrido no sepa leer. El barrido tiene DOS filtros, no uno: el
      // `where('estado','==','Pendiente')` de la consulta y, dentro del bucle,
      // `leerFechaLimite()` — lo que no puede parsear lo cuenta como
      // `ilegibles` y sigue. O sea que dejar ahi una cadena saca la alerta del
      // aviso para siempre mientras la deja `Pendiente`: el mismo agujero que
      // `estado`, por el campo de al lado. Lo levanto el gate de revision.
      //
      // `null` se admite a proposito: `AlertModel.toMap()` escribe
      // `fecha_limite: null` cuando no hay fecha. Una alerta sin fecha es
      // silenciosa POR DISENO; lo que no puede es serlo por confusion de tipo.
      //
      // **El guard solo aplica si `fecha_limite` CAMBIA**, y esto lo levanto el
      // gate de revision de GAPS-05. `request.resource.data` es el documento
      // RESULTANTE, no lo que cambia: sin la primera clausula, un
      // `update({'estado':'Completada'})` sobre una alerta HEREDADA cuyo
      // `fecha_limite` es una cadena ISO moria con `permission-denied`, porque
      // el valor heredado sobrevive al merge y no es timestamp. O sea que su
      // dueño no podia cerrarla, solo borrarla, mientras el barrido —que SI
      // parsea cadenas a proposito (`alertasVencidas.js:24-28`)— le seguia
      // mandando cada escalon. Cerrar el tipo hacia ineditable justo la alerta
      // que mas molesta.
      //
      // Es el mismo criterio que `fotosBajoServicio` en /resenias (validar solo
      // si el campo cambia) y el contrario al que se aplico aqui al lado con
      // `estado` («si lo tenia, lo sigue teniendo»). La diferencia es que
      // `estado` no tiene valores heredados de otro tipo y `fecha_limite` si.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fecha_limite'])
            || request.resource.data.get('fecha_limite', null) == null
            || request.resource.data.fecha_limite is timestamp);

      // Eliminación: propietario del vehículo o admin
      allow delete: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );
    }

    // 6. Tabla de Reseñas
    match /resenias/{reseniaId} {
      // Las reseñas son de lectura pública para alimentar el directorio de talleres.
      allow read: if true;

      // Solo el usuario autor puede crearla, y solo si referencia un servicio
      // real, del taller indicado y de un vehículo de su propiedad (evita
      // reseñas sin haber recibido un servicio); ver isOwnFinishedService.
      allow create: if isAuthenticated()
        && request.resource.data.id_usuario == request.auth.uid
        && request.resource.data.id_servicio is string
        && request.resource.data.id_servicio.size() > 0
        && exists(/databases/$(database)/documents/servicios/$(request.resource.data.id_servicio))
        && isOwnFinishedService(request.resource.data.id_servicio, request.resource.data.id_taller)
        && fotosBajoServicio(
             request.resource.data.get('fotos', []),
             request.resource.data.id_servicio,
           );

      // El autor puede corregir su texto, puntuacion, fotos y la marca de tiempo
      // de edicion (fecha_resenia, que ReviewService.updateReview siempre
      // reescribe); no se permite reasignar id_servicio/id_taller/id_usuario.
      //
      // El taller dueño de la reseña puede escribir unicamente respuesta_taller
      // (derecho a réplica), sin poder tocar el contenido original.
      //
      // Cualquier usuario autenticado puede marcar is_reported=true (reportar),
      // pero no puede usar ese mismo update para tocar ningun otro campo, ni
      // puede revertirlo a false (solo el admin puede des-reportar, vía delete
      // o mediante el propio panel de moderación que solo expone "eliminar").
      //
      // El admin puede moderar (p.ej. corregir comentario) pero, igual que
      // el autor, no puede reasignar id_servicio/id_taller/id_usuario vía
      // update: esa reasignación sigue prohibida sin excepción alguna.
      allow update: if isAuthenticated()
        && fotosDeReseniaValidasEnUpdate()
        && (
        (resource.data.id_usuario == request.auth.uid
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['comentario', 'estrellas', 'fecha_resenia', 'fotos']))
        || (actuaPorTaller(resource.data.id_taller)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['respuesta_taller']))
        || (request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['is_reported'])
            && request.resource.data.is_reported == true)
        || (isAdmin()
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['id_servicio', 'id_taller', 'id_usuario']))
      );

      // El autor original o el administrador (moderación de comentarios ofensivos) pueden eliminarla
      allow delete: if isAuthenticated() && (resource.data.id_usuario == request.auth.uid || isAdmin());
    }

    // 7. Tabla de Conversaciones
    // Restringido: solo los participantes de la conversación pueden leer/crear/actualizar
    match /conversaciones/{convId} {
      allow read: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid ||
        resource.data.id_mecanico == request.auth.uid ||
        isAdmin()
      );

      // Revision de rama completa (hallazgo C2): antes, cualquier cuenta
      // autenticada podia crear una conversacion nombrandose a si misma
      // como id_mecanico y a CUALQUIER victima como id_propietario, sin
      // relacion previa ni comprobacion de rol. `obtenerPerfilPublico`
      // confia en que "existe una conversacion" implica una relacion
      // legitima (ver functions/src/obtenerPerfilPublico.js,
      // compartenConversacion); esa confianza era auto-emitible por quien
      // llama. Ahora: el propietario siempre puede crear una conversacion
      // sobre si mismo (inicia el chat desde el directorio, workshop_
      // directory_screen.dart), y el mecanico solo puede crear una
      // conversacion en nombre de SU PROPIO taller (actuaPorTaller,
      // service_finalized_screen.dart) — nunca en nombre de un taller
      // ajeno ni sin ese vinculo. Verificado que ChatProvider.
      // iniciarOCrearConversacion es el UNICO sitio de 'lib/' que crea
      // conversaciones (grep de crearConversacion/collection('conversaciones')
      // .add|.doc) y que sus dos call sites (workshop_directory_screen.dart,
      // service_finalized_screen.dart) siempre pasan id_taller.
      //
      // `&& isMecanico()` es la mitigacion residual del propio hallazgo C2:
      // sin ella, un cliente cualquiera podia nombrarse id_mecanico == su
      // propio uid Y id_taller == su propio uid, y `actuaPorTaller` deja
      // pasar ese caso (su primera rama es `request.auth.uid == tallerId`,
      // que no comprueba rol). Eso seguia fabricando la conversacion que
      // `compartenConversacion` exige; el callable lo bloquea aparte con
      // `llamanteEsMecanico` (segunda barrera independiente), pero la regla
      // debe cerrar tambien su propio hueco en vez de depender solo de eso.
      // H-01, gate de revision de reglas: la rama del propietario no
      // comprobaba NADA sobre `id_mecanico`, asi que cualquier cuenta se
      // fabricaba una conversacion nombrando de mecanico a una victima. Eso
      // no solo ensucia su bandeja: es el primer paso de un ataque en dos
      // escrituras que burlaba el gate nuevo de /reservas, porque
      // `esConversacionDeAmbos` daba por buena la relacion que esta misma
      // regla acababa de fabricar. La rama del mecanico ya estaba cerrada
      // (Ronda 3); esta era la simetrica que faltaba.
      //
      // Un propietario puede abrir chat con cualquier TALLER APROBADO, que es
      // el flujo real; no con un usuario arbitrario.
      allow create: if isAuthenticated() && (
        (request.resource.data.id_propietario == request.auth.uid
          && esMecanicoAprobado(request.resource.data.id_mecanico)) ||
        (request.resource.data.id_mecanico == request.auth.uid
          && isMecanico()
          && actuaPorTaller(request.resource.data.id_taller))
      );

      // Revision adversarial (Ronda 3): esta regla dejaba a cualquiera de los
      // dos participantes reescribir CUALQUIER campo del documento, y la
      // Tarea 9 (C1) desnormalizo ahi justo el nombre y la foto que la bandeja
      // y la cabecera del chat pintan. Cinco ataques pasaban contra las reglas
      // de la propia rama: mover `id_propietario` al uid de una victima
      // (inyecta el hilo en SU bandeja, y el atacante sigue siendo participante
      // para escribir en el), endosar `id_mecanico` a un tercero, suplantar
      // `nombre_mecanico`/`foto_mecanico`, apuntar `id_taller` a un taller
      // ajeno y falsear los contadores de no leidos.
      //
      // Se acota a las tres escrituras que la app hace de verdad
      // (`ChatRepository` es el UNICO escritor de esta coleccion en lib/):
      //   1. `enviarMensaje`: cola del ultimo mensaje + incremento del
      //      contador DEL OTRO.
      //   2. `marcarComoLeidos`: reseteo a 0 del contador PROPIO.
      //   3. `setTypingStatus`: el indicador "escribiendo".
      // Las identidades (`id_propietario`, `id_mecanico`, `id_taller`, nombres
      // y fotos) quedan fijadas en el `create` y ya no se pueden mover.
      //
      // Las dos ramas son simetricas a proposito: cada participante solo puede
      // BAJAR su propio contador y SUBIR el del otro, que es la unica direccion
      // que tienen las dos escrituras reales, y `typing_id` solo puede quedar
      // en null o en el propio uid — nadie puede fingir que el otro escribe.
      allow update: if isAuthenticated() && (
        isAdmin()
        || (resource.data.id_propietario == request.auth.uid
            && camposDeConversacionAcotados()
            && request.resource.data.get('no_leidos_propietario', 0)
                 <= resource.data.get('no_leidos_propietario', 0)
            && request.resource.data.get('no_leidos_mecanico', 0)
                 >= resource.data.get('no_leidos_mecanico', 0)
            && typingPropio())
        || (resource.data.id_mecanico == request.auth.uid
            && camposDeConversacionAcotados()
            && request.resource.data.get('no_leidos_mecanico', 0)
                 <= resource.data.get('no_leidos_mecanico', 0)
            && request.resource.data.get('no_leidos_propietario', 0)
                 >= resource.data.get('no_leidos_propietario', 0)
            && typingPropio())
      );

      function camposDeConversacionAcotados() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ultimo_mensaje',
          'ultimo_mensaje_ts',
          'no_leidos_propietario',
          'no_leidos_mecanico',
          'typing_id'
        ]);
      }

      function typingPropio() {
        return request.resource.data.get('typing_id', null) == null
          || request.resource.data.get('typing_id', null) == request.auth.uid;
      }

      // Subcolección de mensajes — solo participantes de la conversación padre
      match /mensajes/{msgId} {
        function esParticipante() {
          return get(/databases/$(database)/documents/conversaciones/$(convId)).data
              .id_propietario == request.auth.uid ||
            get(/databases/$(database)/documents/conversaciones/$(convId)).data
              .id_mecanico == request.auth.uid;
        }

        allow read: if isAuthenticated() && esParticipante();

        // Revisión de Tarea 11 (C4b), hallazgo R1: la regla original de
        // `create` no comprobaba `request.resource.data` en absoluto — solo
        // exigía ser participante. Cualquier participante podía forjar
        // `id_remitente` con el uid del OTRO participante; como
        // `chat_screen.dart` calcula `isMe = msg.idRemitente == userId`, el
        // mensaje forjado se renderizaba como si el otro lo hubiera escrito
        // (p.ej. el taller hace que aparezca "Acepto pagar 2.000.000" en
        // boca del propietario). Se auditó cada `create` real
        // (`ChatRepository.enviarMensaje`, único punto de escritura, y su
        // único llamador `ChatProvider.enviarMensaje`/`enviarCotizacion`):
        // todos pasan `remitenteId: userId` (el uid autenticado de quien
        // envía) — ninguna escritura legítima, de cliente ni de Cloud
        // Functions (el trigger `notifyOnNewChatMessage` solo lee, no
        // escribe mensajes), depende de poder fijar un `id_remitente`
        // distinto al propio.
        allow create: if isAuthenticated() && esParticipante() &&
          request.resource.data.id_remitente == request.auth.uid;

        // Tarea 11b (C4), revisada en la ronda C4b: la regla original
        // permitía reescribir CUALQUIER campo de un mensaje ajeno — el
        // emisor, el tipo, el precio de una cotización ya aceptada — sin
        // verificar autoría ni acotar los campos tocados. Se cierra a
        // cuatro escrituras concretas, cada una ya usada por la app hoy:
        //   1. Editar el propio texto: solo el autor, solo mensajes de tipo
        //      'texto' (una cotización o reserva editada cambiaría lo que
        //      la otra parte ya aceptó/leyó), solo puede tocar `contenido`
        //      y `editado`. `hasOnly` impide colar `id_remitente` o `tipo`.
        //      Hallazgo R3 (revisión C4b): la rama original no exigía
        //      `editado == true` — `update({contenido: 'x'})` a secas, o
        //      con `editado: false`, pasaba el `hasOnly` igual, permitiendo
        //      reescribir el texto sin dejar la marca "(editado)" que es la
        //      única señal visible del cambio. Ahora se exige
        //      `request.resource.data.editado == true` explícitamente.
        //      Revisión de rama completa (Blocker 4): tampoco comprobaba
        //      `is_deleted`, así que un mensaje ya tombstoneado (que sigue
        //      teniendo `tipo: 'texto'`) podía "editarse" — el autor escribía
        //      contenido arbitrario ENCIMA del tombstone, marcado `(editado)`,
        //      derrotando el borrado de una sola dirección que la rama 4 de
        //      abajo paga por construir. Se exige además
        //      `resource.data.get('is_deleted', false) != true`.
        //   2. Marcar como visto (`ChatRepository.marcarComoLeidos`): el
        //      receptor actualiza el `estado` de un mensaje que NO escribió
        //      — sigue siendo cualquier participante, solo ese campo.
        //   3. Metadata de tarjetas interactivas (reserva/cotización/reseña,
        //      `actualizarMetadatosMensaje`): la acción (aceptar, rechazar,
        //      calificar) la dispara la contraparte del emisor, así que
        //      también se mantiene abierto a cualquier participante, solo
        //      ese campo.
        //   4. Borrado lógico (`ChatRepository.deleteMensaje`, is_deleted +
        //      contenido): usa `update`, no `delete` — se acota aquí al
        //      autor, igual que el `delete` físico de abajo. Hallazgo R2
        //      (revisión C4b): la rama original no fijaba el valor de
        //      `contenido` ni exigía que `is_deleted` pasara de false→true,
        //      así que servía como reescritura de `contenido` disfrazada de
        //      borrado — dos escrituras (borrar con un `contenido`
        //      inventado, luego "revivir" con `is_deleted: false`) dejaban
        //      un mensaje vivo con el texto reescrito y sin marca de
        //      editado, incluso en una `cotizacion_card`. Ahora es un
        //      tombstone de una sola dirección: exige
        //      `resource.data.is_deleted != true` (no se puede volver a
        //      "borrar" ni, más importante, revertir desde `true`),
        //      `request.resource.data.is_deleted == true`, y fija
        //      `contenido` al valor EXACTO que escribe
        //      `ChatRepository.deleteMensaje` — no es localizable ni
        //      configurable, es un literal en el repositorio.
        //      Blocker 6 (revisión de rama completa): ese literal vive en
        //      `lib/features/chat/data/repositories/chat_repository.dart`
        //      como la constante `kTombstoneMensajeEliminado`. ESTA regla
        //      compara carácter a carácter contra el string de abajo; si el
        //      literal de la constante cambia (p. ej. una pasada de
        //      localización futura) sin cambiar también el de aquí, el
        //      borrado lógico empieza a fallar en producción para todos los
        //      usuarios, en silencio, porque los tests de widget corren
        //      contra `FakeFirebaseFirestore` (no evalúa reglas). Cambia
        //      ambos EN EL MISMO commit; hay un test de guardia que lee
        //      ambos archivos y compara
        //      (`test/features/chat/tombstone_literal_test.dart`).
        allow update: if isAuthenticated() && esParticipante() && (
          (resource.data.id_remitente == request.auth.uid &&
            // `.get('tipo', 'texto')` y no `resource.data.tipo` a secas: los
            // mensajes anteriores a la introduccion del campo no lo traen, y
            // desreferenciarlo sobre ellos es un error de evaluacion que deja
            // el mensaje ineditable para siempre en vez de denegar limpio. El
            // default replica el que ya aplica el cliente al leerlos
            // (MensajeModel.fromMap: `map['tipo'] ?? 'texto'`).
            resource.data.get('tipo', 'texto') == 'texto' &&
            resource.data.get('is_deleted', false) != true &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['contenido', 'editado']) &&
            request.resource.data.editado == true)
          // Revision adversarial (Ronda 3): estas dos ramas eran las unicas
          // de las cuatro sin ninguna comprobacion de autoria ni de valor, y
          // las dos pasaban el banco de ataques sobre mensajes AJENOS.
          //
          //   2. Marcar como visto: lo hace el RECEPTOR, nunca el autor, y el
          //      unico valor que escribe `ChatRepository.marcarComoLeidos` es
          //      'visto'. Sin esas dos condiciones, `estado` era un campo de
          //      texto libre que cualquier participante podia poner a
          //      cualquier cosa sobre cualquier mensaje.
          || (resource.data.id_remitente != request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['estado']) &&
            request.resource.data.estado == 'visto')
          //   3. Metadata de tarjetas interactivas: la accion (aceptar,
          //      rechazar, calificar) la dispara la contraparte del emisor,
          //      asi que sigue abierta a cualquier participante — pero SOLO
          //      sobre la clave `estado` del mapa. Los dos unicos escritores
          //      reales (`ReservaChatCard._actualizar` y
          //      `ReviewChatCard`) copian la metadata y cambian esa clave y
          //      nada mas. Antes se podia reescribir el mapa ENTERO, incluido
          //      `id_cotizacion`, que es el puntero al documento que la
          //      tarjeta abre y que el boton "Aceptar" acepta: repuntarlo
          //      cambiaba que cotizacion se aceptaba. Que hoy el cliente lea
          //      el documento vivo (Tarea 8) contenia el daño por accidente,
          //      no por frontera.
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['metadata']) &&
            request.resource.data.metadata.diff(resource.data.metadata)
              .affectedKeys().hasOnly(['estado']))
          || (resource.data.id_remitente == request.auth.uid &&
            resource.data.get('is_deleted', false) != true &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['is_deleted', 'contenido']) &&
            request.resource.data.is_deleted == true &&
            request.resource.data.contenido == 'Este mensaje ha sido eliminado')
        );

        // Borrado: solo el autor del mensaje, y solo si sigue siendo
        // participante de la conversación (defensa en profundidad,
        // hallazgo R4 — el resto de reglas de esta subcolección ya exige
        // `esParticipante()`, esta no lo hacía). La regla original permitía
        // a cualquier participante borrar el mensaje del otro — un permiso
        // heredado sin que nadie lo decidiera, no una elección de diseño
        // (ver informe de Tarea 11).
        allow delete: if isAuthenticated() && esParticipante() &&
          resource.data.id_remitente == request.auth.uid;
      }
    }

    // 8. Tabla de Reservas
    // Una cita solo puede nacer dentro de una conversacion existente en la
    // que participen EXACTAMENTE los dos uid que la cita nombra. Ver la nota
    // del `allow create` de /reservas.
    function esConversacionDeAmbos(convId, propietario, mecanico) {
      return convId is string && convId.size() > 0 &&
        exists(/databases/$(database)/documents/conversaciones/$(convId)) &&
        get(/databases/$(database)/documents/conversaciones/$(convId))
          .data.get('id_propietario', '') == propietario &&
        get(/databases/$(database)/documents/conversaciones/$(convId))
          .data.get('id_mecanico', '') == mecanico;
    }

    match /reservas/{reservaId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid ||
         isAdmin());
      // Tanto el propietario como el mecánico pueden proponer una cita desde
      // el chat (chat_screen.dart _mostrarSelectorFecha, flujo de
      // cotizacion+agenda integrado): cualquiera de los dos puede ser quien
      // crea el documento, con tal de que se asigne a sí mismo en su propio
      // campo (id_propietario/id_mecanico). Restringir esto a solo
      // propietario, como hacia la version anterior de esta regla, rompe la
      // mitad del flujo (el mecanico proponiendo fecha).
      //
      // H-01 cierra el riesgo residual que esta nota reconocia: no se
      // comprobaba que existiera relacion previa entre los dos uid. Sin eso,
      // cualquier cuenta autenticada creaba una cita poniendo de `id_mecanico`
      // a una victima, y `onReservaCreada` (functions/index.js) confia en ese
      // campo para notificarle — suplantacion con notificacion dirigida, sin
      // tocar la UI. Lo levanto la segunda auditoria adversarial.
      //
      // La cita queda atada a su conversacion, que YA es una relacion de
      // fiar: crear una conversacion se endurecio en el hallazgo C2 justo
      // porque `obtenerPerfilPublico` se apoya en que exista. No cambia el
      // contrato de la app: `ReservaModel.toMap()` escribe `id_conversacion`
      // siempre y en `lib/` hay un unico creador de reservas.
      //
      // GAPS-05 ata ademas `id_taller`, que hasta aqui era el unico campo de
      // identidad LIBRE del documento: el `create` pineaba propietario y
      // mecanico contra la conversacion y luego dejaba apuntar la cita al
      // taller que se quisiera. Una cita legitima entre dos personas reales
      // podia contaminar cualquier agrupacion por taller con el id de un
      // tercero.
      //
      // Se ata a `id_mecanico` y no a `id_taller_efectivo` del mecanico
      // porque eso es lo que la app escribe de verdad: el unico creador de
      // reservas de `lib/` (`chat_screen.dart:346`) pone
      // `idTaller: isMecanico ? userId : receptorId`, o sea el mismo valor que
      // `id_mecanico`. El `idTallerEfectivo` lo usan las COTIZACIONES, que son
      // otra coleccion. Comprobarlo antes de escribir la regla es lo que
      // evito atar el campo a un valor que ningun flujo produce.
      //
      // Se compara contra `request.resource.data.id_taller` SIN `.get(...)`
      // con valor por defecto, a proposito: con un defecto, un documento que
      // omitiera el campo pasaria la comparacion por tautologia — el defecto
      // exacto que GAPS-02 encontro en `abierto`.
      //
      // Del gate de revision de GAPS-05: `id_taller` no era el unico campo de
      // identidad libre, y el que mas importaba era `id_proponente`, porque de
      // el depende TODA la maquina de transiciones de abajo (confirmar exige
      // `uid != id_proponente`). Se pinea al llamante. El cliente se arreglo
      // ANTES —`chat_screen.dart` no lo pasaba y `ReservaModel` lo resolvia
      // con `?? idPropietario`, asi que una cita propuesta por el mecanico
      // nacia con el proponente al reves—; pinear la regla sin arreglar eso
      // habria roto la mitad del flujo.
      //
      // `estado` se pinea a 'pendiente' por la misma razon que /cotizaciones
      // pinea el suyo a 'draft': nacer en el estado final se salta el `update`
      // entero, y una cita nacida 'confirmada' entra ademas en el barrido de
      // recordatorios sin que la contraparte haya aceptado nada.
      //
      // `fecha_hora_propuesta` se ata al tipo porque `ReservaModel.fromMap`
      // hace `as Timestamp` sin `?`: un string ahi revienta el parseo para los
      // dos participantes y la pantalla no se puede recuperar.
      allow create: if isAuthenticated() &&
        (request.resource.data.id_propietario == request.auth.uid ||
         request.resource.data.id_mecanico == request.auth.uid) &&
        request.resource.data.id_taller == request.resource.data.id_mecanico &&
        request.resource.data.id_proponente == request.auth.uid &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.fecha_hora_propuesta is timestamp &&
        esConversacionDeAmbos(
          request.resource.data.get('id_conversacion', ''),
          request.resource.data.id_propietario,
          request.resource.data.id_mecanico
        );
      // Tras crearse, solo estado/fecha_hora_confirmada/fecha_hora_propuesta
      // son escribibles (ver ReservaRepository.actualizarEstadoReserva y
      // .reprogramarReserva, los unicos dos flujos reales de escritura):
      // sin este acotado, cualquiera de los dos participantes podia
      // reescribir id_propietario/id_mecanico/id_vehiculo/id_taller despues
      // de creada la reserva (hallazgo M1).
      allow update: if isAuthenticated() && (
        isAdmin() || (
          (resource.data.id_propietario == request.auth.uid ||
           resource.data.id_mecanico == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'fecha_hora_confirmada', 'fecha_hora_propuesta', 'id_proponente']) &&
          (
            (
              // Reprogramar: mueve fecha_hora_propuesta y vuelve a
              // 'pendiente'. Se detecta por fecha_hora_propuesta, no por
              // 'estado' en affectedKeys() — si la reserva ya estaba
              // 'pendiente', reescribir el mismo valor no cuenta como campo
              // afectado en diff(), y el chequeo de transición de abajo
              // quedaría bypaseado por completo (permitía reprogramar sin
              // id_proponente propio).
              'fecha_hora_propuesta' in request.resource.data.diff(resource.data).affectedKeys() &&
              request.resource.data.estado == 'pendiente' &&
              request.resource.data.id_proponente == request.auth.uid
            ) ||
            (
              !('fecha_hora_propuesta' in request.resource.data.diff(resource.data).affectedKeys()) &&
              !('id_proponente' in request.resource.data.diff(resource.data).affectedKeys()) &&
              (
                !('estado' in request.resource.data.diff(resource.data).affectedKeys()) ||
                (
                  request.resource.data.estado in ['confirmada', 'rechazada'] &&
                  request.auth.uid != resource.data.get('id_proponente', resource.data.id_propietario)
                ) ||
                (
                  request.resource.data.estado == 'cancelada_por_propietario' &&
                  request.auth.uid == resource.data.id_propietario
                ) ||
                (
                  request.resource.data.estado == 'cancelada_por_taller' &&
                  request.auth.uid == resource.data.id_mecanico
                ) ||
                (
                  request.resource.data.estado == 'cancelada'
                ) ||
                (
                  request.resource.data.estado in ['completada', 'cotizada']
                )
              )
            )
          )
        )
      );
    }

    // 9. Tabla de Cotizaciones
    match /cotizaciones/{cotizacionId} {
      // El margen debe estar confirmado ANTES de publicar y seguir existiendo
      // despues de la solicitud (tambien si un cliente intenta usar un batch).
      function tieneContratoPrivado() {
        let path = /databases/$(database)/documents/cotizaciones/$(cotizacionId)/privado/margen;
        return exists(path) && existsAfter(path) &&
          getAfter(path).data.keys().hasOnly(['beneficios']) &&
          getAfter(path).data.beneficios is list &&
          resource.data.items is list &&
          getAfter(path).data.beneficios.size() == resource.data.items.size();
      }
      // RONDA 4: `actuaPorTaller(id_taller)` ademas de `id_mecanico ==
      // auth.uid`. La cotizacion es del TALLER, no del operario que la
      // redacto: con solo `id_mecanico`, un empleado no podia ver las
      // cotizaciones que escribio un companero suyo, ni el dueño las de sus
      // empleados. Eso dejaba a `VehiclePublicViewScreen` diciendole al resto
      // del taller «este vehiculo no tiene una cotizacion aceptada en tu
      // taller» cuando si la habia — y esa consulta de lista, filtrada por
      // `id_mecanico`, era la unica que las reglas le admitian.
      // `id_taller` no es un campo que el llamante pueda apuntar a un taller
      // ajeno: `allow create` (abajo) ya lo ata con `actuaPorTaller`. El
      // margen del mecanico sigue fuera de este documento, en la subcoleccion
      // `privado` (hallazgo H2).
      // `resource == null` explicito, por el mismo motivo ya documentado en
      // /vehiculos: sin esa rama, un get() sobre una cotizacion inexistente
      // —la que se acaba de borrar, o un id que todavia no se ha escrito— no
      // devuelve "no existe", sino que evalua `resource.data.id_propietario`
      // sobre null. Eso es un error de evaluacion, no un false, y llega al
      // cliente como PERMISSION_DENIED: un mensaje que manda a buscar un
      // problema de permisos donde solo hay un documento ausente. No filtra
      // nada, porque un documento inexistente no tiene datos que exponer.
      allow read: if isAuthenticated() &&
        (resource == null ||
         resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid ||
         actuaPorTaller(resource.data.get('id_taller', '')) ||
         isAdmin());
      // El estado inicial esta fijado a 'draft' a proposito. Sin esto,
      // acotar el `update` por rol y valor no sirve de nada: el mecanico se
      // saltaba la regla de update entera CREANDO la cotizacion ya en
      // 'aceptada'. No dispara `onCotizacionAceptada` (es un onUpdate), pero
      // una cotizacion nacida 'aceptada' es un dato falso que otras piezas
      // creen: cuando existia el callable `iniciarReparacionPorVehiculo`
      // (retirado en FUNC-02), su gate solo miraba "hay una cotizacion
      // aceptada para este vehiculo+taller", asi que el mecanico podia
      // emitirse medio gate el solo. Ese consumidor ya no existe, pero el
      // dato sigue siendo la prueba de consentimiento del propietario en
      // toda la app: fijar el estado inicial en 'draft' es lo que hace que
      // 'aceptada' solo pueda venir de el.
      // Verificado que los tres creadores reales (chat_screen.dart:1007,
      // reserva_detail_screen.dart:200, reserva_chat_card.dart:137) usan el
      // repositorio, que guarda draft y publica pendiente tras el margen.
      //
      // Ronda 2 (FIX 1) — hasta aqui, `create` solo comprobaba que el
      // mecanico se nombrara a si mismo y que el estado naciera 'pendiente'.
      // NADA ataba `id_propietario`, `id_vehiculo` ni `id_taller` a la
      // realidad: un mecanico creaba
      // {id_mecanico: self, id_propietario: self, id_vehiculo: <vehiculo
      // ajeno>, estado: 'pendiente'} y luego satisfacia el, la rama DEL
      // PROPIETARIO de `update` (arriba) para aceptarsela el mismo — dos
      // escrituras, cotizacion 'aceptada' sin que el dueño real participara.
      // Una cotizacion 'aceptada' fabricada asi valia como consentimiento
      // del propietario ante cualquier consumidor server-side (lo era, en su
      // dia, para el callable de apertura manual retirado en FUNC-02). Se
      // reutilizan getVehicleOwner() y actuaPorTaller() (mismas
      // funciones que ya usaba el viejo `allow create` de /reparaciones) en
      // vez de escribir un lookup nuevo:
      //   - getVehicleOwner(id_vehiculo) == id_propietario: ata el
      //     propietario declarado al dueño REAL del vehiculo (get() sobre
      //     /vehiculos; si el vehiculo no existe, get() lanza y la regla
      //     deniega).
      //   - actuaPorTaller(id_taller): el llamante debe poder actuar en
      //     nombre de ESE taller (el mismo, o un empleado del dueño), igual
      //     que ya exige `update` mas abajo del lado del mecanico.
      //   - id_propietario != id_mecanico: cierra el caso degenerado en el
      //     que alguien fuera dueño de su propio vehiculo Y mecanico a la
      //     vez — no hay flujo legitimo en el que el mecanico se cotice a si
      //     mismo.
      // Coste de get(): actuaPorTaller hace como mucho 1 get() (0 si
      // auth.uid == id_taller, el caso mas comun); getVehicleOwner hace 1
      // get() mas. Maximo 2 get() en esta regla, muy por debajo del limite
      // de 10 por solicitud de documento unico.
      allow create: if isAuthenticated() &&
        request.resource.data.id_mecanico == request.auth.uid &&
        request.resource.data.estado == 'draft' &&
        request.resource.data.items is list &&
        request.resource.data.id_propietario != request.auth.uid &&
        actuaPorTaller(request.resource.data.id_taller) &&
        // El vehiculo es OPCIONAL: un cliente que contacta al taller desde el
        // directorio (workshop_directory_screen.dart:1209) abre una
        // conversacion SIN vehiculo, y CotizacionModel.toMap()
        // (cotizacion_model.dart:111) omite la clave entera cuando es null.
        // Sin este guarda, getVehicleOwner() sobre el campo ausente no
        // deniega limpio: revienta con "property is undefined", y se llevaba
        // por delante la via mas comun de cotizar.
        // Es seguro dejarla pasar: sin id_vehiculo no se puede encadenar el
        // ataque (existeCotizacionAceptada busca por vehiculo+taller), y
        // llegar a 'aceptada' sigue exigiendo ser el id_propietario nombrado,
        // que la linea de arriba prohibe que sea el propio mecanico.
        (
          !('id_vehiculo' in request.resource.data) ||
          // `exists()` antes de `getVehicleOwner()`: el dueño puede borrar su
          // vehiculo (allow delete mas arriba en /vehiculos) y la conversacion
          // conserva el `id_vehiculo`. Sin este guarda, el get() sobre el
          // documento ausente no deniega limpio — revienta con un error de
          // evaluacion, y el mecanico recibe un `permission-denied` pelado sin
          // forma de entender por que ni de cotizar en ese chat. Mismo criterio
          // que ya aplica el `create` de /usuarios con sus accesos guardados.
          (
            exists(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo)) &&
            getVehicleOwner(request.resource.data.id_vehiculo) == request.resource.data.id_propietario
          )
        );
      // Solo el campo 'estado' es escribible tras la creacion, y cada parte
      // solo puede escribir el valor que su propio flujo real produce: el
      // propietario acepta/rechaza (cotizacion_chat_card.dart, via
      // actualizarEstadoCotizacion) y el mecanico la marca 'finalizada'
      // (initiate_service_screen.dart). Verificado por grep que ningun otro
      // sitio escribe 'estado' sobre esta coleccion.
      //
      // Revision de rama completa (hallazgo C1): antes de esto, CUALQUIERA
      // de las dos partes podia escribir CUALQUIER valor de 'estado'. Eso
      // dejaba que el mecanico se auto-aceptara su propia cotizacion sobre
      // un vehiculo ajeno, cumpliendo asi por su cuenta la unica condicion
      // que el trigger `onCotizacionAceptada` (5. reparaciones) exige para
      // abrir un ticket. Separar por rol Y por valor cierra esa via.
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
        tieneContratoPrivado() &&
        (
          (resource.data.estado == 'draft'
            && resource.data.id_mecanico == request.auth.uid
            && request.resource.data.estado == 'pendiente')
          || (resource.data.estado in ['pendiente', 'aceptada', 'rechazada', 'finalizada'] && (
          (resource.data.id_propietario == request.auth.uid
            && request.resource.data.estado in ['aceptada', 'rechazada'])
          // RONDA 4: `actuaPorTaller(id_taller)`, no solo `id_mecanico ==
          // auth.uid`. Quien marca 'finalizada' es InitiateServiceScreen al
          // cerrar el servicio, y ahi el operario no tiene por que ser el
          // mismo que redacto la cotizacion: en un taller con empleados lo
          // normal es que uno cotice y otro cierre. Con la condicion vieja esa
          // escritura moria en permission-denied DESPUES de haber registrado
          // ya el servicio, el ticket nunca llegaba a 'listo_para_entrega'
          // (esa llamada va despues, en el mismo try) y la pantalla culpaba al
          // vinculo del vehiculo con un mensaje que no tenia nada que ver.
          // Se conserva la rama por `id_mecanico` para las cotizaciones
          // legacy que se escribieron sin `id_taller`.
          || ((resource.data.id_mecanico == request.auth.uid
                || actuaPorTaller(resource.data.get('id_taller', '')))
            && request.resource.data.estado == 'finalizada')
          ))
        );

      // Limpieza de una creacion fallida, sin dejar un margen huerfano.
      allow delete: if isAuthenticated() &&
        resource.data.id_mecanico == request.auth.uid &&
        resource.data.estado == 'draft' &&
        !existsAfter(/databases/$(database)/documents/cotizaciones/$(cotizacionId)/privado/margen);

      // Beneficio por renglon (ver CotizacionItem.beneficio en el cliente):
      // documento privado fuera del doc principal porque 'cotizaciones' es
      // de lectura compartida con el propietario, y el beneficio del
      // mecanico nunca debe ser visible para el cliente (hallazgo H2).
      match /privado/{docId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.id_mecanico == request.auth.uid
          || isAdmin()
        );
        allow create, update: if isAuthenticated() && docId == 'margen' &&
          get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.id_mecanico == request.auth.uid &&
          get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.estado == 'draft' &&
          getAfter(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.estado == 'draft' &&
          request.resource.data.keys().hasOnly(['beneficios']) &&
          request.resource.data.beneficios is list &&
          request.resource.data.beneficios.size() ==
            get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.items.size();
        allow delete: if isAuthenticated() &&
          get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.id_mecanico == request.auth.uid &&
          get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.estado == 'draft' &&
          (!existsAfter(/databases/$(database)/documents/cotizaciones/$(cotizacionId)) ||
            getAfter(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.estado == 'draft');
      }
    }

    // 10. Tabla de Mantenimientos (tareas de mantenimiento programadas)
    // Solo el propietario del vehículo puede leer/crear/actualizar/eliminar
    // Mecánicos pueden leer y actualizar (registrar km, marcar completado)
    match /mantenimientos/{mantenimientoId} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      allow create: if isAuthenticated() && (
        isVehicleOwner(request.resource.data.id_vehiculo)
        || isAdmin()
      );

      // puedeMecanicoAtenderVehiculo (no isVinculadoAlVehiculo a secas): un
      // mecanico que cierra el PRIMER servicio de un cliente walk-in todavia
      // no aparece en 'talleres_vinculados' en este punto — ese vinculo se
      // otorga recien despues, al crear el 'servicios' correspondiente — asi
      // que sin el carve-out este update (paso 1 de tallerUpdateService)
      // fallaba con permission-denied antes de llegar a esa escritura.
      // `id_vehiculo` inmutable, mismo motivo que en /alertas: la
      // autorización mira resource.data (el doc viejo), así que reasignarlo
      // movería el mantenimiento al coche de otro con un update autorizado.
      allow update: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || puedeMecanicoAtenderVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id_vehiculo']);

      allow delete: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );
    }

    // 11. Tabla de Historial de Mantenimientos
    // Lectura: propietario del vehículo o mecánico del servicio
    // Escritura: mecánico o admin
    match /historial_mantenimientos/{historialId} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      // actuaPorTaller() (no request.auth.uid directo) para aceptar tambien
      // a un empleado; carve-out de walk-in igual que 'mantenimientos'.update
      // y 'servicios'.create, porque este create es el paso 4 del mismo
      // tallerUpdateService que ya necesita esos dos.
      allow create: if isAuthenticated() && (
        (isMecanico() && actuaPorTaller(request.resource.data.id_taller)
          && puedeMecanicoAtenderVehiculo(request.resource.data.id_vehiculo))
        || isAdmin()
      );

      // `id_vehiculo` e `id_taller` inmutables: actuaPorTaller() se evalúa
      // sobre resource.data.id_taller (el viejo), de modo que sin este
      // acotado el taller dueño de la entrada podía reasignarla al vehículo
      // de otro cliente o atribuírsela a otro taller, falsificando historial
      // ajeno desde un update que las reglas consideran legítimo.
      allow update: if isAuthenticated() && (
        (isMecanico() && actuaPorTaller(resource.data.id_taller))
        || isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['id_vehiculo', 'id_taller']);

      allow delete: if isAdmin();
    }

    // 12. Admin Logs — audit trail
    // Lectura: solo administradores
    // Escritura: solo vía Admin SDK (Cloud Functions) o admin autenticado
    // Los clientes normales NO pueden escribir en esta colección
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      
      // El log SI se escribe desde el cliente: AdminService._logAction lo
      // emite tras cada accion de administracion (aprobar, suspender, cambiar
      // rol...) via AdminRepository.registrarLog. Cerrar este create tumbaria
      // todo el panel de administracion, no solo la auditoria.
      //
      // Lo que si se cierra es la ATRIBUCION: 'admin_uid' viaja en el payload
      // del cliente (AdminLogModel.toMap), asi que sin este chequeo un
      // administrador podia firmar una entrada con el uid de OTRO
      // administrador y ensuciarle el historial. Todas las llamadas reales
      // pasan `currentUid` (ver admin_usuarios_screen / admin_talleres_screen),
      // asi que exigir que coincida con el llamante no rompe ningun flujo.
      //
      // LIMITE CONOCIDO, y es estructural: esto garantiza que un log escrito
      // sea autentico, no que la accion quede logueada. La accion y su log son
      // dos writes independientes del cliente; un administrador que omita el
      // segundo actua sin dejar rastro, y 'fecha' es un DateTime.now() del
      // cliente, o sea antedatable. La unica cura real es mover las acciones de
      // administracion a Cloud Functions y que el log lo escriba el Admin SDK
      // en la misma transaccion. Fuera del alcance de esta tanda.
      allow create: if isAdmin()
                    && request.resource.data.get('admin_uid', '') == request.auth.uid;

      allow update, delete: if false; // Logs son inmutables
    }

    // 13. Notificaciones in-app (para centro de notificaciones)
    match /notificaciones/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId); // marcar como leída
      allow create: if false; // Solo vía Cloud Functions (Admin SDK)
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 14. Tabla de Reparaciones (kanban de estado de reparación, panel mecánico)
    // Lectura: propietario del vehículo, taller asignado o admin
    // Escritura: solo el taller vinculado al vehículo (mismo patrón que
    // 'servicios'/'historial_mantenimientos'): create exige isMecanico() +
    // isVinculadoAlVehiculo(id_vehiculo) — o, igual que en 'servicios'
    // (walk-in: cliente sin cita previa, ver vehicle_search_screen.dart ->
    // initiate_service_screen.dart -> _iniciarTicketReparacion), que el
    // vehículo aún no tenga ningún taller vinculado — y que id_propietario
    // coincida con el dueño real del vehículo (evita inyectar una
    // reparación falsa en el vehículo de una víctima); update bloquea
    // reasignar id_vehiculo/id_taller/id_propietario tras la creación
    // (mismo hallazgo ya corregido en 'servicios').
    // Nota (fix de integracion de empleados): las 3 comparaciones de uid de
    // abajo (read/create/update) usan actuaPorTaller() en vez de
    // `== request.auth.uid` directo, para aceptar tambien a una sub-cuenta
    // de empleado actuando en nombre del taller dueño — ver
    // InitiateServiceScreen._iniciarTicketReparacion, que ya resuelve
    // `idTaller` al uid del dueño (UserModel.idTallerEfectivo), no al
    // propio uid del empleado. El resto de las condiciones (isMecanico(),
    // isVinculadoAlVehiculo, el carve-out de walk-in, el bloqueo de campos
    // en update) queda intacto: solo se amplia QUIEN puede ser "el taller",
    // no se relaja ninguna otra proteccion.
    match /reparaciones/{reparacionId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         actuaPorTaller(resource.data.id_taller) || isAdmin());

      // A4b: ya nadie crea reparaciones desde el cliente. El unico creador es
      // el trigger `onCotizacionAceptada` (Admin SDK, que se salta las
      // reglas), que abre el ticket en 'pendiente_recepcion' cuando el cliente
      // acepta la cotizacion. Que el mecanico pudiera crearlo a mano era
      // justamente lo que dejaba recibir un vehiculo sin cotizacion aceptada
      // (A3/B2).
      //
      // ESTE `if false` NO PROTEGE A LOS CALLABLES NI A LOS TRIGGERS: corren
      // con Admin SDK y no pasan por las reglas. Hubo un segundo creador por
      // esa via, el callable `iniciarReparacionPorVehiculo`, que ademas abria
      // el ticket directamente en 'recibido' y se otorgaba el vinculo con el
      // vehiculo; FUNC-02 lo retiro entero (ya no tenia consumidor en el
      // cliente, pero seguia desplegado e invocable). Desde entonces escriben
      // aqui tres funciones y ninguna mas: el trigger `onCotizacionAceptada`,
      // que es el unico que CREA; el callable `recibirVehiculoDelTicket`, que
      // transiciona a 'recibido' y otorga el vinculo; y el barrido de
      // `onVehicleDelete`, que solo CIERRA los tickets del vehiculo borrado.
      // Cualquier funcion nueva sobre /reparaciones tiene que replicar a mano
      // la autorizacion que esta regla haria — la regla no se la va a aplicar.
      // Lo vigila `functions/test/apertura_unica_ticket.test.js`.
      allow create: if false;

      // Las invariantes de la maquina de estados vivian SOLO en
      // ReparacionRepository.cambiarEstado, es decir en el cliente Dart. La
      // revision adversarial de la ronda 6 comprobo contra el emulador que un
      // taller podia saltarselas todas escribiendo `estado` a mano:
      //
      //  - `pendiente_recepcion` -> `entregado`: entregar un coche que nunca
      //    llego.
      //  - `entregado` -> `recibido`: RESUCITAR un ticket cerrado. Esta era la
      //    grave: `recibirTicketYVincular` solo rechaza estados cerrados, asi
      //    que un ticket resucitado pasa el control y su `arrayUnion` le
      //    devuelve al taller el acceso a la ficha del coche sin ninguna
      //    cotizacion aceptada nueva — el modelo de consentimiento entero de
      //    las rondas 5 y 6 se sorteaba con un update.
      //  - un `estado` inventado: el ticket desaparece para siempre del
      //    tablero, que desde la ronda 6 filtra con `whereIn`.
      //
      // Las tres se cierran sin ninguna lectura extra, solo con `resource` y
      // `request.resource`.
      // El booleano denormalizado que el tablero consulta (gap 9.1) tiene que
      // decir la verdad sobre el estado RESULTANTE, lo escriba quien lo
      // escriba. Se mira `request.resource.data` y NO `resource.data`:
      // autorizar contra el documento VIEJO es el patron exacto que destapo
      // los cinco huecos de autorizacion de QA-01.
      //
      // Son DOS condiciones y hacen falta las dos:
      //
      //   1. si el campo esta, su valor tiene que ser el derivado del estado.
      //      Sin esto el taller podria poner `abierto: false` en un ticket
      //      vivo —escondiendo un coche de su propio tablero sin cerrar el
      //      ticket, con el vinculo a la ficha intacto— o dejarlo en `true` al
      //      entregar, y el coche entregado ocuparia una columna para siempre.
      //   2. si el documento YA lo tenia, tiene que seguir teniendolo. El
      //      `.get(campo, derivado)` de la condicion 1 no distingue "nunca lo
      //      tuvo" de "me lo acabo de borrar": sobre un campo ausente degenera
      //      en `derivado == derivado`, una tautologia, y un
      //      `update({abierto: FieldValue.delete()})` lograba por OMISION
      //      exactamente lo que la condicion 1 impide por valor. Lo encontro
      //      el gate de revision de esta misma rama.
      //
      // La tolerancia a la ausencia se conserva solo para los tickets legados
      // que nunca tuvieron el campo y cuyo backfill aun no ha corrido: no
      // salen en el tablero (una igualdad sobre un campo ausente no devuelve
      // nada), pero el taller no se queda sin poder tocar sus tickets viejos.
      //
      // Va fuera de la rama del taller, aplicandose tambien al admin: un admin
      // que cerrara un ticket sin bajar `abierto` dejaria una tarjeta clavada
      // en el tablero que el taller NO puede arreglar, porque un ticket
      // cerrado le es inmutable.
      function abiertoCoherente() {
        return request.resource.data.get('abierto', ticketAbierto(request.resource.data))
                 == ticketAbierto(request.resource.data)
          && (!('abierto' in resource.data) || 'abierto' in request.resource.data);
      }

      allow update: if isAuthenticated() && abiertoCoherente() && (
        isAdmin() ||
        (actuaPorTaller(resource.data.id_taller)
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['id_vehiculo', 'id_taller', 'id_propietario'])
          // Un ticket cerrado es inmutable para el taller. Solo el admin puede
          // corregirlo.
          && !(estadoTicket(resource.data) in estadosTicketCerrado())
          // Lista blanca de estados.
          && request.resource.data.estado in estadosTicketValidos()
          // Entregar afirma que el coche SALIO: solo tiene sentido si estaba
          // dentro.
          && (request.resource.data.estado != 'entregado'
              || estadoTicket(resource.data) in estadosVehiculoEnTaller())
          // El centinela de migracion es de los scripts de mantenimiento
          // (Admin SDK, que no pasa por estas reglas). Un cliente que lo
          // escribiera silenciaria las notificaciones del propietario a
          // voluntad.
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['migracion_ronda6']))
      );

      allow delete: if isAdmin();
    }


    // Buzon de los formularios de la landing (UX-01: contacto y solicitud de
    // afiliacion de talleres). Lo llena UNICAMENTE la Cloud Function
    // recibirSolicitudLanding con el Admin SDK, que no pasa por estas reglas:
    // desde el cliente esta cerrada por los dos lados.
    //
    // Cerrada a la escritura porque el formulario de afiliacion de la landing
    // POSTeaba sin autenticar a la REST API de Firestore; que ahora escriba
    // en otra coleccion no arregla nada si esa coleccion admite escrituras
    // anonimas, porque se saltaria la validacion y el limitador del endpoint.
    // Cerrada a la lectura porque guarda correos, telefonos y mensajes de
    // personas que escribieron a soporte.
    match /solicitudes_landing/{solicitudId} {
      allow read: if isAdmin();

      allow create: if false;

      // El administrador atiende el buzon, no lo reescribe: lo unico que
      // puede cambiar es el estado, y dentro de una lista cerrada. Sin el
      // hasOnly, "marcar como atendida" autorizaria tambien a reescribir el
      // mensaje o el correo de quien escribio.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['estado'])
                    // .get('estado','') y no .estado: un update que BORRE el campo
                    // pasa el hasOnly y luego revienta la evaluacion en vez de
                    // denegar limpio. Hoy el efecto neto es el mismo porque es el
                    // ultimo termino de una cadena de &&, pero en cuanto esta
                    // condicion entre en un || el error se propaga y tumba tambien
                    // la rama que si deberia conceder.
                    && request.resource.data.get('estado', '') in ['nueva', 'atendida', 'descartada'];

      // Borrar una solicitud es destruir la unica copia de lo que alguien
      // envio: se queda al nivel de Superusuario, como el hard delete de
      // cuentas.
      allow delete: if isSuperUser();
    }

    // Contador del limitador por IP del endpoint. Si un cliente pudiera
    // tocarlo, el limite seria decorativo: bastaria con ponerlo a cero entre
    // envio y envio. Ni siquiera el administrador tiene nada que hacer aqui.
    match /solicitudes_landing_control/{ipHash} {
      allow read, write: if false;
    }

    // INNO-01 — pases temporales de historial por QR.
    //
    // Cerrada a TODO cliente, en los dos sentidos, y las dos mitades importan:
    //
    // - Sin `read` no se puede canjear un pase leyendo el documento por su id,
    //   ni —sobre todo— LISTAR la coleccion para barrer los pases vivos de
    //   otros. Un pase es un secreto portador: quien lo tiene, entra.
    // - Sin `write` no se puede fabricar un pase para un vehiculo ajeno, ni
    //   estirarle el `expira_en` a uno propio ya caducado, ni des-revocar uno
    //   que el propietario ya anulo.
    //
    // Los tres callables (`crearPaseHistorial`, `leerPaseHistorial`,
    // `revocarPaseHistorial`) corren con Admin SDK y no pasan por aqui, que es
    // justo el motivo de que la funcionalidad sea un callable y no una regla:
    // una regla no puede recibir el token como parametro, asi que autorizar con
    // el obligaria a ponerlo en la ruta y dejaria rastro enumerable.
    match /tokens_historial/{token} {
      allow read, write: if false;
    }

  }
}
