rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES AUXILIARES ---
    
    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario actual es dueño del documento por UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Obtiene los datos del perfil del usuario actual de la colección 'usuarios'
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Verifica si el usuario actual tiene rol de Administrador o Superusuario
    // (Superusuario hereda todos los permisos de Administrador en cualquier
    // regla que use isAdmin(); sus permisos EXCLUSIVOS, como crear
    // Administradores o hacer hard-delete de cuentas, se controlan aparte
    // con isSuperUser()).
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol in ['Administrador', 'admin', 'Superusuario'];
    }

    // Verifica si el usuario actual tiene rol de Superusuario, el nivel por
    // encima de Administrador (crear Administradores/Superusuarios, hard
    // delete de cuentas).
    function isSuperUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol == 'Superusuario';
    }

    // Verifica si el usuario actual tiene rol de Mecánico APROBADO. Un taller
    // pendiente de aprobacion no accede a datos: el bloqueo del enrutador no
    // basta, la API es accesible directamente.
    function isMecanico() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        getUserData().rol in ['Mecanico', 'Taller'] &&
        getUserData().get('estado', 'pendiente') in ['aprobado', 'activo'];
    }

    // Obtiene el propietario de un vehículo
    function getVehicleOwner(vehiculoId) {
      return get(/databases/$(database)/documents/vehiculos/$(vehiculoId)).data.id_propietario;
    }

    // Verifica si el usuario es propietario de un vehículo dado
    function isVehicleOwner(vehiculoId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/vehiculos/$(vehiculoId)) &&
        getVehicleOwner(vehiculoId) == request.auth.uid;
    }

    // Verifica que el usuario es un mecanico cuyo taller esta vinculado al vehiculo.
    function isVinculadoAlVehiculo(vehiculoId) {
      return isMecanico() &&
        exists(/databases/$(database)/documents/vehiculos/$(vehiculoId)) &&
        get(/databases/$(database)/documents/vehiculos/$(vehiculoId))
          .data.get('talleres_vinculados', []).hasAny([request.auth.uid]);
    }

    // Verifica que un servicio ya finalizado pertenezca al taller indicado
    // y que el vehículo de ese servicio sea propiedad del usuario autenticado.
    // Esto es lo que garantiza que solo se pueda reseñar un servicio real y propio.
    function isOwnFinishedService(servicioId, tallerId) {
      let servicio = get(/databases/$(database)/documents/servicios/$(servicioId)).data;
      return servicio.id_taller == tallerId && isVehicleOwner(servicio.id_vehiculo);
    }

    // Verifica si el uid autenticado actua legitimamente en nombre del
    // taller `tallerId` (fix de integracion de sub-cuentas de empleado,
    // ronda final de la Tarea "panel mecanico 100%"): o bien es el propio
    // dueño (mismo uid que `tallerId`) o bien es una sub-cuenta de empleado
    // cuyo `usuarios/{auth.uid}.id_taller_propietario` apunta a ese taller
    // (ver crearEmpleadoTaller / UserModel.idTallerPropietario /
    // UserModel.idTallerEfectivo, que en el cliente hace que
    // reparaciones/catalogo_servicios se escriban con el uid del DUEÑO como
    // id_taller/tallerId, nunca con el propio uid del empleado). El `||`
    // corta en corto: para el caso dueño (el camino mas comun) nunca se
    // ejecuta el get() de la segunda condicion. Se usa `get()` directo (no
    // getUserData(), que solo lee request.auth.uid) porque aqui se necesita
    // leer el doc de usuarios del llamante para comparar su
    // id_taller_propietario, exactamente igual al patron ya usado en el
    // create de 'usuarios' de arriba para excluir ese mismo campo.
    function actuaPorTaller(tallerId) {
      return request.auth.uid == tallerId ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid))
           .data.get('id_taller_propietario', null) == tallerId);
    }


    // --- REGLAS POR COLECCIÓN ---

    // 1. Tabla de Usuarios
    match /usuarios/{userId} {
      // Cada usuario lee unicamente su propio documento. El perfil publico de
      // los talleres vive en la coleccion `talleres`, proyectado por la Cloud
      // Function publishTallerProfile.
      allow read: if isOwner(userId) || isAdmin();

      // Permitir la creación de su propio perfil de usuario durante registro/onboarding.
      // Ademas de exigir rol == 'Propietario' (ningun rol privilegiado por
      // auto-registro):
      // - 'id_taller_propietario' queda bloqueado por completo: no tiene un
      //   valor por defecto seguro y el cliente (UserModel) nunca lo escribe,
      //   asi que un create que lo incluya solo puede ser un intento de
      //   auto-vincularse a un taller ajeno.
      // - 'estado' / 'calificacion_promedio' / 'total_resenias' SI viajan en
      //   el payload real del cliente (UserModel.toMap() siempre los incluye
      //   con sus valores por defecto: 'activo', 0.0, 0 — ver
      //   user_service.dart createUserData(), rama de usuario nuevo), asi que
      //   bloquearlos por completo rompe el registro real. En su lugar se
      //   permiten solo con su valor por defecto inofensivo: eso deja pasar
      //   el registro legitimo pero sigue bloqueando que alguien se plante
      //   un estado 'aprobado' o una reputacion no nula desde el create.
      allow create: if isOwner(userId) && request.resource.data.rol == 'Propietario'
                    && !('id_taller_propietario' in request.resource.data)
                    && (!('estado' in request.resource.data) || request.resource.data.estado == 'activo')
                    && (!('calificacion_promedio' in request.resource.data) || request.resource.data.calificacion_promedio == 0)
                    && (!('total_resenias' in request.resource.data) || request.resource.data.total_resenias == 0);
      
      // El usuario puede editar su propio perfil básico, pero no puede tocar
      // 'rol' (escalamiento de privilegios) ni las métricas agregadas de
      // reputación, que solo debe escribir el backend (aggregateRatings, ya
      // escribe en 'usuarios' con Admin SDK y por tanto no necesita ningún
      // permiso de cliente aquí: el hueco de "cualquier autenticado puede
      // parchear calificacion_promedio/total_resenias" que existía en la
      // rama del colaborador para su recálculo client-side ya no aplica).
      // Los administradores tienen acceso completo para cambiar roles o estados.
      // 'estado' tambien queda excluido: es el campo que el directorio publico
      // de talleres usa para filtrar por 'aprobado' (ver publishTallerProfile),
      // asi que un mecanico no puede autoaprobarse saltandose admin_service.
      // 'id_taller_propietario' tambien queda excluido: es el campo que
      // vincula a un empleado con su taller dueño (ver crearEmpleadoTaller,
      // que lo fija con Admin SDK al crear la cuenta). Sin esta exclusion,
      // cualquier usuario podria auto-asignarse como empleado de un taller
      // ajeno con un solo update.
      // Un Administrador conserva acceso total salvo para asignar el propio
      // rol 'Administrador' o 'Superusuario': eso queda exclusivo de
      // isSuperUser(). Solo se bloquea cuando el update efectivamente toca
      // 'rol' Y el valor resultante es uno de esos dos — así un Administrador
      // sigue pudiendo aprobar/suspender/reasignar a Propietario/Mecanico
      // sin restricciones nuevas.
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['rol', 'calificacion_promedio', 'total_resenias', 'estado', 'id_taller_propietario', 'suma_estrellas']))
                    || isSuperUser()
                    || (isAdmin() && !(
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']) &&
                         request.resource.data.rol in ['Administrador', 'Superusuario']
                       ));

      // Hard delete de cuentas es exclusivo de Superusuario (ver
      // superUserDeleteAccount en functions/index.js, que además borra la
      // cuenta de Firebase Auth vía Admin SDK — este delete de Firestore
      // por sí solo nunca lo hace).
      allow delete: if isSuperUser();
    }

    // 2. Tabla de Talleres
    match /talleres/{tallerId} {
      // El directorio de talleres es de lectura publica.
      allow read: if true;

      // Solo la Cloud Function publishTallerProfile (Admin SDK) escribe aqui.
      // El flujo de calificaciones del colaborador (mecanico/cualquier
      // autenticado escribiendo calificacion_promedio/total_resenias) no
      // aplica: esos campos viven en 'usuarios', no en 'talleres' (ver
      // aggregateRatings en functions/index.js), y el editor de perfil del
      // taller (workshop_settings_screen.dart) escribe en 'usuarios' via
      // UserService, nunca en esta colección.
      allow create, update: if isAdmin();

      allow delete: if isAdmin();

      // Sub-cuentas de empleados del taller (Tarea 8, EmpleadoRepository).
      // Las reglas no se heredan de la coleccion padre, asi que esta
      // subcoleccion necesita su propio match aunque 'talleres/{tallerId}'
      // ya tenga reglas arriba.
      match /empleados/{empleadoId} {
        // Solo el dueño del taller (tallerId == su propio uid) o un admin
        // pueden ver la lista de empleados; ni siquiera el empleado mismo
        // necesita leer esta subcoleccion (EmpleadosScreen la usa solo
        // desde la vista del dueño).
        allow read: if isAuthenticated() && (request.auth.uid == tallerId || isAdmin());

        // El unico write de cliente real es EmpleadoRepository.desactivarEmpleado(),
        // que solo cambia 'activo'. crearRegistroEmpleado() (Tarea 6) nunca
        // se invoca en la app: crearEmpleadoTaller (Cloud Function) crea el
        // documento con el Admin SDK, que bypassea estas reglas por completo.
        allow update: if isAuthenticated() && request.auth.uid == tallerId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo']);

        allow create, delete: if isAdmin();
      }

      // Catálogo de servicios/repuestos rápidos del taller (Tarea 9,
      // CatalogoRepository). Igual que 'empleados', esta subcoleccion
      // necesita su propio match aunque 'talleres/{tallerId}' ya tenga
      // reglas arriba.
      match /catalogo_servicios/{itemId} {
        allow read: if true;
        // Ampliado (fix de integracion de empleados) para aceptar tambien a
        // una sub-cuenta de empleado actuando en nombre de `tallerId` via
        // actuaPorTaller(): antes solo `request.auth.uid == tallerId`
        // (el dueño real) podia escribir, dejando al empleado sin poder
        // gestionar el catalogo aunque `initiate_service_screen.dart` /
        // `catalogo_servicios_screen.dart` ya resuelven el id efectivo del
        // taller (dueño) y no el propio uid del empleado.
        allow create, update, delete: if isAuthenticated() && actuaPorTaller(tallerId);
      }
    }

    // 3. Tabla de Vehículos
    match /vehiculos/{vehiculoId} {
      // Un mecánico solo puede leer el vehículo si su taller ya tiene una
      // relación de servicio con él (talleres_vinculados, poblado por la
      // Cloud Function requestReviewOnServiceComplete al crear un servicio).
      // La búsqueda de vehículos nuevos por placa NO usa esta regla: pasa
      // por la Cloud Function callable buscarVehiculoPorPlaca, que devuelve
      // solo datos identificatorios sin exponer el documento completo.
      allow read: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid
        || isAdmin()
        || (isMecanico() && resource.data.get('talleres_vinculados', []).hasAny([request.auth.uid]))
        // Usuarios con quien el propietario comparte el vehiculo (ver
        // share_vehicle_sheet.dart) obtienen SOLO lectura aqui; a proposito
        // esto NO se agrega a isVehicleOwner(), que sigue significando "es
        // el dueño real" para isOwnFinishedService/servicios/reseñas.
        || resource.data.get('shared_with', []).hasAny([request.auth.uid])
      );

      // Solo el propietario registrado del vehículo puede crearlo o eliminarlo
      allow create: if isAuthenticated() && request.resource.data.id_propietario == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.id_propietario == request.auth.uid;

      // El propietario puede modificar todo su vehículo.
      // Un mecánico de un taller ya vinculado puede actualizar el vehículo
      // únicamente para reportar el 'kilometraje_actual'.
      allow update: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid
        || (isMecanico()
            && resource.data.get('talleres_vinculados', []).hasAny([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kilometraje_actual']))
        || isAdmin()
      );
    }

    // 4. Tabla de Servicios (Historial de Mantenimiento)
    match /servicios/{servicioId} {
      // MITIGACION PARCIAL (hallazgo critico C1 de la revision adversarial de
      // Fase C): la version anterior permitia a cualquier mecanico crear un
      // 'servicios' para CUALQUIER id_vehiculo con solo poner su propio uid
      // en id_taller, lo que el trigger requestReviewOnServiceComplete
      // traducia automaticamente en un talleres_vinculados permanente sobre
      // el vehiculo de otro, reabriendo exactamente la fuga que la Tarea 9
      // cerro (ver isVinculadoAlVehiculo). No existe hoy en el modelo de
      // datos un campo fiable de "reserva o cotizacion aceptada" referenciado
      // desde 'servicios' que las reglas puedan verificar con get()/exists():
      // ni reservas ni cotizaciones se referencian por id desde el documento
      // de servicio, y la busqueda de vehiculo por placa (Cloud Function
      // buscarVehiculoPorPlaca) esta deliberadamente abierta a cualquier
      // mecanico para soportar el flujo real de "cliente que llega sin cita"
      // (ver vehicle_search_screen.dart -> initiate_service_screen.dart),
      // que por diseno no tiene ninguna relacion previa que verificar.
      // Como mitigacion NO rompe ese flujo legitimo: reduce el alcance de la
      // fuga de "cualquier vehiculo, en cualquier momento" a "solo vehiculos
      // que ningun taller ha atendido todavia". Un vehiculo que ya tiene un
      // taller vinculado deja de poder ser secuestrado por uno distinto sin
      // pasar por el mismo taller.
      //
      // CIERRE COMPLETO (tarea C1-cierre): ya implementado. El trigger
      // requestReviewOnServiceComplete (functions/index.js) ya NO otorga
      // talleres_vinculados automaticamente cuando el vehiculo nunca tuvo
      // taller vinculado: en su lugar marca taller_pendiente_confirmacion
      // en el vehiculo y notifica al propietario (writeNotification + FCM).
      // El vinculo permanente solo se otorga cuando el propietario confirma
      // explicitamente desde su panel (VehicleService.confirmarVinculoTaller
      // / rechazarVinculoTaller), una escritura directa sobre su propio
      // /vehiculos ya permitida por la clausula de "allow update" de abajo
      // (resource.data.id_propietario == request.auth.uid, sin restriccion
      // de campos) — no requirio ningun cambio de regla nueva. La regla de
      // 'servicios' create de aqui abajo sigue siendo necesaria tal cual
      // esta: permite crear el servicio del walk-in (que dispara el
      // trigger), porque el vinculo permanente ahora depende de ese paso
      // posterior fuera de esta coleccion.
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isMecanico() && request.resource.data.id_taller == request.auth.uid
          && exists(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
          && (
            get(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
              .data.get('talleres_vinculados', []).size() == 0
            || get(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
                 .data.get('talleres_vinculados', []).hasAny([request.auth.uid])
          ))
      );
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
        || (isMecanico() && resource.data.id_taller == request.auth.uid)
      );
      // Un mecanico puede seguir actualizando su propio servicio (costo,
      // descripcion, materiales, etc.) pero NO puede reescribir id_vehiculo
      // ni id_taller: sin esta exclusion, un taller podia crear un servicio
      // legitimo en un vehiculo propio y luego, via update, apuntarlo al
      // vehiculo de una victima, inyectando un registro de servicio falso
      // en su historial (hallazgo Important, revision de la 2a ronda de
      // Fase C; adyacente a C1, no es un bypass de talleres_vinculados
      // porque ese trigger es solo onCreate).
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isMecanico() && resource.data.id_taller == request.auth.uid
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['id_vehiculo', 'id_taller']))
      );

      allow delete: if isAdmin();
    }

    // 5. Tabla de Alertas y Recordatorios
    // Restringido: solo el propietario del vehículo vinculado o admin puede gestionar alertas
    match /alertas/{alertaId} {
      // Lectura: propietario del vehículo vinculado, mecánico con relación, o admin
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      // Creación: propietario del vehículo o admin
      allow create: if isAuthenticated() && (
        isVehicleOwner(request.resource.data.id_vehiculo)
        || isAdmin()
      );

      // Actualización: propietario del vehículo o admin
      allow update: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );

      // Eliminación: propietario del vehículo o admin
      allow delete: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );
    }

    // 6. Tabla de Reseñas
    match /resenias/{reseniaId} {
      // Las reseñas son de lectura pública para alimentar el directorio de talleres.
      allow read: if true;

      // Solo el usuario autor puede crearla, y solo si referencia un servicio
      // real, del taller indicado y de un vehículo de su propiedad (evita
      // reseñas sin haber recibido un servicio); ver isOwnFinishedService.
      allow create: if isAuthenticated()
        && request.resource.data.id_usuario == request.auth.uid
        && request.resource.data.id_servicio is string
        && request.resource.data.id_servicio.size() > 0
        && exists(/databases/$(database)/documents/servicios/$(request.resource.data.id_servicio))
        && isOwnFinishedService(request.resource.data.id_servicio, request.resource.data.id_taller);

      // El autor puede corregir su texto, puntuacion, fotos y la marca de tiempo
      // de edicion (fecha_resenia, que ReviewService.updateReview siempre
      // reescribe); no se permite reasignar id_servicio/id_taller/id_usuario.
      //
      // El taller dueño de la reseña puede escribir unicamente respuesta_taller
      // (derecho a réplica), sin poder tocar el contenido original.
      //
      // Cualquier usuario autenticado puede marcar is_reported=true (reportar),
      // pero no puede usar ese mismo update para tocar ningun otro campo, ni
      // puede revertirlo a false (solo el admin puede des-reportar, vía delete
      // o mediante el propio panel de moderación que solo expone "eliminar").
      //
      // El admin puede moderar (p.ej. corregir comentario) pero, igual que
      // el autor, no puede reasignar id_servicio/id_taller/id_usuario vía
      // update: esa reasignación sigue prohibida sin excepción alguna.
      allow update: if isAuthenticated() && (
        (resource.data.id_usuario == request.auth.uid
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['comentario', 'estrellas', 'fecha_resenia', 'fotos']))
        || (actuaPorTaller(resource.data.id_taller)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['respuesta_taller']))
        || (request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['is_reported'])
            && request.resource.data.is_reported == true)
        || (isAdmin()
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['id_servicio', 'id_taller', 'id_usuario']))
      );

      // El autor original o el administrador (moderación de comentarios ofensivos) pueden eliminarla
      allow delete: if isAuthenticated() && (resource.data.id_usuario == request.auth.uid || isAdmin());
    }

    // 7. Tabla de Conversaciones
    // Restringido: solo los participantes de la conversación pueden leer/crear/actualizar
    match /conversaciones/{convId} {
      allow read: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid ||
        resource.data.id_mecanico == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.id_propietario == request.auth.uid ||
        request.resource.data.id_mecanico == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        resource.data.id_propietario == request.auth.uid ||
        resource.data.id_mecanico == request.auth.uid ||
        isAdmin()
      );

      // Subcolección de mensajes — solo participantes de la conversación padre
      match /mensajes/{msgId} {
        allow read, create, update: if isAuthenticated() &&
          (get(/databases/$(database)/documents/conversaciones/$(convId)).data
            .id_propietario == request.auth.uid ||
          get(/databases/$(database)/documents/conversaciones/$(convId)).data
            .id_mecanico == request.auth.uid);

        allow delete: if isAuthenticated() &&
          (get(/databases/$(database)/documents/conversaciones/$(convId)).data
            .id_propietario == request.auth.uid ||
          get(/databases/$(database)/documents/conversaciones/$(convId)).data
            .id_mecanico == request.auth.uid);
      }
    }

    // 8. Tabla de Reservas
    match /reservas/{reservaId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid ||
         isAdmin());
      // Tanto el propietario como el mecánico pueden proponer una cita desde
      // el chat (chat_screen.dart _mostrarSelectorFecha, flujo de
      // cotizacion+agenda integrado): cualquiera de los dos puede ser quien
      // crea el documento, con tal de que se asigne a sí mismo en su propio
      // campo (id_propietario/id_mecanico). Restringir esto a solo
      // propietario, como hacia la version anterior de esta regla, rompe la
      // mitad del flujo (el mecanico proponiendo fecha). Nota: al igual que
      // en la version anterior, no se valida aqui que exista una relacion
      // previa (conversacion) entre ambos uid — riesgo residual conocido,
      // sin escalar respecto al comportamiento previo a este merge.
      allow create: if isAuthenticated() &&
        (request.resource.data.id_propietario == request.auth.uid ||
         request.resource.data.id_mecanico == request.auth.uid);
      // Tras crearse, solo estado/fecha_hora_confirmada/fecha_hora_propuesta
      // son escribibles (ver ReservaRepository.actualizarEstadoReserva y
      // .reprogramarReserva, los unicos dos flujos reales de escritura):
      // sin este acotado, cualquiera de los dos participantes podia
      // reescribir id_propietario/id_mecanico/id_vehiculo/id_taller despues
      // de creada la reserva (hallazgo M1).
      allow update: if isAuthenticated() && (
        isAdmin() || (
          (resource.data.id_propietario == request.auth.uid ||
           resource.data.id_mecanico == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['estado', 'fecha_hora_confirmada', 'fecha_hora_propuesta'])
        )
      );
    }

    // 9. Tabla de Cotizaciones
    match /cotizaciones/{cotizacionId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid ||
         isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.id_mecanico == request.auth.uid;
      // Solo el campo 'estado' es escribible tras la creacion: el
      // propietario acepta/rechaza (actualizarEstadoCotizacion) y el
      // mecanico la marca 'finalizada' (finalizarServicioDesdeCotizacion);
      // ninguno de los dos flujos reales toca otro campo. Sin este acotado,
      // cualquiera de los dos podia reescribir 'items' (precio) o
      // reasignar id_propietario/id_mecanico despues de creada (hallazgo H1).
      allow update: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         resource.data.id_mecanico == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);

      // Beneficio por renglon (ver CotizacionItem.beneficio en el cliente):
      // documento privado fuera del doc principal porque 'cotizaciones' es
      // de lectura compartida con el propietario, y el beneficio del
      // mecanico nunca debe ser visible para el cliente (hallazgo H2).
      match /privado/{docId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.id_mecanico == request.auth.uid
          || isAdmin()
        );
        allow write: if isAuthenticated() &&
          get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.id_mecanico == request.auth.uid;
      }
    }

    // 10. Tabla de Mantenimientos (tareas de mantenimiento programadas)
    // Solo el propietario del vehículo puede leer/crear/actualizar/eliminar
    // Mecánicos pueden leer y actualizar (registrar km, marcar completado)
    match /mantenimientos/{mantenimientoId} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      allow create: if isAuthenticated() && (
        isVehicleOwner(request.resource.data.id_vehiculo)
        || isAdmin()
      );

      allow update: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      allow delete: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isAdmin()
      );
    }

    // 11. Tabla de Historial de Mantenimientos
    // Lectura: propietario del vehículo o mecánico del servicio
    // Escritura: mecánico o admin
    match /historial_mantenimientos/{historialId} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(resource.data.id_vehiculo)
        || isVinculadoAlVehiculo(resource.data.id_vehiculo)
        || isAdmin()
      );

      allow create: if isAuthenticated() && (
        (isVinculadoAlVehiculo(request.resource.data.id_vehiculo)
          && request.resource.data.id_taller == request.auth.uid)
        || isAdmin()
      );

      allow update: if isAuthenticated() && (
        (isVinculadoAlVehiculo(resource.data.id_vehiculo)
          && resource.data.id_taller == request.auth.uid)
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // 12. Admin Logs — audit trail
    // Lectura: solo administradores
    // Escritura: solo vía Admin SDK (Cloud Functions) o admin autenticado
    // Los clientes normales NO pueden escribir en esta colección
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      
      // Solo admin puede crear logs desde el cliente
      // Cloud Functions usan Admin SDK que bypasea estas reglas
      allow create: if isAdmin();
      
      allow update, delete: if false; // Logs son inmutables
    }

    // 13. Notificaciones in-app (para centro de notificaciones)
    match /notificaciones/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId); // marcar como leída
      allow create: if false; // Solo vía Cloud Functions (Admin SDK)
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 14. Tabla de Reparaciones (kanban de estado de reparación, panel mecánico)
    // Lectura: propietario del vehículo, taller asignado o admin
    // Escritura: solo el taller vinculado al vehículo (mismo patrón que
    // 'servicios'/'historial_mantenimientos'): create exige isMecanico() +
    // isVinculadoAlVehiculo(id_vehiculo) — o, igual que en 'servicios'
    // (walk-in: cliente sin cita previa, ver vehicle_search_screen.dart ->
    // initiate_service_screen.dart -> _iniciarTicketReparacion), que el
    // vehículo aún no tenga ningún taller vinculado — y que id_propietario
    // coincida con el dueño real del vehículo (evita inyectar una
    // reparación falsa en el vehículo de una víctima); update bloquea
    // reasignar id_vehiculo/id_taller/id_propietario tras la creación
    // (mismo hallazgo ya corregido en 'servicios').
    // Nota (fix de integracion de empleados): las 3 comparaciones de uid de
    // abajo (read/create/update) usan actuaPorTaller() en vez de
    // `== request.auth.uid` directo, para aceptar tambien a una sub-cuenta
    // de empleado actuando en nombre del taller dueño — ver
    // InitiateServiceScreen._iniciarTicketReparacion, que ya resuelve
    // `idTaller` al uid del dueño (UserModel.idTallerEfectivo), no al
    // propio uid del empleado. El resto de las condiciones (isMecanico(),
    // isVinculadoAlVehiculo, el carve-out de walk-in, el bloqueo de campos
    // en update) queda intacto: solo se amplia QUIEN puede ser "el taller",
    // no se relaja ninguna otra proteccion.
    match /reparaciones/{reparacionId} {
      allow read: if isAuthenticated() &&
        (resource.data.id_propietario == request.auth.uid ||
         actuaPorTaller(resource.data.id_taller) || isAdmin());

      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isMecanico() && actuaPorTaller(request.resource.data.id_taller)
          && exists(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
          && (
            get(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
              .data.get('talleres_vinculados', []).size() == 0
            || get(/databases/$(database)/documents/vehiculos/$(request.resource.data.id_vehiculo))
                 .data.get('talleres_vinculados', []).hasAny([request.resource.data.id_taller])
          )
          && request.resource.data.id_propietario ==
               getVehicleOwner(request.resource.data.id_vehiculo))
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (actuaPorTaller(resource.data.id_taller)
          && !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['id_vehiculo', 'id_taller', 'id_propietario']))
      );

      allow delete: if isAdmin();
    }

  }
}
