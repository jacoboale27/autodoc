rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función auxiliar para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario es administrador consultando Firestore
    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'admin'];
    }

    // Verifica si el usuario es propietario de un vehículo
    function isVehicleOwner(vehicleId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/vehiculos/$(vehicleId)) &&
        firestore.get(/databases/(default)/documents/vehiculos/$(vehicleId)).data.id_propietario == request.auth.uid;
    }

    // Verifica si el usuario es mecánico
    function isMecanico() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in ['Mecanico', 'Taller'];
    }

    // Mecanico/taller cuya cuenta esta ADEMAS habilitada.
    //
    // isMecanico() de este archivo mira `rol` pero no `estado`, al reves que
    // su homonima de firestore.rules. Esa asimetria es deliberada y util para
    // el expediente de verificacion —que se sube justo cuando la cuenta aun
    // no esta aprobada— pero seria un agujero en la galeria comercial: sin
    // este chequeo, cualquiera que se registre como taller podria publicar
    // imagenes en una ruta de lectura publica antes de que un humano lo haya
    // mirado, sin haber pasado ninguna revision.
    //
    // Los valores son los mismos que AppEstadoCuenta.aprobados e isMecanico()
    // de firestore.rules; si cambian alli, cambian aqui.
    function esTallerAprobado(uid) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(uid)) &&
        firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.rol in ['Mecanico', 'Taller'] &&
        firestore.get(/databases/(default)/documents/usuarios/$(uid)).data.get('estado', 'pendiente') in ['aprobado', 'activo'];
    }

    // Toda escritura de imagen: maximo 5 MB y tipo de imagen permitido.
    // Se excluye deliberadamente image/svg+xml: un SVG puede contener script
    // y se serviria desde el dominio del propio proyecto.
    function esImagenValida() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    // Facturas: ademas de imagen, la app soporta subir el comprobante como
    // PDF (ver invoice_upload_service.dart e initiate_service_screen.dart).
    // Mismo limite de 5 MB; se sigue excluyendo SVG/HTML explicitamente.
    function esFacturaValida() {
      return request.resource.size < 5 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') ||
         request.resource.contentType == 'application/pdf');
    }

    // Notas de voz de chat: no son imagen, por lo que esImagenValida() no
    // aplica. Limite de 10 MB (cubre sobradamente los ~90s que permite la UI
    // de grabacion) y solo los content-types de audio que produce el
    // grabador/reproductor de la app.
    function esAudioValido() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/(mp4|aac|m4a|mpeg)');
    }

    // Mecanico cuyo taller esta vinculado al vehiculo.
    function isVinculadoAlVehiculo(vehicleId) {
      return isMecanico() &&
        firestore.exists(/databases/(default)/documents/vehiculos/$(vehicleId)) &&
        firestore.get(/databases/(default)/documents/vehiculos/$(vehicleId))
          .data.get('talleres_vinculados', []).hasAny([request.auth.uid]);
    }

    // Propietario del vehiculo al que pertenece un servicio dado. Espeja
    // isOwnFinishedService() de firestore.rules (sin repetir el chequeo de
    // id_taller, que no aplica aqui): las fotos de una resenia se suben
    // ANTES de crear el documento de resenia (ver review_sheet.dart#_submit
    // y ReviewService.subirFotosResenia), por lo que no podemos apoyarnos en
    // el propio doc de resenia para autorizar. En su lugar autorizamos
    // directamente contra servicios/{idServicio}.id_vehiculo, igual que
    // hace el bloque de facturas/{vehicleId} mas abajo.
    function esPropietarioDelServicio(idServicio) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/servicios/$(idServicio)) &&
        isVehicleOwner(
          firestore.get(/databases/(default)/documents/servicios/$(idServicio)).data.id_vehiculo
        );
    }

    // Reglas para fotos de perfil
    // Cualquier usuario de la app puede leer las fotos de perfil
    // Solo el propietario puede subir o modificar su propia foto de perfil
    match /perfiles/{fileId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && esImagenValida()
        && fileId.matches('^' + request.auth.uid + '(\\.(jpg|jpeg|png|webp))?$');
    }

    // Reglas para facturas y recibos de mantenimiento
    // Lectura: propietario del vehículo, mecánicos con servicio activo, o admin
    // Escritura: propietario del vehículo, mecánicos, o admin
    match /facturas/{vehicleId}/{fileName} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(vehicleId)
        || isVinculadoAlVehiculo(vehicleId)
        || isAdmin()
      );
      allow write: if isAuthenticated()
        && esFacturaValida()
        && (isVehicleOwner(vehicleId) || isVinculadoAlVehiculo(vehicleId) || isAdmin());
      // Las facturas son el rastro documental del producto: solo un admin las borra.
      allow delete: if isAdmin();
    }

    // Reglas para imágenes de chat
    // Solo participantes de la conversación (autenticados)
    match /chat_images/{conversacionId}/{fileName} {
      allow read: if isAuthenticated() && (
        isAdmin() || (
          firestore.exists(/databases/(default)/documents/conversaciones/$(conversacionId)) &&
          (firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_propietario == request.auth.uid ||
           firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_mecanico == request.auth.uid)
        )
      );
      allow write: if isAuthenticated() && esImagenValida() && (
        firestore.exists(/databases/(default)/documents/conversaciones/$(conversacionId)) &&
        (firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_propietario == request.auth.uid ||
         firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_mecanico == request.auth.uid)
      );
    }

    // Reglas para notas de voz de chat
    // Mismo criterio de autorizacion que chat_images/: solo participantes
    // de la conversacion (autenticados), o admin para lectura.
    match /chat_audios/{conversacionId}/{fileName} {
      allow read: if isAuthenticated() && (
        isAdmin() || (
          firestore.exists(/databases/(default)/documents/conversaciones/$(conversacionId)) &&
          (firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_propietario == request.auth.uid ||
           firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_mecanico == request.auth.uid)
        )
      );
      allow write: if isAuthenticated() && esAudioValido() && (
        firestore.exists(/databases/(default)/documents/conversaciones/$(conversacionId)) &&
        (firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_propietario == request.auth.uid ||
         firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_mecanico == request.auth.uid)
      );
    }

    // Reglas para imágenes de vehículos
    //
    // {allPaths=**} y no {fileName}: la galeria de fotos sube a
    // `vehiculos/{vehicleId}/fotos/{uuid}.jpg` (ver VehiclePhotoService.addPhoto),
    // que son DOS segmentos bajo el vehiculo. Un comodin simple como {fileName}
    // solo captura un segmento, asi que esa ruta no casaba con ninguna regla y
    // toda subida a la galeria moria en permission-denied.
    match /vehiculos/{vehicleId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(vehicleId)
        || isVinculadoAlVehiculo(vehicleId)
        || isAdmin()
      );
      allow write: if isAuthenticated()
        && esImagenValida()
        && (isVehicleOwner(vehicleId) || isAdmin());
      allow delete: if isAuthenticated() && (isVehicleOwner(vehicleId) || isAdmin());
    }

    // Evidencia de verificacion de un taller.
    //
    // Contrapartida en Storage de la coleccion `verificaciones` de Firestore:
    // los documentos con los que un taller demuestra que el negocio existe.
    // NO es contenido comercial y nunca se publica; la galeria que si se
    // enseña al publico es otra ruta.
    //
    // Lectura: solo el propio taller y un administrador. A diferencia de
    // `perfiles/` o `resenia_fotos/`, aqui NO vale "cualquier autenticado":
    // un NIT es un dato identificativo del negocio.
    //
    // Escritura: solo el propio taller, y a proposito SIN exigir que este
    // aprobado. Es el unico bloque del archivo donde esa asimetria de
    // isMecanico() —que mira `rol` pero no `estado`— es justo lo que hace
    // falta: un taller sube su expediente precisamente cuando todavia no
    // esta aprobado. Que el taller no sea aun un mecanico operativo se sigue
    // comprobando donde importa, en firestore.rules.
    //
    // Los nombres de archivo son un whitelist fijo de tres. Las reglas de
    // Storage no pueden CONTAR archivos, asi que un `{fileName}` libre deja
    // subir ilimitados objetos de 5 MB a una cuenta que ni siquiera esta
    // aprobada: spam de almacenamiento facturable sin ninguna cuota que lo
    // frene. Fijar los nombres da un tope duro de 3 archivos por taller sin
    // contador, sin Cloud Function y sin huerfanos que limpiar, porque
    // corregir una subida es sobrescribirla. Debe coincidir con
    // VerificacionTallerModel.slotsPermitidos.
    //
    // El PDF se admite solo para el NIT, que es lo unico que llega
    // razonablemente como escaneo; fachada y rotulo son fotos y solo aceptan
    // imagen.
    //
    // Borrado: solo admin, misma postura que `facturas/`. La evidencia es el
    // rastro de por que se aprobo un taller; si el propio taller pudiera
    // borrarla, bastaria con aprobarse y limpiar detras. Para corregir una
    // subida se sobrescribe.
    match /verificaciones/{tallerId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == tallerId || isAdmin());

      // `write` en Storage cubre tambien el DELETE, y en un delete
      // `request.resource` es null: sin este guarda, borrar dispara un
      // "Null value error" al evaluar el content-type. El borrado real lo
      // resuelve el `allow delete` de abajo; esto solo evita que esta regla
      // reviente en vez de denegar limpiamente.
      allow write: if isAuthenticated()
        && request.resource != null
        && request.auth.uid == tallerId
        && isMecanico()
        && (
             (fileName.matches('^nit\\.(jpg|jpeg|png|webp|pdf)$') && esFacturaValida())
             || (fileName.matches('^(fachada|rotulo)\\.(jpg|jpeg|png|webp)$') && esImagenValida())
           );

      allow delete: if isAdmin();
    }

    // Galeria comercial de un taller: logo y fotos del local.
    //
    // No confundir con `verificaciones/`, que es su opuesto en todo: aquella
    // es evidencia privada que se sube ANTES de estar aprobado y solo ven el
    // taller y un administrador; esta es escaparate publico que solo se puede
    // publicar DESPUES de estar aprobado.
    //
    // Lectura publica y sin autenticar, igual que `talleres` en
    // firestore.rules (`allow read: if true`). El directorio de talleres es
    // publico por diseño; unas fotos de escaparate que exigieran login no se
    // verian en el sitio donde tienen sentido.
    //
    // Escritura solo del propio taller Y solo si esta aprobado: publicar en
    // una ruta de lectura publica es exactamente lo que la revision viene a
    // autorizar.
    //
    // Seis nombres fijos, misma razon que en `verificaciones/`: las reglas de
    // Storage no pueden CONTAR archivos, asi que fijar los nombres es lo unico
    // que pone un tope duro (aqui, 1 logo + 5 fotos del local) sin contador ni
    // Cloud Function. Cambiar una foto es sobrescribir su hueco.
    //
    // Debe coincidir con GaleriaTaller.slotsPermitidos.
    match /talleres_fotos/{tallerId}/{fileName} {
      allow read: if true;

      allow write: if request.resource != null
        && request.auth.uid == tallerId
        && esTallerAprobado(tallerId)
        && esImagenValida()
        && fileName.matches('^(logo|local-[1-5])\\.(jpg|jpeg|png|webp)$');

      // A diferencia de la evidencia de verificacion, que solo borra un admin,
      // aqui el taller SI borra lo suyo: son sus fotos comerciales, quitar la
      // foto de un local que ya no existe es gestion normal del negocio y no
      // destruye ningun rastro de por que se le aprobo. El admin conserva el
      // borrado para moderar contenido reportado.
      allow delete: if isAdmin() ||
        (request.auth.uid == tallerId && esTallerAprobado(tallerId));
    }

    // Reglas para fotos adjuntas a resenias
    // Lectura: las resenias son publicas en Firestore (allow read: if true),
    // pero Storage exige como minimo autenticacion, siguiendo la convencion
    // ya usada en este archivo (perfiles/, vehiculos/, etc. tampoco son de
    // lectura anonima).
    // Escritura: solo el propietario del vehiculo del servicio reseniado
    // (ver esPropietarioDelServicio) puede subir fotos a su propia carpeta
    // de servicio.
    // Eliminacion: solo admin (moderacion de contenido reportado).
    match /resenia_fotos/{idServicio}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if esImagenValida() && esPropietarioDelServicio(idServicio);
      allow delete: if isAdmin();
    }
  }
}
