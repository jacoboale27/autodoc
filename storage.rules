rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función auxiliar para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario es administrador consultando Firestore
    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'admin'];
    }

    // Verifica si el usuario es propietario de un vehículo
    function isVehicleOwner(vehicleId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/vehiculos/$(vehicleId)) &&
        firestore.get(/databases/(default)/documents/vehiculos/$(vehicleId)).data.id_propietario == request.auth.uid;
    }

    // Verifica si el usuario es mecánico
    function isMecanico() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol in ['Mecanico', 'Taller'];
    }

    // Toda escritura de imagen: maximo 5 MB y tipo de imagen permitido.
    // Se excluye deliberadamente image/svg+xml: un SVG puede contener script
    // y se serviria desde el dominio del propio proyecto.
    function esImagenValida() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    // Facturas: ademas de imagen, la app soporta subir el comprobante como
    // PDF (ver invoice_upload_service.dart e initiate_service_screen.dart).
    // Mismo limite de 5 MB; se sigue excluyendo SVG/HTML explicitamente.
    function esFacturaValida() {
      return request.resource.size < 5 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') ||
         request.resource.contentType == 'application/pdf');
    }

    // Notas de voz de chat: no son imagen, por lo que esImagenValida() no
    // aplica. Limite de 10 MB (cubre sobradamente los ~90s que permite la UI
    // de grabacion) y solo los content-types de audio que produce el
    // grabador/reproductor de la app.
    function esAudioValido() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/(mp4|aac|m4a|mpeg)');
    }

    // Mecanico cuyo taller esta vinculado al vehiculo.
    function isVinculadoAlVehiculo(vehicleId) {
      return isMecanico() &&
        firestore.exists(/databases/(default)/documents/vehiculos/$(vehicleId)) &&
        firestore.get(/databases/(default)/documents/vehiculos/$(vehicleId))
          .data.get('talleres_vinculados', []).hasAny([request.auth.uid]);
    }

    // Propietario del vehiculo al que pertenece un servicio dado. Espeja
    // isOwnFinishedService() de firestore.rules (sin repetir el chequeo de
    // id_taller, que no aplica aqui): las fotos de una resenia se suben
    // ANTES de crear el documento de resenia (ver review_sheet.dart#_submit
    // y ReviewService.subirFotosResenia), por lo que no podemos apoyarnos en
    // el propio doc de resenia para autorizar. En su lugar autorizamos
    // directamente contra servicios/{idServicio}.id_vehiculo, igual que
    // hace el bloque de facturas/{vehicleId} mas abajo.
    function esPropietarioDelServicio(idServicio) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/servicios/$(idServicio)) &&
        isVehicleOwner(
          firestore.get(/databases/(default)/documents/servicios/$(idServicio)).data.id_vehiculo
        );
    }

    // Reglas para fotos de perfil
    // Cualquier usuario de la app puede leer las fotos de perfil
    // Solo el propietario puede subir o modificar su propia foto de perfil
    match /perfiles/{fileId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && esImagenValida()
        && fileId.matches('^' + request.auth.uid + '(\\.(jpg|jpeg|png|webp))?$');
    }

    // Reglas para facturas y recibos de mantenimiento
    // Lectura: propietario del vehículo, mecánicos con servicio activo, o admin
    // Escritura: propietario del vehículo, mecánicos, o admin
    match /facturas/{vehicleId}/{fileName} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(vehicleId)
        || isVinculadoAlVehiculo(vehicleId)
        || isAdmin()
      );
      allow write: if isAuthenticated()
        && esFacturaValida()
        && (isVehicleOwner(vehicleId) || isVinculadoAlVehiculo(vehicleId) || isAdmin());
      // Las facturas son el rastro documental del producto: solo un admin las borra.
      allow delete: if isAdmin();
    }

    // Reglas para imágenes de chat
    // Solo participantes de la conversación (autenticados)
    match /chat_images/{conversacionId}/{fileName} {
      allow read: if isAuthenticated() && (
        isAdmin() || (
          firestore.exists(/databases/(default)/documents/conversaciones/$(conversacionId)) &&
          (firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_propietario == request.auth.uid ||
           firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_mecanico == request.auth.uid)
        )
      );
      allow write: if isAuthenticated() && esImagenValida() && (
        firestore.exists(/databases/(default)/documents/conversaciones/$(conversacionId)) &&
        (firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_propietario == request.auth.uid ||
         firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_mecanico == request.auth.uid)
      );
    }

    // Reglas para notas de voz de chat
    // Mismo criterio de autorizacion que chat_images/: solo participantes
    // de la conversacion (autenticados), o admin para lectura.
    match /chat_audios/{conversacionId}/{fileName} {
      allow read: if isAuthenticated() && (
        isAdmin() || (
          firestore.exists(/databases/(default)/documents/conversaciones/$(conversacionId)) &&
          (firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_propietario == request.auth.uid ||
           firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_mecanico == request.auth.uid)
        )
      );
      allow write: if isAuthenticated() && esAudioValido() && (
        firestore.exists(/databases/(default)/documents/conversaciones/$(conversacionId)) &&
        (firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_propietario == request.auth.uid ||
         firestore.get(/databases/(default)/documents/conversaciones/$(conversacionId)).data.id_mecanico == request.auth.uid)
      );
    }

    // Reglas para imágenes de vehículos
    match /vehiculos/{vehicleId}/{fileName} {
      allow read: if isAuthenticated() && (
        isVehicleOwner(vehicleId)
        || isVinculadoAlVehiculo(vehicleId)
        || isAdmin()
      );
      allow write: if isAuthenticated()
        && esImagenValida()
        && (isVehicleOwner(vehicleId) || isAdmin());
      allow delete: if isAuthenticated() && (isVehicleOwner(vehicleId) || isAdmin());
    }

    // Reglas para fotos adjuntas a resenias
    // Lectura: las resenias son publicas en Firestore (allow read: if true),
    // pero Storage exige como minimo autenticacion, siguiendo la convencion
    // ya usada en este archivo (perfiles/, vehiculos/, etc. tampoco son de
    // lectura anonima).
    // Escritura: solo el propietario del vehiculo del servicio reseniado
    // (ver esPropietarioDelServicio) puede subir fotos a su propia carpeta
    // de servicio.
    // Eliminacion: solo admin (moderacion de contenido reportado).
    match /resenia_fotos/{idServicio}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if esImagenValida() && esPropietarioDelServicio(idServicio);
      allow delete: if isAdmin();
    }
  }
}
