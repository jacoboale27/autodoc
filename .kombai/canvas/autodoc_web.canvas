      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-primary: #522C81;\n    --color-mint: #81E6D9;\n    --color-slate-night: #0F172A;\n    --color-slate-surface: #1E293B;\n    --color-slate-container: #141E36;\n    --color-text-primary: #F8FAFC;\n    --color-text-secondary: #94A3B8;\n    --color-outline: #334155;\n    --radius-lg: 16px;\n    --radius-xxl: 32px;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    background-color: var(--color-slate-night);\n    color: var(--color-text-primary);\n    overflow-x: hidden;\n  }\n\n  .glass-header {\n    background: rgba(15, 23, 42, 0.6);\n    backdrop-filter: blur(12px);\n    border: 1px solid var(--color-outline);\n  }\n\n  .hero-gradient {\n    background: radial-gradient(circle at 80% 50%, rgba(82, 44, 129, 0.3) 0%, transparent 70%);\n  }\n\n  /* Command Center Styles */\n  .tab-card {\n    cursor: pointer;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    background: var(--color-slate-container);\n    border: 1px solid var(--color-outline);\n    border-radius: var(--radius-lg);\n  }\n\n  .tab-card:hover {\n    border-color: var(--color-mint);\n    transform: translateX(8px);\n  }\n\n  .tab-card.active {\n    background: var(--color-primary);\n    border-left: 4px solid var(--color-mint);\n    transform: translateX(12px);\n  }\n\n  .display-area {\n    background: var(--color-slate-container);\n    border-radius: var(--radius-xxl);\n    border: 1px solid var(--color-outline);\n    position: relative;\n    overflow: hidden;\n    box-shadow: inset 0 0 40px rgba(129, 230, 217, 0.05);\n  }\n\n  .feature-content {\n    position: absolute;\n    inset: 0;\n    opacity: 0;\n    visibility: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .feature-content.active {\n    opacity: 1;\n    visibility: visible;\n  }\n\n  .glass-tag {\n    background: rgba(15, 23, 42, 0.6);\n    backdrop-filter: blur(8px);\n    border: 1px solid rgba(129, 230, 217, 0.2);\n    border-radius: 8px;\n    padding: 8px 12px;\n  }\n\n  .device-mockup {\n    position: relative;\n    width: 200px;\n    height: 420px;\n    background: #000;\n    border-radius: 32px;\n    border: 6px solid var(--color-slate-surface);\n    overflow: hidden;\n    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);\n  }\n\n  .device-screen {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n</style>\n\n<div class=\"min-h-screen selection:bg-mint/30\" data-kid=\"1\">\n  \n  <header class=\"fixed top-6 left-1/2 -translate-x-1/2 z-50 w-[90%] max-w-5xl\" data-kid=\"2\">\n    <nav class=\"glass-header rounded-full px-6 py-3 flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-2\" data-kid=\"4\">\n        <div class=\"w-8 h-8 bg-mint rounded-lg flex items-center justify-center\" data-kid=\"5\">\n          <i class=\"ti ti-car text-primary text-xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"text-xl font-bold tracking-tight\" data-kid=\"7\">AutoDoc</span>\n      </div>\n      \n      <div class=\"hidden md:flex items-center gap-8\" data-kid=\"8\">\n        <a href=\"#features\" class=\"text-sm font-medium hover:text-mint transition-colors\" data-kid=\"9\">Plataforma</a>\n        <a href=\"#owners\" class=\"text-sm font-medium hover:text-mint transition-colors\" data-kid=\"10\">Para Dueños</a>\n        <a href=\"#workshops\" class=\"text-sm font-medium hover:text-mint transition-colors\" data-kid=\"11\">Talleres</a>\n      </div>\n\n      <div class=\"flex items-center gap-4\" data-kid=\"12\">\n        <button class=\"text-sm font-medium px-4 py-2 hover:text-mint transition-colors\" data-kid=\"13\">Login</button>\n        <button class=\"bg-mint text-primary text-sm font-bold px-5 py-2.5 rounded-full hover:scale-105 transition-transform\" data-kid=\"14\">\n          Probar Gratis\n        </button>\n      </div>\n    </nav>\n  </header>\n\n  \n  <section class=\"relative pt-40 pb-20 px-6 max-w-7xl mx-auto min-h-[90vh] flex items-center hero-gradient\" data-kid=\"15\">\n    <div class=\"grid lg:grid-cols-[5fr_5fr] gap-12 items-center w-full\" data-kid=\"16\">\n      <div class=\"hero-text-area\" data-kid=\"17\">\n        <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-mint/10 border border-mint/20 text-mint text-xs font-bold mb-6 uppercase tracking-widest\" data-kid=\"18\">\n          Control total en tu mano\n        </div>\n        <h1 class=\"text-5xl lg:text-7xl font-extrabold leading-[1.1] mb-6 tracking-tight\" data-kid=\"19\">\n          Tu Garaje Virtual, <br data-kid=\"20\"> <span class=\"text-mint\" data-kid=\"21\">Elevado</span>\n        </h1>\n        <p class=\"text-xl text-slate-400 mb-10 max-w-lg leading-relaxed\" data-kid=\"22\">\n          Digitaliza tu vehículo hoy. Historial clínico certificado, alertas inteligentes de SOAT y mantenimientos, conectado con los mejores talleres.\n        </p>\n        <div class=\"flex flex-wrap gap-4\" data-kid=\"23\">\n          <button class=\"bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-xl font-bold text-lg shadow-xl shadow-primary/20 flex items-center gap-2 transition-all hover:-translate-y-1\" data-kid=\"24\">\n            Comenzar mi Garaje\n            <i class=\"ti ti-arrow-right\" data-kid=\"25\"></i>\n          </button>\n          <button class=\"border border-slate-700 hover:border-mint/50 px-8 py-4 rounded-xl font-bold text-lg transition-all flex items-center gap-2\" data-kid=\"26\">\n            Ver Directorio\n          </button>\n        </div>\n      </div>\n\n      <div class=\"relative flex justify-center items-center h-[500px]\" data-kid=\"27\">\n        <div class=\"relative z-10 w-full h-full flex items-center justify-center\" data-kid=\"28\">\n          <div class=\"hero-mockup-1 device-mockup absolute -translate-x-[120px] -translate-y-[20px] rotate-[-6deg] z-30\" data-kid=\"29\">\n            <img src=\"/api/local/images/idk/dashboard_screen_lightmode.jpg\" alt=\"Dashboard\" class=\"device-screen\" data-kid=\"30\">\n          </div>\n          <div class=\"hero-mockup-2 device-mockup absolute translate-x-[80px] translate-y-[40px] rotate-[4deg] z-20 scale-95 opacity-80\" data-kid=\"31\">\n            <img src=\"/api/local/images/idk/garage_screen_lightmode.jpg\" alt=\"Garage\" class=\"device-screen\" data-kid=\"32\">\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"features\" class=\"py-32 px-6 max-w-7xl mx-auto\" data-kid=\"33\">\n    <div class=\"text-center mb-20\" data-kid=\"34\">\n      <h2 class=\"text-4xl md:text-5xl font-extrabold mb-4\" data-kid=\"35\">Digital Command Center</h2>\n      <p class=\"text-slate-400 text-lg max-w-2xl mx-auto\" data-kid=\"36\">Toma el mando de tu experiencia automotriz con herramientas diseñadas para tu tranquilidad.</p>\n    </div>\n\n    <div class=\"grid lg:grid-cols-[4fr_6fr] gap-12 items-stretch min-h-[600px]\" data-kid=\"37\">\n      \n      <div class=\"flex flex-col gap-4\" data-kid=\"38\">\n        \n        <div class=\"tab-card active p-6\" data-target=\"tab-1\" data-kid=\"39\">\n          <div class=\"flex items-center gap-4 mb-2\" data-kid=\"40\">\n            <div class=\"w-10 h-10 rounded-lg bg-mint/20 flex items-center justify-center\" data-kid=\"41\">\n              <i class=\"ti ti-car text-mint text-xl\" data-kid=\"42\"></i>\n            </div>\n            <h4 class=\"text-xl font-bold\" data-kid=\"43\">Garaje Virtual</h4>\n          </div>\n          <p class=\"text-slate-400 text-sm pl-14\" data-kid=\"44\">Centraliza la información de todos tus vehículos en un solo panel interactivo.</p>\n        </div>\n\n        \n        <div class=\"tab-card p-6\" data-target=\"tab-2\" data-kid=\"45\">\n          <div class=\"flex items-center gap-4 mb-2\" data-kid=\"46\">\n            <div class=\"w-10 h-10 rounded-lg bg-mint/20 flex items-center justify-center\" data-kid=\"47\">\n              <i class=\"ti ti-history text-mint text-xl\" data-kid=\"48\"></i>\n            </div>\n            <h4 class=\"text-xl font-bold\" data-kid=\"49\">Historial Digital</h4>\n          </div>\n          <p class=\"text-slate-400 text-sm pl-14\" data-kid=\"50\">Cada servicio, factura y foto guardada de forma segura para siempre.</p>\n        </div>\n\n        \n        <div class=\"tab-card p-6\" data-target=\"tab-3\" data-kid=\"51\">\n          <div class=\"flex items-center gap-4 mb-2\" data-kid=\"52\">\n            <div class=\"w-10 h-10 rounded-lg bg-mint/20 flex items-center justify-center\" data-kid=\"53\">\n              <i class=\"ti ti-bell-ringing text-mint text-xl\" data-kid=\"54\"></i>\n            </div>\n            <h4 class=\"text-xl font-bold\" data-kid=\"55\">Alertas Proactivas</h4>\n          </div>\n          <p class=\"text-slate-400 text-sm pl-14\" data-kid=\"56\">SOAT, seguros y cambios de aceite. Te avisamos antes de que sea tarde.</p>\n        </div>\n\n        \n        <div class=\"tab-card p-6\" data-target=\"tab-4\" data-kid=\"57\">\n          <div class=\"flex items-center gap-4 mb-2\" data-kid=\"58\">\n            <div class=\"w-10 h-10 rounded-lg bg-mint/20 flex items-center justify-center\" data-kid=\"59\">\n              <i class=\"ti ti-link text-mint text-xl\" data-kid=\"60\"></i>\n            </div>\n            <h4 class=\"text-xl font-bold\" data-kid=\"61\">Conexión con Talleres</h4>\n          </div>\n          <p class=\"text-slate-400 text-sm pl-14\" data-kid=\"62\">Sincronización directa con mecánicos para validación de servicios real.</p>\n        </div>\n      </div>\n\n      \n      <div class=\"display-area\" data-kid=\"63\">\n        \n        <div id=\"tab-1\" class=\"feature-content active\" data-kid=\"64\">\n          <div class=\"relative w-full h-full\" data-kid=\"65\">\n            <img src=\"https://images.unsplash.com/photo-1592199564137-731e91904939?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTAwNDR8MHwxfHNlYXJjaHwxfHxtb2Rlcm4lMjBsdXh1cnklMjBjYXIlMjBwYXJrZWQlMjBpbiUyMGElMjBtaW5pbWFsaXN0JTIwYnJpZ2h0JTIwc3R1ZGlvfGVufDB8fHx8MTc4Mjk0MjYxNnww&ixlib=rb-4.1.0&q=85\" alt=\"Luxury Car\" class=\"w-full h-full object-cover opacity-60\" data-kid=\"66\">\n            <div class=\"absolute inset-0 flex items-center justify-center p-12\" data-kid=\"67\">\n              <div class=\"grid grid-cols-2 gap-4 w-full max-w-md\" data-kid=\"68\">\n                <div class=\"glass-tag flex flex-col gap-1\" data-kid=\"69\">\n                  <span class=\"text-[10px] text-mint font-bold uppercase\" data-kid=\"70\">Modelo</span>\n                  <span class=\"text-sm font-bold\" data-kid=\"71\">Porsche 911 Carrera</span>\n                </div>\n                <div class=\"glass-tag flex flex-col gap-1\" data-kid=\"72\">\n                  <span class=\"text-[10px] text-mint font-bold uppercase\" data-kid=\"73\">Año</span>\n                  <span class=\"text-sm font-bold\" data-kid=\"74\">2023</span>\n                </div>\n                <div class=\"glass-tag col-span-2 flex items-center justify-between\" data-kid=\"75\">\n                  <div class=\"flex flex-col gap-1\" data-kid=\"76\">\n                    <span class=\"text-[10px] text-mint font-bold uppercase\" data-kid=\"77\">Seguro SOAT</span>\n                    <span class=\"text-sm font-bold\" data-kid=\"78\">Vigente hasta Dic 2026</span>\n                  </div>\n                  <i class=\"ti ti-shield-check text-mint text-xl\" data-kid=\"79\"></i>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div id=\"tab-2\" class=\"feature-content\" data-kid=\"80\">\n          <div class=\"relative w-full h-full bg-slate-900/50 flex flex-col p-12\" data-kid=\"81\">\n            <img src=\"https://images.pexels.com/photos/8985913/pexels-photo-8985913.jpeg\" alt=\"Tools\" class=\"absolute inset-0 w-full h-full object-cover opacity-30\" data-kid=\"82\">\n            <h4 class=\"text-2xl font-bold mb-8 relative z-10\" data-kid=\"83\">Línea de Tiempo Clínica</h4>\n            <div class=\"space-y-6 relative z-10 max-w-sm\" data-kid=\"84\">\n              <div class=\"flex gap-4 items-start\" data-kid=\"85\">\n                <div class=\"w-3 h-3 rounded-full bg-mint mt-1.5 shadow-[0_0_10px_var(--color-mint)]\" data-kid=\"86\"></div>\n                <div data-kid=\"87\">\n                  <p class=\"text-xs text-mint font-bold\" data-kid=\"88\">15 JUN 2026</p>\n                  <p class=\"text-sm font-bold\" data-kid=\"89\">Cambio de Kit de Distribución</p>\n                  <p class=\"text-[10px] text-slate-500\" data-kid=\"90\">Taller Central Motor • 45,000 km</p>\n                </div>\n              </div>\n              <div class=\"flex gap-4 items-start opacity-60\" data-kid=\"91\">\n                <div class=\"w-3 h-3 rounded-full bg-slate-600 mt-1.5\" data-kid=\"92\"></div>\n                <div data-kid=\"93\">\n                  <p class=\"text-xs text-slate-400\" data-kid=\"94\">12 MAR 2026</p>\n                  <p class=\"text-sm font-bold\" data-kid=\"95\">Mantenimiento Preventivo</p>\n                  <p class=\"text-[10px] text-slate-500\" data-kid=\"96\">AutoExpress • 42,300 km</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div id=\"tab-3\" class=\"feature-content\" data-kid=\"97\">\n          <div class=\"relative w-full h-full flex items-center justify-center\" data-kid=\"98\">\n            <img src=\"https://images.pexels.com/photos/10924197/pexels-photo-10924197.jpeg\" alt=\"Speedometer\" class=\"absolute inset-0 w-full h-full object-cover opacity-50\" data-kid=\"99\">\n            <div class=\"relative z-10 w-[80%] max-w-sm\" data-kid=\"100\">\n              <div class=\"bg-mint p-6 rounded-2xl shadow-[0_20px_50px_rgba(129,230,217,0.3)] transform -rotate-2\" data-kid=\"101\">\n                <div class=\"flex items-center gap-4 text-primary\" data-kid=\"102\">\n                  <i class=\"ti ti-alert-triangle text-3xl\" data-kid=\"103\"></i>\n                  <div data-kid=\"104\">\n                    <p class=\"font-black text-lg leading-tight\" data-kid=\"105\">ATENCIÓN REQUERIDA</p>\n                    <p class=\"text-xs font-bold opacity-80\" data-kid=\"106\">Próximo cambio de aceite en 500km</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div id=\"tab-4\" class=\"feature-content\" data-kid=\"107\">\n          <div class=\"w-full h-full p-12 flex flex-col justify-center gap-8\" data-kid=\"108\">\n             <div class=\"flex items-center gap-12 justify-center\" data-kid=\"109\">\n                <div class=\"flex flex-col items-center gap-3\" data-kid=\"110\">\n                  <div class=\"w-20 h-20 rounded-3xl bg-primary border border-mint/30 flex items-center justify-center text-4xl\" data-kid=\"111\">\n                    <i class=\"ti ti-car-garage text-mint\" data-kid=\"112\"></i>\n                  </div>\n                  <span class=\"text-xs font-bold text-slate-500\" data-kid=\"113\">TALLER</span>\n                </div>\n                <div class=\"flex-1 max-w-[120px] h-px bg-gradient-to-r from-mint/50 to-mint/50 relative\" data-kid=\"114\">\n                  <div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"115\">\n                    <i class=\"ti ti-refresh text-mint animate-spin\" data-kid=\"116\"></i>\n                  </div>\n                </div>\n                <div class=\"flex flex-col items-center gap-3\" data-kid=\"117\">\n                  <div class=\"w-20 h-20 rounded-3xl bg-mint flex items-center justify-center text-4xl\" data-kid=\"118\">\n                    <i class=\"ti ti-device-mobile text-primary\" data-kid=\"119\"></i>\n                  </div>\n                  <span class=\"text-xs font-bold text-mint\" data-kid=\"120\">TU APP</span>\n                </div>\n             </div>\n             <div class=\"text-center\" data-kid=\"121\">\n               <p class=\"text-xl font-bold mb-2\" data-kid=\"122\">Sincronización Certificada</p>\n               <p class=\"text-slate-400 text-sm max-w-xs mx-auto\" data-kid=\"123\">Tu mecánico sube la evidencia y tú la recibes al instante con trazabilidad total.</p>\n             </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-24 px-6 bg-slate-surface/30\" data-kid=\"124\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-16\" data-kid=\"125\">\n      <div class=\"md:w-1/2\" data-kid=\"126\">\n        <h2 class=\"text-4xl font-extrabold mb-6\" data-kid=\"127\">Tranquilidad para el conductor, <span class=\"text-mint\" data-kid=\"128\">eficiencia para el experto.</span></h2>\n        <p class=\"text-slate-400 text-lg mb-8 leading-relaxed\" data-kid=\"129\">\n          Diseñamos una plataforma que rompe la barrera de desconfianza entre dueños y talleres. Con AutoDoc, cada intervención es clara, cada costo es justificado y cada vehículo mantiene su valor de reventa.\n        </p>\n        <div class=\"grid grid-cols-2 gap-6\" data-kid=\"130\">\n          <div data-kid=\"131\">\n            <h5 class=\"text-mint font-bold text-2xl mb-1\" data-kid=\"132\">98%</h5>\n            <p class=\"text-xs text-slate-500 uppercase font-bold tracking-widest\" data-kid=\"133\">Satisfacción del Usuario</p>\n          </div>\n          <div data-kid=\"134\">\n            <h5 class=\"text-mint font-bold text-2xl mb-1\" data-kid=\"135\">+500</h5>\n            <p class=\"text-xs text-slate-500 uppercase font-bold tracking-widest\" data-kid=\"136\">Talleres Verificados</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"md:w-1/2 rounded-[40px] overflow-hidden shadow-2xl shadow-primary/20\" data-kid=\"137\">\n        <img src=\"https://images.unsplash.com/photo-1649769069590-268b0b994462?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTAwNDR8MHwxfHNlYXJjaHwxfHxwcm9mZXNzaW9uYWwlMjBtZWNoYW5pYyUyMGluJTIwdW5pZm9ybXxlbnwwfHx8fDE3ODI5NDE0NzB8MA&ixlib=rb-4.1.0&q=85\" alt=\"Professional Mechanic\" class=\"w-full h-full object-cover\" data-kid=\"138\">\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 px-6 border-t border-outline mt-20\" data-kid=\"139\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-12\" data-kid=\"140\">\n      <div class=\"col-span-2 md:col-span-1\" data-kid=\"141\">\n        <div class=\"flex items-center gap-2 mb-6\" data-kid=\"142\">\n          <div class=\"w-6 h-6 bg-mint rounded flex items-center justify-center\" data-kid=\"143\">\n            <i class=\"ti ti-car text-primary text-xs\" data-kid=\"144\"></i>\n          </div>\n          <span class=\"text-lg font-bold\" data-kid=\"145\">AutoDoc</span>\n        </div>\n        <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"146\">\n          Transformando la gestión automotriz a través de tecnología inteligente y transparencia garantizada.\n        </p>\n      </div>\n      <div data-kid=\"147\">\n        <h5 class=\"font-bold mb-6\" data-kid=\"148\">Para Dueños</h5>\n        <ul class=\"space-y-4 text-slate-500 text-sm\" data-kid=\"149\">\n          <li data-kid=\"150\"><a href=\"#\" class=\"hover:text-mint\" data-kid=\"151\">Mi Garaje</a></li>\n          <li data-kid=\"152\"><a href=\"#\" class=\"hover:text-mint\" data-kid=\"153\">Alertas SOAT</a></li>\n          <li data-kid=\"154\"><a href=\"#\" class=\"hover:text-mint\" data-kid=\"155\">Mantenimientos</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"156\">\n        <h5 class=\"font-bold mb-6\" data-kid=\"157\">Para Talleres</h5>\n        <ul class=\"space-y-4 text-slate-500 text-sm\" data-kid=\"158\">\n          <li data-kid=\"159\"><a href=\"#\" class=\"hover:text-mint\" data-kid=\"160\">Gestión Digital</a></li>\n          <li data-kid=\"161\"><a href=\"#\" class=\"hover:text-mint\" data-kid=\"162\">Reputación</a></li>\n          <li data-kid=\"163\"><a href=\"#\" class=\"hover:text-mint\" data-kid=\"164\">Evidence Upload</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"165\">\n        <h5 class=\"font-bold mb-6\" data-kid=\"166\">Social</h5>\n        <div class=\"flex gap-4\" data-kid=\"167\">\n          <a href=\"#\" class=\"w-10 h-10 rounded-full glass-header flex items-center justify-center hover:text-mint\" data-kid=\"168\">\n            <i class=\"ti ti-brand-instagram\" data-kid=\"169\"></i>\n          </a>\n          <a href=\"#\" class=\"w-10 h-10 rounded-full glass-header flex items-center justify-center hover:text-mint\" data-kid=\"170\">\n            <i class=\"ti ti-brand-linkedin\" data-kid=\"171\"></i>\n          </a>\n        </div>\n      </div>\n    </div>\n    <div class=\"max-w-7xl mx-auto mt-20 pt-8 border-t border-outline text-center text-slate-600 text-xs\" data-kid=\"172\">\n      © 2026 AutoDoc Technology. Hecho para conductores inteligentes.\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"173\"></script>\n<script data-kid=\"174\">\n  window.addEventListener('load', () => {\n    // Hero Entrance\n    const heroTl = gsap.timeline();\n    heroTl.from('.hero-text-area > *', {\n      y: 50,\n      autoAlpha: 0,\n      stagger: 0.1,\n      duration: 1,\n      ease: 'power4.out'\n    })\n    .from('.hero-mockup-1', { x: -50, autoAlpha: 0, rotate: -20, duration: 1 }, '-=0.5')\n    .from('.hero-mockup-2', { x: 50, autoAlpha: 0, rotate: 20, duration: 1 }, '-=0.8');\n\n    // Tab Switching Logic\n    const tabCards = document.querySelectorAll('.tab-card');\n    const contents = document.querySelectorAll('.feature-content');\n\n    tabCards.forEach(card => {\n      card.addEventListener('click', () => {\n        const targetId = card.getAttribute('data-target');\n        const targetContent = document.getElementById(targetId);\n\n        // Update Tab State\n        tabCards.forEach(c => c.classList.remove('active'));\n        card.classList.add('active');\n\n        // Transition Content\n        const activeContent = document.querySelector('.feature-content.active');\n        \n        const tl = gsap.timeline();\n        tl.to(activeContent, { \n          opacity: 0, \n          x: -20,\n          duration: 0.3, \n          onComplete: () => {\n            activeContent.classList.remove('active');\n            gsap.set(targetContent, { x: 20, opacity: 0 });\n            targetContent.classList.add('active');\n          }\n        })\n        .to(targetContent, { \n          opacity: 1, \n          x: 0,\n          duration: 0.4, \n          ease: 'power2.out' \n        });\n      });\n    });\n  });\n</script>",
