    "var_712ef23e890c": {
      "type": "variant",
      "label": "AutoDoc Vehicle Search — Hadrian Dark Mobile",
      "parentId": "var_3c284eae1a41",
      "themeId": null,
      "rect": {
        "x": 49610,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<link data-kid=\"1\" data-name=\"Google Fonts stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"app layout container\" style=\"padding-bottom:calc(104px + env(safe-area-inset-bottom));\">\n    <header class=\"sticky top-0 z-20 border-b border-[#334155] bg-[#0B1220]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"sticky header\">\n        <div class=\"flex min-h-[44px] items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"header contents container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"application logo and breadcrumb container\">\n                <div aria-label=\"AutoDoc\" class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#082F49] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1-1\" data-name=\"application logo box\">\n                    <span class=\"font-heading text-[17px] font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1-1-1\" data-name=\"application logo abbreviation\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"breadcrumb container\">\n                    <div class=\"flex items-center gap-2 text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"breadcrumb path\">\n                        <span data-kid=\"2-1-1-1-2-1-1\" data-name=\"breadcrumb segment 1\">\n                            Taller\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-chevron-right text-[13px] text-[#64748B]\" data-kid=\"2-1-1-1-2-1-2\" data-name=\"chevron separator icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"text-[#E2E8F0]\" data-kid=\"2-1-1-1-2-1-3\" data-name=\"breadcrumb segment 2\">\n                            Búsqueda\n                        </span>\n                    </div>\n                    <div class=\"mt-0.5 truncate font-heading text-[13px] font-bold text-white\" data-kid=\"2-1-1-1-2-2\" data-name=\"page title text\">\n                        Taller\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"page title dynamic highlight\">\n                            Rápido\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"user profile and notifications container\">\n                <button aria-label=\"Notificaciones\" class=\"relative flex size-11 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-1-2-1\" data-name=\"notification bell button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-2-1-2\" data-name=\"notification dot\">\n                    </span>\n                </button>\n                <div class=\"flex size-11 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-1-2-2\" data-name=\"user initials badge\">\n                    TR\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-2 flex items-center justify-between pl-[52px] text-[10px] text-[#64748B]\" data-kid=\"2-1-2\" data-name=\"date and time display\">\n            <span data-dynamic=\"true\" data-kid=\"2-1-2-1\" data-name=\"current date text\" data-reason=\"date text updated by script\">\n                Sábado, 15 ago 2026\n            </span>\n            <span class=\"font-semibold text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-1-2-2\" data-name=\"current time text\" data-reason=\"time text updated every minute by script\">\n                09:14 a. m.\n            </span>\n        </div>\n    </header>\n    <main class=\"px-4 pt-6\" data-kid=\"2-2\" data-name=\"main content area\">\n        <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-1\" data-name=\"page header section\">\n            <div class=\"min-w-0\" data-kid=\"2-2-1-1\" data-name=\"page title and description\">\n                <h1 class=\"font-heading text-[26px] font-extrabold leading-tight tracking-[-0.045em] text-white\" data-kid=\"2-2-1-1-1\" data-name=\"main heading\">\n                    Buscar vehículo\n                </h1>\n                <p class=\"mt-2 max-w-[280px] text-[13px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-1-2\" data-name=\"instructional text\">\n                    Encuentra el vehículo del cliente para abrir o consultar un servicio.\n                </p>\n            </div>\n            <button aria-label=\"Escanear QR\" class=\"flex size-11 shrink-0 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"2-2-1-2\" data-name=\"qr scan button\">\n                <i aria-hidden=\"true\" class=\"ti ti-qrcode text-[19px]\" data-kid=\"2-2-1-2-1\" data-name=\"qr code icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n        <button class=\"mt-2 flex min-h-11 items-center gap-2 text-left text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2\" data-name=\"mobile qr scan link\">\n            <i aria-hidden=\"true\" class=\"ti ti-qrcode text-[15px] text-[#38BDF8]\" data-kid=\"2-2-2-1\" data-name=\"mobile qr code icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            Escanear QR\n        </button>\n        <section aria-label=\"Búsqueda de vehículo\" class=\"mt-6 overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] px-4 py-4 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-3\" data-name=\"vehicle search section container\">\n            <label class=\"block\" data-kid=\"2-2-3-1\" data-name=\"search input container\">\n                <span class=\"mb-2 block text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-3-1-1\" data-name=\"search input label\">\n                    Buscar por placa, marca o cliente\n                </span>\n                <div class=\"flex h-12 items-center gap-3 border border-[#64748B] bg-[#0F172A] px-3 focus-within:border-[#38BDF8]\" data-kid=\"2-2-3-1-2\" data-name=\"search field wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-search shrink-0 text-[18px] text-[#38BDF8]\" data-kid=\"2-2-3-1-2-1\" data-name=\"search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <input aria-label=\"Buscar por placa, marca o cliente\" class=\"min-w-0 flex-1 bg-transparent text-[14px] text-[#F8FAFC] outline-hidden placeholder:text-[#64748B]\" data-kid=\"2-2-3-1-2-2\" data-name=\"vehicle search input field\" placeholder=\"Ej. P 482-916 o Juan Pérez\" value=\"P 482-916\"/>\n                </div>\n            </label>\n            <button class=\"mt-3 flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-4 text-[13px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-2-3-2\" data-name=\"search submit button\">\n                <i aria-hidden=\"true\" class=\"ti ti-search text-[16px]\" data-kid=\"2-2-3-2-1\" data-name=\"search icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Buscar\n            </button>\n            <div class=\"mt-3 space-y-2 text-[11px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-3-3\" data-name=\"search helper text area\">\n                <span class=\"flex items-start gap-2\" data-kid=\"2-2-3-3-1\" data-name=\"info icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-info-circle mt-0.5 shrink-0 text-[14px] text-[#818CF8]\" data-kid=\"2-2-3-3-1-1\" data-name=\"info icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-2-3-3-1-2\" data-name=\"info text\">\n                        Busca por placa completa para abrir el historial correcto.\n                    </span>\n                </span>\n                <span class=\"block font-semibold text-[#FBBF24]\" data-dynamic=\"true\" data-kid=\"2-2-3-3-2\" data-name=\"vehicle count status text\" data-reason=\"count updated by search results\">\n                    3 vehículos encontrados\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"results-heading\" class=\"mt-7\" data-kid=\"2-2-4\" data-name=\"search results section\">\n            <div class=\"mb-3\" data-kid=\"2-2-4-1\" data-name=\"results header area\">\n                <div class=\"flex items-end justify-between gap-3\" data-kid=\"2-2-4-1-1\" data-name=\"results header alignment container\">\n                    <div data-kid=\"2-2-4-1-1-1\" data-name=\"results heading group\">\n                        <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.02em] text-white\" data-kid=\"2-2-4-1-1-1-1\" data-name=\"results section title\" id=\"results-heading\">\n                            Resultados de búsqueda\n                        </h2>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-4-1-1-1-2\" data-name=\"results instructional text\">\n                            Selecciona un vehículo para revisar sus datos.\n                        </p>\n                    </div>\n                    <span class=\"shrink-0 text-right text-[10px] text-[#64748B]\" data-kid=\"2-2-4-1-1-2\" data-name=\"results sort indicator\">\n                        Coincidencia\n                        <br data-kid=\"2-2-4-1-1-2-1\" data-name=\"line break in indicator\"/>\n                        por placa\n                    </span>\n                </div>\n            </div>\n            <div class=\"overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-4-2\" data-name=\"results list container\">\n                <article class=\"border-b border-[#334155] border-l-2 border-l-[#38BDF8] bg-[#1E293B] px-3 py-4\" data-kid=\"2-2-4-2-1\" data-name=\"selected result card\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-2-1-1\" data-name=\"result top container\">\n                        <div data-kid=\"2-2-4-2-1-1-1\" data-name=\"vehicle details column\">\n                            <div class=\"text-[14px] font-semibold text-white\" data-kid=\"2-2-4-2-1-1-1-1\" data-name=\"vehicle model and year\">\n                                Toyota Corolla 2022\n                            </div>\n                            <div class=\"mt-1 text-[12px] tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-4-2-1-1-1-2\" data-name=\"vehicle identifier details\">\n                                P 482-916\n                                <span class=\"text-[#64748B]\" data-kid=\"2-2-4-2-1-1-1-2-1\" data-name=\"bullet separator\">\n                                    ·\n                                </span>\n                                48,260 km\n                            </div>\n                        </div>\n                        <span class=\"flex shrink-0 items-center gap-2 text-[11px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-4-2-1-1-2\" data-name=\"result status badge\">\n                            <span class=\"size-2 rounded-full bg-[#FBBF24]\" data-kid=\"2-2-4-2-1-1-2-1\" data-name=\"status color dot\">\n                            </span>\n                            Revisión pronta\n                        </span>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-3 border-t border-[#334155] pt-3 text-[11px]\" data-kid=\"2-2-4-2-1-2\" data-name=\"result footer grid\">\n                        <div data-kid=\"2-2-4-2-1-2-1\" data-name=\"client info block\">\n                            <span class=\"block uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-2-1-2-1-1\" data-name=\"label text\">\n                                Cliente\n                            </span>\n                            <span class=\"mt-1 block text-[#E2E8F0]\" data-kid=\"2-2-4-2-1-2-1-2\" data-name=\"client name\">\n                                Juan Pérez\n                            </span>\n                        </div>\n                        <div data-kid=\"2-2-4-2-1-2-2\" data-name=\"last service block\">\n                            <span class=\"block uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-2-1-2-2-1\" data-name=\"label text\">\n                                Último servicio\n         