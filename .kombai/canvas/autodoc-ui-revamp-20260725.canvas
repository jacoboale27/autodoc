    "var_c8161dba2a00": {
      "type": "variant",
      "label": "AutoDoc Admin Logs — Hadrian Light Mobile",
      "parentId": "var_46a4c32beba6",
      "themeId": null,
      "rect": {
        "x": 114535,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  .admin-logs-mobile-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .admin-logs-mobile-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"admin-logs-mobile-body min-h-screen overflow-x-hidden bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"admin dashboard mobile layout\" style=\"--surface:#F7F6F8;--surface-container:#EEEDF0;--surface-variant:#E2E8F0;--outline:#CBD5E1;--outline-strong:#94A3B8;--primary:#522C81;--secondary:#81E6D9;--on-primary:#FFFFFF;--text-primary:#0F172A;--text-secondary:#5B6B80;--success:#2F855A;--warning:#B45309;--error:#C2414B;--success-surface:#ECFDF5;--warning-surface:#FFFBEB;--error-surface:#FFF1F2;\">\n    <header class=\"sticky top-0 z-40 flex min-h-[68px] items-center justify-between gap-3 border-b border-[var(--outline)] bg-[var(--surface)]/95 px-4 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"compact admin logs header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"admin context group\">\n            <div aria-label=\"AutoDoc administración\" class=\"flex size-11 shrink-0 items-center justify-center rounded-[12px] bg-[var(--primary)] text-[17px] font-extrabold tracking-[-0.08em] text-[var(--on-primary)] shadow-[0_4px_10px_rgba(82,44,129,0.16)] admin-logs-mobile-heading\" data-kid=\"1-1-1-1\" data-name=\"admin brand mark\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"admin screen context\">\n                <p class=\"truncate text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--text-secondary)]\" data-kid=\"1-1-1-2-1\" data-name=\"administration label\">\n                    Administración\n                </p>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"1-1-1-2-2\" data-name=\"admin context sub-container\">\n                    <span class=\"truncate admin-logs-mobile-heading text-[15px] font-bold tracking-[-0.03em] text-[var(--text-primary)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"active screen title\">\n                        Registro de actividad\n                    </span>\n                    <span class=\"size-1.5 shrink-0 rounded-full bg-[var(--success)]\" data-kid=\"1-1-1-2-2-2\" data-name=\"admin online status\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-1-2\" data-name=\"admin logs header actions\">\n            <button aria-label=\"Exportar CSV\" class=\"flex size-11 items-center justify-center rounded-full border border-[var(--outline)] bg-[var(--surface-container)] text-[var(--primary)] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-2-1\" data-name=\"export CSV icon action\">\n                <i class=\"ti ti-download text-[18px]\" data-kid=\"1-1-2-1-1\" data-name=\"download icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-haspopup=\"dialog\" aria-label=\"Filtros\" class=\"flex size-11 items-center justify-center rounded-full bg-[var(--primary)] text-[var(--on-primary)] shadow-[0_4px_10px_rgba(82,44,129,0.18)]\" data-kid=\"1-1-2-2\" data-name=\"open filter bottom sheet action\">\n                <i class=\"ti ti-adjustments-horizontal text-[18px]\" data-kid=\"1-1-2-2-1\" data-name=\"filter adjustments icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[480px] px-4 pb-[calc(112px+env(safe-area-inset-bottom))] pt-6\" data-kid=\"1-2\" data-name=\"admin logs mobile content\">\n        <div class=\"mb-5\" data-kid=\"1-2-1\" data-name=\"logs page heading\">\n            <div class=\"mb-3 flex items-center gap-2 text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-1-1\" data-name=\"logs breadcrumb\">\n                <span data-kid=\"1-2-1-1-1\" data-name=\"admin breadcrumb link\">\n                    Admin\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px] text-[var(--outline-strong)]\" data-kid=\"1-2-1-1-2\" data-name=\"chevron right icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-semibold text-[var(--text-primary)]\" data-kid=\"1-2-1-1-3\" data-name=\"logs page breadcrumb text\">\n                    Logs\n                </span>\n            </div>\n            <h1 class=\"admin-logs-mobile-heading text-[27px] font-extrabold leading-tight tracking-[-0.045em] text-[var(--text-primary)]\" data-kid=\"1-2-1-2\" data-name=\"logs main headline\">\n                Registro de actividad\n            </h1>\n            <p class=\"mt-2 max-w-[320px] text-[14px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-2-1-3\" data-name=\"logs page description text\">\n                Consulta las acciones administrativas recientes y su contexto operativo.\n            </p>\n        </div>\n        <div class=\"mb-4 flex items-center justify-between gap-3 border-y border-[var(--outline)] py-3\" data-kid=\"1-2-2\" data-name=\"logs list toolbar\">\n            <div class=\"min-w-0\" data-kid=\"1-2-2-1\" data-name=\"logs list summary container\">\n                <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[var(--primary)]\" data-kid=\"1-2-2-1-1\" data-name=\"recent activity label\">\n                    Actividad reciente\n                </p>\n                <p class=\"mt-1 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-2-2-1-2\" data-name=\"date order instruction text\">\n                    Eventos ordenados por fecha\n                </p>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-2-2\" data-name=\"logs action container\">\n                <span class=\"rounded-full border border-[var(--outline)] bg-[var(--surface-container)] px-3 py-2 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-2-2-2-1\" data-name=\"record count\">\n                    4 registros\n                </span>\n                <button aria-label=\"Actualizar registros\" class=\"flex size-11 items-center justify-center rounded-full border border-[var(--outline)] bg-[var(--surface-container)] text-[var(--primary)]\" data-kid=\"1-2-2-2-2\" data-name=\"refresh logs action\">\n                    <i class=\"ti ti-refresh text-[17px]\" data-kid=\"1-2-2-2-2-1\" data-name=\"refresh icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <button aria-haspopup=\"dialog\" class=\"mb-5 flex min-h-[48px] w-full items-center justify-between rounded-[14px] border border-[var(--outline)] bg-[var(--surface-container)] px-4 text-left shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-3\" data-name=\"filter bottom sheet trigger\">\n            <span class=\"flex items-center gap-3\" data-kid=\"1-2-3-1\" data-name=\"filter trigger content\">\n                <span class=\"flex size-8 items-center justify-center rounded-full bg-[#F0EAF7] text-[var(--primary)]\" data-kid=\"1-2-3-1-1\" data-name=\"filter icon wrapper\">\n                    <i class=\"ti ti-filter text-[16px]\" data-kid=\"1-2-3-1-1-1\" data-name=\"filter icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </spa