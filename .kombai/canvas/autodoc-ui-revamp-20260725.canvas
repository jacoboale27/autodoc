\"2-1-3-2-3-1-3-2-1\" data-name=\"vehicle data item\">\n                                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-3-2-1-1\" data-name=\"data label\">\n                                        Modelo\n                                    </p>\n                                    <p class=\"mt-1 text-[14px] font-semibold\" data-kid=\"2-1-3-2-3-1-3-2-1-2\" data-name=\"data value\">\n                                        Toyota Corolla 2022\n                                    </p>\n                                </div>\n                                <div data-kid=\"2-1-3-2-3-1-3-2-2\" data-name=\"vehicle data item\">\n                                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-3-2-2-1\" data-name=\"data label\">\n                                        Placa\n                                    </p>\n                                    <p class=\"mt-1 text-[14px] font-semibold tracking-[0.12em]\" data-kid=\"2-1-3-2-3-1-3-2-2-2\" data-name=\"data value\">\n                                        P 482-916\n                                    </p>\n                                </div>\n                                <div data-kid=\"2-1-3-2-3-1-3-2-3\" data-name=\"vehicle data item\">\n                                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-3-2-3-1\" data-name=\"data label\">\n                                        Kilometraje\n                                    </p>\n                                    <p class=\"mt-1 text-[14px] font-semibold tabular-nums\" data-kid=\"2-1-3-2-3-1-3-2-3-2\" data-name=\"data value\">\n                                        48,260 km\n                                    </p>\n                                </div>\n                            </div>\n                        </section>\n                    </div>\n                    <aside class=\"border-t-2 border-[#CBD5E1] pt-4\" data-kid=\"2-1-3-2-3-2\" data-name=\"reservation timeline column\">\n                        <h2 class=\"font-heading text-[17px] font-bold\" data-kid=\"2-1-3-2-3-2-2\" data-name=\"section header\">\n                            Estado de la reserva\n                        </h2>\n                        <div class=\"mt-5\" data-kid=\"2-1-3-2-3-2-1\" data-name=\"reservation timeline\">\n                            <div class=\"relative flex gap-3 pb-7\" data-kid=\"2-1-3-2-3-2-1-1\" data-name=\"timeline step\">\n                                <div class=\"relative flex w-5 justify-center\" data-kid=\"2-1-3-2-3-2-1-1-1\" data-name=\"timeline icon container\">\n                                    <span class=\"z-10 grid size-5 place-items-center rounded-full bg-[#10B981] text-[11px] text-white\" data-kid=\"2-1-3-2-3-2-1-1-1-1\" data-name=\"check icon\">\n                                        <i class=\"ti ti-check\" data-kid=\"2-1-3-2-3-2-1-1-1-1-1\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                    </span>\n                                    <span class=\"absolute top-5 h-full w-px bg-[#CBD5E1]\" data-kid=\"2-1-3-2-3-2-1-1-1-2\" data-name=\"timeline track\">\n                                    </span>\n                                </div>\n                                <div data-kid=\"2-1-3-2-3-2-1-1-2\" data-name=\"timeline content\">\n                                    <p class=\"text-[13px] font-semibold\" data-kid=\"2-1-3-2-3-2-1-1-2-1\" data-name=\"step title\">\n                                        Solicitud enviada\n                                    </p>\n                                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-1-2-2\" data-name=\"step timestamp\">\n                                        Hoy, 08:40 · Cita solicitada al taller.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"relative flex gap-3 pb-7\" data-kid=\"2-1-3-2-3-2-1-2\" data-name=\"timeline step\">\n                                <div class=\"relative flex w-5 justify-center\" data-kid=\"2-1-3-2-3-2-1-2-1\" data-name=\"timeline icon container\">\n                                    <span class=\"z-10 grid size-5 place-items-center rounded-full bg-[#10B981] text-[11px] text-white\" data-kid=\"2-1-3-2-3-2-1-2-1-1\" data-name=\"check icon\">\n                                        <i class=\"ti ti-check\" data-kid=\"2-1-3-2-3-2-1-2-1-1-1\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                    </span>\n                                    <span class=\"absolute top-5 h-full w-px bg-[#CBD5E1]\" data-kid=\"2-1-3-2-3-2-1-2-1-2\" data-name=\"timeline track\">\n                                    </span>\n                                </div>\n                                <div data-kid=\"2-1-3-2-3-2-1-2-2\" data-name=\"timeline content\">\n                                    <p class=\"text-[13px] font-semibold\" data-kid=\"2-1-3-2-3-2-1-2-2-1\" data-name=\"step title\">\n                                        Cotización recibida\n                                    </p>\n                                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-2-2-2\" data-name=\"step timestamp\">\n                                        Hoy, 09:36 · El taller envió el valor del servicio.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-3\" data-kid=\"2-1-3-2-3-2-1-3\" data-name=\"timeline step\">\n                                <div class=\"flex w-5 justify-center\" data-kid=\"2-1-3-2-3-2-1-3-1\" data-name=\"timeline icon container\">\n                                    <span class=\"grid size-5 place-items-center rounded-full border-2 border-[#F59E0B] bg-[#FFFBEB] text-[11px] text-[#B45309]\" data-kid=\"2-1-3-2-3-2-1-3-1-1\" data-name=\"clock icon\">\n                                        <i class=\"ti ti-clock\" data-kid=\"2-1-3-2-3-2-1-3-1-1-1\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                    </span>\n                                </div>\n                                <div data-kid=\"2-1-3-2-3-2-1-3-2\" data-name=\"timeline content\">\n                                    <p class=\"text-[13px] font-semibold text-[#B45309]\" data-kid=\"2-1-3-2-3-2-1-3-2-1\" data-name=\"step title\">\n                                        Pendiente de confirmación\n                                    </p>\n                                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-3-2-2\" data-name=\"step timestamp\">\n                                        Tu respuesta es necesaria para reservar el espacio.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mt-7 border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-3-2-3-2-4\" data-name=\"timeline disclaimer container\">\n                            <p class=\"text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-1-3-2-3-2-4-1\" data-name=\"disclaimer text\">\n                                Al confirmar, el taller recibirá la autorización para preparar tu vehículo.\n                            </p>\n                        </div>\n                    </aside>\n                </div>\n                <div class=\"mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-[#CBD5E1] pt-5\" data-kid=\"2-1-3-2-4\" data-name=\"reservation actions\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-4-1\" data-name=\"action buttons\">\n                        <button class=\"inline-flex min-h-[48px] items-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#45256D] px-5 py-3 text-[13px] font-bold text-white shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.97]\" data-kid=\"2-1-3-2-4-1-1\" data-name=\"confirm reservation button\">\n                            <i class=\"ti ti-check\" data-kid=\"2-1-3-2-4-1-1-1\" data-name=\"check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Confirmar reserva\n                        </button>\n                        <button class=\"inline-flex min-h-[48px] items-center gap-2 rounded-full border border-[#E85D5D] px-5 py-3 text-[13px] font-bold text-[#B91C1C] transition duration-150 ease-out hover:bg-[#FEF2F2] hover:scale-[1.02] active:scale-[0.97]\" data-kid=\"2-1-3-2-4-1-2\" data-name=\"reject reservation button\">\n                            <i class=\"ti ti-x\" data-kid=\"2-1-3-2-4-1-2-1\" data-name=\"x icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Rechazar\n                        </button>\n                    </div>\n                    <button class=\"inline-flex min-h-12 items-center gap-2 px-4 py-3 text-[13px] font-bold text-[#1E88E5] hover:bg-[#E8F2FD]\" data-kid=\"2-1-3-2-4-2\" data-name=\"open chat button\">\n                        <i class=\"ti ti-message-circle\" data-kid=\"2-1-3-2-4-2-1\" data-name=\"message icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Abrir conversación\n                    </button>\n                </div>\n                <p class=\"mt-6 pb-2 text-[11px] text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-5\" data-name=\"footer sync text\" data-reason=\"text updated to reflect sync status by script\">\n                    AutoDoc · Reserva de servicio · Datos sincronizados hace 8 min\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
