    "var_5640eab77b38": {
      "type": "variant",
      "label": "AutoDoc Task Complete — Hadrian Light",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 64925,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"task complete page\">\n    <div class=\"grid min-h-screen lg:grid-cols-[340px_minmax(0,1fr)]\" data-kid=\"2-1\" data-name=\"confirmation layout\">\n        <aside class=\"relative flex min-h-[260px] flex-col justify-between overflow-hidden bg-[#0F172A] px-8 py-8 text-white lg:min-h-screen\" data-kid=\"2-1-1\" data-name=\"technical side panel\">\n            <div class=\"absolute inset-0 opacity-60 [background-image:linear-gradient(rgba(148,163,184,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.08)_1px,transparent_1px)] [background-size:32px_32px]\" data-kid=\"2-1-1-1\" data-name=\"technical grid background\">\n            </div>\n            <div class=\"relative\" data-kid=\"2-1-1-2\" data-name=\"brand block\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-1-2-1\" data-name=\"brand lockup\">\n                    <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-2-1-1\" data-name=\"brand mark\">\n                        AD\n                    </div>\n                    <div data-kid=\"2-1-1-2-1-2\" data-name=\"brand name container\">\n                        <div class=\"font-heading text-[18px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-1-2-1-2-1\" data-name=\"brand name text\">\n                            AutoDoc\n                        </div>\n                        <div class=\"mt-0.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-[#94A3B8]\" data-kid=\"2-1-1-2-1-2-2\" data-name=\"brand subtitle text\">\n                            Vehicle log\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"relative my-10 flex flex-1 items-center\" data-kid=\"2-1-1-3\" data-name=\"technical vehicle illustration\">\n                <div class=\"w-full\" data-kid=\"2-1-1-3-1\" data-name=\"technical illustration content\">\n                    <div class=\"mb-7 flex items-center gap-3 text-[#94A3B8]\" data-kid=\"2-1-1-3-1-1\" data-name=\"completion reference label\">\n                        <span class=\"h-px w-10 bg-[#1E88E5]\" data-kid=\"2-1-1-3-1-1-1\" data-name=\"label horizontal rule\">\n                        </span>\n                        <span class=\"text-[10px] font-bold uppercase tracking-[0.2em]\" data-kid=\"2-1-1-3-1-1-2\" data-name=\"reference text\">\n                            Maintenance record / 042\n                        </span>\n                    </div>\n                    <div class=\"relative flex h-[190px] items-center justify-center border-y border-[#334155]\" data-kid=\"2-1-1-3-1-2\" data-name=\"vehicle technical frame\">\n                        <div class=\"absolute left-0 top-4 text-[10px] font-semibold tabular-nums text-[#64748B]\" data-kid=\"2-1-1-3-1-2-1\" data-name=\"mileage label\">\n                            48,260 KM\n                        </div>\n                        <div class=\"absolute bottom-4 right-0 text-[10px] font-semibold tabular-nums text-[#64748B]\" data-kid=\"2-1-1-3-1-2-2\" data-name=\"date label\">\n                            12 JUN 2026\n                        </div>\n                        <div class=\"absolute left-1/2 top-1/2 h-px w-[210px] -translate-x-1/2 bg-[#1E88E5]/50\" data-kid=\"2-1-1-3-1-2-3\" data-name=\"frame horizontal rule\">\n                        </div>\n                        <div class=\"absolute left-1/2 top-1/2 h-[108px] w-[108px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#1E88E5]/40\" data-kid=\"2-1-1-3-1-2-4\" data-name=\"outer circular outline\">\n                        </div>\n                        <div class=\"absolute left-1/2 top-1/2 h-[72px] w-[72px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#10B981]/60\" data-kid=\"2-1-1-3-1-2-5\" data-name=\"inner circular accent\">\n                        </div>\n                        <i aria-hidden=\"true\" class=\"ti ti-steering-wheel relative text-[54px] text-[#E2E8F0]\" data-kid=\"2-1-1-3-1-2-6\" data-name=\"steering wheel icon\" style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"mt-7 grid grid-cols-2 gap-5\" data-kid=\"2-1-1-3-1-3\" data-name=\"technical metadata\">\n                        <div class=\"border-l-2 border-[#10B981] pl-3\" data-kid=\"2-1-1-3-1-3-1\" data-name=\"registration status block\">\n                            <div class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-1-3-1-3-1-1\" data-name=\"registration status label\">\n                                Registro\n                            </div>\n                            <div class=\"mt-1 text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-1-3-1-3-1-2\" data-name=\"registration status value\">\n                                Sincronizado\n                            </div>\n                        </div>\n                        <div class=\"border-l-2 border-[#1E88E5] pl-3\" data-kid=\"2-1-1-3-1-3-2\" data-name=\"next service block\">\n                            <div class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-1-3-1-3-2-1\" data-name=\"next service label\">\n                                Próximo\n                            </div>\n                            <div class=\"mt-1 text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-1-3-1-3-2-2\" data-name=\"next service value\">\n                                10,000 km\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"relative flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-1-4\" data-name=\"technical footer\">\n                <span data-kid=\"2-1-1-4-1\" data-name=\"copyright notice\">\n                    AutoDoc · 2026\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"2-1-1-4-2\" data-name=\"connection status indicator\">\n                    <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-1-1-4-2-1\" data-name=\"status dot\">\n                    </span>\n                    Registro seguro\n                </span>\n            </div>\n        </aside>\n        <main class=\"flex min-h-screen items-center justify-center px-6 py-12 lg:px-16\" data-kid=\"2-1-2\" data-name=\"confirmation content area\">\n            <section aria-labelledby=\"complete-heading\" class=\"w-full max-w-[660px]\" data-kid=\"2-1-2-1\" data-name=\"completion confirmation section\">\n                <div class=\"mb-10 flex items-center justify-between text-[12px] text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"confirmation breadcrumb\">\n                    <span data-kid=\"2-1-2-1-1-1\" data-name=\"breadcrumb path\">\n                        Propietario / Servicio\n                    </span>\n                    <span class=\"font-semibold tabular-nums text-[#94A3B8]\" data-kid=\"2-1-2-1-1-2\" data-name=\"breadcrumb registration ID\">\n                        Registro 042\n                    </span>\n                </div>\n                <div class=\"rounded-[16px] border border-[#CBD5E1] bg-white py-10 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-1-2-1-2\" data-name=\"success header card\">\n                    <div class=\"flex items-start gap-5\" data-kid=\"2-1-2-1-2-1\" data-name=\"success icon and heading\">\n                        <div aria-label=\"Tarea completada correctamente\" class=\"grid size-16 shrink-0 place-items-center rounded-full border-2 border-[#10B981] bg-[#ECFDF5] text-[#10B981]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"accessible success icon\" role=\"img\">\n                            <i aria-hidden=\"true\" class=\"ti ti-check text-[32px]\" data-kid=\"2-1-2-1-2-1-1-1\" data-name=\"checkmark icon\" style=\"width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <div data-kid=\"2-1-2-1-2-1-2\" data-name=\"success message text group\">\n                            <p class=\"mb-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[#10B981]\" data-kid=\"2-1-2-1-2-1-2-1\" data-name=\"success category label\">\n                                Registro confirmado\n                            </p>\n                            <h1 class=\"font-heading text-[36px] font-extrabold tracking-[-0.05em] text-[#0F172A]\" data-kid=\"2-1-2-1-2-1-2-2\" data-name=\"success headline\" id=\"complete-heading\">\n                                Tarea completada\n                            </h1>\n                            <p class=\"mt-3 max-w-[470px] text-[16px] leading-7 text-[#475569]\" data-kid=\"2-1-2-1-2-1-2-3\" data-name=\"success description text\">\n                                El mantenimiento de tu vehículo quedó registrado.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"grid gap-8 border-b border-[#CBD5E1] py-8 md:grid-cols-[minmax(0,1fr)_190px]\" data-kid=\"2-1-2-1-3\" data-name=\"service completion details\">\n                    <div data-kid=\"2-1-2-1-3-1\" data-name=\"service summary\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-2-1-3-1-2\" data-name=\"service label\">\n                            Servicio registrado\n                        </p>\n                        <h2 class=\"mt-3 font-heading text-[21px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-1-2-1-3-1-3\" data-name=\"vehicle model title\">\n                            Toyota Corolla 2022\n                        </h2>\n                        <p class=\"mt-1 text-[14px] text-[#475569]\" data-kid=\"2-1-2-1-3-1-4\" data-name=\"service description\">\n                            Cambio de aceite\n                        </p>\n                        <div class=\"mt-6 flex flex-wrap gap-x-6 gap-y-3 text-[13px]\" data-kid=\"2-1-2-1-3-1-1\" data-name=\"service metadata row\">\n                            <span class=\"flex items-center gap-2 text-[#334155]\" data-kid=\"2-1-2-1-3-1-1-1\" data-name=\"mileage metadata group\">\n                                <i aria-hidden=\"true\" class=\"ti ti-steering-wheel text-[16px] text-[#1E88E5]\" data-kid=\"2-1-2-1-3-1-1-1-1\" data-name=\"steering wheel icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                <strong class=\"tabular-nums font-semibold\" data-kid=\"2-1-2-1-3-1-1-1-2\" data-name=\"mileage value\">\n                                    48,260 km\n                                </strong>\n                            </span>\n                            <span class=\"flex items-center gap-2 text-[#334155]\" data-kid=\"2-1-2-1-3-1-1-2\" data-name=\"date metadata group\">\n                                <i aria-hidden=\"true\" class=\"ti ti-calendar-event text-[16px] text-[#1E88E5]\" data-kid=\"2-1-2-1-3-1-1-2-1\" data-name=\"calendar icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                <strong class=\"font-semibold\" data-kid=\"2-1-2-1-3-1-1-2-2\" data-name=\"date value\">\n                                    12 jun 2026\n                                </strong>\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"border-l border-[#E2E8F0] pl-6\" data-kid=\"2-1-2-1-3-2\" data-name=\"next reminder block\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-2-1-3-2-1\" data-name=\"next reminder label\">\n                            Siguiente recordatorio\n                        </p>\n                        <p class=\"mt-3 font-heading text-[22px] font-bold tabular-nums tracking-[-0.03em] text-[#1E88E5]\" data-kid=\"2-1-2-1-3-2-2\" data-name=\"next reminder value\">\n                            10,000 km\n                        </p>\n                        <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-1-2-1-3-2-3\" data-name=\"reminder note\">\n                            Revisión recomendada\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-3 border-b border-[#CBD5E1] py-5 text-[13px] text-[#334155]\" data-kid=\"2-1-2-1-4\" data-name=\"sync confirmation message\">\n                    <i aria-hidden=\"true\" class=\"ti ti-cloud-check text-[18px] text-[#10B981]\" data-kid=\"2-1-2-1-4-1\" data-name=\"cloud check icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-2-1-4-2\" data-name=\"sync status text\">\n                        Tus datos se sincronizaron con tu garaje\n                    </span>\n                </div>\n                <div class=\"mt-8 flex flex-col gap-3 sm:flex-row sm:items-center\" data-kid=\"2-1-2-1-5\" data-name=\"completion actions\">\n                    <button class=\"inline-flex min-h-[48px] flex-1 items-center justify-center gap-2 bg-[#1E88E5] px-5 py-3 text-[13px] font-bold text-white hover:bg-[#176FBB]\" data-kid=\"2-1-2-1-5-1\" data-name=\"return dashboard button\">\n                        Volver al dashboard\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"2-1-2-1-5-1-1\" data-name=\"arrow icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button class=\"inline-flex min-h-[48px] flex-1 items-center justify-center gap-2 border border-[#94A3B8] bg-white px-5 py-3 text-[13px] font-bold text-[#1E3A5F] hover:border-[#1E88E5] hover:text-[#1E88E5]\" data-kid=\"2-1-2-1-5-2\" data-name=\"view history button\">\n                        Ver historial\n                        <i aria-hidden=\"true\" class=\"ti ti-history text-[16px]\" data-kid=\"2-1-2-1-5-2-1\" data-name=\"history icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <p class=\"mt-8 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-2-1-6\" data-name=\"confirmation footer\">\n                    Puedes consultar este registro y tus próximos recordatorios desde el historial de tu vehículo.\n                </p>\n            </section>\n        </main>\n    </div>\n</div>\n",
