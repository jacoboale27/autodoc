      "themeId": null,
      "rect": {
        "x": 29205,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    [data-name=\"notifications button\"], [data-name=\"toggle dark mode button\"] { min-width:44px; min-height:44px; border-radius:999px; border:1px solid #CBD5E1; background:#EEEDF0; color:#64748B; box-shadow:0 2px 4px rgba(15,23,42,.05); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"notifications button\"]:hover, [data-name=\"toggle dark mode button\"]:hover { background:#F7F6F8; color:#522C81; box-shadow:0 6px 14px rgba(15,23,42,.1); }\n  [data-name=\"notifications button\"]:active, [data-name=\"toggle dark mode button\"]:active { transform:scale(.97); }\n  [data-name=\"stacked editorial profile header\"], [data-name=\"stacked preference rows\"] { overflow:hidden; border:1px solid rgba(203,213,225,.4); border-radius:16px; background:#EEEDF0; box-shadow:0 2px 4px rgba(15,23,42,.05); }\n  [data-name=\"change photo button\"], [data-name=\"language selector button\"], [data-name=\"appearance selector button\"] { min-height:48px; border-radius:999px; border:1px solid #CBD5E1; background:#EEEDF0; color:#522C81; box-shadow:0 2px 4px rgba(15,23,42,.05); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"change photo button\"]:hover, [data-name=\"language selector button\"]:hover, [data-name=\"appearance selector button\"]:hover { background:#F7F6F8; box-shadow:0 6px 14px rgba(15,23,42,.1); }\n  [data-name=\"change photo button\"]:active, [data-name=\"language selector button\"]:active, [data-name=\"appearance selector button\"]:active { transform:scale(.97); }\n  [data-name=\"selected role card\"] { border-radius:16px; box-shadow:0 2px 4px rgba(15,23,42,.05); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"selected role card\"]:hover { transform:scale(1.01); box-shadow:0 6px 14px rgba(15,23,42,.1); }\n  [data-name=\"selected role card\"]:active { transform:scale(.99); }\n  [data-name=\"cancel button\"] { min-height:48px; border-radius:999px; border:1px solid #CBD5E1; background:#EEEDF0; color:#334155; box-shadow:0 2px 4px rgba(15,23,42,.05); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"cancel button\"]:hover { background:#F7F6F8; box-shadow:0 6px 14px rgba(15,23,42,.1); }\n  [data-name=\"cancel button\"]:active { transform:scale(.97); }\n  [data-name=\"save changes button\"] { min-height:48px; border-radius:999px; background:linear-gradient(135deg,#522C81,#45236F); color:#FFFFFF; box-shadow:0 2px 4px rgba(15,23,42,.05); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"save changes button\"]:hover { transform:scale(1.02); box-shadow:0 6px 14px rgba(15,23,42,.1); }\n  [data-name=\"save changes button\"]:active { transform:scale(.97); }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile profile page root\" style=\"padding-bottom:calc(102px + env(safe-area-inset-bottom))\">\n    <header class=\"sticky top-0 z-20 border-b border-[#CBD5E1] bg-white/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile profile top bar\">\n        <div class=\"flex min-h-11 items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"mobile header row\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"mobile brand and context\">\n                <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[16px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"mobile page title container\">\n                    <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-1-2-1\" data-name=\"mobile role label\">\n                        Propietario\n                    </p>\n                    <p class=\"truncate font-heading text-[15px] font-bold tracking-[-0.02em] text-[#0F172A]\" data-kid=\"2-1-1-1-2-2\" data-name=\"mobile current page\">\n                        Mi perfil\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"mobile header actions\">\n                <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"notifications button\" type=\"button\">\n                    <i class=\"ti ti-bell\" data-kid=\"2-1-1-2-1-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-[10px] top-[9px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-1-2-1-2\" data-name=\"notification status dot\">\n                    </span>\n                </button>\n                <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-1-2-2\" data-name=\"toggle dark mode button\" type=\"button\">\n                    <i class=\"ti ti-moon\" data-kid=\"2-1-1-2-2-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-2 flex items-center justify-between text-[11px]\" data-kid=\"2-1-2\" data-name=\"mobile breadcrumb and date row\">\n            <div class=\"flex items-center gap-2 text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"profile breadcrumb\">\n                <span data-kid=\"2-1-2-1-1\" data-name=\"breadcrumb role segment\">\n                    Propietario\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-2-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-3\" data-name=\"breadcrumb page segment\">\n                    Mi perfil\n                </span>\n            </div>\n            <span class=\"shrink-0 text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-2-2\" data-name=\"current date text\" data-reason=\"text set by client-side date injection\">\n                Sábado, 15 ago 2026\n            </span>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[960px] px-4 pt-6\" data-kid=\"2-2\" data-name=\"mobile profile content\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"mobile profile page heading\">\n            <h1 class=\"font-heading text-[28px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-1\" data-name=\"page heading\">\n                Mi perfil\n            </h1>\n            <p class=\"mt-2 text-[14px] text-[#475569]\" data-kid=\"2-2-1-2\" data-name=\"page description\">\n                Mantén tus datos y preferencias al día.\n            </p>\n            <p class=\"mt-2 text-[11px] font-semibold text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-1-3\" data-name=\"last updated timestamp\" data-reason=\"text set by client-side time injection\">\n                Última actualización: hoy\n            </p>\n        </div>\n        <section class=\"border-y border-[#CBD5E1] bg-white px-4 py-5\" data-kid=\"2-2-2\" data-name=\"stacked editorial profile header\">\n            <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"2-2-2-1\" data-name=\"profile identity row\">\n                <div class=\"grid size-[68px] shrink-0 place-items-center rounded-full border-4 border-[#E8F2FD] bg-[#DBEAFE] font-heading text-[21px] font-extrabold text-[#1E88E5]\" data-kid=\"2-2-2-1-1\" data-name=\"profile avatar initials\">\n                    JP\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-2-2-1-2\" data-name=\"profile identity details\">\n                    <h2 class=\"truncate font-heading text-[19px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-2-2-1-2-1\" data-name=\"profile name\">\n                        Juan Pérez\n                    </h2>\n                    <p class=\"mt-1 text-[13px] text-[#64748B]\" data-kid=\"2-2-2-1-2-2\" data-name=\"account type label\">\n                        Cuenta personal\n                    </p>\n                    <div class=\"mt-2 flex items-center gap-2 text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-2-2-1-2-3\" data-name=\"completion status row\">\n                        <i class=\"ti ti-circle-check-filled\" data-kid=\"2-2-2-1-2-3-1\" data-name=\"circle check icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Perfil completo 80%\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-5\" data-kid=\"2-2-2-2\" data-name=\"profile completion and photo controls\">\n                <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-2-2-3\" data-name=\"completion progress header\">\n                    <span class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-2-2-3-1\" data-name=\"completion label\">\n                        Completitud\n                    </span>\n                    <span class=\"text-[12px] font-bold text-[#10B981]\" data-kid=\"2-2-2-2-3-2\" data-name=\"completion percentage text\">\n                        80%\n                    </span>\n                </div>\n                <div class=\"mt-2 h-2 w-full overflow-hidden rounded-full bg-[#E2E8F0]\" data-kid=\"2-2-2-2-1\" data-name=\"completion progress bar\">\n                    <div class=\"h-full w-4/5 rounded-full bg-[#10B981]\" data-kid=\"2-2-2-2-1-1\" data-name=\"completion progress bar fill\">\n                    </div>\n                </div>\n                <button class=\"mt-3 inline-flex min-h-11 w-full items-center justify-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-2-2-2\" data-name=\"change photo button\" type=\"button\">\n                    <i class=\"ti ti-camera-plus text-[16px]\" data-kid=\"2-2-2-2-2-1\" data-name=\"camera plus icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Cambiar foto\n                </button>\n            </div>\n        </section>\n        <form class=\"mt-7\" data-kid=\"2-2-3\" data-name=\"mobile profile form\">\n            <section class=\"border-t border-[#CBD5E1] pt-5\" data-kid=\"2-2-3-1\" data-name=\"personal data section\">\n                <div class=\"mb-4 flex items-start justify-between gap-3\" data-kid=\"2-2-3-1-1\" data-name=\"personal data section header\">\n                    <div data-kid=\"2-2-3-1-1-4\">\n                        <h2 class=\"font-heading text-[17px] font-bold text-[#0F172A]\" data-kid=\"2-2-3-1-1-1\" data-name=\"section title\">\n                            Datos personales\n                        </h2>\n                        <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-1-1-2\" data-name=\"section description\">\n                            Información básica para tu cuenta.\n                        </p>\n                    </div>\n                    <span class=\"shrink-0 pt-1 text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-2-3-1-1-3\" data-name=\"verification status badge\">\n                        <i class=\"ti ti-check\" data-kid=\"2-2-3-1-1-3-1\" data-name=\"check icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Verificado\n                    </span>\n                </div>\n                <div class=\"space-y-4\" data-kid=\"2-2-3-1-2\" data-name=\"stacked personal fields\">\n                    <label class=\"block\" data-kid=\"2-2-3-1-2-1\" data-name=\"full name input field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#334155]\" data-kid=\"2-2-3-1-2-1-2\" data-name=\"field label\">\n                            Nombre completo\n                        </span>\n                        <div class=\"flex min-h-12 items-center gap-3 border border-[#CBD5E1] bg-white px-3\" data-kid=\"2-2-3-1-2-1-1\" data-name=\"full name input container\">\n                            <i class=\"ti ti-user text-[17px] text-[#64748B]\" data-kid=\"2-2-3-1-2-1-1-1\" data-name=\"user icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span class=\"min-w-0 flex-1 truncate text-[14px] font-medium text-[#0F172A]\" data-kid=\"2-2-3-1-2-1-1-3\" data-name=\"full name text\">\n                                Juan Pérez\n                            </span>\n                            <i class=\"ti ti-circle-check-filled shrink-0 text-[16px] text-[#10B981]\" data-kid=\"2-2-3-1-2-1-1-2\" data-name=\"verified name icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <span class=\"mt-1.5 block text-[11px] font-medium text-[#10B981]\" data-kid=\"2-2-3-1-2-1-4\" data-name=\"field validation message\">\n                            Formato válido\n                        </span>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-2-3-1-2-2\" data-name=\"email input field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#334155]\" data-kid=\"2-2-3-1-2-2-2\" data-name=\"field label\">\n                            Correo electrónico\n                        </span>\n                        <div class=\"flex min-h-12 items-center gap-3 border border-[#CBD5E1] bg-[#F8FAFC] px-3\" data-kid=\"2-2-3-1-2-2-1\" data-name=\"email input container\">\n                            <i class=\"ti ti-mail text-[17px] text-[#64748B]\" data-kid=\"2-2-3-1-2-2-1-1\" data-name=\"mail icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span class=\"min-w-0 flex-1 truncate text-[14px] font-medium text-[#0F172A]\" data-kid=\"2-2-3-1-2-2-1-3\" data-name=\"email text\">\n                                juan.perez@email.com\n                            </span>\n                            <i class=\"ti ti-lock-check shrink-0 text-[16px] text-[#10B981]\" data-kid=\"2-2-3-1-2-2-1-2\" data-name=\"lock check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <span class=\"mt-1.5 block text-[11px] font-medium text-[#64748B]\" data-kid=\"2-2-3-1-2-2-4\" data-name=\"field info message\">\n                            Correo verificado\n                        </span>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-2-3-1-2-3\" data-name=\"phone input field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#334155]\" data-kid=\"2-2-3-1-2-3-2\" data-name=\"field label\">\n                            Teléfono\n                        </span>\n                        <div class=\"flex min-h-12 items-center gap-3 border border-[#CBD5E1] bg-white px-3\" data-kid=\"2-2-3-1-2-3-1\" data-name=\"phone input container\">\n                            <i class=\"ti ti-phone text-[17px] text-[#64748B]\" data-kid=\"2-2-3-1-2-3-1-1\" data-name=\"phone icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span class=\"text-[14px] font-medium text-[#0F172A]\" data-kid=\"2-2-3-1-2-3-1-2\" data-name=\"phone text\">\n                                +57 315 482 9160\n                            </span>\n                        </div>\n                    </label>\n                </div>\n            </section>\n            <section class=\"mt-7 border-t border-[#CBD5E1] pt-5\" data-kid=\"2-2-3-2\" data-name=\"preferences section\">\n                <div class=\"mb-4\" data-kid=\"2-2-3-2-1\" data-name=\"preferences section header\">\n                    <h2 class=\"font-heading text-[17px] font-bold text-[#0F172A]\" data-kid=\"2-2-3-2-1-1\" data-name=\"section title\">\n                        Preferencias\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-2-1-2\" data-name=\"section description\">\n                        Personaliza cómo recibes la información de AutoDoc.\n                    </p>\n                </div>\n                <div class=\"divide-y divide-[#E2E8F0] border-y border-[#E2E8F0] bg-white\" data-kid=\"2-2-3-2-2\" data-name=\"stacked preference rows\">\n                    <div class=\"flex min-h-[72px] items-center justify-between gap-3 px-3\" data-kid=\"2-2-3-2-2-1\" data-name=\"language preference row\">\n                        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-2-3-2-2-1-1\" data-name=\"language preference icon and label container\">\n                            <i class=\"ti ti-language shrink-0 text-[19px] text-[#1E88E5]\" data-kid=\"2-2-3-2-2-1-1-1\" data-name=\"language icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <div class=\"min-w-0\" data-kid=\"2-2-3-2-2-1-1-2\" data-name=\"language text container\">\n                                <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-3-2-2-1-1-2-1\" data-name=\"preference title\">\n                                    Idioma\n                                </p>\n                                <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-2-3-2-2-1-1-2-2\" data-name=\"preference value\">\n                                    Español\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"inline-flex min-h-12 shrink-0 items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-3-2-2-1-2\" data-name=\"language selector button\" type=\"button\">\n                            <span data-kid=\"2-2-3-2-2-1-2-2\" data-name=\"selected language text\">\n                                Español\n                            </span>\n                            <i class=\"ti ti-chevron-down text-[15px]\" data-kid=\"2-2-3-2-2-1-2-1\" data-name=\"chevron down icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"flex min-h-[72px] items-center justify-between gap-3 px-3\" data-kid=\"2-2-3-2-2-2\" data-name=\"appearance preference row\">\n                        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-2-3-2-2-2-1\" data-name=\"appearance preference icon and label container\">\n                            <i class=\"ti ti-sun shrink-0 text-[19px] text-[#F59E0B]\" data-kid=\"2-2-3-2-2-2-1-1\" data-name=\"appearance icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <div class=\"min-w-0\" data-kid=\"2-2-3-2-2-2-1-2\" data-name=\"appearance text container\">\n                                <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-3-2-2-2-1-2-1\" data-name=\"preference title\">\n                                    Apariencia\n                                </p>\n                                <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-2-3-2-2-2-1-2-2\" data-name=\"preference value\">\n                                    Modo claro\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"inline-flex min-h-12 shrink-0 items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-3-2-2-2-2\" data-name=\"appearance selector button\" type=\"button\">\n                            <span data-kid=\"2-2-3-2-2-2-2-2\" data-name=\"selected appearance text\">\n                                Claro\n                            </span>\n                            <i class=\"ti ti-chevron-down text-[15px]\" data-kid=\"2-2-3-2-2-2-2-1\" data-name=\"chevron down icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"flex min-h-[72px] items-center justify-between gap-3 px-3\" data-kid=\"2-2-3-2-2-3\" data-name=\"notifications preference row\">\n                        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-2-3-2-2-3-1\" data-name=\"notifications preference icon and label container\">\n                            <i class=\"ti ti-bell-ringing shrink-0 text-[19px] text-[#10B981]\" data-kid=\"2-2-3-2-2-3-1-1\" data-name=\"notifications bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <div class=\"min-w-0\" data-kid=\"2-2-3-2-2-3-1-2\" data-name=\"notifications text container\">\n                                <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-3-2-2-3-1-2-1\" data-name=\"preference title\">\n                                    Notificaciones\n                                </p>\n                                <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-2-3-2-2-3-1-2-2\" data-name=\"preference value\">\n                                    Alertas de mantenimiento activadas\n                                </p>\n                            </div>\n                        </div>\n                        <div aria-checked=\"true\" aria-label=\"Notificaciones activadas\" class=\"flex h-7 w-12 shrink-0 items-center rounded-full bg-[#1E88E5] p-1\" data-kid=\"2-2-3-2-2-3-2\" data-name=\"notifications toggle switch\" role=\"switch\">\n                            <span class=\"ml-auto size-5 rounded-full bg-white shadow-sm\" data-kid=\"2-2-3-2-2-3-2-1\" data-name=\"toggle switch thumb\">\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section class=\"mt-7 border-t border-[#CBD5E1] pt-5\" data-kid=\"2-2-3-3\" data-name=\"role section\">\n                <div class=\"mb-4\" data-kid=\"2-2-3-3-1\" data-name=\"role section header\">\n                    <h2 class=\"font-heading text-[17px] font-bold text-[#0F172A]\" data-kid=\"2-2-3-3-1-1\" data-name=\"section title\">\n                        Rol de cuenta\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-3-1-2\" data-name=\"section description\">\n                        Define qué herramientas aparecen en tu espacio.\n                    </p>\n                </div>\n                <div class=\"flex items-start justify-between gap-3 border border-[#1E88E5] bg-[#E8F2FD] px-3 py-4\" data-kid=\"2-2-3-3-2\" data-name=\"selected role card\">\n                    <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"2-2-3-3-2-1\" data-name=\"role card icon and text container\">\n                        <div class=\"grid size-10 shrink-0 place-items-center rounded-full bg-white text-[#1E88E5]\" data-kid=\"2-2-3-3-2-1-1\" data-name=\"role icon container\">\n                            <i class=\"ti ti-user-check text-[19px]\" data-kid=\"2-2-3-3-2-1-1-1\" data-name=\"role check icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-2-3-3-2-1-2\" data-name=\"role details\">\n                            <p class=\"text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-2-3-3-2-1-2-1\" data-name=\"role name\">\n                                Propietario\n                            </p>\n                            <p class=\"mt-1 text-[12px] leading-5 text-[#475569]\" data-kid=\"2-2-3-3-2-1-2-2\" data-name=\"role description\">\n                                Puedes gestionar tus vehículos y servicios.\n                            </p>\n                        </div>\n                    </div>\n                    <span class=\"flex shrink-0 items-center gap-1 pt-1 text-[11px] font-bold text-[#1E88E5]\" data-kid=\"2-2-3-3-2-2\" data-name=\"selected status indicator\">\n                        <i class=\"ti ti-circle-check-filled text-[16px]\" data-kid=\"2-2-3-3-2-2-1\" data-name=\"check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"sr-only\" data-kid=\"2-2-3-3-2-2-2\" data-name=\"status text\">\n                            Seleccionado\n                        </span>\n                    </span>\n                </div>\n                <p class=\"mt-2 text-right text-[11px] font-bold text-[#1E88E5]\" data-kid=\"2-2-3-3-3\" data-name=\"selected status caption\">\n                    Seleccionado\n                </p>\n            </section>\n            <div class=\"mt-7 border-t border-[#CBD5E1] pt-5\" data-kid=\"2-2-3-4\" data-name=\"profile form actions\">\n                <p class=\"flex items-start gap-2 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-3-4-1\" data-name=\"security notice text\">\n                    <i class=\"ti ti-shield-lock mt-0.5 shrink-0 text-[16px] text-[#10B981]\" data-kid=\"2-2-3-4-1-1\" data-name=\"shield lock icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Tus datos se almacenan de forma segura.\n                </p>\n                <div class=\"mt-4 grid grid-cols-2 gap-3\" data-kid=\"2-2-3-4-2\" data-name=\"form action buttons\">\n                    <button class=\"min-h-12 border border-[#CBD5E1] bg-white px-3 text-[13px] font-semibold text-[#334155]\" data-kid=\"2-2-3-4-2-1\" data-name=\"cancel button\" type=\"button\">\n                        Cancelar\n                    </button>\n                    <button class=\"inline-flex min-h-12 items-center justify-center gap-2 bg-[#1E88E5] px-3 text-[13px] font-bold text-white\" data-kid=\"2-2-3-4-2-2\" data-name=\"save changes button\" type=\"submit\">\n                        Guardar cambios\n                        <i class=\"ti ti-check text-[16px]\" data-kid=\"2-2-3-4-2-2-1\" data-name=\"save check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </form>\n    </main>\n    <nav aria-label=\"Navegación principal móvil\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\" style=\"padding-bottom:env(safe-area-inset-bottom)\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-5 gap-1\" data-kid=\"2-3-1\" data-name=\"mobile bottom navigation items\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-11 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-1\" data-name=\"navigation link: home\" href=\"#inicio\">\n                <i class=\"ti ti-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"home icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-11 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-2\" data-name=\"navigation link: garage\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"garage icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"garage label\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-11 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-3\" data-name=\"navigation link: workshops\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-label=\"Alertas\" class=\"relative flex min-h-11 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-4\" data-name=\"navigation link: alerts\" href=\"#alertas\">\n                <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"alerts icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"alerts label\">\n                    Alertas\n                </span>\n                <span class=\"absolute right-3 top-1 size-1.5 rounded-full bg-[#EF4444]\" data-kid=\"2-3-1-4-3\" data-name=\"alerts badge\">\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Mi perfil\" class=\"flex min-h-11 flex-col items-center justify-center gap-0.5 rounded-lg bg-[#E8F2FD] text-[#1E88E5]\" data-kid=\"2-3-1-5\" data-name=\"navigation link: profile\" href=\"#perfil\">\n                <i class=\"ti ti-user text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"profile icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-5-2\" data-name=\"profile label\">\n                    Mi perfil\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
