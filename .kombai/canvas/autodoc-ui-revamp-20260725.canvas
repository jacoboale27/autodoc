                </div>\n                    </div>\n                </div>\n            </article>\n            <article class=\"px-4 py-4\" data-kid=\"1-2-3-6\" data-name=\"reject workshop audit record\">\n                <div class=\"flex items-start gap-3\" data-kid=\"1-2-3-6-1\" data-name=\"record layout group\">\n                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[var(--error-surface)] text-[var(--error)]\" data-kid=\"1-2-3-6-1-1\" data-name=\"record icon background\">\n                        <i class=\"ti ti-ban\" data-kid=\"1-2-3-6-1-1-1\" data-name=\"ban icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-3-6-1-2\" data-name=\"record content details\">\n                        <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-2-3-6-1-2-1\" data-name=\"record meta header\">\n                            <div class=\"min-w-0\" data-kid=\"1-2-3-6-1-2-1-1\" data-name=\"record title info\">\n                                <div class=\"text-[11px] font-bold uppercase tracking-[0.1em] text-[var(--error)]\" data-kid=\"1-2-3-6-1-2-1-1-1\" data-name=\"record action status label\">\n                                    RECHAZAR TALLER\n                                </div>\n                                <div class=\"mt-1 text-[13px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-2-3-6-1-2-1-1-2\" data-name=\"record event description\">\n                                    Rechazó una solicitud por documentación incompleta\n                                </div>\n                            </div>\n                            <time class=\"shrink-0 text-right text-[10px] leading-4 text-[var(--text-secondary)]\" data-kid=\"1-2-3-6-1-2-1-2\" data-name=\"record timestamp time element\">\n                                14/08/26\n                                <br data-kid=\"1-2-3-6-1-2-1-2-1\" data-name=\"line break\"/>\n                                <strong class=\"text-[var(--text-primary)]\" data-kid=\"1-2-3-6-1-2-1-2-2\" data-name=\"record time value\">\n                                    17:26\n                                </strong>\n                            </time>\n                        </div>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-2-3-6-1-2-2\" data-name=\"record secondary description\">\n                            La solicitud no cumplió los requisitos administrativos.\n                        </p>\n                        <div class=\"mt-3 flex flex-wrap gap-2\" data-kid=\"1-2-3-6-1-2-3\" data-name=\"record metadata tags\">\n                            <span class=\"rounded-full bg-[var(--surface-variant)] px-2.5 py-1 text-[10px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-2-3-6-1-2-3-1\" data-name=\"record category tag\">\n                                <i class=\"ti ti-category text-[11px]\" data-kid=\"1-2-3-6-1-2-3-1-1\" data-name=\"category icon\" style=\"width:11px;height:11px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                TALLERES\n                            </span>\n                            <span class=\"rounded-full bg-[var(--surface-variant)] px-2.5 py-1 font-mono text-[10px] text-[var(--text-secondary)]\" data-kid=\"1-2-3-6-1-2-3-2\" data-name=\"record fingerprint tag\">\n                                <i class=\"ti ti-fingerprint text-[11px]\" data-kid=\"1-2-3-6-1-2-3-2-1\" data-name=\"fingerprint icon\" style=\"width:11px;height:11px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                taller_29de…\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </article>\n        </section>\n        <footer class=\"mt-6 border-t border-[var(--outline)] pt-5 text-[11px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-2-4\" data-name=\"logs page footer\">\n            <div data-kid=\"1-2-4-1\" data-name=\"copyright notice text\">\n                AutoDoc · Consola de administración\n            </div>\n            <div class=\"mt-2 flex items-center gap-2\" data-kid=\"1-2-4-2\" data-name=\"sync status group\">\n                <span class=\"size-1.5 rounded-full bg-[var(--success)]\" data-kid=\"1-2-4-2-1\" data-name=\"sync status indicator\">\n                </span>\n                Datos sincronizados hace 2 min · Registro protegido para auditoría.\n            </div>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación de administración\" class=\"fixed inset-x-0 bottom-0 z-40 border-t border-[var(--outline)] bg-[#020617]/95 px-2 pb-[env(safe-area-inset-bottom)] pt-2 backdrop-blur-sm\" data-kid=\"1-3\" data-name=\"fixed admin bottom navigation\">\n        <div class=\"mx-auto grid max-w-[480px] grid-cols-5 gap-1\" data-kid=\"1-3-1\" data-name=\"navigation link grid\">\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-3-1-1\" data-name=\"dashboard navigation link\" href=\"#resumen\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"1-3-1-1-1\" data-name=\"dashboard icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-1-2\" data-name=\"dashboard label text\">\n                    Resumen\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-3-1-2\" data-name=\"users navigation link\" href=\"#usuarios\">\n                <i class=\"ti ti-users text-[18px]\" data-kid=\"1-3-1-2-1\" data-name=\"users icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-2-2\" data-name=\"users label text\">\n                    Usuarios\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-3-1-3\" data-name=\"workshops navigation link\" href=\"#talleres\">\n                <i class=\"ti ti-building-store text-[18px]\" data-kid=\"1-3-1-3-1\" data-name=\"workshops icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-3-2\" data-name=\"workshops label text\">\n                    Talleres\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-3-1-4\" data-name=\"reviews navigation link\" href=\"#resenas\">\n                <i class=\"ti ti-star text-[18px]\" data-kid=\"1-3-1-4-1\" data-name=\"reviews icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-4-2\" data-name=\"reviews label text\">\n                    Reseñas\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 border-t-2 border-[var(--primary)] bg-[var(--surface-variant)] text-[10px] font-bold text-[var(--primary)]\" data-kid=\"1-3-1-5\" data-name=\"active logs navigation link\" href=\"#logs\">\n                <i class=\"ti ti-list-details text-[18px]\" data-kid=\"1-3-1-5-1\" data-name=\"logs icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-5-2\" data-name=\"logs label text\">\n                    Logs\n                </span>\n            </a>\n        </div>\n    </nav>\n    <div class=\"admin-logs-scrim fixed inset-0 z-50 bg-[var(--scrim)] transition-opacity duration-200\" data-kid=\"1-4\" data-name=\"overlay backdrop scrim\" id=\"adminLogsScrim\">\n    </div>\n    <section aria-label=\"Filtros de actividad\" class=\"admin-logs-sheet fixed inset-x-0 bottom-0 z-[60] rounded-t-[24px] border border-[var(--outline-strong)] bg-[var(--surface-container)] px-4 pb-[calc(18px+env(safe-area-inset-bottom))] pt-4 shadow-[0_-12px_32px_rgba(2,6,23,.42)] transition duration-200\" data-kid=\"1-5\" data-name=\"filters bottom sheet\" id=\"adminLogsSheet\">\n        <div class=\"mx-auto mb-4 h-1 w-10 rounded-full bg-[var(--outline-strong)]\" data-kid=\"1-5-1\" data-name=\"sheet drag handle\">\n        </div>\n        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-5-2\" data-name=\"sheet header\">\n            <div data-kid=\"1-5-2-1\" data-name=\"sheet title container\">\n                <p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--primary)]\" data-kid=\"1-5-2-1-1\" data-name=\"sheet subtitle label\">\n                    Refinar consulta\n                </p>\n                <h2 class=\"admin-logs-mobile-heading mt-1 text-[19px] font-bold text-[var(--text-primary)]\" data-kid=\"1-5-2-1-2\" data-name=\"sheet main title\">\n                    Filtros\n                </h2>\n            </div>\n            <button aria-label=\"Cerrar filtros\" class=\"flex size-11 items-center justify-center rounded-full border border-[var(--outline-strong)] bg-[var(--surface-variant)] text-[var(--text-secondary)]\" data-kid=\"1-5-2-2\" data-name=\"sheet close button\" id=\"adminLogsSheetClose\">\n                <i class=\"ti ti-x text-[18px]\" data-kid=\"1-5-2-2-1\" data-name=\"close icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n        <p class=\"mt-5 text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-5-3\" data-name=\"action type section label\">\n            Tipo de acción\n        </p>\n        <div class=\"mt-3 flex flex-wrap gap-2\" data-kid=\"1-5-4\" data-name=\"action type filter tags\">\n            <button class=\"min-h-[44px] rounded-full border border-[var(--primary)] bg-[var(--primary)] px-3 text-[11px] font-bold text-[var(--on-primary)]\" data-kid=\"1-5-4-1\" data-name=\"all filter button\">\n                Todos\n            </button>\n            <button class=\"min-h-[44px] rounded-full border border-[var(--outline-strong)] px-3 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-5-4-2\" data-name=\"suspend filter button\">\n                SUSPENDER\n            </button>\n            <button class=\"min-h-[44px] rounded-full border border-[var(--outline-strong)] px-3 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-5-4-3\" data-name=\"approve filter button\">\n                APROBAR\n            </button>\n            <button class=\"min-h-[44px] rounded-full border border-[var(--outline-strong)] px-3 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-5-4-4\" data-name=\"change filter button\">\n                CAMBIAR\n            </button>\n            <button class=\"min-h-[44px] rounded-full border border-[var(--outline-strong)] px-3 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-5-4-5\" data-name=\"delete filter button\">\n                ELIMINAR\n            </button>\n        </div>\n        <p class=\"mt-5 text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-5-5\" data-name=\"date range section label\">\n            Rango de fechas\n        </p>\n        <div class=\"mt-3 grid grid-cols-2 gap-2\" data-kid=\"1-5-6\" data-name=\"date range input buttons\">\n            <button class=\"flex min-h-[48px] items-center gap-2 rounded-[12px] border border-[var(--outline-strong)] bg-[var(--surface-variant)] px-3 text-left text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-5-6-1\" data-name=\"date from button\">\n                <i class=\"ti ti-calendar text-[15px] text-[var(--primary)]\" data-kid=\"1-5-6-1-1\" data-name=\"calendar icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Desde\n            </button>\n            <button class=\"flex min-h-[48px] items-center gap-2 rounded-[12px] border border-[var(--outline-strong)] bg-[var(--surface-variant)] px-3 text-left text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-5-6-2\" data-name=\"date to button\">\n                <i class=\"ti ti-calendar text-[15px] text-[var(--primary)]\" data-kid=\"1-5-6-2-1\" data-name=\"calendar icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Hasta\n            </button>\n        </div>\n        <div class=\"mt-5 flex gap-2 border-t border-[var(--outline)] pt-4\" data-kid=\"1-5-7\" data-name=\"sheet action buttons\">\n            <button class=\"min-h-[48px] flex-1 rounded-full border border-[var(--outline-strong)] px-3 text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-5-7-1\" data-name=\"clear filter button\">\n                Limpiar\n            </button>\n            <button class=\"min-h-[48px] flex-1 rounded-full bg-[var(--primary)] px-3 text-[12px] font-bold text-[var(--on-primary)]\" data-kid=\"1-5-7-2\" data-name=\"apply filter button\" id=\"adminLogsSheetApply\">\n                Aplicar\n            </button>\n        </div>\n    </section>\n</div>\n<script>\n    const adminLogsTrigger = document.getElementById('adminLogsFilterTrigger');\n  const adminLogsSheet = document.getElementById('adminLogsSheet');\n  const adminLogsScrim = document.getElementById('adminLogsScrim');\n  const adminLogsClose = document.getElementById('adminLogsSheetClose');\n  const adminLogsApply = document.getElementById('adminLogsSheetApply');\n  const toggleAdminLogsSheet = (open) => {\n    adminLogsSheet.classList.toggle('is-open', open);\n    adminLogsScrim.classList.toggle('is-open', open);\n  };\n  adminLogsTrigger?.addEventListener('click', () => toggleAdminLogsSheet(true));\n  adminLogsClose?.addEventListener('click', () => toggleAdminLogsSheet(false));\n  adminLogsApply?.addEventListener('click', () => toggleAdminLogsSheet(false));\n  adminLogsScrim?.addEventListener('click', () => toggleAdminLogsSheet(false));\n</script>\n",
