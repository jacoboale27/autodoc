<div class=\"text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-1-2-4-3\">\n                                    Sin historial\n                                </div>\n                                <div class=\"flex items-center gap-2 text-[11px] font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-3-1-2-4-4\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[#FBBF24]\" data-kid=\"2-1-3-2-3-1-2-4-4-1\">\n                                    </span>\n                                    Sin datos\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mt-5 flex items-center justify-between border-t border-[#334155] pt-4 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-3\">\n                            <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-3-1-3-1\">\n                                <i class=\"ti ti-clock text-[14px] text-[#818CF8]\" data-kid=\"2-1-3-2-3-1-3-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Últimas búsquedas guardadas: P 482-916, H 731-204\n                            </span>\n                            <button class=\"font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-3-1-3-2\">\n                                Limpiar historial\n                            </button>\n                        </div>\n                    </section>\n                    <aside aria-labelledby=\"found-heading\" class=\"border-l border-[#334155] pl-7\" data-kid=\"2-1-3-2-3-2\">\n                        <div class=\"mb-4 flex items-center justify-between\" data-kid=\"2-1-3-2-3-2-1\">\n                            <div data-kid=\"2-1-3-2-3-2-1-1\">\n                                <span class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#34D399]\" data-kid=\"2-1-3-2-3-2-1-1-1\">\n                                    Resultado seleccionado\n                                </span>\n                                <h2 class=\"mt-2 text-[20px] font-bold tracking-[-0.025em] text-white\" data-kid=\"2-1-3-2-3-2-1-1-2\" id=\"found-heading\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                                    Vehículo encontrado\n                                </h2>\n                            </div>\n                            <i class=\"ti ti-car text-[22px] text-[#38BDF8]\" data-kid=\"2-1-3-2-3-2-1-2\" style=\"width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <div class=\"border-y border-[#475569] py-4\" data-kid=\"2-1-3-2-3-2-2\">\n                            <div class=\"text-[16px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-3-2-2-1\">\n                                Toyota Corolla 2022\n                            </div>\n                            <div class=\"mt-1 text-[12px] tabular-nums tracking-[0.12em] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-2-2-2\">\n                                P 482-916\n                            </div>\n                            <div class=\"mt-5 flex items-end justify-between\" data-kid=\"2-1-3-2-3-2-2-3\">\n                                <div data-kid=\"2-1-3-2-3-2-2-3-1\">\n                                    <div class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2-3-1-1\">\n                                        Kilometraje actual\n                                    </div>\n                                    <div class=\"mt-1 text-[24px] font-bold tabular-nums text-[#38BDF8]\" data-kid=\"2-1-3-2-3-2-2-3-1-2\">\n                                        48,260\n                                        <span class=\"text-[12px] font-medium text-[#94A3B8]\" data-kid=\"2-1-3-2-3-2-2-3-1-2-1\">\n                                            km\n                                        </span>\n                                    </div>\n                                </div>\n                                <div class=\"text-right\" data-kid=\"2-1-3-2-3-2-2-3-2\">\n                                    <div class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2-3-2-1\">\n                                        Cliente\n                                    </div>\n                                    <div class=\"mt-1 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-2-2-3-2-2\">\n                                        Juan Pérez\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"py-4\" data-kid=\"2-1-3-2-3-2-3\">\n                            <div class=\"mb-3 text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-2-3-1\">\n                                Alertas del vehículo\n                            </div>\n                            <div class=\"space-y-3\" data-kid=\"2-1-3-2-3-2-3-2\">\n                                <div class=\"flex items-start gap-3 border-l-2 border-[#F87171] pl-3\" data-kid=\"2-1-3-2-3-2-3-2-1\">\n                                    <i class=\"ti ti-alert-triangle mt-0.5 text-[16px] text-[#F87171]\" data-kid=\"2-1-3-2-3-2-3-2-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <div data-kid=\"2-1-3-2-3-2-3-2-1-2\">\n                                        <div class=\"text-[12px] font-semibold text-[#FCA5A5]\" data-kid=\"2-1-3-2-3-2-3-2-1-2-1\">\n                                            SOAT vencido\n                                        </div>\n                                        <div class=\"mt-0.5 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-2-3-2-1-2-2\">\n                                            Requiere renovación antes de circular.\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"flex items-start gap-3 border-l-2 border-[#FBBF24] pl-3\" data-kid=\"2-1-3-2-3-2-3-2-2\">\n                                    <i class=\"ti ti-tool mt-0.5 text-[16px] text-[#FBBF24]\" data-kid=\"2-1-3-2-3-2-3-2-2-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <div data-kid=\"2-1-3-2-3-2-3-2-2-2\">\n                                        <div class=\"text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-3-2-3-2-2-2-1\">\n                                            Frenos\n                                        </div>\n                                        <div class=\"mt-0.5 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-2-3-2-2-2-2\">\n                                            Revisión recomendada en 420 km.\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex gap-3 border-t border-[#334155] pt-5\" data-kid=\"2-1-3-2-3-2-4\">\n                            <button class=\"flex-1 bg-[#38BDF8] px-3 py-3 text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-2-3-2-4-1\">\n                                Iniciar servicio\n                                <i class=\"ti ti-arrow-up-right ml-1 text-[14px]\" data-kid=\"2-1-3-2-3-2-4-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                            <button class=\"flex-1 border border-[#475569] px-3 py-3 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-2-4-2\">\n                                Ver historial\n                            </button>\n                        </div>\n                        <div class=\"mt-5 flex items-start gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-5\">\n                            <i class=\"ti ti-info-circle mt-0.5 text-[14px] text-[#818CF8]\" data-kid=\"2-1-3-2-3-2-5-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span data-kid=\"2-1-3-2-3-2-5-2\">\n                                Sin resultados, muestra aquí un aviso para probar otra placa o escanear el QR.\n                            </span>\n                        </div>\n                    </aside>\n                </div>\n                <footer class=\"mt-8 flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-4\">\n                    <span data-kid=\"2-1-3-2-4-1\">\n                        AutoDoc · Gestión operativa del taller\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-1-3-2-4-2\" data-name=\"sync status timestamp\" data-reason=\"text updated periodically by synchronization script\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-4-2-1\">\n                        </span>\n                        Datos sincronizados hace 4 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
