      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen overflow-hidden bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"admin reviews application shell\" style=\"--surface:#F7F6F8;--surface-container:#EEEDF0;--surface-variant:#E2E8F0;--outline:#CBD5E1;--outline-strong:#94A3B8;--primary:#522C81;--secondary:#81E6D9;--text-primary:#0F172A;--text-secondary:#5B6B80;--warning:#B45309;--warning-surface:#FFFBEB;--error:#C2414B;--error-surface:#FFF1F2;--success:#2F855A;--success-surface:#ECFDF5;font-family:'IBM Plex Sans',sans-serif\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\" data-name=\"admin reviews layout\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"1-1-1\" data-name=\"primary admin icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[var(--secondary)] text-[18px] font-extrabold tracking-[-0.08em] text-[#0F172A]\" data-kid=\"1-1-1-1\" data-name=\"admin logo\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                AD\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"1-1-1-2\" data-name=\"primary admin navigation\">\n                <button aria-label=\"Resumen\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"1-1-1-2-1\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-1-2-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Usuarios\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"1-1-1-2-2\">\n                    <i class=\"ti ti-users\" data-kid=\"1-1-1-2-2-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"1-1-1-2-3\">\n                    <i class=\"ti ti-tool\" data-kid=\"1-1-1-2-3-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Reseñas\" class=\"grid size-11 place-items-center rounded-xl bg-[var(--primary)] text-[20px] text-white shadow-[0_8px_20px_rgba(82,44,129,0.24)]\" data-kid=\"1-1-1-2-4\">\n                    <i class=\"ti ti-star\" data-kid=\"1-1-1-2-4-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Logs\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"1-1-1-2-5\">\n                    <i class=\"ti ti-list-details\" data-kid=\"1-1-1-2-5-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Seed\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"1-1-1-2-6\">\n                    <i class=\"ti ti-database-cog\" data-kid=\"1-1-1-2-6-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </nav>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"1-1-1-3\" data-name=\"admin utility navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8]\" data-kid=\"1-1-1-3-1\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"1-1-1-3-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8]\" data-kid=\"1-1-1-3-2\">\n                    <i class=\"ti ti-settings\" data-kid=\"1-1-1-3-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[var(--outline)] bg-white px-5 py-6\" data-kid=\"1-1-2\" data-name=\"admin contextual sidebar\">\n            <div class=\"mb-8\" data-kid=\"1-1-2-1\" data-name=\"admin identity block\">\n                <p class=\"text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-2-1-1\">\n                    Administración\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"1-1-2-1-2\">\n                    <span class=\"size-2 rounded-full bg-[var(--success)]\" data-kid=\"1-1-2-1-2-1\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-2-1-2-2\">\n                        Superadmin\n                    </span>\n                </div>\n            </div>\n            <div class=\"mb-3 px-3 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--text-secondary)]\" data-kid=\"1-1-2-2\">\n                Centro de control\n            </div>\n            <nav aria-label=\"Navegación de administración\" class=\"flex flex-col gap-1\" data-kid=\"1-1-2-3\" data-name=\"admin sidebar links\">\n                <a class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-transparent px-3 text-[14px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-1\" href=\"#resumen\">\n                    <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"1-1-2-3-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Resumen\n                </a>\n                <a class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-transparent px-3 text-[14px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-2\" href=\"#usuarios\">\n                    <i class=\"ti ti-users text-[17px]\" data-kid=\"1-1-2-3-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Usuarios\n                </a>\n                <a class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-transparent px-3 text-[14px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-3\" href=\"#talleres\">\n                    <i class=\"ti ti-tool text-[17px]\" data-kid=\"1-1-2-3-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Talleres\n                </a>\n                <a aria-current=\"page\" class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-[var(--primary)] bg-[#F0EAF7] px-3 text-[14px] font-semibold text-[var(--primary)]\" data-kid=\"1-1-2-3-4\" href=\"#resenas\">\n                    <i class=\"ti ti-star text-[17px]\" data-kid=\"1-1-2-3-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Reseñas\n                    <span class=\"ml-auto rounded-full bg-[#E7DDF2] px-2 py-0.5 text-[11px] font-bold text-[var(--primary)]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-4-2\" data-name=\"review count badge\" data-reason=\"number text replaced by backend sync\">\n                        7\n                    </span>\n                </a>\n                <a class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-transparent px-3 text-[14px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-5\" href=\"#logs\">\n                    <i class=\"ti ti-list-details text-[17px]\" data-kid=\"1-1-2-3-5-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Logs\n                </a>\n                <a class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-transparent px-3 text-[14px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-6\" href=\"#seed\">\n                    <i class=\"ti ti-database-cog text-[17px]\" data-kid=\"1-1-2-3-6-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Seed\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[var(--surface-variant)] pt-5\" data-kid=\"1-1-2-4\" data-name=\"admin profile summary\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-4-1\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#E7DDF2] text-[12px] font-bold text-[var(--primary)]\" data-kid=\"1-1-2-4-1-1\">\n                        SA\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-1-2-4-1-2\">\n                        <p class=\"truncate text-[13px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-2-4-1-2-1\">\n                            Superadmin\n                        </p>\n                        <p class=\"truncate text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-1-2-4-1-2-2\">\n                            Acceso interno\n                        </p>\n                    </div>\n                    <i class=\"ti ti-chevron-down ml-auto text-[16px] text-[var(--outline-strong)]\" data-kid=\"1-1-2-4-1-3\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"1-1-3\" data-name=\"admin reviews main content\" id=\"resenas\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[var(--outline)] bg-white px-8\" data-kid=\"1-1-3-1\" data-name=\"admin reviews top bar\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"1-1-3-1-1\">\n                    <span class=\"text-[var(--text-secondary)]\" data-kid=\"1-1-3-1-1-1\">\n                        Admin\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px] text-[var(--outline-strong)]\" data-kid=\"1-1-3-1-1-2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-3-1-1-3\">\n                        Moderar reseñas\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-4\" data-kid=\"1-1-3-1-2\">\n                    <span class=\"text-[12px] text-[var(--text-secondary)]\" data-dynamic=\"true\" data-kid=\"1-1-3-1-2-1\" data-name=\"current date text\" data-reason=\"date text replaced by system clock\">\n                        Sábado, 17 ago 2026\n                    </span>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[var(--outline)] bg-[var(--surface-container)] text-[var(--text-secondary)]\" data-kid=\"1-1-3-1-2-2\">\n                        <i class=\"ti ti-bell\" data-kid=\"1-1-3-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[var(--error)]\" data-kid=\"1-1-3-1-2-2-2\">\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-2 border-l border-[var(--outline)] pl-4\" data-kid=\"1-1-3-1-2-3\">\n                        <div class=\"grid size-9 place-items-center rounded-full bg-[#E7DDF2] text-[12px] font-bold text-[var(--primary)]\" data-kid=\"1-1-3-1-2-3-1\">\n                            SA\n                        </div>\n                        <span class=\"text-[13px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-3-1-2-3-2\">\n                            Superadmin\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1120px] px-8 py-8\" data-kid=\"1-1-3-2\" data-name=\"reviews content container\">\n                <div class=\"mb-6 flex items-end justify-between gap-6\" data-kid=\"1-1-3-2-1\" data-name=\"reviews page heading\">\n                    <div data-kid=\"1-1-3-2-1-1\">\n                        <p class=\"mb-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--primary)]\" data-kid=\"1-1-3-2-1-1-1\">\n                            Moderación de contenido\n                        </p>\n                        <h1 class=\"text-[32px] font-extrabold tracking-[-0.045em] text-[var(--text-primary)]\" data-kid=\"1-1-3-2-1-1-2\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Moderar reseñas\n                        </h1>\n                        <p class=\"mt-2 text-[15px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-1-1-3\">\n                            Revisa la experiencia de los usuarios y protege la calidad de la comunidad.\n                        </p>\n                    </div>\n                    <div class=\"flex min-h-[52px] items-center gap-3 rounded-full border border-[var(--outline)] bg-white px-4 shadow-[0_2px_4px_rgba(15,23,42,0.04)]\" data-kid=\"1-1-3-2-1-2\">\n                        <span class=\"text-[13px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-3-2-1-2-1\">\n                            Mostrar solo reportadas\n                        </span>\n                        <span class=\"relative inline-flex h-7 w-12 rounded-full bg-[var(--error)]\" data-kid=\"1-1-3-2-1-2-2\">\n                            <span class=\"absolute left-1 top-1 size-5 rounded-full bg-white shadow-sm\" data-kid=\"1-1-3-2-1-2-2-1\">\n                            </span>\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mb-5 flex items-center justify-between gap-4 border-y border-[var(--outline)] py-4\" data-kid=\"1-1-3-2-2\" data-name=\"reviews list summary\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-3-2-2-1\">\n                        <span class=\"flex size-9 items-center justify-center rounded-full bg-[#F0EAF7] text-[var(--primary)]\" data-kid=\"1-1-3-2-2-1-1\">\n                            <i class=\"ti ti-message-report\" data-kid=\"1-1-3-2-2-1-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-1-3-2-2-1-2\">\n                            <p class=\"text-[13px] font-bold text-[var(--text-primary)]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-2-1-2-1\" data-name=\"total reviews in review count\" data-reason=\"number text replaced by backend sync\">\n                                7 reseñas en revisión\n                            </p>\n                            <p class=\"text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-1-2-2\">\n                                Las reportadas aparecen primero.\n                            </p>\n                        </div>\n                    </div>\n                    <button class=\"flex min-h-[48px] items-center gap-2 rounded-full border border-[var(--outline)] bg-white px-4 text-[12px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-3-2-2-2\">\n                        <i class=\"ti ti-refresh text-[var(--primary)]\" data-kid=\"1-1-3-2-2-2-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Actualizar\n                    </button>\n                </div>\n                <section class=\"grid gap-4\" data-kid=\"1-1-3-2-3\" data-name=\"loaded reviews list\">\n                    <article class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-5 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-3-2-3-1\" data-name=\"reported review card\">\n                        <div class=\"flex items-start gap-4\" data-kid=\"1-1-3-2-3-1-1\">\n                            <div class=\"flex size-11 shrink-0 items-center justify-center rounded-[12px] bg-[var(--warning-surface)] text-[var(--warning)]\" data-kid=\"1-1-3-2-3-1-1-1\">\n                                <i class=\"ti ti-star-filled\" data-kid=\"1-1-3-2-3-1-1-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-1-3-2-3-1-1-2\">\n                                <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-1-3-2-3-1-1-2-1\">\n                                    <div data-kid=\"1-1-3-2-3-1-1-2-1-1\">\n                                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-1-3-2-3-1-1-2-1-1-1\">\n                                            <div aria-label=\"2 de 5 estrellas\" class=\"flex items-center gap-0.5 text-[var(--warning)]\" data-kid=\"1-1-3-2-3-1-1-2-1-1-1-1\">\n                                                <i class=\"ti ti-star-filled\" data-kid=\"1-1-3-2-3-1-1-2-1-1-1-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                <i class=\"ti ti-star-filled\" data-kid=\"1-1-3-2-3-1-1-2-1-1-1-1-2\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                <i class=\"text-[var(--outline-strong)]\" data-kid=\"1-1-3-2-3-1-1-2-1-1-1-1-3\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                <i class=\"ti ti-star\" data-kid=\"1-1-3-2-3-1-1-2-1-1-1-1-4\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                <i class=\"ti ti-star\" data-kid=\"1-1-3-2-3-1-1-2-1-1-1-1-5\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                            </div>\n                                            <span class=\"inline-flex min-h-[28px] items-center gap-1 rounded-full bg-[var(--error-surface)] px-2.5 text-[11px] font-bold text-[var(--error)]\" data-kid=\"1-1-3-2-3-1-1-2-1-1-1-2\">\n                                                <i class=\"ti ti-flag-3\" data-kid=\"1-1-3-2-3-1-1-2-1-1-1-2-1\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                Reportada\n                                            </span>\n                                        </div>\n                                        <p class=\"mt-2 text-[13px] text-[var(--text-secondary)]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3-1-1-2-1-1-2\" data-name=\"reported status badge\" data-reason=\"badge text injected based on review status\">\n                                            15/08/2026\n                                        </p>\n                                    </div>\n                                    <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-3-2-3-1-1-2-1-2\">\n                                        <button aria-label=\"Descartar reporte\" class=\"flex size-12 items-center justify-center rounded-full border border-[var(--outline)] bg-white text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-3-1-1-2-1-2-1\">\n                                            <i class=\"ti ti-flag-off\" data-kid=\"1-1-3-2-3-1-1-2-1-2-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                            </i>\n                                        </button>\n                                        <button aria-label=\"Eliminar reseña\" class=\"flex size-12 items-center justify-center rounded-full border border-[#E8B8BB] bg-[var(--error-surface)] text-[var(--error)]\" data-kid=\"1-1-3-2-3-1-1-2-1-2-2\">\n                                            <i class=\"ti ti-trash\" data-kid=\"1-1-3-2-3-1-1-2-1-2-2-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                            </i>\n                                        </button>\n                                    </div>\n                                </div>\n                                <p class=\"mt-3 max-w-[820px] text-[14px] leading-6 text-[var(--text-primary)]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3-1-1-2-2\" data-name=\"review body text\" data-reason=\"text content replaced by fetched database record\">\n                                    El servicio fue rápido, pero la explicación del trabajo quedó incompleta y tuve que pedir aclaraciones.\n                                </p>\n                                <div class=\"mt-4 flex flex-wrap items-center gap-2\" data-kid=\"1-1-3-2-3-1-1-2-3\">\n                                    <span class=\"inline-flex min-h-[32px] items-center gap-1.5 rounded-full bg-[var(--surface-variant)] px-3 text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-3-1-1-2-3-1\">\n                                        <i class=\"ti ti-building-store\" data-kid=\"1-1-3-2-3-1-1-2-3-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Taller: Taller Rápido\n                                    </span>\n                                    <span class=\"inline-flex min-h-[32px] items-center gap-1.5 rounded-full bg-[var(--surface-variant)] px-3 text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-3-1-1-2-3-2\">\n                                        <i class=\"ti ti-user\" data-kid=\"1-1-3-2-3-1-1-2-3-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Cliente: Juan Pérez\n                                    </span>\n                                </div>\n                                <div class=\"mt-4 flex items-center gap-2\" data-kid=\"1-1-3-2-3-1-1-2-4\">\n                                    <div class=\"size-12 overflow-hidden rounded-[10px] border border-[var(--outline)] bg-[var(--surface-variant)]\" data-kid=\"1-1-3-2-3-1-1-2-4-1\">\n                                        <div class=\"h-full w-full bg-[#D8D1DE]\" data-kid=\"1-1-3-2-3-1-1-2-4-1-1\">\n                                        </div>\n                                    </div>\n                                    <div class=\"size-12 overflow-hidden rounded-[10px] border border-[var(--outline)] bg-[var(--surface-variant)]\" data-kid=\"1-1-3-2-3-1-1-2-4-2\">\n                                        <div class=\"flex h-full items-center justify-center text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-3-1-1-2-4-2-1\">\n                                            <i class=\"ti ti-photo-off\" data-kid=\"1-1-3-2-3-1-1-2-4-2-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                            </i>\n                                        </div>\n                                    </div>\n                                    <span class=\"text-[11px] text-[var(--text-secondary)]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3-1-1-2-4-3\" data-name=\"photo attachment status text\" data-reason=\"number of photos replaced by fetched record\">\n                                        2 fotos · una no disponible\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-5 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-3-2-3-2\" data-name=\"published review card\">\n                        <div class=\"flex items-start gap-4\" data-kid=\"1-1-3-2-3-2-1\">\n                            <div class=\"flex size-11 shrink-0 items-center justify-center rounded-[12px] bg-[var(--success-surface)] text-[var(--success)]\" data-kid=\"1-1-3-2-3-2-1-1\">\n                                <i class=\"ti ti-message-check\" data-kid=\"1-1-3-2-3-2-1-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-1-3-2-3-2-1-2\">\n                                <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-1-3-2-3-2-1-2-1\">\n                                    <div data-kid=\"1-1-3-2-3-2-1-2-1-1\">\n                                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-2-3-2-1-2-1-1-1\">\n                                            <div aria-label=\"5 de 5 estrellas\" class=\"flex items-center gap-0.5 text-[var(--warning)]\" data-kid=\"1-1-3-2-3-2-1-2-1-1-1-1\">\n                                                <i class=\"ti ti-star-filled\" data-kid=\"1-1-3-2-3-2-1-2-1-1-1-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                <i class=\"ti ti-star-filled\" data-kid=\"1-1-3-2-3-2-1-2-1-1-1-1-2\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                <i class=\"ti ti-star-filled\" data-kid=\"1-1-3-2-3-2-1-2-1-1-1-1-3\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                <i class=\"ti ti-star-filled\" data-kid=\"1-1-3-2-3-2-1-2-1-1-1-1-4\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                <i class=\"ti ti-star-filled\" data-kid=\"1-1-3-2-3-2-1-2-1-1-1-1-5\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                            </div>\n                                            <span class=\"inline-flex min-h-[28px] items-center gap-1 rounded-full bg-[var(--success-surface)] px-2.5 text-[11px] font-bold text-[var(--success)]\" data-kid=\"1-1-3-2-3-2-1-2-1-1-1-2\">\n                                                <i class=\"ti ti-circle-check\" data-kid=\"1-1-3-2-3-2-1-2-1-1-1-2-1\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                Visible\n                                            </span>\n                                        </div>\n                                        <p class=\"mt-2 text-[13px] text-[var(--text-secondary)]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3-2-1-2-1-1-2\" data-name=\"published status badge\" data-reason=\"badge text injected based on review status\">\n                                            12/08/2026\n                                        </p>\n                                    </div>\n                                    <button aria-label=\"Eliminar reseña\" class=\"flex size-12 items-center justify-center rounded-full border border-[var(--outline)] bg-white text-[var(--error)]\" data-kid=\"1-1-3-2-3-2-1-2-1-2\">\n                                        <i class=\"ti ti-trash\" data-kid=\"1-1-3-2-3-2-1-2-1-2-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                    </button>\n                                </div>\n                                <p class=\"mt-3 max-w-[820px] text-[14px] leading-6 text-[var(--text-primary)]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3-2-1-2-2\" data-name=\"review body text\" data-reason=\"text content replaced by fetched database record\">\n                                    Excelente atención y diagnóstico muy claro. El vehículo quedó listo antes de lo esperado.\n                                </p>\n                                <div class=\"mt-4 flex flex-wrap items-center gap-2\" data-kid=\"1-1-3-2-3-2-1-2-3\">\n                                    <span class=\"inline-flex min-h-[32px] items-center gap-1.5 rounded-full bg-[var(--surface-variant)] px-3 text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-3-2-1-2-3-1\">\n                                        <i class=\"ti ti-building-store\" data-kid=\"1-1-3-2-3-2-1-2-3-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Taller: MotorLab\n                                    </span>\n                                    <span class=\"inline-flex min-h-[32px] items-center gap-1.5 rounded-full bg-[var(--surface-variant)] px-3 text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-3-2-1-2-3-2\">\n                                        <i class=\"ti ti-user\" data-kid=\"1-1-3-2-3-2-1-2-3-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Cliente: Ana Torres\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </article>\n                </section>\n                <aside class=\"mt-5 flex items-center gap-3 rounded-[14px] border border-dashed border-[var(--outline)] bg-white px-4 py-3\" data-kid=\"1-1-3-2-4\" data-name=\"compact empty state cue\">\n                    <span class=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-[var(--surface-variant)] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-1\">\n                        <i class=\"ti ti-inbox\" data-kid=\"1-1-3-2-4-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-1-3-2-4-2\">\n                        <p class=\"text-[12px] font-bold text-[var(--text-primary)]\" data-kid=\"1-1-3-2-4-2-1\">\n                            Estado alternativo sin resultados\n                        </p>\n                        <p class=\"text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-2-2\">\n                            No hay reseñas reportadas · No hay reseñas registradas\n                        </p>\n                    </div>\n                </aside>\n                <p class=\"mt-6 flex items-center gap-2 text-[11px] text-[var(--text-secondary)]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-5\" data-name=\"last sync status text\" data-reason=\"timestamp replaced periodically by sync script\">\n                    <span class=\"size-1.5 rounded-full bg-[var(--success)]\" data-kid=\"1-1-3-2-5-1\">\n                    </span>\n                    Datos sincronizados hace 4 min · Moderación protegida\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
