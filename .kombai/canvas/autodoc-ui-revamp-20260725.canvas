    "var_5ff7647d0c6f": {
      "type": "variant",
      "label": "AutoDoc Mechanic Dashboard — Hadrian Dark Mobile",
      "parentId": "var_c0f414e54464",
      "themeId": null,
      "rect": {
        "x": 10655,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\">\n</script>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"mobile mechanic dashboard root\">\n    <header class=\"sticky top-0 z-20 border-b border-[#334155] bg-[#0B1220]/95 px-4 pb-3 pt-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"compact mobile top bar\">\n        <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and utility row\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"mobile workshop identity\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1-1\" data-name=\"AutoDoc logo initials text\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"workshop brand text\">\n                    <div class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#94A3B8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"workshop category label\">\n                        Taller\n                    </div>\n                    <div class=\"mt-0.5 flex items-center gap-2 [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-2-2\" data-name=\"workshop name container\">\n                        <span class=\"truncate text-[15px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"workshop name text\">\n                            Taller\n                            <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-1-2-2-1-1\" data-name=\"workshop name highlighted part\">\n                                Rápido\n                            </span>\n                        </span>\n                        <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-1-2-2-2\" data-name=\"status indicator dot\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"mobile utility actions\">\n                <button aria-label=\"Chat\" class=\"relative flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-transparent bg-transparent text-[#CBD5E1] transition duration-150 ease-out hover:border-[#334155] hover:bg-[#141E36] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-1-2-1\" data-name=\"chat action button\">\n                    <i class=\"ti ti-message-2 text-[19px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"chat icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-1 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-2-1-2\" data-name=\"chat notification indicator dot\">\n                    </span>\n                </button>\n                <button aria-label=\"Cambiar tema\" class=\"flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-1-2-2\" data-name=\"theme toggle action button\">\n                    <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"sun moon icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Notificaciones\" class=\"relative flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-1-2-3\" data-name=\"notifications action button\">\n                    <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-1-2-3-1\" data-name=\"bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-2-3-2\" data-name=\"notification indicator dot\">\n                    </span>\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-3 flex items-center justify-between gap-3 text-[11px]\" data-kid=\"2-1-2\" data-name=\"mobile breadcrumb and time row\">\n            <div class=\"flex items-center gap-2 text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"breadcrumb navigation container\">\n                <span data-kid=\"2-1-2-1-1\" data-name=\"current section text\">\n                    Taller\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-1-2-1-2\" data-name=\"breadcrumb separator icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-1-2-1-3\" data-name=\"active page text\">\n                    Panel\n                </span>\n            </div>\n            <div class=\"text-right\" data-kid=\"2-1-2-2\" data-name=\"current date and time display\">\n                <div class=\"text-[10px] text-[#64748B]\" data-kid=\"2-1-2-2-1\" data-name=\"current date text\">\n                    Sábado, 25 jul 2026\n                </div>\n                <div class=\"mt-0.5 font-semibold text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-2\" data-name=\"current time text\" data-reason=\"updated by system time script\">\n                    08:42 a. m.\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[112px] pt-6\" data-kid=\"2-2\" data-name=\"mobile mechanic dashboard content\">\n        <section class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"mobile dashboard heading\">\n            <div data-kid=\"2-2-1-2\" data-name=\"page title container\">\n                <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[27px] font-extrabold leading-[1.1] tracking-[-0.04em] text-white\" data-kid=\"2-2-1-2-1\" data-name=\"main page headline\">\n                    Panel del taller\n                </h1>\n                <p class=\"mt-2 text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-2-2\" data-name=\"page description text\">\n                    Una vista clara de las reparaciones que mueven tu día.\n                </p>\n            </div>\n            <button class=\"mt-5 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-5 py-3 text-[12px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-2-1-1\" data-name=\"new repair action button\">\n                <i class=\"ti ti-plus text-[15px]\" data-kid=\"2-2-1-1-1\" data-name=\"plus icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Nueva reparación\n            </button>\n        </section>\n        <section class=\"overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-2\" data-name=\"mobile operations scoreboard container\">\n            <div class=\"flex items-center justify-between gap-3 border-b border-[#334155] px-1 py-3\" data-kid=\"2-2-2-2\" data-name=\"scoreboard header\">\n                <div class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-2-2-1\" data-name=\"scoreboard title\">\n                    Resumen operativo\n                </div>\n                <div class=\"flex items-center gap-2 text-[10px] text-[#94A3B8]\" data-kid=\"2-2-2-2-2\" data-name=\"refresh status container\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-2-2-2-1\" data-name=\"refresh status indicator\">\n                    </span>\n                    Actualizado hace 4 min\n                </div>\n            </div>\n            <div class=\"grid grid-cols-2 divide-x divide-y divide-[#334155]\" data-kid=\"2-2-2-1\" data-name=\"stacked operations metrics container\">\n                <div class=\"min-h-[104px] px-3 py-4\" data-kid=\"2-2-2-1-1\" data-name=\"metric card\">\n                    <div class=\"text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-1-1\" data-name=\"metric label\">\n                        Servicios hoy\n                    </div>\n                    <div class=\"mt-2 text-[24px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-2-1-1-2\" data-name=\"metric value\">\n                        12\n                    </div>\n                    <div class=\"mt-1 text-[10px] font-semibold text-[#34D399]\" data-kid=\"2-2-2-1-1-3\" data-name=\"metric trend indicator\">\n                        +3 vs. ayer\n                    </div>\n                </div>\n                <div class=\"min-h-[104px] px-3 py-4\" data-kid=\"2-2-2-1-2\">\n                    <div class=\"text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-2-1\">\n                        En curso\n                    </div>\n                    <div class=\"mt-2 text-[24px] font-bold tabular-nums text-[#38BDF8]\" data-kid=\"2-2-2-1-2-2\">\n                        4\n                    </div>\n                    <div class=\"mt-1 text-[10px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-2-1-2-3\">\n                        2 bahías activas\n                    </div>\n                </div>\n                <div class=\"min-h-[104px] px-3 py-4\" data-kid=\"2-2-2-1-3\">\n                    <div class=\"text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-3-1\">\n                        Pendientes\n                    </div>\n                    <div class=\"mt-2 text-[24px] font-bold tabular-nums text-[#FCD34D]\" data-kid=\"2-2-2-1-3-2\">\n                        7\n                    </div>\n                    <div class=\"mt-1 text-[10px] font-semibold text-[#FBBF24]\" data-kid=\"2-2-2-1-3-3\">\n                        Requieren revisión\n                    </div>\n                </div>\n                <div class=\"min-h-[104px] px-3 py-4\" data-kid=\"2-2-2-1-4\">\n                    <div class=\"text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-4-1\">\n                        Ingresos del mes\n                    </div>\n                    <div class=\"mt-2 text-[22px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-2-1-4-2\">\n                        $8,420\n                    </div>\n                    <div class=\"mt-1 text-[10px] font-semibold text-[#34D399]\" data-kid=\"2-2-2-1-4-3\">\n                        +12.6%\n                    </div>\n                </div>\n                <div class=\"min-h-[104px] px-3 py-4\" data-kid=\"2-2-2-1-5\">\n                    <div class=\"text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-5-1\">\n                        Tiempo medio\n                    </div>\n                    <div class=\"mt-2 text-[20px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-2-1-5-2\">\n                        2 h 15 min\n                    </div>\n                    <div class=\"mt-1 text-[10px] font-semibold text-[#34D399]\" data-kid=\"2-2-2-1-5-3\">\n                        -18 min esta semana\n                    </div>\n                </div>\n                <div class=\"min-h-[104px] px-3 py-4\" data-kid=\"2-2-2-1-6\">\n                    <div class=\"text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-6-1\">\n                        Satisfacción\n                    </div>\n                    <div class=\"mt-2 flex items-baseline gap-1\" data-kid=\"2-2-2-1-6-2\">\n                        <span class=\"text-[24px] font-bold tabular-nums text-[#FCD34D]\" data-kid=\"2-2-2-1-6-2-1\">\n                            4.8\n                        </span>\n                        <span class=\"text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-1-6-2-2\">\n                            /5\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[10px] font-semibold text-[#FBBF24]\" data-kid=\"2-2-2-1-6-3\">\n                        36 reseñas\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-7 overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-3\" data-name=\"mobile revenue chart panel\">\n            <div class=\"flex items-start justify-between gap-3 border-b border-[#334155] px-1 py-4\" data-kid=\"2-2-3-1\" data-name=\"revenue chart header\">\n                <div data-kid=\"2-2-3-1-1\" data-name=\"revenue header text container\">\n                    <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold leading-tight tracking-[-0.02em] text-white\" data-kid=\"2-2-3-1-1-1\" data-name=\"revenue section title\">\n                        Ingresos últimos 7 días\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-3-1-1-2\" data-name=\"revenue section description\">\n                        Cierre diario de órdenes facturadas\n                    </p>\n                </div>\n                <span class=\"shrink-0 text-right text-[11px] font-semibold text-[#34D399]\" data-kid=\"2-2-3-1-2\" data-name=\"total revenue amount\">\n                    $2,184\n                    <br data-kid=\"2-2-3-1-2-1\" data-name=\"revenue amount line break\"/>\n                    esta semana\n                </span>\n            </div>\n            <div class=\"px-1 pb-4 pt-5\" data-kid=\"2-2-3-2\" data-name=\"revenue chart container\">\n                <div class=\"h-[176px] w-full\" data-kid=\"2-2-3-2-1\" data-name=\"chart drawing area\">\n                    <canvas aria-label=\"Gráfico de ingresos de los últimos siete días\" data-dynamic=\"true\" data-kid=\"2-2-3-2-1-1\" data-name=\"revenue line chart\" data-reason=\"rendered by Chart.js script\" id=\"mechanicRevenueChartMobile\">\n                    </canvas>\n                </div>\n                <div class=\"mt-3 flex justify-between px-2 text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-2-3-2-2\" data-name=\"chart x-axis labels\">\n                    <span data-kid=\"2-2-3-2-2-1\">\n                        L\n                    </span>\n                    <span data-kid=\"2-2-3-2-2-2\">\n                        M\n                    </span>\n                    <span data-kid=\"2-2-3-2-2-3\">\n                        X\n                    </span>\n                    <span data-kid=\"2-2-3-2-2-4\">\n                        J\n                    </span>\n                    <span data-kid=\"2-2-3-2-2-5\">\n                        V\n                    </span>\n                    <span data-kid=\"2-2-3-2-2-6\">\n                        S\n                    </span>\n                    <span data-kid=\"2-2-3-2-2-7\">\n                        D\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-7 overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-4\" data-name=\"mobile active repairs queue section\">\n            <div class=\"flex items-start justify-between gap-3 border-b border-[#334155] px-1 py-4\" data-kid=\"2-2-4-5\" data-name=\"active repairs header\">\n                <div data-kid=\"2-2-4-5-1\">\n                    <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold leading-tight tracking-[-0.02em] text-white\" data-kid=\"2-2-4-5-1-1\">\n                        Reparaciones activas\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-4-5-1-2\">\n                        Seguimiento por prioridad\n                    </p>\n                </div>\n                <span class=\"shrink-0 text-[11px] font-semibold text-[#FBBF24]\" data-kid=\"2-2-4-5-2\">\n                    4 en curso\n                </span>\n            </div>\n            <div class=\"divide-y divide-[#334155]\" data-kid=\"2-2-4-6\" data-name=\"active repairs list\">\n                <div class=\"px-1 py-4\" data-kid=\"2-2-4-1\" data-name=\"active repair item\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-1-1\">\n                        <span class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-4-1-1-1\">\n                            Toyota Corolla\n                        </span>\n                        <span class=\"flex shrink-0 items-center gap-1 text-[10px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-4-1-1-2\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#38BDF8]\" data-kid=\"2-2-4-1-1-2-1\">\n                            </span>\n                            En curso\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-4-1-2\">\n                        P 482-916 · Cambio de aceite\n                    </div>\n                </div>\n                <div class=\"px-1 py-4\" data-kid=\"2-2-4-2\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-2-1\">\n                        <span class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-4-2-1-1\">\n                            Mazda 3\n                        </span>\n                        <span class=\"flex max-w-[148px] shrink-0 items-center justify-end gap-1 text-right text-[10px] font-semibold leading-4 text-[#FCD34D]\" data-kid=\"2-2-4-2-1-2\">\n                            <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#FBBF24]\" data-kid=\"2-2-4-2-1-2-1\">\n                            </span>\n                            Esperando aprobación\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-4-2-2\">\n                        H 731-204 · Frenos\n                    </div>\n                </div>\n                <div class=\"px-1 py-4\" data-kid=\"2-2-4-3\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-3-1\">\n                        <span class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-4-3-1-1\">\n                            Renault Duster\n                        </span>\n                        <span class=\"flex shrink-0 items-center gap-1 text-[10px] font-semibold text-[#FCA5A5]\" data-kid=\"2-2-4-3-1-2\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-2-4-3-1-2-1\">\n                            </span>\n                            Prioridad alta\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-4-3-2\">\n                        J 204-118 · Diagnóstico\n                    </div>\n                </div>\n            </div>\n            <button class=\"flex min-h-[48px] items-center gap-2 px-1 text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-4-4\" data-name=\"view all repairs action button\">\n                Ver todas las reparaciones\n                <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"2-2-4-4-1\" data-name=\"arrow right icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </section>\n        <section class=\"mt-7 border-t border-[#334155] pt-5\" data-kid=\"2-2-5\" data-name=\"mobile quick actions section\">\n            <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-5-1\">\n                <div data-kid=\"2-2-5-1-1\">\n                    <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold tracking-[-0.02em] text-white\" data-kid=\"2-2-5-1-1-1\">\n                        Accesos rápidos\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-5-1-1-2\">\n                        Tareas frecuentes del equipo\n                    </p>\n                </div>\n                <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-5-1-2\">\n                    3 accesos\n                </span>\n            </div>\n            <div class=\"mt-4 divide-y divide-[#334155] overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-5-2\" data-name=\"quick actions links container\">\n                <a class=\"flex min-h-[68px] items-center gap-3 px-1 py-3 text-[13px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-5-2-1\" data-name=\"quick action link\" href=\"#buscar\">\n                    <span class=\"flex h-8 w-8 shrink-0 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"2-2-5-2-1-1\">\n                        <i class=\"ti ti-search text-[16px]\" data-kid=\"2-2-5-2-1-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-2-5-2-1-2\">\n                        Buscar vehículo\n                    </span>\n                    <i class=\"ti ti-arrow-up-right ml-auto text-[14px] text-[#64748B]\" data-kid=\"2-2-5-2-1-3\" data-name=\"arrow up right icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </a>\n                <a class=\"flex min-h-[68px] items-center gap-3 px-1 py-3 text-[13px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-5-2-2\" href=\"#catalogo\">\n                    <span class=\"flex h-8 w-8 shrink-0 items-center justify-center border border-[#475569] text-[#818CF8]\" data-kid=\"2-2-5-2-2-1\">\n                        <i class=\"ti ti-list-details text-[16px]\" data-kid=\"2-2-5-2-2-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-2-5-2-2-2\">\n                        Catálogo de servicios\n                    </span>\n                    <i class=\"ti ti-arrow-up-right ml-auto text-[14px] text-[#64748B]\" data-kid=\"2-2-5-2-2-3\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </a>\n                <a class=\"flex min-h-[68px] items-center gap-3 px-1 py-3 text-[13px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-5-2-3\" href=\"#historial\">\n                    <span class=\"flex h-8 w-8 shrink-0 items-center justify-center border border-[#475569] text-[#34D399]\" data-kid=\"2-2-5-2-3-1\">\n                        <i class=\"ti ti-history text-[16px]\" data-kid=\"2-2-5-2-3-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-2-5-2-3-2\">\n                        Historial de servicios\n                    </span>\n                    <i class=\"ti ti-arrow-up-right ml-auto text-[14px] text-[#64748B]\" data-kid=\"2-2-5-2-3-3\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </a>\n            </div>\n        </section>\n        <footer class=\"mt-8 flex flex-col gap-2 border-t border-[#334155] pt-4 text-[11px] text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"footer bar\">\n            <span data-kid=\"2-2-6-1\">\n                AutoDoc · Operación del taller\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-2-6-2\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-6-2-1\">\n                </span>\n                Sincronizado hace 4 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-30 mx-auto flex min-h-[80px] max-w-[375px] items-start border-t border-[#334155] bg-[#020617] px-1 pb-[env(safe-area-inset-bottom)] pt-2\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\">\n        <a aria-current=\"page\" class=\"flex min-h-[56px] flex-1 flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] text-[#38BDF8]\" data-kid=\"2-3-1\" data-name=\"dashboard nav item\" href=\"#panel\">\n            <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"2-3-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"text-[9px] font-semibold\" data-kid=\"2-3-1-2\">\n                Panel\n            </span>\n        </a>\n        <a class=\"relative flex min-h-[56px] flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-2\" data-name=\"repairs nav item\" href=\"#reparaciones\">\n            <span class=\"relative\" data-kid=\"2-3-2-1\" data-name=\"nav item icon wrapper\">\n                <i class=\"ti ti-tool text-[18px]\" data-kid=\"2-3-2-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute -right-3 -top-2 rounded-[4px] bg-[#7F1D1D] px-1 py-0.5 text-[8px] font-bold text-[#FCA5A5]\" data-kid=\"2-3-2-1-2\" data-name=\"repairs count badge\">\n                    07\n                </span>\n            </span>\n            <span class=\"text-[9px] font-medium\" data-kid=\"2-3-2-2\">\n                Reparaciones\n            </span>\n        </a>\n        <a class=\"flex min-h-[56px] flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-3\" data-name=\"search vehicle nav item\" href=\"#buscar\">\n            <i class=\"ti ti-search text-[18px]\" data-kid=\"2-3-3-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"text-center text-[9px] font-medium leading-3\" data-kid=\"2-3-3-2\">\n                Buscar vehículo\n            </span>\n        </a>\n        <a class=\"flex min-h-[56px] flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-4\" data-name=\"history nav item\" href=\"#historial\">\n            <i class=\"ti ti-history text-[18px]\" data-kid=\"2-3-4-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"text-[9px] font-medium\" data-kid=\"2-3-4-2\">\n                Historial\n            </span>\n        </a>\n        <a class=\"flex min-h-[56px] flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-5\" data-name=\"reviews nav item\" href=\"#resenas\">\n            <i class=\"ti ti-star text-[18px] text-[#FBBF24]\" data-kid=\"2-3-5-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"text-[9px] font-medium\" data-kid=\"2-3-5-2\">\n                Reseñas\n            </span>\n        </a>\n    </nav>\n</div>\n<script>\n    const revenueCanvas = document.getElementById('mechanicRevenueChartMobile');\n  if (revenueCanvas && window.Chart) {\n    new Chart(revenueCanvas, {\n      type: 'line',\n      data: { labels: ['L','M','X','J','V','S','D'], datasets: [{ data: [260, 310, 280, 420, 360, 290, 264], borderColor: '#38BDF8', backgroundColor: 'rgba(56,189,248,0.12)', borderWidth: 2, pointRadius: 3, pointBackgroundColor: '#38BDF8', pointBorderColor: '#0F172A', pointBorderWidth: 2, tension: 0.35, fill: true }] },\n      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false, min: 0, max: 500 } }, animation: { duration: 0 } }\n    });\n  }\n</script>\n",
