\n                                <i class=\"ti ti-mood-smile text-[17px]\" data-kid=\"2-2-2-2-3-1-2-2-1\" data-name=\"smiley emoji icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                            <span class=\"ml-auto text-[10px] text-[#64748B]\" data-kid=\"2-2-2-2-3-1-2-3\" data-name=\"send prompt text\">\n                                Enter para enviar\n                            </span>\n                        </div>\n                    </div>\n                    <button aria-label=\"Enviar mensaje\" class=\"mt-3 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-2-2-2-3-2\" data-name=\"send message button\">\n                        <i class=\"ti ti-send text-[19px]\" data-kid=\"2-2-2-2-3-2-1\" data-name=\"send message icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Enviar mensaje\n                    </button>\n                </div>\n            </div>\n        </section>\n    </main>\n    <nav aria-label=\"Navegación móvil\" class=\"fixed inset-x-0 bottom-0 z-40 border-t border-[#334155] bg-[#020617] px-2 pb-[calc(env(safe-area-inset-bottom)+8px)] pt-2\" data-kid=\"2-3\" data-name=\"mobile navigation bar\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-4 gap-1\" data-kid=\"2-3-1\" data-name=\"navigation items container\">\n            <button aria-label=\"Inicio\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" data-name=\"navigation home button\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"2-3-1-1-1\" data-name=\"home icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px]\" data-kid=\"2-3-1-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </button>\n            <button aria-label=\"Mi garaje\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"navigation garage button\">\n                <i class=\"ti ti-steering-wheel text-[18px]\" data-kid=\"2-3-1-2-1\" data-name=\"steering wheel icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px]\" data-kid=\"2-3-1-2-2\" data-name=\"garage label\">\n                    Garaje\n                </span>\n            </button>\n            <button aria-label=\"Talleres\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"navigation workshops button\">\n                <i class=\"ti ti-tool text-[18px]\" data-kid=\"2-3-1-3-1\" data-name=\"tool icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px]\" data-kid=\"2-3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </button>\n            <button aria-label=\"Conversaciones\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] text-[#38BDF8]\" data-kid=\"2-3-1-4\" data-name=\"navigation messages button\">\n                <i class=\"ti ti-message-2 text-[18px]\" data-kid=\"2-3-1-4-1\" data-name=\"messages icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-4-2\" data-name=\"messages label\">\n                    Mensajes\n                </span>\n            </button>\n        </div>\n    </nav>\n</div>\n",
