      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<style data-name=\"AutoDoc shared component treatment\">\n    :root { --app-primary: #81E6D9; --app-secondary: #522C81; --app-surface-container: #141E36; --app-outline: #334155; --app-on-primary: #0F172A; --app-shadow-sm: 0 2px 4px rgba(0,0,0,0.20); --app-shadow-hover: 0 6px 14px rgba(0,0,0,0.35); }\n  button { min-height: 48px; border-radius: 999px !important; transition: transform 150ms cubic-bezier(0.23,1,0.32,1), box-shadow 150ms cubic-bezier(0.23,1,0.32,1), background-color 150ms cubic-bezier(0.23,1,0.32,1), border-color 150ms cubic-bezier(0.23,1,0.32,1), color 150ms cubic-bezier(0.23,1,0.32,1); }\n  button:active { transform: scale(0.97); }\n  button:focus-visible { outline: 3px solid rgba(129,230,217,0.35); outline-offset: 2px; }\n  button[class*=\"bg-[#1E88E5]\"], button[class*=\"bg-[#38BDF8]\"] { background: var(--app-primary) !important; color: var(--app-on-primary) !important; box-shadow: var(--app-shadow-sm); }\n  button[class*=\"border-[#1E88E5]\"], button[class*=\"border-[#38BDF8]\"] { border-color: var(--app-primary) !important; color: var(--app-primary) !important; }\n  button[class*=\"bg-\"]:hover, button[class*=\"border-\"]:hover { box-shadow: var(--app-shadow-hover); }\n  button[aria-label=\"Notificaciones\"], button[aria-label=\"Cambiar a modo oscuro\"], button[aria-label=\"Cambiar tema\"], button[aria-label=\"Panel del taller\"], button[aria-label=\"Reparaciones\"], button[aria-label=\"Buscar vehículo\"], button[aria-label=\"Conversaciones\"], button[aria-label=\"Ayuda\"], button[aria-label=\"Configuración\"], button[aria-label^=\"Más acciones\"], button[aria-label^=\"Acciones para\"], button[aria-label=\"Ordenar reseñas\"], button[aria-label=\"Limpiar filtros\"], button[aria-label=\"Página anterior\"], button[aria-label=\"Página siguiente\"] { min-width: 48px !important; min-height: 48px !important; padding: 0.75rem !important; border: 1px solid var(--app-outline) !important; border-radius: 999px !important; background: var(--app-surface-container) !important; box-shadow: var(--app-shadow-sm); }\n  button[aria-label=\"Notificaciones\"]:hover, button[aria-label=\"Cambiar a modo oscuro\"]:hover, button[aria-label=\"Cambiar tema\"]:hover, button[aria-label^=\"Más acciones\"]:hover, button[aria-label^=\"Acciones para\"]:hover { box-shadow: var(--app-shadow-hover); }\n  main section { border: 1px solid rgba(51,65,85,0.70); border-radius: 16px; background: var(--app-surface-container); box-shadow: var(--app-shadow-sm); overflow: hidden; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"application root\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"workshop application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"workshop icon rail\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\" data-name=\"primary rail group\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#082F49]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1-1\" data-name=\"AutoDoc logo initials\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-1-2\" data-name=\"rail navigation\">\n                    <button aria-label=\"Panel del taller\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"dashboard navigation button\">\n                        <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Reparaciones\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-1-2-2\" data-name=\"repairs navigation button\">\n                        <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"repairs icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Buscar vehículo\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-1-2-3\" data-name=\"vehicle search navigation button\">\n                        <i class=\"ti ti-search text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" data-name=\"vehicle search icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Conversaciones\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-1-2-4\" data-name=\"conversations navigation button\">\n                        <i class=\"ti ti-message-2 text-[19px]\" data-kid=\"2-1-1-1-2-4-1\" data-name=\"conversations icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\" data-name=\"secondary rail group\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-1\" data-name=\"settings navigation button\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-2\" data-name=\"help navigation button\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"help icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\" data-name=\"workshop contextual sidebar\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\" data-name=\"workshop identity\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\" data-name=\"workshop label\">\n                    Taller\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-2-1-2\" data-name=\"workshop name and status\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-2-1-2-1\" data-name=\"workshop name text\">\n                        Taller\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"workshop name fast suffix text\">\n                            Rápido\n                        </span>\n                    </span>\n                    <span aria-label=\"Taller activo\" class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-2-1-2-2\" data-name=\"workshop status indicator\">\n                    </span>\n                </div>\n                <div class=\"mt-2 text-[11px] text-[#64748B]\" data-kid=\"2-1-2-1-3\" data-name=\"workshop status text\">\n                    Operación activa\n                </div>\n            </div>\n            <nav aria-label=\"Navegación del taller\" class=\"flex-1 px-4 py-6\" data-kid=\"2-1-2-2\" data-name=\"context navigation\">\n                <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-1\" data-name=\"operation navigation heading\">\n                    Operación\n                </div>\n                <div class=\"space-y-1\" data-kid=\"2-1-2-2-2\" data-name=\"operation navigation links\">\n                    <a class=\"flex items-center gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-3 py-3 text-[13px] font-semibold text-white\" data-kid=\"2-1-2-2-2-1\" data-name=\"dashboard link\" href=\"#\">\n                        <i class=\"ti ti-layout-dashboard text-[17px] text-[#38BDF8]\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"dashboard icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Panel\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-3 py-3 text-[13px] font-semibold text-white\" data-kid=\"2-1-2-2-2-2\" data-name=\"repairs link\" href=\"#\">\n                        <i class=\"ti ti-tool text-[17px] text-[#38BDF8]\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"repairs icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Reparaciones\n                        <span class=\"ml-auto rounded-[4px] bg-[#075985] px-1.5 py-0.5 text-[10px] font-bold text-[#BAE6FD]\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"repairs pending count badge\">\n                            04\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-3\" data-name=\"vehicle search link\" href=\"#\">\n                        <i class=\"ti ti-search text-[17px]\" data-kid=\"2-1-2-2-2-3-1\" data-name=\"vehicle search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Buscar vehículo\n                    </a>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-4\" data-name=\"history link\" href=\"#\">\n                        <i class=\"ti ti-history text-[17px]\" data-kid=\"2-1-2-2-2-4-1\" data-name=\"history icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Historial\n                    </a>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-5\" data-name=\"reviews link\" href=\"#\">\n                        <i class=\"ti ti-star text-[17px] text-[#FBBF24]\" data-kid=\"2-1-2-2-2-5-1\" data-name=\"reviews icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Reseñas\n                        <span class=\"ml-auto text-[11px] text-[#64748B]\" data-kid=\"2-1-2-2-2-5-2\" data-name=\"reviews rating text\">\n                            4.8\n                        </span>\n                    </a>\n                </div>\n                <div class=\"mt-10 border-t border-[#334155] pt-7\" data-kid=\"2-1-2-2-3\"