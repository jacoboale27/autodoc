      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component treatment\">\n    :root { --app-primary: #81E6D9; --app-surface-container: #141E36; --app-outline: #334155; --app-on-primary: #0F172A; --app-shadow-sm: 0 2px 4px rgba(0,0,0,0.20); --app-shadow-hover: 0 6px 14px rgba(0,0,0,0.35); }\n  button { min-height: 48px; border-radius: 999px !important; transition: transform 150ms cubic-bezier(0.23,1,0.32,1), box-shadow 150ms cubic-bezier(0.23,1,0.32,1), background-color 150ms cubic-bezier(0.23,1,0.32,1), border-color 150ms cubic-bezier(0.23,1,0.32,1), color 150ms cubic-bezier(0.23,1,0.32,1); }\n  button:active { transform: scale(0.97); }\n  button:focus-visible { outline: 3px solid rgba(129,230,217,0.35); outline-offset: 2px; }\n  button[class*=\"bg-[#1E88E5]\"], button[class*=\"bg-[#38BDF8]\"] { background: var(--app-primary) !important; color: var(--app-on-primary) !important; box-shadow: var(--app-shadow-sm); }\n  button[class*=\"border-[#1E88E5]\"], button[class*=\"border-[#38BDF8]\"] { border-color: var(--app-primary) !important; color: var(--app-primary) !important; }\n  button[class*=\"bg-\"]:hover, button[class*=\"border-\"]:hover { box-shadow: var(--app-shadow-hover); }\n  button[aria-label] { min-width: 48px; min-height: 48px; padding: 0.75rem; border: 1px solid var(--app-outline) !important; background: var(--app-surface-container) !important; box-shadow: var(--app-shadow-sm); }\n  main section { border: 1px solid rgba(51,65,85,0.70); border-radius: 16px; background: var(--app-surface-container); box-shadow: var(--app-shadow-sm); overflow: hidden; }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"mechanic service history application\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"mechanic application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"mechanic icon rail\">\n            <div class=\"flex flex-col items-center gap-8\" data-kid=\"2-1-1-1\" data-name=\"primary rail group\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    AD\n                </div>\n                <div class=\"flex flex-col items-center gap-4 text-[#94A3B8]\" data-kid=\"2-1-1-1-2\" data-name=\"rail navigation buttons\">\n                    <button aria-label=\"Panel del taller\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"dashboard rail button\">\n                        <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"dashboard rail icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Reparaciones\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-2\" data-name=\"repairs rail button\">\n                        <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"repairs rail icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Buscar vehículo\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-3\" data-name=\"search rail button\">\n                        <i class=\"ti ti-search text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" data-name=\"search rail icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Historial de servicios\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-4\" data-name=\"history rail button\">\n                        <i class=\"ti ti-history text-[19px]\" data-kid=\"2-1-1-1-2-4-1\" data-name=\"history rail icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Conversaciones\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-5\" data-name=\"chat rail button\">\n                        <i class=\"ti ti-message-circle text-[19px]\" data-kid=\"2-1-1-1-2-5-1\" data-name=\"chat rail icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\" data-name=\"secondary rail group\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-1\" data-name=\"settings rail button\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"settings rail icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-2\" data-name=\"help rail button\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"help rail icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\" data-name=\"mechanic contextual sidebar\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\" data-name=\"workshop identity header\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\" data-name=\"role label\">\n                    Taller\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 font-heading\" data-kid=\"2-1-2-1-2\" data-name=\"workshop name row\">\n                    <span class=\"text-[18px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-1-2-1-2-1\" data-name=\"workshop name text\">\n                        Taller\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"workshop name highlight\">\n                            Rápido\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-2-1-2-2\" data-name=\"online status\">\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación del taller\" class=\"flex-1 px-4 py-6\" data-kid=\"2-1-2-2\" data-name=\"contextual navigation\">\n                <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-1\" data-name=\"operation section label\">\n                    Operación\n                </div>\n                <div class=\"space-y-1\" data-kid=\"2-1-2-2-2\" data-name=\"operation links\">\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-1\" data-name=\"dashboard nav link\" href=\"#panel\">\n                        <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"dashboard nav icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Panel\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-2\" data-name=\"repairs nav link\" href=\"#reparaciones\">\n                        <i class=\"ti ti-tool text-[17px]\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"repairs nav icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Reparaciones\n                        <span class=\"ml-auto rounded-[4px] bg-[#3F1D25] px-1.5 py-0.5 text-[10px] font-bold tabular-nums text-[#FCA5A5]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"repairs counter badge\" data-reason=\"number replaced by backend state\">\n                            07\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-3\" data-name=\"search nav link\" href=\"#buscar\">\n                        <i class=\"ti ti-search text-[17px]\" data-kid=\"2-1-2-2-2-3-1\" data-name=\"search nav icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Buscar vehículo\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-3 py-3 text-[13px] font-semibold text-white\" data-kid=\"2-1-2-2-2-4\" data-name=\"history nav link\" href=\"#historial\">\n                        <i class=\"ti ti-history text-[17px] text-[#38BDF8]\" data-kid=\"2-1-2-2-2-4-1\" data-name=\"history nav icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Historial\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-5\" data-name=\"reviews nav link\" href=\"#resenas\">\n                        <i class=\"ti ti-star text-[17px]\" data-kid=\"2-1-2-2-2-5-1\" data-name=\"reviews nav icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Reseñas\n                        <span class=\"ml-auto text-[11px] tabular-nums text-[#FCD34D]\" data-kid=\"2-1-2-2-2-5-2\" data-name=\"reviews rating score\">\n                            4.8\n                        </span>\n                    </a>\n                </div>\n                <div class=\"mt-10 border-t border-[#334155] pt-7\" data-kid=\"2-1-2-2-3\" data-name=\"management section\">\n                    <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-3-1\" data-name=\"management section label\">\n                        Gestión\n                    </div>\n                    <div class=\"space-y-1\" data-kid=\"2-1-2-2-3-2\" data-name=\"management links\">\n                        <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-2-1\" data-name=\"catalog nav link\" href=\"#catalogo\">\n                            <i class=\"ti ti-list-details text-[17px] text-[#818CF8]\" data-kid=\"2-1-2-2-3-2-1-1\" data-name=\"catalog nav icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Catálogo\n                        </a>\n                        <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-2-2\" data-name=\"employees nav link\" href=\"#empleados\">\n                            <i class=\"ti ti-users text-[17px]\" data-kid=\"2-1-2-2-3-2-2-1\" data-name=\"employees nav icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Empleados\n                        </a>\n                    </div>\n                </div>\n            </nav>\n            <div class=\"border-t border-[#334155] px-5 py-5\" data-kid=\"2-1-2-3\" data-name=\"workshop account footer\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\" data-name=\"account identity block\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-3-1-1\" data-name=\"account initials\">\n                        TR\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\" data-name=\"account info text\">\n                        <div class=\"truncate text-[12px] font-semibold text-white\" data-kid=\"2-1-2-3-1-2-1\" data-name=\"account workshop name\">\n                            Taller Rápido\n                        </div>\n                        <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\" data-name=\"account plan type\">\n                            Plan profesional\n                        </div>\n                    </div>\n                    <i class=\"ti ti-dots ml-auto text-[16px] text-[#64748B]\" data-kid=\"2-1-2-3-1-3\" data-name=\"account menu icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[#0F172A]\" data-kid=\"2-1-3\" data-name=\"service history main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#334155] px-8\" data-kid=\"2-1-3-1\" data-name=\"history top header\">\n                <div class=\"flex items-center gap-3 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumb\">\n                    <span data-kid=\"2-1-3-1-1-1\" data-name=\"breadcrumb root item\">\n                        Taller\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-1-3-1-1-2\" data-name=\"breadcrumb separator icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-1-1-3\" data-name=\"breadcrumb current page\">\n                        Historial\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-6\" data-kid=\"2-1-3-1-2\" data-name=\"header utilities\">\n                    <div class=\"text-right\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1\" data-name=\"current date time\" data-reason=\"text replaced by local time clock\">\n                        <div class=\"text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-1\" data-name=\"current date text\" data-reason=\"text replaced by local time clock\">\n                            Sábado, 15 ago 2026\n                        </div>\n                        <div class=\"mt-0.5 text-[12px] font-semibold text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-2\" data-name=\"current time text\" data-reason=\"text replaced by local time clock\">\n                            09:14 a. m.\n                        </div>\n                    </div>\n                    <div class=\"h-5 w-px bg-[#334155]\" data-kid=\"2-1-3-1-2-2\" data-name=\"utility separator\">\n                    </div>\n                    <button aria-label=\"Cambiar tema\" class=\"flex h-9 w-9 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-3-1-2-3\" data-name=\"theme toggle button\">\n                        <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"theme toggle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex h-9 w-9 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-3-1-2-4\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-3-1-2-4-1\" data-name=\"notifications icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-4-2\" data-name=\"notifications badge\" data-reason=\"visibility controlled by backend notifications\">\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-3 border-l border-[#334155] pl-5\" data-kid=\"2-1-3-1-2-5\" data-name=\"user menu button\">\n                        <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-1-2-5-1\" data-name=\"user initials\">\n                            MR\n                        </div>\n