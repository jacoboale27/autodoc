      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .safe-bottom { padding-bottom: max(12px, env(safe-area-inset-bottom)); }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"mobile application container\">\n    <header class=\"sticky top-0 z-20 border-b border-[#334155] bg-[#0B1220]/95 px-4 pb-3 pt-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile top bar\">\n        <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"mobile top bar identity row\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"mobile brand and context\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#082F49] shadow-[0_8px_24px_rgba(56,189,248,0.14)]\" data-kid=\"2-1-1-1-1\" data-name=\"application logo container\">\n                    <span class=\"text-[17px] font-extrabold tracking-[-0.09em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1-1\" data-name=\"application logo text\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"mobile screen context\">\n                    <div class=\"text-[10px] font-semibold uppercase tracking-[0.15em] text-[#64748B]\" data-kid=\"2-1-1-1-2-1\" data-name=\"owner role label\">\n                        Propietario\n                    </div>\n                    <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-1-2-2\" data-name=\"mobile brand name row\">\n                        <span class=\"truncate text-[17px] font-extrabold tracking-[-0.04em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"brand name\">\n                            Auto\n                            <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-1-2-2-1-1\" data-name=\"brand name accent text\">\n                                Doc\n                            </span>\n                        </span>\n                        <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-1-2-2-2\" data-name=\"status indicator\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"mobile header actions\">\n                <button aria-label=\"Cambiar tema\" class=\"flex h-11 w-11 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-1-2-1\" data-name=\"theme toggle button\">\n                    <i class=\"ti ti-sun-moon text-[18px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"theme toggle icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Notificaciones\" class=\"relative flex h-11 w-11 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-1-2-2\" data-name=\"notifications button\">\n                    <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"notifications icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-2-2-2\" data-name=\"notifications indicator\">\n                    </span>\n                </button>\n                <button aria-label=\"Perfil de Juan Pérez\" class=\"flex h-11 w-11 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-1-2-3\" data-name=\"user avatar button\">\n                    JP\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-3 flex items-center justify-between gap-3 text-[11px]\" data-kid=\"2-1-2\" data-name=\"mobile breadcrumb and datetime row\">\n            <div class=\"flex min-w-0 items-center gap-2 text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"breadcrumb navigation\">\n                <span data-kid=\"2-1-2-1-1\" data-name=\"breadcrumb parent\">\n                    Propietario\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-1-2-1-2\" data-name=\"breadcrumb separator icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"truncate font-medium text-[#E2E8F0]\" data-kid=\"2-1-2-1-3\" data-name=\"breadcrumb current\">\n                    Mi garaje\n                </span>\n            </div>\n            <div class=\"shrink-0 text-right text-[#64748B]\" data-kid=\"2-1-2-2\" data-name=\"datetime container\">\n                <div data-dynamic=\"true\" data-kid=\"2-1-2-2-1\" data-name=\"current date text\" data-reason=\"date updated by script\">\n                    Sábado, 25 jul 2026\n                </div>\n                <div class=\"mt-0.5 font-semibold text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-2\" data-name=\"current time text\" data-reason=\"time updated by script\">\n                    08:42 a. m.\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[104px] pt-6\" data-kid=\"2-2\" data-name=\"mobile page main content\">\n        <div class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"page heading section\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-1-1\" data-name=\"page title row\">\n                <div class=\"min-w-0\" data-kid=\"2-2-1-1-1\" data-name=\"page title group\">\n                    <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[28px] font-extrabold leading-tight tracking-[-0.04em] text-white\" data-kid=\"2-2-1-1-1-1\" data-name=\"main page title\">\n                        Mi garaje\n                    </h1>\n                    <p class=\"mt-2 max-w-[300px] text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-1-1-2\" data-name=\"page description\">\n                        Tus vehículos y su estado de mantenimiento, en un solo lugar.\n                    </p>\n                </div>\n            </div>\n            <button class=\"mt-5 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-5 py-3 text-[12px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-2-1-2\" data-name=\"add vehicle action button\">\n                <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-2-1-2-1\" data-name=\"add vehicle icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Añadir vehículo\n            </button>\n        </div>\n        <div class=\"mb-6 border-y border-[#334155] py-4\" data-kid=\"2-2-2\" data-name=\"search and filter controls\">\n            <div class=\"flex h-11 w-full items-center gap-3 border border-[#475569] bg-[#111C2D] px-3 text-[#64748B]\" data-kid=\"2-2-2-1\" data-name=\"search input field\">\n                <i class=\"ti ti-search text-[18px]\" data-kid=\"2-2-2-1-1\" data-name=\"search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"truncate text-[13px]\" data-kid=\"2-2-2-1-2\" data-name=\"search placeholder text\">\n                    Buscar por marca o placa\n                </span>\n            </div>\n            <div class=\"mt-3 flex items-center gap-3\" data-kid=\"2-2-2-2\" data-name=\"filter and count row\">\n                <button class=\"flex min-h-[48px] min-w-0 flex-1 items-center justify-between gap-2 rounded-full border border-[#334155] bg-[#141E36] px-4 text-[13px] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-2-2-2-1\" data-name=\"filter toggle button\">\n                    <span class=\"flex min-w-0 items-center gap-2\" data-kid=\"2-2-2-2-1-3\" data-name=\"filter label container\">\n                        <i class=\"ti ti-adjustments-horizontal shrink-0 text-[17px] text-[#94A3B8]\" data-kid=\"2-2-2-2-1-1\" data-name=\"filter icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"truncate\" data-kid=\"2-2-2-2-1-3-2\" data-name=\"filter label text\">\n                            Todos los estados\n                        </span>\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[15px] text-[#64748B]\" data-kid=\"2-2-2-2-1-2\" data-name=\"filter chevron icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <span class=\"shrink-0 text-right text-[11px] font-semibold tabular-nums text-[#94A3B8]\" data-kid=\"2-2-2-2-2\" data-name=\"vehicle count display\">\n                    2 vehículos registrados\n                </span>\n            </div>\n        </div>\n        <section aria-label=\"Vehículos registrados\" class=\"grid gap-4\" data-kid=\"2-2-3\" data-name=\"mobile vehicle list\">\n            <article class=\"overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-3-1\" data-name=\"primary vehicle card\">\n                <div class=\"relative h-[190px] bg-[#111827]\" data-kid=\"2-2-3-1-1\" data-name=\"vehicle image container\">\n                    <img alt=\"Sedán Hyundai en estudio, Hyundai Motor Group en Pexels\" class=\"h-full w-full object-cover opacity-90\" data-kid=\"2-2-3-1-1-1\" data-name=\"vehicle image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14696345/pexels-photo-14696345.jpeg?auto=compress&cs=tinysrgb&w=750&q=80\"/>\n                    <div class=\"absolute inset-x-0 bottom-0 bg-[#020617]/80 px-4 py-3\" data-kid=\"2-2-3-1-1-2\" data-name=\"vehicle image overlay\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.18em] text-[#94A3B8]\" data-kid=\"2-2-3-1-1-2-1\" data-name=\"vehicle status label\">\n                            Vehículo principal\n                        </div>\n                        <div class=\"mt-1 flex items-center gap-2 text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-1-1-2-2\" data-name=\"vehicle status indicator\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-3-1-1-2-2-1\" data-name=\"status circle icon\">\n                            </span>\n                            Activo\n                        </div>\n                    </div>\n                </div>\n                <div class=\"p-4\" data-kid=\"2-2-3-1-2\" data-name=\"vehicle info details\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-1-2-1\" data-name=\"vehicle title and status\">\n                        <div class=\"min-w-0\" data-kid=\"2-2-3-1-2-1-1\" data-name=\"vehicle display name\">\n                            <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[21px] font-bold leading-tight tracking-[-0.035em] text-white\" data-kid=\"2-2-3-1-2-1-1-1\" data-name=\"vehicle model\">\n                                Toyota Corolla 2022\n                            </h2>\n                            <div class=\"mt-2 text-[13px] font-semibold tracking-[0.14em] text-[#CBD5E1]\" data-kid=\"2-2-3-1-2-1-1-2\" data-name=\"vehicle license plate\">\n                                P 482-916\n                            </div>\n                        </div>\n                        <span class=\"shrink-0 border border-[#FBBF24]/50 bg-[#713F12]/20 px-2 py-1 text-[10px] font-bold tracking-[0.12em] text-[#FCD34D]\" data-kid=\"2-2-3-1-2-1-2\" data-name=\"urgent badge\">\n                            REVISIÓN\n                        </span>\n                    </div>\n                    <div class=\"mt-6 grid grid-cols-2 gap-4 border-y border-[#475569] py-4\" data-kid=\"2-2-3-1-2-2\" data-name=\"metric grid\">\n                        <div data-kid=\"2-2-3-1-2-2-1\" data-name=\"mileage column\">\n                            <div class=\"text-[10px] font-semibold uppercase tracking-[0.15em] text-[#64748B]\" data-kid=\"2-2-3-1-2-2-1-1\" data-name=\"mileage label\">\n                                Kilometraje\n                            </div>\n                            <div class=\"mt-2 text-[22px] font-bold tabular-nums text-[#38BDF8]\" data-kid=\"2-2-3-1-2-2-1-2\" data-name=\"mileage value\">\n                                48,260\n                                <span class=\"text-[12px] font-medium text-[#94A3B8]\" data-kid=\"2-2-3-1-2-2-1-2-1\" data-name=\"mileage unit\">\n                                    km\n                                </span>\n                            </div>\n                        </div>\n                        <div data-kid=\"2-2-3-1-2-2-2\" data-name=\"status column\">\n                            <div class=\"text-[10px] font-semibold uppercase tracking-[0.15em] text-[#64748B]\" data-kid=\"2-2-3-1-2-2-2-1\" data-name=\"status label\">\n                                Estado\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-2 text-[13px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-3-1-2-2-2-2\" data-name=\"status text\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#FBBF24]\" data-kid=\"2-2-3-1-2-2-2-2-1\" data-name=\"status icon\">\n                                </span>\n                                Revisión pronta\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-3-1-2-3\" data-name=\"maintenance warning\">\n                        Próxima revisión en\n                        <strong class=\"font-semibold tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-3-1-2-3-1\" data-name=\"maintenance distance\">\n                            420 km\n                        </strong>\n                    </div>\n                    <button class=\"mt-4 flex min-h-11 w-full items-center justify-between border-t border-[#334155] pt-4 text-left text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-3-1-2-4\" data-name=\"view vehicle link\">\n                        Ver ficha completa\n                        <i class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"2-2-3-1-2-4-1\" data-name=\"link arrow icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </article>\n            <article class=\"rounded-[16px] border border-[#334155]/20 bg-[#141E36] p-4 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-3-2\" data-name=\"secondary vehicle card\">\n                <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-2-3-2-1\" data-name=\"secondary card header\">\n                    <div class=\"min-w-0\" data-kid=\"2-2-3-2-1-1\" data-name=\"secondary card title\">\n                        <div class=\"mb-3 flex items-center gap-2 text-[11px] font-semibold text-[#6EE7B7]\" data-kid=\"2-2-3-2-1-1-1\" data-name=\"status label\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#34D399]\" data-kid=\"2-2-3-2-1-1-1-1\" data-name=\"status circle\">\n                            </span>\n                            Activo · Óptimo\n                        </div>\n                        <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[20px] font-bold tracking-[-0.035em] text-white\" data-kid=\"2-2-3-2-1-1-2\" data-name=\"vehicle model\">\n                            Mazda 3 2019\n                        </h2>\n                        <div class=\"mt-2 text-[13px] font-semibold tracking-[0.14em] text-[#CBD5E1]\" data-kid=\"2-2-3-2-1-1-3\" data-name=\"vehicle license plate\">\n                            H 731-204\n                        </div>\n                    </div>\n                    <i class=\"ti ti-car shrink-0 text-[20px] text-[#38BDF8]\" data-kid=\"2-2-3-2-1-2\" data-name=\"car icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n                <div class=\"mt-5 flex items-end justify-between gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-2-3-2-2\" data-name=\"secondary vehicle stats\">\n                    <div data-kid=\"2-2-3-2-2-1\" data-name=\"mileage section\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-3-2-2-1-1\" data-name=\"mileage label\">\n                            Kilometraje\n                        </div>\n                        <div class=\"mt-1 text-[17px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-3-2-2-1-2\" data-name=\"mileage value\">\n                            81,430\n                            <span class=\"text-[11px] font-medium text-[#94A3B8]\" data-kid=\"2-2-3-2-2-1-2-1\" data-name=\"mileage unit\">\n                                km\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"2-2-3-2-2-2\" data-name=\"last visit section\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-3-2-2-2-1\" data-name=\"last visit label\">\n                            Última visita\n                        </div>\n                        <div class=\"mt-1 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-3-2-2-2-2\" data-name=\"last visit date\">\n                            02 jun 2026\n                        </div>\n                    </div>\n                </div>\n                <button class=\"mt-4 flex min-h-11 items-center gap-2 text-left text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-3-2-3\" data-name=\"view link\">\n                    Ver ficha\n                    <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"2-2-3-2-3-1\" data-name=\"link arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </article>\n            <article class=\"rounded-[16px] border border-dashed border-[#334155] bg-[#141E36] p-4 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-3-3\" data-name=\"incomplete vehicle card\">\n                <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-2-3-3-1\" data-name=\"incomplete card header\">\n                    <div class=\"min-w-0\" data-kid=\"2-2-3-3-1-1\" data-name=\"incomplete title section\">\n                        <div class=\"mb-3 flex items-center gap-2 text-[11px] font-semibold text-[#FBBF24]\" data-kid=\"2-2-3-3-1-1-1\" data-name=\"incomplete status label\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#FBBF24]\" data-kid=\"2-2-3-3-1-1-1-1\" data-name=\"status circle\">\n                            </span>\n                            Sin datos recientes\n                        </div>\n                        <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[20px] font-bold tracking-[-0.035em] text-white\" data-kid=\"2-2-3-3-1-1-2\" data-name=\"vehicle model\">\n                            Renault Duster 2021\n                        </h2>\n                        <div class=\"mt-2 text-[13px] font-semibold tracking-[0.14em] text-[#CBD5E1]\" data-kid=\"2-2-3-3-1-1-3\" data-name=\"vehicle license plate\">\n                            J 204-118\n                        </div>\n                    </div>\n                    <i class=\"ti ti-file-alert shrink-0 text-[20px] text-[#FBBF24]\" data-kid=\"2-2-3-3-1-2\" data-name=\"warning icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n                <div class=\"mt-5 border-t border-[#334155] pt-4 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-3-3-2\" data-name=\"incomplete description\">\n                    Completa la ficha para activar recordatorios de kilometraje y vencimientos.\n                </div>\n                <button class=\"mt-4 flex min-h-11 items-center gap-2 text-left text-[12px] font-semibold text-[#FBBF24]\" data-kid=\"2-2-3-3-3\" data-name=\"complete ficha button\">\n                    Completar ficha\n                    <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"2-2-3-3-3-1\" data-name=\"link arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </article>\n        </section>\n        <div class=\"mt-6 border-t border-[#334155] pt-5\" data-kid=\"2-2-4\" data-name=\"alert prompt bar\">\n            <div class=\"flex items-start gap-3 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-4-1\" data-name=\"alert prompt message\">\n                <i class=\"ti ti-info-circle mt-0.5 shrink-0 text-[16px] text-[#38BDF8]\" data-kid=\"2-2-4-1-1\" data-name=\"info icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"2-2-4-1-2\" data-name=\"alert text\">\n                    ¿Tienes otro vehículo? Agrégalo para recibir alertas de mantenimiento.\n                </span>\n            </div>\n            <button class=\"mt-3 flex min-h-11 w-full items-center justify-between border border-[#475569] px-3 text-left text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-4-2\" data-name=\"manage alerts link\">\n                Administrar alertas\n                <i class=\"ti ti-arrow-up-right text-[14px]\" data-kid=\"2-2-4-2-1\" data-name=\"link arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n        <footer class=\"mt-7 flex flex-col gap-2 border-t border-[#334155] pt-4 text-[11px] text-[#64748B]\" data-kid=\"2-2-5\" data-name=\"page footer\">\n            <span data-kid=\"2-2-5-1\" data-name=\"copyright/brand name\">\n                AutoDoc · Diagnóstico y mantenimiento para tu vehículo\n            </span>\n            <span class=\"flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-2-5-2\" data-name=\"sync status section\" data-reason=\"sync status updated by script\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-5-2-1\" data-name=\"sync indicator icon\">\n                </span>\n                Datos sincronizados hace 4 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"safe-bottom fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/98 px-1 pt-2\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\">\n        <div class=\"grid grid-cols-5 gap-0.5\" data-kid=\"2-3-1\" data-name=\"bottom navigation destinations\">\n            <button aria-label=\"Inicio\" class=\"flex min-h-14 min-w-0 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" data-name=\"home navigation button\">\n                <i class=\"ti ti-home-2 text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"home icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"truncate text-[10px]\" data-kid=\"2-3-1-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </button>\n            <button aria-current=\"page\" aria-label=\"Mi garaje\" class=\"flex min-h-14 min-w-0 flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-3-1-2\" data-name=\"garage navigation button\">\n                <i class=\"ti ti-steering-wheel text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"garage icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"truncate text-[10px] font-semibold\" data-kid=\"2-3-1-2-2\" data-name=\"garage label\">\n                    Mi garaje\n                </span>\n            </button>\n            <button aria-label=\"Talleres\" class=\"flex min-h-14 min-w-0 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"workshops navigation button\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"truncate text-[10px]\" data-kid=\"2-3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </button>\n            <button aria-label=\"Alertas\" class=\"relative flex min-h-14 min-w-0 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-4\" data-name=\"alerts navigation button\">\n                <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"alerts icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"truncate text-[10px]\" data-kid=\"2-3-1-4-3\" data-name=\"alerts label\">\n                    Alertas\n                </span>\n                <span class=\"absolute right-[18%] top-1.5 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-3-1-4-2\" data-name=\"alerts notification indicator\">\n                </span>\n            </button>\n            <button aria-label=\"Historial\" class=\"flex min-h-14 min-w-0 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-5\" data-name=\"history navigation button\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"truncate text-[10px]\" data-kid=\"2-3-1-5-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </button>\n        </div>\n    </nav>\n</div>\n",
