      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"task config application shell\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"task config shell layout\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"primary icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary rail navigation\">\n                <button aria-label=\"Inicio\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"home navigation button\">\n                    <i class=\"ti ti-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Mi garaje\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"garage navigation button\">\n                    <i class=\"ti ti-car\" data-kid=\"2-1-1-2-2-1\" data-name=\"car icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"workshops navigation button\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-3-1\" data-name=\"tool icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Alertas\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-4\" data-name=\"alerts navigation button\">\n                    <i class=\"ti ti-bell-ringing\" data-kid=\"2-1-1-2-4-1\" data-name=\"ringing bell icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Historial\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-5\" data-name=\"history navigation button\">\n                    <i class=\"ti ti-history\" data-kid=\"2-1-1-2-5-1\" data-name=\"history icon\">\n                    </i>\n                </button>\n            </nav>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"utility rail navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help circle icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings icon\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"context sidebar\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"account context header\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"account type label\">\n                    Espacio personal\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"account status indicator\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"status dot\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"account role text\">\n                        Propietario\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación contextual\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"context navigation\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-1\" data-name=\"home link\" href=\"#\">\n                    <i class=\"ti ti-dashboard text-[17px]\" data-kid=\"2-1-2-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                    <span data-kid=\"2-1-2-2-1-2\" data-name=\"home label\">\n                        Inicio\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-2\" data-name=\"garage link\" href=\"#\">\n                    <i class=\"ti ti-car text-[17px]\" data-kid=\"2-1-2-2-2-1\" data-name=\"car icon\">\n                    </i>\n                    <span data-kid=\"2-1-2-2-2-2\" data-name=\"garage label\">\n                        Mi garaje\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-3\" data-name=\"workshops link\" href=\"#\">\n                    <i class=\"ti ti-tool text-[17px]\" data-kid=\"2-1-2-2-3-1\" data-name=\"tool icon\">\n                    </i>\n                    <span data-kid=\"2-1-2-2-3-2\" data-name=\"workshops label\">\n                        Talleres\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-2.5 text-[14px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-2-4\" data-name=\"alerts active link\" href=\"#\">\n                    <i class=\"ti ti-bell-ringing text-[17px]\" data-kid=\"2-1-2-2-4-1\" data-name=\"ringing bell icon\">\n                    </i>\n                    <span data-kid=\"2-1-2-2-4-2\" data-name=\"alerts label with count\">\n                        Alertas\n                        <span class=\"ml-1 text-[11px] font-bold text-[#EF4444]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-4-2-1\" data-name=\"alert count badge\" data-reason=\"value injected or updated by backend notification state\">\n                            1\n                        </span>\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-5\" data-name=\"history link\" href=\"#\">\n                    <i class=\"ti ti-history text-[17px]\" data-kid=\"2-1-2-2-5-1\" data-name=\"history icon\">\n                    </i>\n                    <span data-kid=\"2-1-2-2-5-2\" data-name=\"history label\">\n                        Historial\n                    </span>\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"profile summary\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\" data-name=\"user account summary\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3-1-1\" data-name=\"user initials avatar\">\n                        JP\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\" data-name=\"user name and type group\">\n                        <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-3-1-2-1\" data-name=\"user name\">\n                            Juan Pérez\n                        </p>\n                        <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\" data-name=\"account description\">\n                            Cuenta personal\n                        </p>\n                    </div>\n                    <i class=\"ti ti-chevron-down ml-auto text-[16px] text-[#94A3B8]\" data-kid=\"2-1-2-3-1-3\" data-name=\"expand chevron icon\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"2-1-3\" data-name=\"task config main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-white px-8\" data-kid=\"2-1-3-1\" data-name=\"top header\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumb navigation\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-1-3-1-1-1\" data-name=\"breadcrumb parent section\">\n                        Propietario\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-3-1-1-2\" data-name=\"breadcrumb separator\">\n                        /\n                    </span>\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-1-3\" data-name=\"breadcrumb current page\">\n                        Recordatorios\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-1-2\" data-name=\"header controls\">\n                    <span class=\"hidden text-[12px] text-[#64748B] lg:block\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-3\" data-name=\"current date display\" data-reason=\"date text rendered or updated by client-side script\">\n                        Sábado, 25 jul 2026\n                    </span>\n                    <button aria-label=\"Notificaciones\" class=\"relative grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-1\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-2-1-1\" data-name=\"bell icon\">\n                        </i>\n                        <span class=\"absolute right-[7px] top-[6px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-2\" data-name=\"notification unread indicator\" data-reason=\"visibility/presence toggled by script based on unread count\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-2\" data-name=\"theme toggle button\">\n                        <i class=\"ti ti-moon\" data-kid=\"2-1-3-1-2-2-1\" data-name=\"moon icon\">\n                        </i>\n                    </button>\n                    <div class=\"h-6 w-px bg-[#E2E8F0]\" data-kid=\"2-1-3-1-2-6\" data-name=\"header separator\">\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-1-2-7\" data-name=\"user profile area\">\n                        <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-1-2-7-1\" data-name=\"user initials avatar\">\n                            JP\n                        </div>\n                        <span class=\"hidden text-[13px] font-semibold text-[#0F172A] xl:block\" data-kid=\"2-1-3-1-2-7-2\" data-name=\"user name\">\n                            Juan Pérez\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[900px] px-8 py-8\" data-kid=\"2-1-3-2\" data-name=\"task config page body\">\n                <div class=\"mb-7\" data-kid=\"2-1-3-2-1\" data-name=\"page heading group\">\n                    <div class=\"flex items-start justify-between gap-6\" data-kid=\"2-1-3-2-1-3\" data-name=\"heading layout\">\n                        <div data-kid=\"2-1-3-2-1-3-1\" data-name=\"title description container\">\n                            <p class=\"mb-2 text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-3-2-1-3-1-1\" data-name=\"reminder context label\">\n                                Recordatorio de mantenimiento\n                            </p>\n                            <h1 class=\"font-heading text-[30px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-1-3-2-1-1\" data-name=\"page main heading\">\n                                Configurar recordatorio\n                            </h1>\n                            <p class=\"mt-2 text-[14px] text-[#475569]\" data-kid=\"2-1-3-2-1-3-1-3\" data-name=\"instructional description\">\n                                Define cuándo quieres volver a recibir esta alerta.\n                            </p>\n                        </div>\n                        <div class=\"hidden border-l-2 border-[#1E88E5] pl-4 text-right lg:block\" data-kid=\"2-1-3-2-1-2\" data-name=\"task context marker\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-3-2-1-2-1\" data-name=\"context type label\">\n                                Tarea\n                            </p>\n                            <p class=\"mt-1 font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-1-2-2\" data-name=\"task description name\">\n                                Cambio de aceite\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <section aria-labelledby=\"task-form-heading\" class=\"mx-auto max-w-[560px]\" data-kid=\"2-1-3-2-2\" data-name=\"task config form section\">\n                    <div class=\"mb-5 flex items-center gap-3 border-y border-[#CBD5E1] py-4\" data-kid=\"2-1-3-2-2-1\" data-name=\"task summary row\">\n                        <span class=\"grid size-10 place-items-center border border-[#BFDBFE] bg-[#EFF6FF] text-[19px] text-[#1E88E5]\" data-kid=\"2-1-3-2-2-1-1\" data-name=\"task icon container\">\n                            <i class=\"ti ti-tool\" data-kid=\"2-1-3-2-2-1-1-1\" data-name=\"tool icon\">\n                            </i>\n                        </span>\n                        <div class=\"min-w-0\" data-kid=\"2-1-3-2-2-1-2\" data-name=\"task details group\">\n                            <h2 class=\"font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-2-1-2-1\" data-name=\"task title\" id=\"task-form-heading\">\n                                Cambio de aceite\n                            </h2>\n                            <p class=\"mt-0.5 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-2-1-2-2\" data-name=\"task vehicle details\">\n                                Toyota Corolla 2022 · P 482-916 · 48,260 km\n                            </p>\n                        </div>\n                        <span class=\"ml-auto inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#F59E0B]\" data-kid=\"2-1-3-2-2-1-3\" data-name=\"task status badge\">\n                            <span class=\"size-2 rounded-full bg-[#F59E0B]\" data-kid=\"2-1-3-2-2-1-3-1\" data-name=\"status dot\">\n                            </span>\n                            Próximo\n                        </span>\n                    </div>\n                    <form class=\"space-y-5\" data-kid=\"2-1-3-2-2-2\" data-name=\"maintenance reminder form\">\n                        <div data-kid=\"2-1-3-2-2-2-1\" data-name=\"current mileage field\">\n                            <label class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-1-3-2-2-2-1-1\" data-name=\"mileage field label\" for=\"current-mileage\">\n                                Kilometraje actual\n                            </label>\n                            <div class=\"relative\" data-kid=\"2-1-3-2-2-2-1-2\" data-name=\"input container\">\n                                <input aria-label=\"Kilometraje actual\" class=\"w-full border border-[#CBD5E1] bg-white px-4 py-3 pr-12 text-[15px] font-semibold tabular-nums text-[#0F172A] outline-hidden placeholder:text-[#94A3B8] focus:border-[#1E88E5] focus:ring-3 focus:ring-[#DBEAFE]\" data-kid=\"2-1-3-2-2-2-1-2-1\" data-name=\"mileage input\" id=\"current-mileage\" value=\"48,260\"/>\n                                <span class=\"pointer-events-none absolute inset-y-0 right-4 flex items-center text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-3-2-2-2-1-2-2\" data-name=\"mileage unit suffix\">\n                                    km\n                                </span>\n                            </div>\n                        </div>\n                        <div data-kid=\"2-1-3-2-2-2-2\" data-name=\"frequency field\">\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-1-3-2-2-2-2-1\" data-name=\"frequency label container\">\n                                <label class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-1-3-2-2-2-2-1-1\" data-name=\"frequency field label\" for=\"frequency\">\n                                    Recordar cada\n                                </label>\n                                <span class=\"mb-2 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-2-1-2\" data-name=\"suggested distance text\">\n                                    Distancia sugerida: 10,000 km\n                                </span>\n                            </div>\n                            <div class=\"relative\" data-kid=\"2-1-3-2-2-2-2-2\" data-name=\"input container\">\n                                <input aria-label=\"Recordar cada\" class=\"w-full border-2 border-[#1E88E5] bg-white px-4 py-3 pr-12 text-[15px] font-semibold tabular-nums text-[#0F172A] outline-hidden ring-3 ring-[#DBEAFE]\" data-kid=\"2-1-3-2-2-2-2-2-1\" data-name=\"frequency input\" id=\"frequency\" value=\"10,000\"/>\n                                <span class=\"pointer-events-none absolute inset-y-0 right-4 flex items-center text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-3-2-2-2-2-2-2\" data-name=\"frequency unit suffix\">\n                                    km\n                                </span>\n                            </div>\n                            <p class=\"mt-2 flex items-start gap-2 text-[12px] font-medium text-[#B91C1C]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-2-2-3\" data-name=\"validation alert message\" data-reason=\"visibility/presence toggled by script on validation failure\" role=\"alert\">\n                                <i class=\"ti ti-alert-circle mt-0.5 text-[15px]\" data-kid=\"2-1-3-2-2-2-2-3-1\" data-name=\"alert circle icon\">\n                                </i>\n                                <span data-kid=\"2-1-3-2-2-2-2-3-2\" data-name=\"alert text\">\n                                    Usa un intervalo mayor a 0 km para activar el recordatorio.\n                                </span>\n                            </p>\n                        </div>\n                        <div data-kid=\"2-1-3-2-2-2-3\" data-name=\"next service date field\">\n                            <label class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-1-3-2-2-2-3-1\" data-name=\"date field label\" for=\"next-service\">\n                                Próxima revisión\n                            </label>\n                            <div class=\"relative\" data-kid=\"2-1-3-2-2-2-3-2\" data-name=\"input container\">\n                                <input aria-label=\"Próxima revisión\" class=\"w-full border border-[#CBD5E1] bg-white px-4 py-3 pl-11 text-[15px] font-semibold text-[#0F172A] outline-hidden focus:border-[#1E88E5] focus:ring-3 focus:ring-[#DBEAFE]\" data-kid=\"2-1-3-2-2-2-3-2-1\" data-name=\"date input\" id=\"next-service\" value=\"12 jun 2027\"/>\n                                <i class=\"ti ti-calendar-event pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[17px] text-[#1E88E5]\" data-kid=\"2-1-3-2-2-2-3-2-2\" data-name=\"calendar icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center justify-between border-y border-[#E2E8F0] py-4\" data-kid=\"2-1-3-2-2-2-4\" data-name=\"advance notification switch row\">\n                            <div data-kid=\"2-1-3-2-2-2-4-2\" data-name=\"switch labels container\">\n                                <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-2-2-4-2-1\" data-name=\"switch title\">\n                                    Avisarme con anticipación\n                                </p>\n                                <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-4-2-2\" data-name=\"switch description\">\n                                    Recibirás una alerta antes de la fecha calculada.\n                                </p>\n                            </div>\n                            <button aria-label=\"Avisarme con anticipación activado\" aria-pressed=\"true\" class=\"relative h-7 w-12 shrink-0 rounded-full bg-[#1E88E5]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-2-4-1\" data-name=\"advance notification switch\" data-reason=\"aria-pressed and styling updated by toggle script\" type=\"button\">\n                                <span class=\"absolute right-1 top-1 size-5 rounded-full bg-white shadow-[0_1px_2px_rgba(15,23,42,0.2)]\" data-kid=\"2-1-3-2-2-2-4-1-1\" data-name=\"switch toggle handle\">\n                                </span>\n                            </button>\n                        </div>\n                        <div class=\"flex items-start gap-3 border-l-4 border-[#10B981] bg-[#ECFDF5] px-4 py-3.5\" data-kid=\"2-1-3-2-2-2-5\" data-name=\"reminder calculation summary\">\n                            <i class=\"ti ti-bell-check mt-0.5 text-[18px] text-[#059669]\" data-kid=\"2-1-3-2-2-2-5-1\" data-name=\"bell check icon\">\n                            </i>\n                            <div data-kid=\"2-1-3-2-2-2-5-2\" data-name=\"summary text container\">\n                                <p class=\"text-[13px] font-semibold text-[#065F46]\" data-kid=\"2-1-3-2-2-2-5-2-1\" data-name=\"summary title\">\n                                    Recordatorio activo\n                                </p>\n                                <p class=\"mt-0.5 text-[12px] text-[#047857]\" data-kid=\"2-1-3-2-2-2-5-2-2\" data-name=\"summary detail text\">\n                                    Te avisaremos 500 km antes de la próxima revisión.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center justify-end gap-3 border-t border-[#CBD5E1] pt-5\" data-kid=\"2-1-3-2-2-2-6\" data-name=\"form actions\">\n                            <button class=\"min-h-12 border border-[#CBD5E1] bg-white px-5 text-[13px] font-semibold text-[#334155] hover:border-[#1E88E5] hover:text-[#1E88E5]\" data-kid=\"2-1-3-2-2-2-6-1\" data-name=\"cancel button\" type=\"button\">\n                                Cancelar\n                            </button>\n                            <button class=\"inline-flex min-h-12 items-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#45256E] px-5 py-3 text-[13px] font-bold text-white shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.97]\" data-kid=\"2-1-3-2-2-2-6-2\" data-name=\"save reminder button\" type=\"submit\">\n                                Guardar recordatorio\n                                <i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"2-1-3-2-2-2-6-2-1\" data-name=\"arrow right icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </form>\n                </section>\n                <footer class=\"mx-auto mt-7 flex max-w-[560px] items-center justify-between border-t border-[#E2E8F0] pt-4 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3\" data-name=\"task config footer\">\n                    <span data-kid=\"2-1-3-2-3-1\" data-name=\"copyright/section info\">\n                        AutoDoc · Recordatorios de mantenimiento\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-3-2\" data-name=\"sync status container\">\n                        <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-1-3-2-3-2-1\" data-name=\"sync status dot\">\n                        </span>\n                        Datos sincronizados hace 8 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
