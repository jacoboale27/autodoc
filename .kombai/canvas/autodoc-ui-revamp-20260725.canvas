      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component treatment\">\n    :root { --app-primary: #522C81; --app-surface-container: #EEEDF0; --app-outline: #CBD5E1; --app-on-primary: #FFFFFF; --app-shadow-sm: 0 2px 4px rgba(15,23,42,0.05); --app-shadow-hover: 0 6px 14px rgba(15,23,42,0.10); }\n  button { min-height: 48px; border-radius: 999px !important; transition: transform 150ms cubic-bezier(0.23,1,0.32,1), box-shadow 150ms cubic-bezier(0.23,1,0.32,1), background-color 150ms cubic-bezier(0.23,1,0.32,1), border-color 150ms cubic-bezier(0.23,1,0.32,1), color 150ms cubic-bezier(0.23,1,0.32,1); }\n  button:active { transform: scale(0.97); }\n  button:focus-visible { outline: 3px solid rgba(82,44,129,0.35); outline-offset: 2px; }\n  button[class*=\"bg-[#1E88E5]\"], button[class*=\"bg-[#38BDF8]\"] { background: var(--app-primary) !important; color: var(--app-on-primary) !important; box-shadow: var(--app-shadow-sm); }\n  button[class*=\"border-[#1E88E5]\"], button[class*=\"border-[#38BDF8]\"] { border-color: var(--app-primary) !important; color: var(--app-primary) !important; }\n  button[class*=\"bg-\"]:hover, button[class*=\"border-\"]:hover { box-shadow: var(--app-shadow-hover); }\n  button[aria-label] { min-width: 48px; min-height: 48px; padding: 0.75rem; border: 1px solid var(--app-outline) !important; background: var(--app-surface-container) !important; box-shadow: var(--app-shadow-sm); }\n  main section { border: 1px solid rgba(203,213,225,0.70); border-radius: 16px; background: var(--app-surface-container); box-shadow: var(--app-shadow-sm); overflow: hidden; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"pending approval page\">\n    <header class=\"flex items-center justify-between border-b border-[#E2E8F0] bg-white px-8 py-5\" data-kid=\"2-1\" data-name=\"pending page header\">\n        <div class=\"flex items-center gap-3\" data-kid=\"2-1-1\" data-name=\"AutoDoc brand lockup\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 place-items-center rounded-[11px] bg-[#1E88E5] text-[17px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo mark\">\n                AD\n            </div>\n            <div data-kid=\"2-1-1-2\" data-name=\"brand wordmark group\">\n                <div class=\"font-heading text-[16px] font-extrabold tracking-[-0.04em] text-[#0F172A]\" data-kid=\"2-1-1-2-1\" data-name=\"brand name AutoDoc\">\n                    AutoDoc\n                </div>\n                <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-1-2-2\" data-name=\"brand tagline text\">\n                    Gestión vehicular segura\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-1-2\" data-name=\"page context label\">\n            <i aria-hidden=\"true\" class=\"ti ti-shield-check text-[16px] text-[#10B981]\" data-kid=\"2-1-2-1\" data-name=\"shield check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            Acceso protegido\n        </div>\n    </header>\n    <main class=\"mx-auto flex min-h-[calc(100vh-82px)] w-full max-w-[560px] items-start justify-center px-5 py-12 sm:py-16\" data-kid=\"2-2\" data-name=\"pending approval content wrapper\">\n        <section aria-labelledby=\"pending-title\" class=\"w-full max-w-[480px] border border-[#CBD5E1] bg-white px-6 py-8 shadow-[0_12px_30px_rgba(15,23,42,0.06)] sm:px-9 sm:py-10\" data-kid=\"2-2-1\" data-name=\"pending approval panel\">\n            <div class=\"flex flex-col items-center text-center\" data-kid=\"2-2-1-1\" data-name=\"pending status intro\">\n                <div class=\"grid size-[76px] place-items-center border-2 border-[#BFDBFE] bg-[#E8F2FD] text-[#1E88E5]\" data-kid=\"2-2-1-1-1\" data-name=\"pending status icon wrapper\">\n                    <i aria-label=\"Solicitud en revisión\" class=\"ti ti-clock-hour-4 text-[36px]\" data-kid=\"2-2-1-1-1-1\" data-name=\"clock hour icon\" style=\"width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n                <div class=\"mt-6 inline-flex items-center gap-2 border border-[#FCD34D] bg-[#FFFBEB] px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.12em] text-[#92400E]\" data-kid=\"2-2-1-1-2\" data-name=\"pending status badge\">\n                    <span aria-hidden=\"true\" class=\"size-2 rounded-full bg-[#F59E0B]\" data-kid=\"2-2-1-1-2-1\" data-name=\"status indicator dot\">\n                    </span>\n                    Solicitud enviada\n                </div>\n                <h1 class=\"mt-5 font-heading text-[27px] font-extrabold leading-[1.14] tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-1-3\" data-name=\"pending approval heading\" id=\"pending-title\">\n                    Tu taller está pendiente de aprobación\n                </h1>\n                <p class=\"mt-4 max-w-[390px] text-[15px] leading-6 text-[#475569]\" data-kid=\"2-2-1-1-4\" data-name=\"pending approval description\">\n                    Revisaremos la información y te avisaremos cuando puedas empezar a gestionar servicios.\n                </p>\n            </div>\n            <div class=\"mt-8 border-y border-[#E2E8F0] py-6\" data-kid=\"2-2-1-2\" data-name=\"approval progress section\">\n                <div class=\"flex items-center justify-between text-left\" data-kid=\"2-2-1-2-1\" data-name=\"approval progress steps\">\n                    <div class=\"flex w-[74px] flex-col items-center gap-2\" data-kid=\"2-2-1-2-1-1\" data-name=\"submitted step\">\n                        <div class=\"grid size-9 place-items-center rounded-full bg-[#1E88E5] text-white\" data-kid=\"2-2-1-2-1-1-1\" data-name=\"submitted step marker\">\n                            <i aria-hidden=\"true\" class=\"ti ti-check text-[18px]\" data-kid=\"2-2-1-2-1-1-1-1\" data-name=\"check icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <span class=\"text-center text-[11px] font-semibold leading-4 text-[#1E88E5]\" data-kid=\"2-2-1-2-1-1-2\" data-name=\"submitted step label\">\n                            Enviada\n                        </span>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"mb-6 h-px flex-1 bg-[#1E88E5]\" data-kid=\"2-2-1-2-1-4\" data-name=\"submitted to in-review progress line\">\n                    </div>\n                    <div class=\"flex w-[82px] flex-col items-center gap-2\" data-kid=\"2-2-1-2-1-2\" data-name=\"in review step\">\n                        <div class=\"grid size-9 place-items-center rounded-full border-2 border-[#F59E0B] bg-[#FFFBEB] text-[#B45309]\" data-kid=\"2-2-1-2-1-2-1\" data-name=\"in review step marker\">\n                            <i aria-hidden=\"true\" class=\"ti ti-clock-hour-4 text-[17px]\" data-kid=\"2-2-1-2-1-2-1-1\" data-name=\"clock hour icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <span class=\"text-center text-[11px] font-semibold leading-4 text-[#92400E]\" data-kid=\"2-2-1-2-1-2-2\" data-name=\"in review step label\">\n                            En revisión\n                        </span>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"mb-6 h-px flex-1 bg-[#CBD5E1]\" data-kid=\"2-2-1-2-1-6\" data-name=\"in-review to approved progress line\">\n                    </div>\n                    <div class=\"flex w-[74px] flex-col items-center gap-2\" data-kid=\"2-2-1-2-1-3\" data-name=\"approved step\">\n                        <div class=\"grid size-9 place-items-center rounded-full border border-[#CBD5E1] bg-[#F8FAFC] text-[#94A3B8]\" data-kid=\"2-2-1-2-1-3-1\" data-name=\"approved step marker\">\n                            <i aria-hidden=\"true\" class=\"ti ti-shield-check text-[17px]\" data-kid=\"2-2-1-2-1-3-1-1\" data-name=\"shield check icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <span class=\"text-center text-[11px] font-semibold leading-4 text-[#64748B]\" data-kid=\"2-2-1-2-1-3-2\" data-name=\"approved step label\">\n                            Aprobada\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-6 flex items-center justify-between text-[12px]\" data-kid=\"2-2-1-2-2\" data-name=\"request metadata row\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-2-1-2-2-1\" data-name=\"request date label\">\n                        Fecha de solicitud\n                    </span>\n                    <span class=\"font-semibold tabular-nums text-[#0F172A]\" data-kid=\"2-2-1-2-2-2\" data-name=\"request date value\">\n                        Enviada hoy\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-6 border-l-4 border-[#1E88E5] bg-[#F8FAFC] px-4 py-3.5\" data-kid=\"2-2-1-3\" data-name=\"approval reassurance note\">\n                <div class=\"flex items-start gap-3\" data-kid=\"2-2-1-3-1\" data-name=\"reassurance note content group\">\n                    <i aria-hidden=\"true\" class=\"ti ti-info-circle mt-0.5 text-[18px] text-[#1E88E5]\" data-kid=\"2-2-1-3-1-1\" data-name=\"info circle icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <p class=\"text-[12px] leading-5 text-[#475569]\" data-kid=\"2-2-1-3-1-2\" data-name=\"reassurance text\">\n                        Te notificaremos por correo y en la aplicación cuando cambie el estado de tu solicitud.\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-7 flex flex-col gap-3\" data-kid=\"2-2-1-4\" data-name=\"pending approval actions\">\n                <button aria-label=\"Verificar estado de aprobación\" class=\"inline-flex min-h-[52px] items-center justify-center gap-2 bg-[#1E88E5] px-5 text-[14px] font-bold text-white hover:bg-[#176FBB]\" data-kid=\"2-2-1-4-1\" data-name=\"check approval status button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-refresh text-[18px]\" data-kid=\"2-2-1-4-1-1\" data-name=\"refresh icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Verificar estado\n                </button>\n                <button aria-label=\"Contactar soporte de AutoDoc\" class=\"inline-flex min-h-[52px] items-center justify-center gap-2 border border-[#CBD5E1] bg-white px-5 text-[14px] font-semibold text-[#1E293B] hover:border-[#1E88E5] hover:text-[#1E88E5]\" data-kid=\"2-2-1-4-2\" data-name=\"contact support button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-headset text-[18px] text-[#1E88E5]\" data-kid=\"2-2-1-4-2-1\" data-name=\"headset icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Contactar soporte\n                </button>\n            </div>\n            <div class=\"mt-6 text-center\" data-kid=\"2-2-1-5\" data-name=\"logout action\">\n                <button aria-label=\"Cerrar sesión\" class=\"inline-flex min-h-[48px] items-center justify-center gap-2 px-4 text-[13px] font-semibold text-[#64748B] hover:text-[#0F172A]\" data-kid=\"2-2-1-5-1\" data-name=\"sign out button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-logout-2 text-[16px]\" data-kid=\"2-2-1-5-1-1\" data-name=\"logout icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Cerrar sesión\n                </button>\n            </div>\n        </section>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-08-15T15:43:59.867918+00:00",
      "modified": "2026-08-17T21:00:34.781921+00:00",
