    "var_116f7db1e976": {
      "type": "variant",
      "label": "AutoDoc Notifications — Hadrian Dark Mobile",
      "parentId": "var_9efa2b7c2f7d",
      "themeId": null,
      "rect": {
        "x": 92275,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    [data-name=\"change theme button\"], [data-name=\"user profile button\"] { min-width:44px; min-height:44px; border-radius:999px; border:1px solid #334155; background:#141E36; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"change theme button\"]:hover, [data-name=\"user profile button\"]:hover { background:#1E293B; color:#81E6D9; box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"change theme button\"]:active, [data-name=\"user profile button\"]:active { transform:scale(.97); }\n  [data-name=\"mark all as read button\"] { min-height:48px; border:0; border-radius:999px; background:linear-gradient(135deg,#81E6D9,#6FC8BC); color:#0F172A; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"mark all as read button\"]:hover { transform:scale(1.02); box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"mark all as read button\"]:active { transform:scale(.97); }\n  [data-name=\"today notification list\"], [data-name=\"previous notification list\"] { overflow:hidden; border:1px solid rgba(51,65,85,.2); border-radius:16px; background:#141E36; box-shadow:0 2px 4px rgba(0,0,0,.2); }\n  [data-name*=\"open\"][data-name*=\"notification button\"] { min-width:44px; min-height:44px; border:1px solid #334155; border-radius:999px; background:#141E36; transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name*=\"open\"][data-name*=\"notification button\"]:hover { background:#1E293B; color:#81E6D9; box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name*=\"open\"][data-name*=\"notification button\"]:active { transform:scale(.97); }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"mobile notifications application root\">\n    <header class=\"sticky top-0 z-20 border-b border-[#334155] bg-[#0B1220]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"compact mobile top bar\">\n        <div class=\"flex min-h-[44px] items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"top bar container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"brand logo and user type section\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-[#082F49] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc brand initials\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"user role and section title\">\n                    <div class=\"truncate text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"user role label\">\n                        Propietario\n                    </div>\n                    <div class=\"mt-0.5 truncate font-heading text-[15px] font-bold tracking-[-0.03em] text-white\" data-kid=\"2-1-1-1-2-2\" data-name=\"section title\">\n                        Notificaciones\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"user account and theme actions\">\n                <button aria-label=\"Cambiar tema\" class=\"flex h-11 w-11 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"change theme button\">\n                    <i class=\"ti ti-sun-moon text-[18px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"sun-moon icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Perfil de Juan Pérez\" class=\"flex h-11 w-11 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-1-2-2\" data-name=\"user profile button\">\n                    JP\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-32 pt-6\" data-kid=\"2-2\" data-name=\"mobile notifications content\">\n        <div class=\"border-b border-[#334155] pb-6\" data-kid=\"2-2-1\" data-name=\"mobile notifications title row\">\n            <div data-kid=\"2-2-1-1\" data-name=\"title and subtitle container\">\n                <h1 class=\"font-heading text-[27px] font-extrabold leading-tight tracking-[-0.045em] text-white\" data-kid=\"2-2-1-1-1\" data-name=\"page main headline\">\n                    Notificaciones\n                </h1>\n                <p class=\"mt-2 text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-1-2\" data-name=\"page description text\">\n                    Mantente al día con el estado de tus vehículos y servicios.\n                </p>\n            </div>\n            <button class=\"mt-5 flex min-h-[44px] w-full items-center justify-center gap-2 border border-[#475569] px-4 py-2.5 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-1-2\" data-name=\"mark all as read button\">\n                <i class=\"ti ti-checks text-[16px] text-[#38BDF8]\" data-kid=\"2-2-1-2-1\" data-name=\"checkmark icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Marcar todas como leídas\n            </button>\n        </div>\n        <div class=\"border-b border-[#334155] py-4\" data-kid=\"2-2-2\" data-name=\"mobile notification filters\">\n            <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-2-1\" data-name=\"notification type filter tabs\">\n                <div class=\"flex items-center gap-5 text-[12px]\" data-kid=\"2-2-2-1-1\" data-name=\"notification count tabs\">\n                    <button class=\"min-h-[44px] border-b-2 border-[#38BDF8] pb-2 font-semibold text-white\" data-kid=\"2-2-2-1-1-1\" data-name=\"all notifications tab\">\n                        Todas\n                        <span class=\"ml-1 tabular-nums text-[#38BDF8]\" data-dynamic=\"true\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"all notifications count\" data-reason=\"count updated by script\">\n                            5\n                        </span>\n                    </button>\n                    <button class=\"min-h-[44px] pb-2 font-medium text-[#94A3B8]\" data-kid=\"2-2-2-1-1-2\" data-name=\"unread notifications tab\">\n                        No leídas\n                        <span class=\"ml-1 rounded-[4px] bg-[#7F1D1D] px-1.5 py-0.5 text-[10px] font-bold text-[#FCA5A5]\" data-dynamic=\"true\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"unread notifications count\" data-reason=\"count updated by script\">\n                            2\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <div class=\"mt-2 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2\" data-name=\"auto-update status indicator\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-2-2-1\" data-name=\"online status dot\">\n                </span>\n                Actualización automática activa\n            </div>\n        </div>\n        <section aria-labelledby=\"today-heading-mobile\" class=\"pt-6\" data-kid=\"2-2-3\" data-name=\"today notifications section\">\n            <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"2-2-3-1\" data-name=\"section header\">\n                <h2 class=\"font-heading text-[17px] font-bold text-white\" data-kid=\"2-2-3-1-1\" data-name=\"today section heading\" id=\"today-heading-mobile\">\n                    Hoy\n                </h2>\n                <span class=\"text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-3-1-2\" data-name=\"today section notification count\" data-reason=\"count updated by script\">\n                    3 novedades\n                </span>\n            </div>\n            <div class=\"border-y border-[#334155]\" data-kid=\"2-2-3-2\" data-name=\"today notification list\">\n                <div class=\"flex items-start gap-3 border-b border-[#334155] border-l-2 border-l-[#F87171] bg-[#16202F] px-3 py-4\" data-kid=\"2-2-3-2-1\" data-name=\"unread SOAT notification\">\n                    <div class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#F87171]/40 bg-[#3F1D25] text-[#FCA5A5]\" data-kid=\"2-2-3-2-1-1\" data-name=\"SOAT notification icon wrapper\">\n                        <i class=\"ti ti-shield-exclamation text-[18px]\" data-kid=\"2-2-3-2-1-1-1\" data-name=\"shield exclamation icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-3-2-1-2\" data-name=\"SOAT notification details\">\n                        <div class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-3-2-1-2-1\" data-name=\"SOAT header container\">\n                            <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"2-2-3-2-1-2-1-1\" data-name=\"SOAT notification title\">\n                                <h3 class=\"truncate text-[13px] font-semibold text-white\" data-kid=\"2-2-3-2-1-2-1-1-1\">\n                                    SOAT vencido\n                                </h3>\n                                <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#F87171]\" data-kid=\"2-2-3-2-1-2-1-1-2\" data-name=\"unread status dot\">\n                                </span>\n                            </div>\n                            <time class=\"shrink-0 text-[10px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-3-2-1-2-1-2\" data-name=\"SOAT notification time\" data-reason=\"relative time stamp updated by script\">\n                                Hace 8 min\n                            </time>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-3-2-1-2-2\" data-name=\"SOAT notification vehicle info\">\n                            Toyota Corolla 2022 · P 482-916\n                        </p>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[#CBD5E1]\" data-kid=\"2-2-3-2-1-2-3\" data-name=\"SOAT notification message\">\n                            Renueva la cobertura para mantener tu vehículo en regla.\n                        </p>\n                    </div>\n                    <button aria-label=\"Abrir notificación SOAT vencido\" class=\"mt-[-6px] flex h-11 w-11 shrink-0 items-center justify-center text-[#64748B]\" data-kid=\"2-2-3-2-1-3\" data-name=\"open SOAT notification button\">\n                        <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-2-3-2-1-3-1\" data-name=\"chevron icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"flex items-start gap-3 border-b border-[#334155] border-l-2 border-l-[#FBBF24] bg-[#16202F] px-3 py-4\" data-kid=\"2-2-3-2-2\" data-name=\"unread brake notification\">\n                    <div class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#FBBF24]/40 bg-[#3B2A0E] text-[#FCD34D]\" data-kid=\"2-2-3-2-2-1\" data-name=\"brake notification icon wrapper\">\n                        <i class=\"ti ti-tool text-[18px]\" data-kid=\"2-2-3-2-2-1-1\" data-name=\"tool icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-3-2-2-2\" data-name=\"brake notification details\">\n                        <div class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-3-2-2-2-1\" data-name=\"brake header container\">\n                            <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"2-2-3-2-2-2-1-1\" data-name=\"brake notification title\">\n                                <h3 class=\"truncate text-[13px] font-semibold text-white\" data-kid=\"2-2-3-2-2-2-1-1-1\">\n                                    Pastillas próximas\n                                </h3>\n                                <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#FBBF24]\" data-kid=\"2-2-3-2-2-2-1-1-2\" data-name=\"unread status dot\">\n                                </span>\n                            </div>\n                            <time class=\"shrink-0 text-[10px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-3-2-2-2-1-2\" data-name=\"brake notification time\" data-reason=\"relative time stamp updated by script\">\n                                Hace 32 min\n                            </time>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-3-2-2-2-2\" data-name=\"brake notification vehicle info\">\n                            Toyota Corolla 2022 · revisión preventiva\n                        </p>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[#CBD5E1]\" data-kid=\"2-2-3-2-2-2-3\" data-name=\"brake notification message\">\n                            Revisión recomendada en\n                            <strong class=\"font-semibold text-white tabular-nums\" data-kid=\"2-2-3-2-2-2-3-1\" data-name=\"brake warning mileage value\">\n                                420 km\n                            </strong>\n                            .\n                        </p>\n                    </div>\n                    <button aria-label=\"Abrir notificación Pastillas próximas\" class=\"mt-[-6px] flex h-11 w-11 shrink-0 items-center justify-center text-[#64748B]\" data-kid=\"2-2-3-2-2-3\" data-name=\"open brake notification button\">\n                        <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-2-3-2-2-3-1\" data-name=\"chevron icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"flex items-start gap-3 px-3 py-4\" data-kid=\"2-2-3-2-3\" data-name=\"read reservation notification\">\n                    <div class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#34D399]/40 bg-[#064E3B]/30 text-[#6EE7B7]\" data-kid=\"2-2-3-2-3-1\" data-name=\"reservation icon wrapper\">\n                        <i class=\"ti ti-calendar-check text-[18px]\" data-kid=\"2-2-3-2-3-1-1\" data-name=\"calendar check icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-3-2-3-2\" data-name=\"reservation notification details\">\n                        <div class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-3-2-3-2-1\" data-name=\"reservation header container\">\n                            <h3 class=\"min-w-0 truncate text-[13px] font-medium text-[#E2E8F0]\" data-kid=\"2-2-3-2-3-2-1-1\" data-name=\"reservation notification title\">\n                                Reserva confirmada\n                            </h3>\n                            <time class=\"shrink-0 text-[10px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-3-2-3-2-1-2\" data-name=\"reservation notification time\" data-reason=\"relative time stamp updated by script\">\n                                Hace 1 h\n                            </time>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-3-2-3-2-2\" data-name=\"reservation vehicle/date info\">\n                            Taller Rápido · mañana, 10:00\n                        </p>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[#CBD5E1]\" data-kid=\"2-2-3-2-3-2-3\" data-name=\"reservation message\">\n                            Cambio de aceite confirmado para tu Toyota Corolla.\n                        </p>\n                    </div>\n                    <button aria-label=\"Abrir reserva confirmada\" class=\"mt-[-6px] flex h-11 w-11 shrink-0 items-center justify-center text-[#64748B]\" data-kid=\"2-2-3-2-3-3\" data-name=\"open reservation notification button\">\n                        <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-2-3-2-3-3-1\" data-name=\"chevron icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"previous-heading-mobile\" class=\"pt-6\" data-kid=\"2-2-4\" data-name=\"previous notifications section\">\n            <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"2-2-4-1\" data-name=\"previous notifications header\">\n                <h2 class=\"font-heading text-[17px] font-bold text-white\" data-kid=\"2-2-4-1-1\" data-name=\"previous section heading\" id=\"previous-heading-mobile\">\n                    Anteriores\n                </h2>\n                <span class=\"text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-4-1-2\" data-name=\"previous section count\" data-reason=\"count updated by script\">\n                    2 notificaciones\n                </span>\n            </div>\n            <div class=\"border-y border-[#334155]\" data-kid=\"2-2-4-2\" data-name=\"previous notification list\">\n                <div class=\"flex items-start gap-3 border-b border-[#334155] px-3 py-4\" data-kid=\"2-2-4-2-1\" data-name=\"read review notification\">\n                    <div class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#FBBF24]/40 bg-[#3B2A0E] text-[#FCD34D]\" data-kid=\"2-2-4-2-1-1\" data-name=\"review icon wrapper\">\n                        <i class=\"ti ti-star text-[18px]\" data-kid=\"2-2-4-2-1-1-1\" data-name=\"star icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-4-2-1-2\" data-name=\"review notification details\">\n                        <div class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-4-2-1-2-1\" data-name=\"review header container\">\n                            <h3 class=\"min-w-0 truncate text-[13px] font-medium text-[#E2E8F0]\" data-kid=\"2-2-4-2-1-2-1-1\" data-name=\"review notification title\">\n                                Reseña recibida\n                            </h3>\n                            <time class=\"shrink-0 text-[10px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-4-2-1-2-1-2\" data-name=\"review notification time\" data-reason=\"relative time stamp updated by script\">\n                                Ayer\n                            </time>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-4-2-1-2-2\" data-name=\"review vehicle info\">\n                            MotorLab · servicio del 02 jun 2026\n                        </p>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[#CBD5E1]\" data-kid=\"2-2-4-2-1-2-3\" data-name=\"review message\">\n                            Gracias por valorar la atención de tu taller.\n                        </p>\n                    </div>\n                    <button aria-label=\"Abrir reseña recibida\" class=\"mt-[-6px] flex h-11 w-11 shrink-0 items-center justify-center text-[#64748B]\" data-kid=\"2-2-4-2-1-3\" data-name=\"open review notification button\">\n                        <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-2-4-2-1-3-1\" data-name=\"chevron icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"flex items-start gap-3 px-3 py-4\" data-kid=\"2-2-4-2-2\" data-name=\"read service notification\">\n                    <div class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#38BDF8]/40 bg-[#075985]/30 text-[#7DD3FC]\" data-kid=\"2-2-4-2-2-1\" data-name=\"service icon wrapper\">\n                        <i class=\"ti ti-file-check text-[18px]\" data-kid=\"2-2-4-2-2-1-1\" data-name=\"file check icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-4-2-2-2\" data-name=\"service notification details\">\n                        <div class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-4-2-2-2-1\" data-name=\"service header container\">\n                            <h3 class=\"min-w-0 truncate text-[13px] font-medium text-[#E2E8F0]\" data-kid=\"2-2-4-2-2-2-1-1\" data-name=\"service notification title\">\n                                Servicio completado\n                            </h3>\n                            <time class=\"shrink-0 text-[10px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-4-2-2-2-1-2\" data-name=\"service notification time\" data-reason=\"relative time stamp updated by script\">\n                                Hace 2 días\n                            </time>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-4-2-2-2-2\" data-name=\"service notification title\">\n                            Cambio de aceite · Taller Rápido\n                        </p>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[#CBD5E1]\" data-kid=\"2-2-4-2-2-2-3\" data-name=\"service notification message\">\n                            El historial de tu vehículo fue actualizado.\n                        </p>\n                    </div>\n                    <button aria-label=\"Abrir servicio completado\" class=\"mt-[-6px] flex h-11 w-11 shrink-0 items-center justify-center text-[#64748B]\" data-kid=\"2-2-4-2-2-3\" data-name=\"open service notification button\">\n                        <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-2-4-2-2-3-1\" data-name=\"chevron icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <div class=\"mt-6 flex items-center gap-3 border-t border-[#334155] pt-5 text-[12px] text-[#64748B]\" data-kid=\"2-2-5\" data-name=\"contextual empty state\">\n            <i class=\"ti ti-bell-off text-[16px]\" data-kid=\"2-2-5-1\" data-name=\"bell off icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span data-kid=\"2-2-5-2\" data-name=\"empty state message\">\n                No hay más notificaciones en este periodo.\n            </span>\n        </div>\n        <footer class=\"mt-7 flex flex-col gap-2 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"notifications sync footer\">\n            <span data-kid=\"2-2-6-1\" data-name=\"AutoDoc footer brand\">\n                AutoDoc · Centro de notificaciones\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-2-6-2\" data-name=\"sync status indicator\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-6-2-1\" data-name=\"sync status dot\">\n                </span>\n                Sincronizado hace 2 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación móvil\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/98 px-2 pb-[env(safe-area-inset-bottom)] pt-2\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-5 gap-1\" data-kid=\"2-3-1\" data-name=\"bottom nav container\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-1\" data-name=\"nav home link\" href=\"#inicio\">\n                <i class=\"ti ti-home-2 text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"home icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-2\" data-name=\"nav garage link\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"car icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"garage label\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-3\" data-name=\"nav talleres link\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"tool icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"talleres label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Notificaciones\" class=\"relative flex min-h-[52px] flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] text-[#38BDF8]\" data-kid=\"2-3-1-4\" data-name=\"nav notifications link\" href=\"#notificaciones\">\n                <i class=\"ti ti-bell text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-4-2\" data-name=\"notifications label\">\n                    Alertas\n                </span>\n                <span class=\"absolute right-[14px] top-[5px] h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-3-1-4-3\" data-name=\"unread notification dot\">\n                </span>\n            </a>\n            <a aria-label=\"Historial\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-5\" data-name=\"nav historial link\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-5-2\" data-name=\"historial label\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
