             Todos\n                        </button>\n                        <button class=\"min-h-[44px] rounded-full border border-[var(--outline)] bg-[var(--surface-container)] px-4 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-2-2\">\n                            Pendientes\n                        </button>\n                        <button class=\"min-h-[44px] rounded-full border border-[var(--outline)] bg-[var(--surface-container)] px-4 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-2-3\">\n                            Aprobados\n                        </button>\n                        <button class=\"min-h-[44px] rounded-full border border-[var(--outline)] bg-[var(--surface-container)] px-4 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-2-4\">\n                            Suspendidos\n                        </button>\n                    </div>\n                    <div class=\"grid grid-cols-3 gap-4\" data-kid=\"1-1-3-2-4-3\">\n                        <article class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-5 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-1-3-2-4-3-1\" data-name=\"formal workshop admin card\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-3-2-4-3-1-1\">\n                                <div data-kid=\"1-1-3-2-4-3-1-1-1\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-2-4-3-1-1-1-1\">\n                                        <i class=\"ti ti-building-store text-[20px] text-[var(--primary)]\" data-kid=\"1-1-3-2-4-3-1-1-1-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        <h3 class=\"font-heading text-[17px] font-bold text-[var(--text-primary)]\" data-kid=\"1-1-3-2-4-3-1-1-1-1-2\">\n                                            Taller Rápido\n                                        </h3>\n                                    </div>\n                                    <span class=\"mt-3 inline-flex rounded-full bg-[var(--warning-surface)] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[var(--warning)]\" data-kid=\"1-1-3-2-4-3-1-1-1-2\">\n                                        <i class=\"ti ti-clock mr-1\" data-kid=\"1-1-3-2-4-3-1-1-1-2-1\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        PENDIENTE\n                                    </span>\n                                </div>\n                                <button aria-label=\"Más opciones de Taller Rápido\" class=\"flex size-11 items-center justify-center rounded-full border border-[var(--outline)] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-3-1-1-2\">\n                                    <i class=\"ti ti-dots\" data-kid=\"1-1-3-2-4-3-1-1-2-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </button>\n                            </div>\n                            <div class=\"mt-4 space-y-2 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-3-1-2\">\n                                <p data-kid=\"1-1-3-2-4-3-1-2-1\">\n                                    <i class=\"ti ti-tool mr-2 text-[var(--primary)]\" data-kid=\"1-1-3-2-4-3-1-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    Mantenimiento general\n                                </p>\n                                <p data-kid=\"1-1-3-2-4-3-1-2-2\">\n                                    <i class=\"ti ti-map-pin mr-2 text-[var(--primary)]\" data-kid=\"1-1-3-2-4-3-1-2-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    San Salvador · 2222-0101\n                                </p>\n                            </div>\n                            <div class=\"mt-5 flex gap-2 border-t border-[var(--outline)] pt-4\" data-kid=\"1-1-3-2-4-3-1-3\">\n                                <button class=\"min-h-[48px] flex-1 rounded-full border border-[var(--error)] px-3 text-[11px] font-bold text-[var(--error)]\" data-kid=\"1-1-3-2-4-3-1-3-1\">\n                                    Rechazar\n                                </button>\n                                <button class=\"min-h-[48px] flex-1 rounded-full bg-[var(--success)] px-3 text-[11px] font-bold text-[var(--on-primary)]\" data-kid=\"1-1-3-2-4-3-1-3-2\">\n                                    Aprobar Taller\n                                </button>\n                            </div>\n                        </article>\n                        <article class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-5 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-1-3-2-4-3-2\" data-name=\"formal workshop admin card\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-3-2-4-3-2-1\">\n                                <div data-kid=\"1-1-3-2-4-3-2-1-1\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-2-4-3-2-1-1-1\">\n                                        <i class=\"ti ti-building-store text-[20px] text-[var(--primary)]\" data-kid=\"1-1-3-2-4-3-2-1-1-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        <h3 class=\"font-heading text-[17px] font-bold text-[var(--text-primary)]\" data-kid=\"1-1-3-2-4-3-2-1-1-1-2\">\n                                            MotorLab\n                                        </h3>\n                                    </div>\n                                    <span class=\"mt-3 inline-flex rounded-full bg-[var(--success-surface)] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[var(--success)]\" data-kid=\"1-1-3-2-4-3-2-1-1-2\">\n                                        <i class=\"ti ti-circle-check mr-1\" data-kid=\"1-1-3-2-4-3-2-1-1-2-1\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        APROBADO\n                                    </span>\n                                </div>\n                                <button aria-label=\"Más opciones de MotorLab\" class=\"flex size-11 items-center justify-center rounded-full border border-[var(--outline)] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-3-2-1-2\">\n                                    <i class=\"ti ti-dots\" data-kid=\"1-1-3-2-4-3-2-1-2-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </button>\n                            </div>\n                            <div class=\"mt-4 space-y-2 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-3-2-2\">\n                                <p data-kid=\"1-1-3-2-4-3-2-2-1\">\n                                    <i class=\"ti ti-tool mr-2 text-[var(--primary)]\" data-kid=\"1-1-3-2-4-3-2-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    Diagnóstico y frenos\n                                </p>\n                                <p data-kid=\"1-1-3-2-4-3-2-2-2\">\n                                    <i class=\"ti ti-map-pin mr-2 text-[var(--primary)]\" data-kid=\"1-1-3-2-4-3-2-2-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    Santa Tecla · 2222-0144\n                                </p>\n                            </div>\n                            <div class=\"mt-5 flex border-t border-[var(--outline)] pt-4\" data-kid=\"1-1-3-2-4-3-2-3\">\n                                <button class=\"min-h-[48px] w-full rounded-full border border-[var(--error)] px-3 text-[11px] font-bold text-[var(--error)]\" data-kid=\"1-1-3-2-4-3-2-3-1\">\n                                    <i class=\"ti ti-ban mr-1\" data-kid=\"1-1-3-2-4-3-2-3-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    Suspender\n                                </button>\n                            </div>\n                        </article>\n                        <article class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-5 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-1-3-2-4-3-3\" data-name=\"formal workshop admin card\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-3-2-4-3-3-1\">\n                                <div data-kid=\"1-1-3-2-4-3-3-1-1\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-2-4-3-3-1-1-1\">\n                                        <i class=\"ti ti-building-store text-[20px] text-[var(--primary)]\" data-kid=\"1-1-3-2-4-3-3-1-1-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        <h3 class=\"font-heading text-[17px] font-bold text-[var(--text-primary)]\" data-kid=\"1-1-3-2-4-3-3-1-1-1-2\">\n                                            Centro Auto\n                                        </h3>\n                                    </div>\n                                    <span class=\"mt-3 inline-flex rounded-full bg-[var(--error-surface)] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[var(--error)]\" data-kid=\"1-1-3-2-4-3-3-1-1-2\">\n                                        <i class=\"ti ti-ban mr-1\" data-kid=\"1-1-3-2-4-3-3-1-1-2-1\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        SUSPENDIDO\n                                    </span>\n                                </div>\n                                <button aria-label=\"Más opciones de Centro Auto\" class=\"flex size-11 items-center justify-center rounded-full border border-[var(--outline)] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-3-3-1-2\">\n                                    <i class=\"ti ti-dots\" data-kid=\"1-1-3-2-4-3-3-1-2-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </button>\n                            </div>\n                            <div class=\"mt-4 space-y-2 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-4-3-3-2\">\n                                <p data-kid=\"1-1-3-2-4-3-3-2-1\">\n                                    <i class=\"ti ti-tool mr-2 text-[var(--primary)]\" data-kid=\"1-1-3-2-4-3-3-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    Mecánica general\n                                </p>\n                                <p data-kid=\"1-1-3-2-4-3-3-2-2\">\n                                    <i class=\"ti ti-map-pin mr-2 text-[var(--primary)]\" data-kid=\"1-1-3-2-4-3-3-2-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    Soyapango · 2222-0180\n                                </p>\n                            </div>\n                            <div class=\"mt-5 flex border-t border-[var(--outline)] pt-4\" data-kid=\"1-1-3-2-4-3-3-3\">\n                                <button class=\"min-h-[48px] w-full rounded-full bg-[var(--success)] px-3 text-[11px] font-bold text-[var(--on-primary)]\" data-kid=\"1-1-3-2-4-3-3-3-1\">\n                                    <i class=\"ti ti-check mr-1\" data-kid=\"1-1-3-2-4-3-3-3-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    Reactivar\n                                </button>\n                            </div>\n                        </article>\n                    </div>\n                </section>\n                <p class=\"mt-7 flex items-center gap-2 text-[11px] text-[var(--text-secondary)]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-5\" data-name=\"status update indicator text\" data-reason=\"time elapsed since last sync updated by script\">\n                    <span class=\"size-1.5 rounded-full bg-[var(--success)]\" data-kid=\"1-1-3-2-5-1\">\n                    </span>\n                    Datos sincronizados hace 3 min · Los cambios requieren confirmación.\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
