      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @keyframes autodoc-splash-spin { to { transform: rotate(360deg); } }\n  @keyframes autodoc-splash-pulse { 0%, 100% { transform: translateX(-115%); } 50% { transform: translateX(180%); } }\n  .autodoc-splash-spin { animation: autodoc-splash-spin 1.2s linear infinite; }\n  .autodoc-splash-progress { animation: autodoc-splash-pulse 1.6s ease-in-out infinite; }\n  @media (prefers-reduced-motion: reduce) {\n    .autodoc-splash-spin, .autodoc-splash-progress { animation: none; }\n  }\n</style>\n<div class=\"relative min-h-screen overflow-x-hidden bg-(--splash-primary) text-(--splash-on-primary) antialiased\" data-kid=\"1\" data-name=\"splash screen background\" style=\"--splash-primary:#0F172A;--splash-on-primary:#0F172A;--splash-brand:#F8FAFC;--splash-secondary:#522C81;--splash-secondary-bright:#81E6D9;--splash-success:#48BB78;--splash-outline:#334155;font-family:'IBM Plex Sans',sans-serif\">\n    <div class=\"pointer-events-none absolute -left-40 -top-40 size-[360px] rounded-full opacity-80\" data-kid=\"1-1\" data-name=\"success decorative blob\" style=\"background:radial-gradient(circle at center,rgba(72,187,120,.16) 0%,rgba(72,187,120,.04) 42%,transparent 72%)\">\n    </div>\n    <div class=\"pointer-events-none absolute -bottom-48 -right-48 size-[420px] rounded-full opacity-90\" data-kid=\"1-2\" data-name=\"secondary decorative blob\" style=\"background:radial-gradient(circle at center,rgba(129,230,217,.16) 0%,rgba(129,230,217,.04) 42%,transparent 72%)\">\n    </div>\n    <main class=\"relative mx-auto flex min-h-screen w-full max-w-[375px] flex-col items-center px-6 py-7\" data-kid=\"1-3\" data-name=\"scroll-safe splash content\">\n        <div class=\"flex w-full justify-end\" data-kid=\"1-3-1\" data-name=\"splash utility row\">\n            <div aria-label=\"Configuración\" class=\"flex size-11 items-center justify-center rounded-full border border-(--splash-outline) bg-[#141E36]/80 text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,.2)]\" data-kid=\"1-3-1-1\" data-name=\"settings status control\">\n                <i class=\"ti ti-settings-2 text-[18px]\" data-kid=\"1-3-1-1-1\" data-name=\"settings icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n        </div>\n        <section class=\"flex w-full flex-col items-center pt-16 text-center\" data-kid=\"1-3-2\" data-name=\"splash branding group\">\n            <div class=\"relative flex size-[142px] items-center justify-center\" data-kid=\"1-3-2-1\" data-name=\"isotype logo stage\">\n                <div class=\"absolute size-[108px] rotate-45 rounded-[22px] border border-white/10 bg-white/[0.06]\" data-kid=\"1-3-2-1-1\" data-name=\"rotated logo surface\">\n                </div>\n                <div class=\"absolute size-[122px] -rotate-12 rounded-[26px] border-[3px] border-(--splash-secondary-bright)/40\" data-kid=\"1-3-2-1-2\" data-name=\"rotated secondary outline\">\n                </div>\n                <div class=\"relative flex size-[86px] items-center justify-center rounded-[18px] border border-white/20 bg-(--splash-brand) p-3 shadow-[0_16px_34px_rgba(2,6,23,.42)]\" data-kid=\"1-3-2-1-3\" data-name=\"on-primary logo tile\">\n                    <img alt=\"AutoDoc\" class=\"size-full object-contain\" data-kid=\"1-3-2-1-3-1\" data-name=\"AutoDoc isotype logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/logo/autodoc_isotype.svg\"/>\n                </div>\n            </div>\n            <div class=\"mt-8 flex items-baseline justify-center tracking-[-0.065em]\" data-kid=\"1-3-2-2\" data-name=\"AutoDoc wordmark\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                <span class=\"text-[40px] font-extrabold leading-none text-(--splash-brand)\" data-kid=\"1-3-2-2-1\" data-name=\"Auto wordmark\">\n                    Auto\n                </span>\n                <span class=\"text-[40px] font-extrabold leading-none text-(--splash-secondary-bright)\" data-kid=\"1-3-2-2-2\" data-name=\"Doc wordmark\">\n                    Doc\n                </span>\n            </div>\n            <p class=\"mt-3 text-[10px] font-semibold uppercase tracking-[0.3em] text-(--splash-brand)/85\" data-kid=\"1-3-2-3\" data-name=\"professional diagnosis slogan\">\n                DIAGNÓSTICO PROFESIONAL\n            </p>\n        </section>\n        <section class=\"flex w-full flex-col items-center pb-8 pt-20\" data-kid=\"1-3-3\" data-name=\"session resolution loading state\">\n            <div class=\"relative flex size-[58px] items-center justify-center\" data-kid=\"1-3-3-1\" data-name=\"circular car loading indicator\">\n                <div class=\"absolute inset-0 rounded-full border-[4px] border-(--splash-outline)\" data-kid=\"1-3-3-1-1\" data-name=\"loading ring track\">\n                </div>\n                <div class=\"autodoc-splash-spin absolute inset-0 rounded-full border-[4px] border-transparent border-r-(--splash-secondary-bright) border-t-(--splash-secondary-bright)\" data-dynamic=\"true\" data-kid=\"1-3-3-1-2\" data-name=\"rotating loading ring\" data-reason=\"rotated continuously by infinite CSS keyframe animation\">\n                </div>\n                <i class=\"ti ti-car text-[18px] text-(--splash-secondary-bright)\" data-kid=\"1-3-3-1-3\" data-name=\"loading car icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <p class=\"mt-6 text-[15px] font-semibold text-(--splash-brand)\" data-kid=\"1-3-3-2\" data-name=\"loading status label\">\n                Cargando datos...\n            </p>\n            <div class=\"mt-4 h-1 w-full max-w-[220px] overflow-hidden rounded-full bg-white/10\" data-kid=\"1-3-3-3\" data-name=\"indeterminate progress track\">\n                <div class=\"autodoc-splash-progress h-full w-2/5 rounded-full bg-(--splash-secondary-bright)\" data-dynamic=\"true\" data-kid=\"1-3-3-3-1\" data-name=\"indeterminate progress value\" data-reason=\"translated horizontally by infinite CSS keyframe animation\">\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-08-17T22:11:04.077222+00:00",
      "modified": "2026-08-17T22:11:35.880337+00:00",
      "id": "var_93d4922f926f"
    },
    "var_eb14862cb54c": {
      "type": "variant",
      "label": "AutoDoc Admin Workshops — Hadrian Light",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 118720,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"admin workshops application shell\" style=\"--surface:#F7F6F8;--surface-container:#EEEDF0;--surface-variant:#E2E8F0;--outline:#CBD5E1;--outline-strong:#94A3B8;--primary:#522C81;--secondary:#81E6D9;--on-primary:#FFFFFF;--text-primary:#0F172A;--text-secondary:#5B6B80;--success:#2F855A;--warning:#C17817;--error:#E85D5D;--success-surface:#ECFDF5;--warning-surface:#FFFBEB;--error-surface:#FFF1F2\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"1-1-1\" data-name=\"primary admin icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[var(--secondary)] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-[#0F172A]\" data-kid=\"1-1-1-1\">\n                AD\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"1-1-1-2\">\n                <button aria-label=\"Resumen\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B]\" data-kid=\"1-1-1-2-1\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-1-2-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Usuarios\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B]\" data-kid=\"1-1-1-2-2\">\n                    <i class=\"ti ti-users\" data-kid=\"1-1-1-2-2-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl bg-[var(--primary)] text-[20px] text-white shadow-[0_8px_20px_rgba(82,44,129,0.22)]\" data-kid=\"1-1-1-2-3\">\n                    <i class=\"ti ti-building-store\" data-kid=\"1-1-1-2-3-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Reseñas\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B]\" data-kid=\"1-1-1-2-4\">\n                    <i class=\"ti ti-star\" data-kid=\"1-1-1-2-4-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Logs\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B]\" data-kid=\"1-1-1-2-5\">\n                    <i class=\"ti ti-list-details\" data-kid=\"1-1-1-2-5-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Seed\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B]\" data-kid=\"1-1-1-2-6\">\n                    <i class=\"ti ti-database-cog\" data-kid=\"1-1-1-2-6-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </nav>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"1-1-1-3\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B]\" data-kid=\"1-1-1-3-1\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"1-1-1-3-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B]\" data-kid=\"1-1-1-3-2\">\n                    <i class=\"ti ti-settings\" data-kid=\"1-1-1-3-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[var(--outline)] bg-white px-5 py-6\" data-kid=\"1-1-2\" data-name=\"admin contextual sidebar\">\n            <div class=\"mb-8\" data-kid=\"1-1-2-1\">\n                <p class=\"text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-2-1-1\">\n                    Administración\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"1-1-2-1-2\">\n                    <span class=\"size-2 rounded-full bg-[var(--success)]\" data-kid=\"1-1-2-1-2-1\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-2-1-2-2\">\n                        Superadmin\n                    </span>\n                </div>\n            </div>\n            <div class=\"mb-3 px-3 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--text-secondary)]\" data-kid=\"1-1-2-2\">\n                Centro de control\n            </div>\n            <nav aria-label=\"Navegación de administración\" class=\"flex flex-col gap-1\" data-kid=\"1-1-2-3\">\n                <a class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-transparent px-3 text-[14px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-1\" href=\"#resumen\">\n                    <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"1-1-2-3-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Resumen\n                </a>\n                <a class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-transparent px-3 text-[14px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-2\" href=\"#usuarios\">\n                    <i class=\"ti ti-users text-[17px]\" data-kid=\"1-1-2-3-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Usuarios\n                </a>\n                <a aria-current=\"page\" class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-[var(--primary)] bg-[#F0EAF7] px-3 text-[14px] font-semibold text-[var(--primary)]\" data-kid=\"1-1-2-3-3\" href=\"#talleres\">\n                    <i class=\"ti ti-building-store text-[17px]\" data-kid=\"1-1-2-3-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Talleres\n                    <span class=\"ml-auto rounded-full bg-[#E7DDF2] px-2 py-0.5 text-[11px] font-bold text-[var(--primary)]\" data-kid=\"1-1-2-3-3-2\">\n                        4\n                    </span>\n                </a>\n                <a class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-transparent px-3 text-[14px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-4\" href=\"#resenas\">\n                    <i class=\"ti ti-star text-[17px]\" data-kid=\"1-1-2-3-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Reseñas\n                </a>\n                <a class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-transparent px-3 text-[14px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-5\" href=\"#logs\">\n                    <i class=\"ti ti-list-details text-[17px]\" data-kid=\"1-1-2-3-5-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Logs\n                </a>\n                <a class=\"flex min-h-[48px] items-center gap-3 border-l-[3px] border-transparent px-3 text-[14px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-6\" href=\"#seed\">\n                    <i class=\"ti ti-database-cog text-[17px]\" data-kid=\"1-1-2-3-6-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Seed\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[var(--surface-variant)] pt-5\" data-kid=\"1-1-2-4\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-4-1\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#E7DDF2] text-[12px] font-bold text-[var(--primary)]\" data-kid=\"1-1-2-4-1-1\">\n                        SA\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-1-2-4-1-2\">\n                        <p class=\"truncate text-[13px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-2-4-1-2-1\">\n                            Superadmin\n                        </p>\n                        <p class=\"truncate text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-1-2-4-1-2-2\">\n                            Acceso interno\n                        </p>\n                    </div>\n                    <i class=\"ti ti-chevron-down ml-auto text-[16px] text-[var(--outline-strong)]\" data-kid=\"1-1-2-4-1-3\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"1-1-3\" data-name=\"admin workshops main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[var(--outline)] bg-white px-8\" data-kid=\"1-1-3-1\" data-name=\"admin workshops top bar\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"1-1-3-1-1\">\n                    <span class=\"text-[var(--text-secondary)]\" data-kid=\"1-1-3-1-1-1\">\n                        Admin\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px] text-[var(--outline-strong)]\" data-kid=\"1-1-3-1-1-2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-3-1-1-3\">\n                        Gestionar talleres\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-4\" data-kid=\"1-1-3-1-2\">\n                    <span class=\"text-[12px] text-[var(--text-secondary)]\" data-dynamic=\"true\" data-kid=\"1-1-3-1-2-1\" data-name=\"date display text\" data-reason=\"date updated dynamically by script\">\n                        Sábado, 17 ago 2026\n                    </span>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[var(--outline)] bg-[var(--surface-container)] text-[var(--text-secondary)]\" data-kid=\"1-1-3-1-2-2\">\n                        <i class=\"ti ti-bell\" data-kid=\"1-1-3-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[var(--error)]\" data-kid=\"1-1-3-1-2-2-2\">\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-2 border-l border-[var(--outline)] pl-4\" data-kid=\"1-1-3-1-2-3\">\n                        <div class=\"grid size-9 place-items-center rounded-full bg-[#E7DDF2] text-[12px] font-bold text-[var(--primary)]\" data-kid=\"1-1-3-1-2-3-1\">\n                            SA\n                        </div>\n                        <span class=\"text-[13px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-3-1-2-3-2\">\n                            Superadmin\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1160px] px-8 py-7\" data-kid=\"1-1-3-2\" data-name=\"admin workshops page body\">\n                <div class=\"mb-5 flex items-end justify-between gap-6\" data-kid=\"1-1-3-2-1\" data-name=\"workshops page heading\">\n                    <div data-kid=\"1-1-3-2-1-1\">\n                        <p class=\"mb-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--primary)]\" data-kid=\"1-1-3-2-1-1-1\">\n                            Gestión de red\n                        </p>\n                        <h1 class=\"font-heading text-[32px] font-extrabold tracking-[-0.045em] text-[var(--text-primary)]\" data-kid=\"1-1-3-2-1-1-2\">\n                            Gestionar talleres\n                        </h1>\n                        <p class=\"mt-2 text-[15px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-1-1-3\">\n                            Administra mecánicos, solicitudes formales y estados de operación.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-3-2-1-2\">\n                        <button class=\"flex min-h-[48px] items-center gap-2 rounded-full border border-[var(--outline)] bg-white px-4 text-[13px] font-semibold text-[var(--text-primary)] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-3-2-1-2-1\">\n                            <i class=\"ti ti-refresh text-[16px] text-[var(--primary)]\" data-kid=\"1-1-3-2-1-2-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Actualizar\n                        </button>\n                        <button class=\"flex min-h-[48px] items-center gap-2 rounded-full bg-[var(--primary)] px-4 text-[13px] font-bold text-white shadow-[0_4px_10px_rgba(82,44,129,0.18)]\" data-kid=\"1-1-3-2-1-2-2\">\n                            <i class=\"ti ti-download text-[16px]\" data-kid=\"1-1-3-2-1-2-2-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Exportar CSV\n                        </button>\n                    </div>\n                </div>\n                <section class=\"mb-6 rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-4 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-3-2-2\" data-name=\"workshops search and advanced filters\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-3-2-2-1\">\n                        <div class=\"flex min-h-[52px] min-w-0 flex-1 items-center gap-3 rounded-[12px] border border-[var(--outline)] bg-white px-4\" data-kid=\"1-1-3-2-2-1-1\">\n                            <i class=\"ti ti-search text-[19px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-1-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span class=\"text-[