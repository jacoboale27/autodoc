      "themeId": null,
      "rect": {
        "x": 86710,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"Mobile service catalog root\">\n    <header class=\"sticky top-0 z-20 flex h-16 items-center justify-between border-b border-[#334155] bg-[#0F172A]/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"Compact mobile header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"Mobile brand and breadcrumb\">\n            <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617] shadow-[0_8px_24px_rgba(56,189,248,0.16)]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo text\">\n                    AD\n                </span>\n            </div>\n            <div class=\"min-w-0 leading-tight\" data-kid=\"2-1-1-2\" data-name=\"Mobile screen context\">\n                <div class=\"truncate text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"breadcrumb context label\">\n                    Taller\n                </div>\n                <div class=\"truncate text-[13px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-1-2-2\" data-name=\"Breadcrumb screen title\">\n                    Catálogo de servicios\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"Mobile header actions\">\n            <button aria-label=\"Cambiar tema\" class=\"flex h-11 w-11 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-2-1\" data-name=\"Theme toggle button\">\n                <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-2-1-1\" data-name=\"Sun-moon theme icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative flex h-11 w-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-2-2\" data-name=\"Notifications button\">\n                <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-2-2-1\" data-name=\"Bell notification icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-2\" data-name=\"Notification badge\">\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"px-4 pb-28 pt-6\" data-kid=\"2-2\" data-name=\"Scrollable mobile content\">\n        <div class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"Page heading\">\n            <div class=\"mb-3 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"Page breadcrumb\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"Breadcrumb current module\">\n                    Taller\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-2-1-1-2\" data-name=\"Breadcrumb separator icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-semibold text-[#CBD5E1]\" data-kid=\"2-2-1-1-3\" data-name=\"Breadcrumb current page\">\n                    Catálogo\n                </span>\n            </div>\n            <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[27px] font-extrabold leading-tight tracking-[-0.04em] text-white\" data-kid=\"2-2-1-2\" data-name=\"Page title\">\n                Catálogo de servicios\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-3\" data-name=\"Page description\">\n                Define los servicios que tu equipo puede añadir rápidamente a una reparación y conserva precios consistentes.\n            </p>\n            <button class=\"mt-5 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-4 text-[12px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-2-1-4\" data-name=\"add service call-to-action button\">\n                <i class=\"ti ti-plus text-[15px]\" data-kid=\"2-2-1-4-1\" data-name=\"Plus icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Añadir servicio\n            </button>\n        </div>\n        <section class=\"mb-6 overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] py-3 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-2\" data-name=\"search and filter controls container\">\n            <label class=\"flex h-11 w-full items-center gap-3 border border-[#475569] bg-[#111C2D] px-3 text-[#94A3B8]\" data-kid=\"2-2-2-1\" data-name=\"Service search input field\">\n                <i class=\"ti ti-search shrink-0 text-[17px]\" data-kid=\"2-2-2-1-1\" data-name=\"Search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <input aria-label=\"Buscar servicio\" class=\"min-w-0 flex-1 bg-transparent text-[13px] text-[#E2E8F0] outline-none placeholder:text-[#64748B]\" data-kid=\"2-2-2-1-2\" data-name=\"Search input box\" placeholder=\"Buscar por nombre de servicio\"/>\n                <span class=\"hidden border-l border-[#475569] pl-3 text-[11px] text-[#64748B] min-[360px]:inline\" data-kid=\"2-2-2-1-3\" data-name=\"Search shortcut hint\">\n                    ⌘ K\n                </span>\n            </label>\n            <div class=\"mt-3 flex items-center justify-between gap-3\" data-kid=\"2-2-2-2\" data-name=\"Catalog filter row\">\n                <span class=\"text-[12px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-2-2-1\" data-name=\"Service count display\" data-reason=\"text value updated based on catalog items by script\">\n                    4 servicios\n                </span>\n                <button class=\"flex h-11 items-center gap-2 border border-[#475569] px-3 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-2\" data-name=\"Filter dropdown button\">\n                    <i class=\"ti ti-adjustments-horizontal text-[15px]\" data-kid=\"2-2-2-2-2-1\" data-name=\"Filter icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Activos\n                    <i class=\"ti ti-chevron-down text-[13px]\" data-kid=\"2-2-2-2-2-2\" data-name=\"Chevron down icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <section aria-labelledby=\"catalog-mobile-title\" class=\"overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-3\" data-name=\"mobile service catalog card container\">\n            <div class=\"border-b border-[#334155] px-4 py-4\" data-kid=\"2-2-3-1\" data-name=\"Catalog section header\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-1-1\" data-name=\"Section header details\">\n                    <div data-kid=\"2-2-3-1-1-1\" data-name=\"Section heading group\">\n                        <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold tracking-[-0.02em]\" data-kid=\"2-2-3-1-1-1-1\" data-name=\"Section title\" id=\"catalog-mobile-title\">\n                            Servicios del taller\n                        </h2>\n                        <p class=\"mt-1 text-[12px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-3-1-1-1-2\" data-name=\"Section description\">\n                            Precios disponibles para añadir a una factura.\n                        </p>\n                    </div>\n                    <span class=\"flex shrink-0 items-center gap-1.5 pt-1 text-right text-[10px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-3-1-1-2\" data-name=\"Catalog sync status\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-3-1-1-2-1\" data-name=\"Sync status dot\">\n                        </span>\n                        <span class=\"max-w-[82px]\" data-kid=\"2-2-3-1-1-2-2\" data-name=\"Sync status text\">\n                            Catálogo sincronizado\n                        </span>\n                    </span>\n                </div>\n            </div>\n            <article class=\"border-b border-[#334155] px-4 py-4\" data-kid=\"2-2-3-2\" data-name=\"Service row 1\">\n                <div class=\"flex items-start gap-3\" data-kid=\"2-2-3-2-1\" data-name=\"Service details\">\n                    <span class=\"flex h-9 w-9 shrink-0 items-center justify-center border border-[#334155] text-[#38BDF8]\" data-kid=\"2-2-3-2-1-1\" data-name=\"Service icon container\">\n                        <i class=\"ti ti-droplet-up text-[16px]\" data-kid=\"2-2-3-2-1-1-1\" data-name=\"Service droplet icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-3-2-1-2\" data-name=\"Service name and category\">\n                        <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-1-2-1\" data-name=\"Service name\">\n                            Cambio de aceite\n                        </div>\n                        <div class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-3-2-1-2-2\" data-name=\"Service category\">\n                            Mantenimiento preventivo\n                        </div>\n                    </div>\n                    <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-2-3-2-1-3\" data-name=\"Service action buttons\">\n                        <button aria-label=\"Editar cambio de aceite\" class=\"flex h-11 w-11 items-center justify-center text-[#94A3B8]\" data-kid=\"2-2-3-2-1-3-1\" data-name=\"Service edit button\">\n                            <i class=\"ti ti-pencil text-[16px]\" data-kid=\"2-2-3-2-1-3-1-1\" data-name=\"Pencil edit icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                        <button aria-label=\"Más opciones cambio de aceite\" class=\"flex h-11 w-11 items-center justify-center text-[#94A3B8]\" data-kid=\"2-2-3-2-1-3-2\" data-name=\"Service more options button\">\n                            <i class=\"ti ti-dots text-[16px]\" data-kid=\"2-2-3-2-1-3-2-1\" data-name=\"Dots menu icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"mt-4 grid grid-cols-3 gap-2 border-t border-[#334155] pt-3\" data-kid=\"2-2-3-2-2\" data-name=\"Service metadata\">\n                    <div data-kid=\"2-2-3-2-2-1\" data-name=\"Service duration metadata\">\n                        <div class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-2-1-1\" data-name=\"Duration label\">\n                            Duración\n                        </div>\n                        <div class=\"mt-1 text-[12px] tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-3-2-2-1-2\" data-name=\"Duration value\">\n                            45 min\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-3-2-2-2\" data-name=\"Service price metadata\">\n                        <div class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-2-2-1\" data-name=\"Price label\">\n                            Precio\n                        </div>\n                        <div class=\"mt-1 text-[13px] font-semibold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-3-2-2-2-2\" data-name=\"Price value\">\n                            $82.00\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-3-2-2-3\" data-name=\"Service status metadata\">\n                        <div class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-2-3-1\" data-name=\"Status label\">\n                            Estado\n                        </div>\n                        <div class=\"mt-1 flex items-center gap-1.5 text-[12px] font-semibold text-[#6EE7B7]\" data-kid=\"2-2-3-2-2-3-2\" data-name=\"Status indicator\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#34D399]\" data-kid=\"2-2-3-2-2-3-2-1\" data-name=\"Status indicator dot\">\n                            </span>\n                            Activo\n                        </div>\n                    </div>\n                </div>\n            </art