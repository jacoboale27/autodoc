      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n    aside button { min-width: 44px; min-height: 44px; border: 1px solid rgba(51,65,85,.2); border-radius: 9999px; background: #141E36; box-shadow: 0 2px 4px rgba(0,0,0,.2); transition: transform 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n    aside button:hover { background: #1E293B; box-shadow: 0 6px 14px rgba(0,0,0,.35); }\n    aside button:active { transform: scale(.97); }\n    aside button[class*=\"bg-[#1E293B]\"] { background: #1E293B; border-color: #38BDF8; color: #38BDF8; }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"alerts application root\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"alerts desktop shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"owner icon rail\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\" data-name=\"primary rail navigation\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1-1\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-1-2\" data-name=\"owner rail destinations\">\n                    <button aria-label=\"Inicio\" class=\"flex h-11 w-11 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"home rail button\">\n                        <i class=\"ti ti-home-2 text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Mi garaje\" class=\"flex h-11 w-11 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-2\" data-name=\"garage rail button\">\n                        <i class=\"ti ti-steering-wheel text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex h-11 w-11 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-3\" data-name=\"workshops rail button\">\n                        <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Alertas\" class=\"flex h-11 w-11 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-4\" data-name=\"active alerts rail button\">\n                        <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-1-1-1-2-4-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Historial\" class=\"flex h-11 w-11 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-5\" data-name=\"history rail button\">