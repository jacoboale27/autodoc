text-[15px] text-[#64748B]\" data-kid=\"2-2-2-1-2-2-2-2\" data-name=\"Chevron down icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-2-2-1-2-3\" data-name=\"Phone field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-1-2-3-1\" data-name=\"Phone field label\">\n                            Teléfono de contacto\n                        </span>\n                        <div class=\"flex h-12 items-center border border-[#F87171] bg-[#1E293B] px-3\" data-kid=\"2-2-2-1-2-3-2\" data-name=\"Phone input container\">\n                            <i class=\"ti ti-phone mr-3 text-[17px] text-[#F87171]\" data-kid=\"2-2-2-1-2-3-2-1\" data-name=\"Phone icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <input aria-label=\"Teléfono de contacto\" class=\"min-w-0 flex-1 bg-transparent text-[13px] text-[#F8FAFC] outline-none\" data-kid=\"2-2-2-1-2-3-2-2\" data-name=\"Phone input field\" value=\"7788-99\"/>\n                        </div>\n                        <span class=\"mt-2 flex items-start gap-1.5 text-[11px] leading-4 text-[#FCA5A5]\" data-kid=\"2-2-2-1-2-3-3\" data-name=\"Phone error message container\">\n                            <i class=\"ti ti-alert-circle mt-0.5 shrink-0 text-[14px]\" data-kid=\"2-2-2-1-2-3-3-1\" data-name=\"Alert icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            El número debe tener al menos 8 dígitos.\n                        </span>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-2-2-1-2-4\" data-name=\"WhatsApp field\