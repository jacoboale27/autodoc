    "var_defeb8af8fcb": {
      "type": "variant",
      "label": "AutoDoc Splash — Hadrian Dark",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 100170,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .splash-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .splash-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  @keyframes splash-spin { to { transform: rotate(360deg); } }\n  @keyframes splash-breathe { 0%, 100% { opacity: .72; transform: scale(.98); } 50% { opacity: 1; transform: scale(1); } }\n  .splash-spin { animation: splash-spin 1.2s linear infinite; transform-origin: center; }\n  .splash-breathe { animation: splash-breathe 2.4s ease-out infinite; }\n  @media (prefers-reduced-motion: reduce) {\n    .splash-spin, .splash-breathe { animation: none; }\n  }\n</style>\n<div class=\"splash-body relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"1\" data-name=\"AutoDoc dark splash loading state\">\n    <div class=\"pointer-events-none absolute -left-[180px] -top-[180px] size-[540px] rounded-full opacity-80\" data-kid=\"1-1\" data-name=\"success decorative radial blob\" style=\"background:radial-gradient(circle at center, rgba(72,187,120,.18) 0%, rgba(72,187,120,.06) 34%, transparent 72%)\">\n    </div>\n    <div class=\"pointer-events-none absolute -bottom-[250px] -right-[220px] size-[640px] rounded-full opacity-90\" data-kid=\"1-2\" data-name=\"secondary decorative radial blob\" style=\"background:radial-gradient(circle at center, rgba(129,230,217,.18) 0%, rgba(129,230,217,.05) 36%, transparent 74%)\">\n    </div>\n    <div class=\"pointer-events-none absolute inset-x-0 top-0 h-px bg-[#334155]\" data-kid=\"1-3\" data-name=\"top graphite border\">\n    </div>\n    <main class=\"relative z-10 flex min-h-screen w-full max-w-[760px] flex-col items-center justify-between px-10 py-10 lg:px-16 lg:py-12\" data-kid=\"1-4\" data-name=\"centered splash composition\">\n        <div class=\"flex w-full items-center justify-end\" data-kid=\"1-4-1\" data-name=\"splash utility row\">\n            <div aria-label=\"Estado del sistema\" class=\"flex size-11 items-center justify-center rounded-full border border-[#334155] bg-[#141E36]/80 text-[#64748B] shadow-[0_2px_4px_rgba(0,0,0,.2)]\" data-kid=\"1-4-1-1\" data-name=\"system status icon control\">\n                <i class=\"ti ti-settings-2 text-[18px] text-[#94A3B8]\" data-kid=\"1-4-1-1-1\" data-name=\"system status icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n        </div>\n        <section class=\"flex w-full flex-1 flex-col items-center justify-center py-10 text-center\" data-kid=\"1-4-2\" data-name=\"splash branding group\">\n            <div class=\"relative flex size-[176px] items-center justify-center\" data-kid=\"1-4-2-1\" data-name=\"isotype logo stage\">\n                <div class=\"absolute size-[132px] rotate-45 rounded-[24px] border border-[#E2E8F0]/10 bg-[#F8FAFC]/[0.06]\" data-kid=\"1-4-2-1-1\" data-name=\"rotated on-primary logo plate\">\n                </div>\n                <div class=\"absolute size-[150px] -rotate-12 rounded-[30px] border-[3px] border-[#81E6D9]/40\" data-kid=\"1-4-2-1-2\" data-name=\"rotated secondary logo border\">\n                </div>\n                <div class=\"relative flex size-[104px] items-center justify-center rounded-[22px] border border-[#E2E8F0]/30 bg-[#F8FAFC] p-4 shadow-[0_16px_34px_rgba(2,6,23,.42)] splash-breathe\" data-kid=\"1-4-2-1-3\" data-name=\"on-primary logo tile\">\n                    <img alt=\"AutoDoc\" class=\"size-full object-contain\" data-kid=\"1-4-2-1-3-1\" data-name=\"AutoDoc isotype logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/logo/autodoc_isotype.svg\"/>\n                </div>\n            </div>\n            <div class=\"mt-9 flex items-baseline justify-center tracking-[-0.065em]\" data-kid=\"1-4-2-2\" data-name=\"AutoDoc wordmark\">\n                <span class=\"splash-heading text-[56px] font-extrabold leading-none text-[#F8FAFC]\" data-kid=\"1-4-2-2-1\" data-name=\"Auto wordmark\">\n                    Auto\n                </span>\n                <span class=\"splash-heading text-[56px] font-extrabold leading-none text-[#81E6D9]\" data-kid=\"1-4-2-2-2\" data-name=\"Doc wordmark\">\n                    Doc\n                </span>\n            </div>\n            <p class=\"mt-4 text-[12px] font-semibold uppercase tracking-[0.42em] text-[#F8FAFC]/85\" data-kid=\"1-4-2-3\" data-name=\"professional diagnosis slogan\">\n                DIAGNÓSTICO PROFESIONAL\n            </p>\n        </section>\n        <section class=\"flex w-full flex-col items-center pb-4\" data-kid=\"1-4-3\" data-name=\"splash loading footer\">\n            <div class=\"relative flex size-[68px] items-center justify-center\" data-kid=\"1-4-3-1\" data-name=\"circular car loading indicator\">\n                <div class=\"absolute inset-0 rounded-full border-[5px] border-[#334155]\" data-kid=\"1-4-3-1-1\" data-name=\"loading track\">\n                </div>\n                <div class=\"splash-spin absolute inset-0 rounded-full border-[5px] border-transparent border-t-[#81E6D9] border-r-[#81E6D9]\" data-kid=\"1-4-3-1-2\" data-name=\"rotating secondary loading ring\">\n                </div>\n                <i class=\"ti ti-car text-[20px] text-[#81E6D9]\" data-kid=\"1-4-3-1-3\" data-name=\"car loading icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <p class=\"mt-6 text-[16px] font-semibold text-[#F8FAFC]\" data-kid=\"1-4-3-2\" data-name=\"loading status label\">\n                Cargando datos...\n            </p>\n            <div class=\"mt-4 h-1 w-full max-w-[260px] overflow-hidden rounded-full bg-[#F8FAFC]/10\" data-kid=\"1-4-3-3\" data-name=\"indeterminate progress track\">\n                <div class=\"h-full w-2/5 rounded-full bg-gradient-to-r from-[#81E6D9] to-[#6FC8BC]\" data-kid=\"1-4-3-3-1\" data-name=\"indeterminate secondary progress\" style=\"animation:splash-progress 1.5s ease-in-out infinite alternate\">\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n<style>\n    @keyframes splash-progress { from { transform: translateX(-115%); } to { transform: translateX(250%); } }\n  @media (prefers-reduced-motion: reduce) { [data-name=\"indeterminate secondary progress\"] { animation: none !important; transform: translateX(0); } }\n</style>\n",
