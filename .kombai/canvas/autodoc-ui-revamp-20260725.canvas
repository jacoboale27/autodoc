      "html": "<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    [data-name=\"theme toggle button\"], [data-name=\"notifications button\"] { min-width:44px; min-height:44px; border-radius:999px; border:1px solid #334155; background:#141E36; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"theme toggle button\"]:hover, [data-name=\"notifications button\"]:hover { background:#1E293B; color:#81E6D9; box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"theme toggle button\"]:active, [data-name=\"notifications button\"]:active { transform:scale(.97); }\n  [data-name=\"mobile service status summary\"], [data-name=\"mobile maintenance frequency settings\"], [data-name=\"mobile advanced notification settings\"] { overflow:hidden; border:1px solid rgba(51,65,85,.2); border-radius:16px; background:#141E36; box-shadow:0 2px 4px rgba(0,0,0,.2); }\n  [data-name=\"cancel button\"] { min-height:48px; border:1px solid #334155; border-radius:999px; background:#141E36; color:#CBD5E1; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"cancel button\"]:hover { background:#1E293B; box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"cancel button\"]:active { transform:scale(.97); }\n  [data-name=\"save button\"] { min-height:48px; border-radius:999px; background:linear-gradient(135deg,#81E6D9,#6FC8BC); color:#0F172A; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"save button\"]:hover { transform:scale(1.02); box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"save button\"]:active { transform:scale(.97); }\n</style>\n<div class=\"min-h-screen w-full overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"main page container\" style=\"font-family:'IBM Plex Sans',sans-serif\">\n    <header class=\"sticky top-0 z-20 flex h-[72px] items-center justify-between border-b border-[#334155] bg-[#0B1220]/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile top header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617] shadow-[0_8px_24px_rgba(56,189,248,0.16)]\" data-kid=\"2-1-1-1\" data-name=\"brand logo\">\n                <span class=\"text-[18px] font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1-1\" data-name=\"brand logo acronym\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    AD\n                </span>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"page title container\">\n                <div class=\"truncate text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"context label\">\n                    Propietario\n                </div>\n                <div class=\"truncate text-[14px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-1-2-2\" data-name=\"page title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    Recordatorios\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header actions\">\n            <button aria-label=\"Cambiar tema\" class=\"flex h-11 w-11 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-2-1\" data-name=\"theme toggle button\">\n                <i class=\"ti ti-sun-moon text-[18px]\" data-kid=\"2-1-2-1-1\" data-name=\"sun-moon icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative flex h-11 w-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-2-2\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-2-2-1\" data-name=\"bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-2\" data-name=\"unread notification indicator\">\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[116px]\" data-kid=\"2-2\" data-name=\"mobile task configuration content\">\n        <div class=\"pt-6\" data-kid=\"2-2-1\" data-name=\"mobile breadcrumb\">\n            <div class=\"flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"breadcrumb path\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"breadcrumb parent item\">\n                    Propietario\n                </span>\n                <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-2-1-1-2\" data-name=\"breadcrumb separator icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-2-1-1-3\" data-name=\"breadcrumb current item\">\n                    Recordatorios\n                </span>\n            </div>\n            <h1 class=\"mt-5 text-[26px] font-extrabold leading-tight tracking-[-0.04em] text-[#F8FAFC]\" data-kid=\"2-2-1-2\" data-name=\"page header title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                Configurar recordatorio\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-6 text-[#94A3B8]\" data-kid=\"2-2-1-3\" data-name=\"page header description\">\n                Define cuándo quieres volver a recibir una alerta para que el mantenimiento llegue antes que la urgencia.\n            </p>\n        </div>\n        <section class=\"mt-7\" data-kid=\"2-2-2\" data-name=\"mobile configuration form\">\n            <div class=\"border-y border-[#334155] py-5\" data-kid=\"2-2-2-1\" data-name=\"mobile service status summary\">\n                <div class=\"flex items-start gap-3\" data-kid=\"2-2-2-1-1\" data-name=\"mobile service task info\">\n                    <div class=\"flex h-12 w-12 shrink-0 items-center justify-center border border-[#475569] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-2-2-1-1-1\" data-name=\"service icon container\">\n                        <i class=\"ti ti-engine text-[23px]\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"service engine icon\" style=\"width:23px;height:23px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-2-1-1-2\" data-name=\"task details container\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#94A3B8]\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"task category label\">\n                            Tarea de mantenimiento\n                        </div>\n                        <h2 class=\"mt-1 text-[17px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-2-1-1-2-2\" data-name=\"task title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Cambio de aceite\n                        </h2>\n                        <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-2-1-1-2-3\" data-name=\"task vehicle info\">\n                            Toyota Corolla 2022 · P 482-916\n                        </p>\n                    </div>\n                </div>\n                <span class=\"mt-4 inline-flex items-center gap-2 border border-[#34D399]/40 px-2.5 py-1 text-[10px] font-bold tracking-[0.12em] text-[#6EE7B7]\" data-kid=\"2-2-2-1-2\" data-name=\"status badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-2-1-2-1\" data-name=\"status dot\">\n                    </span>\n                    ACTIVO\n                </span>\n            </div>\n            <div class=\"border-b border-[#334155] py-7\" data-kid=\"2-2-2-2\" data-name=\"mobile maintenance frequency settings\">\n                <h3 class=\"text-[16px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-2-2-1\" data-name=\"section heading\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    Frecuencia de mantenimiento\n                </h3>\n                <p class=\"mt-1 text-[13px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-2-2-2\" data-name=\"section description\">\n                    Usaremos el kilometraje y la fecha del último servicio para calcular el siguiente recordatorio.\n                </p>\n                <div class=\"mt-6 space-y-5\" data-kid=\"2-2-2-2-3\" data-name=\"mobile form input fields\">\n                    <label class=\"block\" data-kid=\"2-2-2-2-3-1\" data-name=\"mileage field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-3-1-1\" data-name=\"field label\">\n                            Kilometraje actual\n                        </span>\n                        <div class=\"flex h-12 items-center border border-[#38BDF8] bg-[#111C2D] px-4 ring-2 ring-[#38BDF8]/20\" data-kid=\"2-2-2-2-3-1-2\" data-name=\"input container\">\n                            <i class=\"ti ti-gauge text-[18px] text-[#38BDF8]\" data-kid=\"2-2-2-2-3-1-2-1\" data-name=\"gauge icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <input aria-label=\"Kilometraje actual\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[14px] font-semibold tabular-nums text-[#F8FAFC] outline-none\" data-dynamic=\"true\" data-kid=\"2-2-2-2-3-1-2-2\" data-name=\"mileage input\" data-reason=\"value reinitialized from vehicle data source\" value=\"48,260\"/>\n                            <span class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-2-2-3-1-2-3\" data-name=\"unit label\">\n                                km\n                            </span>\n                        </div>\n                        <span class=\"mt-2 flex items-center gap-1.5 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-2-3-1-3\" data-name=\"info message\">\n                            <i class=\"ti ti-info-circle text-[14px] text-[#38BDF8]\" data-kid=\"2-2-2-2-3-1-3-1\" data-name=\"info icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Campo enfocado · dato sincronizado desde tu vehículo.\n                        </span>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-2-2-2-3-2\" data-name=\"frequency interval field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-3-2-1\" data-name=\"field label\">\n                            Recordar cada\n                        </span>\n                        <div class=\"flex h-12 items-center border border-[#475569] bg-[#1E293B] px-4\" data-kid=\"2-2-2-2-3-2-2\" data-name=\"input container\">\n                            <i class=\"ti ti-road-sign text-[18px] text-[#94A3B8]\" data-kid=\"2-2-2-2-3-2-2-1\" data-name=\"road sign icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <input aria-label=\"Recordar cada\" class=\"min-w-0 flex-1 bg-transparent px-3 text-[14px] font-semibold tabular-nums text-[#F8FAFC] outline-none\" data-kid=\"2-2-2-2-3-2-2-2\" data-name=\"interval input\" value=\"10,000\"/>\n                            <span class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-2-2-3-2-2-3\" data-name=\"unit label\">\n                                km\n                            </span>\n                        </div>\n                        <span class=\"mt-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-3-2-3\" data-name=\"helper text\">\n                            Puedes cambiarlo para ajustarlo a tu forma de conducir.\n                        </span>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-2-2-2-3-3\" data-name=\"next service field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-3-3-1\" data-name=\"field label\">\n                            Próxima revisión\n                        </span>\n                        <div class=\"flex h-12 items-center border border-[#334155] bg-[#111827] px-4\" data-kid=\"2-2-2-2-3-3-2\" data-name=\"field value container\">\n                            <i class=\"ti ti-calendar-event text-[18px] text-[#94A3B8]\" data-kid=\"2-2-2-2-3-3-2-1\" data-name=\"calendar icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span class=\"px-3 text-[14px] font-semibold text-[#E2E8F0]\" data-dynamic=\"true\" data-kid=\"2-2-2-2-3-3-2-2\" data-name=\"calculated date text\" data-reason=\"date text reinitialized by calculation script\">\n                                12 jun 2027\n                            </span>\n                            <span class=\"ml-auto text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-3-3-2-3\" data-name=\"calculated label\">\n                                Calculada\n                            </span>\n                        </div>\n                    </label>\n                </div>\n            </div>\n            <div class=\"border-b border-[#334155] py-6\" data-kid=\"2-2-2-3\" data-name=\"mobile advanced notification settings\">\n                <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-2-2-3-1\" data-name=\"toggle row\">\n                    <div class=\"min-w-0\" data-kid=\"2-2-2-3-1-1\" data-name=\"toggle text info\">\n                        <h3 class=\"text-[15px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-2-3-1-1-1\" data-name=\"toggle title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Avisarme con anticipación\n                        </h3>\n                        <p class=\"mt-1 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-2-3-1-1-2\" data-name=\"toggle description\">\n                            Recibe una alerta antes de que llegue la fecha o el kilometraje.\n                        </p>\n                    </div>\n                    <button aria-label=\"Avisarme con anticipación activado\" class=\"relative mt-1 h-7 w-12 shrink-0 rounded-full bg-[#38BDF8]\" data-kid=\"2-2-2-3-1-2\" data-name=\"notification toggle button\">\n                        <span class=\"absolute right-1 top-1 h-5 w-5 rounded-full bg-[#082F49]\" data-kid=\"2-2-2-3-1-2-1\" data-name=\"toggle switch handle\">\n                        </span>\n                    </button>\n                </div>\n                <div class=\"mt-5 flex items-start gap-3 border-l-2 border-[#38BDF8] bg-[#132B40] px-4 py-3\" data-kid=\"2-2-2-3-2\" data-name=\"notification summary box\">\n                    <i class=\"ti ti-bell-ringing mt-0.5 shrink-0 text-[17px] text-[#38BDF8]\" data-kid=\"2-2-2-3-2-1\" data-name=\"bell ringing icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <div class=\"min-w-0\" data-kid=\"2-2-2-3-2-2\" data-name=\"summary text container\">\n                        <div class=\"text-[12px] font-semibold text-[#E0F2FE]\" data-kid=\"2-2-2-3-2-2-1\" data-name=\"summary headline\">\n                            Te avisaremos 500 km antes\n                        </div>\n                        <div class=\"mt-0.5 text-[11px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-2-3-2-2-2\" data-name=\"summary detail\">\n                            También recibirás un recordatorio cuando se acerque la fecha programada.\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex flex-col gap-3 pt-6\" data-kid=\"2-2-2-4\" data-name=\"mobile form action buttons\">\n                <button class=\"order-2 flex h-12 w-full items-center justify-center px-5 text-[13px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-2-4-1\" data-name=\"cancel button\">\n                    Cancelar\n                </button>\n                <button class=\"order-1 flex h-12 w-full items-center justify-center gap-2 bg-[#38BDF8] px-5 text-[13px] font-bold text-[#082F49]\" data-kid=\"2-2-2-4-2\" data-name=\"save button\">\n                    Guardar recordatorio\n                    <i class=\"ti ti-check text-[16px]\" data-kid=\"2-2-2-4-2-1\" data-name=\"check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <p class=\"mt-5 flex items-start gap-2 text-[11px] leading-5 text-[#64748B]\" data-kid=\"2-2-2-5\" data-name=\"validation warning text\">\n                <i class=\"ti ti-shield-check mt-0.5 shrink-0 text-[14px] text-[#34D399]\" data-kid=\"2-2-2-5-1\" data-name=\"shield icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"2-2-2-5-2\" data-name=\"validation warning description\">\n                    Los cambios se guardan en tu historial de mantenimiento. Si un valor no es válido, verás el mensaje junto al campo antes de guardar.\n                </span>\n            </p>\n        </section>\n    </main>\n    <nav aria-label=\"Navegación inferior\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/96 px-2 pb-[env(safe-area-inset-bottom)] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-5 gap-1\" data-kid=\"2-3-1\" data-name=\"navigation grid\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" data-name=\"nav item home\" href=\"#inicio\">\n                <i class=\"ti ti-home-2 text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"home icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"nav item garage\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"car icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"garage label\">\n                    Mi garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"nav item workshops\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"tool icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-label=\"Alertas\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#FBBF24]\" data-kid=\"2-3-1-4\" data-name=\"nav item alerts\" href=\"#alertas\">\n                <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"alert icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"alerts label\">\n                    Alertas\n                </span>\n            </a>\n            <a aria-label=\"Historial\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-5\" data-name=\"nav item history\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-5-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
