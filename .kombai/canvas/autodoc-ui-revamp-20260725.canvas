text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-3-2-4-1-2\">\n                                    Cliente: Ana Martínez\n                                </div>\n                            </div>\n                            <button aria-label=\"Eliminar reseña\" class=\"flex min-h-[48px] min-w-[48px] items-center justify-center rounded-full border border-[var(--outline)] bg-[var(--surface-variant)] text-[var(--text-secondary)] hover:border-[var(--error)] hover:text-[var(--error)]\" data-kid=\"1-1-3-2-3-2-4-2\">\n                                <i class=\"ti ti-trash icon\" data-kid=\"1-1-3-2-3-2-4-2-1\">\n                                </i>\n                            </button>\n                        </div>\n                    </article>\n                    <article class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-5 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-1-3-2-3-3\" data-name=\"reported review card two\">\n                        <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-1-3-2-3-3-1\">\n                            <div aria-label=\"2 de 5 estrellas\" class=\"flex items-center gap-1 text-[var(--warning)]\" data-kid=\"1-1-3-2-3-3-1-1\">\n                                <i class=\"ti ti-star-filled icon\" data-kid=\"1-1-3-2-3-3-1-1-1\">\n                                </i>\n                                <i class=\"ti ti-star-filled icon\" data-kid=\"1-1-3-2-3-3-1-1-2\">\n                                </i>\n                                <i class=\"ti ti-star icon text-[var(--muted)]\" data-kid=\"1-1-3-2-3-3-1-1-3\">\n                                </i>\n                                <i class=\"ti ti-star icon text-[var(--muted)]\" data-kid=\"1-1-3-2-3-3-1-1-4\">\n                                </i>\n                                <i class=\"ti ti-star icon text-[var(--muted)]\" data-kid=\"1-1-3-2-3-3-1-1-5\">\n                                </i>\n                            </div>\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-2-3-3-1-2\">\n                                <span class=\"inline-flex items-center gap-1 rounded-full border border-[var(--error)]/40 bg-[var(--error-surface)] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.08em] text-[var(--error)]\" data-kid=\"1-1-3-2-3-3-1-2-1\">\n                                    <i class=\"ti ti-flag-3 icon\" data-kid=\"1-1-3-2-3-3-1-2-1-1\">\n                                    </i>\n                                    Reportada\n                                </span>\n                                <time class=\"text-[11px] text-[var(--muted)]\" data-kid=\"1-1-3-2-3-3-1-2-2\">\n                                    09/08/2026\n                                </time>\n                            </div>\n                        </div>\n                        <p class=\"mt-4 text-[14px] leading-6 text-[var(--text-primary)]\" data-kid=\"1-1-3-2-3-3-2\">\n                            La reseña fue marcada por la comunidad y espera una decisión de moderación.\n                        </p>\n                        <div class=\"mt-4 flex gap-2\" data-kid=\"1-1-3-2-3-3-3\">\n                            <div class=\"flex h-14 w-14 items-center justify-center rounded-[10px] border border-dashed border-[var(--outline-strong)] bg-[var(--surface)] text-[var(--muted)]\" data-kid=\"1-1-3-2-3-3-3-1\">\n                                <i class=\"ti ti-photo-off icon\" data-kid=\"1-1-3-2-3-3-3-1-1\">\n                                </i>\n                            </div>\n                        </div>\n                        <div class=\"mt-5 flex items-end justify-between gap-4 border-t border-[var(--outline)] pt-4\" data-kid=\"1-1-3-2-3-3-4\">\n                            <div class=\"min-w-0\" data-kid=\"1-1-3-2-3-3-4-1\">\n                                <div class=\"truncate text-[12px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-3-2-3-3-4-1-1\">\n                                    Taller: Centro Auto\n                                </div>\n                                <div class=\"mt-1 truncate text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-3-3-4-1-2\">\n                                    Cliente: Diego López\n                                </div>\n                            </div>\n                            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-1-3-2-3-3-4-2\">\n                                <button aria-label=\"Descartar reporte\" class=\"flex min-h-[48px] min-w-[48px] items-center justify-center rounded-full border border-[var(--outline)] bg-[var(--surface-variant)] text-[var(--text-secondary)] hover:text-[var(--primary)]\" data-kid=\"1-1-3-2-3-3-4-2-1\">\n                                    <i class=\"ti ti-flag-off icon\" data-kid=\"1-1-3-2-3-3-4-2-1-1\">\n                                    </i>\n                                </button>\n                                <button aria-label=\"Eliminar reseña\" class=\"flex min-h-[48px] min-w-[48px] items-center justify-center rounded-full border border-[var(--error)]/45 bg-[var(--error-surface)] text-[var(--error)] hover:bg-[var(--error)] hover:text-[var(--on-primary)]\" data-kid=\"1-1-3-2-3-3-4-2-2\">\n                                    <i class=\"ti ti-trash icon\" data-kid=\"1-1-3-2-3-3-4-2-2-1\">\n                                    </i>\n                                </button>\n                            </div>\n                        </div>\n                    </article>\n                    <aside class=\"rounded-[16px] border border-dashed border-[var(--outline-strong)] bg-[var(--surface)] p-5\" data-kid=\"1-1-3-2-3-4\" data-name=\"compact empty review state cue\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"1-1-3-2-3-4-1\">\n                            <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[var(--surface-variant)] text-[var(--muted)]\" data-kid=\"1-1-3-2-3-4-1-1\">\n                                <i class=\"ti ti-filter-off icon\" data-kid=\"1-1-3-2-3-4-1-1-1\">\n                                </i>\n                            </span>\n                            <div data-kid=\"1-1-3-2-3-4-1-2\">\n                                <div class=\"text-[12px] font-bold uppercase tracking-[0.12em] text-[var(--muted)]\" data-kid=\"1-1-3-2-3-4-1-2-1\">\n                                    Estado vacío del filtro\n                                </div>\n                                <p class=\"mt-2 text-[13px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-3-4-1-2-2\">\n                                    No hay reseñas reportadas\n                                </p>\n                                <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"1-1-3-2-3-4-1-2-3\">\n                                    Sin filtro activo: No hay reseñas registradas\n                                </p>\n                            </div>\n                        </div>\n                    </aside>\n                </section>\n                <p class=\"mt-7 flex items-center gap-2 text-[11px] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-4\" data-name=\"synchronization status timestamp\" data-reason=\"text replaced by script\">\n                    <span class=\"size-1.5 rounded-full bg-[var(--success)]\" data-kid=\"1-1-3-2-4-1\">\n                    </span>\n                    Datos sincronizados hace 4 min · Moderación protegida\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
      "comments": [],
