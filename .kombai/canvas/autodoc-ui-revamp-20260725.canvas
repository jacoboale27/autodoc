section\">\n                    <div class=\"mb-3 flex items-end justify-between\" data-kid=\"2-1-3-2-3-6\" data-name=\"table header container\">\n                        <div data-kid=\"2-1-3-2-3-6-1\" data-name=\"table header text group\">\n                            <h2 class=\"font-heading text-[21px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-1-3-2-3-6-1-1\" data-name=\"table heading\" id=\"catalog-table-heading\">\n                                Servicios del taller\n                            </h2>\n                            <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-6-1-2\" data-name=\"table description text\">\n                                Estos ítems aparecen como opciones rápidas al facturar.\n                            </p>\n                        </div>\n                        <span class=\"text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-3-6-2\" data-name=\"active status summary text\">\n                            3 activos · 1 inactivo\n                        </span>\n                    </div>\n                    <div class=\"overflow-hidden border border-[#CBD5E1] bg-white\" data-kid=\"2-1-3-2-3-1\" data-name=\"service catalog table container\">\n                        <div class=\"grid grid-cols-[minmax(0,1.8fr)_150px_150px_150px_96px] items-center gap-4 border-b border-[#CBD5E1] bg-[#EDF2F7] px-5 py-3 text-[10px] font-bold uppercase tracking-[0.13em] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1\" data-name=\"table column header row\">\n                            <span data-kid=\"2-1-3-2-3-1-1-1\" data-name=\"service column header\">\n                                Servicio\n                            </span>\n                            <span data-kid=\"2-1-3-2-3-1-1-2\" data-name=\"duration column header\">\n                                Duración\n                            </span>\n                            <span data-kid=\"2-1-3-2-3-1-1-3\" data-name=\"price column header\"