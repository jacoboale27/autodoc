-1-1\" data-name=\"external link arrow icon\">\n                                </i>\n                            </span>\n                        </a>\n                    </div>\n                    <div class=\"mt-5 border-y border-[#CBD5E1] bg-white\" data-kid=\"2-1-3-2-4-2\" data-name=\"workshops table\">\n                        <div class=\"grid grid-cols-[minmax(0,1.5fr)_120px_100px_116px] items-center gap-4 border-b border-[#E2E8F0] px-5 py-3 text-[10px] font-bold uppercase tracking-[0.13em] text-[#64748B]\" data-kid=\"2-1-3-2-4-2-1\" data-name=\"table header row\">\n                            <span data-kid=\"2-1-3-2-4-2-1-1\" data-name=\"workshop name header\">\n                                Taller\n                            </span>\n                            <span data-kid=\"2-1-3-2-4-2-1-2\" data-name=\"distance header\">\n                                Distancia\n                            </span>\n                            <span data-kid=\"2-1-3-2-4-2-1-3\" data-name=\"rating header\">\n                                Valoración\n                            </span>\n                            <span class=\"text-right\" data-kid=\"2-1-3-2-4-2-1-4\" data-name=\"action header\">\n                                Acción\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-[minmax(0,1.5fr)_120px_100px_116px] items-center gap-4 border-b border-[#E2E8F0] px-5 py-4 text-[13px]\" data-kid=\"2-1-3-2-4-2-2\" data-name=\"workshop data row\">\n                            <span class=\"flex items-center gap-3 font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-2-2-1\" data-name=\"workshop name cell\">\n                                <span class=\"grid size-8 place-items-center border border-[#CBD5E1] text-[16px] text-[#1E88E5]\" data-kid=\"2-1-3-2-4-2-2-1-1\" data-name=\"workshop icon container\">\n                                    <i class=\"ti ti-tool\" data-kid=\"2-1-3-2-4-2-2-1-1-1\" data-name=\"wrench tool icon\">\n                                    </i>\n                                </span>\n                                Taller Rápido\n                            </span>\n                            <span class=\"text-[#64748B]\" data-kid=\"2-1-3-2-4-2-2-2\" data-name=\"workshop distance\">\n                                1.8 km\n                            </span>\n                            <span class=\"flex items-center gap-1 font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-2-2-3\" data-name=\"workshop rating\">\n                                <span class=\"text-[13px] text-[#F59E0B]\" data-kid=\"2-1-3-2-4-2-2-3-1\" data-name=\"rating star icon container\">\n                                    <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-2-2-3-1-1\" data-name=\"rating star icon\">\n                                    </i>\n                                </span>\n                                4.9\n                            </span>\n                            <button class=\"justify-self-end text-[12px] font-bold text-[#1E88E5] hover:text-[#176FBB]\" data-kid=\"2-1-3-2-4-2-2-4\" data-name=\"contact button\">\n                                Contactar\n                            </button>\n                        </div>\n                        <div class=\"grid grid-cols-[minmax(0,1.5fr)_120px_100px_116px] items-center gap-4 border-b border-[#E2E8F0] px-5 py-4 text-[13px]\" data-kid=\"2-1-3-2-4-2-3\" data-name=\"workshop data row\">\n                            <span class=\"flex items-center gap-3 font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-2-3-1\" data-name=\"workshop name cell\">\n                                <span class=\"grid size-8 place-items-center border border-[#CBD5E1] text-[16px] text-[#1E88E5]\" data-kid=\"2-1-3-2-4-2-3-1-1\" data-name=\"workshop icon container\">\n                                    <i class=\"ti ti-tool\" data-kid=\"2-1-3-2-4-2-3-1-1-1\" data-name=\"wrench tool icon\">\n                                    </i>\n                                </span>\n                                MotorLab\n                            </span>\n                            <span class=\"text-[#64748B]\" data-kid=\"2-1-3-2-4-2-3-2\" data-name=\"workshop distance\">\n                                3.4 km\n                            </span>\n                            <span class=\"flex items-center gap-1 font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-2-3-3\" data-name=\"workshop rating\">\n                                <span class=\"text-[13px] text-[#F59E0B]\" data-kid=\"2-1-3-2-4-2-3-3-1\" data-name=\"rating star icon container\">\n                                    <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-2-3-3-1-1\" data-name=\"rating star icon\">\n                                    </i>\n                                </span>\n                                4.8\n                            </span>\n                            <button class=\"justify-self-end text-[12px] font-bold text-[#1E88E5] hover:text-[#176FBB]\" data-kid=\"2-1-3-2-4-2-3-4\" data-name=\"contact button\">\n                                Contactar\n                            </button>\n                        </div>\n                        <div class=\"grid grid-cols-[minmax(0,1.5fr)_120px_100px_116px] items-center gap-4 px-5 py-4 text-[13px]\" data-kid=\"2-1-3-2-4-2-4\" data-name=\"workshop data row\">\n                            <span class=\"flex items-center gap-3 font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-2-4-1\" data-name=\"workshop name cell\">\n                                <span class=\"grid size-8 place-items-center border border-[#CBD5E1] text-[16px] text-[#1E88E5]\" data-kid=\"2-1-3-2-4-2-4-1-1\" data-name=\"workshop icon container\">\n                                    <i class=\"ti ti-tool\" data-kid=\"2-1-3-2-4-2-4-1-1-1\" data-name=\"wrench tool icon\">\n                                    </i>\n                                </span>\n                                Centro Auto\n                            </span>\n                            <span class=\"text-[#64748B]\" data-kid=\"2-1-3-2-4-2-4-2\" data-name=\"workshop distance\">\n                                5.1 km\n                            </span>\n                            <span class=\"flex items-center gap-1 font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-2-4-3\" data-name=\"workshop rating\">\n                                <span class=\"text-[13px] text-[#F59E0B]\" data-kid=\"2-1-3-2-4-2-4-3-1\" data-name=\"rating star icon container\">\n                                    <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-2-4-3-1-1\" data-name=\"rating star icon\">\n                                    </i>\n                                </span>\n                                4.6\n                            </span>\n                            <button class=\"justify-self-end text-[12px] font-bold text-[#1E88E5] hover:text-[#176FBB]\" data-kid=\"2-1-3-2-4-2-4-4\" data-name=\"contact button\">\n                                Contactar\n                            </button>\n                        </div>\n                    </div>\n                </section>\n                <p class=\"mt-7 pb-2 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-5\" data-name=\"footer copyright text\">\n                    AutoDoc · Diagnóstico y mantenimiento vehicular · Datos sincronizados con tu garaje\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
