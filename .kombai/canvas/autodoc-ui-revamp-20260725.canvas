      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"1\" data-name=\"admin audit log application\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\" data-name=\"admin application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"1-1-1\" data-name=\"admin icon rail\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"1-1-1-1\" data-name=\"primary rail group\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#81E6D9] text-[18px] font-extrabold tracking-[-0.08em] text-[#0F172A] shadow-[0_8px_24px_rgba(129,230,217,0.14)] font-heading\" data-kid=\"1-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    AD\n                </div>\n                <nav aria-label=\"Navegación principal\" class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"1-1-1-1-2\" data-name=\"primary navigation rail\">\n                    <button aria-label=\"Resumen\" class=\"flex h-11 w-11 items-center justify-center rounded-full text-[19px] hover:bg-[#1E293B] hover:text-[#81E6D9]\" data-kid=\"1-1-1-1-2-1\" data-name=\"dashboard rail button\">\n                        <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Usuarios\" class=\"flex h-11 w-11 items-center justify-center rounded-full text-[19px] hover:bg-[#1E293B] hover:text-[#81E6D9]\" data-kid=\"1-1-1-1-2-2\" data-name=\"users rail button\">\n                        <i class=\"ti ti-users\" data-kid=\"1-1-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex h-11 w-11 items-center justify-center rounded-full text-[19px] hover:bg-[#1E293B] hover:text-[#81E6D9]\" data-kid=\"1-1-1-1-2-3\" data-name=\"workshops rail button\">\n                        <i class=\"ti ti-building-store\" data-kid=\"1-1-1-1-2-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Logs\" class=\"flex h-11 w-11 items-center justify-center rounded-full border-l-2 border-[#81E6D9] bg-[#1E293B] text-[19px] text-[#81E6D9]\" data-kid=\"1-1-1-1-2-4\" data-name=\"active logs rail button\">\n                        <i class=\"ti ti-list-details\" data-kid=\"1-1-1-1-2-4-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Reseñas\" class=\"flex h-11 w-11 items-center justify-center rounded-full text-[19px] hover:bg-[#1E293B] hover:text-[#81E6D9]\" data-kid=\"1-1-1-1-2-5\" data-name=\"reviews rail button\">\n                        <i class=\"ti ti-star\" data-kid=\"1-1-1-1-2-5-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </nav>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 border-t border-[#334155] pt-5 text-[#94A3B8]\" data-kid=\"1-1-1-2\" data-name=