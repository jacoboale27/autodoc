xt-[#CBD5E1]\" data-kid=\"2-2-5-2-2-3\" data-name=\"Log event description\">\n                        Marcó una reseña para revisión manual\n                    </div>\n                </article>\n                <article class=\"space-y-3 px-4 py-4\" data-kid=\"2-2-5-2-3\" data-name=\"Log entry\">\n                    <div class=\"flex items-center justify-between text-[10px] uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-5-2-3-1\" data-name=\"Log header meta\">\n                        <span data-kid=\"2-2-5-2-3-1-1\" data-name=\"Hora label\">\n                            Hora\n                        </span>\n                        <span class=\"tabular-nums text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-2-5-2-3-1-2\" data-name=\"Log timestamp\" data-reason=\"text updated by log refresh script\">\n                            08:30\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-3 text-[12px]\" data-kid=\"2-2-5-2-3-2\" data-name=\"Log details\">\n                        <div data-kid=\"2-2-5-2-3-2-1\" data-name=\"Actor meta\">\n                            <div class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-5-2-3-2-1-1\" data-name=\"Actor label\">\n                                Actor\n                            </div>\n                            <div class=\"mt-1 font-semibold text-[#E2E8F0]\" data-kid=\"2-2-5-2-3-2-1-2\" data-name=\"Actor name\">\n                                Superadmin\n                            </div>\n                        </div>\n                        <div data-kid=\"2-2-5-2-3-2-2\" data-name=\"State meta\">\n                            <div class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-5-2-3-2-2-1\" data-name=\"State label\">\n                                Estado\n                            </div>\n                            <div class=\"mt-1 flex items-center gap-2 font-semibold text-[#FCA5A5]\" data-kid=\"2-2-5-2-3-2-2-2\" data-name=\"Status badge\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#F87171]\" data-kid=\"2-2-5-2-3-2-2-2-1\" data-name=\"Status indicator\">\n                                </span>\n                                Crítico\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"text-[12px] text-[#CBD5E1]\" data-kid=\"2-2-5-2-3-3\" data-name=\"Log event description\">\n                        Bloqueó una cuenta sospechosa\n                    </div>\n                </article>\n            </div>\n        </section>\n        <footer class=\"mt-7 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"Page footer\">\n            <div data-kid=\"2-2-6-1\" data-name=\"Footer branding text\">\n                AutoDoc · Consola de administración\n            </div>\n            <div class=\"mt-2 flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-2-6-2\" data-name=\"System status footer text\" data-reason=\"synchronization status timestamp updated by polling script\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-6-2-1\" data-name=\"System status dot\">\n                </span>\n                Datos sincronizados hace 2 min\n            </div>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación de administración\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/[.98] px-2 pb-[max(10px,env(safe-area-inset-bottom))] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"Mobile bottom navigation bar\">\n        <div class=\"grid grid-cols-5 gap-1\" data-kid=\"2-3-1\" data-name=\"Navigation links grid\">\n            <a aria-current=\"page\" class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-3-1-1\" data-name=\"Dashboard navigation link\" href=\"#resumen\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"2-3-1-1-1\" data-name=\"Dashboard icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-1-2\" data-name=\"Dashboard label\">\n                    Resumen\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"Users navigation link\" href=\"#usuarios\">\n                <i class=\"ti ti-users text-[18px]\" data-kid=\"2-3-1-2-1\" data-name=\"Users icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px]\" data-kid=\"2-3-1-2-2\" data-name=\"Users label\">\n                    Usuarios\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"Workshops navigation link\" href=\"#talleres\">\n                <i class=\"ti ti-building-store text-[18px]\" data-kid=\"2-3-1-3-1\" data-name=\"Workshops icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px]\" data-kid=\"2-3-1-3-2\" data-name=\"Workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a class=\"relative flex min-h-[54px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-4\" data-name=\"Reviews navigation link\" href=\"#resenias\">\n                <i class=\"ti ti-star text-[18px]\" data-kid=\"2-3-1-4-1\" data-name=\"Reviews icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px]\" data-kid=\"2-3-1-4-2\" data-name=\"Reviews label\">\n                    Reseñas\n                </span>\n                <span class=\"absolute right-2 top-1 h-4 min-w-4 rounded-[4px] bg-[#422006] px-1 text-center text-[10px] font-bold leading-4 text-[#FCD34D]\" data-dynamic=\"true\" data-kid=\"2-3-1-4-3\" data-name=\"Reviews count badge\" data-reason=\"count updated by notifications script\">\n                    7\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-5\" data-name=\"Logs navigation link\" href=\"#logs\">\n                <i class=\"ti ti-terminal-2 text-[18px]\" data-kid=\"2-3-1-5-1\" data-name=\"Logs icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px]\" data-kid=\"2-3-1-5-2\" data-name=\"Logs label\">\n                    Logs\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
