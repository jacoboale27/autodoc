          <div class=\"mb-3 flex items-end justify-between\" data-kid=\"2-1-3-2-4-1\" data-name=\"Workshops directory header\">\n                        <div data-kid=\"2-1-3-2-4-1-1\" data-name=\"Workshops directory title\">\n                            <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold tracking-[-0.02em] text-white\" data-kid=\"2-1-3-2-4-1-1-1\">\n                                Talleres cerca de ti\n                            </h2>\n                            <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-1-2\">\n                                Opciones con mejor valoración para tu próxima revisión.\n                            </p>\n                        </div>\n                        <a class=\"flex items-center gap-2 text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-4-1-2\" data-name=\"Workshops directory description\" href=\"#\">\n                            Ver directorio\n                            <i class=\"ti ti-arrow-up-right text-[14px]\" data-kid=\"2-1-3-2-4-1-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"border-y border-[#475569]\" data-kid=\"2-1-3-2-4-2\" data-name=\"Workshops directory table\">\n                        <div class=\"grid grid-cols-[1.5fr_0.7fr_0.7fr_1fr] border-b border-[#334155] px-4 py-3 text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-3-2-4-2-1\" data-name=\"Table header\">\n                            <div data-kid=\"2-1-3-2-4-2-1-1\" data-name=\"Workshop column label\">\n                                Taller\n                            </div>\n                            <div data-kid=\"2-1-3-2-4-2-1-2\" data-name=\"Distance column label\">\n                                Distancia\n                            </div>\n                            <div data-kid=\"2-1-3-2-4-2-1-3\" data-name=\"Rating column label\">\n                                Valoración\n                            </div>\n                            <div class=\"text-right\" data-kid=\"2-1-3-2-4-2-1-4\" data-name=\"Action column label\">\n                                Acción\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-[1.5fr_0.7fr_0.7fr_1fr] items-center border-b border-[#334155] px-4 py-4\" data-kid=\"2-1-3-2-4-2-2\" data-name=\"First workshop row\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-4-2-2-1\" data-name=\"Workshop name\">\n                                <span class=\"flex h-8 w-8 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-2-1-1\" data-name=\"Workshop icon wrapper\">\n                                    <i class=\"ti ti-tool text-[16px]\" data-kid=\"2-1-3-2-4-2-2-1-1-1\" data-name=\"Workshop icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-2-2-1-2\" data-name=\"Workshop name text\">\n                                    Taller Rápido\n                                </span>\n                            </div>\n                            <div class=\"text-[12px] tabular-nums text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-2-2-2\" data-name=\"Workshop distance value\">\n                                1.8 km\n                            </div>\n                            <div class=\"flex items-center gap-1 text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-4-2-2-3\" data-name=\"Workshop rating value\">\n                                <i class=\"ti ti-star-filled text-[13px]\" data-kid=\"2-1-3-2-4-2-2-3-1\" data-name=\"Star icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                4.9\n                            </div>\n                            <div class=\"text-right\" data-kid=\"2-1-3-2-4-2-2-4\" data-name=\"Contact workshop action button\">\n                                <button class=\"text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-2-4-1\">\n                                    Contactar\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-[1.5fr_0.7fr_0.7fr_1fr] items-center border-b border-[#334155] px-4 py-4\" data-kid=\"2-1-3-2-4-2-3\" data-name=\"Second workshop row\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-4-2-3-1\" data-name=\"Workshop name\">\n                                <span class=\"flex h-8 w-8 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-3-1-1\" data-name=\"Workshop icon wrapper\">\n                                    <i class=\"ti ti-tool text-[16px]\" data-kid=\"2-1-3-2-4-2-3-1-1-1\" data-name=\"Workshop icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-2-3-1-2\" data-name=\"Workshop name text\">\n                                    MotorLab\n                                </span>\n                            </div>\n                            <div class=\"text-[12px] tabular-nums text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-2-3-2\" data-name=\"Workshop distance value\">\n                                3.4 km\n                            </div>\n                            <div class=\"flex items-center gap-1 text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-4-2-3-3\" data-name=\"Workshop rating value\">\n                                <i class=\"ti ti-star-filled text-[13px]\" data-kid=\"2-1-3-2-4-2-3-3-1\" data-name=\"Star icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                4.8\n                            </div>\n                            <div class=\"text-right\" data-kid=\"2-1-3-2-4-2-3-4\" data-name=\"Contact workshop action button\">\n                                <button class=\"text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-3-4-1\">\n                                    Contactar\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-[1.5fr_0.7fr_0.7fr_1fr] items-center px-4 py-4\" data-kid=\"2-1-3-2-4-2-4\" data-name=\"Third workshop row\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-4-2-4-1\" data-name=\"Workshop name\">\n                                <span class=\"flex h-8 w-8 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-4-1-1\" data-name=\"Workshop icon wrapper\">\n                                    <i class=\"ti ti-tool text-[16px]\" data-kid=\"2-1-3-2-4-2-4-1-1-1\" data-name=\"Workshop icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-2-4-1-2\" data-name=\"Workshop name text\">\n                                    Centro Auto\n                                </span>\n                            </div>\n                            <div class=\"text-[12px] tabular-nums text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-2-4-2\" data-name=\"Workshop distance value\">\n                                5.1 km\n                            </div>\n                            <div class=\"flex items-center gap-1 text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-4-2-4-3\" data-name=\"Workshop rating value\">\n                                <i class=\"ti ti-star-filled text-[13px]\" data-kid=\"2-1-3-2-4-2-4-3-1\" data-name=\"Star icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                4.6\n                            </div>\n                            <div class=\"text-right\" data-kid=\"2-1-3-2-4-2-4-4\" data-name=\"Contact workshop action button\">\n                                <button class=\"text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-4-4-1\">\n                                    Contactar\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <footer class=\"mt-9 flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-5\" data-name=\"Dashboard footer\">\n                    <span data-kid=\"2-1-3-2-5-1\" data-name=\"Footer branding text\">\n                        AutoDoc · Diagnóstico y mantenimiento para tu vehículo\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-1-3-2-5-2\" data-name=\"sync status section\" data-reason=\"text updated periodically by synchronization script\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-5-2-1\" data-name=\"Sync status indicator dot\">\n                        </span>\n                        Datos sincronizados hace 4 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
