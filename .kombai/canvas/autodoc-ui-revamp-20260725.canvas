      "html": "<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"dashboard page layout container\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"main content structure wrapper\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"sidebar navigation panel\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc brand logo abbreviation\">\n                AD\n            </div>\n            <div class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary navigation button group\">\n                <button aria-label=\"Inicio\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard navigation button\">\n                    <i class=\"ti ti-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Mi garaje\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"my garage navigation button\">\n                    <i class=\"ti ti-car\" data-kid=\"2-1-1-2-2-1\" data-name=\"car icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"workshops navigation button\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-3-1\" data-name=\"wrench tool icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Alertas\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-4\" data-name=\"alerts navigation button\">\n                    <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-1-2-4-1\" data-name=\"alert triangle icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Historial\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-5\" data-name=\"history navigation button\">\n                    <i class=\"ti ti-history\" data-kid=\"2-1-1-2-5-1\" data-name=\"history clock icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"utility navigation button group\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help navigation button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help circle icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings navigation button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings gear icon\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"secondary sidebar container\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"account status header container\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"account label text\">\n                    Espacio personal\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"account ownership status indicator\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"online status dot\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"ownership role text\">\n                        Propietario\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"main vertical navigation list\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-2.5 text-[14px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-2-1\" data-name=\"active navigation link\" href=\"#inicio\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-1-1\" data-name=\"dashboard link icon container\">\n                        <i class=\"ti ti-dashboard\" data-kid=\"2-1-2-2-1-1-1\" data-name=\"dashboard link icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-1-2-2-1-2\" data-name=\"dashboard link label text\">\n                        Inicio\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-2\" data-name=\"navigation link\" href=\"#garaje\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-2-1\" data-name=\"navigation link icon container\">\n                        <i class=\"ti ti-car\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"car link icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-1-2-2-2-2\" data-name=\"navigation link label text\">\n                        Mi garaje\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-3\" data-name=\"navigation link\" href=\"#talleres\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-3-1\" data-name=\"navigation link icon container\">\n                        <i class=\"ti ti-tool\" data-kid=\"2-1-2-2-3-1-1\" data-name=\"wrench link icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-1-2-2-3-2\" data-name=\"navigation link label text\">\n                        Talleres\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-4\" data-name=\"navigation link\" href=\"#alertas\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-4-1\" data-name=\"navigation link icon container\">\n                        <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-2-2-4-1-1\" data-name=\"alert link icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-1-2-2-4-2\" data-name=\"navigation link label text\">\n                        Alertas\n                        <span class=\"ml-1 text-[11px] font-bold text-[#EF4444]\" data-kid=\"2-1-2-2-4-2-1\" data-name=\"alert count badge\">\n                            1\n                        </span>\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-5\" data-name=\"navigation link\" href=\"#historial\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-5-1\" data-name=\"navigation link icon container\">\n                        <i class=\"ti ti-history\" data-kid=\"2-1-2-2-5-1-1\" data-name=\"history link icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-1-2-2-5-2\" data-name=\"navigation link label text\">\n                        Historial\n                    </span>\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"user profile summary section\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\" data-name=\"user account details\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3-1-1\" data-name=\"user initials badge\">\n                        JP\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\" data-name=\"user profile text container\">\n                        <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-3-1-2-1\" data-name=\"user full name text\">\n                            Juan Pérez\n                        </p>\n   