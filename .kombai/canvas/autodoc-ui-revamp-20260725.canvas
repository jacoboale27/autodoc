      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" style=\"font-family:'IBM Plex Sans',sans-serif\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[18px] font-extrabold tracking-[-0.08em] text-[#020617]\" data-kid=\"2-1-1-1-1\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    AD\n                </div>\n                <nav aria-label=\"Navegación principal\" class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-1-2\">\n                    <button aria-label=\"Inicio\" class=\"flex h-10 w-10 items-center justify-center text-[19px]\" data-kid=\"2-1-1-1-2-1\">\n                        <i class=\"ti ti-layout-dashboard\" data-kid=\"2-1-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Mi garaje\" class=\"flex h-10 w-10 items-center justify-center text-[19px]\" data-kid=\"2-1-1-1-2-2\">\n                        <i class=\"ti ti-steering-wheel\" data-kid=\"2-1-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex h-10 w-10 items-center justify-center text-[19px]\" data-kid=\"2-1-1-1-2-3\">\n                        <i class=\"ti ti-tool\" data-kid=\"2-1-1-1-2-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Mensajes\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[19px] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-4\">\n                        <i class=\"ti ti-message-2\" data-kid=\"2-1-1-1-2-4-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </nav>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center text-[19px]\" data-kid=\"2-1-1-2-1\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center text-[19px]\" data-kid=\"2-1-1-2-2\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\">\n            