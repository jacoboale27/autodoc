      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"notifications application root\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"notifications app shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"notifications icon rail\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\" data-name=\"rail primary actions\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[18px] font-extrabold tracking-[-0.08em] text-[#082F49] shadow-[0_8px_24px_rgba(56,189,248,0.18)] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    AD\n                </div>\n                <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-1-2\" data-name=\"rail navigation buttons\">\n                    <button aria-label=\"Inicio\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-1\">\n                        <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Mi garaje\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-2\">\n                        <i class=\"ti ti-steering-wheel text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-3\">\n                        <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-4\">\n                        <i class=\"ti ti-bell text-[19px]\" data-kid=\"2-1-1-1-2-4-2\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-1-2-4-1\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Historial\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-5\">\n                        <i class=\"ti ti-history text-[19px]\" data-kid=\"2-1-1-1-2-5-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\" data-name=\"rail utility actions\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-1\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-2\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\" data-name=\"context navigation sidebar\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\" data-name=\"sidebar account header\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\">\n                    Propietario\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-2-1-2\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-2-1-2-1\">\n                        Auto\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\">\n                            Doc\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-2-1-2-2\">\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"flex-1 px-4 py-6\" data-kid=\"2-1-2-2\" data-name=\"sidebar navigation links\">\n                <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-1\">\n                    Espacio de trabajo\n                </div>\n                <div class=\"space-y-1\" data-kid=\"2-1-2-2-2\">\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-1\" href=\"#\">\n                        <i class=\"ti ti-home-2 text-[17px]\" data-kid=\"2-1-2-2-2-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Inicio\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-2\" href=\"#\">\n                        <i class=\"ti ti-car text-[17px]\" data-kid=\"2-1-2-2-2-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Mi garaje\n                        <span class=\"ml-auto text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-1-2-2-2-2-2\">\n                            02\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-3\" href=\"#\">\n                        <i class=\"ti ti-tool text-[17px]\" data-kid=\"2-1-2-2-2-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Talleres\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-3 py-3 text-[13px] font-semibold text-white\" data-kid=\"2-1-2-2-2-4\" href=\"#\">\n                        <i class=\"ti ti-bell text-[17px] text-[#38BDF8]\" data-kid=\"2-1-2-2-2-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Notificaciones\n                        <span class=\"ml-auto rounded-[4px] bg-[#7F1D1D] px-1.5 py-0.5 text-[10px] font-bold text-[#FCA5A5]\" data-kid=\"2-1-2-2-2-4-2\">\n                            02\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-5\" href=\"#\">\n                        <i class=\"ti ti-history text-[17px]\" data-kid=\"2-1-2-2-2-5-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Historial\n                    </a>\n                </div>\n                <div class=\"mt-10 border-t border-[#334155] pt-7\" data-kid=\"2-1-2-2-3\">\n                    <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-3-1\">\n                        Acceso rápido\n                    </div>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-2\" href=\"#\">\n                        <i class=\"ti ti-calendar-plus text-[17px] text-[#818CF8]\" data-kid=\"2-1-2-2-3-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Agendar servicio\n                    </a>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-3\" href=\"#\">\n                        <i class=\"ti ti-message-circle text-[17px]\" data-kid=\"2-1-2-2-3-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Conversaciones\n                    </a>\n                </div>\n            </nav>\n            <div class=\"border-t border-[#334155] px-5 py-5\" data-kid=\"2-1-2-3\" data-name=\"sidebar profile summary\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-3-1-1\">\n                        JP\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\">\n                        <div class=\"truncate text-[12px] font-semibold text-white\" data-kid=\"2-1-2-3-1-2-1\">\n                            Juan Pérez\n                        </div>\n                        <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\">\n                            Plan personal\n                        </div>\n                    </div>\n                    <i class=\"ti ti-dots ml-auto text-[16px] text-[#64748B]\" data-kid=\"2-1-2-3-1-3\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[#0F172A]\" data-kid=\"2-1-3\" data-name=\"notifications main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#334155] px-8\" data-kid=\"2-1-3-1\" data-name=\"notifications top bar\">\n                <div class=\"flex items-center gap-3 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-1-1\">\n                    <span data-kid=\"2-1-3-1-1-1\">\n                        Propietario\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-1-3-1-1-2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-1-1-3\">\n                        Notificaciones\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-6\" data-kid=\"2-1-3-1-2\">\n                    <div class=\"text-right\" data-kid=\"2-1-3-1-2-1\">\n                        <div class=\"text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-1\" data-name=\"current date display\" data-reason=\"text replaced by system date script\">\n                            Sábado, 15 ago 2026\n                        </div>\n                        <div class=\"mt-0.5 text-[12px] font-semibold text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-2\" data-name=\"current time display\" data-reason=\"text replaced by system time script\">\n                            09:14 a. m.\n                        </div>\n                    </div>\n                    <div class=\"h-5 w-px bg-[#334155]\" data-kid=\"2-1-3-1-2-2\">\n                    </div>\n                    <button aria-label=\"Cambiar tema\" class=\"flex h-9 w-9 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-3-1-2-3\">\n                        <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-3-1-2-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex h-9 w-9 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-3-1-2-4\">\n                        <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-3-1-2-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-3-1-2-4-2\">\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-3 border-l border-[#334155] pl-5\" data-kid=\"2-1-3-1-2-5\">\n                        <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-1-2-5-1\">\n                            JP\n                        </div>\n                        <div class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-1-2-5-2\">\n                            Juan Pérez\n                        </div>\n                        <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-1-3-1-2-5-3\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1040px] px-8 pb-14 pt-8\" data-kid=\"2-1-3-2\" data-name=\"notifications content wrapper\">\n                <div class=\"flex items-end justify-between gap-6 border-b border-[#334155] pb-7\" data-kid=\"2-1-3-2-1\" data-name=\"notifications title row\">\n                    <div data-kid=\"2-1-3-2-1-1\">\n                        <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[30px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-1-3-2-1-1-1\">\n                            Notificaciones\n                        </h1>\n                        <p class=\"mt-2 text-[14px] text-[#94A3B8]\" data-kid=\"2-1-3-2-1-1-2\">\n                            Mantente al día con el estado de tus vehículos y servicios.\n                        </p>\n                    </div>\n                    <button class=\"flex min-h-12 items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-5 py-3 text-[12px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-3-2-1-2\" data-name=\"mark all notifications as read button\">\n                        <i class=\"ti ti-checks text-[15px] text-[#38BDF8]\" data-kid=\"2-1-3-2-1-2-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Marcar todas como leídas\n                    </button>\n                </div>\n                <div class=\"flex items-center justify-between border-b border-[#334155] py-5\" data-kid=\"2-1-3-2-2\" data-name=\"notification filters\">\n                    <div class=\"flex items-center gap-6 text-[12px]\" data-kid=\"2-1-3-2-2-1\">\n                        <button class=\"border-b-2 border-[#38BDF8] pb-3 font-semibold text-white\" data-kid=\"2-1-3-2-2-1-1\">\n                            Todas\n                            <span class=\"ml-1 text-[#38BDF8] tabular-nums\" data-kid=\"2-1-3-2-2-1-1-1\">\n                                5\n                            </span>\n                        </button>\n                        <button class=\"pb-3 font-medium text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-2\">\n                            No leídas\n                            <span class=\"ml-1 rounded-[4px] bg-[#7F1D1D] px-1.5 py-0.5 text-[10px] font-bold text-[#FCA5A5]\" data-kid=\"2-1-3-2-2-1-2-1\">\n                                2\n                            </span>\n                        </button>\n                    </div>\n                    <span class=\"text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-2\" data-name=\"auto-update status indicator\" data-reason=\"text replaced by sync status script\">\n                        Actualización automática activa\n                    </span>\n                </div>\n                <section aria-labelledby=\"today-heading\" class=\"pt-7\" data-kid=\"2-1-3-2-3\" data-name=\"today notifications section\">\n                    <div class=\"mb-3 flex items-center justify-between\" data-kid=\"2-1-3-2-3-2\">\n                        <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[16px] font-bold text-white\" data-kid=\"2-1-3-2-3-2-1\" id=\"today-heading\">\n                            Hoy\n                        </h2>\n                        <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2\">\n                            3 novedades\n                        </span>\n                    </div>\n                    <div class=\"border-y border-[#334155]\" data-kid=\"2-1-3-2-3-1\" data-name=\"today notification list\">\n                        <div class=\"flex items-start gap-4 border-b border-[#334155] border-l-2 border-l-[#F87171] bg-[#16202F] px-4 py-4\" data-kid=\"2-1-3-2-3-1-1\" data-name=\"unread SOAT notification\">\n                            <div class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#F87171]/40 bg-[#3F1D25] text-[#FCA5A5]\" data-kid=\"2-1-3-2-3-1-1-1\">\n                                <i class=\"ti ti-shield-exclamation text-[18px]\" data-kid=\"2-1-3-2-3-1-1-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"2-1-3-2-3-1-1-2\">\n                                <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-1-3-2-3-1-1-2-1\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-3-1-1-2-1-1\">\n                                        <h3 class=\"text-[13px] font-semibold text-white\" data-kid=\"2-1-3-2-3-1-1-2-1-1-1\">\n                                            SOAT vencido\n                                        </h3>\n                                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-3-2-3-1-1-2-1-1-2\">\n                                        </span>\n                                    </div>\n                                    <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-3-1-1-2-1-2\" data-name=\"relative time string\" data-reason=\"text updated as time elapses by script\">\n                                        Hace 8 min\n                                    </time>\n                                </div>\n                                <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-1-1-2-2\">\n                                    Toyota Corolla 2022 · P 482-916\n                                </p>\n                                <p class=\"mt-2 text-[12px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-1-1-2-3\">\n                                    Renueva la cobertura para mantener tu vehículo en regla.\n                                </p>\n                            </div>\n                            <button aria-label=\"Abrir notificación SOAT vencido\" class=\"mt-1 text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1-3\">\n                                <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-1-3-2-3-1-1-3-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"flex items-start gap-4 border-b border-[#334155] border-l-2 border-l-[#FBBF24] bg-[#16202F] px-4 py-4\" data-kid=\"2-1-3-2-3-1-2\" data-name=\"unread brake notification\">\n                            <div class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#FBBF24]/40 bg-[#3B2A0E] text-[#FCD34D]\" data-kid=\"2-1-3-2-3-1-2-1\">\n                                <i class=\"ti ti-tool text-[18px]\" data-kid=\"2-1-3-2-3-1-2-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"2-1-3-2-3-1-2-2\">\n                                <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-1-3-2-3-1-2-2-1\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-3-1-2-2-1-1\">\n                                        <h3 class=\"text-[13px] font-semibold text-white\" data-kid=\"2-1-3-2-3-1-2-2-1-1-1\">\n                                            Pastillas próximas\n                                        </h3>\n                                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#FBBF24]\" data-kid=\"2-1-3-2-3-1-2-2-1-1-2\">\n                                        </span>\n                                    </div>\n                                    <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-3-1-2-2-1-2\" data-name=\"relative time string\" data-reason=\"text updated as time elapses by script\">\n                                        Hace 32 min\n                                    </time>\n                                </div>\n                                <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-1-2-2-2\">\n                                    Toyota Corolla 2022 · revisión preventiva\n                                </p>\n                                <p class=\"mt-2 text-[12px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-1-2-2-3\">\n                                    Revisión recomendada en\n                                    <strong class=\"font-semibold text-white tabular-nums\" data-kid=\"2-1-3-2-3-1-2-2-3-1\">\n                                        420 km\n                                    </strong>\n                                    .\n                                </p>\n                            </div>\n                            <button aria-label=\"Abrir notificación Pastillas próximas\" class=\"mt-1 text-[#64748B]\" data-kid=\"2-1-3-2-3-1-2-3\">\n                                <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-1-3-2-3-1-2-3-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"flex items-start gap-4 px-4 py-4\" data-kid=\"2-1-3-2-3-1-3\" data-name=\"read reservation notification\">\n                            <div class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#34D399]/40 bg-[#064E3B]/30 text-[#6EE7B7]\" data-kid=\"2-1-3-2-3-1-3-1\">\n                                <i class=\"ti ti-calendar-check text-[18px]\" data-kid=\"2-1-3-2-3-1-3-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"2-1-3-2-3-1-3-2\">\n                                <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-1-3-2-3-1-3-2-1\">\n                                    <h3 class=\"text-[13px] font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-2-3-1-3-2-1-1\">\n                                        Reserva confirmada\n                                    </h3>\n                                    <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-3-1-3-2-1-2\" data-name=\"relative time string\" data-reason=\"text updated as time elapses by script\">\n                                        Hace 1 h\n                                    </time>\n                                </div>\n                                <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-1-3-2-2\">\n                                    Taller Rápido · mañana, 10:00\n                                </p>\n                                <p class=\"mt-2 text-[12px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-1-3-2-3\">\n            