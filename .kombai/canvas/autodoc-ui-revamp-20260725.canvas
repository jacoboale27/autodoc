      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  button, select, input { font: inherit; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" style=\"--surface:#0F172A;--surface-container:#141E36;--surface-variant:#1E293B;--outline:#334155;--outline-strong:#475569;--primary:#81E6D9;--secondary:#522C81;--on-primary:#0F172A;--on-secondary:#FFFFFF;--text-primary:#F8FAFC;--text-secondary:#94A3B8;--success:#48BB78;--warning:#F6AD55;--error:#FC8181;--success-surface:#064E3B;--warning-surface:#422006;--error-surface:#3F1D25\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\" data-name=\"admin workshops application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[var(--outline)] bg-[#020617] py-6 text-[var(--text-secondary)]\" data-kid=\"1-1-1\" data-name=\"admin icon rail\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"1-1-1-1\">\n                <div aria-label=\"AutoDoc\" class=\"flex size-10 items-center justify-center rounded-[12px] bg-[var(--primary)] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-[var(--on-primary)] shadow-[0_8px_24px_rgba(129,230,217,0.14)]\" data-kid=\"1-1-1-1-1\">\n                    AD\n                </div>\n                <nav aria-label=\"Navegación principal\" class=\"flex flex-col items-center gap-5\" data-kid=\"1-1-1-1-2\">\n                    <button aria-label=\"Resumen\" class=\"flex size-11 items-center justify-center rounded-full text-[19px] hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-1-2-1\">\n                        <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Usuarios\" class=\"flex size-11 items-center justify-center rounded-full text-[19px] hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-1-2-2\">\n                        <i class=\"ti ti-users\" data-kid=\"1-1-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex size-11 items-center justify-center rounded-full border-l-2 border-[var(--primary)] bg-[var(--surface-variant)] text-[19px] text-[var(--primary)]\" data-kid=\"1-1-1-1-2-3\">\n                        <i class=\"ti ti-building-store\" data-kid=\"1-1-1-1-2-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Reseñas\" class=\"flex size-11 items-center justify-center rounded-full text-[19px] hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-1-2-4\">\n                        <i class=\"ti ti-star\" data-kid=\"1-1-1-1-2-4-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Logs\" class=\"flex size-11 items-center justify-center rounded-full text-[19px] hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-1-2-5\">\n                        <i class=\"ti ti-list-details\" data-kid=\"1-1-1-1-2-5-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </nav>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 border-t border-[var(--outline)] pt-5\" data-kid=\"1-1-1-2\">\n                <button aria-label=\"Configuración\" class=\"flex size-11 items-center justify-center rounded-full hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-2-1\">\n                    <i class=\"ti ti-settings\" data-kid=\"1-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex size-11 items-center justify-center rounded-full hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-2-2\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"1-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[var(--outline)] bg-[#0B1220]\" data-kid=\"1-1-2\" data-name=\"admin contextual sidebar\">\n            <div class=\"border-b border-[var(--outline)] px-6 py-7\" data-kid=\"1-1-2-1\">\n                <div class=\"text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-2-1-1\">\n                    Administración\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 font-heading\" data-kid=\"1-1-2-1-2\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em] text-[var(--text-primary)]\" data-kid=\"1-1-2-1-2-1\">\n                        Auto\n                        <span class=\"text-[var(--primary)]\" data-kid=\"1-1-2-1-2-1-1\">\n                            Doc\n                        </span>\n                    </span>\n                    <span class=\"size-1.5 rounded-full bg-[var(--success)]\" data-kid=\"1-1-2-1-2-2\">\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Centro de control\" class=\"flex-1 px-4 py-6\" data-kid=\"1-1-2-2\">\n                <div class=\"mb-3 px-3 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--text-secondary)]\" data-kid=\"1-1-2-2-1\">\n                    Centro de control\n                </div>\n                <div class=\"space-y-1\" data-kid=\"1-1-2-2-2\">\n                    <a class=\"flex min-h-[48px] items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[var(--text-secondary)] hover:bg-[var(--surface-variant)] hover:text-[var(--text-primary)]\" data-kid=\"1-1-2-2-2-1\" href=\"#resumen\">\n                        <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"1-1-2-2-2-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Resumen\n                    </a>\n                    <a class=\"flex min-h-[48px] items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[var(--text-secondary)] hover:bg-[var(--surface-variant)] hover:text-[var(--text-primary)]\" data-kid=\"1-1-2-2-2-2\" href=\"#usuarios\">\n                        <i class=\"ti ti-users text-[17px]\" data-kid=\"1-1-2-2-2-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Usuarios\n                    </a>\n                    <a aria-current=\"page\" class=\"flex min-h-[48px] items-center gap-3 border-l-2 border-[var(--primary)] bg-[var(--surface-variant)] px-3 py-3 text-[13px] font-semibold text-[var(--primary)]\" data-kid=\"1-1-2-2-2-3\" href=\"#talleres\">\n                        <i class=\"ti ti-building-store text-[17px]\" data-kid=\"1-1-2-2-2-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Talleres\n                        <span class=\"ml-auto rounded-[4px] bg-[var(--warning-surface)] px-1.5 py-0.5 text-[10px] font-bold text-[var(--warning)]\" data-kid=\"1-1-2-2-2-3-2\">\n                            03\n                        </span>\n                    </a>\n                    <a class=\"flex min-h-[48px] items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[var(--text-secondary)] hover:bg-[var(--surface-variant)] hover:text-[var(--text-primary)]\" data-kid=\"1-1-2-2-2-4\" href=\"#resenas\">\n                        <i class=\"ti ti-star text-[17px]\" data-kid=\"1-1-2-2-2-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Reseñas\n                    </a>\n                    <a class=\"flex min-h-[48px] items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[var(--text-secondary)] hover:bg-[var(--surface-variant)] hover:text-[var(--text-primary)]\" data-kid=\"1-1-2-2-2-5\" href=\"#logs\">\n                        <i class=\"ti ti-list-details text-[17px]\" data-kid=\"1-1-2-2-2-5-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Logs\n                    </a>\n                    <a class=\"flex min-h-[48px] items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[var(--text-secondary)] hover:bg-[var(--surface-variant)] hover:text-[var(--text-primary)]\" data-kid=\"1-1-2-2-2-6\" href=\"#seed\">\n                        <i class=\"ti ti-database-cog text-[17px]\" data-kid=\"1-1-2-2-2-6-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Seed\n                    </a>\n                </div>\n            </nav>\n            <div class=\"border-t border-[var(--outline)] px-5 py-5\" data-kid=\"1-1-2-3\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-3-1\">\n                    <div class=\"flex size-9 items-center justify-center rounded-full bg-[var(--surface-variant)] text-[12px] font-bold text-[var(--primary)]\" data-kid=\"1-1-2-3-1-1\">\n                        SA\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-1-2-3-1-2\">\n                        <div class=\"truncate text-[12px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-2-3-1-2-1\">\n                            Superadmin\n                        </div>\n                        <div class=\"text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-1-2-2\">\n                            Acceso interno\n                        </div>\n                    </div>\n                    <i class=\"ti ti-dots ml-auto text-[16px] text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-1-3\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[var(--surface)]\" data-kid=\"1-1-3\" data-name=\"admin workshops main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[var(--outline)] px-8\" data-kid=\"1-1-3-1\" data-name=\"admin top bar\">\n                <div class=\"flex items-center gap-3 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-1-1\">\n                    <span data-kid=\"1-1-3-1-1-1\">\n                        Admin\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"1-1-3-1-1-2