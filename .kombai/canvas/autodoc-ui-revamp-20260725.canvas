      "html": "<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen w-full overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile dashboard page layout\">\n    <header class=\"sticky top-0 z-10 flex h-16 items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"compact mobile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"brand and screen context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[17px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc brand logo abbreviation\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"account context container\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"account role label\">\n                    Propietario\n                </p>\n                <p class=\"truncate text-[15px] font-heading font-bold text-[#0F172A]\" data-kid=\"2-1-1-2-2\" data-name=\"current page label\">\n                    Inicio\n                </p>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile top actions\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[20px] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"bell icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-[10px] top-[9px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\" data-name=\"notification dot badge\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[20px] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-2-2\" data-name=\"theme toggle button\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-2-2-1\" data-name=\"moon icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"px-4 pb-32 pt-6\" data-kid=\"2-2\" data-name=\"mobile dashboard scroll content\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"mobile content header\">\n            <h1 class=\"font-heading text-[27px] font-extrabold leading-[1.12] tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-1\" data-name=\"main dashboard heading\">\n                Tu vehículo, en control\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-2\" data-name=\"dashboard description paragraph\">\n                Consulta el estado de tu auto y actúa antes de que un detalle se convierta en una reparación.\n            </p>\n            <button class=\"mt-4 flex min-h-11 w-full items-center justify-center gap-2 border border-[#CBD5E1] bg-white px-4 py-2.5 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-1-3\" data-name=\"refresh data button\">\n                <span class=\"text-[17px] text-[#1E88E5]\" data-kid=\"2-2-1-3-1\" data-name=\"refresh icon container\">\n                    <i class=\"ti ti-refresh\" data-kid=\"2-2-1-3-1-1\" data-name=\"refresh icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                Actualizar datos\n            </button>\n        </div>\n        <section aria-labelledby=\"mobile-vehicle-heading\" class=\"overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-white shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-2-2\" data-name=\"stacked vehicle summary card\">\n            <div class=\"relative aspect-[1.55] w-full bg-[#E2E8F0]\" data-kid=\"2-2-2-1\" data-name=\"vehicle image background\">\n                <img alt=\"Sedán Hyundai en perfil, fotografía de Hyundai Motor Group en Pexels\" class=\"h-full w-full object-cover\" data-kid=\"2-2-2-1-1\" data-name=\"vehicle display image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14696345/pexels-photo-14696345.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                <div class=\"absolute bottom-3 left-3 border border-white/70 bg-[#0F172A]/80 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-white\" data-kid=\"2-2-2-1-2\" data-name=\"vehicle badge text\">\n                    Vehículo principal\n                </div>\n            </div>\n            <div class=\"p-5\" data-kid=\"2-2-2-2\" data-name=\"vehicle details content\">\n                <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-2-2-1\" data-name=\"vehicle status row\">\n                    <span class=\"inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.16em] text-[#10B981]\" data-kid=\"2-2-2-2-1-1\" data-name=\"status label text\">\n                        <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"status dot\">\n                        </span>\n                        Activo\n                    </span>\n                    <button aria-label=\"Más opciones\" class=\"grid size-11 place-items-center text-[19px] text-[#64748B]\" data-kid=\"2-2-2-2-1-2\" data-name=\"card menu button\">\n                        <i class=\"ti ti-dots\" data-kid=\"2-2-2-2-1-2-1\" data-name=\"menu dots icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <h2 class=\"mt-2 font-heading text-[25px] font-extrabold leading-tight tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-2-2-2\" data-name=\"vehicle name heading\" id=\"mobile-vehicle-heading\">\n                    Toyota Corolla 2022\n                </h2>\n                <p class=\"mt-1 text-[13px] font-semibold tracking-[0.18em] text-[#64748B]\" data-kid=\"2-2-2-2-3\" data-name=\"vehicle license plate\">\n                    P 482-916\n                </p>\n                <div class=\"mt-5 grid grid-cols-2 gap-3 border-y border-[#E2E8F0] py-4\" data-kid=\"2-2-2-2-4\" data-name=\"vehicle metrics grid\">\n                    <div class=\"min-w-0\" data-kid=\"2-2-2-2-4-1\" data-name=\"mileage display group\">\n                        <p class=\"text-[10px] font-semibold uppercase leading-4 tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-2-2-4-1-1\" data-name=\"mileage label\">\n                            Kilometraje actual\n                        </p>\n                        <p class=\"mt-1 font-heading text-[22px] font-bold tracking-[-0.04em] text-[#0F172A]\" data-kid=\"2-2-2-2-4-1-2\" data-name=\"mileage value text\">\n                            48,260\n                            <span class=\"font-body text-[12px] font-semibold tracking-normal text-[#64748B]\" data-kid=\"2-2-2-2-4-1-2-1\" data-name=\"mileage unit label\">\n                                km\n                            </span>\n                        </p>\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-2-2-2-4-2\" data-name=\"last service display group\">\n                        <p class=\"text-[10px] font-semibold uppercase leading-4 tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-2-2-4-2-1\" data-name=\"service date label\">\n                            Último servicio\n                        </p>\n                        <p class=\"mt-1 font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-2-2-2-4-2-2\" data-name=\"service date text\">\n                            12 jun 2026\n                        </p>\n                        <p class=\"mt-0.5 truncate text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-4-2-3\" data-name=\"service shop name\">\n                            Taller Rápido\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-4\" data-kid=\"2-2-2-2-5\" data-name=\"vehicle card footer row\">\n                    <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-5-1\" data-name=\"update timestamp text\">\n                        Actualizado hace 8 min\n                    </p>\n                    <button class=\"mt-3 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#45236F] px-5 py-3 text-[13px] font-semibold text-white shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.97]\" data-kid=\"2-2-2-2-5-2\" data-name=\"details call-to-action button\">\n                        Ver ficha completa\n                        <span class=\"text-[16px]\" data-kid=\"2-2-2-2-5-2-1\" data-name=\"arrow icon container\">\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"2-2-2-2-5-2-1-1\" data-name=\"arrow icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"mobile-maintenance-heading\" class=\"mt-8\" data-kid=\"2-2-3\" data-name=\"maintenance diagnosis section\">\n            <div class=\"mb-4\" data-kid=\"2-2-3-1\" data-name=\"section title group\">\n                <h2 class=\"font-heading text-[21px] font-bold leading-tight tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-3-1-1\" data-name=\"diagnosis heading\" id=\"mobile-maintenance-heading\">\n                    Estado de mantenimiento\n                </h2>\n                <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-1-2\" data-name=\"monitored systems count text\">\n                    3 sistemas monitorizados\n                </p>\n            </div>\n            <div class=\"overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-white shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-2-3-2\" data-name=\"maintenance labeled row list container\">\n                <div class=\"border-b border-[#E2E8F0] p-4\" data-kid=\"2-2-3-2-1\" data-name=\"motor status row\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-3-2-1-1\">\n                        <span class=\"font-semibold text-[13px] text-[#0F172A]\" data-kid=\"2-2-3-2-1-1-1\">\n                            Motor\n                        </span>\n                        <span class=\"flex shrink-0 items-center gap-2 text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-2-3-2-1-1-2\">\n                            <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-2-3-2-1-1-2-1\">\n                            </span>\n                            Óptimo\n                        </span>\n                    </div>\n                    <p class=\"mt-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-2-1-2\">\n                        Próxima revisión en\n                        <strong class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-3-2-1-2-1\">\n                            1,740 km\n                        </strong>\n                    </p>\n                </div>\n                <div class=\"border-b border-[#E2E8F0] p-4\" data-kid=\"2-2-3-2-2\" data-name=\"brakes status row\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-3-2-2-1\">\n                        <span class=\"font-semibold text-[13px] text-[#0F172A]\" data-kid=\"2-2-3-2-2-1-1\">\n                            Frenos\n                        </span>\n                        <span class=\"flex shrink-0 items-center gap-2 text-[12px] font-semibold text-[#F59E0B]\" data-kid=\"2-2-3-2-2-1-2\">\n                            <span class=\"size-2 rounded-full bg-[#F59E0B]\" data-kid=\"2-2-3-2-2-1-2-1\">\n                            </span>\n                            Revisión pronta\n                        </span>\n                    </div>\n                    <p class=\"mt-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-2-2-2\">\n                        Cambiar pastillas en\n                        <strong class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-3-2-2-2-1\">\n                            420 km\n                        </strong>\n                    </p>\n                </div>\n                <div class=\"p-4\" data-kid=\"2-2-3-2-3\" data-name=\"insurance status row\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-3-2-3-1\">\n                        <span class=\"font-semibold text-[13px] text-[#0F172A]\" data-kid=\"2-2-3-2-3-1-1\">\n                            SOAT\n                        </span>\n                        <span class=\"flex shrink-0 items-center gap-2 text-[12px] font-semibold text-[#EF4444]\" data-kid=\"2-2-3-2-3-1-2\">\n                            <span class=\"size-2 rounded-full bg-[#EF4444]\" data-kid=\"2-2-3-2-3-1-2-1\">\n                            </span>\n                            Vencido\n                        </span>\n                    </div>\n                    <p class=\"mt-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-2-3-2\">\n                        Renovar antes del\n                        <strong class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-3-2-3-2-1\">\n                            18 ago 2026\n                        </strong>\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-4 border-l-4 border-[#EF4444] bg-[#FEF2F2] px-4 py-4\" data-kid=\"2-2-3-3\" data-name=\"urgent alert banner\">\n                <div class=\"flex items-start gap-3\" data-kid=\"2-2-3-3-1\">\n                    <span class=\"mt-0.5 shrink-0 text-[20px] text-[#EF4444]\" data-kid=\"2-2-3-3-1-1\" data-name=\"alert icon container\">\n                        <i class=\"ti ti-alert-triangle\" data-kid=\"2-2-3-3-1-1-1\" data-name=\"alert triangle icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0\" data-kid=\"2-2-3-3-1-2\">\n                        <p class=\"text-[13px] font-bold leading-5 text-[#991B1B]\" data-kid=\"2-2-3-3-1-2-1\" data-name=\"alert heading\">\n                            Acción requerida: SOAT vencido\n                        </p>\n                        <p class=\"mt-1 text-[12px] leading-5 text-[#7F1D1D]\" data-kid=\"2-2-3-3-1-2-2\" data-name=\"alert sub-text\">\n                            Renueva la cobertura para mantener tu vehículo habilitado.\n                        </p>\n                    </div>\n                </div>\n                <button class=\"mt-3 min-h-11 w-full border border-[#EF4444] bg-white px-3 py-2 text-[12px] font-bold text-[#B91C1C]\" data-kid=\"2-2-3-3-2\" data-name=\"resolve alert button\">\n                    Resolver ahora\n                </button>\n            </div>\n        </section>\n        <aside aria-labelledby=\"mobile-expense-heading\" class=\"mt-8 border-t border-[#CBD5E1] pt-6\" data-kid=\"2-2-4\" data-name=\"financial summary section\">\n            <h2 class=\"font-heading text-[21px] font-bold leading-tight tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-4-1\" data-name=\"financial section heading\" id=\"mobile-expense-heading\">\n                Resumen de gastos\n            </h2>\n            <p class=\"mt-2 text-[12px] leading-5 text-[#475569]\" data-kid=\"2-2-4-2\" data-name=\"financial summary paragraph\">\n                Acumulado de mantenimiento para tu vehículo principal.\n            </p>\n            <div class=\"mt-5 divide-y divide-[#E2E8F0] overflow-hidden rounded-[16px] border border-[#E2E8F0] bg-white shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-2-4-3\" data-name=\"financial stats list container\">\n                <div class=\"flex items-center justify-between gap-4 py-4\" data-kid=\"2-2-4-3-1\">\n                    <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-2-4-3-1-1\">\n                        Total este año\n                    </span>\n                    <strong class=\"font-heading text-[19px] text-[#0F172A]\" data-kid=\"2-2-4-3-1-2\">\n                        $684.50\n                    </strong>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 py-4\" data-kid=\"2-2-4-3-2\">\n                    <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-2-4-3-2-1\">\n                        Servicios registrados\n                    </span>\n                    <strong class=\"font-heading text-[19px] text-[#0F172A]\" data-kid=\"2-2-4-3-2-2\">\n                        7\n                    </strong>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 py-4\" data-kid=\"2-2-4-3-3\">\n                    <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-2-4-3-3-1\">\n                        Promedio por visita\n                    </span>\n                    <strong class=\"font-heading text-[19px] text-[#1E88E5]\" data-kid=\"2-2-4-3-3-2\">\n                        $97.79\n                    </strong>\n                </div>\n            </div>\n            <button class=\"mt-4 flex min-h-11 items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-4-4\" data-name=\"view history link button\">\n                Ver historial de servicios\n                <span class=\"text-[15px]\" data-kid=\"2-2-4-4-1\" data-name=\"arrow right icon container\">\n                    <i class=\"ti ti-arrow-right\" data-kid=\"2-2-4-4-1-1\" data-name=\"arrow right icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n            </button>\n        </aside>\n        <section aria-labelledby=\"mobile-workshops-heading\" class=\"mt-8 border-t border-[#CBD5E1] pt-6\" data-kid=\"2-2-5\" data-name=\"workshops section\">\n            <div class=\"flex items-end justify-between gap-3\" data-kid=\"2-2-5-1\" data-name=\"workshops header\">\n                <h2 class=\"font-heading text-[21px] font-bold leading-tight tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-5-1-1\" data-name=\"workshops section heading\" id=\"mobile-workshops-heading\">\n                    Talleres cerca de ti\n                </h2>\n                <a class=\"shrink-0 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-5-1-2\" data-name=\"directory link\" href=\"#directorio\">\n                    Ver directorio\n                    <span class=\"text-[15px]\" data-kid=\"2-2-5-1-2-1\">\n                        <i class=\"ti ti-arrow-up-right\" data-kid=\"2-2-5-1-2-1-1\" data-name=\"external link arrow icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                </a>\n            </div>\n            <div class=\"mt-4 divide-y divide-[#E2E8F0] overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-white shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-2-5-2\" data-name=\"workshops compact list\">\n                <article class=\"p-4\" data-kid=\"2-2-5-2-1\" data-name=\"workshop data row\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-2-5-2-1-1\">\n                        <span class=\"grid size-9 shrink-0 place-items-center border border-[#CBD5E1] text-[17px] text-[#1E88E5]\" data-kid=\"2-2-5-2-1-1-1\">\n                            <i class=\"ti ti-tool\" data-kid=\"2-2-5-2-1-1-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"2-2-5-2-1-1-2\">\n                            <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-1-1-2-1\">\n                                Taller Rápido\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-5-2-1-1-2-2\">\n                                1.8 km\n                            </p>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"2-2-5-2-1-1-3\">\n                            <p class=\"flex items-center justify-end gap-1 text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-1-1-3-1\">\n                                <span class=\"text-[13px] text-[#F59E0B]\" data-kid=\"2-2-5-2-1-1-3-1-1\">\n                                    <i class=\"ti ti-star-filled\" data-kid=\"2-2-5-2-1-1-3-1-1-1\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                4.9\n                            </p>\n                            <button class=\"mt-2 min-h-11 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-5-2-1-1-3-2\">\n                                Contactar\n                            </button>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"p-4\" data-kid=\"2-2-5-2-2\" data-name=\"workshop data row\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-2-5-2-2-1\">\n                        <span class=\"grid size-9 shrink-0 place-items-center border border-[#CBD5E1] text-[17px] text-[#1E88E5]\" data-kid=\"2-2-5-2-2-1-1\">\n                            <i class=\"ti ti-tool\" data-kid=\"2-2-5-2-2-1-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"2-2-5-2-2-1-2\">\n                            <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-2-1-2-1\">\n                                MotorLab\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-5-2-2-1-2-2\">\n                                3.4 km\n                            </p>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"2-2-5-2-2-1-3\">\n                            <p class=\"flex items-center justify-end gap-1 text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-2-1-3-1\">\n                                <span class=\"text-[13px] text-[#F59E0B]\" data-kid=\"2-2-5-2-2-1-3-1-1\">\n                                    <i class=\"ti ti-star-filled\" data-kid=\"2-2-5-2-2-1-3-1-1-1\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                4.8\n                            </p>\n                            <button class=\"mt-2 min-h-11 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-5-2-2-1-3-2\">\n                                Contactar\n                            </button>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"p-4\" data-kid=\"2-2-5-2-3\" data-name=\"workshop data row\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-2-5-2-3-1\">\n                        <span class=\"grid size-9 shrink-0 place-items-center border border-[#CBD5E1] text-[17px] text-[#1E88E5]\" data-kid=\"2-2-5-2-3-1-1\">\n                            <i class=\"ti ti-tool\" data-kid=\"2-2-5-2-3-1-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"2-2-5-2-3-1-2\">\n                            <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-3-1-2-1\">\n                                Centro Auto\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-5-2-3-1-2-2\">\n                                5.1 km\n                            </p>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"2-2-5-2-3-1-3\">\n                            <p class=\"flex items-center justify-end gap-1 text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-3-1-3-1\">\n                                <span class=\"text-[13px] text-[#F59E0B]\" data-kid=\"2-2-5-2-3-1-3-1-1\">\n                                    <i class=\"ti ti-star-filled\" data-kid=\"2-2-5-2-3-1-3-1-1-1\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                4.6\n                            </p>\n                            <button class=\"mt-2 min-h-11 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-5-2-3-1-3-2\">\n                                Contactar\n                            </button>\n                        </div>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <p class=\"mt-7 pb-2 text-[11px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-6\" data-name=\"footer copyright text\">\n            AutoDoc · Diagnóstico y mantenimiento vehicular · Datos sincronizados con tu garaje\n        </p>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-20 border-t border-[#CBD5E1] bg-white/95 px-2 pb-[env(safe-area-inset-bottom)] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\">\n        <div class=\"mx-auto flex max-w-[375px] items-center justify-around gap-1\" data-kid=\"2-3-1\" data-name=\"navigation items container\">\n            <a aria-current=\"page\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-0.5 rounded-lg bg-[#E8F2FD] text-[#1E88E5]\" data-kid=\"2-3-1-1\" data-name=\"home navigation item\" href=\"#inicio\">\n                <i class=\"ti ti-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-1-2\">\n                    Inicio\n                </span>\n            </a>\n            <a class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-2\" data-name=\"garage navigation item\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-1-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\">\n                    Mi garaje\n                </span>\n            </a>\n            <a class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-3\" data-name=\"workshops navigation item\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\">\n                    Talleres\n                </span>\n            </a>\n            <a class=\"relative flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-4\" data-name=\"alerts navigation item\" href=\"#alertas\">\n                <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-1-4-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\">\n                    Alertas\n                </span>\n                <span class=\"absolute right-[18%] top-1 size-2 rounded-full bg-[#EF4444]\" data-kid=\"2-3-1-4-3\" data-name=\"alerts dot badge\">\n                </span>\n            </a>\n            <a class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-5\" data-name=\"history navigation item\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-5-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-5-2\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
