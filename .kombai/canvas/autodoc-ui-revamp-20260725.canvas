      "html": "<link data-kid=\"1\" data-name=\"web font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#0F172A] pb-24 text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"mobile mechanic reviews application container\">\n    <header class=\"sticky top-0 z-40 border-b border-[#334155] bg-[#0B1220]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile top bar\">\n        <div class=\"flex min-h-[44px] items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"header layout container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"application branding container\">\n                <div aria-label=\"AutoDoc\" class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo container\">\n                    <span class=\"font-heading text-[18px] font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1-1-1\" data-name=\"AutoDoc initials\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"app title container\">\n                    <p class=\"truncate text-[10px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-1-1-2-1\" data-name=\"brand category label\">\n                        Taller\n                    </p>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-1-1-2-2\" data-name=\"page title group\">\n                        <h1 class=\"truncate font-heading text-[16px] font-bold tracking-[-0.03em] text-white\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"page title\">\n                            Reseñas\n                        </h1>\n                        <span class=\"size-1.5 shrink-0 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-1-2-2-2\" data-name=\"status indicator dot\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"header action buttons\">\n                <button aria-label=\"Cambiar tema\" class=\"flex size-11 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"theme toggle button\">\n                    <i class=\"ti ti-sun-moon text-[18px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"sun moon icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Notificaciones\" class=\"relative flex size-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-1-2-2\" data-name=\"notifications button\">\n                    <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-2-2-2\" data-name=\"notification unread dot\">\n                    </span>\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-2 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-1-2\" data-name=\"breadcrumb navigation\">\n            <span data-kid=\"2-1-2-1\" data-name=\"breadcrumb parent\">\n                Taller\n            </span>\n            <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-1-2-2\" data-name=\"chevron right icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"font-semibold text-[#E2E8F0]\" data-kid=\"2-1-2-3\" data-name=\"breadcrumb current page\">\n                Reseñas\n            </span>\n        </div>\n    </header>\n    <main class=\"px-4 pt-6\" data-kid=\"2-2\" data-name=\"mobile reviews content\">\n        <section class=\"flex flex-col gap-4\" data-kid=\"2-2-1\" data-name=\"mobile reviews title section\">\n            <div data-kid=\"2-2-1-1\" data-name=\"title description container\">\n                <h2 class=\"font-heading text-[27px] font-extrabold leading-[1.08] tracking-[-0.045em] text-white\" data-kid=\"2-2-1-1-1\" data-name=\"reviews headline\">\n                    Reseñas de clientes\n                </h2>\n                <p class=\"mt-2 text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-1-2\" data-name=\"reviews subheadline\">\n                    La confianza se construye servicio a servicio.\n                </p>\n            </div>\n            <button class=\"flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full border border-[#334155] bg-[#141E36] px-4 py-3 text-[12px] font-semibold text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-2-1-2\" data-name=\"export reviews button\">\n                <i class=\"ti ti-download text-[16px] text-[#81E6D9]\" data-kid=\"2-2-1-2-1\" data-name=\"download icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Exportar reseñas\n            </button>\n        </section>\n        <section class=\"mt-7 border-y border-[#475569]\" data-kid=\"2-2-2\" data-name=\"mobile rating summary\">\n            <div class=\"px-1 py-6\" data-kid=\"2-2-2-3\" data-name=\"rating metrics container\">\n                <div class=\"flex items-end gap-4\" data-kid=\"2-2-2-3-1\" data-name=\"rating overview\">\n                    <div class=\"font-heading text-[52px] font-extrabold leading-none tabular-nums text-white\" data-kid=\"2-2-2-3-1-1\" data-name=\"average rating number\">\n                        4.8\n                    </div>\n                    <div class=\"pb-1\" data-kid=\"2-2-2-3-1-2\" data-name=\"stars and count container\">\n                        <div aria-label=\"4.8 de 5 estrellas\" class=\"flex items-center gap-1 text-[18px] text-[#FBBF24]\" data-kid=\"2-2-2-3-1-2-1\" data-name=\"star rating icons container\">\n                            <i class=\"ti ti-star-filled\" data-kid=\"2-2-2-3-1-2-1-1\" data-name=\"star filled icon 1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"2-2-2-3-1-2-1-2\" data-name=\"star filled icon 2\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"2-2-2-3-1-2-1-3\" data-name=\"star filled icon 3\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"2-2-2-3-1-2-1-4\" data-name=\"star filled icon 4\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-half-filled\" data-kid=\"2-2-2-3-1-2-1-5\" data-name=\"star half filled icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <div class=\"mt-2 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-3-1-2-2\" data-name=\"total reviews text\">\n                            86 reseñas\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-6 space-y-3 border-t border-[#334155] pt-5\" data-kid=\"2-2-2-1\" data-name=\"mobile rating distribution\">\n                    <div class=\"flex items-center gap-3 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-1\" data-name=\"5 stars distribution row\">\n                        <span class=\"w-[68px] shrink-0\" data-kid=\"2-2-2-1-1-1\" data-name=\"5 stars label\">\n                            5 estrellas\n                        </span>\n                        <div class=\"h-1.5 flex-1 bg-[#334155]\" data-kid=\"2-2-2-1-1-2\" data-name=\"5 stars bar background\">\n                            <div class=\"h-1.5 bg-[#FBBF24]\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"5 stars bar fill\" style=\"width:72%\">\n                            </div>\n                        </div>\n                        <span class=\"w-8 text-right tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-2-1-1-3\" data-name=\"5 stars percentage\">\n                            72%\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-2\" data-name=\"4 stars distribution row\">\n                        <span class=\"w-[68px] shrink-0\" data-kid=\"2-2-2-1-2-1\" data-name=\"4 stars label\">\n                            4 estrellas\n                        </span>\n                        <div class=\"h-1.5 flex-1 bg-[#334155]\" data-kid=\"2-2-2-1-2-2\" data-name=\"4 stars bar background\">\n                            <div class=\"h-1.5 bg-[#FBBF24]\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"4 stars bar fill\" style=\"width:18%\">\n                            </div>\n                        </div>\n                        <span class=\"w-8 text-right tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-2-1-2-3\" data-name=\"4 stars percentage\">\n                            18%\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-3\" data-name=\"3 stars distribution row\">\n                        <span class=\"w-[68px] shrink-0\" data-kid=\"2-2-2-1-3-1\" data-name=\"3 stars label\">\n                            3 o menos\n                        </span>\n                        <div class=\"h-1.5 flex-1 bg-[#334155]\" data-kid=\"2-2-2-1-3-2\" data-name=\"3 stars bar background\">\n                            <div class=\"h-1.5 bg-[#F87171]\" data-kid=\"2-2-2-1-3-2-1\" data-name=\"3 stars bar fill\" style=\"width:10%\">\n                            </div>\n                        </div>\n                        <span class=\"w-8 text-right tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-2-1-3-3\" data-name=\"3 stars percentage\">\n                            10%\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-6 border-l border-[#334155] pl-4\" data-kid=\"2-2-2-2\" data-name=\"mobile response summary\">\n                    <div class=\"text-[10px] uppercase tracking-[0.15em] text-[#64748B]\" data-kid=\"2-2-2-2-1\" data-name=\"response label\">\n                        Respuesta del taller\n                    </div>\n                    <div class=\"mt-2 font-heading text-[22px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-2-2-2\" data-name=\"response percentage\">\n                        68%\n                    </div>\n                    <div class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-2-3\" data-name=\"response count description\">\n                        de reseñas respondidas\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-7 border-b border-[#334155] pb-4\" data-kid=\"2-2-3\" data-name=\"mobile reviews toolbar\">\n            <div aria-label=\"Filtros de reseñas\" class=\"grid grid-cols-3 border-b border-[#334155]\" data-kid=\"2-2-3-1\" data-name=\"filter tabs group\" role=\"tablist\">\n                <button aria-selected=\"true\" class=\"min-h-[44px] border-b-2 border-[#38BDF8] px-1 text-[10px] font-semibold text-white\" data-kid=\"2-2-3-1-1\" data-name=\"all reviews tab button\">\n                    Todas\n                    <span class=\"ml-0.5 text-[#38BDF8]\" data-kid=\"2-2-3-1-1-1\" data-name=\"all reviews count\">\n                        86\n                    </span>\n                </button>\n                <button class=\"min-h-[44px] px-1 text-[10px] font-medium text-[#94A3B8]\" data-kid=\"2-2-3-1-2\" data-name=\"unanswered reviews tab button\">\n                    Sin responder\n                    <span class=\"ml-0.5 text-[#FBBF24]\" data-kid=\"2-2-3-1-2-1\" data-name=\"unanswered reviews count\">\n                        27\n                    </span>\n                </button>\n                <button class=\"min-h-[44px] px-1 text-[10px] font-medium text-[#94A3B8]\" data-kid=\"2-2-3-1-3\" data-name=\"with comment reviews tab button\">\n                    Con comentario\n                    <span class=\"ml-0.5 text-[#CBD5E1]\" data-kid=\"2-2-3-1-3-1\" data-name=\"with comment reviews count\">\n                        54\n                    </span>\n                </button>\n            </div>\n            <button class=\"mt-3 flex min-h-[44px] w-full items-center justify-center gap-2 border border-[#475569] px-3 text-[12px] text-[#CBD5E1]\" data-kid=\"2-2-3-2\" data-name=\"sort dropdown button\">\n                <i class=\"ti ti-arrows-sort text-[15px] text-[#94A3B8]\" data-kid=\"2-2-3-2-1\" data-name=\"sort icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Más recientes\n                <i class=\"ti ti-chevron-down text-[15px] text-[#64748B]\" data-kid=\"2-2-3-2-2\" data-name=\"chevron down icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </section>\n        <section aria-label=\"Lista de reseñas\" class=\"divide-y divide-[#334155]\" data-kid=\"2-2-4\" data-name=\"mobile review list\">\n            <article class=\"py-6\" data-kid=\"2-2-4-1\" data-name=\"Juan review card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-1-1\" data-name=\"review header container\">\n                    <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"2-2-4-1-1-1\" data-name=\"reviewer info container\">\n                        <div class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-2-4-1-1-1-1\" data-name=\"reviewer initials avatar\">\n                            JP\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-2-4-1-1-1-2\" data-name=\"reviewer details\">\n                            <div class=\"truncate text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"2-2-4-1-1-1-2-1\" data-name=\"reviewer name\">\n                                Juan Pérez\n                            </div>\n                            <div class=\"mt-1 truncate text-[11px] text-[#64748B]\" data-kid=\"2-2-4-1-1-1-2-2\" data-name=\"reviewer vehicle\">\n                                Toyota Corolla 2022\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-1-1-1-2-3\" data-name=\"review date\">\n                                12 jun 2026\n                            </div>\n                        </div>\n                    </div>\n                    <div aria-label=\"5 de 5 estrellas\" class=\"flex shrink-0 items-center gap-1 text-[14px] text-[#FBBF24]\" data-kid=\"2-2-4-1-1-2\" data-name=\"review star icons container\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-1-1-2-1\" data-name=\"star filled icon 1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-1-1-2-2\" data-name=\"star filled icon 2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-1-1-2-3\" data-name=\"star filled icon 3\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-1-1-2-4\" data-name=\"star filled icon 4\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-1-1-2-5\" data-name=\"star filled icon 5\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex items-center justify-between gap-3\" data-kid=\"2-2-4-1-2\" data-name=\"review actions container\">\n                    <p class=\"text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-4-1-2-1\" data-name=\"review score number\">\n                        5.0\n                    </p>\n                    <button class=\"flex min-h-[44px] items-center gap-2 border border-[#475569] px-3 text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-4-1-2-2\" data-name=\"respond to review button\">\n                        <i class=\"ti ti-message-2 text-[15px]\" data-kid=\"2-2-4-1-2-2-1\" data-name=\"message icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Responder\n                    </button>\n                </div>\n                <p class=\"mt-4 text-[16px] font-medium text-[#E2E8F0]\" data-kid=\"2-2-4-1-3\" data-name=\"review title\">\n                    Servicio claro y rápido\n                </p>\n                <p class=\"mt-2 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-4-1-4\" data-name=\"review text body\">\n                    El taller explicó cada paso y entregó el vehículo a tiempo.\n                </p>\n            </article>\n            <article class=\"py-6\" data-kid=\"2-2-4-2\" data-name=\"Laura review card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-2-1\" data-name=\"review header container\">\n                    <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"2-2-4-2-1-1\" data-name=\"reviewer info container\">\n                        <div class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#26334A] text-[12px] font-bold text-[#CBD5E1]\" data-kid=\"2-2-4-2-1-1-1\" data-name=\"reviewer initials avatar\">\n                            LG\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-2-4-2-1-1-2\" data-name=\"reviewer details\">\n                            <div class=\"truncate text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"2-2-4-2-1-1-2-1\" data-name=\"reviewer name\">\n                                Laura Gómez\n                            </div>\n                            <div class=\"mt-1 truncate text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-1-1-2-2\" data-name=\"reviewer vehicle\">\n                                Mazda 3 2019\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-1-1-2-3\" data-name=\"review date\">\n                                02 jun 2026\n                            </div>\n                        </div>\n                    </div>\n                    <div aria-label=\"4 de 5 estrellas\" class=\"flex shrink-0 items-center gap-1 text-[14px] text-[#FBBF24]\" data-kid=\"2-2-4-2-1-2\" data-name=\"review star icons container\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-2-1-2-1\" data-name=\"star filled icon 1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-2-1-2-2\" data-name=\"star filled icon 2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-2-1-2-3\" data-name=\"star filled icon 3\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-2-1-2-4\" data-name=\"star filled icon 4\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star text-[#64748B]\" data-kid=\"2-2-4-2-1-2-5\" data-name=\"star empty icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex items-center justify-between gap-3\" data-kid=\"2-2-4-2-2\" data-name=\"review actions container\">\n                    <p class=\"text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-4-2-2-1\" data-name=\"review score number\">\n                        4.0\n                    </p>\n                    <button class=\"flex min-h-[44px] items-center gap-2 border border-[#475569] px-3 text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-4-2-2-2\" data-name=\"respond to review button\">\n                        <i class=\"ti ti-message-2 text-[15px]\" data-kid=\"2-2-4-2-2-2-1\" data-name=\"message icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Responder\n                    </button>\n                </div>\n                <p class=\"mt-4 text-[16px] font-medium text-[#E2E8F0]\" data-kid=\"2-2-4-2-3\" data-name=\"review title\">\n                    Buen trabajo, aunque la espera fue un poco larga.\n                </p>\n                <p class=\"mt-2 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-4-2-4\" data-name=\"review text body\">\n                    La reparación quedó bien y el equipo mantuvo una comunicación clara.\n                </p>\n            </article>\n            <article class=\"py-6\" data-kid=\"2-2-4-3\" data-name=\"Andres review card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-3-1\" data-name=\"review header container\">\n                    <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"2-2-4-3-1-1\" data-name=\"reviewer info container\">\n                        <div class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#26334A] text-[12px] font-bold text-[#CBD5E1]\" data-kid=\"2-2-4-3-1-1-1\" data-name=\"reviewer initials avatar\">\n                            AR\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-2-4-3-1-1-2\" data-name=\"reviewer details\">\n                            <div class=\"truncate text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"2-2-4-3-1-1-2-1\" data-name=\"reviewer name\">\n                                Andrés Ruiz\n                            </div>\n                            <div class=\"mt-1 truncate text-[11px] text-[#64748B]\" data-kid=\"2-2-4-3-1-1-2-2\" data-name=\"reviewer vehicle\">\n                                Renault Duster 2021\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-3-1-1-2-3\" data-name=\"review date\">\n                                28 may 2026\n                            </div>\n                        </div>\n                    </div>\n                    <div aria-label=\"3 de 5 estrellas\" class=\"flex shrink-0 items-center gap-1 text-[14px] text-[#FBBF24]\" data-kid=\"2-2-4-3-1-2\" data-name=\"review star icons container\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-3-1-2-1\" data-name=\"star filled icon 1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-3-1-2-2\" data-name=\"star filled icon 2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star-filled\" data-kid=\"2-2-4-3-1-2-3\" data-name=\"star filled icon 3\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star text-[#64748B]\" data-kid=\"2-2-4-3-1-2-4\" data-name=\"star empty icon 4\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <i class=\"ti ti-star text-[#64748B]\" data-kid=\"2-2-4-3-1-2-5\" data-name=\"star empty icon 5\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex items-center justify-between gap-3\" data-kid=\"2-2-4-3-2\" data-name=\"review actions container\">\n                    <p class=\"text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-4-3-2-1\" data-name=\"review score number\">\n                        3.0\n                    </p>\n                    <button class=\"flex min-h-[44px] items-center gap-2 border border-[#475569] px-3 text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-4-3-2-2\" data-name=\"respond to review button\">\n                        <i class=\"ti ti-message-2 text-[15px]\" data-kid=\"2-2-4-3-2-2-1\" data-name=\"message icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Responder\n                    </button>\n                </div>\n                <p class=\"mt-4 text-[16px] font-medium text-[#E2E8F0]\" data-kid=\"2-2-4-3-3\" data-name=\"review title\">\n                    La información del servicio podría ser más clara.\n                </p>\n                <p class=\"mt-2 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-4-3-4\" data-name=\"review text body\">\n                    Una respuesta del taller puede ayudar a cerrar esta experiencia.\n                </p>\n            </article>\n        </section>\n        <footer class=\"mt-8 flex flex-col gap-3 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-2-5\" data-name=\"mobile reviews footer\">\n            <span data-kid=\"2-2-5-1\" data-name=\"footer description text\">\n                AutoDoc · Gestión operativa del taller\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-2-5-2\" data-name=\"sync status container\">\n                <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-5-2-1\" data-name=\"sync status dot\">\n                </span>\n                Datos sincronizados hace 4 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación móvil del taller\" class=\"fixed inset-x-0 bottom-0 z-50 border-t border-[#334155] bg-[#020617]/98 px-2 pb-[calc(env(safe-area-inset-bottom)+8px)] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[420px] grid-cols-4 gap-1\" data-kid=\"2-3-1\" data-name=\"bottom nav buttons container\">\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" data-name=\"dashboard nav link\" href=\"#panel\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"dashboard label\">\n                    Panel\n                </span>\n            </a>\n            <a class=\"relative flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"repairs nav link\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"tool icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"repairs label\">\n                    Reparaciones\n                </span>\n                <span class=\"absolute right-4 top-1 size-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-3-1-2-3\" data-name=\"repairs alert dot\">\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"search nav link\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"search icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"search label\">\n                    Buscar\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] text-[#38BDF8]\" data-kid=\"2-3-1-4\" data-name=\"reviews nav link\" href=\"#reseñas\">\n                <i class=\"ti ti-star-filled text-[19px] text-[#FBBF24]\" data-kid=\"2-3-1-4-1\" data-name=\"reviews star icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-4-2\" data-name=\"reviews label\">\n                    Reseñas\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
