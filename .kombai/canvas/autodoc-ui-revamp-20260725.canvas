      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component treatment\">\n    :root { --app-primary: #522C81; --app-surface-container: #EEEDF0; --app-outline: #CBD5E1; --app-on-primary: #FFFFFF; --app-shadow-sm: 0 2px 4px rgba(15,23,42,0.05); --app-shadow-hover: 0 6px 14px rgba(15,23,42,0.10); }\n  button { min-height: 48px; border-radius: 999px !important; transition: transform 150ms cubic-bezier(0.23,1,0.32,1), box-shadow 150ms cubic-bezier(0.23,1,0.32,1), background-color 150ms cubic-bezier(0.23,1,0.32,1), border-color 150ms cubic-bezier(0.23,1,0.32,1), color 150ms cubic-bezier(0.23,1,0.32,1); }\n  button:active { transform: scale(0.97); }\n  button:focus-visible { outline: 3px solid rgba(82,44,129,0.35); outline-offset: 2px; }\n  button[class*=\"bg-[#1E88E5]\"], button[class*=\"bg-[#38BDF8]\"] { background: var(--app-primary) !important; color: var(--app-on-primary) !important; box-shadow: var(--app-shadow-sm); }\n  button[class*=\"border-[#1E88E5]\"], button[class*=\"border-[#38BDF8]\"] { border-color: var(--app-primary) !important; color: var(--app-primary) !important; }\n  button[class*=\"bg-\"]:hover, button[class*=\"border-\"]:hover { box-shadow: var(--app-shadow-hover); }\n  button[aria-label] { min-width: 48px; min-height: 48px; padding: 0.75rem; border: 1px solid var(--app-outline) !important; background: var(--app-surface-container) !important; box-shadow: var(--app-shadow-sm); }\n  main section { border: 1px solid rgba(203,213,225,0.70); border-radius: 16px; background: var(--app-surface-container); box-shadow: var(--app-shadow-sm); overflow: hidden; }\n</style>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mechanic reviews page\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"mechanic icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"brand mark\">\n                AD\n            </div>\n            <div class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary rail navigation\">\n                <button aria-label=\"Panel del taller\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard rail button\">\n                    <i class=\"ti ti-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Reparaciones\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"repairs rail button\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-2-1\" data-name=\"repairs icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Buscar vehículo\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"search rail button\">\n                    <i class=\"ti ti-search\" data-kid=\"2-1-1-2-3-1\" data-name=\"search icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Reseñas\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-4\" data-name=\"reviews rail button\">\n                    <i class=\"ti ti-star\" data-kid=\"2-1-1-2-4-1\" data-name=\"reviews icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"utility rail navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings icon\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"mechanic contextual sidebar\">\n            <div class=\"mb-8 border-b border-[#E2E8F0] pb-6\" data-kid=\"2-1-2-1\" data-name=\"workshop identity\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"role label\">\n                    Taller\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"workshop name row\">\n                    <span class=\"text-[15px] font-heading font-extrabold text-[#0F172A]\" data-kid=\"2-1-2-1-2-1\" data-name=\"workshop name\">\n                        Taller Rápido\n                    </span>\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-2\" data-name=\"online state dot\">\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-2-1-3\" data-name=\"workshop status\">\n                    Operación activa\n                </p>\n            </div>\n            <nav aria-label=\"Navegación del taller\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"mechanic navigation\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-1\" data-name=\"panel link\" href=\"#panel\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-1-1\">\n                        <i class=\"ti ti-dashboard\" data-kid=\"2-1-2-2-1-1-1\">\n                        </i>\n                    </span>\n                    Panel\n                </a>\n                <a class=\"flex items-center justify-between gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-2\" data-name=\"repairs link\" href=\"#reparaciones\">\n                    <span class=\"flex items-center gap-3\" data-kid=\"2-1-2-2-2-2\">\n                        <span class=\"text-[17px]\" data-kid=\"2-1-2-2-2-1\">\n                            <i class=\"ti ti-tool\" data-kid=\"2-1-2-2-2-1-1\">\n                            </i>\n                        </span>\n                        Reparaciones\n                    </span>\n                    <span class=\"text-[11px] font-bold tabular-nums text-[#64748B]\" data-kid=\"2-1-2-2-2-3\">\n                        04\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-3\" data-name=\"vehicle search link\" href=\"#buscar\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-3-1\">\n                        <i class=\"ti ti-search\" data-kid=\"2-1-2-2-3-1-1\">\n                        </i>\n                    </span>\n                    Buscar vehículo\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-4\" data-name=\"history link\" href=\"#historial\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-4-1\">\n                        <i class=\"ti ti-history\" data-kid=\"2-1-2-2-4-1-1\">\n                        </i>\n                    </span>\n                    Historial\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-2.5 text-[14px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-2-5\" data-name=\"active reviews link\" href=\"#resenas\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-5-1\">\n                        <i class=\"ti ti-star\" data-kid=\"2-1-2-2-5-1-1\">\n                        </i>\n                    </span>\n                    Reseñas\n                    <span class=\"ml-auto text-[11px] font-bold tabular-nums\" data-kid=\"2-1-2-2-5-2\">\n                        4.8\n                    </span>\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"secondary workshop links\">\n                <p class=\"mb-3 px-3 text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-3-1\" data-name=\"secondary heading\">\n                    Gestión\n                </p>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-2-3-2\" data-name=\"catalog link\" href=\"#catalogo\">\n                    <i class=\"ti ti-list-details text-[17px] text-[#1E88E5]\" data-kid=\"2-1-2-3-2-1\">\n                    </i>\n                    Catálogo\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-2-3-3\" data-name=\"employees link\" href=\"#empleados\">\n                    <i class=\"ti ti-users text-[17px]\" data-kid=\"2-1-2-3-3-1\">\n                    </i>\n                    Empleados\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-2-3-4\" data-name=\"settings link\" href=\"#configuracion\">\n                    <i class=\"ti ti-settings text-[17px]\" data-kid=\"2-1-2-3-4-1\">\n                    </i>\n                    Configuración\n                </a>\n            </div>\n            <div class=\"mt-5 border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-4\" data-name=\"signed in mechanic\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-4-1\" data-name=\"mechanic account row\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-4-1-1\" data-name=\"mechanic avatar\">\n                        MR\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-4-1-2\">\n                        <p class=\"truncate text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-4-1-2-1\">\n                            María Rodríguez\n                        </p>\n                        <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-2-4-1-2-2\">\n                            Administradora\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"2-1-3\" data-name=\"reviews content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-white px-8\" data-kid=\"2-1-3-1\" data-name=\"top bar\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumb\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-1-3-1-1-1\">\n                        Taller\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-3-1-1-2\">\n                        /\n                    </span>\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-1-3\">\n                        Reseñas\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-1-2\" data-name=\"header utilities\">\n                    <span class=\"hidden text-[12px] text-[#64748B] lg:block\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-4\" data-name=\"current date display\" data-reason=\"text replaced by date script\">\n                        Sábado, 25 jul 2026\n                    </span>\n                    <button aria-label=\"Notificaciones\" class=\"relative grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-1\">\n                        <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-2-1-1\">\n                        </i>\n                        <span class=\"absolute right-[7px] top-[6px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-3-1-2-1-2\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-2\">\n                        <i class=\"ti ti-moon\" data-kid=\"2-1-3-1-2-2-1\">\n                        </i>\n                    </button>\n                    <div class=\"h-6 w-px bg-[#E2E8F0]\" data-kid=\"2-1-3-1-2-7\">\n                    </div>\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-1-2-3\">\n                        MR\n                    </div>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-2-9\">\n                        María Rodríguez\n                    </span>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1160px] px-8 py-8\" data-kid=\"2-1-3-2\" data-name=\"reviews page body\">\n                <div class=\"mb-7 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"page heading\">\n                    <div data-kid=\"2-1-3-2-1-4\">\n                        <h1 class=\"font-heading text-[32px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-1-3-2-1-1\">\n                            Reseñas de clientes\n                        </h1>\n                        <p class=\"mt-2 text-[15px] text-[#334155]\" data-kid=\"2-1-3-2-1-2\">\n                            Escucha lo que tus clientes valoran del servicio.\n                        </p>\n                    </div>\n                    <button class=\"inline-flex items-center gap-2 border border-[#CBD5E1] bg-white px-4 py-2.5 text-[13px] font-semibold text-[#0F172A] hover:border-[#1E88E5]\" data-kid=\"2-1-3-2-1-3\">\n                        <i class=\"ti ti-refresh text-[16px] text-[#1E88E5]\" data-kid=\"2-1-3-2-1-3-1\">\n                        </i>\n                        Actualizar datos\n                    </button>\n                </div>\n                <section aria-labelledby=\"rating-heading\" class=\"border-y border-[#CBD5E1] bg-white\" data-kid=\"2-1-3-2-2\" data-name=\"rating overview band\">\n                    <div class=\"grid grid-cols-[240px_minmax(0,1fr)] gap-8 px-7 py-6\" data-kid=\"2-1-3-2-2-1\">\n                        <div class=\"border-r border-[#E2E8F0] pr-8\" data-kid=\"2-1-3-2-2-1-1\" data-name=\"overall rating block\">\n                            <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-3-2-2-1-1-1\">\n                                Valoración general\n                            </p>\n                            <div class=\"mt-2 flex items-end gap-3\" data-kid=\"2-1-3-2-2-1-1-3\">\n                                <strong class=\"font-heading text-[42px] font-extrabold leading-none tracking-[-0.05em] text-[#0F172A]\" data-kid=\"2-1-3-2-2-1-1-3-1\" id=\"rating-heading\">\n                                    4.8\n                                </strong>\n                                <span class=\"pb-1 text-[16px] font-semibold text-[#64748B]\" data-kid=\"2-1-3-2-2-1-1-3-2\">\n                                    / 5\n                                </span>\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-2 text-[14px] font-semibold text-[#F59E0B]\" data-kid=\"2-1-3-2-2-1-1-2\">\n                                <span aria-label=\"4.8 de 5 estrellas\" class=\"flex gap-0.5 text-[17px]\" data-kid=\"2-1-3-2-2-1-1-2-1\">\n                                    <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-2-1-1-2-1-1\">\n                                    </i>\n                                    <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-2-1-1-2-1-2\">\n                                    </i>\n                                    <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-2-1-1-2-1-3\">\n                                    </i>\n                                    <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-2-1-1-2-1-4\">\n                                    </i>\n                                    <i class=\"ti ti-star-half-filled\" data-kid=\"2-1-3-2-2-1-1-2-1-5\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[#64748B]\" data-kid=\"2-1-3-2-2-1-1-2-2\">\n                                    86 reseñas\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"space-y-2 pt-1\" data-kid=\"2-1-3-2-2-1-2\" data-name=\"rating distribution\">\n                            <div class=\"flex items-center gap-3 text-[12px]\" data-kid=\"2-1-3-2-2-1-2-1\">\n                                <span class=\"w-20 font-semibold text-[#334155]\" data-kid=\"2-1-3-2-2-1-2-1-1\">\n                                    5 estrellas\n                                </span>\n                                <div class=\"h-2 flex-1 bg-[#EDF2F7]\" data-kid=\"2-1-3-2-2-1-2-1-2\">\n                                    <div class=\"h-2 bg-[#F59E0B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-1-2-1-2-1\" data-name=\"star rating progress bar five\" data-reason=\"width updated by rating statistics script\" style=\"width:72%\">\n                                    </div>\n                                </div>\n                                <span class=\"w-12 text-right font-semibold tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-2-1-2-1-3\">\n                                    72%\n                                </span>\n                            </div>\n                            <div class=\"flex items-center gap-3 text-[12px]\" data-kid=\"2-1-3-2-2-1-2-2\">\n                                <span class=\"w-20 font-semibold text-[#334155]\" data-kid=\"2-1-3-2-2-1-2-2-1\">\n                                    4 estrellas\n                                </span>\n                                <div class=\"h-2 flex-1 bg-[#EDF2F7]\" data-kid=\"2-1-3-2-2-1-2-2-2\">\n                                    <div class=\"h-2 bg-[#F59E0B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-1-2-2-2-1\" data-name=\"star rating progress bar four\" data-reason=\"width updated by rating statistics script\" style=\"width:18%\">\n                                    </div>\n                                </div>\n                                <span class=\"w-12 text-right font-semibold tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-2-1-2-2-3\">\n                                    18%\n                                </span>\n                            </div>\n                            <div class=\"flex items-center gap-3 text-[12px]\" data-kid=\"2-1-3-2-2-1-2-3\">\n                                <span class=\"w-20 font-semibold text-[#334155]\" data-kid=\"2-1-3-2-2-1-2-3-1\">\n                                    3 o menos\n                                </span>\n                                <div class=\"h-2 flex-1 bg-[#EDF2F7]\" data-kid=\"2-1-3-2-2-1-2-3-2\">\n                                    <div class=\"h-2 bg-[#F59E0B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-1-2-3-2-1\" data-name=\"star rating progress bar three\" data-reason=\"width updated by rating statistics script\" style=\"width:10%\">\n                                    </div>\n                                </div>\n                                <span class=\"w-12 text-right font-semibold tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-2-1-2-3-3\">\n                                    10%\n                                </span>\n                            </div>\n                            <p class=\"pt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-2-1-2-4\">\n                                La distribución se calcula sobre reseñas publicadas.\n                            </p>\n                        </div>\n                    </div>\n                </section>\n                <div class=\"mt-7 flex items-center justify-between gap-4 border-b border-[#CBD5E1]\" data-kid=\"2-1-3-2-3\" data-name=\"review filters\">\n                    <div class=\"flex items-center gap-6\" data-kid=\"2-1-3-2-3-5\">\n                        <button class=\"border-b-2 border-[#1E88E5] px-1 pb-3 text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-3-1\">\n                            Todas\n                            <span class=\"ml-1 tabular-nums\" data-kid=\"2-1-3-2-3-1-1\">\n                                86\n                            </span>\n                        </button>\n                        <button class=\"px-1 pb-3 text-[13px] font-semibold text-[#64748B]\" data-kid=\"2-1-3-2-3-2\">\n                            Sin responder\n                            <span class=\"ml-1 tabular-nums\" data-kid=\"2-1-3-2-3-2-1\">\n                                2\n                            </span>\n                        </button>\n                        <button class=\"px-1 pb-3 text-[13px] font-semibold text-[#64748B]\" data-kid=\"2-1-3-2-3-3\">\n                            Con comentario\n                            <span class=\"ml-1 tabular-nums\" data-kid=\"2-1-3-2-3-3-1\">\n                                61\n                            </span>\n                        </button>\n                    </div>\n                    <button aria-label=\"Ordenar reseñas\" class=\"flex items-center gap-2 pb-3 text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-3-2-3-4\">\n                        <i class=\"ti ti-arrows-sort text-[15px] text-[#1E88E5]\" data-kid=\"2-1-3-2-3-4-1\">\n                        </i>\n                        Más recientes\n                        <i class=\"ti ti-chevron-down text-[14px]\" data-kid=\"2-1-3-2-3-4-2\">\n                        </i>\n                    </button>\n                </div>\n                <section aria-label=\"Listado de reseñas\" class=\"mt-1 border-b border-[#CBD5E1] bg-white\" data-kid=\"2-1-3-2-4\" data-name=\"reviews list\">\n                    <article class=\"border-b border-[#E2E8F0] px-7 py-6\" data-kid=\"2-1-3-2-4-1\" data-name=\"review row one\">\n                        <div class=\"flex items-start justify-between gap-8\" data-kid=\"2-1-3-2-4-1-1\">\n                            <div class=\"flex min-w-0 gap-4\" data-kid=\"2-1-3-2-4-1-1-1\">\n                                <div class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-4-1-1-1-1\">\n                                    JP\n                                </div>\n                                <div class=\"min-w-0\" data-kid=\"2-1-3-2-4-1-1-1-2\">\n                                    <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"2-1-3-2-4-1-1-1-2-1\">\n                                        <h2 class=\"font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-4-1-1-1-2-1-1\">\n                                            Juan Pérez\n                                        </h2>\n                                        <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-4-1-1-1-2-1-2\">\n                                            Toyota Corolla · 12 jun 2026\n                                        </span>\n                                    </div>\n                                    <div class=\"mt-2 flex items-center gap-2 text-[13px] font-semibold text-[#F59E0B]\" data-kid=\"2-1-3-2-4-1-1-1-2-2\">\n                                        <span aria-label=\"5 de 5 estrellas\" class=\"flex gap-0.5\" data-kid=\"2-1-3-2-4-1-1-1-2-2-1\">\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-1-1-1-2-2-1-1\">\n                                            </i>\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-1-1-1-2-2-1-2\">\n                                            </i>\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-1-1-1-2-2-1-3\">\n                                            </i>\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-1-1-1-2-2-1-4\">\n                                            </i>\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-1-1-1-2-2-1-5\">\n                                            </i>\n                                        </span>\n                                        <span data-kid=\"2-1-3-2-4-1-1-1-2-2-2\">\n                                            5 de 5 · Excelente\n                                        </span>\n                                    </div>\n                                    <p class=\"mt-3 text-[14px] leading-6 text-[#334155]\" data-kid=\"2-1-3-2-4-1-1-1-2-3\">\n                                        Servicio claro y rápido.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex shrink-0 items-center gap-4\" data-kid=\"2-1-3-2-4-1-1-2\">\n                                <span class=\"text-[11px] font-semibold text-[#F59E0B]\" data-kid=\"2-1-3-2-4-1-1-2-1\">\n                                    Sin responder\n                                </span>\n                                <button class=\"inline-flex min-h-12 items-center gap-2 border border-[#1E88E5] px-4 py-2 text-[12px] font-bold text-[#1E88E5] hover:bg-[#E8F2FD]\" data-kid=\"2-1-3-2-4-1-2\">\n                                    <i class=\"ti ti-message-reply text-[15px]\" data-kid=\"2-1-3-2-4-1-2-1\">\n                                    </i>\n                                    Responder\n                                </button>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"border-b border-[#E2E8F0] px-7 py-6\" data-kid=\"2-1-3-2-4-2\" data-name=\"review row two\">\n                        <div class=\"flex items-start justify-between gap-8\" data-kid=\"2-1-3-2-4-2-1\">\n                            <div class=\"flex min-w-0 gap-4\" data-kid=\"2-1-3-2-4-2-1-1\">\n                                <div class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#F1F5F9] text-[12px] font-bold text-[#475569]\" data-kid=\"2-1-3-2-4-2-1-1-1\">\n                                    LG\n                                </div>\n                                <div class=\"min-w-0\" data-kid=\"2-1-3-2-4-2-1-1-2\">\n                                    <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"2-1-3-2-4-2-1-1-2-1\">\n                                        <h2 class=\"font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-4-2-1-1-2-1-1\">\n                                            Laura Gómez\n                                        </h2>\n                                        <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-4-2-1-1-2-1-2\">\n                                            Mazda 3 · 02 jun 2026\n                                        </span>\n                                    </div>\n                                    <div class=\"mt-2 flex items-center gap-2 text-[13px] font-semibold text-[#F59E0B]\" data-kid=\"2-1-3-2-4-2-1-1-2-2\">\n                                        <span aria-label=\"4 de 5 estrellas\" class=\"flex gap-0.5\" data-kid=\"2-1-3-2-4-2-1-1-2-2-1\">\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-2-1-1-2-2-1-1\">\n                                            </i>\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-2-1-1-2-2-1-2\">\n                                            </i>\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-2-1-1-2-2-1-3\">\n                                            </i>\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-2-1-1-2-2-1-4\">\n                                            </i>\n                                            <i class=\"ti ti-star\" data-kid=\"2-1-3-2-4-2-1-1-2-2-1-5\">\n                                            </i>\n                                        </span>\n                                        <span data-kid=\"2-1-3-2-4-2-1-1-2-2-2\">\n                                            4 de 5 · Muy bueno\n                                        </span>\n                                    </div>\n                                    <p class=\"mt-3 text-[14px] leading-6 text-[#334155]\" data-kid=\"2-1-3-2-4-2-1-1-2-3\">\n                                        Buen trabajo, esperaba más detalle.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex shrink-0 items-center gap-4\" data-kid=\"2-1-3-2-4-2-1-2\">\n                                <span class=\"text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-4-2-1-2-1\">\n                                    Respondida\n                                </span>\n                                <button class=\"inline-flex min-h-12 items-center gap-2 border border-[#CBD5E1] px-4 py-2 text-[12px] font-bold text-[#64748B] hover:border-[#1E88E5] hover:text-[#1E88E5]\" data-kid=\"2-1-3-2-4-2-2\">\n                                    <i class=\"ti ti-eye text-[15px]\" data-kid=\"2-1-3-2-4-2-2-1\">\n                                    </i>\n                                    Ver respuesta\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"mt-4 ml-14 border-l-2 border-[#1E88E5] bg-[#F8FAFC] px-4 py-3\" data-kid=\"2-1-3-2-4-2-3\">\n                            <p class=\"text-[11px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-4-2-3-1\">\n                                Respuesta del taller\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#475569]\" data-kid=\"2-1-3-2-4-2-3-2\">\n                                Gracias, Laura. Tomamos nota para explicar mejor cada revisión.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"px-7 py-6\" data-kid=\"2-1-3-2-4-3\" data-name=\"review row three\">\n                        <div class=\"flex items-start justify-between gap-8\" data-kid=\"2-1-3-2-4-3-1\">\n                            <div class=\"flex min-w-0 gap-4\" data-kid=\"2-1-3-2-4-3-1-1\">\n                                <div class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#FEF3C7] text-[12px] font-bold text-[#92400E]\" data-kid=\"2-1-3-2-4-3-1-1-1\">\n                                    AR\n                                </div>\n                                <div class=\"min-w-0\" data-kid=\"2-1-3-2-4-3-1-1-2\">\n                                    <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"2-1-3-2-4-3-1-1-2-1\">\n                                        <h2 class=\"font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-4-3-1-1-2-1-1\">\n                                            Andrés Ruiz\n                                        </h2>\n                                        <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-4-3-1-1-2-1-2\">\n                                            Renault Duster · 28 may 2026\n                                        </span>\n                                    </div>\n                                    <div class=\"mt-2 flex items-center gap-2 text-[13px] font-semibold text-[#F59E0B]\" data-kid=\"2-1-3-2-4-3-1-1-2-2\">\n                                        <span aria-label=\"3 de 5 estrellas\" class=\"flex gap-0.5\" data-kid=\"2-1-3-2-4-3-1-1-2-2-1\">\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-3-1-1-2-2-1-1\">\n                                            </i>\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-3-1-1-2-2-1-2\">\n                                            </i>\n                                            <i class=\"ti ti-star-filled\" data-kid=\"2-1-3-2-4-3-1-1-2-2-1-3\">\n                                            </i>\n                                            <i class=\"ti ti-star\" data-kid=\"2-1-3-2-4-3-1-1-2-2-1-4\">\n                                            </i>\n                                            <i class=\"ti ti-star\" data-kid=\"2-1-3-2-4-3-1-1-2-2-1-5\">\n                                            </i>\n                                        </span>\n                                        <span data-kid=\"2-1-3-2-4-3-1-1-2-2-2\">\n                                            3 de 5 · A mejorar\n                                        </span>\n                                    </div>\n                                    <p class=\"mt-3 text-[14px] leading-6 text-[#334155]\" data-kid=\"2-1-3-2-4-3-1-1-2-3\">\n                                        La espera fue larga.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex shrink-0 items-center gap-4\" data-kid=\"2-1-3-2-4-3-1-2\">\n                                <span class=\"text-[11px] font-semibold text-[#F59E0B]\" data-kid=\"2-1-3-2-4-3-1-2-1\">\n                                    Sin responder\n                                </span>\n                                <button class=\"inline-flex min-h-12 items-center gap-2 border border-[#1E88E5] px-4 py-2 text-[12px] font-bold text-[#1E88E5] hover:bg-[#E8F2FD]\" data-kid=\"2-1-3-2-4-3-2\">\n                                    <i class=\"ti ti-message-reply text-[15px]\" data-kid=\"2-1-3-2-4-3-2-1\">\n                                    </i>\n                                    Responder\n                                </button>\n                            </div>\n                        </div>\n                    </article>\n                </section>\n                <div class=\"flex items-center justify-between pt-5 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-5\" data-name=\"page footer\">\n                    <span data-kid=\"2-1-3-2-5-1\">\n                        Mostrando 3 de 86 reseñas\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-5-2\">\n                        <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-1-3-2-5-2-1\">\n                        </span>\n                        Datos sincronizados hace 8 min\n                    </span>\n                </div>\n            </div>\n        </main>\n    </div>\n</div>\n",
