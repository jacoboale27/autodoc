ent:center\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"2-1-3-2-3-2-1-2-2\" data-name=\"section header text\">\n                                    <h2 class=\"font-heading text-[19px] font-bold tracking-[-0.025em]\" data-kid=\"2-1-3-2-3-2-1-2-2-1\" data-name=\"section title\">\n                                        Servicios ofrecidos\n                                    </h2>\n                                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-2-2-2\" data-name=\"section subtitle\">\n                                        Aparecerán en el perfil público de tu taller.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"space-y-1 border-y border-[#E2E8F0]\" data-kid=\"2-1-3-2-3-2-1-1\" data-name=\"service switches\">\n                                <label class=\"flex items-center justify-between gap-4 py-4\" data-kid=\"2-1-3-2-3-2-1-1-1\" data-name=\"oil change service switch\">\n                                    <span class=\"flex items-center gap-3 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-1-1-1-1\" data-name=\"service label\">\n                                        <i class=\"ti ti-droplet text-[18px] text-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-1-1-1-1-1\" data-name=\"oil drop icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Cambio de aceite\n                                    </span>\n                                    <span class=\"relative h-6 w-11 rounded-full bg-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-1-1-1-2\" data-name=\"switch toggle\">\n                                        <span class=\"absolute right-1 top-1 size-4 rounded-full bg-white shadow-[0_1px_2px_rgba(15,23,42,0.15)]\" data-kid=\"2-1-3-2-3-2-1-1-1-2-1\" data-name=\"toggle knob\">\n                                        </span>\n                                    </span>\n                                </label>\n                                <label class=\"flex items-center justify-between gap-4 border-t border-[#E2E8F0] py-4\" data-kid=\"2-1-3-2-3-2-1-1-2\" data-name=\"brakes service switch\">\n                                    <span class=\"flex items-center gap-3 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-1-1-2-1\" data-name=\"service label\">\n                                        <i class=\"ti ti-disc text-[18px] text-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-1-1-2-1-1\" data-name=\"disc icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Frenos\n                                    </span>\n                                    <span class=\"relative h-6 w-11 rounded-full bg-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-1-1-2-2\" data-name=\"switch toggle\">\n                                        <span class=\"absolute right-1 top-1 size-4 rounded-full bg-white shadow-[0_1px_2px_rgba(15,23,42,0.15)]\" data-kid=\"2-1-3-2-3-2-1-1-2-2-1\" data-name=\"toggle knob\">\n                                        </span>\n                                    </span>\n                                </label>\n                                <label class=\"flex items-center justify-between gap-4 border-t border-[#E2E8F0] py-4\" data-kid=\"2-1-3-2-3-2-1-1-3\" data-name=\"diagnosis service switch\">\n                                    <span class=\"flex items-center gap-3 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-1-1-3-1\" data-name=\"service label\">\n                                        <i class=\"ti ti-search text-[18px] text-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-1-1-3-1-1\" data-name=\"search