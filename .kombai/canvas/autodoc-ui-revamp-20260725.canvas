      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .seed-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .seed-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"seed-body min-h-screen overflow-x-hidden bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"--surface:#F7F6F8;--surface-container:#EEEDF0;--surface-variant:#E2E8F0;--outline:#CBD5E1;--primary:#522C81;--secondary:#81E6D9;--on-primary:#FFFFFF;--text-primary:#0F172A;--text-secondary:#5B6B80;--success:#2F855A;--success-surface:#ECFDF5;--error:#C2414B;--error-surface:#FFF1F2;--shadow:0 8px 24px rgba(15,23,42,0.08)\">\n    <header class=\"sticky top-0 z-20 flex min-h-[68px] items-center border-b border-[var(--outline)] bg-[var(--surface)]/95 px-4 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"standalone admin seed app bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"app bar branding container\">\n            <div class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[var(--primary)] text-[var(--on-primary)] shadow-[0_2px_4px_rgba(15,23,42,0.08)]\" data-kid=\"1-1-1-1\" data-name=\"security app bar icon\">\n                <i class=\"ti ti-shield-lock text-[19px]\" data-kid=\"1-1-1-1-1\" data-name=\"shield lock icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <h1 class=\"seed-heading truncate text-[16px] font-bold tracking-[-0.03em] text-[var(--text-primary)]\" data-kid=\"1-1-1-2\" data-name=\"admin configuration title\">\n                Configuración de administradores\n            </h1>\n        </div>\n    </header>\n    <main class=\"mx-auto flex w-full max-w-[480px] flex-col px-4 pb-8 pt-10\" data-kid=\"1-2\" data-name=\"scroll safe seed content\">\n        <section class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-5 shadow-[var(--shadow)]\" data-kid=\"1-2-1\" data-name=\"migration completed information card\">\n            <div class=\"mx-auto flex size-[76px] items-center justify-center rounded-full border border-[var(--success)]/25 bg-[var(--success-surface)] text-[var(--success)]\" data-kid=\"1-2-1-1\" data-name=\"migration security status icon\">\n                <i class=\"ti ti-shield-check text-[36px]\" data-kid=\"1-2-1-1-1\" data-name=\"shield check icon\" style=\"width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <div class=\"mt-7 text-center\" data-kid=\"1-2-1-2\" data-name=\"card content area\">\n                <p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--success)]\" data-kid=\"1-2-1-2-1\" data-name=\"configuration status eyebrow\">\n                    ESTADO DE CONFIGURACIÓN\n                </p>\n                <h2 class=\"seed-heading mt-3 text-[25px] font-extrabold leading-tight tracking-[-0.045em] text-[var(--text-primary)]\" data-kid=\"1-2-1-2-2\" data-name=\"migration completed heading\">\n                    Migración Completada\n                </h2>\n                <p class=\"mt-4 text-[14px] leading-6 text-[var(--text-secondary)]\" data-kid=\"1-2-1-2-3\" data-name=\"migration explanation\">\n                    Las cuentas administrativas ya fueron configuradas y los secretos se eliminaron del código fuente por motivos de seguridad.\n                </p>\n            </div>\n            <div class=\"mt-7 flex items-center justify-center gap-2 border-t border-[var(--outline)] pt-5 text-[12px] font-semibold text-[var(--success)]\" data-kid=\"1-2-1-3\" data-name=\"security verification status\">\n                <i class=\"ti ti-lock-check text-[16px]\" data-kid=\"1-2-1-3-1\" data-name=\"lock check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Configuración segura verificada\n            </div>\n        </section>\n        <aside class=\"mt-5 rounded-[14px] border border-dashed border-[var(--outline)] bg-[var(--surface)] px-4 py-4\" data-kid=\"1-2-2\" data-name=\"release access denied alternate cue\">\n            <div class=\"flex items-start gap-3\" data-kid=\"1-2-2-1\" data-name=\"access denied inner container\">\n                <div class=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-[var(--surface-variant)] text-[var(--text-secondary)]\" data-kid=\"1-2-2-1-1\" data-name=\"lock icon background container\">\n                    <i class=\"ti ti-lock text-[17px]\" data-kid=\"1-2-2-1-1-1\" data-name=\"lock icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-2-2-1-2\" data-name=\"access denied text container\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--text-secondary)]\" data-kid=\"1-2-2-1-2-1\" data-name=\"access denied title\">\n                        Acceso denegado\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-2-2-1-2-2\" data-name=\"access denied description\">\n                        Esta sección solo está disponible durante la configuración interna de la aplicación.\n                    </p>\n                </div>\n            </div>\n        </aside>\n        <p class=\"mt-8 pb-2 text-center text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-3\" data-name=\"admin seed footer\">\n            AutoDoc · Configuración interna · Sin acciones pendientes\n        </p>\n    </main>\n</div>\n",
