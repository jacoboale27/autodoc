    "var_f60b7ef8adfd": {
      "type": "variant",
      "label": "AutoDoc Onboarding — Hadrian Light Mobile",
      "parentId": "var_8b90c65cb64d",
      "themeId": null,
      "rect": {
        "x": 23640,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .technical-octagon { clip-path: polygon(50% 0%, 88% 14%, 100% 50%, 88% 86%, 50% 100%, 12% 86%, 0% 50%, 12% 14%); }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile onboarding screen container\">\n    <header class=\"absolute inset-x-0 top-0 z-20 flex items-start justify-between px-5 py-5\" data-kid=\"2-1\" data-name=\"mobile onboarding top bar\">\n        <div class=\"flex min-h-[44px] items-center gap-2.5\" data-kid=\"2-1-1\" data-name=\"mobile brand lockup\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[16px] font-heading font-extrabold tracking-[-0.09em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc mobile logo mark\">\n                AD\n            </div>\n            <div class=\"font-heading text-[16px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-1-1-2\" data-name=\"AutoDoc mobile wordmark\">\n                AutoDoc\n            </div>\n        </div>\n        <div class=\"flex min-h-[44px] items-center gap-2 text-right text-[9px] font-semibold leading-4 tracking-[0.12em] text-[#E2E8F0]\" data-kid=\"2-1-2\" data-name=\"mobile onboarding product label\">\n            <span class=\"size-1.5 shrink-0 rounded-full bg-[#B87333]\" data-kid=\"2-1-2-1\" data-name=\"copper status dot\">\n            </span>\n            <span class=\"max-w-[110px]\" data-kid=\"2-1-2-2\" data-name=\"mobile onboarding product description\">\n                CUIDADO VEHICULAR\n            </span>\n        </div>\n    </header>\n    <main class=\"min-h-screen pb-[172px]\" data-kid=\"2-2\" data-name=\"mobile onboarding vertical layout\">\n        <section class=\"relative h-[258px] overflow-hidden bg-[#0F172A]\" data-kid=\"2-2-1\" data-name=\"mobile onboarding visual panel\">\n            <img alt=\"Sedán Hyundai en perfil durante una revisión visual, fotografía de Hyundai Motor Group en Pexels\" class=\"h-full w-full object-cover object-center opacity-90\" data-kid=\"2-2-1-1\" data-name=\"mobile vehicle maintenance image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14696345/pexels-photo-14696345.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n            <div class=\"absolute inset-0 bg-[#0F172A]/45\" data-kid=\"2-2-1-2\" data-name=\"mobile solid image contrast layer\">\n            </div>\n            <div class=\"absolute left-5 top-24 h-[116px] w-px bg-[#CBD5E1]/45\" data-kid=\"2-2-1-3\" data-name=\"mobile technical vertical line\">\n            </div>\n            <div class=\"absolute left-[18px] top-[172px] size-3 rounded-full border-2 border-[#38BDF8] bg-[#0F172A]\" data-kid=\"2-2-1-4\" data-name=\"mobile technical line marker\">\n            </div>\n            <div class=\"absolute right-6 top-[92px] size-14 border border-[#B87333]/70 technical-octagon\" data-kid=\"2-2-1-5\" data-name=\"mobile technical octagon outline\">\n            </div>\n            <div class=\"absolute right-[54px] top-[120px] h-px w-10 bg-[#B87333]/70\" data-kid=\"2-2-1-6\" data-name=\"mobile technical horizontal line\">\n            </div>\n            <div class=\"absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4\" data-kid=\"2-2-1-7\" data-name=\"mobile visual panel metadata\">\n                <div data-kid=\"2-2-1-7-1\" data-name=\"mobile technical annotation\">\n                    <p class=\"text-[9px] font-bold uppercase tracking-[0.18em] text-[#CBD5E1]\" data-kid=\"2-2-1-7-1-1\" data-name=\"annotation label\">\n                        LECTURA TÉCNICA\n                    </p>\n                    <p class=\"mt-1 font-heading text-[17px] font-bold tracking-[-0.03em] text-white\" data-kid=\"2-2-1-7-1-2\" data-name=\"annotation title\">\n                        Motor y frenos\n                    </p>\n                    <p class=\"mt-0.5 text-[11px] text-[#CBD5E1]\" data-kid=\"2-2-1-7-1-3\" data-name=\"annotation description\">\n                        Una vista clara antes de salir.\n                    </p>\n                </div>\n                <div class=\"border-l border-[#CBD5E1]/50 pl-3 text-right\" data-kid=\"2-2-1-7-2\" data-name=\"mobile technical metrics\">\n                    <p class=\"text-[9px] font-semibold uppercase tracking-[0.14em] text-[#CBD5E1]\" data-kid=\"2-2-1-7-2-1\" data-name=\"metric label\">\n                        SISTEMAS\n                    </p>\n                    <p class=\"mt-0.5 font-heading text-[19px] font-bold tabular-nums text-white\" data-kid=\"2-2-1-7-2-2\" data-name=\"metric value\">\n                        02 / 08\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative bg-[#F8FAFC] px-5 pb-8 pt-7\" data-kid=\"2-2-2\" data-name=\"mobile onboarding content panel\">\n            <div data-kid=\"2-2-2-1\" data-name=\"mobile onboarding copy group\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-2-2-1-1\" data-name=\"mobile step counter group\">\n                    <span class=\"font-heading text-[11px] font-extrabold tracking-[0.14em] text-[#1E88E5]\" data-kid=\"2-2-2-1-1-1\" data-name=\"step counter\">\n                        01 / 03\n                    </span>\n                    <span class=\"h-px w-8 bg-[#CBD5E1]\" data-kid=\"2-2-2-1-1-2\" data-name=\"step divider\">\n                    </span>\n                    <span class=\"text-[11px] font-medium tracking-[0.05em] text-[#64748B]\" data-kid=\"2-2-2-1-1-3\" data-name=\"step context\">\n                        INICIO\n                    </span>\n                </div>\n                <h1 class=\"mt-6 font-heading text-[36px] font-extrabold leading-[1.06] tracking-[-0.055em] text-[#0F172A]\" data-kid=\"2-2-2-1-2\" data-name=\"mobile onboarding title\">\n                    Tu vehículo,\n                    <br data-kid=\"2-2-2-1-2-1\" data-name=\"title line break\"/>\n                    en control.\n                </h1>\n                <p class=\"mt-5 text-[16px] leading-7 text-[#475569]\" data-kid=\"2-2-2-1-3\" data-name=\"mobile onboarding description\">\n                    Registra el estado de tu auto y recibe recordatorios antes de que una reparación se vuelva urgente.\n                </p>\n                <div aria-label=\"Progreso del onboarding: paso 1 de 3\" class=\"mt-7 flex min-h-[44px] items-center gap-3\" data-kid=\"2-2-2-1-4\" data-name=\"mobile pagination indicators\">\n                    <span class=\"h-2.5 w-11 bg-[#1E88E5]\" data-kid=\"2-2-2-1-4-1\" data-name=\"active progress segment\">\n                    </span>\n                    <span class=\"h-2.5 w-2.5 border border-[#94A3B8] bg-transparent\" data-kid=\"2-2-2-1-4-2\" data-name=\"inactive progress marker\">\n                    </span>\n                    <span class=\"h-2.5 w-2.5 border border-[#94A3B8] bg-transparent\" data-kid=\"2-2-2-1-4-3\" data-name=\"inactive progress marker\">\n                    </span>\n                    <span class=\"ml-1 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-2-2-1-4-4\" data-name=\"progress text\">\n                        1 de 3\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-8 rounded-[16px] border border-[#CBD5E1]/40 bg-[#EEEDF0] p-4 shadow-[0_2px_4px_rgba(0,0,0,0.05)]\" data-kid=\"2-2-2-2\" data-name=\"mobile onboarding reassurance box\">\n                <div class=\"flex items-start gap-3\" data-kid=\"2-2-2-2-1\" data-name=\"mobile reassurance content\">\n                    <i class=\"ti ti-shield-check mt-0.5 text-[19px] text-[#1E88E5]\" data-kid=\"2-2-2-2-1-1\" data-name=\"trust icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <p class=\"text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-2-2-1-2\" data-name=\"trust note\">\n                        Tus datos quedan organizados para que puedas actuar a tiempo, con menos sorpresas en el taller.\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-8 text-left\" data-kid=\"2-2-2-3\" data-name=\"mobile onboarding footer mark\">\n                <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#94A3B8]\" data-kid=\"2-2-2-3-1\" data-name=\"footer label\">\n                    AUTODOC / 2026\n                </p>\n                <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-3-2\" data-name=\"footer description\">\n                    Diagnóstico y mantenimiento vehicular\n                </p>\n            </div>\n        </section>\n    </main>\n    <nav aria-label=\"Acciones de onboarding\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-[#F8FAFC]/95 px-5 pb-[calc(14px+env(safe-area-inset-bottom))] pt-3 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"mobile onboarding fixed action navigation\">\n        <div class=\"flex items-center gap-3\" data-kid=\"2-3-3\" data-name=\"navigation buttons container\">\n            <button aria-label=\"Omitir onboarding y continuar al inicio de sesión\" class=\"inline-flex min-h-[48px] flex-1 items-center justify-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] px-4 text-[14px] font-semibold text-[#5B6B80] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.10)] active:scale-[0.97]\" data-kid=\"2-3-1\" data-name=\"mobile skip button\">\n                Omitir\n            </button>\n            <button aria-label=\"Siguiente: continuar al segundo paso\" class=\"inline-flex min-h-[52px] flex-[1.6] items-center justify-center gap-3 rounded-full bg-gradient-to-br from-[#522C81] to-[#46246F] px-5 text-[14px] font-bold text-white shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.10)] active:scale-[0.97]\" data-kid=\"2-3-2\" data-name=\"mobile next button with gradient background\">\n                Siguiente\n                <i class=\"ti ti-arrow-right text-[18px]\" data-kid=\"2-3-2-1\" data-name=\"next arrow icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
