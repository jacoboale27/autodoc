-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                </button>\n                <button class=\"flex min-h-[44px] w-full items-center justify-between border border-[#334155] px-3 text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-6-3-2\" data-name=\"workshop 2 contact action\">\n                    MotorLab\n                    <span data-kid=\"2-2-6-3-2-1\" data-name=\"contact workshop 2 button text\">\n                        Contactar\n                        <i class=\"ti ti-arrow-up-right text-[14px]\" data-kid=\"2-2-6-3-2-1-1\" data-name=\"contact arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                </button>\n                <button class=\"flex min-h-[44px] w-full items-center justify-between border border-[#334155] px-3 text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-6-3-3\" data-name=\"workshop 3 contact action\">\n                    Centro Auto\n                    <span data-kid=\"2-2-6-3-3-1\" data-name=\"contact workshop 3 button text\">\n                        Contactar\n                        <i class=\"ti ti-arrow-up-right text-[14px]\" data-kid=\"2-2-6-3-3-1-1\" data-name=\"contact arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                </button>\n            </div>\n        </section>\n        <footer class=\"mt-8 flex flex-col gap-2 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-2-7\" data-name=\"footer section\">\n            <span data-kid=\"2-2-7-1\" data-name=\"footer brand text\">\n                AutoDoc · Diagnóstico y mantenimiento para tu vehículo\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-2-7-2\" data-name=\"sync status text\">\n                <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-7-2-1\" data-name=\"sync status indicator\">\n                </span>\n                Datos sincronizados hace 4 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/95 px-2 pb-[env(safe-area-inset-bottom)] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"bottom main navigation\">\n        <div class=\"flex h-[72px] items-start justify-around gap-1\" data-kid=\"2-3-1\" data-name=\"navigation items container\">\n            <a aria-current=\"page\" class=\"flex min-h-[56px] min-w-[44px] flex-1 flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] bg-[#1E293B] px-1 text-[#38BDF8]\" data-kid=\"2-3-1-1\" data-name=\"navigation dashboard link\" href=\"#inicio\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"2-3-1-1-1\" data-name=\"dashboard icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-1-2\" data-name=\"dashboard label\">\n                    Inicio\n                </span>\n            </a>\n            <a class=\"flex min-h-[56px] min-w-[44px] flex-1 flex-col items-center justify-center gap-1 border-t-2 border-transparent px-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"navigation garage link\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[18px]\" data-kid=\"2-3-1-2-1\" data-name=\"garage icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"garage label\">\n                    Mi garaje\n                </span>\n            </a>\n            <a class=\"flex min-h-[56px] min-w-[44px] flex-1 flex-col items-center justify-center gap-1 border-t-2 border-transparent px-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"navigation workshops link\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[18px]\" data-kid=\"2-3-1-3-1\" data-name=\"workshops icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a class=\"relative flex min-h-[56px] min-w-[44px] flex-1 flex-col items-center justify-center gap-1 border-t-2 border-transparent px-1 text-[#94A3B8]\" data-kid=\"2-3-1-4\" data-name=\"navigation alerts link\" href=\"#alertas\">\n                <i class=\"ti ti-alert-triangle text-[18px]\" data-kid=\"2-3-1-4-1\" data-name=\"alerts icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"alerts label\">\n                    Alertas\n                </span>\n                <span class=\"absolute right-[18%] top-1 size-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-3-1-4-3\" data-name=\"alerts badge indicator\">\n                </span>\n            </a>\n            <a class=\"flex min-h-[56px] min-w-[44px] flex-1 flex-col items-center justify-center gap-1 border-t-2 border-transparent px-1 text-[#94A3B8]\" data-kid=\"2-3-1-5\" data-name=\"navigation history link\" href=\"#historial\">\n                <i class=\"ti ti-history text-[18px]\" data-kid=\"2-3-1-5-1\" data-name=\"history icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-5-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
