 footer\">\n                                            <span data-kid=\"2-1-3-2-3-3-2-1-1-2-3-1\" data-name=\"timestamp text\">\n                                                Hace 12 min\n                                            </span>\n                                            <button aria-label=\"Abrir Toyota Yaris\" class=\"font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-3-3-2-1-1-2-3-2\" data-name=\"open repair button with button style\">\n                                                Abrir\n                                                <i class=\"ti ti-arrow-up-right\" data-kid=\"2-1-3-2-3-3-2-1-1-2-3-2-1\" data-name=\"open repair arrow icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                            </button>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"px-4 py-4\" data-kid=\"2-1-3-2-3-3-2-2\" data-name=\"repair card\">\n                                <div class=\"flex items-start gap-3\" data-kid=\"2-1-3-2-3-3-2-2-1\" data-name=\"card content wrapper\">\n                                    <span class=\"mt-0.5 text-[18px] text-[#10B981]\" data-kid=\"2-1-3-2-3-3-2-2-1-1\" data-name=\"card icon wrapper\">\n                                        <i class=\"ti ti-circle-check\" data-kid=\"2-1-3-2-3-3-2-2-1-1-1\" data-name=\"checkmark icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                    </span>\n                                    <div class=\"min-w-0 flex-1\" data-kid=\"2-1-3-2-3-3-2-2-1-2\" data-name=\"card details\">\n                                        <div class=\"flex items-start justify-between gap-2\" data-kid=\"2-1-3-2-3-3-2-2-1-2-1\" data-name=\"card title row\">\n                                            <p class=\"truncate text-[13px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-3-3-2-2-1-2-1-1\" data-name=\"vehicle model\">\n                                                Chevrolet Onix\n                                            </p>\n                                            <span class=\"shrink-0 text-[10px] font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-3-3-2-2-1-2-1-2\" data-name=\"priority tag\">\n                                                Lista\n                                            </span>\n                                        </div>\n                                        <p class=\"mt-1 text-[12px] text-[#475569]\" data-kid=\"2-1-3-2-3-3-2-2-1-2-2\" data-name=\"repair details\">\n                                            T 410-225 · Alineación\n                                        </p>\n                                        <div class=\"mt-2 flex items-center justify-between text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-3-2-2-1-2-3\" data-name=\"card footer\">\n                                            <span data-kid=\"2-1-3-2-3-3-2-2-1-2-3-1\" data-name=\"timestamp text\">\n                                                Hace 28 min\n                                            </span>\n                                            <button aria-label=\"Abrir Chevrolet Onix\" class=\"font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-3-3-2-2-1-2-3-2\" data-name=\"open repair button with button style\">\n                                                Abrir\n                                                <i class=\"ti ti-arrow-up-right\" data-kid=\"2-1-3-2-3-3-2-2-1-2-3-2-1\" data-name=\"open repair arrow icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                            </button>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                </section>\n                <div class=\"mt-6 flex items-start gap-3 border-l-4 border-[#CBD5E1] bg-white px-4 py-3\" data-kid=\"2-1-3-2-4\" data-name=\"responsive board hint\">\n                    <i class=\"ti ti-device-mobile text-[17px] text-[#64748B]\" data-kid=\"2-1-3-2-4-1\" data-name=\"device icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <p class=\"text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-4-2\" data-name=\"hint text\">\n                        En pantallas estrechas cambia entre estados mediante pestañas.\n                    </p>\n                </div>\n                <p class=\"mt-7 pb-2 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-5\" data-name=\"board footer\">\n                    AutoDoc · Gestión operativa del taller · Datos sincronizados hace 8 min\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
