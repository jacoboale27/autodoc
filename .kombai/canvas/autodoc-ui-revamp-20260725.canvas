p-2 bg-[#38BDF8] px-5 text-[13px] font-bold text-[#082F49]\" data-kid=\"2-1-3-2-2-1-2\">\n                            <i class=\"ti ti-search text-[16px]\" data-kid=\"2-1-3-2-2-1-2-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Buscar\n                        </button>\n                    </div>\n                    <div class=\"mt-3 flex items-center justify-between gap-4 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-2\">\n                        <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-2-2-1\">\n                            <i class=\"ti ti-info-circle text-[14px] text-[#818CF8]\" data-kid=\"2-1-3-2-2-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Busca por placa completa para abrir el historial correcto.\n                        </span>\n                        <span class=\"text-[#FBBF24]\" data-kid=\"2-1-3-2-2-2-2\">\n                            3 vehículos encontrados\n                        </span>\n                    </div>\n                </section>\n                <div class=\"mt-7 grid grid-cols-[minmax(0,1.35fr)_minmax(300px,0.65fr)] gap-7\" data-kid=\"2-1-3-2-3\">\n                    <section aria-labelledby=\"results-heading\" class=\"min-w-0\" data-kid=\"2-1-3-2-3-1\">\n                        <div class=\"mb-3 flex items-end justify-between\" data-kid=\"2-1-3-2-3-1-1\">\n                            <div data-kid=\"2-1-3-2-3-1-1-1\">\n                                <h2 class=\"text-[18px] font-bold tracking-[-0.02em] text-white\" data-kid=\"2-1-3-2-3-1-1-1-1\" id=\"results-heading\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                                    Resultados de búsqueda\n                                </h2>\n                                <p class=\"mt-1 text-[12px]