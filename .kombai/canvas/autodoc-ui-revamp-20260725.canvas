      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .about-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .about-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"about-body min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"1\" data-name=\"about dark application view\">\n    <header class=\"flex h-[76px] items-center justify-between border-b border-[#334155] bg-[#0B1220] px-8\" data-kid=\"1-1\" data-name=\"about app bar\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"about app bar title group\">\n            <div class=\"flex size-10 items-center justify-center rounded-[12px] bg-[#81E6D9] text-[#0F172A] shadow-[0_8px_24px_rgba(129,230,217,0.12)]\" data-kid=\"1-1-1-1\" data-name=\"about vehicle icon container\">\n                <i class=\"ti ti-car text-[20px]\" data-kid=\"1-1-1-1-1\" data-name=\"about vehicle icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"about app bar title container\">\n                <p class=\"about-heading text-[15px] font-bold tracking-[-0.03em] text-[#F8FAFC]\" data-kid=\"1-1-1-2-1\" data-name=\"about app bar title\">\n                    Acerca de AutoDoc\n                </p>\n                <p class=\"mt-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#64748B]\" data-kid=\"1-1-1-2-2\" data-name=\"about app bar context\">\n                    Información del producto\n                </p>\n            </div>\n        </div>\n        <button aria-label=\"Volver\" class=\"flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"1-1-2\" data-name=\"about back button\">\n            <i class=\"ti ti-arrow-left text-[18px]\" data-kid=\"1-1-2-1\" data-name=\"about back icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n        </button>\n    </header>\n    <main class=\"mx-auto w-full max-w-[720px] px-8 pb-14 pt-12\" data-kid=\"1-2\" data-name=\"about readable page body\">\n        <section class=\"flex flex-col items-center text-center\" data-kid=\"1-2-1\" data-name=\"about product identity\">\n            <div class=\"flex size-[128px] items-center justify-center rounded-full border border-[#81E6D9]/30 bg-[#81E6D9]/[0.10] text-[#81E6D9] shadow-[0_8px_24px_rgba(129,230,217,0.08)]\" data-kid=\"1-2-1-1\" data-name=\"about product icon circle\">\n                <i class=\"ti ti-car text-[58px]\" data-kid=\"1-2-1-1-1\" data-name=\"about product vehicle icon\" style=\"width:58px;height:58px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <h1 class=\"about-heading mt-7 text-[34px] font-extrabold tracking-[-0.055em] text-[#F8FAFC]\" data-kid=\"1-2-1-2\" data-name=\"about product name\">\n                AutoDoc\n            </h1>\n            <p class=\"mt-3 max-w-[520px] text-[16px] leading-6 text-[#94A3B8]\" data-kid=\"1-2-1-3\" data-name=\"about product tagline\">\n                Tu copiloto digital para el cuidado del vehículo\n            </p>\n        </section>\n        <section class=\"mt-10 overflow-hidden rounded-[16px] border border-[#334155] bg-[#141E36] shadow-[0_8px_24px_rgba(2,6,23,0.24)]\" data-kid=\"1-2-2\" data-name=\"about information card\">\n            <div class=\"flex min-h-[72px] items-center justify-between gap-5 border-b border-[#334155] px-6 py-4\" data-kid=\"1-2-2-1\" data-name=\"about version row\">\n                <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-2-1-1\" data-name=\"about version row content\">\n                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1E293B] text-[#81E6D9]\" data-kid=\"1-2-2-1-1-1\" data-name=\"about version icon container\">\n                        <i class=\"ti ti-info-circle text-[19px]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"about version icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"text-[15px] font-semibold text-[#F8FAFC]\" data-kid=\"1-2-2-1-1-2\" data-name=\"about version label\">\n                        Versión\n                    </span>\n                </div>\n                <span class=\"shrink-0 text-[14px] font-semibold tabular-nums text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2\" data-name=\"about version value\" data-reason=\"version string set by script\">\n                    —\n                </span>\n            </div>\n            <button class=\"flex min-h-[72px] w-full items-center justify-between gap-5 border-b border-[#334155] px-6 py-4 text-left transition duration-150 ease-out hover:bg-[#1E293B] active:scale-[0.99]\" data-kid=\"1-2-2-2\" data-name=\"about support row\">\n                <span class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-2-2-1\" data-name=\"about support row label container\">\n                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1E293B] text-[#81E6D9]\" data-kid=\"1-2-2-2-1-1\" data-name=\"about support icon container\">\n                        <i class=\"ti ti-mail text-[19px]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"about support icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"text-[15px] font-semibold text-[#F8FAFC]\" data-kid=\"1-2-2-2-1-2\" data-name=\"about support label\">\n                        Soporte Técnico\n                    </span>\n                </span>\n                <i class=\"ti ti-arrow-up-right shrink-0 text-[18px] text-[#64748B]\" data-kid=\"1-2-2-2-2\" data-name=\"about support arrow\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button class=\"flex min-h-[72px] w-full items-center justify-between gap-5 border-b border-[#334155] px-6 py-4 text-left transition duration-150 ease-out hover:bg-[#1E293B] active:scale-[0.99]\" data-kid=\"1-2-2-3\" data-name=\"about privacy row\">\n                <span class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-2-3-1\" data-name=\"about privacy row label container\">\n                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1E293B] text-[#81E6D9]\" data-kid=\"1-2-2-3-1-1\" data-name=\"about privacy icon container\">\n                        <i class=\"ti ti-shield-lock text-[19px]\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"about privacy icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"text-[15px] font-semibold text-[#F8FAFC]\" data-kid=\"1-2-2-3-1-2\" data-name=\"about privacy label\">\n                        Política de Privacidad\n                    </span>\n                </span>\n                <i class=\"ti ti-arrow-up-right shrink-0 text-[18px] text-[#64748B]\" data-kid=\"1-2-2-3-2\" data-name=\"about privacy arrow\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button class=\"flex min-h-[72px] w-full items-center justify-between gap-5 px-6 py-4 text-left transition duration-150 ease-out hover:bg-[#1E293B] active:scale-[0.99]\" data-kid=\"1-2-2-4\" data-name=\"about terms row\">\n                <span class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-2-4-1\" data-name=\"about terms row label container\">\n                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1E293B] text-[#81E6D9]\" data-kid=\"1-2-2-4-1-1\" data-name=\"about terms icon container\">\n                        <i class=\"ti ti-gavel text-[19px]\" data-kid=\"1-2-2-4-1-1-1\" data-name=\"about terms icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"text-[15px] font-semibold text-[#F8FAFC]\" data-kid=\"1-2-2-4-1-2\" data-name=\"about terms label\">\n                        Términos y Condiciones\n                    </span>\n                </span>\n                <i class=\"ti ti-arrow-up-right shrink-0 text-[18px] text-[#64748B]\" data-kid=\"1-2-2-4-2\" data-name=\"about terms arrow\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </section>\n        <footer class=\"mt-10 border-t border-[#334155] pt-6 text-center text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"1-2-3\" data-name=\"about copyright footer\">\n            <p data-kid=\"1-2-3-1\" data-name=\"about copyright text\">\n                © 2026 AutoDoc Inc.\n            </p>\n            <p data-kid=\"1-2-3-2\" data-name=\"about rights reserved text\">\n                Todos los derechos reservados.\n            </p>\n        </footer>\n    </main>\n</div>\n",
