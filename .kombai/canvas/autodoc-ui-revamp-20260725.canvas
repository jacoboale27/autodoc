data-kid=\"1-1-3-2-4-2-3-2\">\n                                taller_8f31a2\n                            </div>\n                        </div>\n                        <time class=\"text-right text-[11px] text-[#94A3B8]\" data-kid=\"1-1-3-2-4-2-4\">\n                            15/08/26\n                            <br data-kid=\"1-1-3-2-4-2-4-1\"/>\n                            <span class=\"font-semibold text-[#CBD5E1]\" data-kid=\"1-1-3-2-4-2-4-2\">\n                                08:42\n                            </span>\n                        </time>\n                    </article>\n                    <article class=\"grid grid-cols-[minmax(0,1.05fr)_minmax(0,1.35fr)_minmax(0,1.6fr)_120px] items-center gap-5 border-b border-[#334155] px-5 py-5\" data-kid=\"1-1-3-2-4-3\" data-name=\"reported review log entry\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-1-3-2-4-3-1\">\n                            <span class=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-[#422006] text-[#FBBF24]\" data-kid=\"1-1-3-2-4-3-1-1\">\n                                <i class=\"ti ti-flag\" data-kid=\"1-1-3-2-4-3-1-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                            <div data-kid=\"1-1-3-2-4-3-1-2\">\n                                <div class=\"text-[12px] font-bold text-[#FBBF24]\" data-kid=\"1-1-3-2-4-3-1-2-1\">\n                                    CAMBIAR ROL\n                                </div>\n                                <div class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"1-1-3-2-4-3-1-2-2\">\n                                    Moderación\n                                </div>\n                            </div>\n                        </div>\n                        <p class=\"text-[12px] leading-5 text-[#CBD5E1]\" data-kid=\"1-1-3-2-4-3-2\">\n         