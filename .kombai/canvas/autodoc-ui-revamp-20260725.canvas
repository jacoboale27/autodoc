    },
    "var_67d8f47e80c0": {
      "type": "variant",
      "label": "AutoDoc Admin Workshops — Hadrian Dark Mobile",
      "parentId": "var_3408f07cedd8",
      "themeId": null,
      "rect": {
        "x": 121955,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  :root {\n    --surface:#0F172A;\n    --surface-container:#141E36;\n    --surface-variant:#1E293B;\n    --outline:#334155;\n    --outline-strong:#475569;\n    --primary:#81E6D9;\n    --primary-deep:#6FC8BC;\n    --secondary:#8B7CF6;\n    --on-primary:#0F172A;\n    --text-primary:#F8FAFC;\n    --text-secondary:#94A3B8;\n    --muted:#64748B;\n    --success:#34D399;\n    --warning:#FBBF24;\n    --error:#F87171;\n  }\n  .workshop-mobile-body { font-family:'IBM Plex Sans',sans-serif; }\n  .workshop-mobile-heading { font-family:'Plus Jakarta Sans',sans-serif; }\n  .hide-scrollbar { scrollbar-width:none; -ms-overflow-style:none; }\n  .hide-scrollbar::-webkit-scrollbar { display:none; }\n</style>\n<div class=\"workshop-mobile-body min-h-screen overflow-x-hidden antialiased\" data-kid=\"1\" data-name=\"mobile page layout container\" style=\"background:var(--surface);color:var(--text-primary)\">\n    <header class=\"sticky top-0 z-30 border-b px-4 py-3 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"header container\" style=\"border-color:var(--outline);background:rgba(11,18,32,.96)\">\n        <div class=\"flex min-h-[48px] items-center justify-between gap-3\" data-kid=\"1-1-1\" data-name=\"header row container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"app title and branding container\">\n                <div class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] text-[17px] font-extrabold tracking-[-0.08em] shadow-[0_8px_24px_rgba(129,230,217,.14)] workshop-mobile-heading\" data-kid=\"1-1-1-1-1\" data-name=\"app logo initials\" style=\"background:var(--primary);color:var(--on-primary)\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"app title container\">\n                    <div class=\"truncate text-[10px] font-semibold uppercase tracking-[.16em]\" data-kid=\"1-1-1-1-2-1\" data-name=\"subheading category text\" style=\"color:var(--text-secondary)\">\n                        Administración\n                    </div>\n                    <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"1-1-1-1-2-2\" data-name=\"title container\">\n                        <span class=\"truncate text-[15px] font-bold tracking-[-.03em] workshop-mobile-heading\" data-kid=\"1-1-1-1-2-2-1\" data-name=\"page title text\">\n                            Gestionar talleres\n                        </span>\n                        <span class=\"size-1.5 shrink-0 rounded-full\" data-kid=\"1-1-1-1-2-2-2\" data-name=\"status indicator dot\" style=\"background:var(--success)\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-1-1-2\" data-name=\"header action buttons container\">\n                <button aria-label=\"Cambiar tema\" class=\"flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border\" data-kid=\"1-1-1-2-1\" data-name=\"theme toggle button\" style=\"border-color:var(--outline-strong);background:var(--surface-container);color:var(--text-secondary)\">\n                    <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"sun-moon icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Notificaciones\" class=\"relative flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border\" data-kid=\"1-1-1-2-2\" data-name=\"notifications button\" style=\"border-color:var(--outline-strong);background:var(--surface-container);color:var(--text-primary)\">\n                    <i class=\"ti ti-bell text-[17px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 size-1.5 rounded-full\" data-kid=\"1-1-1-2-2-2\" data-name=\"unread notification indicator dot\" style=\"background:var(--error)\">\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[480px] px-4 pb-[calc(112px+env(safe-area-inset-bottom))] pt-5\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-5\" data-kid=\"1-2-1\" data-name=\"page header section\">\n            <div class=\"mb-3 flex items-center gap-2 text-[11px]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation container\" style=\"color:var(--muted)\">\n                <span data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb category label\">\n                    Admin\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"1-2-1-1-2\" data-name=\"chevron icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-semibold\" data-kid=\"1-2-1-1-3\" data-name=\"current page label\" style=\"color:var(--text-primary)\">\n                    Talleres\n                </span>\n            </div>\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-1-2\" data-name=\"main title block\">\n                <div class=\"min-w-0\" data-kid=\"1-2-1-2-1\" data-name=\"title copy container\">\n                    <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[.2em]\" data-kid=\"1-2-1-2-1-1\" data-name=\"pre-heading label\" style=\"color:var(--primary)\">\n                        Gestión operativa\n                    </p>\n                    <h1 class=\"workshop-mobile-heading text-[27px] font-extrabold leading-[1.1] tracking-[-.045em]\" data-kid=\"1-2-1-2-1-2\" data-name=\"main page headline\">\n                        Gestionar talleres\n                    </h1>\n                    <p class=\"mt-2 text-[14px] leading-5\" data-kid=\"1-2-1-2-1-3\" data-name=\"description text\" style=\"color:var(--text-secondary)\">\n                        Administra perfiles, solicitudes formales y estados de operación.\n                    </p>\n                </div>\n                <button aria-label=\"Exportar CSV\" class=\"flex min-h-[48px] min-w-[48px] shrink-0 items-center justify-center rounded-full border\" data-kid=\"1-2-1-2-2\" data-name=\"export csv button\" style=\"border-color:var(--outline-strong);background:var(--surface-container);color:var(--primary)\">\n                    <i class=\"ti ti-download text-[18px]\" data-kid=\"1-2-1-2-2-1\" data-name=\"download icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <section class=\"rounded-[16px] border p-4 shadow-[0_2px_4px_rgba(0,0,0,.20)]\" data-kid=\"1-2-2\" data-name=\"search and filter section\" style=\"border-color:var(--outline);background:var(--surface-container)\">\n            <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"1-2-2-1\" data-name=\"section header\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"section title and description\">\n                    <h2 class=\"workshop-mobile-heading text-[15px] font-bold\" data-kid=\"1-2-2-1-1-1\" data-name=\"filter section title\">\n                        Buscar y filtrar\n                    </h2>\n                    <p class=\"mt-1 text-[11px]\" data-kid=\"1-2-2-1-1-2\" data-name=\"filter section description\" style=\"color:var(--text-secondary)\">\n                        Combina búsqueda, ubicación y especialidad.\n                    </p>\n                </div>\n                <button aria-label=\"Abrir filtros avanzados\" class=\"flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border\" data-kid=\"1-2-2-1-2\" data-name=\"advanced filters button\" style=\"border-color:var(--outline-strong);background:var(--surface-variant);color:var(--primary)\">\n                    <i class=\"ti ti-adjustments-horizontal text-[17px]\" data-kid=\"1-2-2-1-2-1\" data-name=\"adjustments icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex min-h-[50px] items-center gap-3 rounded-[12px] border px-3\" data-kid=\"1-2-2-2\" data-name=\"search input field placeholder\" style=\"border-color:var(--outline-strong);background:var(--surface-variant)\">\n                <i class=\"ti ti-search text-[18px]\" data-kid=\"1-2-2-2-1\" data-name=\"search icon\" style=\"width:18px;height:18px;color:var(--primary);display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[13px]\" data-kid=\"1-2-2-2-2\" data-name=\"search text\" style=\"color:var(--text-secondary)\">\n                    Buscar taller / mecánico...\n                </span>\n            </div>\n            <div class=\"hide-scrollbar mt-3 flex gap-2 overflow-x-auto pb-1\" data-kid=\"1-2-2-3\" data-name=\"filter tags container\">\n                <button class=\"flex min-h-[44px] shrink-0 items-center gap-2 rounded-full border px-3 text-[11px] font-semibold\" data-kid=\"1-2-2-3-1\" data-name=\"department filter button\" style=\"border-color:var(--outline-strong);background:var(--surface-variant);color:var(--text-primary)\">\n                    Departamento\n                    <i class=\"ti ti-chevron-down text-[13px]\" data-kid=\"1-2-2-3-1-1\" data-name=\"chevron icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-[44px] shrink-0 items-center gap-2 rounded-full border px-3 text-[11px] font-semibold\" data-kid=\"1-2-2-3-2\" data-name=\"municipality filter button\" style=\"border-color:var(--outline-strong);background:var(--surface-variant);color:var(--text-primary)\">\n                    Municipio\n                    <i class=\"ti ti-chevron-down text-[13px]\" data-kid=\"1-2-2-3-2-1\" data-name=\"chevron icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-[44px] shrink-0 items-center gap-2 rounded-full border px-3 text-[11px] font-semibold\" data-kid=\"1-2-2-3-3\" data-name=\"specialty filter button\" style=\"border-color:var(--outline-strong);background:var(--surface-variant);color:var(--text-primary)\">\n                    Especialidad\n                    <i class=\"ti ti-chevron-down text-[13px]\" data-kid=\"1-2-2-3-3-1\" data-name=\"chevron icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <section class=\"mt-7\" data-kid=\"1-2-3\" data-name=\"registered mechanics section\">\n            <div class=\"mb-3 flex items-end justify-between gap-3\" data-kid=\"1-2-3-1\" data-name=\"section header row\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"section heading\">\n                    <h2 class=\"workshop-mobile-heading text-[19px] font-bold tracking-[-.025em]\" data-kid=\"1-2-3-1-1-1\" data-name=\"section title\">\n                        Mecánicos registrados\n                    </h2>\n                    <p class=\"mt-1 text-[12px]\" data-kid=\"1-2-3-1-1-2\" data-name=\"