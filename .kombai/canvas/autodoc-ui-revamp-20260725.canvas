      "html": "<link data-kid=\"1\" data-name=\"Tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile service history page\">\n    <header class=\"sticky top-0 z-20 flex h-16 items-center justify-between border-b border-[#CBD5E1] bg-white/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[17px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc brand mark\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"mobile page title container\">\n                <p class=\"truncate text-[10px] font-bold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"mobile breadcrumb top label\">\n                    Taller\n                </p>\n                <p class=\"truncate font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-1-1-2-2\" data-name=\"mobile breadcrumb current title\">\n                    Historial\n                </p>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header actions\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"mobile notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"notifications icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\" data-name=\"notifications indicator badge\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-2\" data-name=\"mobile theme button\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-2-2-1\" data-name=\"theme toggle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"px-4 pb-32 pt-6\" data-kid=\"2-2\" data-name=\"mobile page content\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"mobile page header section\">\n            <div class=\"mb-3 flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1-4\" data-name=\"breadcrumb navigation container\">\n                <span data-kid=\"2-2-1-4-1\" data-name=\"breadcrumb parent page\">\n                    Taller\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-4-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-4-3\" data-name=\"breadcrumb current page\">\n                    Historial\n                </span>\n            </div>\n            <div class=\"flex items-end justify-between gap-3\" data-kid=\"2-2-1-5\" data-name=\"page header title area\">\n                <div class=\"min-w-0\" data-kid=\"2-2-1-5-1\" data-name=\"page headline text container\">\n                    <h1 class=\"font-heading text-[28px] font-extrabold leading-[1.1] tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-1\" data-name=\"history headline\">\n                        Historial de servicios\n                    </h1>\n                    <p class=\"mt-2 text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-2\" data-name=\"history description\">\n                        Consulta el trabajo realizado por tu equipo.\n                    </p>\n                </div>\n                <button aria-label=\"Exportar historial\" class=\"grid size-11 shrink-0 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[18px] text-[#522C81] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-[#F1F5F9] hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-2-1-3\" data-name=\"export history icon button\">\n                    <i class=\"ti ti-download\" data-kid=\"2-2-1-3-1\" data-name=\"download icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <section class=\"grid grid-cols-2 overflow-hidden border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-2\" data-name=\"mobile history summary\">\n            <div class=\"col-span-2 border-b border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-1\" data-name=\"summary total services container\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-2-1-1\" data-name=\"summary total services label\">\n                    Resumen del taller\n                </p>\n                <p class=\"mt-1 font-heading text-[22px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-2-2-1-2\" data-name=\"summary total count\">\n                    642\n                    <span class=\"font-body text-[12px] font-semibold tracking-normal text-[#64748B]\" data-kid=\"2-2-2-1-2-1\" data-name=\"summary total suffix text\">\n                        servicios este mes\n                    </span>\n                </p>\n            </div>\n            <div class=\"border-r border-[#E2E8F0] px-4 py-3.5\" data-kid=\"2-2-2-2\" data-name=\"summary completed services container\">\n                <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-1\" data-name=\"summary completed services label\">\n                    Completados\n                </p>\n                <p class=\"mt-1 font-heading text-[20px] font-bold tabular-nums text-[#10B981]\" data-kid=\"2-2-2-2-2\" data-name=\"summary completed services count\">\n                    598\n                </p>\n            </div>\n            <div class=\"px-4 py-3.5\" data-kid=\"2-2-2-3\" data-name=\"summary in review services container\">\n                <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-2-3-1\" data-name=\"summary in review services label\">\n                    En revisión\n                </p>\n                <p class=\"mt-1 font-heading text-[20px] font-bold tabular-nums text-[#F59E0B]\" data-kid=\"2-2-2-3-2\" data-name=\"summary in review services count\">\n                    44\n                </p>\n            </div>\n            <div class=\"col-span-2 border-t border-[#E2E8F0] px-4 py-3.5\" data-kid=\"2-2-2-4\" data-name=\"summary billing container\">\n                <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-2-4-1\" data-name=\"summary billing row\">\n                    <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-2-4-1-1\" data-name=\"summary billing label\">\n                        Facturación del mes\n                    </p>\n                    <p class=\"font-heading text-[20px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-2-2-4-1-2\" data-name=\"summary billing total\">\n                        $18,420\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-5 space-y-2.5\" data-kid=\"2-2-3\" data-name=\"mobile history filters\">\n            <div class=\"flex min-h-[48px] items-center gap-3 border border-[#CBD5E1] bg-white px-4 text-[13px] text-[#94A3B8]\" data-kid=\"2-2-3-1\" data-name=\"mobile search field\">\n                <i class=\"ti ti-search shrink-0 text-[17px] text-[#64748B]\" data-kid=\"2-2-3-1-1\" data-name=\"search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"min-w-0 truncate\" data-kid=\"2-2-3-1-2\" data-name=\"search field placeholder text\">\n                    Buscar por vehículo, cliente o servicio\n                </span>\n                <span class=\"ml-auto shrink-0 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-3-1-3\" data-name=\"search keyboard shortcut hint\">\n                    ⌘ K\n                </span>\n            </div>\n            <div class=\"grid grid-cols-2 gap-2.5\" data-kid=\"2-2-3-2\" data-name=\"mobile filter buttons\">\n                <button class=\"flex min-h-[48px] items-center justify-between gap-2 border border-[#CBD5E1] bg-white px-3 text-left text-[12px] font-medium text-[#334155]\" data-kid=\"2-2-3-2-1\" data-name=\"mobile period filter button\">\n                    Este mes\n                    <i class=\"ti ti-chevron-down shrink-0 text-[15px] text-[#64748B]\" data-kid=\"2-2-3-2-1-1\" data-name=\"period filter chevron icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-[48px] items-center justify-between gap-2 border border-[#CBD5E1] bg-white px-3 text-left text-[12px] font-medium text-[#334155]\" data-kid=\"2-2-3-2-2\" data-name=\"mobile status filter button\">\n                    Estados\n                    <i class=\"ti ti-chevron-down shrink-0 text-[15px] text-[#64748B]\" data-kid=\"2-2-3-2-2-1\" data-name=\"status filter chevron icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <section class=\"mt-6\" data-kid=\"2-2-4\" data-name=\"mobile services list\">\n            <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"2-2-4-4\" data-name=\"services list header\">\n                <h2 class=\"font-heading text-[15px] font-bold uppercase tracking-[0.11em] text-[#334155]\" data-kid=\"2-2-4-4-1\" data-name=\"services list title\">\n                    Servicios registrados\n                </h2>\n                <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-2-4-4-2\" data-name=\"services list count badge\">\n                    3 resultados\n                </span>\n            </div>\n            <div class=\"space-y-3\" data-kid=\"2-2-4-5\" data-name=\"services list container\">\n                <article class=\"border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4-1\" data-name=\"completed service card\">\n                    <div class=\"flex items-start justify-between gap-3 border-b border-[#E2E8F0] px-4 py-3\" data-kid=\"2-2-4-1-1\" data-name=\"completed service header\">\n                        <div data-kid=\"2-2-4-1-1-1\" data-name=\"completed service vehicle info\">\n                            <p class=\"text-[11px] font-semibold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-1-1-1-1\" data-name=\"completed service date\">\n                                12 jun 2026\n                            </p>\n                            <p class=\"mt-1 font-heading text-[16px] font-bold text-[#0F172A]\" data-kid=\"2-2-4-1-1-1-2\" data-name=\"completed service model\">\n                                Toyota Corolla\n                            </p>\n                            <p class=\"mt-0.5 text-[11px] tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-1-1-1-3\" data-name=\"completed service license plate\">\n                                P 482-916\n                            </p>\n                        </div>\n                        <span class=\"inline-flex shrink-0 items-center gap-1.5 pt-1 text-[12px] font-semibold text-[#059669]\" data-kid=\"2-2-4-1-1-2\" data-name=\"completed status label\">\n                            <i class=\"ti ti-circle-check text-[15px]\" data-kid=\"2-2-4-1-1-2-1\" data-name=\"checkmark icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Completado\n                        </span>\n                    </div>\n                    <dl class=\"grid grid-cols-2 gap-x-4 gap-y-3 px-4 py-4 text-[12px]\" data-kid=\"2-2-4-1-2\" data-name=\"service details list\">\n                        <div data-kid=\"2-2-4-1-2-1\" data-name=\"customer detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-1-2-1-1\" data-name=\"customer label\">\n                                Cliente\n                            </dt>\n                            <dd class=\"mt-0.5 font-medium text-[#334155]\" data-kid=\"2-2-4-1-2-1-2\" data-name=\"customer name\">\n                                Juan Pérez\n                            </dd>\n                        </div>\n                        <div data-kid=\"2-2-4-1-2-2\" data-name=\"service type detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-1-2-2-1\" data-name=\"service label\">\n                                Servicio\n                            </dt>\n                            <dd class=\"mt-0.5 font-medium text-[#334155]\" data-kid=\"2-2-4-1-2-2-2\" data-name=\"service type\">\n                                Cambio de aceite\n                            </dd>\n                        </div>\n                        <div data-kid=\"2-2-4-1-2-3\" data-name=\"technician detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-1-2-3-1\" data-name=\"technician label\">\n                                Técnico\n                            </dt>\n                            <dd class=\"mt-0.5 text-[#334155]\" data-kid=\"2-2-4-1-2-3-2\" data-name=\"technician name\">\n                                María Rodríguez\n                            </dd>\n                        </div>\n                        <div data-kid=\"2-2-4-1-2-4\" data-name=\"total cost detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-1-2-4-1\" data-name=\"total cost label\">\n                                Total\n                            </dt>\n                            <dd class=\"mt-0.5 font-semibold tabular-nums text-[#0F172A]\" data-kid=\"2-2-4-1-2-4-2\" data-name=\"total cost value\">\n                                $82.00\n                            </dd>\n                        </div>\n                    </dl>\n                </article>\n                <article class=\"border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4-2\" data-name=\"review service card\">\n                    <div class=\"flex items-start justify-between gap-3 border-b border-[#E2E8F0] px-4 py-3\" data-kid=\"2-2-4-2-1\" data-name=\"review service header\">\n                        <div data-kid=\"2-2-4-2-1-1\" data-name=\"review service vehicle info\">\n                            <p class=\"text-[11px] font-semibold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-1-1-1\" data-name=\"review service date\">\n                                18 may 2026\n                            </p>\n                            <p class=\"mt-1 font-heading text-[16px] font-bold text-[#0F172A]\" data-kid=\"2-2-4-2-1-1-2\" data-name=\"review service model\">\n                                Mazda 3\n                            </p>\n                            <p class=\"mt-0.5 text-[11px] tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-2-1-1-3\" data-name=\"review service license plate\">\n                                H 731-204\n                            </p>\n                        </div>\n                        <span class=\"inline-flex shrink-0 items-center gap-1.5 pt-1 text-[12px] font-semibold text-[#B45309]\" data-kid=\"2-2-4-2-1-2\" data-name=\"review status label\">\n                            <i class=\"ti ti-clock text-[15px]\" data-kid=\"2-2-4-2-1-2-1\" data-name=\"clock icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            En revisión\n                        </span>\n                    </div>\n                    <dl class=\"grid grid-cols-2 gap-x-4 gap-y-3 px-4 py-4 text-[12px]\" data-kid=\"2-2-4-2-2\" data-name=\"review details list\">\n                        <div data-kid=\"2-2-4-2-2-1\" data-name=\"customer detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-2-2-1-1\" data-name=\"customer label\">\n                                Cliente\n                            </dt>\n                            <dd class=\"mt-0.5 font-medium text-[#334155]\" data-kid=\"2-2-4-2-2-1-2\" data-name=\"customer name\">\n                                Laura Gómez\n                            </dd>\n                        </div>\n                        <div data-kid=\"2-2-4-2-2-2\" data-name=\"service type detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-2-2-2-1\" data-name=\"service label\">\n                                Servicio\n                            </dt>\n                            <dd class=\"mt-0.5 font-medium text-[#334155]\" data-kid=\"2-2-4-2-2-2-2\" data-name=\"service type\">\n                                Frenos\n                            </dd>\n                        </div>\n                        <div data-kid=\"2-2-4-2-2-3\" data-name=\"technician detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-2-2-3-1\" data-name=\"technician label\">\n                                Técnico\n                            </dt>\n                            <dd class=\"mt-0.5 text-[#334155]\" data-kid=\"2-2-4-2-2-3-2\" data-name=\"technician name\">\n                                Carlos Méndez\n                            </dd>\n                        </div>\n                        <div data-kid=\"2-2-4-2-2-4\" data-name=\"total cost detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-2-2-4-1\" data-name=\"total cost label\">\n                                Total\n                            </dt>\n                            <dd class=\"mt-0.5 font-semibold tabular-nums text-[#0F172A]\" data-kid=\"2-2-4-2-2-4-2\" data-name=\"total cost value\">\n                                $180.00\n                            </dd>\n                        </div>\n                    </dl>\n                </article>\n                <article class=\"border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4-3\" data-name=\"completed diagnosis card\">\n                    <div class=\"flex items-start justify-between gap-3 border-b border-[#E2E8F0] px-4 py-3\" data-kid=\"2-2-4-3-1\" data-name=\"diagnosis header\">\n                        <div data-kid=\"2-2-4-3-1-1\" data-name=\"diagnosis vehicle info\">\n                            <p class=\"text-[11px] font-semibold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-3-1-1-1\" data-name=\"diagnosis date\">\n                                04 feb 2026\n                            </p>\n                            <p class=\"mt-1 font-heading text-[16px] font-bold text-[#0F172A]\" data-kid=\"2-2-4-3-1-1-2\" data-name=\"diagnosis model\">\n                                Renault Duster\n                            </p>\n                            <p class=\"mt-0.5 text-[11px] tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-3-1-1-3\" data-name=\"diagnosis license plate\">\n                                J 204-118\n                            </p>\n                        </div>\n                        <span class=\"inline-flex shrink-0 items-center gap-1.5 pt-1 text-[12px] font-semibold text-[#059669]\" data-kid=\"2-2-4-3-1-2\" data-name=\"diagnosis status label\">\n                            <i class=\"ti ti-circle-check text-[15px]\" data-kid=\"2-2-4-3-1-2-1\" data-name=\"checkmark icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Completado\n                        </span>\n                    </div>\n                    <dl class=\"grid grid-cols-2 gap-x-4 gap-y-3 px-4 py-4 text-[12px]\" data-kid=\"2-2-4-3-2\" data-name=\"diagnosis details list\">\n                        <div data-kid=\"2-2-4-3-2-1\" data-name=\"customer detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-3-2-1-1\" data-name=\"customer label\">\n                                Cliente\n                            </dt>\n                            <dd class=\"mt-0.5 font-medium text-[#334155]\" data-kid=\"2-2-4-3-2-1-2\" data-name=\"customer name\">\n                                Andrés Ruiz\n                            </dd>\n                        </div>\n                        <div data-kid=\"2-2-4-3-2-2\" data-name=\"service type detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-3-2-2-1\" data-name=\"service label\">\n                                Servicio\n                            </dt>\n                            <dd class=\"mt-0.5 font-medium text-[#334155]\" data-kid=\"2-2-4-3-2-2-2\" data-name=\"service type\">\n                                Diagnóstico\n                            </dd>\n                        </div>\n                        <div data-kid=\"2-2-4-3-2-3\" data-name=\"technician detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-3-2-3-1\" data-name=\"technician label\">\n                                Técnico\n                            </dt>\n                            <dd class=\"mt-0.5 text-[#334155]\" data-kid=\"2-2-4-3-2-3-2\" data-name=\"technician name\">\n                                María Rodríguez\n                            </dd>\n                        </div>\n                        <div data-kid=\"2-2-4-3-2-4\" data-name=\"total cost detail\">\n                            <dt class=\"text-[#64748B]\" data-kid=\"2-2-4-3-2-4-1\" data-name=\"total cost label\">\n                                Total\n                            </dt>\n                            <dd class=\"mt-0.5 font-semibold tabular-nums text-[#0F172A]\" data-kid=\"2-2-4-3-2-4-2\" data-name=\"total cost value\">\n                                $95.00\n                            </dd>\n                        </div>\n                    </dl>\n                </article>\n            </div>\n        </section>\n        <section class=\"mt-4 border border-dashed border-[#CBD5E1] bg-white px-4 py-4\" data-kid=\"2-2-5\" data-name=\"mobile contextual empty state\">\n            <div class=\"flex items-start gap-3\" data-kid=\"2-2-5-1\" data-name=\"empty state content\">\n                <span class=\"grid size-9 shrink-0 place-items-center rounded-full bg-[#F1F5F9] text-[17px] text-[#64748B]\" data-kid=\"2-2-5-1-1\" data-name=\"empty state icon container\">\n                    <i class=\"ti ti-calendar-off\" data-kid=\"2-2-5-1-1-1\" data-name=\"calendar icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <div class=\"min-w-0\" data-kid=\"2-2-5-1-2\" data-name=\"empty state message text\">\n                    <p class=\"text-[13px] font-semibold text-[#334155]\" data-kid=\"2-2-5-1-2-1\" data-name=\"empty state title\">\n                        No hay más servicios en este periodo\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-2-5-1-2-2\" data-name=\"empty state description\">\n                        Amplía el rango de fechas para consultar registros anteriores.\n                    </p>\n                    <button class=\"mt-3 inline-flex min-h-[44px] items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-5-1-2-3\" data-name=\"empty state action button\">\n                        Cambiar periodo\n                        <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"2-2-5-1-2-3-1\" data-name=\"arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <footer class=\"mt-6 border-t border-[#CBD5E1] pt-4 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-6\" data-name=\"mobile history footer\">\n            <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-6-1\" data-name=\"footer info row\">\n                <span data-kid=\"2-2-6-1-1\" data-name=\"brand footer text\">\n                    AutoDoc · Gestión operativa del taller\n                </span>\n                <span class=\"flex shrink-0 items-center gap-2\" data-kid=\"2-2-6-1-2\" data-name=\"sync status container\">\n                    <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-2-6-1-2-1\" data-name=\"sync status indicator\">\n                    </span>\n                    Sincronizado\n                </span>\n            </div>\n            <p class=\"mt-2\" data-dynamic=\"true\" data-kid=\"2-2-6-2\" data-name=\"last sync timestamp text\" data-reason=\"timestamp updated by background sync process\">\n                Datos sincronizados hace 8 min\n            </p>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación del taller\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pt-2 backdrop-blur-sm\" data-kid=\"3\" data-name=\"mobile bottom navigation\" style=\"padding-bottom:max(env(safe-area-inset-bottom), 10px)\">\n        <div class=\"grid grid-cols-5 gap-1\" data-kid=\"3-1\" data-name=\"navigation grid container\">\n            <a aria-label=\"Panel\" class=\"flex min-h-[48px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"3-1-1\" data-name=\"dashboard navigation link\" href=\"#panel\">\n                <i class=\"ti ti-dashboard text-[18px]\" data-kid=\"3-1-1-1\" data-name=\"dashboard icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"3-1-1-2\" data-name=\"dashboard link text\">\n                    Panel\n                </span>\n            </a>\n            <a aria-label=\"Reparaciones\" class=\"relative flex min-h-[48px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"3-1-2\" data-name=\"repairs navigation link\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[18px]\" data-kid=\"3-1-2-1\" data-name=\"repairs icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"3-1-2-2\" data-name=\"repairs link text\">\n                    Reparaciones\n                </span>\n                <span class=\"absolute right-3 top-1 size-1.5 rounded-full bg-[#1E88E5]\" data-kid=\"3-1-2-3\" data-name=\"repairs alert indicator\">\n                </span>\n            </a>\n            <a aria-label=\"Buscar vehículo\" class=\"flex min-h-[48px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"3-1-3\" data-name=\"search navigation link\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[18px]\" data-kid=\"3-1-3-1\" data-name=\"search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"3-1-3-2\" data-name=\"search link text\">\n                    Buscar\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Historial\" class=\"flex min-h-[48px] flex-col items-center justify-center gap-1 rounded-lg bg-[#E8F2FD] text-[#1E88E5]\" data-kid=\"3-1-4\" data-name=\"history navigation link\" href=\"#historial\">\n                <i class=\"ti ti-history text-[18px]\" data-kid=\"3-1-4-1\" data-name=\"history icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-bold\" data-kid=\"3-1-4-2\" data-name=\"history link text\">\n                    Historial\n                </span>\n            </a>\n            <a aria-label=\"Reseñas\" class=\"flex min-h-[48px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"3-1-5\" data-name=\"reviews navigation link\" href=\"#resenas\">\n                <i class=\"ti ti-star text-[18px]\" data-kid=\"3-1-5-1\" data-name=\"reviews icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"3-1-5-2\" data-name=\"reviews link text\">\n                    Reseñas\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
