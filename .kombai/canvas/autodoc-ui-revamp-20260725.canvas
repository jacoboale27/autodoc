      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen w-full overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"mechanic service history mobile application\">\n    <header class=\"sticky top-0 z-20 flex min-h-[68px] items-center justify-between border-b border-[#334155] bg-[#020617] px-4\" data-kid=\"2-1\" data-name=\"mobile history top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile identity and context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-[12px] bg-[#38BDF8] text-[17px] font-heading font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\">\n                <p class=\"truncate text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-2-1\">\n                    Taller Rápido\n                </p>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-2-2\">\n                    <h1 class=\"font-heading text-[15px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-1-1-2-2-1\">\n                        Historial\n                    </h1>\n                    <span aria-label=\"En línea\" class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-2-2-2\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header actions\">\n            <button aria-label=\"Cambiar tema\" class=\"grid size-11 place-items-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-2-1\" data-name=\"theme switcher button\">\n                <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-2-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-full border border-[#334155] bg-[#141E36] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-2-2\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-2-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-2\">\n                </span>\n            </button>\n            <button aria-label=\"Perfil de María Rodríguez\" class=\"ml-1 grid size-11 place-items-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-2-3\">\n                MR\n            </button>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[112px] pt-6\" data-kid=\"2-2\" data-name=\"mobile history page body\">\n        <div class=\"mb-6 flex items-start justify-between gap-3\" data-kid=\"2-2-1\" data-name=\"mobile history heading area\">\n            <div class=\"min-w-0\" data-kid=\"2-2-1-1\">\n                <div class=\"mb-2 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-1-1\">\n                    <span data-kid=\"2-2-1-1-1-1\">\n                        Taller\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-2-1-1-1-2\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-2-1-1-1-3\">\n                        Historial\n                    </span>\n                </div>\n                <h2 class=\"font-heading text-[25px] font-extrabold leading-tight tracking-[-0.045em] text-white\" data-kid=\"2-2-1-1-2\">\n                    Historial de servicios\n                </h2>\n                <p class=\"mt-2 text-[13px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-1-3\">\n                    Revisa el trabajo realizado por tu equipo y el historial de cada vehículo.\n                </p>\n            </div>\n            <button aria-label=\"Exportar datos\" class=\"grid size-11 shrink-0 place-items-center border border-[#475569] text-[#38BDF8]\" data-kid=\"2-2-1-2\">\n                <i class=\"ti ti-download text-[16px]\" data-kid=\"2-2-1-2-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n        <section class=\"grid grid-cols-2 border-y border-[#475569] bg-[#111C2E]\" data-kid=\"2-2-2\" data-name=\"mobile operational summary\">\n            <div class=\"min-h-[112px] border-b border-r border-[#334155] px-3 py-4\" data-kid=\"2-2-2-1\" data-name=\"services month card\">\n                <div class=\"text-[10px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-2-1-1\">\n                    Servicios este mes\n                </div>\n                <div class=\"mt-1 flex flex-wrap items-baseline gap-1.5\" data-kid=\"2-2-2-1-2\">\n                    <strong class=\"font-heading text-[23px] tabular-nums text-white\" data-dynamic=\"true\" data-kid=\"2-2-2-1-2-1\" data-name=\"services count counter\" data-reason=\"number text fetched or calculated by app state\">\n                        642\n                    </strong>\n                    <span class=\"text-[10px] font-semibold text-[#34D399]\" data-kid=\"2-2-2-1-2-2\">\n                        +8.4%\n                    </span>\n                </div>\n                <div class=\"mt-1 text-[10px] text-[#64748B]\" data-kid=\"2-2-2-1-3\">\n                    vs. mes anterior\n                </div>\n            </div>\n            <div class=\"min-h-[112px] border-b border-[#334155] px-3 py-4\" data-kid=\"2-2-2-2\" data-name=\"revenue card\">\n                <div class=\"text-[10px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-2-2-1\">\n                    Ingresos registrados\n                </div>\n                <div class=\"mt-1 font-heading text-[19px] font-bold tabular-nums text-[#E2E8F0]\" data-dynamic=\"true\" data-kid=\"2-2-2-2-2\" data-name=\"revenue value\" data-reason=\"money value fetched or calculated by app state\">\n                    $8,420\n                </div>\n                <div class=\"mt-1 text-[10px] text-[#34D399]\" data-kid=\"2-2-2-2-3\">\n                    +12.6% mensual\n                </div>\n            </div>\n            <div class=\"min-h-[112px] border-r border-[#334155] px-3 py-4\" data-kid=\"2-2-2-3\" data-name=\"ticket value card\">\n                <div class=\"text-[10px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-2-3-1\">\n                    Ticket medio\n                </div>\n                <div class=\"mt-1 font-heading text-[19px] font-bold tabular-nums text-[#E2E8F0]\" data-dynamic=\"true\" data-kid=\"2-2-2-3-2\" data-name=\"average ticket value\" data-reason=\"money value fetched or calculated by app state\">\n                    $171.12\n                </div>\n                <div class=\"mt-1 text-[10px] text-[#64748B]\" data-kid=\"2-2-2-3-3\">\n                    por servicio\n                </div>\n            </div>\n            <div class=\"min-h-[112px] px-3 py-4\" data-kid=\"2-2-2-4\" data-name=\"sync status card\">\n                <div class=\"text-[10px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-2-4-1\">\n                    Última sincronización\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 text-[12px] font-semibold text-[#34D399]\" data-dynamic=\"true\" data-kid=\"2-2-2-4-2\" data-name=\"sync time status text\" data-reason=\"text updated periodically by synchronization script\">\n                    <span class=\"size-2 rounded-full bg-[#34D399]\" data-kid=\"2-2-2-4-2-1\">\n                    </span>\n                    Hace 4 min\n                </div>\n                <div class=\"mt-1 text-[10px] leading-4 text-[#64748B]\" data-kid=\"2-2-2-4-3\">\n                    Datos del taller actualizados\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-6 space-y-3\" data-kid=\"2-2-3\" data-name=\"mobile history filters\">\n            <div class=\"flex min-h-[46px] items-center gap-2 border border-[#475569] bg-[#111C2E] px-3 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-1\" data-name=\"search input field\">\n                <i class=\"ti ti-search shrink-0 text-[16px] text-[#94A3B8]\" data-kid=\"2-2-3-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"truncate\" data-kid=\"2-2-3-1-2\">\n                    Buscar por vehículo, cliente o servicio\n                </span>\n            </div>\n            <div class=\"grid grid-cols-[1fr_1fr_44px] gap-2\" data-kid=\"2-2-3-2\">\n                <button class=\"flex min-h-[46px] min-w-0 items-center justify-between gap-1 border border-[#475569] px-3 text-left text-[11px] font-medium text-[#CBD5E1]\" data-kid=\"2-2-3-2-1\" data-name=\"date range filter button\">\n                    <span class=\"flex min-w-0 items-center gap-1.5\" data-kid=\"2-2-3-2-1-1\">\n                        <i class=\"ti ti-calendar shrink-0 text-[15px] text-[#38BDF8]\" data-kid=\"2-2-3-2-1-1-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"truncate\" data-kid=\"2-2-3-2-1-1-2\">\n                            Últimos 30 días\n                        </span>\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[13px] text-[#64748B]\" data-kid=\"2-2-3-2-1-2\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-[46px] min-w-0 items-center justify-between gap-1 border border-[#475569] px-3 text-left text-[11px] font-medium text-[#CBD5E1]\" data-kid=\"2-2-3-2-2\" data-name=\"status filter button\">\n                    <span class=\"truncate\" data-kid=\"2-2-3-2-2-1\">\n                        Todos los estados\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[13px] text-[#64748B]\" data-kid=\"2-2-3-2-2-2\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Limpiar filtros\" class=\"grid min-h-[46px] min-w-[44px] place-items-center text-[#94A3B8]\" data-kid=\"2-2-3-2-3\" data-name=\"clear filters button\">\n                    <i class=\"ti ti-adjustments-horizontal text-[17px]\" data-kid=\"2-2-3-2-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <section class=\"mt-6 border-y border-[#475569]\" data-kid=\"2-2-4\" data-name=\"mobile service history list\">\n            <div class=\"flex items-center justify-between border-b border-[#334155] px-3 py-3\" data-kid=\"2-2-4-1\">\n                <span class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-4-1-1\">\n                    Servicios registrados\n                </span>\n                <span class=\"text-[10px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-4-1-2\" data-name=\"results count indicator\" data-reason=\"text updated based on current filtered results list\">\n                    3 resultados\n                </span>\n            </div>\n            <article class=\"border-b border-[#334155] px-3 py-4\" data-kid=\"2-2-4-2\" data-name=\"completed service card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-2-1\">\n                    <div data-kid=\"2-2-4-2-1-1\">\n                        <div class=\"text-[11px] tabular-nums text-[#94A3B8]\" data-kid=\"2-2-4-2-1-1-1\">\n                            12 jun\n                        </div>\n                        <h3 class=\"mt-1 text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-4-2-1-1-2\">\n                            Toyota Corolla\n                        </h3>\n                        <p class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-1-1-3\">\n                            P 482-916 · 48,260 km\n                        </p>\n                    </div>\n                    <span class=\"flex min-h-[26px] items-center gap-1.5 bg-[#064E3B]/35 px-2 text-[10px] font-semibold text-[#6EE7B7]\" data-kid=\"2-2-4-2-1-2\">\n                        <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-4-2-1-2-1\">\n                        </span>\n                        Completado\n                    </span>\n                </div>\n                <div class=\"mt-4 grid grid-cols-2 gap-x-3 gap-y-3 border-t border-[#334155] pt-3 text-[11px]\" data-kid=\"2-2-4-2-2\">\n                    <div data-kid=\"2-2-4-2-2-1\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-2-2-1-1\">\n                            Cliente\n                        </div>\n                        <div class=\"mt-1 text-[#CBD5E1]\" data-kid=\"2-2-4-2-2-1-2\">\n                            Juan Pérez\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-2-2-2\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-2-2-2-1\">\n                            Servicio\n                        </div>\n                        <div class=\"mt-1 text-[#CBD5E1]\" data-kid=\"2-2-4-2-2-2-2\">\n                            Cambio de aceite\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-2-2-3\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-2-2-3-1\">\n                            Técnico\n                        </div>\n                        <div class=\"mt-1 text-[#94A3B8]\" data-kid=\"2-2-4-2-2-3-2\">\n                            María Rodríguez\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-2-2-4\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-2-2-4-1\">\n                            Total\n                        </div>\n                        <div class=\"mt-1 font-semibold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-4-2-2-4-2\">\n                            $82.00\n                        </div>\n                    </div>\n                </div>\n            </article>\n            <article class=\"border-b border-[#334155] bg-[#111C2E]/55 px-3 py-4\" data-kid=\"2-2-4-3\" data-name=\"pending service card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-3-1\">\n                    <div data-kid=\"2-2-4-3-1-1\">\n                        <div class=\"text-[11px] tabular-nums text-[#94A3B8]\" data-kid=\"2-2-4-3-1-1-1\">\n                            08 jun\n                        </div>\n                        <h3 class=\"mt-1 text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-4-3-1-1-2\">\n                            Mazda 3\n                        </h3>\n                        <p class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-3-1-1-3\">\n                            H 731-204 · 81,430 km\n                        </p>\n                    </div>\n                    <span class=\"flex min-h-[26px] items-center gap-1.5 bg-[#713F12]/35 px-2 text-[10px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-4-3-1-2\">\n                        <span class=\"size-1.5 rounded-full bg-[#FBBF24]\" data-kid=\"2-2-4-3-1-2-1\">\n                        </span>\n                        En revisión\n                    </span>\n                </div>\n                <div class=\"mt-4 grid grid-cols-2 gap-x-3 gap-y-3 border-t border-[#334155] pt-3 text-[11px]\" data-kid=\"2-2-4-3-2\">\n                    <div data-kid=\"2-2-4-3-2-1\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-3-2-1-1\">\n                            Cliente\n                        </div>\n                        <div class=\"mt-1 text-[#CBD5E1]\" data-kid=\"2-2-4-3-2-1-2\">\n                            Laura Gómez\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-3-2-2\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-3-2-2-1\">\n                            Servicio\n                        </div>\n                        <div class=\"mt-1 text-[#CBD5E1]\" data-kid=\"2-2-4-3-2-2-2\">\n                            Frenos\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-3-2-3\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-3-2-3-1\">\n                            Técnico\n                        </div>\n                        <div class=\"mt-1 text-[#94A3B8]\" data-kid=\"2-2-4-3-2-3-2\">\n                            Carlos Méndez\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-3-2-4\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-3-2-4-1\">\n                            Total\n                        </div>\n                        <div class=\"mt-1 font-semibold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-4-3-2-4-2\">\n                            $180.00\n                        </div>\n                    </div>\n                </div>\n            </article>\n            <article class=\"border-b border-[#334155] px-3 py-4\" data-kid=\"2-2-4-4\" data-name=\"completed diagnostic card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-4-1\">\n                    <div data-kid=\"2-2-4-4-1-1\">\n                        <div class=\"text-[11px] tabular-nums text-[#94A3B8]\" data-kid=\"2-2-4-4-1-1-1\">\n                            04 jun\n                        </div>\n                        <h3 class=\"mt-1 text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-4-4-1-1-2\">\n                            Renault Duster\n                        </h3>\n                        <p class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-4-1-1-3\">\n                            J 204-118 · 62,110 km\n                        </p>\n                    </div>\n                    <span class=\"flex min-h-[26px] items-center gap-1.5 bg-[#064E3B]/35 px-2 text-[10px] font-semibold text-[#6EE7B7]\" data-kid=\"2-2-4-4-1-2\">\n                        <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-4-4-1-2-1\">\n                        </span>\n                        Completado\n                    </span>\n                </div>\n                <div class=\"mt-4 grid grid-cols-2 gap-x-3 gap-y-3 border-t border-[#334155] pt-3 text-[11px]\" data-kid=\"2-2-4-4-2\">\n                    <div data-kid=\"2-2-4-4-2-1\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-4-2-1-1\">\n                            Cliente\n                        </div>\n                        <div class=\"mt-1 text-[#CBD5E1]\" data-kid=\"2-2-4-4-2-1-2\">\n                            Andrés Ruiz\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-4-2-2\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-4-2-2-1\">\n                            Servicio\n                        </div>\n                        <div class=\"mt-1 text-[#CBD5E1]\" data-kid=\"2-2-4-4-2-2-2\">\n                            Diagnóstico\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-4-2-3\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-4-2-3-1\">\n                            Técnico\n                        </div>\n                        <div class=\"mt-1 text-[#94A3B8]\" data-kid=\"2-2-4-4-2-3-2\">\n                            María Rodríguez\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-4-4-2-4\">\n                        <div class=\"text-[#64748B]\" data-kid=\"2-2-4-4-2-4-1\">\n                            Total\n                        </div>\n                        <div class=\"mt-1 font-semibold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-4-4-2-4-2\">\n                            $95.00\n                        </div>\n                    </div>\n                </div>\n            </article>\n            <div class=\"flex flex-col gap-3 bg-[#0B1220] px-3 py-4 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-5\" data-name=\"empty hint row\">\n                <span class=\"flex items-start gap-2\" data-kid=\"2-2-4-5-1\">\n                    <i class=\"ti ti-info-circle mt-0.5 shrink-0 text-[16px] text-[#818CF8]\" data-kid=\"2-2-4-5-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-2-4-5-1-2\">\n                        No hay más servicios en este periodo.\n                    </span>\n                </span>\n                <button class=\"flex min-h-[44px] items-center gap-2 self-start font-semibold text-[#38BDF8]\" data-kid=\"2-2-4-5-2\">\n                    Ampliar periodo\n                    <i class=\"ti ti-arrow-up-right text-[14px]\" data-kid=\"2-2-4-5-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <div class=\"mt-5 flex items-center justify-between gap-3 text-[11px] text-[#64748B]\" data-kid=\"2-2-5\" data-name=\"mobile pagination footer\">\n            <span data-dynamic=\"true\" data-kid=\"2-2-5-1\" data-name=\"showing results summary\" data-reason=\"text updated based on dynamic list state\">\n                Mostrando 3 de 642 servicios\n            </span>\n            <div class=\"flex items-center gap-2\" data-kid=\"2-2-5-2\">\n                <button aria-label=\"Página anterior\" class=\"grid size-11 place-items-center border border-[#334155] text-[#64748B]\" data-kid=\"2-2-5-2-1\">\n                    <i class=\"ti ti-chevron-left text-[14px]\" data-kid=\"2-2-5-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <span class=\"tabular-nums text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-2-5-2-2\" data-name=\"pagination status text\" data-reason=\"text updated based on current page state\">\n                    1 / 54\n                </span>\n                <button aria-label=\"Página siguiente\" class=\"grid size-11 place-items-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-2-5-2-3\">\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-2-5-2-3-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <footer class=\"mt-8 flex flex-col gap-2 border-t border-[#334155] pt-4 text-[10px] text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"mobile history footer\">\n            <span data-kid=\"2-2-6-1\">\n                AutoDoc · Gestión operativa del taller\n            </span>\n            <span class=\"flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-2-6-2\" data-name=\"sync status text in footer\" data-reason=\"text updated periodically by synchronization script\">\n                <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-6-2-1\">\n                </span>\n                Datos sincronizados hace 4 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/98 px-2 pb-[max(10px,env(safe-area-inset-bottom))] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-5 gap-1\" data-kid=\"2-3-1\">\n            <a aria-label=\"Panel\" class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" href=\"#panel\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[9px] font-medium\" data-kid=\"2-3-1-1-2\">\n                    Panel\n                </span>\n            </a>\n            <a aria-label=\"Reparaciones\" class=\"relative flex min-h-[54px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[9px] font-medium\" data-kid=\"2-3-1-2-2\">\n                    Reparaciones\n                </span>\n                <span class=\"absolute right-2 top-1 size-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-3-1-2-3\">\n                </span>\n            </a>\n            <a aria-label=\"Buscar vehículo\" class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[19px]\" data-kid=\"2-3-1-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[9px] font-medium\" data-kid=\"2-3-1-3-2\">\n                    Buscar\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Historial\" class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-3-1-4\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-4-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[9px] font-semibold\" data-kid=\"2-3-1-4-2\">\n                    Historial\n                </span>\n            </a>\n            <a aria-label=\"Conversaciones\" class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-5\" href=\"#conversaciones\">\n                <i class=\"ti ti-message-circle text-[19px]\" data-kid=\"2-3-1-5-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[9px] font-medium\" data-kid=\"2-3-1-5-2\">\n                    Chat\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
