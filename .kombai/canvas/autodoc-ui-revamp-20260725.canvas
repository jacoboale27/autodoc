abel\">\n                        Especialidad\n                    </span>\n                    <i class=\"ti ti-chevron-down text-[15px]\" data-kid=\"1-2-2-3-3-2\" data-name=\"specialty dropdown icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <section class=\"mt-7\" data-kid=\"1-2-3\" data-name=\"registered mechanics section\">\n            <div class=\"mb-3 flex items-end justify-between gap-3\" data-kid=\"1-2-3-1\" data-name=\"section header container\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"section header text group\">\n                    <h2 class=\"font-heading text-[19px] font-bold tracking-[-0.03em]\" data-kid=\"1-2-3-1-1-1\" data-name=\"mechanics section title\">\n                        Mecánicos registrados\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-2-3-1-1-2\" data-name=\"mechanics count description\">\n                        3 usuarios con rol Taller o Mecánico\n                    </p>\n                </div>\n                <span class=\"rounded-full border border-[var(--outline)] bg-[var(--surface-container)] px-3 py-2 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-2-3-1-2\" data-name=\"user count badge\">\n                    3 usuarios\n                </span>\n            </div>\n            <div class=\"space-y-3\" data-kid=\"1-2-3-2\" data-name=\"mechanics list container\">\n                <article class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-4 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-3-2-1\" data-name=\"mechanic admin card\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"1-2-3-2-1-1\" data-name=\"mechanic card header row\">\n                        <div class=\"grid size-11 shrink-0 place-it