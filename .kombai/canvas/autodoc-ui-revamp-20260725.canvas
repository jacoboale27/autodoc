3-2-1-1\" data-name=\"maintenance icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-5-3-2-1-2\" data-name=\"maintenance type label\">\n                            Mantenimiento\n                        </span>\n                    </div>\n                    <p class=\"mt-3 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-3-2-2\" data-name=\"maintenance title\">\n                        Revisión de frenos\n                    </p>\n                    <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-2-5-3-2-3\" data-name=\"maintenance details\">\n                        18 may 2026 · 46,520 km\n                    </p>\n                </div>\n                <div class=\"px-4 py-4\" data-kid=\"2-2-5-3-3\" data-name=\"timeline document soat event\">\n                    <div class=\"flex items-center gap-2 text-[17px] text-[#EF4444]\" data-kid=\"2-2-5-3-3-1\" data-name=\"soat event head\">\n                        <i class=\"ti ti-file-alert\" data-kid=\"2-2-5-3-3-1-1\" data-name=\"soat icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-5-3-3-1-2\" data-name=\"soat type label\">\n                            Documento\n                        </span>\n                    </div>\n                    <p class=\"mt-3 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-3-3-2\" data-name=\"soat title\">\n                        SOAT\n                    </p>\n                    <p class=\"mt-1 text-[11px] text-[#EF4444]\" data-kid=\"2-2-5-3-3-3\" data-name=\"soat details\">\n                        Vencido · 18 ago 2026\n                    </p>\n                </div>\n                <div class=\"px-4 py-4\" data-kid=\"2-2-5-3-4\" data-name=\"timeline document tecno event\">\n                    <div class=\"flex items-center gap-2 text-[17px] text-[#F59E0B]\" data-kid=\"2-2-5-3-4-1\" data-name=\"tecno event head\">\n                        <i class=\"ti ti-file-certificate\" data-kid=\"2-2-5-3-4-1-1\" data-name=\"tecno icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-5-3-4-1-2\" data-name=\"tecno type label\">\n                            Documento\n                        </span>\n                    </div>\n                    <p class=\"mt-3 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-3-4-2\" data-name=\"tecno title\">\n                        Tecnomecánica\n                    </p>\n                    <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-2-5-3-4-3\" data-name=\"tecno details\">\n                        Actualiza la fecha\n                    </p>\n                </div>\n            </div>\n        </section>\n        <p class=\"mt-6 pb-2 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-6\" data-name=\"footer credits\">\n            AutoDoc · Diagnóstico y mantenimiento vehicular · Datos sincronizados con tu garaje\n        </p>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pb-[env(safe-area-inset-bottom)] shadow-[0_-4px_18px_rgba(15,23,42,0.08)] backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"mobile bottom navigation\">\n        <div class=\"mx-auto flex h-[72px] max-w-[440px] items-stretch justify-between gap-1\" data-kid=\"2-3-6\" data-name=\"navigation items container\">\n            <a class=\"flex min-w-0 flex-1 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1\" data-name=\"inicio navigation item\" href=\"#inicio\">\n                <i class=\"ti ti-dashboard text-[19px]\" data-kid=\"2-3-1-1\" data-name=\"inicio icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2\" data-name=\"inicio label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-w-0 flex-1 flex-col items-center justify-center gap-1 text-[#1E88E5]\" data-kid=\"2-3-2\" data-name=\"garage navigation item\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-2-1\" data-name=\"garage icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-2-2\" data-name=\"garage label\">\n                    Mi garaje\n                </span>\n            </a>\n            <a class=\"flex min-w-0 flex-1 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-3\" data-name=\"workshops navigation item\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-3-1\" data-name=\"workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a class=\"relative flex min-w-0 flex-1 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-4\" data-name=\"alerts navigation item\" href=\"#alertas\">\n                <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-4-1\" data-name=\"alerts icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-4-2\" data-name=\"alerts label\">\n                    Alertas\n                </span>\n                <span class=\"absolute right-[18%] top-[12px] size-1.5 rounded-full bg-[#EF4444]\" data-kid=\"2-3-4-3\" data-name=\"alerts badge\">\n                </span>\n            </a>\n            <a class=\"flex min-w-0 flex-1 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-5\" data-name=\"history navigation item\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-5-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-5-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
