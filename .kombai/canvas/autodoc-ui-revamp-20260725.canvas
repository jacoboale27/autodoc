      },
      "html": "<link data-kid=\"1\" data-name=\"google icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"vehicle profile mobile page\">\n    <header class=\"sticky top-0 z-20 flex h-16 items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"mobile vehicle profile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[17px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"mobile brand mark\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"vehicle context wrapper\">\n                <p class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"context label\">\n                    Mi garaje\n                </p>\n                <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-1-2-2\" data-name=\"vehicle model name\">\n                    Toyota Corolla 2022\n                </p>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile top bar actions\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-[9px] top-[9px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\" data-name=\"notification status indicator\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-2-2\" data-name=\"theme toggle button\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-2-2-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[440px] px-4 pb-[calc(92px+env(safe-area-inset-bottom))] pt-6\" data-kid=\"2-2\" data-name=\"mobile vehicle profile content\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"mobile vehicle profile heading\">\n            <div class=\"mb-2 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"vehicle active status\">\n                <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-2-1-1-1\" data-name=\"status dot\">\n                </span>\n                Vehículo activo\n            </div>\n            <h1 class=\"font-heading text-[28px] font-extrabold leading-tight tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2\" data-name=\"vehicle headline title\">\n                Toyota Corolla 2022\n            </h1>\n            <div class=\"mt-1 flex items-center justify-between gap-3\" data-kid=\"2-2-1-5\" data-name=\"vehicle identity and actions\">\n                <p class=\"text-[14px] font-semibold tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-1-5-1\" data-name=\"vehicle license plate\">\n                    P 482-916\n                </p>\n                <button aria-label=\"Más opciones del vehículo\" class=\"grid size-11 shrink-0 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[18px] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-2-1-3\" data-name=\"vehicle options button\">\n                    <i class=\"ti ti-dots\" data-kid=\"2-2-1-3-1\" data-name=\"dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <button class=\"mt-4 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#45236F] px-5 py-3 text-[13px] font-semibold text-white shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.97]\" data-kid=\"2-2-1-4\" data-name=\"register service button\">\n                <i class=\"ti ti-tool text-[16px]\" data-kid=\"2-2-1-4-1\" data-name=\"tool icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Registrar servicio\n            </button>\n        </div>\n        <section aria-label=\"Resumen del vehículo\" class=\"overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-white shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" dat