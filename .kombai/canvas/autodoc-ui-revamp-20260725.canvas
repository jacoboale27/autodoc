      "html": "<link data-kid=\"1\" data-name=\"Tabler icon webfont stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style>\n    [data-name=\"new conversation button\"], [data-name=\"conversation menu button\"], [data-name=\"theme toggle button\"], [data-name=\"notifications button\"], [data-name=\"notification bell button\"], [data-name=\"more options button\"], [data-name=\"attach file button\"] { min-width:44px !important; min-height:44px !important; border-radius:999px !important; background:#EEEDF0 !important; border:1px solid #CBD5E1 !important; box-shadow:0 1px 2px rgba(15,23,42,0.05); transition:transform 150ms ease-out, background 150ms ease-out, box-shadow 150ms ease-out; }\n  [data-name=\"new conversation button\"]:hover, [data-name=\"conversation menu button\"]:hover, [data-name=\"theme toggle button\"]:hover, [data-name=\"notifications button\"]:hover, [data-name=\"notification bell button\"]:hover, [data-name=\"more options button\"]:hover, [data-name=\"attach file button\"]:hover { transform:scale(1.02); background:#F8FAFC !important; box-shadow:0 6px 14px rgba(15,23,42,0.12); }\n  [data-name=\"new conversation button\"]:active, [data-name=\"conversation menu button\"]:active, [data-name=\"theme toggle button\"]:active, [data-name=\"notifications button\"]:active, [data-name=\"notification bell button\"]:active, [data-name=\"more options button\"]:active, [data-name=\"attach file button\"]:active { transform:scale(0.97); }\n</style>\n<div class=\"font-body flex h-screen min-h-[720px] overflow-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"chat application shell\">\n    <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1\" data-name=\"primary application rail\">\n        <div class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1\" data-name=\"AutoDoc logo\">\n            AD\n        </div>\n        <nav aria-label=\"Navegación principal\" class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-2\" data-name=\"primary rail navigation\">\n            <button aria-label=\"Inicio\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-2-1\" data-name=\"home navigation button\">\n                <span class=\"text-[20px]\" data-kid=\"2-1-2-1-1\">\n                    <i class=\"ti ti-dashboard\" data-kid=\"2-1-2-1-1-1\" data-name=\"dashboard icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </span>\n            </button>\n            <button aria-label=\"Mi garaje\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-2-2\" data-name=\"garage navigation button\">\n                <span class=\"text-[20px]\" data-kid=\"2-1-2-2-1\">\n                    <i class=\"ti ti-car\" data-kid=\"2-1-2-2-1-1\" data-name=\"car icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </span>\n            </button>\n            <button aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-2-3\" data-name=\"workshops navigation button\">\n                <span class=\"text-[20px]\" data-kid=\"2-1-2-3-1\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-2-3-1-1\" data-name=\"tool icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </span>\n            </button>\n            <button aria-current=\"page\" aria-label=\"Conversaciones\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-2-4\" data-name=\"active chat navigation button\">\n                <span class=\"text-[20px]\" data-kid=\"2-1-2-4-1\">\n                    <i class=\"ti ti-message-2\" data-kid=\"2-1-2-4-1-1\" data-name=\"message icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF\">\n                    </i>\n                </span>\n            </button>\n            <button aria-label=\"Alertas\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-2-5\" data-name=\"alerts navigation button\">\n                <span class=\"text-[20px]\" data-kid=\"2-1-2-5-1\">\n                    <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-2-5-1-1\" data-name=\"alert icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </span>\n            </button>\n        </nav>\n        <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-3\" data-name=\"utility rail navigation\">\n            <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-3-1\" data-name=\"help button\">\n                <span class=\"text-[19px]\" data-kid=\"2-1-3-1-1\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-3-1-1-1\" data-name=\"help icon\" style=\"width:19px;height:19px;display:inline