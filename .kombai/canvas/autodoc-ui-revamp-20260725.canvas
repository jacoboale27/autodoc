        "x": 71870,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile catalog page root\">\n    <header class=\"sticky top-0 z-20 border-b border-[#CBD5E1] bg-white/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile catalog top bar\">\n        <div class=\"flex min-h-[68px] items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"mobile top bar content\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"mobile workshop identity\">\n                <div aria-label=\"AutoDoc\" class=\"grid size-11 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc brand mark\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-4\">\n                    <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-1-2\" data-name=\"mobile workshop label\">\n                        Taller\n                    </p>\n                    <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-1-3\" data-name=\"mobile workshop status\">\n                        <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-1-1-3-1\" data-name=\"online status dot\">\n                        </span>\n                        <span class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-1-1-3-2\" data-name=\"workshop name\">\n                            Taller Rápido\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"mobile utility actions\">\n                <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-full border border-[#CBD5E1]/40 bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-1-2-1\" data-name=\"mobile notifications button\">\n                    <i class=\"ti ti-bell\" data-kid=\"2-1-1-2-1-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-[9px] top-[8px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-1-2-1-2\" data-name=\"notification badge\">\n                    </span>\n                </button>\n                <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-1-2-2\" data-name=\"mobile theme toggle button\">\n                    <i class=\"ti ti-moon\" data-kid=\"2-1-1-2-2-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <div class=\"grid size-10 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-1-2-3\" data-name=\"mobile user avatar\">\n                    MR\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-2 border-t border-[#F1F5F9] py-2 text-[11px]\" data-kid=\"2-1-2\" data-name=\"mobile breadcrumb row\">\n            <span class=\"text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"parent breadcrumb\">\n                Taller\n            </span>\n            <i class=\"ti ti-chevron-right text-[13px] text-[#CBD5E1]\" data-kid=\"2-1-2-2\" data-name=\"breadcrumb separator\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-2-3\" data-name=\"current breadcrumb\">\n                Catálogo\n            </span>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[520px] px-4 pb-32 pt-6\" data-kid=\"2-2\" data-name=\"mobile catalog body\">\n        <section class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"mobile catalog title section\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-1-1\" data-name=\"title and add action row\">\n                <div class=\"min-w-0\" data-kid=\"2-2-1-1-1\" data-name=\"title text group\">\n                    <h1 class=\"font-heading text-[27px] font-extrabold leading-[1.08] tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-1-1-1\" data-name=\"page headline\">\n                        Catálogo de servicios\n                    </h1>\n                    <p class=\"mt-2 max-w-[270px] text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-1-1-2\" data-name=\"page description\">\n                        Define qué ofreces y cómo se presenta al cliente.\n                    </p>\n                </div>\n                <button aria-label=\"Añadir servicio\" class=\"grid size-11 shrink-0 place-items-center bg-[#1E88E5] text-[19px] font-bold text-white\" data-kid=\"2-2-1-1-2\" data-name=\"add service icon button\">\n                    <i class=\"ti ti-plus\" data-kid=\"2-2-1-1-2-1\" data-name=\"plus icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <button class=\"mt-3 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#47256F] px-4 py-3 text-[13px] font-bold text-white shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.1)] active:scale-[0.97]\" data-kid=\"2-2-1-2\" data-name=\"add service full label button\">\n                <i class=\"ti ti-plus\" data-kid=\"2-2-1-2-1\" data-name=\"plus action icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Añadir servicio\n            </button>\n        </section>\n        <section aria-label=\"Filtros del catálogo\" class=\"mb-7 border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-2\" data-name=\"mobile catalog filters\">\n            <div class=\"flex min-h-[52px] items-center gap-3 px-4\" data-kid=\"2-2-2-1\" data-name=\"mobile search row\">\n                <i class=\"ti ti-search shrink-0 text-[17px] text-[#64748B]\" data-kid=\"2-2-2-1-1\" data-name=\"search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"min-w-0 flex-1 truncate text-[13px] text-[#94A3B8]\" data-kid=\"2-2-2-1-2\" data-name=\"search placeholder\">\n                    Buscar servicio\n                </span>\n                <span class=\"shrink-0 text-[11px] font-medium text-[#64748B]\" data-kid=\"2-2-2-1-3\" data-name=\"service count\">\n                    4 servicios\n                </span>\n            </div>\n            <div class=\"flex items-center justify-between border-t border-[#E2E8F0] px-4 py-2.5\" data-kid=\"2-2-2-2\" data-name=\"mobile filter row\">\n                <span class=\"text-[11px] font-semibold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-2-2-1\" data-name=\"filter label\">\n                    Filtrar por estado\n                </span>\n                <button class=\"flex min-h-[44px] items-center gap-2 rounded-full border border-[#CBD5E1] bg-[#EEEDF0] px-3 text-[12px] font-semibold text-[#334155] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:border-[#522C81] active:scale-[0.97]\" data-kid=\"2-2-2-2-2\" data-name=\"filter dropdown button\">\n                    <i class=\"ti ti-adjustments-horizontal text-[15px] text-[#1E88E5]\" data-kid=\"2-2-2-2-2-1\" data-name=\"adjustments icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Activos\n                    <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-2-2-2-2-2\" data-name=\"chevron icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <section aria-labelledby=\"catalog-table-heading\" data-kid=\"2-2-3\" data-name=\"mobile service catalog section\">\n            <div class=\"mb-4 flex items-end justify-between gap-3\" data-kid=\"2-2-3-1\" data-name=\"mobile catalog section heading\">\n                <div class=\"min-w-0\" data-kid=\"2-2-3-1-1\" data-name=\"mobile catalog heading text\">\n                    <h2 class=\"font-heading text-[20px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-2-3-1-1-1\" data-name=\"catalog table heading\" id=\"catalog-table-heading\">\n                        Servicios del taller\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-3-1-1-2\" data-name=\"catalog table description\">\n                        Estos ítems aparecen como opciones rápidas al facturar.\n                    </p>\n                </div>\n                <span class=\"shrink-0 text-right text-[11px] font-semibold leading-4 text-[#10B981