    },
    "var_f6a460adcf06": {
      "type": "variant",
      "label": "AutoDoc Admin Dashboard — Hadrian Light Mobile",
      "parentId": "var_68415a55df2c",
      "themeId": null,
      "rect": {
        "x": 18075,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component tokens light\">\n    button { min-height:44px; min-width:44px; border-radius:999px !important; transition:transform 150ms cubic-bezier(.23,1,.32,1),box-shadow 150ms cubic-bezier(.23,1,.32,1),background-color 150ms cubic-bezier(.23,1,.32,1),color 150ms cubic-bezier(.23,1,.32,1); }\n  button:active { transform:scale(.97); }\n  button:hover { box-shadow:0 6px 14px rgba(15,23,42,.10); }\n  button[data-name*=\"primary button\"] { background:linear-gradient(135deg,#522C81,#47266F) !important; color:#FFFFFF !important; border:0 !important; box-shadow:0 2px 4px rgba(0,0,0,.05); }\n  button[data-name*=\"refresh\"], button[data-name*=\"export\"], button[data-name*=\"filter\"], button[data-name*=\"page\"] { background:#EEEDF0 !important; border:1px solid rgba(203,213,225,.40) !important; color:#0F172A !important; box-shadow:0 2px 4px rgba(0,0,0,.05); }\n  button[aria-label*=\"Notificaciones\"], button[aria-label*=\"Cambiar tema\"], button[aria-label*=\"Cambiar a modo\"], button[aria-label*=\"Actualizar\"], button[aria-label*=\"Perfil\"] { background:#EEEDF0 !important; border:1px solid rgba(203,213,225,.40) !important; }\n  section[data-name*=\"metrics\"], section[data-name*=\"panel\"], section[data-name*=\"log\"], section[data-name*=\"table\"] { background:#EEEDF0; border-color:rgba(203,213,225,.40) !important; border-radius:16px; box-shadow:0 2px 4px rgba(0,0,0,.05); overflow:hidden; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"admin mobile light application shell\">\n    <header class=\"sticky top-0 z-40 flex min-h-[68px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"compact admin mobile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"admin brand and screen context\">\n            <div aria-label=\"AutoDoc administración\" class=\"grid size-11 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc mobile logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2-1\">\n                    Administración\n                </p>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-2-2\">\n                    <span class=\"truncate font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-1-1-2-2-1\">\n                        Resumen\n                    </span>\n                    <span class=\"size-1.5 shrink-0 rounded-full bg-[#10B981]\" data-kid=\"2-1-1-2-2-2\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile admin header actions\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid min-h-12 min-w-12 place-items-center rounded-lg text-[20px] text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"admin notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\">\n                </span>\n            </button>\n            <button aria-label=\"Perfil de Superadmin\" class=\"grid min-h-12 min-w-12 place-items-center\" data-kid=\"2-1-2-2\" data-name=\"admin profile button\">\n                <span class=\"grid size-10 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-2-1\">\n                    SA\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[480px] px-4 pb-[calc(6.5rem+env(safe-area-inset-bottom))] pt-6\" data-kid=\"2-2\" data-name=\"admin mobile main content\" id=\"resumen\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"admin mobile page heading\">\n            <div class=\"mb-3 flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"admin mobile breadcrumb\">\n                <span data-kid=\"2-2-1-1-1\">\n                    Admin\n                </span>\n                <i class=\"ti ti-chevron-right text-[14px] text-[#94A3B8]\" data-kid=\"2-2-1-1-2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-1-3\">\n                    Resumen\n                </span>\n            </div>\n            <div class=\"flex items-end justify-between gap-3\" data-kid=\"2-2-1-2\">\n                <div class=\"min-w-0\" data-kid=\"2-2-1-2-1\">\n                    <h1 class=\"font-heading text-[26px] font-extrabold leading-tight tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2-1-1\">\n                        Resumen operativo\n                    </h1>\n                    <p class=\"mt-2 text-[14px] leading-5 text-[#475569]\" data-kid=\"2-2-1-2-1-2\">\n                        Salud de la plataforma y actividad reciente.\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-4 flex items-center justify-between gap-3 border-y border-[#E2E8F0] py-3\" data-kid=\"2-2-1-3\">\n                <div class=\"min-w-0\" data-kid=\"2-2-1-3-1\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-1-3-1-1\">\n                        Última sincronización\n                    </p>\n                    <p class=\"mt-1 truncate text-[12px] font-semibold text-[#0F172A]\" data-dynamic=\"true\" data-kid=\"2-2-1-3-1-2\" data-name=\"last sync status text\" data-reason=\"text replaced periodically by synchronization script\">\n                        Hace 4 min · estable\n                    </p>\n                </div>\n                <button aria-label=\"Actualizar datos\" class=\"inline-flex min-h-12 shrink-0 items-center gap-2 border border-[#CBD5E1] bg-white px-3 text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-1-3-2\">\n                    <i class=\"ti ti-refresh text-[16px] text-[#1E88E5]\" data-kid=\"2-2-1-3-2-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-2-1-3-2-2\">\n                        Actualizar\n                    </span>\n                </button>\n            </div>\n        </div>\n        <section class=\"grid grid-cols-2 border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-2\" data-name=\"admin mobile metrics band\">\n            <div class=\"min-h-[122px] border-b border-r border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-1\">\n                <p class=\"text-[12px] font-medium text-[#64748B]\" data-kid=\"2-2-2-1-1\">\n                    Usuarios\n                </p>\n                <div class=\"mt-2 flex flex-wrap items-end gap-2\" data-kid=\"2-2-2-1-2\">\n                    <strong class=\"font-heading text-[24px] font-bold tabular-nums text-[#0F172A]\" data-dynamic=\"true\" data-kid=\"2-2-2-1-2-1\" data-name=\"total users count\" data-reason=\"number replaced by fetched user data\">\n                        1,284\n                    </strong>\n                    <span class=\"mb-1 text-[12px] font-semibold text-[#10B981]\" data-dynamic=\"true\" data-kid=\"2-2-2-1-2-2\" data-name=\"users growth percentage\" data-reason=\"value replaced by fetched growth data\">\n                        +8.4%\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-3\">\n                    vs. mes anterior\n                </p>\n            </div>\n            <div class=\"min-h-[122px] border-b border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-2\">\n                <p class=\"text-[12px] font-medium text-[#64748B]\" data-kid=\"2-2-2-2-1\">\n                    Talleres\n                </p>\n                <div class=\"mt-2 flex flex-wrap items-end gap-2\" data-kid=\"2-2-2-2-2\">\n                    <strong class=\"font-heading text-[24px] font-bold tabular-nums text-[#0F172A]\" data-dynamic=\"true\" data-kid=\"2-2-2-2-2-1\" data-name=\"total workshops count\" data-reason=\"number replaced by fetched workshop data\">\n                        86\n                    </strong>\n                    <span class=\"mb-1 text-[12px] font-semibold text-[#10B981]\" data-dynamic=\"true\" data-kid=\"2-2-2-2-2-2\" data-name=\"workshops growth number\" data-reason=\"value replaced by fetched growth data\">\n                        +3\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-2-3\">\n                    aprobados este mes\n                </p>\n            </div>\n            <div class=\"min-h-[122px] border-r border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-3\">\n                <p class=\"text-[12px] font-medium text-[#64748B]\" data-kid=\"2-2-2-3-1\">\n                    Servicios este mes\n                </p>\n                <div class=\"mt-2 flex flex-wrap items-end gap-2\" data-kid=\"2-2-2-3-2\">\n                    <strong class=\"font-heading text-[24px] font-bold tabular-nums text-[#0F172A]\" data-dynamic=\"true\" data-kid=\"2-2-2-3-2-1\" data-name=\"total services count\" data-reason=\"number replaced by fetched service data\">\n                        642\n                    </strong>\n                    <span class=\"mb-1 text-[12px] font-semibold text-[#1E88E5]\" data-dynamic=\"true\" data-kid=\"2-2-2-3-2-2\" data-name=\"services growth percentage\" data-reason=\"value replaced by fetched growth data\">\n                        +5.1%\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-3-3\">\n                    últimos 30 días\n                </p>\n            </div>\n            <div class=\"min-h-[122px] px-4 py-4\" data-kid=\"2-2-2-4\">\n                <p class=\"text-[12px] font-medium text-[#64748B]\" data-kid=\"2-2-2-4-1\">\n                    Alertas abiertas\n                </p>\n                <div class=\"mt-2 flex flex-wrap items-end gap-2\" data-kid=\"2-2-2-4-2\">\n                    <strong class=\"font-heading text-[24px] font-bold tabular-nums text-[#991B1B]\" data-dynamic=\"true\" data-kid=\"2-2-2-4-2-1\" data-name=\"open alerts count\" data-reason=\"number replaced by fetched alerts data\">\n                        12\n                    </strong>\n                    <span class=\"mb-1 flex items-center gap-1 text-[11px] font-semibold text-[#EF4444]\" data-kid=\"2-2-2-4-2-2\">\n                        <i class=\"ti ti-alert-triangle\" data-kid=\"2-2-2-4-2-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        requieren acción\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-4-3\">\n                    revisión prioritaria\n                </p>\n            </div>\n        </section>\n        <section class=\"mt-6 border-y border-[#CBD5E1] bg-white px-4 py-5\" data-kid=\"2-2-3\" data-name=\"platform trend mobile panel\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-1\">\n                <div class=\"min-w-0\" data-kid=\"2-2-3-1-1\">\n                    <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em] text-[#0F172A]\" data-kid=\"2-2-3-1-1-1\">\n                        Usuarios y talleres\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-3-1-1-2\">\n                        Crecimiento acumulado · últimos seis meses\n                    </p>\n                </div>\n                <div class=\"flex shrink-0 flex-col items-end gap-1 text-[10px] text-[#64748B]\" data-kid=\"2-2-3-1-2\">\n                    <span class=\"flex items-center gap-1.5\" data-kid=\"2-2-3-1-2-1\">\n                        <span class=\"size-2 rounded-full bg-[#1E88E5]\" data-kid=\"2-2-3-1-2-1-1\">\n                        </span>\n                        Usuarios\n                    </span>\n                    <span class=\"flex items-center gap-1.5\" data-kid=\"2-2-3-1-2-2\">\n                        <span class=\"size-2 rounded-full bg-[#F59E0B]\" data-kid=\"2-2-3-1-2-2-1\">\n                        </span>\n                        Talleres\n                    </span>\n                </div>\n            </div>\n            <div class=\"relative mt-5 h-[210px] w-full\" data-kid=\"2-2-3-2\" data-name=\"responsive growth trend chart\">\n                <svg aria-hidden=\"true\" class=\"absolute inset-0 h-full w-full\" data-kid=\"2-2-3-2-2\" data-name=\"growth trend chart background SVG\" preserveaspectratio=\"none\" viewbox=\"0 0 300 180\">\n                    <line stroke=\"#E2E8F0\" stroke-width=\"1\" x1=\"12\" x2=\"292\" y1=\"34\" y2=\"34\">\n                    </line>\n                    <line stroke=\"#E2E8F0\" stroke-width=\"1\" x1=\"12\" x2=\"292\" y1=\"76\" y2=\"76\">\n                    </line>\n                    <line stroke=\"#E2E8F0\" stroke-width=\"1\" x1=\"12\" x2=\"292\" y1=\"118\" y2=\"118\">\n                    </line>\n                    <line stroke=\"#E2E8F0\" stroke-width=\"1\" x1=\"12\" x2=\"292\" y1=\"160\" y2=\"160\">\n                    </line>\n                    <path d=\"M12 145 L68 130 L124 112 L180 98 L236 80 L292 64 L292 160 L12 160 Z\" fill=\"rgba(30,136,229,0.08)\">\n                    </path>\n                    <path d=\"M12 145 L68 130 L124 112 L180 98 L236 80 L292 64\" fill=\"none\" stroke=\"#1E88E5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\">\n                    </path>\n                    <path d=\"M12 164 L68 162 L124 161 L180 159 L236 157 L292 155\" fill=\"none\" stroke=\"#F59E0B\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\">\n                    </path>\n                    <g fill=\"#1E88E5\">\n                        <circle cx=\"12\" cy=\"145\" r=\"3\">\n                        </circle>\n                        <circle cx=\"68\" cy=\"130\" r=\"3\">\n                        </circle>\n                        <circle cx=\"124\" cy=\"112\" r=\"3\">\n                        </circle>\n                        <circle cx=\"180\" cy=\"98\" r=\"3\">\n                        </circle>\n                        <circle cx=\"236\" cy=\"80\" r=\"3\">\n                        </circle>\n                        <circle cx=\"292\" cy=\"64\" r=\"3\">\n                        </circle>\n                    </g>\n                    <g fill=\"#F59E0B\">\n                        <circle cx=\"12\" cy=\"164\" r=\"3\">\n                        </circle>\n                        <circle cx=\"68\" cy=\"162\" r=\"3\">\n                        </circle>\n                        <circle cx=\"124\" cy=\"161\" r=\"3\">\n                        </circle>\n                        <circle cx=\"180\" cy=\"159\" r=\"3\">\n                        </circle>\n                        <circle cx=\"236\" cy=\"157\" r=\"3\">\n                        </circle>\n                        <circle cx=\"292\" cy=\"155\" r=\"3\">\n                        </circle>\n                    </g>\n                    <g fill=\"#64748B\" font-family=\"IBM Plex Sans\" font-size=\"9\" text-anchor=\"middle\">\n                        <text x=\"12\" y=\"176\">\n                            Mar\n                        </text>\n                        <text x=\"68\" y=\"176\">\n                            Abr\n                        </text>\n                        <text x=\"124\" y=\"176\">\n                            May\n                        </text>\n                        <text x=\"180\" y=\"176\">\n                            Jun\n                        </text>\n                        <text x=\"236\" y=\"176\">\n                            Jul\n                        </text>\n                        <text x=\"292\" y=\"176\">\n                            Ago\n                        </text>\n                    </g>\n                </svg>\n                <canvas aria-label=\"Gráfico de crecimiento de usuarios y talleres\" class=\"relative z-10\" data-dynamic=\"true\" data-kid=\"2-2-3-2-1\" data-name=\"responsive growth trend chart canvas\" data-reason=\"chart rendered and updated by Chart.js script\" id=\"adminTrendMobile\">\n                </canvas>\n            </div>\n        </section>\n        <section class=\"mt-6 border-y border-[#CBD5E1] bg-white px-4 py-5\" data-kid=\"2-2-4\" data-name=\"recent activity mobile panel\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-1\">\n                <div class=\"min-w-0\" data-kid=\"2-2-4-1-1\">\n                    <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em] text-[#0F172A]\" data-kid=\"2-2-4-1-1-1\">\n                        Actividad reciente\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-4-1-1-2\">\n                        Eventos que requieren contexto\n                    </p>\n                </div>\n                <i class=\"ti ti-activity shrink-0 text-[18px] text-[#1E88E5]\" data-kid=\"2-2-4-1-2\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <div class=\"mt-3 divide-y divide-[#E2E8F0]\" data-kid=\"2-2-4-2\">\n                <div class=\"flex gap-3 py-3\" data-kid=\"2-2-4-2-1\">\n                    <i class=\"ti ti-circle-check mt-0.5 shrink-0 text-[18px] text-[#10B981]\" data-kid=\"2-2-4-2-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <div class=\"min-w-0\" data-kid=\"2-2-4-2-1-2\">\n                        <p class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-1-2-1\">\n                            Nuevo taller aprobado\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-1-2-2\">\n                            Taller Rápido · hace 8 min\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex gap-3 py-3\" data-kid=\"2-2-4-2-2\">\n                    <i class=\"ti ti-flag-3 mt-0.5 shrink-0 text-[18px] text-[#F59E0B]\" data-kid=\"2-2-4-2-2-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <div class=\"min-w-0\" data-kid=\"2-2-4-2-2-2\">\n                        <p class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-2-2-1\">\n                            Reseña reportada\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-2-2-2\">\n                            MotorLab · hace 21 min\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex gap-3 py-3\" data-kid=\"2-2-4-2-3\">\n                    <i class=\"ti ti-user-off mt-0.5 shrink-0 text-[18px] text-[#EF4444]\" data-kid=\"2-2-4-2-3-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <div class=\"min-w-0\" data-kid=\"2-2-4-2-3-2\">\n                        <p class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-3-2-1\">\n                            Usuario bloqueado\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-3-2-2\">\n                            Cuenta sospechosa · hace 44 min\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <button class=\"mt-2 inline-flex min-h-12 items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-4-3\">\n                Ver actividad completa\n                <i class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"2-2-4-3-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </section>\n        <section class=\"mt-6 border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-5\" data-name=\"admin audit logs mobile list\" id=\"logs\">\n            <div class=\"flex items-start justify-between gap-3 border-b border-[#E2E8F0] px-4 py-5\" data-kid=\"2-2-5-1\">\n                <div class=\"min-w-0\" data-kid=\"2-2-5-1-1\">\n                    <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em] text-[#0F172A]\" data-kid=\"2-2-5-1-1-1\">\n                        Últimos logs\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-5-1-1-2\">\n                        Traza de actividad administrativa reciente\n                    </p>\n                </div>\n                <a class=\"inline-flex min-h-12 shrink-0 items-center gap-1 text-[11px] font-bold text-[#1E88E5]\" data-kid=\"2-2-5-1-2\" href=\"#logs\">\n                    Ver todos\n                    <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"2-2-5-1-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </a>\n            </div>\n            <div class=\"divide-y divide-[#E2E8F0]\" data-kid=\"2-2-5-2\">\n                <article class=\"px-4 py-4\" data-kid=\"2-2-5-2-1\">\n                    <div class=\"mb-2 flex items-center justify-between gap-3\" data-kid=\"2-2-5-2-1-1\">\n                        <span class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-5-2-1-1-1\" data-name=\"log timestamp text\" data-reason=\"text updated to current relative time by script\">\n                            Hora · 08:42\n                        </span>\n                        <span class=\"flex items-center gap-1.5 text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-2-5-2-1-1-2\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"2-2-5-2-1-1-2-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Completado\n                        </span>\n                    </div>\n                    <p class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-1-2\">\n                        Superadmin\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#475569]\" data-kid=\"2-2-5-2-1-3\">\n                        Aprobó el registro de Taller Rápido\n                    </p>\n                </article>\n                <article class=\"px-4 py-4\" data-kid=\"2-2-5-2-2\">\n                    <div class=\"mb-2 flex items-center justify-between gap-3\" data-kid=\"2-2-5-2-2-1\">\n                        <span class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-5-2-2-1-1\" data-name=\"log timestamp text\" data-reason=\"text updated to current relative time by script\">\n                            Hora · 08:21\n                        </span>\n                        <span class=\"flex items-center gap-1.5 text-[12px] font-semibold text-[#F59E0B]\" data-kid=\"2-2-5-2-2-1-2\">\n                            <i class=\"ti ti-clock\" data-kid=\"2-2-5-2-2-1-2-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Pendiente\n                        </span>\n                    </div>\n                    <p class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-2-2\">\n                        Moderación\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#475569]\" data-kid=\"2-2-5-2-2-3\">\n                        Marcó una reseña para revisión\n                    </p>\n                </article>\n                <article class=\"px-4 py-4\" data-kid=\"2-2-5-2-3\">\n                    <div class=\"mb-2 flex items-center justify-between gap-3\" data-kid=\"2-2-5-2-3-1\">\n                        <span class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-5-2-3-1-1\" data-name=\"log timestamp text\" data-reason=\"text updated to current relative time by script\">\n                            Hora · 07:58\n                        </span>\n                        <span class=\"flex items-center gap-1.5 text-[12px] font-semibold text-[#EF4444]\" data-kid=\"2-2-5-2-3-1-2\">\n                            <i class=\"ti ti-alert-circle\" data-kid=\"2-2-5-2-3-1-2-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Revisar\n                        </span>\n                    </div>\n                    <p class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-3-2\">\n                        Seguridad\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#475569]\" data-kid=\"2-2-5-2-3-3\">\n                        Bloqueó una cuenta por actividad sospechosa\n                    </p>\n                </article>\n            </div>\n        </section>\n        <p class=\"mt-6 pb-2 text-[11px] leading-5 text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-2-6\" data-name=\"admin console footer sync text\" data-reason=\"text updated periodically by synchronization script\">\n            AutoDoc · Consola de administración · Datos sincronizados hace 4 min\n        </p>\n    </main>\n    <nav aria-label=\"Navegación de administración\" class=\"fixed inset-x-0 bottom-0 z-50 border-t border-[#CBD5E1] bg-white/95 px-2 pb-[env(safe-area-inset-bottom)] backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"fixed admin mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[480px] grid-cols-4 gap-1 py-2\" data-kid=\"2-3-1\">\n            <a class=\"flex min-h-12 flex-col items-center justify-center gap-1 border-t-2 border-[#1E88E5] text-[10px] font-bold text-[#1E88E5]\" data-kid=\"2-3-1-1\" href=\"#resumen\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"2-3-1-1-2\">\n                    Resumen\n                </span>\n            </a>\n            <a class=\"flex min-h-12 flex-col items-center justify-center gap-1 border-t-2 border-transparent text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-3-1-2\" href=\"#usuarios\">\n                <i class=\"ti ti-users text-[19px]\" data-kid=\"2-3-1-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"2-3-1-2-2\">\n                    Usuarios\n                </span>\n            </a>\n            <a class=\"flex min-h-12 flex-col items-center justify-center gap-1 border-t-2 border-transparent text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-3-1-3\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"2-3-1-3-2\">\n                    Talleres\n                </span>\n            </a>\n            <a class=\"flex min-h-12 flex-col items-center justify-center gap-1 border-t-2 border-transparent text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-3-1-4\" href=\"#logs\">\n                <i class=\"ti ti-list-details text-[19px]\" data-kid=\"2-3-1-4-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"2-3-1-4-2\">\n                    Logs\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js\">\n</script>\n<script>\n    const trendCanvas = document.getElementById('adminTrendMobile');\n  if (trendCanvas && window.Chart) {\n    new Chart(trendCanvas, {\n      type: 'line',\n      data: {\n        labels: ['Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago'],\n        datasets: [\n          { label: 'Usuarios', data: [920, 1008, 1088, 1160, 1220, 1284], borderColor: '#1E88E5', backgroundColor: 'rgba(30,136,229,0.08)', fill: true, tension: 0.32, pointRadius: 3, pointBackgroundColor: '#1E88E5', borderWidth: 2 },\n          { label: 'Talleres', data: [62, 68, 71, 77, 83, 86], borderColor: '#F59E0B', backgroundColor: 'transparent', fill: false, tension: 0.32, pointRadius: 3, pointBackgroundColor: '#F59E0B', borderWidth: 2 }\n        ]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: { legend: { display: false }, tooltip: { enabled: true } },\n        scales: {\n          x: { grid: { display: false }, ticks: { color: '#64748B', font: { family: 'IBM Plex Sans', size: 10 } } },\n          y: { grid: { color: '#E2E8F0' }, ticks: { color: '#64748B', font: { family: 'IBM Plex Sans', size: 9 }, maxTicksLimit: 5 }, border: { display: false } }\n        }\n      }\n    });\n  }\n</script>\n",
