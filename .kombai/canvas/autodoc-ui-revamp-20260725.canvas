      "html": "<link data-kid=\"1\" data-name=\"google fonts stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component treatment\">\n    :root { --app-primary: #522C81; --app-surface-container: #EEEDF0; --app-outline: #CBD5E1; --app-on-primary: #FFFFFF; --app-shadow-sm: 0 2px 4px rgba(15,23,42,0.05); --app-shadow-hover: 0 6px 14px rgba(15,23,42,0.10); }\n  button { min-height: 48px; border-radius: 999px !important; transition: transform 150ms cubic-bezier(0.23,1,0.32,1), box-shadow 150ms cubic-bezier(0.23,1,0.32,1), background-color 150ms cubic-bezier(0.23,1,0.32,1), border-color 150ms cubic-bezier(0.23,1,0.32,1), color 150ms cubic-bezier(0.23,1,0.32,1); }\n  button:active { transform: scale(0.97); }\n  button:focus-visible { outline: 3px solid rgba(82,44,129,0.35); outline-offset: 2px; }\n  button[class*=\"bg-[#1E88E5]\"], button[class*=\"bg-[#38BDF8]\"] { background: var(--app-primary) !important; color: var(--app-on-primary) !important; box-shadow: var(--app-shadow-sm); }\n  button[class*=\"border-[#1E88E5]\"], button[class*=\"border-[#38BDF8]\"] { border-color: var(--app-primary) !important; color: var(--app-primary) !important; }\n  button[class*=\"bg-\"]:hover, button[class*=\"border-\"]:hover { box-shadow: var(--app-shadow-hover); }\n  button[aria-label] { min-width: 48px; min-height: 48px; padding: 0.75rem; border: 1px solid var(--app-outline) !important; background: var(--app-surface-container) !important; box-shadow: var(--app-shadow-sm); }\n  main section { border: 1px solid rgba(203,213,225,0.70); border-radius: 16px; background: var(--app-surface-container); box-shadow: var(--app-shadow-sm); overflow: hidden; }\n</style>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mechanic service history page\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"mechanic icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"brand mark\">\n                AD\n            </div>\n            <div class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary rail navigation\">\n                <button aria-label=\"Panel del taller\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard rail button\">\n                    <i class=\"ti ti-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Reparaciones\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"repairs rail button\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-2-1\" data-name=\"repairs icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Buscar vehículo\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"search rail button\">\n                    <i class=\"ti ti-search\" data-kid=\"2-1-1-2-3-1\" data-name=\"search icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Historial de servicios\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-4\" data-name=\"history rail button\">\n                    <i class=\"ti ti-history\" data-kid=\"2-1-1-2-4-1\" data-name=\"history icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Conversaciones\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-5\" data-name=\"chat rail button\">\n                    <i class=\"ti ti-message-2\" data-kid=\"2-1-1-2-5-1\" data-name=\"chat icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"utility rail navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help rail button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings rail button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings icon\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"mechanic contextual sidebar\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"workshop identity block\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"role label\">\n                    Taller\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"workshop status row\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"active status dot\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"workshop name\">\n                        Taller Rápido\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-2-1-3\" data-name=\"workshop status text\">\n                    Operación activa\n                </p>\n            </div>\n            <nav aria-label=\"Navegación del taller\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"workshop navigation\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-1\" data-name=\"dashboard link\" href=\"#panel\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-1-1\" data-name=\"dashboard link icon container\">\n                        <i class=\"ti ti-dashboard\" data-kid=\"2-1-2-2-1-1-1\" data-name=\"dashboard link icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-1-2-2-1-2\" data-name=\"dashboard link text\">\n                        Panel\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-2\" data-name=\"repairs link\" href=\"#reparaciones\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-2-1\" data-name=\"repairs link icon container\">\n                        <i class=\"ti ti-tool\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"repairs link icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-1-2-2-2-2\" data-name=\"repairs link text\">\n                        Reparaciones\n                    </span>\n                    <span class=\"ml-auto text-[11px] font-bold text-[#1E88E5]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-2-3\" data-name=\"repairs count badge\" data-reason=\"count updated by backend data\">\n                        04\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-3\" data-name=\"vehicle search link\" href=\"#buscar\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-3-1\" data-name=\"vehicle search link icon container\">\n                        <i class=\"ti ti-search\" data-kid=\"2-1-2-2-3-1-1\" data-name=\"vehicle search link icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-1-2-2-3-2\" data-name=\"vehicle search link text\">\n                        Buscar vehículo\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-2.5 text-[14px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-2-4\" data-name=\"active history link\" href=\"#historial\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-4-1\" data-name=\"active history link icon container\">\n                        <i class=\"ti ti-history\" data-kid=\"2-1-2-2-4-1-1\" data-name=\"active history link icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-1-2-2-4-2\" data-name=\"active history link text\">\n                        Historial\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-5\" data-name=\"reviews link\" href=\"#resenas\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-5-1\" data-name=\"reviews link icon container\">\n                        <i class=\"ti ti-star\" data-kid=\"2-1-2-2-5-1-1\" data-name=\"reviews link icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"2-1-2-2-5-2\" data-name=\"reviews link text\">\n                        Reseñas\n                    </span>\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"workshop secondary navigation\">\n                <p class=\"mb-3 px-3 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-3-1\" data-name=\"management label\">\n                    Gestión\n                </p>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-2-3-2\" data-name=\"catalog link\" href=\"#catalogo\">\n                    <i class=\"ti ti-list-details text-[17px] text-[#1E88E5]\" data-kid=\"2-1-2-3-2-1\" data-name=\"catalog link icon\">\n                    </i>\n                    Catálogo\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-2-3-3\" data-name=\"employees link\" href=\"#empleados\">\n                    <i class=\"ti ti-users text-[17px]\" data-kid=\"2-1-2-3-3-1\" data-name=\"employees link icon\">\n                    </i>\n                    Empleados\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-2-3-4\" data-name=\"settings link\" href=\"#configuracion\">\n                    <i class=\"ti ti-settings text-[17px]\" data-kid=\"2-1-2-3-4-1\" data-name=\"settings link icon\">\n                    </i>\n                    Configuración\n                </a>\n            </div>\n            <div class=\"mt-5 border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-4\" data-name=\"workshop account block\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-4-1\" data-name=\"workshop account row\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-4-1-1\" data-name=\"account initials\">\n                        MR\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-4-1-2\" data-name=\"account text\">\n                        <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-4-1-2-1\" data-name=\"account name\">\n                            María Rodríguez\n                        </p>\n                        <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-2-4-1-2-2\" data-name=\"account role\">\n                            Administradora\n                        </p>\n                    </div>\n                    <span class=\"ml-auto text-[16px] text-[#94A3B8]\" data-kid=\"2-1-2-4-1-3\" data-name=\"account menu icon container\">\n                        <i class=\"ti ti-dots\" data-kid=\"2-1-2-4-1-3-1\" data-name=\"account menu icon\">\n                        </i>\n                    </span>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"2-1-3\" data-name=\"service history content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-white px-8\" data-kid=\"2-1-3-1\" data-name=\"top header\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumb\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-1-3-1-1-1\" data-name=\"breadcrumb parent\">\n                        Taller\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-3-1-1-2\" data-name=\"breadcrumb separator\">\n                        /\n                    </span>\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-1-3\" data-name=\"breadcrumb child\">\n                        Historial\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-1-2\" data-name=\"header actions\">\n                    <span class=\"hidden text-[12px] text-[#64748B] lg:block\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-4\" data-name=\"current date text\" data-reason=\"date updated by local system clock\">\n                        Sábado, 25 jul 2026\n                    </span>\n                    <button aria-label=\"Notificaciones\" class=\"relative grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-1\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-2-1-1\" data-name=\"notifications icon\">\n                        </i>\n                        <span class=\"absolute right-[7px] top-[6px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-3-1-2-1-2\" data-name=\"notifications badge\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-2\" data-name=\"theme toggle button\">\n                        <i class=\"ti ti-moon\" data-kid=\"2-1-3-1-2-2-1\" d