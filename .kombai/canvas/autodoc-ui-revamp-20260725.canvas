      "themeId": null,
      "rect": {
        "x": 118245,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"admin reviews dark mobile page\" style=\"--surface:#0F172A;--surface-container:#141E36;--surface-variant:#1E293B;--outline:#334155;--outline-strong:#475569;--primary:#81E6D9;--secondary:#38BDF8;--on-primary:#0F172A;--text-primary:#F8FAFC;--text-secondary:#94A3B8;--success:#34D399;--warning:#FBBF24;--error:#F87171;--error-surface:#3F1D25;--warning-surface:#422006;--success-surface:#064E3B\">\n    <header class=\"sticky top-0 z-30 flex min-h-[68px] items-center justify-between border-b border-[var(--outline)] bg-[#020617]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"admin mobile header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"admin identity and page context\">\n            <div aria-label=\"AutoDoc administración\" class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[var(--primary)] text-[17px] font-heading font-extrabold tracking-[-0.08em] text-[var(--on-primary)] shadow-[0_8px_24px_rgba(129,230,217,0.14)]\" data-kid=\"1-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"page identifier container\">\n                <p class=\"truncate text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--text-secondary)]\" data-kid=\"1-1-1-2-1\" data-name=\"context label\">\n                    Administración\n                </p>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"1-1-1-2-2\" data-name=\"status indicator container\">\n                    <span class=\"truncate font-heading text-[15px] font-bold tracking-[-0.03em] text-[var(--text-primary)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"current page title\">\n                        Moderar reseñas\n                    </span>\n                    <span class=\"size-1.5 shrink-0 rounded-full bg-[var(--success)]\" data-kid=\"1-1-1-2-2-2\" data-name=\"live status indicator\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-1-2\" data-name=\"header actions\">\n            <button aria-label=\"Cambiar tema\" class=\"flex min-h-11 min-w-11 items-center justify-center rounded-full border border-[var(--outline-strong)] bg-[var(--surface-container)] text-[var(--text-secondary)] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-1-2-1\" data-name=\"theme toggle button\">\n                <i class=\"ti ti-sun-moon text-[18px]\" data-kid=\"1-1-2-1-1\" data-name=\"sun moon icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative flex min-h-11 min-w-11 items-center justify-center rounded-full border border-[var(--outline-strong)] bg-[var(--surface-container)] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-1-2-2\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[18px]\" data-kid=\"1-1-2-2-1\" data-name=\"bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[var(--error)]\" data-kid=\"1-1-2-2-2\" data-name=\"notification unread dot\">\n                </span>\n            </button>\n            <button aria-label=\"Abrir menú de Superadmin\" class=\"flex min-h-11 min-w-11 items-center justify-center rounded-full bg-[var(--secondary)] text-[12px] font-bold text-[#082F49]\" data-kid=\"1-1-2-3\" data-name=\"superadmin profile button\">\n                SA\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[480px] px-4 pb-[calc(104px+env(safe-area-inset-bottom))] pt-6\" data-kid=\"1-2\" data-name=\"reviews mobile content\">\n        <div class=\"mb-5\" data-kid=\"1-2-1\" data-name=\"reviews page heading\">\n            <div class=\"mb-3 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation\">\n                <span data-kid=\"1-2-1-1-1\" data-name=\"admin link\">\n                    Admin\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"1-2-1-1-3\" data-name=\"current page breadcrumb\">\n                    Reseñas\n                </span>\n            </div>\n            <h1 class=\"font-heading text-[27px] font-extrabold leading-tight tracking-[-0.045em] text-[var(--text-primary)]\" data-kid=\"1-2-1-2\" data-name=\"page headline\">\n                Moderar reseñas\n            </h1>\n            <p class=\"mt-2 max-w-[320px] text-[14px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-2-1-3\" data-name=\"page description\">\n                Revisa comentarios reportados y protege la calidad de la comunidad.\n            </p>\n        </div>\n        <section class=\"mb-5 rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-4 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-2-2\" data-name=\"report filter control\">\n            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-2-2-1\" data-name=\"filter toggle container\">\n                <div class=\"min-w-0\" data-kid=\"1-2-2-1-1\" data-name=\"filter label group\">\n                    <p class=\"text-[13px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"filter title\">\n                        Mostrar solo reportadas\n                    </p>\n                    <p class=\"mt-1 text-[11px] text-[var(--text-secondary)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2\" data-name=\"pending count text\" data-reason=\"count updated by script\">\n                        3 pendientes de revisión\n                    </p>\n                </div>\n                <div aria-label=\"Mostrar solo reportadas desactivado\" class=\"relative flex h-8 w-14 shrink-0 items-center rounded-full border border-[var(--outline-strong)] bg-[var(--surface-variant)] px-1\" data-kid=\"1-2-2-1-2\" data-name=\"report-only switch\">\n                    <span class=\"size-6 rounded-full bg-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.22)]\" data-kid=\"1-2-2-1-2-1\" data-name=\"switch toggle handle\">\n                    </span>\n                </div>\n            </div>\n        </section>\n        <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"1-2-3\" data-name=\"reviews list header\">\n            <div class=\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.17em] text-[#64748B]\" data-kid=\"1-2-3-1\" data-name=\"list activity label\">\n                <span class=\"size-1.5 rounded-full bg-[var(--primary)]\" data-kid=\"1-2-3-1-1\" data-name=\"activity indicator dot\">\n                </span>\n                Actividad de moderación\n            </div>\n            <span class=\"rounded-full border border-[var(--outline)] bg-[var(--surface-variant)] px-3 py-1.5 text-[11px] font-semibold text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"1-2-3-2\" data-name=\"total review count badge\" data-reason=\"count updated by script\">\n                4 reseñas\n            </span>\n        </div>\n        <section class=\"overflow-hidden rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-2-4\" data-name=\"stacked review list\">\n            <article class=\"border-b border-[var(--outline)] p-4\" data-kid=\"1-2-4-1\" data-name=\"reported review card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-4-1-1\" data-name=\"review header container\">\n                    <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"1-2-4-1-1-1\" data-name=\"review metadata group\">\n                        <div aria-label=\"4 de 5 estrellas\" class=\"flex min-h-9 items-center gap-0.5 text-[18px] text-[var(--warning)]\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"four star rating\">\n                            <i class=\"ti ti-star-filled\" data-kid=\"1-2-4-1-1-1-1-1\" data-name=\"star fill icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"1-2-4-1-1-1-1-2\" data-name=\"star fill icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"1-2-4-1-1-1-1-3\" data-name=\"star fill icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"1-2-4-1-1-1-1-4\" data-name=\"star fill icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star\" data-kid=\"1-2-4-1-1-1-1-5\" data-name=\"star empty icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <span class=\"inline-flex min-h-7 items-center gap-1 rounded-full border border-[var(--error)]/35 bg-[var(--error-surface)] px-2.5 text-[10px] font-bold text-[#FCA5A5]\" data-kid=\"1-2-4-1-1-1-2\" data-name=\"report status tag\">\n                            <i class=\"ti ti-flag text-[12px]\" data-kid=\"1-2-4-1-1-1-2-1\" data-name=\"flag icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Reportada\n                        </span>\n                    </div>\n                    <time class=\"shrink-0 text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-4-1-1-2\" data-name=\"review timestamp\">\n                        15/08/2026\n                    </time>\n                </div>\n                <p class=\"mt-3 text-[13px] leading-5 text-[var(--text-primary)]\" data-kid=\"1-2-4-1-2\" data-name=\"review content body\">\n                    El servicio fue rápido, pero el comentario necesita revisión por contenido inapropiado.\n                </p>\n                <div class=\"mt-3 flex gap-2\" data-kid=\"1-2-4-1-3\" data-name=\"review photo thumbnails\">\n                    <div class=\"flex size-14 items-center justify-center rounded-[10px] border border-[var(--outline-strong)] bg-[#1E293B] text-[18px] text-[var(--primary)]\" data-kid=\"1-2-4-1-3-1\" data-name=\"photo thumbnail\">\n                        <i class=\"ti ti-photo\" data-kid=\"1-2-4-1-3-1-1\" data-name=\"photo icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"flex size-14 items-center justify-center rounded-[10px] border border-dashed border-[var(--outline-strong)] bg-[#0B1220] text-[18px] text-[#64748B]\" data-kid=\"1-2-4-1-3-2\" data-name=\"missing photo thumbnail\">\n                        <i class=\"ti ti-photo-off\" data-kid=\"1-2-4-1-3-2-1\" data-name=\"photo off icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <span class=\"self-center text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-4-1-3-3\" data-name=\"photo meta text\">\n                        2 fotos · una no disponible\n                    </span>\n                </div>\n                <div class=\"mt-4 flex flex-wrap gap-2 text-[11px] text-[#CBD5E1]\" data-kid=\"1-2-4-1-4\" data-name=\"review metadata\">\n                    <span class=\"rounded-full bg-[var(--surface-variant)] px-2.5 py-1.5\" data-kid=\"1-2-4-1-4-1\" data-name=\"store name tag\">\n                        <i class=\"ti ti-building-store mr-1 text-[12px] text-[var(--secondary)]\" data-kid=\"1-2-4-1-4-1-1\" data-name=\"store icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Taller: MotorLab\n                    </span>\n                    <span class=\"rounded-full bg-[var(--surface-variant)] px-2.5 py-1.5\" data-kid=\"1-2-4-1-4-2\" data-name=\"customer name tag\">\n                        <i class=\"ti ti-user mr-1 text-[12px] text-[var(--secondary)]\" data-kid=\"1-2-4-1-4-2-1\" data-name=\"user icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Cliente: Carlos Rivera\n                    </span>\n                </div>\n                <div class=\"mt-4 flex justify-end gap-2\" data-kid=\"1-2-4-1-5\" data-name=\"reported review actions\">\n                    <button aria-label=\"Descartar reporte\" class=\"flex min-h-12 min-w-12 items-center justify-center rounded-full border border-[var(--outline-strong)] bg-[var(--surface-variant)] text-[var(--text-secondary)]\" data-kid=\"1-2-4-1-5-1\" data-name=\"dismiss report button\">\n                        <i class=\"ti ti-flag-off text-[17px]\" data-kid=\"1-2-4-1-5-1-1\" data-name=\"flag off icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Eliminar reseña\" class=\"flex min-h-12 min-w-12 items-center justify-center rounded-full border border-[var(--error)]/50 bg-[var(--error-surface)] text-[#FCA5A5]\" data-kid=\"1-2-4-1-5-2\" data-name=\"delete review button\">\n                        <i class=\"ti ti-trash text-[17px]\" data-kid=\"1-2-4-1-5-2-1\" data-name=\"trash icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </article>\n            <article class=\"border-b border-[var(--outline)] p-4\" data-kid=\"1-2-4-2\" data-name=\"visible review card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-4-2-1\" data-name=\"review header container\">\n                    <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"1-2-4-2-1-1\" data-name=\"review metadata group\">\n                        <div aria-label=\"5 de 5 estrellas\" class=\"flex min-h-9 items-center gap-0.5 text-[18px] text-[var(--warning)]\" data-kid=\"1-2-4-2-1-1-1\" data-name=\"five star rating\">\n                            <i class=\"ti ti-star-filled\" data-kid=\"1-2-4-2-1-1-1-1\" data-name=\"star fill icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"1-2-4-2-1-1-1-2\" data-name=\"star fill icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"1-2-4-2-1-1-1-3\" data-name=\"star fill icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"1-2-4-2-1-1-1-4\" data-name=\"star fill icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"1-2-4-2-1-1-1-5\" data-name=\"star fill icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <span class=\"inline-flex min-h-7 items-center gap-1 rounded-full border border-[var(--success)]/35 bg-[var(--success-surface)] px-2.5 text-[10px] font-bold text-[#6EE7B7]\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"visible status tag\">\n                            <i class=\"ti ti-circle-check text-[12px]\" data-kid=\"1-2-4-2-1-1-2-1\" data-name=\"check circle icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Visible\n                        </span>\n                    </div>\n                    <time class=\"shrink-0 text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-4-2-1-2\" data-name=\"review timestamp\">\n                        12/08/2026\n                    </time>\n                </div>\n                <p class=\"mt-3 text-[13px] leading-5 text-[var(--text-primary)]\" data-kid=\"1-2-4-2-2\" data-name=\"review content body\">\n                    La atención fue excelente y explicaron cada paso del mantenimiento con claridad.\n                </p>\n                <div class=\"mt-4 flex flex-wrap gap-2 text-[11px] text-[#CBD5E1]\" data-kid=\"1-2-4-2-3\" data-name=\"review metadata\">\n                    <span class=\"rounded-full bg-[var(--surface-variant)] px-2.5 py-1.5\" data-kid=\"1-2-4-2-3-1\" data-name=\"store name tag\">\n                        <i class=\"ti ti-building-store mr-1 text-[12px] text-[var(--secondary)]\" data-kid=\"1-2-4-2-3-1-1\" data-name=\"store icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Taller: Taller Rápido\n                    </span>\n                    <span class=\"rounded-full bg-[var(--surface-variant)] px-2.5 py-1.5\" data-kid=\"1-2-4-2-3-2\" data-name=\"customer name tag\">\n                        <i class=\"ti ti-user mr-1 text-[12px] text-[var(--secondary)]\" data-kid=\"1-2-4-2-3-2-1\" data-name=\"user icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Cliente: Ana Martínez\n                    </span>\n                </div>\n                <div class=\"mt-4 flex justify-end\" data-kid=\"1-2-4-2-4\" data-name=\"visible review actions\">\n                    <button aria-label=\"Eliminar reseña\" class=\"flex min-h-12 min-w-12 items-center justify-center rounded-full border border-[var(--outline-strong)] bg-[var(--surface-variant)] text-[var(--text-secondary)]\" data-kid=\"1-2-4-2-4-1\" data-name=\"delete review button\">\n                        <i class=\"ti ti-trash text-[17px]\" data-kid=\"1-2-4-2-4-1-1\" data-name=\"trash icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </article>\n            <div class=\"m-4 rounded-[12px] border border-dashed border-[var(--outline-strong)] px-3 py-3\" data-kid=\"1-2-4-3\" data-name=\"alternate empty state cue\">\n                <div class=\"flex items-start gap-3 text-[var(--text-secondary)]\" data-kid=\"1-2-4-3-1\" data-name=\"empty state container\">\n                    <i class=\"ti ti-inbox text-[18px]\" data-kid=\"1-2-4-3-1-1\" data-name=\"inbox icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <div data-kid=\"1-2-4-3-1-2\" data-name=\"empty state message\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.12em]\" data-kid=\"1-2-4-3-1-2-1\" data-name=\"empty state title\">\n                            Estado alternativo del filtro\n                        </p>\n                        <p class=\"mt-1 text-[11px]\" data-kid=\"1-2-4-3-1-2-2\" data-name=\"empty state body\">\n                            No hay reseñas reportadas · No hay reseñas registradas\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <footer class=\"mt-6 border-t border-[var(--outline)] pt-4 text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-5\" data-name=\"moderation sync footer\">\n            <p class=\"flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"1-2-5-1\" data-name=\"sync status text\" data-reason=\"timestamp updated periodically by script\">\n                <span class=\"size-1.5 rounded-full bg-[var(--success)]\" data-kid=\"1-2-5-1-1\" data-name=\"sync indicator dot\">\n                </span>\n                Datos sincronizados hace 4 min · Moderación protegida\n            </p>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación de administración\" class=\"fixed inset-x-0 bottom-0 z-40 border-t border-[var(--outline)] bg-[#020617]/[.98] px-2 pb-[max(10px,env(safe-area-inset-bottom))] pt-2 backdrop-blur-sm\" data-kid=\"1-3\" data-name=\"admin mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[480px] grid-cols-5 gap-1\" data-kid=\"1-3-1\" data-name=\"bottom nav grid\">\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] text-[var(--text-secondary)]\" data-kid=\"1-3-1-1\" data-name=\"dashboard nav item\" href=\"#resumen\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"1-3-1-1-1\" data-name=\"dashboard icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-1-2\" data-name=\"label\">\n                    Resumen\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] text-[var(--text-secondary)]\" data-kid=\"1-3-1-2\" data-name=\"users nav item\" href=\"#usuarios\">\n                <i class=\"ti ti-users text-[18px]\" data-kid=\"1-3-1-2-1\" data-name=\"users icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-2-2\" data-name=\"label\">\n                    Usuarios\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] text-[var(--text-secondary)]\" data-kid=\"1-3-1-3\" data-name=\"shops nav item\" href=\"#talleres\">\n                <i class=\"ti ti-building-store text-[18px]\" data-kid=\"1-3-1-3-1\" data-name=\"shops icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-3-2\" data-name=\"label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 border-t-2 border-[var(--primary)] bg-[var(--surface-variant)] text-[10px] font-bold text-[var(--primary)]\" data-kid=\"1-3-1-4\" data-name=\"reviews nav item\" href=\"#resenias\">\n                <i class=\"ti ti-star text-[18px]\" data-kid=\"1-3-1-4-1\" data-name=\"reviews icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-4-2\" data-name=\"label\">\n                    Reseñas\n                </span>\n                <span class=\"absolute right-[18%] top-1 rounded-[4px] bg-[var(--warning-surface)] px-1 text-[9px] font-bold text-[#FCD34D]\" data-dynamic=\"true\" data-kid=\"1-3-1-4-3\" data-name=\"pending reviews count badge\" data-reason=\"count updated by script\">\n                    3\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] text-[var(--text-secondary)]\" data-kid=\"1-3-1-5\" data-name=\"logs nav item\" href=\"#logs\">\n                <i class=\"ti ti-list-details text-[18px]\" data-kid=\"1-3-1-5-1\" data-name=\"logs icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-5-2\" data-name=\"label\">\n                    Logs\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
