         <div class=\"mt-7 space-y-5\" data-kid=\"2-1-3-2-3-2-4\" data-name=\"financial stat list\">\n                            <div class=\"flex items-end justify-between border-b border-[#E2E8F0] pb-4\" data-kid=\"2-1-3-2-3-2-4-1\" data-name=\"stat row\">\n                                <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-4-1-1\" data-name=\"stat label\">\n                                    Total este año\n                                </span>\n                                <strong class=\"font-heading text-[19px] text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-4-1-2\" data-name=\"stat value\">\n                                    $684.50\n                                </strong>\n                            </div>\n                            <div class=\"flex items-end justify-between border-b border-[#E2E8F0] pb-4\" data-kid=\"2-1-3-2-3-2-4-2\" data-name=\"stat row\">\n                                <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-4-2-1\" data-name=\"stat label\">\n                                    Servicios registrados\n                                </span>\n                                <strong class=\"font-heading text-[19px] text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-4-2-2\" data-name=\"stat value\">\n                                    7\n                                </strong>\n                            </div>\n                            <div class=\"flex items-end justify-between border-b border-[#E2E8F0] pb-4\" data-kid=\"2-1-3-2-3-2-4-3\" data-name=\"stat row\">\n                                <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-4-3-1\" data-name=\"stat label\">\n                                    Promedio por visita\n                                </span>\n                                <strong class=\"font-heading text-[19px] text-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-4-3-2\" data-name=\"stat value\">\n                                    $97.79\n 