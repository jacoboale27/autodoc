el group\">\n                                        <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-2-2-2-2-2-1-1\" data-name=\"WhatsApp title\">\n                                            Recibir reservas por WhatsApp\n                                        </div>\n                                        <div class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-2-2-2-1-2\" data-name=\"WhatsApp description\">\n                                            Usa +503 7788-9900 como canal de contacto.\n                                        </div>\n                                    </div>\n                                    <span class=\"flex h-6 w-11 items-center justify-end rounded-full bg-[#34D399] px-1\" data-kid=\"2-1-3-2-2-2-2-2-2-2\" data-name=\"WhatsApp switch\">\n                                        <span class=\"h-4 w-4 rounded-full bg-[#064E3B]\" data-kid=\"2-1-3-2-2-2-2-2-2-2-1\" data-name=\"WhatsApp switch thumb\">\n                                        </span>\n                                    </span>\n                                </div>\n                            </div>\n                        </section>\n                        <section aria-label=\"Location status\" class=\"border-l-4 border-[#FBBF24] bg-[#3B2F12] px-5 py-4\" data-kid=\"2-1-3-2-2-2-3\" data-name=\"Location status box\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"2-1-3-2-2-2-3-1\" data-name=\"Location status content\">\n                                <i class=\"ti ti-map-pin-exclamation mt-0.5 text-[19px] text-[#FBBF24]\" data-kid=\"2-1-3-2-2-2-3-1-1\" data-name=\"Location status icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                <div data-kid=\"2-1-3-2-2-2-3-1-2\" data-name=\"Location status text group\">\n                                    <div class=\"text-[12px] font-bold text-[#FDE68A]\" data-kid=\"2-1-3-2-2-2-3-1-2-1\" data-name=\"Location status title\">\n                                        Ubicación registrada\n                                    </div>\n                                    <p class=\"mt-1 text-[11px] leading-5 text-[#FCD34D]\" data-kid=\"2-1-3-2-2-2-3-1-2-2\" data-name=\"Location status subtext\">\n                                        Tus coordenadas están listas para mostrar la distancia a los clientes.\n                                    </p>\n                                    <button class=\"mt-3 text-[11px] font-bold text-[#F8FAFC] underline underline-offset-4\" data-kid=\"2-1-3-2-2-2-3-1-2-3\" data-name=\"Location edit link\">\n                                        Editar ubicación\n                                    </button>\n                                </div>\n                            </div>\n                        </section>\n                    </div>\n                </div>\n                <div class=\"mt-8 flex items-center justify-between border-t border-[#334155] pt-5\" data-kid=\"2-1-3-2-3\" data-name=\"Form footer\">\n                    <span class=\"flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1\" data-name=\"Security confirmation text\">\n                        <i class=\"ti ti-shield-check text-[15px] text-[#34D399]\" data-kid=\"2-1-3-2-3-1-1\" data-name=\"Security icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Los cambios se guardan de forma segura en tu perfil de taller.\n                    </span>\n                    <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2\" data-name=\"Page branding footer\">\n                        AutoDoc · Configuración del taller\n                    </span>\n                </div>\n            </div>\n        </main>\n    </div>\n</div>\n",
