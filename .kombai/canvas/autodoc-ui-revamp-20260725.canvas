    "var_e9983f600901": {
      "type": "variant",
      "label": "AutoDoc Garage — Hadrian Light Mobile",
      "parentId": "var_0fb8fb03114d",
      "themeId": null,
      "rect": {
        "x": 16220,
        "y": 0,
        "w": 375,
        "h": 788
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"tabler icon webfont stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"mobile garage page layout\">\n    <header class=\"sticky top-0 z-20 flex min-h-[68px] items-center gap-3 border-b border-[#CBD5E1] bg-white/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"compact mobile top bar\">\n        <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[17px] font-extrabold tracking-[-0.08em] text-white [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1\" data-name=\"autodoc mobile logo\">\n            AD\n        </div>\n        <div class=\"min-w-0\" data-kid=\"2-1-2\" data-name=\"mobile page context\">\n            <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"owner role label\">\n                Propietario\n            </p>\n            <p class=\"truncate text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-1-2-2\" data-name=\"garage page title\">\n                Mi garaje\n            </p>\n        </div>\n        <div class=\"ml-auto flex items-center gap-1\" data-kid=\"2-1-3\" data-name=\"mobile header actions\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 shrink-0 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-3-1\" data-name=\"mobile notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-1\" data-name=\"notification bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"absolute right-[11px] top-[9px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-3-1-2\" data-name=\"notification dot\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 shrink-0 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-3-2\" data-name=\"mobile theme toggle button\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-3-2-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n            </button>\n            <button aria-label=\"Abrir perfil de Juan Pérez\" class=\"grid size-11 shrink-0 place-items-center\" data-kid=\"2-1-3-3\" data-name=\"mobile profile button\">\n                <span class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-3-1\" data-name=\"mobile user initials\">\n                    JP\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[520px] px-4 pb-[104px] pt-6\" data-kid=\"2-2\" data-name=\"mobile garage content\" id=\"garaje\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"mobile page heading\">\n            <div class=\"mb-2 flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"mobile breadcrumb\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"owner label\">\n                    Propietario\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-1-3\" data-name=\"page title label\">\n                    Mi garaje\n                </span>\n            </div>\n            <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[28px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2\" data-name=\"garage heading\">\n                Mi garaje\n            </h1>\n            <p class=\"mt-2 max-w-[320px] text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-3\" data-name=\"garage description\">\n                Tus vehículos y su estado de mantenimiento, en un solo lugar.\n            </p>\n        </div>\n        <button class=\"mb-5 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#45236F] px-5 py-3 text-[13px] font-semibold text-white shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.97]\" data-kid=\"2-2-2\" data-name=\"add vehicle primary action\">\n            <i class=\"ti ti-plus\" data-kid=\"2-2-2-1\" data-name=\"add vehicle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF\">\n            </i>\n            Añadir vehículo\n        </button>\n        <div class=\"mb-7 overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-white shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-2-3\" data-name=\"mobile garage filters container\">\n            <label class=\"flex min-h-[48px] items-center gap-3 border-b border-[#E2E8F0] px-4\" data-kid=\"2-2-3-1\" data-name=\"vehicle search field\">\n                <i class=\"ti ti-search shrink-0 text-[18px]\" data-kid=\"2-2-3-1-1\" data-name=\"search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <input aria-label=\"Buscar por marca o placa\" class=\"min-w-0 flex-1 bg-transparent text-[13px] text-[#0F172A] outline-hidden placeholder:text-[#94A3B8]\" data-kid=\"2-2-3-1-2\" data-name=\"vehicle search input\" placeholder=\"Buscar por marca o placa\"/>\n            </label>\n            <div class=\"flex min-h-[56px] items-center justify-between gap-3 px-4\" data-kid=\"2-2-3-2\" data-name=\"vehicle filter summary\">\n                <span class=\"text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-2-3-2-1\" data-name=\"registered vehicle count\">\n                    2 vehículos registrados\n                </span>\n                <button class=\"inline-flex min-h-[48px] shrink-0 items-center gap-2 rounded-full border border-[#CBD5E1] bg-[#F8FAFC] px-4 text-[12px] font-semibold text-[#334155] shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-2-3-2-2\" data-name=\"vehicle status filter button\">\n                    Todos los estados\n                    <i class=\"ti ti-chevron-down\" data-kid=\"2-2-3-2-2-1\" data-name=\"filter chevron icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;color:#334155\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <section aria-labelledby=\"vehicles-title\" data-kid=\"2-2-4\" data-name=\"registered vehicles section\">\n            <div class=\"mb-4 flex items-end justify-between gap-3\" data-kid=\"2-2-4-1\" data-name=\"registered vehicles header\">\n                <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[20px] font-bold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-4-1-1\" data-name=\"vehicles section title\" id=\"vehicles-title\">\n                    Vehículos registrados\n                </h2>\n                <span class=\"shrink-0 text-right text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-4-1-2\" data-name=\"last updated timestamp\" data-reason=\"text updated periodically by background script\">\n                    Actualizado hace 8 min\n                </span>\n            </div>\n            <article class=\"mb-5 overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4-2\" data-name=\"primary vehicle card\">\n                <div class=\"aspect-[16/9] bg-[#E2E8F0]\" data-kid=\"2-2-4-2-1\" data-name=\"primary vehicle image container\">\n                    <img alt=\"Sedán Hyundai en perfil, fotografía de Hyundai Motor Group en Pexels\" class=\"h-full w-full object-cover\" data-kid=\"2-2-4-2-1-1\" data-name=\"primary vehicle image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14696345/pexels-photo-14696345.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                </div>\n                <div class=\"p-4\" data-kid=\"2-2-4-2-2\" data-name=\"primary vehicle details\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-4-2-2-1\" data-name=\"primary vehicle status row\">\n                        <span class=\"inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#F59E0B]\" data-kid=\"2-2-4-2-2-1-1\" data-name=\"primary vehicle review status\">\n                            <i class=\"ti ti-alert-triangle text-[15px]\" data-kid=\"2-2-4-2-2-1-1-1\" data-name=\"review warning icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;color:#F59E0B\">\n                            </i>\n                            Revisión pronta\n                        </span>\n                        <span class=\"text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-2-4-2-2-1-2\" data-name=\"primary vehicle badge\">\n                            Principal\n                        </span>\n                    </div>\n                    <h3 class=\"mt-3 [font-family:'Plus_Jakarta_Sans',sans-serif] text-[23px] font-extrabold tracking-[-0.04em] text-[#0F172A]\" data-kid=\"2-2-4-2-2-2\" data-name=\"primary vehicle model title\">\n                        Toyota Corolla 2022\n                    </h3>\n                    <p class=\"mt-1 text-[13px] font-semibold tracking-[0.18em] text-[#64748B]\" data-kid=\"2-2-4-2-2-3\" data-name=\"primary vehicle license plate\">\n                        P 482-916\n                    </p>\n                    <div class=\"mt-5 grid grid-cols-3 gap-3 border-y border-[#E2E8F0] py-4\" data-kid=\"2-2-4-2-2-4\" data-name=\"primary vehicle metrics\">\n                        <div data-kid=\"2-2-4-2-2-4-1\" data-name=\"mileage metric\">\n                            <p class=\"text-[9px] font-semibold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-2-4-1-1\" data-name=\"mileage label\">\n                                Kilometraje\n                            </p>\n                            <p class=\"mt-1 [font-family:'Plus_Jakarta_Sans',sans-serif] text-[17px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-2-4-2-2-4-1-2\" data-name=\"mileage value\">\n                                48,260\n                                <span class=\"text-[10px] font-medium tracking-normal text-[#64748B]\" data-kid=\"2-2-4-2-2-4-1-2-1\" data-name=\"mileage unit\">\n                                    km\n                                </span>\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-2-4-2\" data-name=\"next step metric\">\n                            <p class=\"text-[9px] font-semibold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-2-4-2-1\" data-name=\"next step label\">\n                                Próximo paso\n                            </p>\n                            <p class=\"mt-1 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-2-4-2-2\" data-name=\"next step value\">\n                                420 km\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-2-4-3\" data-name=\"last service metric\">\n                            <p class=\"text-[9px] font-semibold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-2-4-3-1\" data-name=\"last service label\">\n                                Último servicio\n                            </p>\n                            <p class=\"mt-1 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-2-4-3-2\" data-name=\"last service value\">\n                                12 jun 2026\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-5 space-y-3\" data-kid=\"2-2-4-2-2-5\" data-name=\"primary vehicle action row\">\n                        <p class=\"text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-4-2-2-5-1\" data-name=\"maintenance warning message\">\n                            Pastillas de freno requieren revisión.\n                        </p>\n                        <button class=\"flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full border border-[#522C81] bg-transparent px-4 py-2.5 text-[12px] font-bold text-[#522C81] shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-[#EEEDF0] hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.97]\" data-kid=\"2-2-4-2-2-5-2\" data-name=\"primary vehicle details button\">\n                            Ver ficha\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"2-2-4-2-2-5-2-1\" data-name=\"primary vehicle arrow icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </article>\n            <article class=\"mb-5 overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4-3\" data-name=\"healthy vehicle card\">\n                <div class=\"aspect-[16/8] bg-[#E2E8F0]\" data-kid=\"2-2-4-3-1\" data-name=\"mazda image container\">\n                    <img alt=\"Sedán oscuro en perfil, fotografía de Hyundai Motor Group en Pexels\" class=\"h-full w-full object-cover\" data-kid=\"2-2-4-3-1-1\" data-name=\"mazda vehicle image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12122221/pexels-photo-12122221.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                </div>\n                <div class=\"p-4\" data-kid=\"2-2-4-3-2\" data-name=\"mazda vehicle details\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-4-3-2-1\" data-name=\"mazda status row\">\n                        <span class=\"inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#10B981]\" data-kid=\"2-2-4-3-2-1-1\" data-name=\"healthy status label\">\n                            <i class=\"ti ti-circle-check text-[15px]\" data-kid=\"2-2-4-3-2-1-1-1\" data-name=\"healthy status icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;color:#10B981\">\n                            </i>\n                            Óptimo\n                        </span>\n                        <button aria-label=\"Más opciones para Mazda 3\" class=\"grid min-h-[44px] min-w-[44px] place-items-center text-[18px] text-[#94A3B8]\" data-kid=\"2-2-4-3-2-1-2\" data-name=\"mazda options button\">\n                            <i class=\"ti ti-dots\" data-kid=\"2-2-4-3-2-1-2-1\" data-name=\"mazda options icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                            </i>\n                        </button>\n                    </div>\n                    <h3 class=\"mt-2 [font-family:'Plus_Jakarta_Sans',sans-serif] text-[21px] font-bold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-4-3-2-2\" data-name=\"mazda vehicle model title\">\n                        Mazda 3 2019\n                    </h3>\n                    <p class=\"mt-1 text-[13px] font-semibold tracking-[0.18em] text-[#64748B]\" data-kid=\"2-2-4-3-2-3\" data-name=\"mazda license plate\">\n                        H 731-204\n                    </p>\n                    <div class=\"mt-5 flex items-end justify-between gap-4 border-t border-[#E2E8F0] pt-4\" data-kid=\"2-2-4-3-2-4\" data-name=\"mazda vehicle metrics\">\n                        <div data-kid=\"2-2-4-3-2-4-1\" data-name=\"mazda mileage metric\">\n                            <p class=\"text-[10px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-3-2-4-1-1\" data-name=\"mazda mileage label\">\n                                Kilometraje\n                            </p>\n                            <p class=\"mt-1 text-[16px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-2-4-3-2-4-1-2\" data-name=\"mazda mileage value\">\n                                81,430 km\n                            </p>\n                        </div>\n                        <p class=\"text-right text-[11px] text-[#64748B]\" data-kid=\"2-2-4-3-2-4-2\" data-name=\"mazda last service timestamp\">\n                            Última visita\n                            <br data-kid=\"2-2-4-3-2-4-2-1\" data-name=\"mazda last service line break\"/>\n                            <strong class=\"text-[#334155]\" data-kid=\"2-2-4-3-2-4-2-2\" data-name=\"mazda last service date\">\n                                02 jun 2026\n                            </strong>\n                        </p>\n                    </div>\n                    <button class=\"mt-5 flex min-h-[48px] items-center gap-2 rounded-full px-4 text-[12px] font-bold text-[#522C81] transition duration-150 ease-out hover:bg-[#EEEDF0] active:scale-[0.97]\" data-kid=\"2-2-4-3-2-5\" data-name=\"mazda details button\">\n                        Ver ficha\n                        <i class=\"ti ti-arrow-right\" data-kid=\"2-2-4-3-2-5-1\" data-name=\"mazda arrow icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                        </i>\n                    </button>\n                </div>\n            </article>\n            <article class=\"mb-5 overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4-4\" data-name=\"vehicle missing data card\">\n                <div class=\"flex aspect-[16/8] items-center justify-center bg-[#E2E8F0] text-[#94A3B8]\" data-kid=\"2-2-4-4-1\" data-name=\"pending vehicle image placeholder\">\n                    <div class=\"text-center\" data-kid=\"2-2-4-4-1-1\" data-name=\"placeholder icon container\">\n                        <i class=\"ti ti-car-off text-[30px]\" data-kid=\"2-2-4-4-1-1-1\" data-name=\"missing vehicle image icon\" style=\"width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                        </i>\n                        <p class=\"mt-2 text-[11px] font-semibold uppercase tracking-[0.12em]\" data-kid=\"2-2-4-4-1-1-2\" data-name=\"placeholder label\">\n                            Imagen pendiente\n                        </p>\n                    </div>\n                </div>\n                <div class=\"p-4\" data-kid=\"2-2-4-4-2\" data-name=\"pending vehicle details\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-4-4-2-1\" data-name=\"pending status row\">\n                        <span class=\"inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-4-2-1-1\" data-name=\"pending status label\">\n                            <i class=\"ti ti-info-circle text-[15px]\" data-kid=\"2-2-4-4-2-1-1-1\" data-name=\"pending information icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                            </i>\n                            Sin datos recientes\n                        </span>\n                        <button aria-label=\"Más opciones para Renault Duster\" class=\"grid min-h-[44px] min-w-[44px] place-items-center text-[18px] text-[#94A3B8]\" data-kid=\"2-2-4-4-2-1-2\" data-name=\"renault options button\">\n                            <i class=\"ti ti-dots\" data-kid=\"2-2-4-4-2-1-2-1\" data-name=\"renault options icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                            </i>\n                        </button>\n                    </div>\n                    <h3 class=\"mt-2 [font-family:'Plus_Jakarta_Sans',sans-serif] text-[21px] font-bold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-4-4-2-2\" data-name=\"renault vehicle model title\">\n                        Renault Duster 2021\n                    </h3>\n                    <p class=\"mt-1 text-[13px] font-semibold tracking-[0.18em] text-[#64748B]\" data-kid=\"2-2-4-4-2-3\" data-name=\"renault license plate\">\n                        J 204-118\n                    </p>\n                    <div class=\"mt-5 border-t border-[#E2E8F0] pt-4\" data-kid=\"2-2-4-4-2-4\" data-name=\"pending status description container\">\n                        <p class=\"text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-4-4-2-4-1\" data-name=\"pending maintenance message\">\n                            Completa la ficha para activar alertas de mantenimiento y kilometraje.\n                        </p>\n                    </div>\n                    <button class=\"mt-5 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#45236F] px-4 py-2.5 text-[12px] font-bold text-white shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.97]\" data-kid=\"2-2-4-4-2-5\" data-name=\"complete vehicle profile button\">\n                        Completar ficha\n                        <i class=\"ti ti-arrow-up-right\" data-kid=\"2-2-4-4-2-5-1\" data-name=\"complete profile arrow icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF\">\n                        </i>\n                    </button>\n                </div>\n            </article>\n        </section>\n        <div class=\"mb-6 flex flex-col gap-3 border-l-4 border-[#F59E0B] bg-[#FFFBEB] px-4 py-4\" data-kid=\"2-2-5\" data-name=\"maintenance alert banner\" id=\"alertas\">\n            <div class=\"flex items-start gap-3\" data-kid=\"2-2-5-1\" data-name=\"alert message container\">\n                <i class=\"ti ti-bell-ringing mt-0.5 shrink-0 text-[19px]\" data-kid=\"2-2-5-1-1\" data-name=\"maintenance alert icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#F59E0B\">\n                </i>\n                <p class=\"text-[12px] leading-5 text-[#92400E]\" data-kid=\"2-2-5-1-2\" data-name=\"maintenance alert text\">\n                    <strong class=\"font-bold\" data-kid=\"2-2-5-1-2-1\" data-name=\"maintenance alert bold text\">\n                        Un vehículo necesita atención.\n                    </strong>\n                    Revisa el estado del Toyota Corolla antes de tu próxima salida.\n                </p>\n            </div>\n            <button class=\"min-h-[44px] self-end px-2 text-[12px] font-bold text-[#92400E] underline underline-offset-2\" data-kid=\"2-2-5-2\" data-name=\"view alert button\">\n                Ver alerta\n            </button>\n        </div>\n        <div class=\"mb-5 flex flex-col gap-3 border-t border-[#CBD5E1] pt-5 text-[12px] text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"garage follow-up footer\" id=\"historial\">\n            <span data-kid=\"2-2-6-1\" data-name=\"another vehicle question\">\n                ¿Tienes otro vehículo? Agrégalo para recibir alertas de mantenimiento.\n            </span>\n            <a class=\"flex min-h-[44px] items-center gap-1 font-bold text-[#1E88E5]\" data-kid=\"2-2-6-2\" data-name=\"back home link\" href=\"#garaje\" id=\"talleres\">\n                Volver al inicio\n                <i class=\"ti ti-arrow-up-right\" data-kid=\"2-2-6-2-1\" data-name=\"back home arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                </i>\n            </a>\n        </div>\n        <p class=\"pb-2 text-[11px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-7\" data-name=\"garage footer disclaimer\">\n            AutoDoc · Diagnóstico y mantenimiento vehicular · Datos sincronizados con tu garaje\n        </p>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\" style=\"padding-bottom:calc(0.5rem + env(safe-area-inset-bottom))\">\n        <div class=\"mx-auto flex max-w-[520px] items-start justify-between gap-1\" data-kid=\"2-3-1\" data-name=\"mobile navigation items\">\n            <a class=\"flex min-h-[44px] min-w-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-1\" data-name=\"home navigation item\" href=\"#inicio\">\n                <i class=\"ti ti-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"home navigation icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-1-2\" data-name=\"home navigation label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[44px] min-w-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-lg bg-[#E8F2FD] text-[#1E88E5]\" data-kid=\"2-3-1-2\" data-name=\"garage navigation item\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"garage navigation icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                </i>\n                <span class=\"text-[10px] font-bold\" data-kid=\"2-3-1-2-2\" data-name=\"garage navigation label\">\n                    Mi garaje\n                </span>\n            </a>\n            <a class=\"flex min-h-[44px] min-w-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-3\" data-name=\"workshops navigation item\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"workshops navigation icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-3-2\" data-name=\"workshops navigation label\">\n                    Talleres\n                </span>\n            </a>\n            <a class=\"relative flex min-h-[44px] min-w-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-4\" data-name=\"alerts navigation item\" href=\"#alertas\">\n                <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"alerts navigation icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-4-3\" data-name=\"alerts navigation label\">\n                    Alertas\n                </span>\n                <span class=\"absolute right-[18%] top-1 size-1.5 rounded-full bg-[#EF4444]\" data-kid=\"2-3-1-4-2\" data-name=\"alerts badge\">\n                </span>\n            </a>\n            <a class=\"flex min-h-[44px] min-w-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-5\" data-name=\"history navigation item\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"history navigation icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-5-2\" data-name=\"history navigation label\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
