  </span>\n                        <span class=\"flex h-6 w-11 shrink-0 items-center justify-start rounded-full bg-[#334155] px-1\" data-kid=\"2-2-2-3-1-3-2\" data-name=\"Diagnostics toggle switch off\">\n                            <span class=\"h-4 w-4 rounded-full bg-[#94A3B8]\" data-kid=\"2-2-2-3-1-3-2-1\" data-name=\"Diagnostics toggle knob\">\n                            </span>\n                        </span>\n                    </label>\n                    <label class=\"flex min-h-[64px] items-center justify-between gap-4 py-3\" data-kid=\"2-2-2-3-1-4\" data-name=\"General maintenance service row\">\n                        <span class=\"flex min-w-0 items-center gap-3 text-[13px] font-medium text-[#E2E8F0]\" data-kid=\"2-2-2-3-1-4-1\" data-name=\"General maintenance label group\">\n                            <i class=\"ti ti-tool shrink-0 text-[17px] text-[#34D399]\" data-kid=\"2-2-2-3-1-4-1-1\" data-name=\"Tool icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span data-kid=\"2-2-2-3-1-4-1-2\" data-name=\"General maintenance service name\">\n                                Mantenimiento general\n                            </span>\n                        </span>\n                        <span class=\"flex h-6 w-11 shrink-0 items-center justify-end rounded-full bg-[#38BDF8] px-1\" data-kid=\"2-2-2-3-1-4-2\" data-name=\"General maintenance toggle switch\">\n                            <span class=\"h-4 w-4 rounded-full bg-[#082F49]\" data-kid=\"2-2-2-3-1-4-2-1\" data-name=\"General maintenance toggle knob\">\n                            </span>\n                        </span>\n                    </label>\n                </div>\n            </section>\n            <section aria-labelledby=\"contact-heading-mobile\" class=\"border-y border-[#475569]\" data-kid=\"2-2-2-4\" data-name=\"Contact and visibility section\">\n                <div class=\"flex items-start justify-between gap-4 border-b border-[#334155] py-5\" data-kid=\"2-2-2-4-2\" data-name=\"Contact and visibility header\">\n                    <div data-kid=\"2-2-2-4-2-1\" data-name=\"Contact and visibility text group\">\n                        <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-2-4-2-1-1\" data-name=\"Contact and visibility section title\" id=\"contact-heading-mobile\">\n                            Contacto y visibilidad\n                        </h2>\n                        <p class=\"mt-1 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-2-4-2-1-2\" data-name=\"Contact and visibility description\">\n                            Controla cómo reciben solicitudes tus clientes.\n                        </p>\n                    </div>\n                    <i class=\"ti ti-broadcast shrink-0 text-[19px] text-[#34D399]\" data-kid=\"2-2-2-4-2-2\" data-name=\"Broadcast icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n                <div class=\"divide-y divide-[#334155]\" data-kid=\"2-2-2-4-1\" data-name=\"Contact settings mobile list\">\n                    <div class=\"flex min-h-[78px] items-center justify-between gap-4 py-4\" data-kid=\"2-2-2-4-1-1\" data-name=\"Show phone row\">\n                        <div class=\"min-w-0\" data-kid=\"2-2-2-4-1-1-1\" data-name=\"Show phone label group\">\n                            <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-2-4-1-1-1-1\" data-name=\"Show phone title\">\n                                Mostrar teléfono público\n                            </div>\n                            <div class=\"mt-1 text-[11px] leading-4 text-[#64748B]\" data-kid=\"2-2-2-4-1-1-1-2\" data-name=\"Show phone description\">\n                                Visible en el directorio y en tu ficha.\n                            </div>\n                        </div>\n                        <span class=\"flex h-6 w-11 shrink-0 items-center justify-end rounded-full bg-[#38BDF8] px-1\" data-kid=\"2-2-2-4-1-1-2\" data-name=\"Show phone toggle\">\n                            <span class=\"h-4 w-4 rounded-full bg-[#082F49]\" data-kid=\"2-2-2-4-1-1-2-1\" data-name=\"Show phone toggle knob\">\n                            </span>\n                        </span>\n                    </div>\n                    <div class=\"flex min-h-[78px] items-center justify-between gap-4 py-4\" data-kid=\"2-2-2-4-1-2\" data-name=\"WhatsApp receive row\">\n                        <div class=\"min-w-0\" data-kid=\"2-2-2-4-1-2-1\" data-name=\"WhatsApp receive label group\">\n                            <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-2-4-1-2-1-1\" data-name=\"WhatsApp receive title\">\n                                Recibir reservas por WhatsApp\n                            </div>\n                            <div class=\"mt-1 text-[11px] leading-4 text-[#64748B]\" data-kid=\"2-2-2-4-1-2-1-2\" data-name=\"WhatsApp receive description\">\n                                Usa +503 7788-9900 como canal de contacto.\n                            </div>\n                        </div>\n                        <span class=\"flex h-6 w-11 shrink-0 items-center justify-end rounded-full bg-[#34D399] px-1\" data-kid=\"2-2-2-4-1-2-2\" data-name=\"WhatsApp receive toggle\">\n                            <span class=\"h-4 w-4 rounded-full bg-[#064E3B]\" data-kid=\"2-2-2-4-1-2-2-1\" data-name=\"WhatsApp receive toggle knob\">\n                            </span>\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <section aria-label=\"Location status\" class=\"border-l-4 border-[#FBBF24] bg-[#3B2F12] px-4 py-4\" data-kid=\"2-2-2-5\" data-name=\"Location status box\">\n                <div class=\"flex items-start gap-3\" data-kid=\"2-2-2-5-1\" data-name=\"Location status row\">\n                    <i class=\"ti ti-map-pin-exclamation mt-0.5 shrink-0 text-[19px] text-[#FBBF24]\" data-kid=\"2-2-2-5-1-1\" data-name=\"Map pin exclamation icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <div data-kid=\"2-2-2-5-1-2\" data-name=\"Location status content\">\n                        <div class=\"text-[12px] font-bold text-[#FDE68A]\" data-kid=\"2-2-2-5-1-2-1\" data-name=\"Location status title\">\n                            Ubicación registrada\n                        </div>\n                        <p class=\"mt-1 text-[11px] leading-5 text-[#FCD34D]\" data-kid=\"2-2-2-5-1-2-2\" data-name=\"Location status description\">\n                            Tus coordenadas están listas para mostrar la distancia a los clientes.\n                        </p>\n                        <button class=\"mt-3 flex min-h-11 items-center text-[11px] font-bold text-[#F8FAFC] underline underline-offset-4\" data-kid=\"2-2-2-5-1-2-3\" data-name=\"Edit location button\">\n                            Editar ubicación\n                        </button>\n                    </div>\n                </div>\n            </section>\n        </div>\n        <footer class=\"mt-8 space-y-3 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-3\" data-name=\"Mobile settings footer\">\n            <span class=\"flex items-start gap-2 leading-4\" data-kid=\"2-3-1\" data-name=\"Security notice text\">\n                <i class=\"ti ti-shield-check mt-0.5 shrink-0 text-[15px] text-[#34D399]\" data-kid=\"2-3-1-1\" data-name=\"Shield check icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Los cambios se guardan de forma segura en tu perfil de taller.\n            </span>\n            <span data-kid=\"2-3-2\" data-name=\"Footer brand copyright text\">\n                AutoDoc · Configuración del taller\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación móvil del taller\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/98 px-2 pb-[max(10px,env(safe-area-inset-bottom))] pt-2 backdrop-blur\" data-kid=\"2-4\" data-name=\"Fixed mobile workshop navigation\">\n        <div class=\"mx-auto grid max-w-[560px] grid-cols-5 gap-1\" data-kid=\"2-4-1\" data-name=\"Navigation grid container\">\n            <a aria-label=\"Panel\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-4-1-1\" data-name=\"Dashboard navigation item\" href=\"#panel\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-4-1-1-1\" data-name=\"Dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-4-1-1-2\" data-name=\"Dashboard label\">\n                    Panel\n                </span>\n            </a>\n            <a aria-label=\"Reparaciones\" class=\"relative flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-4-1-2\" data-name=\"Repairs navigation item\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-4-1-2-1\" data-name=\"Repairs icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-4-1-2-2\" data-name=\"Repairs label\">\n                    Reparaciones\n                </span>\n                <span class=\"absolute right-2 top-1 rounded-[4px] bg-[#7F1D1D] px-1 text-[9px] font-bold text-[#FCA5A5]\" data-kid=\"2-4-1-2-3\" data-name=\"Repairs notification count badge\">\n                    07\n                </span>\n            </a>\n            <a aria-label=\"Buscar vehículo\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-4-1-3\" data-name=\"Search vehicle navigation item\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[19px]\" data-kid=\"2-4-1-3-1\" data-name=\"Search icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-4-1-3-2\" data-name=\"Search label\">\n                    Buscar\n                </span>\n            </a>\n            <a aria-label=\"Conversaciones\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-4-1-4\" data-name=\"Messages navigation item\" href=\"#mensajes\">\n                <i class=\"ti ti-message-2 text-[19px]\" data-kid=\"2-4-1-4-1\" data-name=\"Messages icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-4-1-4-2\" data-name=\"Messages label\">\n                    Mensajes\n                </span>\n            </a>\n            <a aria-label=\"Configuración activa\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-4-1-5\" data-name=\"Configuration navigation item\" href=\"#configuracion\">\n                <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-4-1-5-1\" data-name=\"Configuration icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-4-1-5-2\" data-name=\"Configuration label\">\n                    Config.\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
