    "var_731ea0855c7d": {
      "type": "variant",
      "label": "AutoDoc Admin Reviews — Hadrian Light Mobile",
      "parentId": "var_b7860933ac80",
      "themeId": null,
      "rect": {
        "x": 116390,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .admin-review-mobile { font-family: 'IBM Plex Sans', sans-serif; }\n  .admin-review-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"admin-review-mobile min-h-screen overflow-x-hidden bg-[#F7F6F8] text-[#0F172A] antialiased\" data-kid=\"1\" data-name=\"admin review mobile layout container\" style=\"--surface:#F7F6F8;--surface-container:#EEEDF0;--surface-variant:#E2E8F0;--outline:#CBD5E1;--primary:#522C81;--secondary:#81E6D9;--text-primary:#0F172A;--text-secondary:#5B6B80;--warning:#B45309;--error:#C2414B;--success:#2F855A\">\n    <header class=\"sticky top-0 z-30 flex min-h-[68px] items-center justify-between border-b border-[#CBD5E1] bg-[#F7F6F8]/95 px-4 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"admin reviews mobile header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"admin brand and page context\">\n            <div class=\"grid size-11 shrink-0 place-items-center rounded-[12px] bg-[#522C81] text-[18px] font-bold tracking-[-0.08em] text-white shadow-[0_2px_4px_rgba(15,23,42,0.08)]\" data-kid=\"1-1-1-1\" data-name=\"AutoDoc admin logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"page context container\">\n                <p class=\"truncate text-[10px] font-bold uppercase tracking-[0.16em] text-[#5B6B80]\" data-kid=\"1-1-1-2-1\" data-name=\"administration label text\">\n                    Administración\n                </p>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"1-1-1-2-2\" data-name=\"page title container\">\n                    <span class=\"admin-review-heading truncate text-[15px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"1-1-1-2-2-1\" data-name=\"moderation page title\">\n                        Moderar reseñas\n                    </span>\n                    <span class=\"size-1.5 shrink-0 rounded-full bg-[#2F855A]\" data-kid=\"1-1-1-2-2-2\" data-name=\"status indicator icon\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-1-2\" data-name=\"header actions container\">\n            <button aria-label=\"Notificaciones\" class=\"relative flex size-11 items-center justify-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[18px]\" data-kid=\"1-1-2-1-1\" data-name=\"bell notification icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[#C2414B]\" data-kid=\"1-1-2-1-2\" data-name=\"notification unread dot\">\n                </span>\n            </button>\n            <button aria-label=\"Perfil de Superadmin\" class=\"grid size-11 place-items-center rounded-full bg-[#E7DDF2] text-[12px] font-bold text-[#522C81]\" data-kid=\"1-1-2-2\" data-name=\"profile superadmin button\">\n                SA\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[480px] px-4 pb-[112px] pt-5\" data-kid=\"1-2\" data-name=\"scroll-safe moderation content\">\n        <div class=\"mb-5\" data-kid=\"1-2-1\" data-name=\"moderation heading section\">\n            <div class=\"mb-3 flex items-center gap-2 text-[11px] text-[#5B6B80]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation container\">\n                <span data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb admin link\">\n                    Admin\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px] text-[#94A3B8]\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb current page\">\n                    Reseñas\n                </span>\n            </div>\n            <div class=\"flex items-end justify-between gap-3\" data-kid=\"1-2-1-2\" data-name=\"heading and description container\">\n                <div class=\"min-w-0\" data-kid=\"1-2-1-2-1\" data-name=\"heading text block\">\n                    <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[#522C81]\" data-kid=\"1-2-1-2-1-1\" data-name=\"quality control label\">\n                        Control de calidad\n                    </p>\n                    <h1 class=\"admin-review-heading text-[26px] font-extrabold leading-tight tracking-[-0.045em] text-[#0F172A]\" data-kid=\"1-2-1-2-1-2\" data-name=\"moderation headline\">\n                        Moderar reseñas\n                    </h1>\n                    <p class=\"mt-2 text-[14px] leading-5 text-[#5B6B80]\" data-kid=\"1-2-1-2-1-3\" data-name=\"moderation description\">\n                        Revisa comentarios reportados y protege la calidad de la comunidad.\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-4 flex min-h-[58px] items-center justify-between gap-3 rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] px-3 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-1-3\" data-name=\"report-only filter row\">\n                <div class=\"min-w-0\" data-kid=\"1-2-1-3-1\" data-name=\"filter label container\">\n                    <p class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"1-2-1-3-1-1\" data-name=\"filter title\">\n                        Mostrar solo reportadas\n                    </p>\n                    <p class=\"mt-1 truncate text-[11px] text-[#5B6B80]\" data-kid=\"1-2-1-3-1-2\" data-name=\"filter sub-label\">\n                        3 pendientes de revisión\n                    </p>\n                </div>\n                <div aria-label=\"Mostrar solo reportadas desactivado\" class=\"relative flex h-8 w-14 shrink-0 items-center rounded-full bg-[#CBD5E1] px-1\" data-kid=\"1-2-1-3-2\" data-name=\"filter toggle switch\">\n                    <span class=\"size-6 rounded-full bg-white shadow-[0_2px_4px_rgba(15,23,42,0.12)]\" data-kid=\"1-2-1-3-2-1\" data-name=\"filter toggle knob\">\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-3 flex items-center justify-between border-y border-[#CBD5E1] py-3\" data-kid=\"1-2-1-4\" data-name=\"activity summary bar\">\n                <span class=\"flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#5B6B80]\" data-kid=\"1-2-1-4-1\" data-name=\"activity indicator label\">\n                    <span class=\"size-1.5 rounded-full bg-[#2F855A]\" data-kid=\"1-2-1-4-1-1\" data-name=\"activity status bullet\">\n                    </span>\n                    Actividad de moderación\n                </span>\n                <span class=\"rounded-full border border-[#CBD5E1] bg-white px-3 py-2 text-[11px] font-semibold text-[#5B6B80]\" data-kid=\"1-2-1-4-2\" data-name=\"total reviews count\">\n                    7 reseñas\n                </span>\n            </div>\n        </div>\n        <section class=\"space-y-3\" data-kid=\"1-2-2\" data-name=\"stacked moderation reviews\">\n            <article class=\"rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] p-4 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-2-1\" data-name=\"reported review card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"review card header\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-2-1-1-1\" data-name=\"review header metadata\">\n                        <div class=\"flex flex-wrap items-center gap-1.5\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"rating star container\">\n                            <span aria-label=\"3 de 5 estrellas\" class=\"text-[15px] text-[#B45309]\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"star icons\">\n                                ★ ★ ★\n                                <span class=\"text-[#94A3B8]\" data-kid=\"1-2-2-1-1-1-1-1-1\" data-name=\"empty star icons\">\n                                    ☆ ☆\n                                </span>\n                            </span>\n                            <span class=\"rounded-full bg-[#FFF1F2] px-2 py-1 text-[10px] font-bold text-[#C2414B]\" data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"report flag badge\">\n                                <i class=\"ti ti-flag text-[11px]\" data-kid=\"1-2-2-1-1-1-1-2-1\" data-name=\"flag icon\" style=\"width:11px;height:11px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Reportada\n                            </span>\n                        </div>\n                        <time class=\"mt-2 block text-[11px] font-semibold text-[#5B6B80]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"review date\">\n                            15/08/2026\n                        </time>\n                    </div>\n                    <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-2-2-1-1-2\" data-name=\"review actions container\">\n                        <button aria-label=\"Descartar reporte\" class=\"flex size-11 items-center justify-center rounded-full border border-[#CBD5E1] bg-white text-[#5B6B80]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"discard report button\">\n                            <i class=\"ti ti-flag-off text-[17px]\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"discard flag icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                        <button aria-label=\"Eliminar reseña\" class=\"flex size-11 items-center justify-center rounded-full border border-[#C2414B]/30 bg-[#FFF1F2] text-[#C2414B]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"delete review button\">\n                            <i class=\"ti ti-trash text-[17px]\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"delete trash icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <p class=\"mt-3 text-[13px] leading-5 text-[#0F172A]\" data-kid=\"1-2-2-1-2\" data-name=\"review comment text\">\n                    El servicio fue rápido, pero la explicación del trabajo quedó incompleta y tuve que pedir aclaraciones.\n                </p>\n                <div class=\"mt-3 flex flex-wrap gap-2 text-[11px] font-semibold text-[#5B6B80]\" data-kid=\"1-2-2-1-3\" data-name=\"review entity tags container\">\n                    <span class=\"rounded-full bg-[#E2E8F0] px-2.5 py-1.5\" data-kid=\"1-2-2-1-3-1\" data-name=\"workshop tag\">\n                        <i class=\"ti ti-building-store mr-1 text-[12px] text-[#522C81]\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"workshop building icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Taller: Taller Rápido\n                    </span>\n                    <span class=\"rounded-full bg-[#E2E8F0] px-2.5 py-1.5\" data-kid=\"1-2-2-1-3-2\" data-name=\"customer tag\">\n                        <i class=\"ti ti-user mr-1 text-[12px] text-[#522C81]\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"customer user icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Cliente: Juan Pérez\n                    </span>\n                </div>\n                <div class=\"mt-3 flex items-center gap-2\" data-kid=\"1-2-2-1-4\" data-name=\"review media attachments container\">\n                    <div class=\"size-12 rounded-[10px] bg-[#D8D2E0]\" data-kid=\"1-2-2-1-4-1\" data-name=\"media placeholder thumbnail\">\n                    </div>\n                    <div class=\"flex size-12 items-center justify-center rounded-[10px] border border-dashed border-[#CBD5E1] bg-white text-[#5B6B80]\" data-kid=\"1-2-2-1-4-2\" data-name=\"media missing icon container\">\n                        <i class=\"ti ti-photo-off text-[17px]\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"photo off icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <span class=\"text-[11px] text-[#5B6B80]\" data-kid=\"1-2-2-1-4-3\" data-name=\"media attachment count text\">\n                        2 fotos · una no disponible\n                    </span>\n                </div>\n            </article>\n            <article class=\"rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] p-4 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-2-2\" data-name=\"visible review card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-2-1\" data-name=\"visible review header\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-2-2-1-1\" data-name=\"visible review header metadata\">\n                        <div class=\"flex flex-wrap items-center gap-1.5\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"visible rating stars\">\n                            <span aria-label=\"5 de 5 estrellas\" class=\"text-[15px] text-[#B45309]\" data-kid=\"1-2-2-2-1-1-1-1\">\n                                ★ ★ ★ ★ ★\n                            </span>\n                            <span class=\"rounded-full bg-[#ECFDF5] px-2 py-1 text-[10px] font-bold text-[#2F855A]\" data-kid=\"1-2-2-2-1-1-1-2\" data-name=\"visible status badge\">\n                                <i class=\"ti ti-circle-check text-[11px]\" data-kid=\"1-2-2-2-1-1-1-2-1\" data-name=\"checkmark icon\" style=\"width:11px;height:11px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Visible\n                            </span>\n                        </div>\n                        <time class=\"mt-2 block text-[11px] font-semibold text-[#5B6B80]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"visible review date\">\n                            12/08/2026\n                        </time>\n                    </div>\n                    <button aria-label=\"Eliminar reseña\" class=\"flex size-11 shrink-0 items-center justify-center rounded-full border border-[#CBD5E1] bg-white text-[#C2414B]\" data-kid=\"1-2-2-2-1-2\" data-name=\"visible review delete button\">\n                        <i class=\"ti ti-trash text-[17px]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"visible review trash icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <p class=\"mt-3 text-[13px] leading-5 text-[#0F172A]\" data-kid=\"1-2-2-2-2\" data-name=\"visible review comment\">\n                    Excelente atención y diagnóstico muy claro. El vehículo quedó listo antes de lo esperado.\n                </p>\n                <div class=\"mt-3 flex flex-wrap gap-2 text-[11px] font-semibold text-[#5B6B80]\" data-kid=\"1-2-2-2-3\" data-name=\"visible review entity tags\">\n                    <span class=\"rounded-full bg-[#E2E8F0] px-2.5 py-1.5\" data-kid=\"1-2-2-2-3-1\">\n                        Taller: MotorLab\n                    </span>\n                    <span class=\"rounded-full bg-[#E2E8F0] px-2.5 py-1.5\" data-kid=\"1-2-2-2-3-2\">\n                        Cliente: Ana Torres\n                    </span>\n                </div>\n                <div class=\"mt-3 flex items-center gap-2\" data-kid=\"1-2-2-2-4\" data-name=\"visible review media thumbnails\">\n                    <div class=\"size-12 rounded-[10px] bg-[#D8E8E0]\" data-kid=\"1-2-2-2-4-1\">\n                    </div>\n                    <div class=\"size-12 rounded-[10px] bg-[#E2E8F0]\" data-kid=\"1-2-2-2-4-2\">\n                    </div>\n                </div>\n            </article>\n        </section>\n        <div class=\"mt-4 rounded-[12px] border border-dashed border-[#CBD5E1] bg-[#F7F6F8] px-3 py-2.5 text-[11px] text-[#5B6B80]\" data-kid=\"1-2-3\" data-name=\"alternate empty states cue\">\n            <span class=\"font-semibold text-[#0F172A]\" data-kid=\"1-2-3-1\">\n                Estados alternativos:\n            </span>\n            No hay reseñas reportadas · No hay reseñas registradas\n        </div>\n        <footer class=\"mt-5 border-t border-[#CBD5E1] pt-4 text-[11px] text-[#5B6B80]\" data-kid=\"1-2-4\" data-name=\"moderation sync footer\">\n            <span class=\"mr-2 inline-block size-1.5 rounded-full bg-[#2F855A]\" data-kid=\"1-2-4-1\">\n            </span>\n            Datos sincronizados hace 4 min · Moderación protegida\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación de administración\" class=\"fixed inset-x-0 bottom-0 z-40 border-t border-[#CBD5E1] bg-[#F7F6F8]/95 px-2 pb-[env(safe-area-inset-bottom)] pt-2 backdrop-blur-sm\" data-kid=\"1-3\" data-name=\"admin mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[480px] grid-cols-5 gap-1\" data-kid=\"1-3-1\" data-name=\"navigation grid container\">\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#5B6B80]\" data-kid=\"1-3-1-1\" data-name=\"navigation summary link\" href=\"#resumen\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"1-3-1-1-1\" data-name=\"summary icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-1-2\" data-name=\"summary label\">\n                    Resumen\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#5B6B80]\" data-kid=\"1-3-1-2\" data-name=\"navigation users link\" href=\"#usuarios\">\n                <i class=\"ti ti-users text-[18px]\" data-kid=\"1-3-1-2-1\" data-name=\"users icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-2-2\" data-name=\"users label\">\n                    Usuarios\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#5B6B80]\" data-kid=\"1-3-1-3\" data-name=\"navigation workshops link\" href=\"#talleres\">\n                <i class=\"ti ti-building-store text-[18px]\" data-kid=\"1-3-1-3-1\" data-name=\"workshops icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 border-t-2 border-[#522C81] bg-[#F0EAF7] text-[10px] font-bold text-[#522C81]\" data-kid=\"1-3-1-4\" data-name=\"navigation reviews link\" href=\"#resenas\">\n                <i class=\"ti ti-star text-[18px]\" data-kid=\"1-3-1-4-1\" data-name=\"reviews icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-4-2\" data-name=\"reviews label\">\n                    Reseñas\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#5B6B80]\" data-kid=\"1-3-1-5\" data-name=\"navigation logs link\" href=\"#logs\">\n                <i class=\"ti ti-list-details text-[18px]\" data-kid=\"1-3-1-5-1\" data-name=\"logs icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-5-2\" data-name=\"logs label\">\n                    Logs\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
