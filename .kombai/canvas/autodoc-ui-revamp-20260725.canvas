      </i>\n                </button>\n            </div>\n            <div class=\"mt-4 flex items-center justify-between border-l-4 border-[#EF4444] bg-[#FEF2F2] px-3 py-2.5\" data-kid=\"1-2-1-5\" data-name=\"mobile alert status summary\">\n                <span class=\"text-[10px] font-bold uppercase tracking-[0.13em] text-[#64748B]\" data-kid=\"1-2-1-5-1\" data-name=\"alert status label\">\n                    Estado general\n                </span>\n                <span class=\"text-[13px] font-semibold text-[#B91C1C]\" data-dynamic=\"true\" data-kid=\"1-2-1-5-2\" data-name=\"alert active count text\" data-reason=\"count value updated by data sync script\">\n                    3 alertas activas\n                </span>\n            </div>\n        </div>\n        <div class=\"-mx-4 overflow-x-auto border-y border-[#CBD5E1] bg-white px-4\" data-kid=\"1-2-2\" data-name=\"mobile alert filter navigation\">\n            <div class=\"flex min-w-max items-center gap-5\" data-kid=\"1-2-2-5\">\n                <button class=\"min-h-[52px] border-b-2 border-[#1E88E5] py-3 text-[13px] font-bold text-[#1E88E5]\" data-kid=\"1-2-2-1\" data-name=\"active all alerts filter\">\n                    Todas\n                    <span class=\"ml-1 text-[11px]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1\" data-name=\"all alerts count badge\" data-reason=\"count value updated by data sync script\">\n                        3\n                    </span>\n                </button>\n                <button class=\"min-h-[52px] border-b-2 border-transparent py-3 text-[13px] font-medium text-[#64748B]\" data-kid=\"1-2-2-2\" data-name=\"critical alerts filter\">\n                    Críticas\n                    <span class=\"ml-1 text-[11px]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1\" data-name=\"critical alerts count badge\" data-reason=\"count value updated by data sync script\">\n                        1\n                    </span>\n                </button>\n                <b