    "var_b3068ebd039b": {
      "type": "variant",
      "label": "AutoDoc Auth — Hadrian Dark Mobile",
      "parentId": "var_ab10314ab481",
      "themeId": null,
      "rect": {
        "x": 38480,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"page wrapper\">\n    <main class=\"mx-auto w-full max-w-[430px] px-4 pb-10 pt-4\" data-kid=\"2-1\" data-name=\"main content container\">\n        <header aria-label=\"AutoDoc\" class=\"flex min-h-[52px] items-center justify-between border-b border-[#334155] pb-4\" data-kid=\"2-1-1\" data-name=\"header section\">\n            <div class=\"flex items-center gap-2 [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1\" data-name=\"brand logo and title group\">\n                <div class=\"grid size-9 place-items-center rounded-[10px] bg-[#38BDF8] text-[15px] font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-1-1-1\" data-name=\"brand logo icon\">\n                    AD\n                </div>\n                <div data-kid=\"2-1-1-1-2\" data-name=\"brand name and subtitle group\">\n                    <div class=\"text-[17px] font-extrabold leading-none tracking-[-0.05em]\" data-kid=\"2-1-1-1-2-1\" data-name=\"brand name\">\n                        Auto\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"brand name highlighted suffix\">\n                            Doc\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[9px] font-semibold uppercase tracking-[0.2em] text-[#64748B]\" data-kid=\"2-1-1-1-2-2\" data-name=\"brand subtitle\">\n                        Control vehicular\n                    </div>\n                </div>\n            </div>\n            <button aria-label=\"Cambiar idioma\" class=\"flex min-h-[44px] items-center gap-1 rounded-full border border-[#334155] bg-[#141E36] px-3 text-[11px] font-semibold text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-1-2\" data-name=\"language switcher button\">\n                <span class=\"border border-[#334155] px-2.5 py-1.5 text-[#E2E8F0]\" data-kid=\"2-1-1-2-1\" data-name=\"active language option\">\n                    ES\n                </span>\n                <span data-kid=\"2-1-1-2-2\" data-name=\"language separator\">\n                    /\n                </span>\n                <span data-kid=\"2-1-1-2-3\" data-name=\"inactive language option\">\n                    EN\n                </span>\n            </button>\n        </header>\n        <section aria-label=\"Marca AutoDoc\" class=\"relative mt-5 overflow-hidden border border-[#334155] bg-[#020617]\" data-kid=\"2-1-2\" data-name=\"hero image section\">\n            <img alt=\"Sedán Hyundai en estudio, fotografía de Hyundai Motor Group en Pexels\" class=\"h-[128px] w-full object-cover opacity-40\" data-kid=\"2-1-2-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14696345/pexels-photo-14696345.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n            <div class=\"absolute inset-0 bg-[#020617]/65\" data-kid=\"2-1-2-2\" data-name=\"hero image overlay\">\n            </div>\n            <div class=\"absolute inset-x-4 bottom-4\" data-kid=\"2-1-2-3\" data-name=\"hero content container\">\n                <div class=\"flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#38BDF8]\" data-kid=\"2-1-2-3-1\" data-name=\"hero eyebrow container\">\n                    <span class=\"h-px w-7 bg-[#38BDF8]\" data-kid=\"2-1-2-3-1-1\" data-name=\"hero eyebrow line\">\n                    </span>\n                    Seguridad antes que sorpresa\n                </div>\n                <h1 class=\"mt-2 [font-family:'Plus_Jakarta_Sans',sans-serif] text-[23px] font-extrabold leading-[1.08] tracking-[-0.05em] text-white\" data-kid=\"2-1-2-3-2\" data-name=\"hero main headline\">\n                    Mantenimiento claro.\n                    <br data-kid=\"2-1-2-3-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-3-2-2\" data-name=\"headline highlight text\">\n                        Decisiones seguras.\n                    </span>\n                </h1>\n            </div>\n        </section>\n        <section aria-labelledby=\"auth-heading\" class=\"mt-7 rounded-[16px] border border-[#334155]/20 bg-[#141E36] p-5 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-1-3\" data-name=\"authentication section container\">\n            <div class=\"mb-7\" data-kid=\"2-1-3-1\" data-name=\"section header container\">\n                <div class=\"mb-3 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#38BDF8]\" data-kid=\"2-1-3-1-1\" data-name=\"section eyebrow container\">\n                    <span class=\"size-1.5 rounded-full bg-[#38BDF8]\" data-kid=\"2-1-3-1-1-1\" data-name=\"section eyebrow dot\">\n                    </span>\n                    Acceso seguro\n                </div>\n                <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[29px] font-extrabold leading-tight tracking-[-0.05em] text-[#F8FAFC]\" data-kid=\"2-1-3-1-2\" data-name=\"section title heading\" id=\"auth-heading\">\n                    Bienvenido a AutoDoc\n                </h2>\n                <p class=\"mt-3 text-[14px] leading-6 text-[#94A3B8]\" data-kid=\"2-1-3-1-3\" data-name=\"section description text\">\n                    Accede para ver el estado de tus vehículos y tus servicios.\n                </p>\n            </div>\n            <div class=\"mb-6 flex items-start gap-3 border-l-4 border-[#F87171] bg-[#3F1D25] px-4 py-3.5\" data-kid=\"2-1-3-2\" data-name=\"error alert message container\" role=\"alert\">\n                <i aria-hidden=\"true\" class=\"ti ti-alert-triangle mt-0.5 text-[18px] text-[#FCA5A5]\" data-kid=\"2-1-3-2-1\" data-name=\"error alert icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <div data-kid=\"2-1-3-2-2\" data-name=\"error alert text content\">\n                    <div class=\"text-[13px] font-bold text-[#FCA5A5]\" data-kid=\"2-1-3-2-2-1\" data-name=\"error alert title\">\n                        Revisa tu correo y contraseña\n                    </div>\n                    <div class=\"mt-1 text-[12px] leading-5 text-[#FECACA]\" data-kid=\"2-1-3-2-2-2\" data-name=\"error alert detail text\">\n                        No pudimos validar estas credenciales. Inténtalo de nuevo.\n                    </div>\n                </div>\n            </div>\n            <form aria-label=\"Iniciar sesión\" class=\"space-y-5\" data-kid=\"2-1-3-3\" data-name=\"login form\">\n                <label class=\"block\" data-kid=\"2-1-3-3-1\" data-name=\"email input group\">\n                    <span class=\"mb-2 block text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-3-1-1\" data-name=\"email label\">\n                        Correo electrónico\n                    </span>\n                    <div class=\"flex h-[54px] items-center gap-3 border border-[#38BDF8] bg-[#0F172A] px-4 ring-2 ring-[#38BDF8]/20\" data-kid=\"2-1-3-3-1-2\" data-name=\"email input field container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-mail text-[18px] text-[#38BDF8]\" data-kid=\"2-1-3-3-1-2-1\" data-name=\"email input icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <input aria-label=\"Correo electrónico\" class=\"min-w-0 flex-1 bg-transparent text-[15px] text-[#F8FAFC] outline-hidden placeholder:text-[#64748B]\" data-kid=\"2-1-3-3-1-2-2\" data-name=\"email input field\" type=\"email\" value=\"juan@ejemplo.com\"/>\n                    </div>\n                </label>\n                <label class=\"block\" data-kid=\"2-1-3-3-2\" data-name=\"password input group\">\n                    <span class=\"mb-2 block text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-3-2-1\" data-name=\"password label\">\n                        Contraseña\n                    </span>\n                    <div class=\"flex h-[54px] items-center gap-3 border border-[#475569] bg-[#0F172A] px-4\" data-kid=\"2-1-3-3-2-2\" data-name=\"password input field container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-lock text-[18px] text-[#94A3B8]\" data-kid=\"2-1-3-3-2-2-1\" data-name=\"password input icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <input aria-label=\"Contraseña\" class=\"min-w-0 flex-1 bg-transparent text-[15px] tracking-[0.16em] text-[#F8FAFC] outline-hidden placeholder:text-[#64748B]\" data-kid=\"2-1-3-3-2-2-2\" data-name=\"password input field\" type=\"password\" value=\"autodoc2026\"/>\n                        <button aria-label=\"Mostrar contraseña\" class=\"grid size-12 shrink-0 place-items-center rounded-full border border-[#334155] bg-[#141E36] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:text-[#81E6D9] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-3-3-2-2-3\" data-name=\"toggle password visibility button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-eye text-[18px]\" data-kid=\"2-1-3-3-2-2-3-1\" data-name=\"toggle password icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </label>\n                <div class=\"flex min-h-[48px] items-center justify-between gap-2\" data-kid=\"2-1-3-3-3\" data-name=\"remember me and forgot password row\">\n                    <label class=\"flex min-h-[48px] items-center gap-3 text-[13px] text-[#CBD5E1]\" data-kid=\"2-1-3-3-3-1\" data-name=\"remember me label and checkbox\">\n                        <input aria-label=\"Recordarme\" checked=\"\" class=\"size-5 accent-[#38BDF8]\" data-kid=\"2-1-3-3-3-1-1\" data-name=\"remember me checkbox\" type=\"checkbox\"/>\n                        <span data-kid=\"2-1-3-3-3-1-2\" data-name=\"remember me text\">\n                            Recordarme\n                        </span>\n                    </label>\n                    <button class=\"min-h-[48px] px-1 text-right text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-3-3-2\" data-name=\"forgot password button\" type=\"button\">\n                        ¿Olvidaste tu contraseña?\n                    </button>\n                </div>\n                <button class=\"flex h-[54px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-5 text-[14px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-3-3-4\" data-name=\"login submit button\" type=\"submit\">\n                    <i aria-hidden=\"true\" class=\"ti ti-login-2 text-[18px]\" data-kid=\"2-1-3-3-4-1\" data-name=\"login submit icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Iniciar sesión\n                </button>\n            </form>\n            <div class=\"my-7 flex items-center gap-4\" data-kid=\"2-1-3-4\" data-name=\"divider with text\">\n                <span class=\"h-px flex-1 bg-[#334155]\" data-kid=\"2-1-3-4-1\" data-name=\"left divider line\">\n                </span>\n                <span class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-3-4-2\" data-name=\"divider text\">\n                    o\n                </span>\n                <span class=\"h-px flex-1 bg-[#334155]\" data-kid=\"2-1-3-4-3\" data-name=\"right divider line\">\n                </span>\n            </div>\n            <button class=\"flex h-[54px] w-full items-center justify-center gap-3 rounded-full border border-[#334155] bg-[#141E36] px-5 text-[14px] font-semibold text-[#E2E8F0] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:border-[#81E6D9] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-3-5\" data-name=\"google sign-in button\" type=\"button\">\n                <span class=\"grid size-6 place-items-center rounded-full bg-white text-[14px] font-bold text-[#4285F4]\" data-kid=\"2-1-3-5-1\" data-name=\"google icon container\">\n                    G\n                </span>\n                Continuar con Google\n            </button>\n            <p class=\"mt-8 text-center text-[13px] text-[#94A3B8]\" data-kid=\"2-1-3-6\" data-name=\"registration link paragraph\">\n                ¿No tienes cuenta?\n                <button class=\"font-bold text-[#38BDF8] underline decoration-[#38BDF8]/50 underline-offset-4\" data-kid=\"2-1-3-6-1\" data-name=\"create account link button\" type=\"button\">\n                    Crear cuenta\n                </button>\n            </p>\n            <p class=\"mt-8 text-center text-[11px] leading-5 text-[#64748B]\" data-kid=\"2-1-3-7\" data-name=\"legal footer text\">\n                Al continuar, aceptas los términos de uso y la política de privacidad de AutoDoc.\n            </p>\n        </section>\n        <footer class=\"mt-8 flex items-center justify-between border-t border-[#334155] pt-4 text-[10px] text-[#64748B]\" data-kid=\"2-1-4\" data-name=\"footer section\">\n            <span data-kid=\"2-1-4-1\" data-name=\"footer copyright text\">\n                AutoDoc · Diagnóstico y mantenimiento vehicular\n            </span>\n            <span class=\"flex items-center gap-1.5\" data-kid=\"2-1-4-2\" data-name=\"system status indicator\">\n                <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-4-2-1\" data-name=\"status dot\">\n                </span>\n                Servicio protegido\n            </span>\n        </footer>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-08-17T20:18:08.406101+00:00",
      "modified": "2026-08-17T21:05:31.827376+00:00",
