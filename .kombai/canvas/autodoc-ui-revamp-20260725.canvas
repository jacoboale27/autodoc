ipt\">\n                                <i class=\"ti ti-clock text-[14px]\" data-kid=\"3-4-3-2-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Hace 41 min\n                            </span>\n                            <span class=\"text-right text-[#34D399]\" data-kid=\"3-4-3-2-2-2\" data-name=\"status detail\">\n                                Avisar al cliente\n                            </span>\n                        </div>\n                        <button class=\"mt-3 ml-12 flex min-h-[44px] items-center gap-1 text-[11px] font-semibold text-[#38BDF8]\" data-kid=\"3-4-3-2-3\" data-name=\"view repair button\">\n                            Ver reparación\n                            <i class=\"ti ti-arrow-right text-[13px]\" data-kid=\"3-4-3-2-3-1\" data-name=\"arrow right icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <footer class=\"mt-8 flex flex-col gap-2 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"3-5\" data-name=\"Page footer\">\n            <span data-kid=\"3-5-1\" data-name=\"footer brand text\">\n                AutoDoc · Operación del taller\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"3-5-2\" data-name=\"sync status container\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"3-5-2-1\" data-name=\"online status indicator\">\n                </span>\n                Sincronizado hace 4 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación móvil\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/95 px-2 pb-[max(10px,env(safe-area-inset-bottom))] pt-2 backdrop-blur-sm\" data-kid=\"4\" data-name=\"Fixed mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-5 gap-1\" data-kid=\"4-1\" data-name=\"navigation grid container\">\n            <a aria-label=\"Panel\" class=\"flex min-h-[44px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"4-1-1\" data-name=\"Dashboard navigation link\" href=\"#panel\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"4-1-1-1\" data-name=\"dashboard icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"4-1-1-2\" data-name=\"dashboard label\">\n                    Panel\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Reparaciones\" class=\"flex min-h-[44px] flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] text-[#38BDF8]\" data-kid=\"4-1-2\" data-name=\"Repairs navigation link\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[18px]\" data-kid=\"4-1-2-1\" data-name=\"tools icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"4-1-2-2\" data-name=\"repairs label\">\n                    Reparaciones\n                </span>\n            </a>\n            <a aria-label=\"Buscar vehículo\" class=\"flex min-h-[44px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"4-1-3\" data-name=\"Search navigation link\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[18px]\" data-kid=\"4-1-3-1\" data-name=\"search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"4-1-3-2\" data-name=\"search label\">\n                    Buscar\n                </span>\n            </a>\n            <a aria-label=\"Historial\" class=\"flex min-h-[44px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"4-1-4\" data-name=\"History navigation link\" href=\"#historial\">\n                <i class=\"ti ti-history text-[18px]\" data-kid=\"4-1-4-1\" data-name=\"history icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"4-1-4-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </a>\n            <a aria-label=\"Conversaciones\" class=\"flex min-h-[44px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"4-1-5\" data-name=\"Conversations navigation link\" href=\"#conversaciones\">\n                <i class=\"ti ti-message-circle text-[18px]\" data-kid=\"4-1-5-1\" data-name=\"messages icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"4-1-5-2\" data-name=\"messages label\">\n                    Mensajes\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
