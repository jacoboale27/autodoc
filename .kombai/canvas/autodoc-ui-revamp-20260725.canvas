      "html": "<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .safe-bottom { padding-bottom: max(112px, env(safe-area-inset-bottom)); }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile mechanic reviews page\">\n    <header class=\"sticky top-0 z-20 flex min-h-[64px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"mobile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[16px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"brand mark\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-4\" data-name=\"workshop info container\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2\" data-name=\"role label\">\n                    Taller\n                </p>\n                <p class=\"truncate font-heading text-[14px] font-extrabold text-[#0F172A]\" data-kid=\"2-1-1-3\" data-name=\"workshop name\">\n                    Taller Rápido\n                </p>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header utilities\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"bell icon\">\n                </i>\n                <span class=\"absolute right-[10px] top-[9px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\" data-name=\"notification dot\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-2\" data-name=\"theme toggle button\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-2-2-1\" data-name=\"moon icon\">\n                </i>\n            </button>\n            <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3\" data-name=\"mechanic avatar\">\n                MR\n            </div>\n        </div>\n    </header>\n    <main class=\"safe-bottom px-4 pb-28 pt-5\" data-kid=\"2-2\" data-name=\"mobile reviews content\">\n        <div class=\"mb-5 flex items-start justify-between gap-3\" data-kid=\"2-2-1\" data-name=\"mobile page heading\">\n            <div class=\"min-w-0\" data-kid=\"2-2-1-5\" data-name=\"page header text container\">\n                <div class=\"mb-2 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"breadcrumb\">\n                    <span data-kid=\"2-2-1-1-1\" data-name=\"breadcrumb segment\">\n                        Taller\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-1-2\" data-name=\"breadcrumb separator\">\n                        /\n                    </span>\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-1-3\" data-name=\"active breadcrumb segment\">\n                        Reseñas\n                    </span>\n                </div>\n                <h1 class=\"font-heading text-[26px] font-extrabold leading-tight tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2\" data-name=\"page title\">\n                    Reseñas de clientes\n                </h1>\n                <p class=\"mt-2 text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-3\" data-name=\"page description\">\n                    Escucha lo que tus clientes valoran del servicio.\n                </p>\n            </div>\n            <button aria-label=\"Actualizar datos\" class=\"grid size-11 shrink-0 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[#522C81] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-[#F1F5F9] hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-2-1-4\" data-name=\"refresh data button\">\n                <i class=\"ti ti-refresh text-[17px]\" data-kid=\"2-2-1-4-1\" data-name=\"refresh icon\">\n                </i>\n            </button>\n        </div>\n        <section aria-labelledby=\"rating-heading\" class=\"border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-2\" data-name=\"rating overview band\">\n            <div class=\"px-4 py-5\" data-kid=\"2-2-2-1\" data-name=\"rating overview content\">\n                <div class=\"border-b border-[#E2E8F0] pb-5\" data-kid=\"2-2-2-1-1\" data-name=\"overall rating block\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-2-1-1-1\" data-name=\"overall rating label\">\n                        Valoración general\n                    </p>\n                    <div class=\"mt-2 flex items-end gap-3\" data-kid=\"2-2-2-1-1-2\" data-name=\"numerical rating container\">\n                        <strong class=\"font-heading text-[42px] font-extrabold leading-none tracking-[-0.05em] text-[#0F172A]\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"numerical rating value\" id=\"rating-heading\">\n                            4.8\n                        </strong>\n                        <span class=\"pb-1 text-[16px] font-semibold text-[#64748B]\" data-kid=\"2-2-2-1-1-2-2\" data-name=\"numerical rating total\">\n                            / 5\n                        </span>\n                    </div>\n                    <div class=\"mt-2 flex flex-wrap items-center gap-2 text-[14px] font-semibold text-[#F59E0B]\" data-kid=\"2-2-2-1-1-3\" data-name=\"star rating row\">\n                        <span aria-label=\"4.8 de 5 estrellas\" class=\"flex gap-0.5 text-[17px]\" data-kid=\"2-2-2-1-1-3-1\" data-name=\"star icons container\">\n                            <i class=\"ti ti-star-filled\" data-kid=\"2-2-2-1-1-3-1-1\" data-name=\"star icon 1\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"2-2-2-1-1-3-1-2\" data-name=\"star icon 2\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"2-2-2-1-1-3-1-3\" data-name=\"star icon 3\">\n                            </i>\n                            <i class=\"ti ti-star-filled\" data-kid=\"2-2-2-1-1-3-1-4\" data-name=\"star icon 4\">\n                            </i>\n                            <i class=\"ti ti-star-half-filled\" data-kid=\"2-2-2-1-1-3-1-5\" data-name=\"star icon 5\">\n                            </i>\n                        </span>\n                        <span class=\"text-[#64748B]\" data-kid=\"2-2-2-1-1-3-2\" data-name=\"total reviews count\">\n                            86 reseñas\n                        </span>\n                    </div>\n                </div>\n                <div class=\"space-y-3 pt-5\" data-kid=\"2-2-2-1-2\" data-name=\"rating distribution\">\n                    <div class=\"grid grid-cols-[76px_minmax(0,1fr)_36px] items-center gap-2 text-[11px]\" data-kid=\"2-2-2-1-2-1\" data-name=\"5-star rating distribution row\">\n                        <span class=\"font-semibold text-[#334155]\" data-kid=\"2-2-2-1-2-1-1\" data-nam