an>\n                        </div>\n                        <p class=\"mt-3 text-[14px] leading-6 text-[#334155]\" data-kid=\"2-2-4-3-1-2-3\" data-name=\"review comment\">\n                            La espera fue larga.\n                        </p>\n                        <div class=\"mt-4 flex flex-wrap items-center justify-between gap-3\" data-kid=\"2-2-4-3-1-2-4\" data-name=\"review footer actions\">\n                            <span class=\"text-[11px] font-semibold text-[#F59E0B]\" data-kid=\"2-2-4-3-1-2-4-1\" data-name=\"review status\">\n                                Sin responder\n                            </span>\n                            <button class=\"inline-flex min-h-11 items-center gap-2 border border-[#1E88E5] px-4 py-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-4-3-1-2-4-2\" data-name=\"respond to review button\">\n                                <i class=\"ti ti-message-reply text-[15px]\" data-kid=\"2-2-4-3-1-2-4-2-1\" data-name=\"reply icon\">\n                                </i>\n                                Responder\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </article>\n        </section>\n        <section class=\"mt-6 border-y border-[#CBD5E1] bg-white px-4 py-4\" data-kid=\"2-2-5\" data-name=\"mobile workshop management links\">\n            <p class=\"mb-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-5-1\" data-name=\"management section title\">\n                Gestión\n            </p>\n            <div class=\"grid grid-cols-3 gap-2\" data-kid=\"2-2-5-2\" data-name=\"management links grid\">\n                <a class=\"flex min-h-11 flex-col items-center justify-center gap-1 border border-[#E2E8F0] text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-2-5-2-1\" data-name=\"catalogo link\" href=\"#catalogo\">\n                    <i class=\"ti ti-list-details text-[16px] text-[#1E88E5]\" data-kid=\"2-2-5-2-1-1\" data-name=\"catalogo icon\">\n                    </i>\n                    Catálogo\n                </a>\n                <a class=\"flex min-h-11 flex-col items-center justify-center gap-1 border border-[#E2E8F0] text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-2-5-2-2\" data-name=\"employees link\" href=\"#empleados\">\n                    <i class=\"ti ti-users text-[16px]\" data-kid=\"2-2-5-2-2-1\" data-name=\"employees icon\">\n                    </i>\n                    Empleados\n                </a>\n                <a class=\"flex min-h-11 flex-col items-center justify-center gap-1 border border-[#E2E8F0] text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-2-5-2-3\" data-name=\"configuration link\" href=\"#configuracion\">\n                    <i class=\"ti ti-settings text-[16px]\" data-kid=\"2-2-5-2-3-1\" data-name=\"configuration icon\">\n                    </i>\n                    Configuración\n                </a>\n            </div>\n        </section>\n        <footer class=\"flex flex-col gap-2 pt-5 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-6\" data-name=\"page footer\">\n            <span data-kid=\"2-2-6-1\" data-name=\"review pagination count\">\n                Mostrando 3 de 86 reseñas\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-2-6-2\" data-name=\"synchronization status\">\n                <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-2-6-2-1\" data-name=\"sync status indicator\">\n                </span>\n                Datos sincronizados hace 8 min\n            </span>\n            <span class=\"sr-only\" data-kid=\"2-2-6-3\" data-name=\"admin profile info\">\n                María Rodríguez · Administradora\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal del taller\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-1 pb-[max(8px,env(safe-area-inset-bottom))] pt-2 backdrop-blur\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-5 gap-0\" data-kid=\"2-3-1\" data-name=\"navigation items container\">\n            <a aria-label=\"Panel\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-3-1-1\" data-name=\"dashboard navigation link\" href=\"#panel\">\n                <i class=\"ti ti-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"dashboard icon\">\n                </i>\n                <span data-kid=\"2-3-1-1-2\" data-name=\"dashboard text\">\n                    Panel\n                </span>\n            </a>\n            <a aria-label=\"Reparaciones\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-3-1-2\" data-name=\"repairs navigation link\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"repairs icon\">\n                </i>\n                <span data-kid=\"2-3-1-2-2\" data-name=\"repairs text\">\n                    Reparaciones\n                </span>\n            </a>\n            <a aria-label=\"Buscar vehículo\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-3-1-3\" data-name=\"search navigation link\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"search icon\">\n                </i>\n                <span data-kid=\"2-3-1-3-2\" data-name=\"search text\">\n                    Buscar\n                </span>\n            </a>\n            <a aria-label=\"Historial\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-3-1-4\" data-name=\"history navigation link\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"history icon\">\n                </i>\n                <span data-kid=\"2-3-1-4-2\" data-name=\"history text\">\n                    Historial\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Reseñas\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[10px] font-bold text-[#1E88E5]\" data-kid=\"2-3-1-5\" data-name=\"reviews navigation link\" href=\"#resenas\">\n                <i class=\"ti ti-star-filled text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"reviews icon\">\n                </i>\n                <span data-kid=\"2-3-1-5-2\" data-name=\"reviews text\">\n                    Reseñas\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
