         <div class=\"px-7 py-5\" data-kid=\"2-1-3-2-2-2-3\">\n                            <div class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-3-1\">\n                                Vehículo\n                            </div>\n                            <div class=\"mt-2 text-[16px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-2-2-3-2\">\n                                48,260 km\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-[1.2fr_0.8fr] gap-8 px-7 py-7\" data-kid=\"2-1-3-2-2-3\">\n                        <div data-kid=\"2-1-3-2-2-3-1\">\n                            <div class=\"mb-6 flex items-center justify-between\" data-kid=\"2-1-3-2-2-3-1-1\">\n                                <h3 class=\"text-[17px] font-bold text-white\" data-kid=\"2-1-3-2-2-3-1-1-1\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                                    Progreso de la reserva\n                                </h3>\n                                <span class=\"text-[12px] text-[#FBBF24]\" data-kid=\"2-1-3-2-2-3-1-1-2\">\n                                    1 paso pendiente\n                                </span>\n                            </div>\n                            <ol class=\"relative ml-2 border-l border-[#475569]\" data-kid=\"2-1-3-2-2-3-1-2\">\n                                <li class=\"relative pb-7 pl-7\" data-kid=\"2-1-3-2-2-3-1-2-1\">\n                                    <span class=\"absolute -left-[9px] top-0 flex h-4 w-4 items-center justify-center rounded-full border-2 border-[#34D399] bg-[#0F172A]\" data-kid=\"2-1-3-2-2-3-1-2-1-1\">\n                                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-2-3-1-2-1-1-1\">\n                                        </span>\n                                    </span>\n                                    <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-2-3-1-2-1-2\">\n                                        Solicitud enviada\n                                    </div>\n                                    <div class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-2-3-1-2-1-3\">\n                                        Hoy · 08:12 · La cita fue solicitada al taller.\n                                    </div>\n                                </li>\n                                <li class=\"relative pb-7 pl-7\" data-kid=\"2-1-3-2-2-3-1-2-2\">\n                                    <span class=\"absolute -left-[9px] top-0 flex h-4 w-4 items-center justify-center rounded-full border-2 border-[#38BDF8] bg-[#0F172A]\" data-kid=\"2-1-3-2-2-3-1-2-2-1\">\n                                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#38BDF8]\" data-kid=\"2-1-3-2-2-3-1-2-2-1-1\">\n                                        </span>\n                                    </span>\n                                    <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-2-3-1-2-2-2\">\n                                        Cotización recibida\n                                    </div>\n                                    <div class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-2-3-1-2-2-3\">\n                                        Hoy · 09:36 · El taller compartió el precio y la duración.\n                                    </div>\n                                </li>\n                                <li class=\"relative pl-7\" data-kid=\"2-1-3-2-2-3-1-2-3\">\n                                    <span class=\"absolute -left-[9px] top-0 flex h-4 w-4 items-center justify-center rounded-full border-2 border-[#FBBF24] bg-[#0F172A]\" data-kid=\"2-1-3-2-2-3-1-2-3-1\">\n                                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#FBBF24]\" data-kid=\"2-1-3-2-2-3-1-2-3-1-1\">\n                                        </span>\n                                    </span>\n                                    <div class=\"text-[13px] font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-2-3-1-2-3-2\">\n                                        Pendiente de confirmación\n                                    </div>\n                                    <div class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-3-1-2-3-3\">\n                                        Confirma la fecha para reservar el espacio del taller.\n                                    </div>\n                                </li>\n                            </ol>\n                        </div>\n                        <div class=\"border-l border-[#475569] pl-8\" data-kid=\"2-1-3-2-2-3-2\">\n                            <div class=\"mb-5 flex items-center justify-between\" data-kid=\"2-1-3-2-2-3-2-1\">\n                                <h3 class=\"text-[17px] font-bold text-white\" data-kid=\"2-1-3-2-2-3-2-1-1\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                                    Información\n                                </h3>\n                                <i class=\"ti ti-info-circle text-[18px] text-[#818CF8]\" data-kid=\"2-1-3-2-2-3-2-1-2\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"space-y-5\" data-kid=\"2-1-3-2-2-3-2-2\">\n                                <div data-kid=\"2-1-3-2-2-3-2-2-1\">\n                                    <div class=\"flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-3-2-2-3-2-2-1-1\">\n                                        <i class=\"ti ti-map-pin text-[15px] text-[#38BDF8]\" data-kid=\"2-1-3-2-2-3-2-2-1-1-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Ubicación\n                                    </div>\n                                    <p class=\"mt-2 text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-2-3-2-2-1-2\">\n                                        Carrera 15 # 93-60, Bogotá\n                                    </p>\n                                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-3-2-2-1-3\">\n                                        Taller Rápido · Bahía 2\n                                    </p>\n                                </div>\n                                <div class=\"border-t border-[#334155] pt-5\" data-kid=\"2-1-3-2-2-3-2-2-2\">\n                                    <div class=\"flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-3-2-2-3-2-2-2-1\">\n                                        <i class=\"ti ti-car text-[15px] text-[#38BDF8]\" data-kid=\"2-1-3-2-2-3-2-2-2-1-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Vehículo\n                                    </div>\n                                    <p class=\"mt-2 text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-2-3-2-2-2-2\">\n                                        Toyota Corolla 2022\n                                    </p>\n                                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-3-2-2-2-3\">\n                                        Placa P 482-916 · 48,260 km\n                                    </p>\n                                </div>\n                                <div class=\"border-t border-[#334155] pt-5\" data-kid=\"2-1-3-2-2-3-2-2-3\">\n                                    <div class=\"flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-3-2-2-3-2-2-3-1\">\n                                        <i class=\"ti ti-notes text-[15px] text-[#38BDF8]\" data-kid=\"2-1-3-2-2-3-2-2-3-1-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Notas del cliente\n                                    </div>\n                                    <p class=\"mt-2 text-[13px] leading-5 text-[#CBD5E1]\" data-kid=\"2-1-3-2-2-3-2-2-3-2\">\n                                        Se escucha un chirrido al frenar. Preferencia por atención en la mañana.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-5 border-t border-[#475569] bg-[#172235] px-7 py-5\" data-kid=\"2-1-3-2-2-4\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"2-1-3-2-2-4-1\">\n                            <i class=\"ti ti-shield-check mt-0.5 text-[18px] text-[#34D399]\" data-kid=\"2-1-3-2-2-4-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <div data-kid=\"2-1-3-2-2-4-1-2\">\n                                <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-2-4-1-2-1\">\n                                    El taller espera tu confirmación\n                                </div>\n                                <div class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-4-1-2-2\">\n                                    Puedes rechazar o abrir la conversación si necesitas ajustar la cita.\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-2-4-2\">\n                            <button class=\"flex min-h-[48px] items-center gap-2 rounded-full border border-[#F87171] px-4 text-[12px] font-semibold text-[#FCA5A5] transition duration-150 ease-out hover:bg-[#3F1D25] hover:scale-[1.02] active:scale-[0.97]\" data-kid=\"2-1-3-2-2-4-2-1\" data-name=\"reject reservation button\">\n                                <i class=\"ti ti-x text-[15px]\" data-kid=\"2-1-3-2-2-4-2-1-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Rechazar\n                            </button>\n                            <button class=\"flex min-h-[48px] items-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-4 text-[12px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-3-2-2-4-2-2\" data-name=\"confirm reservation button\">\n                                <i class=\"ti ti-check text-[15px]\" data-kid=\"2-1-3-2-2-4-2-2-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Confirmar reserva\n                            </button>\n                        </div>\n                    </div>\n                </section>\n                <p class=\"mt-7 flex items-center gap-2 text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-3\" data-name=\"sync status text\" data-reason=\"text replaced by sync time refresh script\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-3-1\">\n                    </span>\n                    Datos sincronizados hace 4 min · La confirmación se compartirá automáticamente con Taller Rápido.\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
