      "html": "<link data-kid=\"1\" data-name=\"Google Fonts CSS link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"reservation detail application container\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"primary icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <div class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary rail actions\">\n                <button aria-label=\"Inicio\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"home rail button\">\n                    <i class=\"ti ti-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Mi garaje\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"garage rail button\">\n                    <i class=\"ti ti-car\" data-kid=\"2-1-1-2-2-1\" data-name=\"car icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"workshop rail button\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-3-1\" data-name=\"tool icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Conversaciones\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-4\" data-name=\"chat rail button\">\n                    <i class=\"ti ti-message-circle\" data-kid=\"2-1-1-2-4-1\" data-name=\"message icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Alertas\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-5\" data-name=\"alerts rail button\">\n                    <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-1-2-5-1\" data-name=\"alert icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4 text-[#94A3B8]\" data-kid=\"2-1-1-3\" data-name=\"utility rail actions\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help rail button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings rail button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"owner contextual navigation\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"owner identity header\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"identity label\">\n                    Espacio personal\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"online status indicator\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"status dot\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"owner role text\">\n                        Propietario\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"owner navigation links\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid