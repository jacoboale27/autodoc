      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile repairs board application\">\n    <header class=\"sticky top-0 z-20 border-b border-[#CBD5E1] bg-white/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"compact mobile top bar\">\n        <div class=\"flex min-h-[44px] items-center justify-between gap-3\" data-kid=\"2-1-1\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\">\n                <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[16px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\">\n                    <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-1-2-1\">\n                        Taller\n                    </p>\n                    <p class=\"truncate text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-1-1-1-2-2\">\n                        Reparaciones\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\">\n                <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-full border border-[#CBD5E1]/40 bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-1-2-1\" data-name=\"notifications button\">\n                    <i class=\"ti ti-bell\" data-kid=\"2-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-[9px] top-[9px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-1-2-1-2\">\n                    </span>\n                </button>\n                <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-1-2-2\" data-name=\"theme toggle button\">\n                    <i class=\"ti ti-moon\" data-kid=\"2-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-1-2-3\" data-name=\"workshop initials avatar\">\n                    TR\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-28 pt-6\" data-kid=\"2-2\" data-name=\"repairs page body\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"page heading group\">\n            <p class=\"mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-1-1\">\n                Taller Rápido · Operación activa\n            </p>\n            <h1 class=\"font-heading text-[28px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2\" data-name=\"page headline\">\n                Reparaciones\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-3\" data-name=\"page description\">\n                Sigue cada vehículo desde la recepción hasta la entrega.\n            </p>\n        </div>\n        <button class=\"mb-5 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#47256F] px-4 py-3 text-[13px] font-semibold text-white shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.1)] active:scale-[0.97]\" data-kid=\"2-2-2\" data-name=\"new repair call-to-action button\">\n            <i class=\"ti ti-plus text-[17px]\" data-kid=\"2-2-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            Nueva reparación\n        </button>\n        <section class=\"mb-6 overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] px-3 py-3 shadow-[0_2px_4px_rgba(0,0,0,0.05)]\" data-kid=\"2-2-3\" data-name=\"board filters panel\">\n            <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"2-2-3-1\">\n                <span class=\"text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-2-3-1-1\">\n                    Filtrar\n                </span>\n                <span class=\"text-right text-[11px] text-[#64748B]\" data-kid=\"2-2-3-1-2\">\n                    <strong class=\"font-semibold text-[#0F172A]\" data-dynamic=\"true\" data-kid=\"2-2-3-1-2-1\" data-name=\"active repairs count number\" data-reason=\"number updated by data-fetching script\">\n                        9\n                    </strong>\n                    reparaciones activas\n                </span>\n            </div>\n            <div class=\"grid grid-cols-3 gap-2\" data-kid=\"2-2-3-2\" data-name=\"filter controls\">\n                <button class=\"min-h-[44px] border border-[#1E88E5] bg-[#E8F2FD] px-2 text-[12px] font-semibold text-[#1E88E5]\" data-kid=\"2-2-3-2-1\">\n                    Todas\n                </button>\n                <button class=\"min-h-[44px] border border-[#E2E8F0] bg-white px-2 text-[11px] font-medium text-[#64748B]\" data-kid=\"2-2-3-2-2\">\n                    Alta prioridad\n                </button>\n                <button class=\"min-h-[44px] border border-[#E2E8F0] bg-white px-2 text-[12px] font-medium text-[#64748B]\" data-kid=\"2-2-3-2-3\">\n                    Hoy\n                </button>\n            </div>\n        </section>\n        <section aria-label=\"Tablero de reparaciones\" class=\"space-y-7\" data-kid=\"2-2-4\" data-name=\"stacked mobile repairs board\" id=\"reparaciones\">\n            <section data-kid=\"2-2-4-1\" data-name=\"por revisar column\">\n                <div class=\"mb-3 flex items-center justify-between border-b-2 border-[#CBD5E1] pb-3\" data-kid=\"2-2-4-1-1\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-4-1-1-1\">\n                        <span class=\"size-2 rounded-full bg-[#F59E0B]\" data-kid=\"2-2-4-1-1-1-1\">\n                        </span>\n                        <h2 class=\"font-heading text-[17px] font-bold text-[#0F172A]\" data-kid=\"2-2-4-1-1-1-2\">\n                            Por revisar\n                        </h2>\n                    </div>\n                    <span class=\"tabular-nums text-[12px] font-bold text-[#64748B]\" data-kid=\"2-2-4-1-1-2\">\n                        4\n                    </span>\n                </div>\n                <div class=\"overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] shadow-[0_2px_4px_rgba(0,0,0,0.05)]\" data-kid=\"2-2-4-1-2\" data-name=\"por revisar repair list container\">\n                    <article class=\"border-b border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-4-1-2-1\" data-name=\"Toyota Corolla repair card\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"2-2-4-1-2-1-1\">\n                            <span class=\"mt-0.5 shrink-0 text-[18px] text-[#F59E0B]\" data-kid=\"2-2-4-1-2-1-1-1\">\n                                <i class=\"ti ti-car\" data-kid=\"2-2-4-1-2-1-1-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"2-2-4-1-2-1-1-2\">\n                                <div class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-4-1-2-1-1-2-1\">\n                                    <p class=\"truncate text-[13px] font-bold text-[#0F172A]\" data-kid=\"2-2-4-1-2-1-1-2-1-1\">\n                                        Toyota Corolla\n                                    </p>\n                                    <span class=\"shrink-0 text-[10px] font-bold uppercase tracking-[0.08em] text-[#F59E0B]\" data-kid=\"2-2-4-1-2-1-1-2-1-2\">\n                                        Alta\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[12px] text-[#475569]\" data-kid=\"2-2-4-1-2-1-1-2-2\">\n                                    P 482-916 · Cambio de aceite\n                                </p>\n                                <div class=\"mt-3 flex min-h-[44px] items-center justify-between text-[11px] text-[#64748B]\" data-kid=\"2-2-4-1-2-1-1-2-3\">\n                                    <span data-dynamic=\"true\" data-kid=\"2-2-4-1-2-1-1-2-3-1\" data-name=\"Toyota Corolla repair elapsed time\" data-reason=\"text updated periodically by timer script\">\n                                        Hace 18 min\n                                    </span>\n                                    <button aria-label=\"Abrir Toyota Corolla\" class=\"min-h-[44px] px-2 font-bold text-[#1E88E5]\" data-kid=\"2-2-4-1-2-1-1-2-3-2\">\n                                        Abrir\n                                        <i class=\"ti ti-arrow-up-right ml-1\" data-kid=\"2-2-4-1-2-1-1-2-3-2-1\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"border-b border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-4-1-2-2\" data-name=\"Kia Rio repair card\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"2-2-4-1-2-2-1\">\n                            <span class=\"mt-0.5 shrink-0 text-[18px] text-[#94A3B8]\" data-kid=\"2-2-4-1-2-2-1-1\">\n                                <i class=\"ti ti-car\" data-kid=\"2-2-4-1-2-2-1-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"2-2-4-1-2-2-1-2\">\n                                <div class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-4-1-2-2-1-2-1\">\n                                    <p class=\"truncate text-[13px] font-bold text-[#0F172A]\" data-kid=\"2-2-4-1-2-2-1-2-1-1\">\n                                        Kia Rio\n                                    </p>\n                                    <span class=\"shrink-0 text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-2-4-1-2-2-1-2-1-2\">\n                                        Normal\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[12px] text-[#475569]\" data-kid=\"2-2-4-1-2-2-1-2-2\">\n                                    K 118-442 · Revisión general\n                                </p>\n                                <div class=\"mt-3 flex min-h-[44px] items-center justify-between text-[11px] text-[#64748B]\" data-kid=\"2-2-4-1-2-2-1-2-3\">\n                                    <span data-dynamic=\"true\" data-kid=\"2-2-4-1-2-2-1-2-3-1\" data-name=\"Kia Rio