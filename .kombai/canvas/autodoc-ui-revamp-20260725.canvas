               </div>\n                                            <time class=\"shrink-0 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-1-2-3-1-2-1-2\" data-name=\"record timestamp\">\n                                                17/08/26 · 07:58\n                                            </time>\n                                        </div>\n                                        <p class=\"mt-2 text-[13px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-1-2-3-1-2-2\" data-name=\"record summary\">\n                                            Se aplicó una suspensión administrativa y quedó registro del motivo.\n                                        </p>\n                                        <div class=\"mt-3 flex flex-wrap items-center gap-2\" data-kid=\"1-1-3-2-2-1-2-3-1-2-3\" data-name=\"record tags wrapper\">\n                                            <span class=\"rounded-full bg-[var(--surface-variant)] px-2.5 py-1 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-1-2-3-1-2-3-1\" data-name=\"category tag\">\n                                                <i class=\"ti ti-category text-[12px]\" data-kid=\"1-1-3-2-2-1-2-3-1-2-3-1-1\" data-name=\"category tag icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                USUARIOS\n                                            </span>\n                                            <span class=\"rounded-full bg-[var(--surface-variant)] px-2.5 py-1 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-1-2-3-1-2-3-2\" data-name=\"fingerprint tag\">\n                                                <i class=\"ti ti-fingerprint text-[12px]\" data-kid=\"1-1-3-2-2-1-2-3-1-2-3-2-1\" data-name=\"fingerprint tag icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                usr_91bd…\n                                            </span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </article>\n                            <article class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-4 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-3-2-2-1-2-4\" data-name=\"audit log role change record\">\n                                <div class=\"flex items-start gap-4\" data-kid=\"1-1-3-2-2-1-2-4-1\" data-name=\"record layout container\">\n                                    <div class=\"grid size-11 shrink-0 place-items-center rounded-[12px] bg-[var(--warning-surface)] text-[var(--warning)]\" data-kid=\"1-1-3-2-2-1-2-4-1-1\" data-name=\"record icon wrapper\">\n                                        <i class=\"ti ti-switch-2\" data-kid=\"1-1-3-2-2-1-2-4-1-1-1\" data-name=\"record action icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                    </div>\n                                    <div class=\"min-w-0 flex-1\" data-kid=\"1-1-3-2-2-1-2-4-1-2\" data-name=\"record details block\">\n                                        <div class=\"flex flex-wrap items-start justify-between gap-3\" data-kid=\"1-1-3-2-2-1-2-4-1-2-1\" data-name=\"record header block\">\n                                            <div data-kid=\"1-1-3-2-2-1-2-4-1-2-1-1\" data-name=\"record metadata\">\n                                                <p class=\"text-[13px] font-bold uppercase tracking-[0.08em] text-[var(--warning)]\" data-kid=\"1-1-3-2-2-1-2-4-1-2-1-1-1\" data-name=\"action type label\">\n                                                    CAMBIAR ROL\n                                                </p>\n                                                <p class=\"mt-1 text-[14px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-3-2-2-1-2-4-1-2-1-1-2\" data-name=\"record title\">\n                                                    Cambió el rol de un usuario\n                                                </p>\n                                            </div>\n                                            <time class=\"shrink-0 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-1-2-4-1-2-1-2\" data-name=\"record timestamp\">\n                                                16/08/26 · 17:44\n                                            </time>\n                                        </div>\n                                        <p class=\"mt-2 text-[13px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-1-2-4-1-2-2\" data-name=\"record summary\">\n                                            El perfil pasó de Propietario a Mecánico tras una revisión.\n                                        </p>\n                                        <div class=\"mt-3 flex flex-wrap items-center gap-2\" data-kid=\"1-1-3-2-2-1-2-4-1-2-3\" data-name=\"record tags wrapper\">\n                                            <span class=\"rounded-full bg-[var(--surface-variant)] px-2.5 py-1 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-1-2-4-1-2-3-1\" data-name=\"category tag\">\n                                                <i class=\"ti ti-category text-[12px]\" data-kid=\"1-1-3-2-2-1-2-4-1-2-3-1-1\" data-name=\"category tag icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                USUARIOS\n                                            </span>\n                                            <span class=\"rounded-full bg-[var(--surface-variant)] px-2.5 py-1 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-1-2-4-1-2-3-2\" data-name=\"fingerprint tag\">\n                                                <i class=\"ti ti-fingerprint text-[12px]\" data-kid=\"1-1-3-2-2-1-2-4-1-2-3-2-1\" data-name=\"fingerprint tag icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                                </i>\n                                                usr_4f20…\n                                            </span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </article>\n                        </div>\n                    </section>\n                    <aside class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-5 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-3-2-2-2\" data-name=\"logs filter panel affordance\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-3-2-2-2-1\" data-name=\"filter header\">\n                            <div data-kid=\"1-1-3-2-2-2-1-1\" data-name=\"filter header titles\">\n                                <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--primary)]\" data-kid=\"1-1-3-2-2-2-1-1-1\" data-name=\"filter subtitle\">\n                                    Refinar consulta\n                                </p>\n                                <h2 class=\"mt-1 text-[18px] font-bold\" data-kid=\"1-1-3-2-2-2-1-1-2\" data-name=\"filter title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                                    Filtros\n                                </h2>\n                            </div>\n                            <span class=\"grid size-9 place-items-center rounded-full bg-[#F0EAF7] text-[var(--primary)]\" data-kid=\"1-1-3-2-2-2-1-2\" data-name=\"filter panel icon wrapper\">\n                                <i class=\"ti ti-adjustments-horizontal\" data-kid=\"1-1-3-2-2-2-1-2-1\" data-name=\"filter icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                        </div>\n                        <div class=\"mt-6\" data-kid=\"1-1-3-2-2-2-2\" data-name=\"action filter control\">\n                            <p class=\"mb-3 text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-2-2-1\" data-name=\"action filter label\">\n                                Tipo de acción\n                            </p>\n                            <div class=\"flex flex-wrap gap-2\" data-kid=\"1-1-3-2-2-2-2-2\" data-name=\"filter chip options\">\n                                <button class=\"min-h-[40px] rounded-full bg-[var(--primary)] px-3 text-[11px] font-bold text-white\" data-kid=\"1-1-3-2-2-2-2-2-1\" data-name=\"all filter chip\">\n                                    Todos\n                                </button>\n                                <button class=\"min-h-[40px] rounded-full border border-[var(--outline)] bg-white px-3 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-2-2-2-2\" data-name=\"suspend filter chip\">\n                                    SUSPENDER\n                                </button>\n                                <button class=\"min-h-[40px] rounded-full border border-[var(--outline)] bg-white px-3 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-2-2-2-3\" data-name=\"approve filter chip\">\n                                    APROBAR\n                                </button>\n                                <button class=\"min-h-[40px] rounded-full border border-[var(--outline)] bg-white px-3 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-2-2-2-4\" data-name=\"change filter chip\">\n                                    CAMBIAR\n                                </button>\n                                <button class=\"min-h-[40px] rounded-full border border-[var(--outline)] bg-white px-3 text-[11px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-2-2-2-5\" data-name=\"delete filter chip\">\n                                    ELIMINAR\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"mt-6\" data-kid=\"1-1-3-2-2-2-3\" data-name=\"date filter control\">\n                            <p class=\"mb-3 text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-2-3-1\" data-name=\"date filter label\">\n                                Rango de fechas\n                            </p>\n                            <div class=\"grid grid-cols-2 gap-2\" data-kid=\"1-1-3-2-2-2-3-2\" data-name=\"date picker inputs\">\n                                <button class=\"flex min-h-[48px] items-center gap-2 rounded-[12px] border border-[var(--outline)] bg-white px-3 text-left text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-2-3-2-1\" data-name=\"start date button\">\n                                    <i class=\"ti ti-calendar text-[15px] text-[var(--primary)]\" data-kid=\"1-1-3-2-2-2-3-2-1-1\" data-name=\"calendar icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    Desde\n                                </button>\n                                <button class=\"flex min-h-[48px] items-center gap-2 rounded-[12px] border border-[var(--outline)] bg-white px-3 text-left text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-2-3-2-2\" data-name=\"end date button\">\n                                    <i class=\"ti ti-calendar text-[15px] text-[var(--primary)]\" data-kid=\"1-1-3-2-2-2-3-2-2-1\" data-name=\"calendar icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    Hasta\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"mt-7 flex gap-2 border-t border-[var(--outline)] pt-5\" data-kid=\"1-1-3-2-2-2-4\" data-name=\"filter actions\">\n                            <button class=\"min-h-[48px] flex-1 rounded-full border border-[var(--outline)] bg-white px-3 text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-2-2-4-1\" data-name=\"clear filter button\">\n                                Limpiar\n                            </button>\n                            <button class=\"min-h-[48px] flex-1 rounded-full bg-[var(--primary)] px-3 text-[12px] font-bold text-white shadow-[0_2px_4px_rgba(82,44,129,0.15)]\" data-kid=\"1-1-3-2-2-2-4-2\" data-name=\"apply filter button\">\n                                Aplicar\n                            </button>\n                        </div>\n                    </aside>\n                </div>\n                <p class=\"mt-7 flex items-center gap-2 text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-1-3-2-3\" data-name=\"sync status footer\">\n                    <span class=\"size-1.5 rounded-full bg-[var(--success)]\" data-kid=\"1-1-3-2-3-1\" data-name=\"sync status dot\">\n                    </span>\n                    Datos sincronizados hace 4 min · Registro interno de seguridad\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
