      "rect": {
        "x": 84855,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F7F6F8] text-[#0F172A] antialiased\" data-kid=\"1\" data-name=\"reservation detail mobile page\">\n    <header class=\"sticky top-0 z-30 flex min-h-[64px] items-center justify-between border-b border-[#CBD5E1] bg-[#F7F6F8]/95 px-4 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"reservation detail app bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"back button container\">\n            <button aria-label=\"Volver\" class=\"flex size-11 shrink-0 items-center justify-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-1-1\" data-name=\"back button\">\n                <i class=\"ti ti-arrow-left text-[18px]\" data-kid=\"1-1-1-1-1\" data-name=\"back arrow icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"header titles container\">\n                <p class=\"truncate font-heading text-[16px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"1-1-1-2-1\" data-name=\"page title\">\n                    Detalle de reserva\n                </p>\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#5B6B80]\" data-kid=\"1-1-1-2-2\" data-name=\"page subtitle\">\n                    Reserva de servicio\n                </p>\n            </div>\n        </div>\n        <button aria-label=\"Más opciones\" class=\"flex size-11 shrink-0 items-center justify-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-2\" data-name=\"more options button\">\n            <i class=\"ti ti-dots text-[18px]\" data-kid=\"1-1-2-1\" data-name=\"more options dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n        </button>\n    </header>\n    <main class=\"mx-auto w-full max-w-[520px] px-4 pb-10 pt-5\" data-kid=\"1-2\" data-name=\"scroll safe reservation content\">\n        <div class=\"mb-5\" data-kid=\"1-2-1\" data-name=\"reservation heading\">\n            <p class=\"mb-2 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.22em] text-[#522C81]\" data-kid=\"1-2-1-1\" data-name=\"status indicator\">\n                <span class=\"size-1.5 rounded-full bg-[#522C81]\" data-kid=\"1-2-1-1-1\" data-name=\"status dot icon\">\n                </span>\n                Cita pendiente\n            </p>\n            <h1 class=\"font-heading text-[27px] font-extrabold leading-[1.12] tracking-[-0.05em] text-[#0F172A]\" data-kid=\"1-2-1-2\" data-name=\"page main headline\">\n                Reserva de servicio\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#5B6B80]\" data-kid=\"1-2-1-3\" data-name=\"page description\">\n                Revisa los datos antes de confirmar la visita al taller.\n            </p>\n        </div>\n        <section class=\"overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-2\" data-name=\"reservation summary card\">\n            <div class=\"border-b border-[#CBD5E1] p-4\" data-kid=\"1-2-2-1\" data-name=\"reservation status and service header\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"header layout container\">\n                    <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"1-2-2-1-1-1\" data-name=\"icon and title container\">\n                        <span class=\"flex size-11 shrink-0 items-center justify-center rounded-[12px] bg-[#522C81]/10 text-[#522C81]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"calendar icon container\">\n                            <i class=\"ti ti-calendar-event text-[21px]\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"calendar event icon\" style=\"width:21px;height:21px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <div class=\"min-w-0\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"service details container\">\n                            <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[#C17817]/25 bg-[#C17817]/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.08em] text-[#C17817]\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"pending status badge\">\n                                <i class=\"ti ti-clock-hour-4 text-[12px]\" data-kid=\"1-2-2-1-1-1-2-1-1\" data-name=\"clock icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Pendiente\n                            </span>\n                            <h2 class=\"mt-2 font-heading text-[20px] font-bold leading-tight tracking-[-0.035em] text-[#0F172A]\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"service title\">\n                                Cambio de pastillas\n                            </h2>\n                            <p class=\"mt-1 text-[12px] leading-5 text-[#5B6B80]\" data-kid=\"1-2-2-1-1-1-2-3\" data-name=\"service workshop and vehicle\">\n                                Taller Rápido · Toyota Corolla 2022\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-2 divide-x divide-[#CBD5E1] border-b border-[#CBD5E1]\" data-kid=\"1-2-2-2\" data-name=\"reservation date and time facts\">\n                <div class=\"px-4 py-4\" data-kid=\"1-2-2-2-1\" data-name=\"date facts container\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#5B6B80]\" data-kid=\"1-2-2-2-1-1\" data-name=\"date label\">\n                        Fecha\n                    </p>\n                    <p class=\"mt-2 font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"1-2-2-2-1-2\" data-name=\"date value\">\n                        Mañana\n                    </p>\n                    <p class=\"mt-1 text-[12px] text-[#5B6B80]\" data-kid=\"1-2-2-2-1-3\" data-name=\"date formatted\">\n                        25 jul 2026\n                    </p>\n                </div>\n                <div class=\"px-4 py-4\" data-kid=\"1-2-2-2-2\" data-name=\"time facts container\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#5B6B80]\" data-kid=\"1-2-2-2-2-1\" data-name=\"time label\">\n                        Hora\n                    </p>\n                    <p class=\"mt-2 font-heading text-[15px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"1-2-2-2-2-2\" data-name=\"time value\">\n                        10:00 a. m.\n                    </p>\n                    <p class=\"mt-1 text-[12px] text-[#5B6B80]\" data-kid=\"1-2-2-2-2-3\" data-name=\"time duration\">\n                        Duración · 45 min\n                    </p>\n                </div>\n            </div>\n            <div class=\"p-4\" data-kid=\"1-2-2-3\" data-name=\"reservation vehicle fact\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#5B6B80]\" data-kid=\"1-2-2-3-1\" data-name=\"vehicle label\">\n                    Vehículo\n                </p>\n                <div class=\"mt-2 flex items-center justify-between gap-3\" data-kid=\"1-2-2-3-2\" data-name=\"vehicle details container\">\n                    <p class=\"font-heading text-[16px] font-bold text-[#0F172A]\" data-kid=\"1-2-2-3-2-1\" data-name=\"vehicle plate\">\n                        P 482-916\n                    </p>\n                    <span class=\"inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#5B6B80]\" data-kid=\"1-2-2-3-2-2\" data-name=\"vehicle model\">\n                        <i class=\"ti ti-car text-[15px] text-[#522C81]\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"car icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Toyota Corolla 2022\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-6\" data-kid=\"1-2-3\" data-name=\"owner pending actions\">\n            <div class=\"mb-3 flex items-end justify-between gap-3\" data-kid=\"1-2-3-1\" data-name=\"actions header container\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"actions title container\">\n                    <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em] text-[#0F172A]\" data-kid=\"1-2-3-1-1-1\" data-name=\"actions title\">\n                        Tu respuesta\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#5B6B80]\" data-kid=\"1-2-3-1-1-2\" data-name=\"actions description\">\n                        El taller espera tu confirmación.\n                    </p>\n                </div>\n                <i class=\"ti ti-shield-check text-[18px] text-[#2F855A]\" data-kid=\"1-2-3-1-2\" data-name=\"shield check icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <div class=\"rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] p-4 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-3-2\" data-name=\"buttons container\">\n                <button class=\"flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#45236F] px-5 py-3 text-[13px] font-bold text-white shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-3-2-1\" data-name=\"accept appointment primary button\">\n                    <i class=\"ti ti-check text-[16px]\" data-kid=\"1-2-3-2-1-1\" data-name=\"check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Aceptar cita\n                </button>\n                <button class=\"mt-3 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full border border-[#CBD5E1] bg-[#F7F6F8] px-5 py-3 text-[13px] font-bold text-[#522C81] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-3-2-2\" data-name=\"reschedule appointment secondary button\">\n                    <i class=\"ti ti-edit-calendar text-[16px]\" data-kid=\"1-2-3-2-2-1\" data-name=\"calendar edit icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Reprogramar\n                </button>\n                <button class=\"mt-2 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full px-5 py-3 text-[13px] font-bold text-[#522C81]\" data-kid=\"1-2-3-2-3\" data-name=\"reject appointment text button\">\n                    <i class=\"ti ti-x text-[16px]\" data-kid=\"1-2-3-2-3-1\" data-name=\"x icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Rechazar\n                </button>\n            </div>\n        </section>\n        <aside class=\"mt-5 flex items-start gap-3 rounded-[14px] border border-[#522C81]/20 bg-[#522C81]/[0.06] p-3\" data-kid=\"1-2-4\" data-name=\"mechanic alternative cue\">\n            <i class=\"ti ti-tool mt-0.5 shrink-0 text-[18px] text-[#522C81]\" data-kid=\"1-2-4-1\" data-name=\"tool icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <div class=\"min-w-0\" data-kid=\"1-2-4-2\" data-name=\"mechanic cue text container\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[0.12em] text-[#522C81]\" data-kid=\"1-2-4-2-1\" data-name=\"mechanic view label\">\n                    Vista mecánico\n                </p>\n                <p class=\"mt-1 text-[12px] leading-5 text-[#5B6B80]\" data-kid=\"1-2-4-2-2\" data-name=\"mechanic cue description\">\n                    La acción alternativa para el taller es\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"1-2-4-2-2-1\" data-name=\"highlighted action text\">\n                        Cotizar y Aceptar\n                    </span>\n                    enviando una cotización con esta fecha.\n                </p>\n            </div>\n        </aside>\n        <section class=\"mt-6 rounded-[16px] border border-dashed border-[#CBD5E1] bg-[#F7F6F8] p-4\" data-kid=\"1-2-5\" data-name=\"reservation empty state alternate cue\">\n            <div class=\"flex items-start gap-3\" data-kid=\"1-2-5-1\" data-name=\"empty state container\">\n                <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#E2E8F0] text-[#5B6B80]\" data-kid=\"1-2-5-1-1\" data-name=\"empty state icon container\">\n                    <i class=\"ti ti-calendar-off text-[18px]\" data-kid=\"1-2-5-1-1-1\" data-name=\"calendar off icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <div data-kid=\"1-2-5-1-2\" data-name=\"empty state text container\">\n                    <p class=\"text-[12px] font-bold text-[#0F172A]\" data-kid=\"1-2-5-1-2-1\" data-name=\"empty state title\">\n                        Estado alternativo\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#5B6B80]\" data-kid=\"1-2-5-1-2-2\" data-name=\"empty state description\">\n                        No se encontró esta cita\n                    </p>\n                    <p class=\"text-[11px] leading-4 text-[#5B6B80]\" data-kid=\"1-2-5-1-2-3\" data-name=\"empty state hint\">\n                        Puede que se haya cancelado o eliminado.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <footer class=\"mt-6 border-t border-[#CBD5E1] pt-4 text-[11px] leading-5 text-[#5B6B80]\" data-kid=\"1-2-6\" data-name=\"page footer info\">\n            AutoDoc · Reserva de servicio · Datos sincronizados hace 8 min\n        </footer>\n    </main>\n</div>\n",
