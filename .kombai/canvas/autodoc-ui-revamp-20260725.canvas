      "html": "<link data-kid=\"1\" data-name=\"webfont stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"task completion page\">\n    <header class=\"flex h-[76px] items-center justify-between border-b border-[#334155] bg-[#0B1220] px-8\" data-kid=\"2-1\" data-name=\"completion header\">\n        <div class=\"flex items-center gap-4\" data-kid=\"2-1-1\" data-name=\"brand and back group\">\n            <button aria-label=\"Volver al servicio\" class=\"flex h-10 w-10 items-center justify-center border border-[#475569] text-[#94A3B8] hover:border-[#38BDF8] hover:text-[#F8FAFC]\" data-kid=\"2-1-1-1\" data-name=\"back button\">\n                <i class=\"ti ti-arrow-left text-[18px] text-[#94A3B8]\" data-kid=\"2-1-1-1-1\" data-name=\"back icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <div class=\"flex items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"brand lockup\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-9 w-9 items-center justify-center rounded-[10px] bg-[#38BDF8] text-[15px] font-heading font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-1-2-1\" data-name=\"brand mark\">\n                    AD\n                </div>\n                <div data-kid=\"2-1-1-2-2\" data-name=\"brand text group\">\n                    <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-2-2-1\" data-name=\"brand context\">\n                        Completar servicio\n                    </div>\n                    <div class=\"font-heading text-[14px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-1-2-2-2\" data-name=\"brand name\">\n                        AutoDoc\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-5\" data-kid=\"2-1-2\" data-name=\"header utilities\">\n            <span class=\"hidden text-[12px] text-[#64748B] md:block\" data-dynamic=\"true\" data-kid=\"2-1-2-1\" data-name=\"date text\" data-reason=\"date generated and inserted by client-side script\">\n                Sábado, 25 jul 2026\n            </span>\n            <button aria-label=\"Notificaciones\" class=\"relative flex h-9 w-9 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-2-2\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[17px] text-[#CBD5E1]\" data-kid=\"2-1-2-2-1\" data-name=\"bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-2\" data-name=\"notification dot\">\n                </span>\n            </button>\n            <div class=\"flex items-center gap-2 border-l border-[#334155] pl-5\" data-kid=\"2-1-2-3\" data-name=\"account summary\">\n                <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-3-1\" data-name=\"user initials\">\n                    JP\n                </div>\n                <span class=\"hidden text-[12px] font-semibold text-[#E2E8F0] lg:block\" data-kid=\"2-1-2-3-2\" data-name=\"user name\">\n                    Juan Pérez\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto flex min-h-[724px] max-w-[980px] flex-col px-8 pb-12 pt-10\" data-kid=\"2-2\" data-name=\"completion content\">\n        <nav aria-label=\"Ruta actual\" class=\"flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1\" data-name=\"breadcrumb navigation\">\n            <span data-kid=\"2-2-1-1\" data-name=\"breadcrumb parent\">\n                Taller Rápido\n            </span>\n            <i class=\"ti ti-chevron-right text-[13px] text-[#64748B]\" data-kid=\"2-2-1-2\" data-name=\"breadcrumb separator\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-3\" data-name=\"breadcrumb current\">\n                Confirmación\n            </span>\n        </nav>\n        <section aria-labelledby=\"completion-title\" class=\"mx-auto mt-12 w-full max-w-[760px] text-center\" data-kid=\"2-2-2\" data-name=\"confirmation introduction\">\n            <div aria-label=\"Tarea completada correctamente\" class=\"mx-auto flex h-[72px] w-[72px] items-center justify-center rounded-full border border-[#34D399]/60 bg-[#064E3B] text-[34px] text-[#34D399]\" data-kid=\"2-2-2-1\" data-name=\"accessible completion check\" role=\"img\">\n                <i class=\"ti ti-check text-[34px] text-[#34D399]\" data-kid=\"2-2-2-1-1\" data-name=\"completion check icon\" style=\"width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <p class=\"mt-7 text-[11px] font-bold uppercase tracking-[0.2em] text-[#34D399]\" data-kid=\"2-2-2-2\" data-name=\"success eyebrow\">\n                Servicio validado\n            </p>\n            <h1 class=\"mt-3 font-heading text-[36px] font-extrabold tracking-[-0.05em] text-[#F8FAFC]\" data-kid=\"2-2-2-3\" data-name=\"completion title\" id=\"completion-title\">\n                Tarea completada\n            </h1>\n            <p class=\"mx-auto mt-3 max-w-[560px] text-[16px] leading-7 text-[#94A3B8]\" data-kid=\"2-2-2-4\" data-name=\"completion description\">\n                El mantenimiento de tu vehículo quedó registrado.\n            </p>\n        </section>\n        <section aria-labelledby=\"service-summary-title\" class=\"mx-auto mt-10 w-full max-w-[860px] overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-3\" data-name=\"completed service summary card\">\n            <div class=\"flex items-start justify-between gap-6 border-b border-[#334155] px-7 py-6\" data-kid=\"2-2-3-1\" data-name=\"summary header\">\n                <div class=\"flex items-start gap-4\" data-kid=\"2-2-3-1-1\" data-name=\"summary identity\">\n                    <div aria-hidden=\"true\" class=\"flex h-11 w-11 items-center justify-center border border-[#38BDF8]/60 bg-[#082F49] text-[20px] text-[#38BDF8]\" data-kid=\"2-2-3-1-1-1\" data-name=\"vehicle icon wrapper\">\n                        <i class=\"ti ti-car text-[20px] text-[#38BDF8]\" data-kid=\"2-2-3-1-1-1-1\" data-name=\"vehicle icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div data-kid=\"2-2-3-1-1-4\" data-name=\"vehicle detail wrapper\">\n                        <h2 class=\"font-heading text-[19px] font-bold tracking-[-0.025em] text-[#F8FAFC]\" data-kid=\"2-2-3-1-1-2\" data-name=\"vehicle title\" id=\"service-summary-title\">\n                            Toyota Corolla 2022\n                        </h2>\n                        <p class=\"mt-1 text-[12px] font-semibold tracking-[0.16em] text-[#94A3B8]\" data-kid=\"2-2-3-1-1-3\" data-name=\"vehicle plate\">\n                            P 482-916\n                        </p>\n                    </div>\n                </div>\n                <span class=\"flex items-center gap-2 border border-[#34D399]/50 bg-[#064E3B]/40 px-3 py-2 text-[11px] font-bold text-[#6EE7B7]\" data-kid=\"2-2-3-1-2\" data-name=\"completed status badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-3-1-2-1\" data-name=\"completed status dot\">\n                    </span>\n                    Registrado\n                </span>\n            </div>\n            <div class=\"grid grid-cols-3 divide-x divide-[#334155]\" data-kid=\"2-2-3-2\" data-name=\"service metadata row\">\n                <div class=\"px-7 py-6\" data-kid=\"2-2-3-2-1\" data-name=\"service metadata item\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-3-2-1-1\" data-name=\"service label\">\n                        Servicio\n                    </p>\n                    <p class=\"mt-2 text-[15px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-1-2\" data-name=\"service value\">\n                        Cambio de aceite\n                    </p>\n                </div>\n                <div class=\"px-7 py-6\" data-kid=\"2-2-3-2-2\" data-name=\"mileage metadata item\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-3-2-2-1\" data-name=\"mileage label\">\n                        Kilometraje\n                    </p>\n                    <p class=\"mt-2 text-[18px] font-bold tabular-nums text-[#38BDF8]\" data-kid=\"2-2-3-2-2-2\" data-name=\"mileage value\">\n                        48,260\n                        <span class=\"text-[12px] font-medium text-[#94A3B8]\" data-kid=\"2-2-3-2-2-2-1\" data-name=\"mileage unit label\">\n                            km\n                        </span>\n                    </p>\n                </div>\n                <div class=\"px-7 py-6\" data-kid=\"2-2-3-2-3\" data-name=\"date metadata item\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-3-2-3-1\" data-name=\"service date label\">\n                        Fecha\n                    </p>\n                    <p class=\"mt-2 text-[15px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-3-2\" data-name=\"service date value\">\n                        12 jun 2026\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Próximo mantenimiento recomendado\" class=\"mx-auto mt-5 flex w-full max-w-[860px] items-center justify-between gap-6 border-l-4 border-[#38BDF8] bg-[#17263A] px-6 py-5\" data-kid=\"2-2-4\" data-name=\"next reminder callout\">\n            <div class=\"flex items-start gap-3\" data-kid=\"2-2-4-1\" data-name=\"reminder content\">\n                <i class=\"ti ti-calendar-due text-[20px] text-[#38BDF8]\" data-kid=\"2-2-4-1-1\" data-name=\"reminder icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <div data-kid=\"2-2-4-1-4\" data-name=\"reminder text wrapper\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[#7DD3FC]\" data-kid=\"2-2-4-1-2\" data-name=\"reminder label\">\n                        Siguiente recordatorio\n                    </p>\n                    <p class=\"mt-1 text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-4-1-3\" data-name=\"reminder value\">\n                        Revisión en\n                        <span class=\"tabular-nums text-[#F8FAFC]\" data-kid=\"2-2-4-1-3-1\" data-name=\"reminder distance\">\n                            10,000 km\n                        </span>\n                    </p>\n                </div>\n            </div>\n            <span class=\"hidden text-[12px] text-[#94A3B8] sm:block\" data-kid=\"2-2-4-2\" data-name=\"reminder context\">\n                Te avisaremos antes de que llegue el momento.\n            </span>\n        </section>\n        <div class=\"mx-auto mt-7 flex w-full max-w-[860px] items-center justify-between gap-5\" data-kid=\"2-2-5\" data-name=\"synchronization and actions\">\n            <div aria-live=\"polite\" class=\"flex items-center gap-2 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-5-1\" data-name=\"sync status\" role=\"status\">\n                <i class=\"ti ti-cloud-check text-[16px] text-[#34D399]\" data-kid=\"2-2-5-1-1\" data-name=\"sync icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Datos guardados y sincronizados\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"2-2-5-2\" data-name=\"completion actions\">\n                <button aria-label=\"Ver historial del vehículo\" class=\"flex min-h-[48px] items-center gap-2 border border-[#475569] px-4 py-3 text-[13px] font-semibold text-[#CBD5E1] hover:border-[#38BDF8] hover:text-[#F8FAFC]\" data-kid=\"2-2-5-2-1\" data-name=\"view history button\">\n                    <i class=\"ti ti-history text-[16px] text-[#94A3B8]\" data-kid=\"2-2-5-2-1-1\" data-name=\"history icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Ver historial\n                </button>\n                <button aria-label=\"Volver al dashboard principal\" class=\"flex min-h-[48px] items-center gap-2 bg-[#38BDF8] px-5 py-3 text-[13px] font-bold text-[#082F49] hover:bg-[#7DD3FC]\" data-kid=\"2-2-5-2-2\" data-name=\"back dashboard button\">\n                    Volver al dashboard\n                    <i class=\"ti ti-arrow-up-right text-[16px] text-[#082F49]\" data-kid=\"2-2-5-2-2-1\" data-name=\"dashboard arrow icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <footer class=\"mt-auto border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"completion footer\">\n            AutoDoc · Historial de mantenimiento vehicular · Registro confirmado\n        </footer>\n    </main>\n</div>\n",
