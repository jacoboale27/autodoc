    "var_06125bc4e46b": {
      "type": "variant",
      "label": "AutoDoc Admin Workshops — Hadrian Light Mobile",
      "parentId": "var_eb14862cb54c",
      "themeId": null,
      "rect": {
        "x": 120100,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .touch { min-height: 48px; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"admin dashboard main page wrapper\" style=\"--surface:#F7F6F8;--surface-container:#EEEDF0;--surface-variant:#E2E8F0;--outline:#CBD5E1;--primary:#522C81;--secondary:#81E6D9;--text-primary:#0F172A;--text-secondary:#5B6B80;--success:#2F855A;--warning:#B45309;--error:#C2414B;--success-surface:#ECFDF5;--warning-surface:#FFFBEB;--error-surface:#FFF1F2;\">\n    <header class=\"sticky top-0 z-30 flex min-h-[68px] items-center justify-between border-b border-[var(--outline)] bg-[var(--surface)]/95 px-4 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"admin workshops mobile header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <div aria-label=\"AutoDoc administración\" class=\"grid size-11 shrink-0 place-items-center rounded-[12px] bg-[var(--primary)] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-white shadow-[0_2px_4px_rgba(15,23,42,0.12)]\" data-kid=\"1-1-1-1\" data-name=\"application initials logo badge\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"header titles container\">\n                <p class=\"truncate text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--text-secondary)]\" data-kid=\"1-1-1-2-1\" data-name=\"header breadcrumb or context label\">\n                    Administración\n                </p>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"1-1-1-2-2\" data-name=\"active status indicator group\">\n                    <span class=\"truncate font-heading text-[15px] font-bold tracking-[-0.03em]\" data-kid=\"1-1-1-2-2-1\" data-name=\"current view title text\">\n                        Gestionar talleres\n                    </span>\n                    <span class=\"size-1.5 shrink-0 rounded-full bg-[var(--success)]\" data-kid=\"1-1-1-2-2-2\" data-name=\"live status dot\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-1-2\" data-name=\"header action buttons container\">\n            <button aria-label=\"Notificaciones\" class=\"touch flex min-w-[48px] items-center justify-center rounded-full border border-[var(--outline)] bg-[var(--surface-container)] text-[var(--text-secondary)] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[18px]\" data-kid=\"1-1-2-1-1\" data-name=\"bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2\" data-name=\"notifications unread badge container\" data-reason=\"badge count injected/updated by script\">\n                </span>\n            </button>\n            <button aria-label=\"Perfil de Superadmin\" class=\"touch flex min-w-[48px] items-center justify-center rounded-full bg-[#E7DDF2] text-[12px] font-bold text-[var(--primary)]\" data-kid=\"1-1-2-2\" data-name=\"user profile button\">\n                SA\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[480px] px-4 pb-[calc(112px+env(safe-area-inset-bottom))] pt-5\" data-kid=\"1-2\" data-name=\"scroll-safe workshops content\">\n        <div class=\"mb-5 flex items-end justify-between gap-3\" data-kid=\"1-2-1\" data-name=\"page header layout\">\n            <div class=\"min-w-0\" data-kid=\"1-2-1-1\" data-name=\"page breadcrumbs and titles container\">\n                <div class=\"mb-2 flex items-center gap-2 text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-1-1-1\" data-name=\"page navigation breadcrumbs\">\n                    <span data-kid=\"1-2-1-1-1-1\" data-name=\"breadcrumbs start text\">\n                        Admin\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"1-2-1-1-1-2\" data-name=\"breadcrumbs separator icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-semibold text-[var(--text-primary)]\" data-kid=\"1-2-1-1-1-3\" data-name=\"breadcrumbs end text\">\n                        Talleres\n                    </span>\n                </div>\n                <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--primary)]\" data-kid=\"1-2-1-1-2\" data-name=\"category label\">\n                    Gestión de red\n                </p>\n                <h1 class=\"font-heading text-[27px] font-extrabold leading-tight tracking-[-0.045em]\" data-kid=\"1-2-1-1-3\" data-name=\"main page title\">\n                    Gestionar talleres\n                </h1>\n                <p class=\"mt-2 text-[14px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-2-1-1-4\" data-name=\"page description text\">\n                    Administra mecánicos, solicitudes formales y estados de operación.\n                </p>\n            </div>\n            <button aria-label=\"Exportar CSV\" class=\"touch flex min-w-[48px] shrink-0 items-center justify-center rounded-full bg-[var(--primary)] text-white shadow-[0_4px_10px_rgba(82,44,129,0.18)]\" data-kid=\"1-2-1-2\" data-name=\"export csv button\">\n                <i class=\"ti ti-download text-[18px]\" data-kid=\"1-2-1-2-1\" data-name=\"download icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n        <section class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-3 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-2\" data-name=\"search and filters panel\">\n            <div class=\"flex min-h-[52px] items-center gap-3 rounded-[12px] border border-[var(--outline)] bg-[var(--surface)] px-3\" data-kid=\"1-2-2-1\" data-name=\"search input simulation container\">\n                <i class=\"ti ti-search shrink-0 text-[19px] text-[var(--text-secondary)]\" data-kid=\"1-2-2-1-1\" data-name=\"search icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"min-w-0 truncate text-[13px] text-[var(--text-secondary)]\" data-kid=\"1-2-2-1-2\" data-name=\"search placeholder text\">\n                    Buscar taller / mecánico...\n                </span>\n            </div>\n            <button class=\"touch mt-3 flex w-full items-center justify-between rounded-full border border-[var(--outline)] bg-[var(--surface)] px-4 text-[13px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-2-2-2\" data-name=\"filter toggle button\">\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1\" data-name=\"filter button label container\">\n                    <i class=\"ti ti-adjustments-horizontal text-[17px] text-[var(--primary)]\" data-kid=\"1-2-2-2-1-1\" data-name=\"filters icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Filtros\n                </span>\n                <i class=\"ti ti-chevron-down text-[16px] text-[var(--text-secondary)]\" data-kid=\"1-2-2-2-2\" data-name=\"dropdown chevro