      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#E2E8F0] [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"Mobile workshop settings application\">\n    <header class=\"sticky top-0 z-20 flex h-[72px] items-center justify-between border-b border-[#334155] bg-[#0B1220]/95 px-4 backdrop-blur\" data-kid=\"2-1\" data-name=\"Mobile settings top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"Mobile brand and context group\">\n            <div aria-label=\"AutoDoc\" class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[18px] font-extrabold tracking-[-0.08em] text-[#082F49] shadow-[0_8px_24px_rgba(56,189,248,0.18)] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"Mobile context text\">\n                <div class=\"truncate text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"Workshop label text\">\n                    Taller\n                </div>\n                <div class=\"flex items-center gap-2 [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-2-2\" data-name=\"Status container\">\n                    <span class=\"truncate text-[15px] font-extrabold tracking-[-0.04em] text-[#F8FAFC]\" data-kid=\"2-1-1-2-2-1\" data-name=\"Page title text\">\n                        Configuración\n                    </span>\n                    <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-2-2-2\" data-name=\"Online status indicator dot\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-1\" data-kid=\"2-1-2\" data-name=\"Mobile utility controls\">\n            <button aria-label=\"Notificaciones\" class=\"relative flex h-11 w-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-2-1\" data-name=\"Notification button\">\n                <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-2-1-1\" data-name=\"Notification bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-1-2\" data-name=\"Notification badge indicator\">\n                </span>\n            </button>\n            <button aria-label=\"Perfil de Taller Rápido\" class=\"flex h-11 w-11 items-center justify-center\" data-kid=\"2-1-2-2\" data-name=\"Account avatar button\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-2-2-1\" data-name=\"Account user initials\">\n                    TR\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[560px] px-4 pb-[112px] pt-6\" data-kid=\"2-2\" data-name=\"Mobile settings content\">\n        <div class=\"mb-7\" data-kid=\"2-2-1\" data-name=\"Mobile form heading\">\n            <div class=\"mb-3 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"Mobile breadcrumb\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"Breadcrumb parent label\">\n                    Taller\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-2-1-1-2\" data-name=\"Chevron separator icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-2-1-1-3\" data-name=\"Breadcrumb current page\">\n                    Configuración\n                </span>\n            </div>\n            <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[27px] font-extrabold leading-tight tracking-[-0.04em] text-[#F8FAFC]\" data-kid=\"2-2-1-2\" data-name=\"Form page title\">\n                Configuración del taller\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-3\" data-name=\"Form description\">\n                Mantén actualizados los datos que tus clientes ven antes de reservar.\n            </p>\n            <div class=\"mt-5 space-y-3\" data-kid=\"2-2-1-4\" data-name=\"Mobile form actions\">\n                <div class=\"flex items-center gap-2 text-[12px] text-[#FBBF24]\" data-kid=\"2-2-1-4-1\" data-name=\"Pending changes indicator\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#FBBF24]\" data-kid=\"2-2-1-4-1-1\" data-name=\"Pending changes indicator dot\">\n                    </span>\n                    Cambios sin guardar\n                </div>\n                <button class=\"flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-4 py-3 text-[12px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-2-1-4-2\" data-name=\"save changes call-to-action button\">\n                    <i class=\"ti ti-device-floppy text-[16px]\" data-kid=\"2-2-1-4-2-1\" data-name=\"Floppy disk icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Guardar cambios\n                </button>\n            </div>\n        </div>\n        <div class=\"space-y-7\" data-kid=\"2-2-2\" data-name=\"Stacked mobile settings sections\">\n            <section aria-labelledby=\"public-info-heading-mobile\" class=\"border-y border-[#475569]\" data-kid=\"2-2-2-1\" data-name=\"Public information section\">\n                <div class=\"flex items-start justify-between gap-4 border-b border-[#334155] py-5\" data-kid=\"2-2-2-1-1\" data-name=\"Public info header\">\n                    <div data-kid=\"2-2-2-1-1-1\" data-name=\"Public info header text group\">\n                        <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"Public information section title\" id=\"public-info-heading-mobile\">\n                            Información pública\n                        </h2>\n                        <p class=\"mt-1 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"Public information section description\">\n                            Estos datos aparecen en el directorio de talleres.\n                        </p>\n                    </div>\n                    <i class=\"ti ti-building-store shrink-0 text-[19px] text-[#38BDF8]\" data-kid=\"2-2-2-1-1-2\" data-name=\"Building store icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n                <div class=\"space-y-5 py-6\" data-kid=\"2-2-2-1-2\" data-name=\"Public info mobile input stack\">\n                    <label class=\"block\" data-kid=\"2-2-2-1-2-1\" data-name=\"Workshop name field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"Workshop name field label\">\n                            Nombre del taller\n                        </span>\n                        <div class=\"flex h-12 items-center border border-[#475569] bg-[#1E293B] 