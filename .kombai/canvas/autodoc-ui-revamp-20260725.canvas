      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  :root {\n    --surface: #0F172A;\n    --surface-container: #141E36;\n    --surface-variant: #1E293B;\n    --outline: #334155;\n    --outline-strong: #475569;\n    --primary: #81E6D9;\n    --secondary: #522C81;\n    --on-primary: #0F172A;\n    --text-primary: #F8FAFC;\n    --text-secondary: #94A3B8;\n    --muted: #64748B;\n    --success: #34D399;\n    --warning: #FBBF24;\n    --error: #F87171;\n    --error-surface: #3F1D25;\n    --warning-surface: #422006;\n    --success-surface: #064E3B;\n  }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .icon { width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center; }\n</style>\n<div class=\"font-body min-h-screen bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"admin reviews application shell\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[var(--outline)] bg-[#020617] py-6\" data-kid=\"1-1-1\" data-name=\"admin icon rail\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"1-1-1-1\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[var(--primary)] text-[18px] font-extrabold tracking-[-0.08em] text-[var(--on-primary)] shadow-[0_8px_24px_rgba(129,230,217,0.14)] font-heading\" data-kid=\"1-1-1-1-1\">\n                    AD\n                </div>\n                <nav aria-label=\"Navegación principal\" class=\"flex flex-col items-center gap-5 text-[var(--muted)]\" data-kid=\"1-1-1-1-2\">\n                    <button aria-label=\"Resumen\" class=\"flex h-11 w-11 items-center justify-center rounded-full text-[19px] hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-1-2-1\">\n                        <i class=\"ti ti-layout-dashboard icon\" data-kid=\"1-1-1-1-2-1-1\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Usuarios\" class=\"flex h-11 w-11 items-center justify-center rounded-full text-[19px] hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-1-2-2\">\n                        <i class=\"ti ti-users icon\" data-kid=\"1-1-1-1-2-2-1\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex h-11 w-11 items-center justify-center rounded-full text-[19px] hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-1-2-3\">\n                        <i class=\"ti ti-building-store icon\" data-kid=\"1-1-1-1-2-3-1\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Reseñas\" class=\"flex h-11 w-11 items-center justify-center rounded-full border-l-2 border-[var(--primary)] bg-[var(--surface-variant)] text-[19px] text-[var(--primary)]\" data-kid=\"1-1-1-1-2-4\">\n                        <i class=\"ti ti-star icon\" data-kid=\"1-1-1-1-2-4-1\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Logs\" class=\"flex h-11 w-11 items-center justify-center rounded-full text-[19px] hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-1-2-5\">\n                        <i class=\"ti ti-list-details icon\" data-kid=\"1-1-1-1-2-5-1\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Seed\" class=\"flex h-11 w-11 items-center justify-center rounded-full text-[19px] hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-1-2-6\">\n                        <i class=\"ti ti-database-cog icon\" data-kid=\"1-1-1-1-2-6-1\">\n                        </i>\n                    </button>\n                </nav>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 border-t border-[var(--outline)] pt-5 text-[var(--muted)]\" data-kid=\"1-1-1-2\">\n                <button aria-label=\"Configuración\" class=\"flex h-11 w-11 items-center justify-center rounded-full hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-2-1\">\n                    <i class=\"ti ti-settings icon\" data-kid=\"1-1-1-2-1-1\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-11 w-11 items-center justify-center rounded-full hover:bg-[var(--surface-variant)] hover:text-[var(--primary)]\" data-kid=\"1-1-1-2-2\">\n                    <i class=\"ti ti-help-circle icon\" data-kid=\"1-1-1-2-2-1\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[var(--outline)] bg-[#0B1220]\" data-kid=\"1-1-2\" data-name=\"admin contextual sidebar\">\n            <div class=\"border-b border-[var(--outline)] px-6 py-7\" data-kid=\"1-1-2-1\">\n                <div class=\"text-[12px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-1-2-1-1\">\n                    Administración\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 font-heading\" data-kid=\"1-1-2-1-2\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em]\" data-kid=\"1-1-2-1-2-1\">\n                        Auto\n                        <span class=\"text-[var(--primary)]\" data-kid=\"1-1-2-1-2-1-1\">\n                            Doc\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 rounde