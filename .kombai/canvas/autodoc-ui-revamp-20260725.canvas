ge\">\n                                        <i class=\"ti ti-circle-check text-[15px]\" data-kid=\"2-1-3-2-3-1-2-1-4-6-1\" data-name=\"check icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Completado\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-3 border-t border-dashed border-[#334155] px-3 py-5 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-2-1-5\" data-name=\"table end status row\">\n                                    <i class=\"ti ti-history-toggle text-[17px]\" data-kid=\"2-1-3-2-3-1-2-1-5-1\" data-name=\"history toggle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <span data-kid=\"2-1-3-2-3-1-2-1-5-2\" data-name=\"no more records message\">\n                                        No hay más registros en este periodo.\n                                    </span>\n                                    <button class=\"ml-auto text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-3-1-2-1-5-3\" data-name=\"change period button\">\n                                        Cambiar periodo\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                    <aside class=\"rounded-[16px] border border-[#334155]/20 bg-[#141E36] p-7 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-1-3-2-3-2\" data-name=\"annual history summary container\">\n                        <div class=\"mb-5\" data-kid=\"2-1-3-2-3-2-1\" data-name=\"summary section header\">\n                            <h2 class=\"text-[18px] font-bold tracking-[-0.02em] text-white\" data-kid=\"2-1-3-2-3-2-1-1\" data-name=\"annual summary title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                                Resumen anual\n                            </h2>\n                            <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-2-1-2\" data-name=\"summary subheadline\">\n                                Toyota Corolla 2022 · últimos 12 meses\n                            </p>\n                        </div>\n                        <div class=\"border-y border-[#475569]\" data-kid=\"2-1-3-2-3-2-2\" data-name=\"summary statistics\">\n                            <div class=\"border-b border-[#334155] py-5\" data-kid=\"2-1-3-2-3-2-2-1\" data-name=\"total maintenance block\">\n                                <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2-1-1\" data-name=\"total label\">\n                                    Total mantenimiento\n                                </div>\n                                <div class=\"mt-1 text-[28px] font-extrabold tabular-nums text-[#38BDF8]\" data-kid=\"2-1-3-2-3-2-2-1-2\" data-name=\"total amount\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                                    $684.50\n                                </div>\n                                <div class=\"mt-1 text-[11px] text-[#34D399]\" data-kid=\"2-1-3-2-3-2-2-1-3\" data-name=\"service count indicator\">\n                                    <i class=\"ti ti-trending-up text-[13px]\" data-kid=\"2-1-3-2-3-2-2-1-3-1\" data-name=\"trending up icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    7 servicios registrados\n                                </div>\n                            </div>\n                            <div class=\"border-b border-[#334155] py-5\" data-kid=\"2-1-3-2-3-2-2-2\" data-name=\"average per service block\">\n                                <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2-2-1\" data-name=\"average label\">\n                                    Promedio por servicio\n                                </div>\n                                <div class=\"mt-1 text-[18px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-1-3-2-3-2-2-2-2\" data-name=\"average amount\">\n                                    $97.79\n                                </div>\n                            </div>\n                            <div class=\"py-5\" data-kid=\"2-1-3-2-3-2-2-3\" data-name=\"next tracking block\">\n                                <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2-3-1\" data-name=\"next tracking label\">\n                                    Próximo seguimiento\n                                </div>\n                                <div class=\"mt-1 flex items-center gap-2 text-[13px] font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-3-2-2-3-2\" data-name=\"next tracking alert\">\n                                    <i class=\"ti ti-alert-triangle text-[15px]\" data-kid=\"2-1-3-2-3-2-2-3-2-1\" data-name=\"alert icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    Pastillas en 420 km\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"mt-6 flex items-center gap-2 text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-3-2-3\" data-name=\"view vehicle alerts button\">\n                            Ver alertas del vehículo\n                            <i class=\"ti ti-arrow-up-right text-[14px]\" data-kid=\"2-1-3-2-3-2-3-1\" data-name=\"arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </aside>\n                </div>\n                <footer class=\"flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-4\" data-name=\"footer bar\">\n                    <span data-kid=\"2-1-3-2-4-1\" data-name=\"footer copyright notice\">\n                        AutoDoc · Historial y trazabilidad del mantenimiento\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-4-2\" data-name=\"sync status indicator\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-4-2-1\" data-name=\"sync indicator dot\">\n                        </span>\n                        Datos sincronizados hace 4 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
