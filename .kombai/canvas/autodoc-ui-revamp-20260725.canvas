      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    :root { --app-primary:#81E6D9; --app-on-primary:#0F172A; --app-surface-container:#141E36; --app-outline:#334155; --app-shadow-sm:0 2px 4px rgba(0,0,0,.2); --app-shadow-hover:0 6px 14px rgba(0,0,0,.35); }\n  button { min-height:48px; border-radius:999px; transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  button[aria-label] { min-width:44px; min-height:44px; background:var(--app-surface-container); border:1px solid rgba(51,65,85,.35); border-radius:999px; box-shadow:var(--app-shadow-sm); }\n  button:not([aria-label])[class*=\"bg-[#38BDF8]\"] { min-height:48px; border-radius:999px; background:linear-gradient(135deg,#81E6D9,#6FC8BC); color:#0F172A; box-shadow:var(--app-shadow-sm); }\n  button:not([aria-label])[class*=\"bg-[#38BDF8]\"]:hover, button:not([aria-label])[class*=\"bg-[#38BDF8]\"]:focus-visible { transform:scale(1.02); box-shadow:var(--app-shadow-hover); }\n  button:not([aria-label])[class*=\"border\"] { background:var(--app-surface-container); border-color:rgba(51,65,85,.5); box-shadow:var(--app-shadow-sm); }\n  button:active { transform:scale(.97); }\n  button[aria-label][class*=\"bg-[#1E293B]\"] { background:#1E293B; border-color:#38BDF8; color:#38BDF8; }\n  [data-name=\"operations scoreboard\"], [data-name=\"revenue chart panel\"], [data-name=\"active repairs queue\"], [data-name=\"column items list\"], [aria-label=\"Búsqueda de vehículo\"], [data-name=\"vehicle results table\"], [data-name=\"selected vehicle detail panel\"], [data-name=\"Services table section\"], [data-name=\"service catalog table\"], [data-name=\"Controls bar\"] { border-radius:16px; border:1px solid rgba(51,65,85,.35); background:var(--app-surface-container); box-shadow:var(--app-shadow-sm); overflow:hidden; }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\">\n</script>\n<div class=\"min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"mechanic dashboard root\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"mechanic application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"mechanic icon rail\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\" data-name=\"rail primary group\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1-1\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-1-2\" data-name=\"rail main navigation\">\n                    <button aria-label=\"Panel del taller\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-1\">\n                        <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Reparaciones\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-2\">\n                        <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Buscar vehículo\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-3\">\n                        <i class=\"ti ti-search text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Chat\" class=\"relative flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-4\">\n                        <i class=\"ti ti-message-2 text-[19px]\" data-kid=\"2-1-1-1-2-4-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-1-2-4-2\">\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\" data-name=\"rail utility navigation\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-1\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-2\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\" data-name=\"mechanic contextual sidebar\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\" data-name=\"workshop identity header\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\">\n                    Taller\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-2-1-2\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-2-1-2-1\">\n                        Taller\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\">\n                            Rápido\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-2-1-2-2\">\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación del taller\" class=\"flex-1 px-4 py-6\" data-kid=\"2-1-2-2\" data-name=\"mechanic navigation list\">\n                <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-1\">\n                    Operación\n                </div>\n                <div class=\"space-y-1\" data-kid=\"2-1-2-2-2\">\n                    <a class=\"flex items-center gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-3 py-3 text-[13px] font-semibold text-white\" data-kid=\"2-1-2-2-2-1\" href=\"#panel\">\n                        <i class=\"ti ti-layout-dashboard text-[17px] text-[#38BDF8]\" data-kid=\"2-1-2-2-2-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Panel\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-2\" href=\"#reparaciones\">\n                        <i class=\"ti ti-tool text-[17px]\" data-kid=\"2-1-2-2-2-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Reparaciones\n                        <span class=\"ml-auto rounded-[4px] bg-[#7F1D1D] px-1.5 py-0.5 text-[10px] font-bold text-[#FCA5A5]\" data-kid=\"2-1-2-2-2-2-2\">\n                            07\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-3\" href=\"#buscar\">\n                        <i class=\"ti ti-search text-[17px]\" data-kid=\"2-1-2-2-2-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Buscar vehículo\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-4\" href=\"#historial\">\n                        <i class=\"ti ti-history text-[17px]\" data-kid=\"2-1-2-2-2-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Historial\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-5\" href=\"#resenas\">\n                        <i class=\"ti ti-star text-[17px] text-[#FBBF24]\" data-kid=\"2-1-2-2-2-5-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Reseñas\n                        <span class=\"ml-auto text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-1-2-2-2-5-2\">\n                            4.8\n                        </span>\n                    </a>\n                </div>\n                <div class=\"mt-10 border-t border-[#334155] pt-7\" data-kid=\"2-1-2-2-3\" data-name=\"quick workshop links\">\n                    <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-3-1\">\n                        Acceso rápido\n                    </div>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-2\" href=\"#catalogo\">\n                        <i class=\"ti ti-list-details text-[17px] text-[#818CF8]\" data-kid=\"2-1-2-2-3-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Catálogo\n                    </a>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-3\" href=\"#empleados\">\n                        <i class=\"ti ti-users text-[17px]\" data-kid=\"2-1-2-2-3-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Empleados\n                    </a>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-4\" href=\"#configuracion\">\n                        <i class=\"ti ti-settings text-[17px]\" data-kid=\"2-1-2-2-3-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Configuración\n                    </a>\n                </div>\n            </nav>\n            <div class=\"border-t border-[#334155] px-5 py-5\" data-kid=\"2-1-2-3\" data-name=\"mechanic account footer\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-3-1-1\">\n                        TR\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\">\n                        <div class=\"truncate text-[12px] font-semibold text-white\" data-kid=\"2-1-2-3-1-2-1\">\n                            Taller Rápido\n                        </div>\n                        <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\">\n                            Plan profesional\n                        </div>\n                    </div>\n                    <i class=\"ti ti-dots ml-auto text-[16px] text-[#64748B]\" data-kid=\"2-1-2-3-1-3\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[#0F172A]\" data-kid=\"2-1-3\" data-name=\"mechanic dashboard content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#334155] px-8\" data-kid=\"2-1-3-1\" data-name=\"mechanic top bar\">\n                <div class=\"flex items-center gap-3 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-1-1\">\n                    <span data-kid=\"2-1-3-1-1-1\">\n                        Taller\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-1-3-1-1-2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-1-1-3\">\n                        Panel\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-6\" data-kid=\"2-1-3-1-2\">\n                    <div class=\"text-right\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1\" data-name=\"date and time display\" data-reason=\"text updated to reflect current date and time by script\">\n                        <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-1-2-1-1\">\n                            Sábado, 25 jul 2026\n                        </div>\n                        <div class=\"mt-0.5 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-1-2-1-2\">\n                            08:42 a. m.\n                        </div>\n                    </div>\n                    <div class=\"h-5 w-px bg-[#334155]\" data-kid=\"2-1-3-1-2-2\">\n                    </div>\n                    <button aria-label=\"Cambiar tema\" class=\"flex h-9 w-9 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-3-1-2-3\">\n                        <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-3-1-2-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex h-9 w-9 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-3-1-2-4\">\n                        <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-3-1-2-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-3-1-2-4-2\">\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-3 border-l border-[#334155] pl-5\" data-kid=\"2-1-3-1-2-5\">\n                        <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-1-2-5-1\">\n                            TR\n                        </div>\n                        <div class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-1-2-5-2\">\n                            Taller Rápido\n                        </div>\n                        <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-1-3-1-2-5-3\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                </div>\n            </header>\n            <div class=\"px-8 pb-12 pt-8\" data-kid=\"2-1-3-2\" data-name=\"mechanic dashboard body\">\n                <div class=\"mb-7 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"mechanic dashboard heading\">\n                    <div data-kid=\"2-1-3-2-1-1\">\n                        <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[30px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-1-3-2-1-1-1\">\n                            Panel del taller\n                        </h1>\n                        <p class=\"mt-2 text-[14px] text-[#94A3B8]\" data-kid=\"2-1-3-2-1-1-2\">\n                            Una vista clara de las reparaciones que mueven tu día.\n                        </p>\n                    </div>\n                    <button class=\"flex items-center gap-2 bg-[#38BDF8] px-4 py-2.5 text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-2-1-2\">\n                        <i class=\"ti ti-plus text-[15px]\" data-kid=\"2-1-3-2-1-2-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Nueva reparación\n                    </button>\n         