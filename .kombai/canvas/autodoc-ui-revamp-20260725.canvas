    "var_ad6f9bf479fc": {
      "type": "variant",
      "label": "AutoDoc Profile Setup — Hadrian Light Mobile",
      "parentId": "var_f0cb0c8de5de",
      "themeId": null,
      "rect": {
        "x": 107115,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#F7F6F8] text-[#0F172A] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"profile setup mobile page\">\n    <header class=\"sticky top-0 z-20 flex min-h-[64px] items-center justify-between border-b border-[#CBD5E1] bg-[#F7F6F8]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"AutoDoc header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"brand header group\">\n            <div class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[#522C81] text-white shadow-[0_2px_4px_rgba(15,23,42,0.08)]\" data-kid=\"2-1-1-1\" data-name=\"brand icon container\">\n                <i class=\"ti ti-car text-[20px]\" data-kid=\"2-1-1-1-1\" data-name=\"brand car icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <span class=\"truncate [font-family:'Plus_Jakarta_Sans',sans-serif] text-[17px] font-extrabold tracking-[-0.04em] text-[#0F172A]\" data-kid=\"2-1-1-2\" data-name=\"brand title\">\n                AutoDoc\n            </span>\n        </div>\n        <button aria-label=\"Salir\" class=\"flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-1-2\" data-name=\"logout button\">\n            <i class=\"ti ti-logout text-[18px]\" data-kid=\"2-1-2-1\" data-name=\"logout icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n        </button>\n    </header>\n    <main class=\"mx-auto w-full max-w-[520px] px-4 pb-[148px] pt-5\" data-kid=\"2-2\" data-name=\"scroll-safe setup content\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"welcome heading group\">\n            <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.22em] text-[#522C81]\" data-kid=\"2-2-1-1\" data-name=\"setup eyebrow\">\n                TU ESPACIO PERSONAL\n            </p>\n            <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[27px] font-extrabold leading-[1.12] tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2\" data-name=\"welcome title\">\n                ¡Bienvenido a AutoDoc!\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#5B6B80]\" data-kid=\"2-2-1-3\" data-name=\"setup description\">\n                Configura tu perfil para obtener diagnósticos personalizados y alertas precisas para tu vehículo.\n            </p>\n        </div>\n        <section class=\"rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] p-4 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-2-2\" data-name=\"profile setup form card\">\n            <div class=\"flex items-center gap-4 border-b border-[#CBD5E1] pb-5\" data-kid=\"2-2-2-1\" data-name=\"profile photo row\">\n                <div class=\"relative flex size-[88px] shrink-0 items-center justify-center rounded-full border-[3px] border-[#522C81]/60 bg-[#522C81]/10 text-[#522C81]\" data-kid=\"2-2-2-1-1\" data-name=\"profile photo placeholder\">\n                    <i class=\"ti ti-user text-[42px]\" data-kid=\"2-2-2-1-1-1\" data-name=\"profile placeholder icon\" style=\"width:42px;height:42px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <button aria-label=\"Elegir foto de perfil\" class=\"absolute -bottom-1 -right-1 flex size-11 items-center justify-center rounded-full border-2 border-[#EEEDF0] bg-[#522C81] text-white shadow-[0_4px_10px_rgba(15,23,42,0.16)]\" data-kid=\"2-2-2-1-1-2\" data-name=\"profile camera button\">\n                        <i class=\"ti ti-camera text-[18px]\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"camera icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-2-2-1-2\" data-name=\"photo instruction\">\n                    <p class=\"text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-2-2-1-2-1\" data-name=\"photo instruction title\">\n                        Foto de perfil\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-4 text-[#5B6B80]\" data-kid=\"2-2-2-1-2-2\" data-name=\"photo instruction description\">\n                        Añade una imagen para personalizar tu perfil.\n                    </p>\n                </div>\n            </div>\n            <div class=\"pt-5\" data-kid=\"2-2-2-2\" data-name=\"name field group\">\n                <label class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#5B6B80]\" data-kid=\"2-2-2-2-1\" data-name=\"full name label\">\n                    NOMBRE COMPLETO\n                </label>\n                <div class=\"mt-2 flex min-h-[52px] items-center gap-3 rounded-[14px] border border-[#CBD5E1] bg-[#F7F6F8] px-4\" data-kid=\"2-2-2-2-2\" data-name=\"full name input field\">\n                    <i class=\"ti ti-user text-[19px] text-[#5B6B80]\" data-kid=\"2-2-2-2-2-1\" data-name=\"name field icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"text-[15px] text-[#5B6B80]\" data-kid=\"2-2-2-2-2-2\" data-name=\"name placeholder text\">\n                        Ej. Juan Pérez\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-6\" data-kid=\"2-2-2-3\" data-name=\"role selection group\">\n                <p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#5B6B80]\" data-kid=\"2-2-2-3-1\" data-name=\"role selection label\">\n                    SELECCIONA TU ROL\n                </p>\n                <div class=\"mt-3 grid grid-cols-2 gap-3\" data-kid=\"2-2-2-3-2\" data-name=\"role choice cards container\">\n                    <button aria-pressed=\"true\" class=\"flex min-h-[106px] flex-col items-start justify-between rounded-[16px] border-2 border-[#522C81] bg-[#522C81]/10 p-3 text-left\" data-kid=\"2-2-2-3-2-1\" data-name=\"selected owner role button\">\n                        <span class=\"flex size-9 items-center justify-center rounded-full bg-[#522C81] text-white\" data-kid=\"2-2-2-3-2-1-1\" data-name=\"owner role icon container\">\n                            <i class=\"ti ti-check text-[18px]\" data-kid=\"2-2-2-3-2-1-1-1\" data-name=\"check icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <span class=\"text-[13px] font-bold text-[#0F172A]\" data-kid=\"2-2-2-3-2-1-2\" data-name=\"owner role label\">\n                            Propietario\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"flex min-h-[106px] flex-col items-start justify-between rounded-[16px] border border-[#CBD5E1] bg-[#F7F6F8] p-3 text-left\" data-kid=\"2-2-2-3-2-2\" data-name=\"mechanic role button\">\n                        <span class=\"flex size-9 items-center justify-center rounded-full bg-[#E2E8F0] text-[#5B6B80]\" data-kid=\"2-2-2-3-2-2-1\" data-name=\"mechanic role icon container\">\n                            <i class=\"ti ti-tool text-[18px]\" data-kid=\"2-2-2-3-2-2-1-1\" data-name=\"tool icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <span class=\"text-[13px] font-semibold text-[#5B6B80]\" data-kid=\"2-2-2-3-2-2-2\" data-name=\"mechanic role label\">\n                            Mecánico\n                        </span>\n                    </button>\n                </div>\n                <div class=\"mt-3 flex items-start gap-3 rounded-[14px] border border-[#522C81]/25 bg-[#522C81]/[0.08] p-3\" data-kid=\"2-2-2-3-3\" data-name=\"owner role explanation card\">\n                    <i class=\"ti ti-info-circle mt-0.5 shrink-0 text-[18px] text-[#522C81]\" data-kid=\"2-2-2-3-3-1\" data-name=\"role info icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <p class=\"text-[12px] leading-5 text-[#0F172A]\" data-kid=\"2-2-2-3-3-2\" data-name=\"owner role explanation text\">\n                        Como propietario, podrás agregar vehículos a tu garaje virtual y dar seguimiento a sus mantenimientos.\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-6\" data-kid=\"2-2-2-4\" data-name=\"preferences group\">\n                <p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#5B6B80]\" data-kid=\"2-2-2-4-1\" data-name=\"preferences label\">\n                    PREFERENCIAS\n                </p>\n                <div class=\"mt-3 flex items-center gap-3 rounded-[16px] border border-[#CBD5E1] bg-[#F7F6F8] p-3\" data-kid=\"2-2-2-4-2\" data-name=\"maintenance notifications preference row\">\n                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#522C81]/10 text-[#522C81]\" data-kid=\"2-2-2-4-2-1\" data-name=\"notifications icon container\">\n                        <i class=\"ti ti-bell-ringing text-[20px]\" data-kid=\"2-2-2-4-2-1-1\" data-name=\"notifications icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-2-4-2-2\" data-name=\"notifications copy group\">\n                        <p class=\"text-[13px] font-bold leading-4 text-[#0F172A]\" data-kid=\"2-2-2-4-2-2-1\" data-name=\"notifications title\">\n                            Notificaciones de mantenimiento\n                        </p>\n                        <p class=\"mt-1 text-[11px] leading-4 text-[#5B6B80]\" data-kid=\"2-2-2-4-2-2-2\" data-name=\"notifications description\">\n                            Alertas sobre cambios de aceite, frenos y revisiones.\n                        </p>\n                    </div>\n                    <span class=\"relative inline-flex h-7 w-12 shrink-0 rounded-full bg-[#522C81]\" data-kid=\"2-2-2-4-2-3\" data-name=\"notifications switch enabled\">\n                        <span class=\"absolute right-1 top-1 size-5 rounded-full bg-white shadow-sm\" data-kid=\"2-2-2-4-2-3-1\" data-name=\"notifications switch thumb\">\n                        </span>\n                    </span>\n                </div>\n            </div>\n        </section>\n    </main>\n    <div class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-[#F7F6F8]/95 px-4 pb-[calc(16px+env(safe-area-inset-bottom))] pt-3 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"sticky final action area\">\n        <button class=\"flex min-h-[52px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#45236F] px-5 py-3 text-[13px] font-bold text-white shadow-[0_6px_14px_rgba(82,44,129,0.18)]\" data-kid=\"2-3-1\" data-name=\"finish profile setup button\">\n            Finalizar Configuración\n            <i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"2-3-1-1\" data-name=\"finish arrow icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n        </button>\n    </div>\n</div>\n",
