      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler icon webfont stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style>\n    [data-name=\"new conversation button\"], [data-name=\"conversation menu button\"], [data-name=\"attach file button\"], [data-name=\"emoji button\"] { min-width:44px !important; min-height:44px !important; border-radius:999px !important; background:#EEEDF0 !important; border:1px solid #CBD5E1 !important; box-shadow:0 1px 2px rgba(15,23,42,0.05); transition:transform 150ms ease-out, background 150ms ease-out, box-shadow 150ms ease-out; }\n  [data-name=\"new conversation button\"]:hover, [data-name=\"conversation menu button\"]:hover, [data-name=\"attach file button\"]:hover, [data-name=\"emoji button\"]:hover { transform:scale(1.02); background:#F8FAFC !important; box-shadow:0 6px 14px rgba(15,23,42,0.12); }\n  [data-name=\"new conversation button\"]:active, [data-name=\"conversation menu button\"]:active, [data-name=\"attach file button\"]:active, [data-name=\"emoji button\"]:active { transform:scale(0.97); }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile chat application shell\">\n    <header class=\"sticky top-0 z-30 flex h-16 items-center justify-between border-b border-[#CBD5E1] bg-white/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile application top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and screen context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[16px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc mobile logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"screen context text\">\n                <p class=\"truncate text-[10px] font-semibold uppercase tracking-[0.13em] text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"role label\">\n                    Propietario\n                </p>\n                <h1 class=\"truncate font-heading text-[16px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-1-1-2-2\" data-name=\"screen title\">\n                    Conversaciones\n                </h1>\n            </div>\n        </div>\n        <button aria-label=\"Nueva conversación\" class=\"grid size-11 shrink-0 place-items-center border border-[#CBD5E1] text-[18px] text-[#1E88E5]\" data-kid=\"2-1-2\" data-name=\"new conversation button\">\n            <i class=\"ti ti-edit\" data-kid=\"2-1-2-1\" data-name=\"edit icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n            </i>\n        </button>\n    </header>\n    <main class=\"px-4 pb-[118px] pt-4\" data-kid=\"2-2\" data-name=\"mobile conversation content\">\n        <div class=\"mb-4 flex items-center justify-between gap-3\" data-kid=\"2-2-1\" data-name=\"conversation navigation row\">\n            <button aria-label=\"Volver a conversaciones\" class=\"flex min-h-11 items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-1-1\" data-name=\"back to conversations button\">\n                <i class=\"ti ti-chevron-left\" data-kid=\"2-2-1-1-1\" data-name=\"back chevron icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                </i>\n                Conversaciones\n            </button>\n            <button aria-label=\"Más opciones de conversación\" class=\"grid size-11 place-items-center border border-[#CBD5E1] bg-white text-[18px] text-[#64748B]\" data-kid=\"2-2-1-2\" data-name=\"conversation menu button\">\n                <i class=\"ti ti-dots\" data-kid=\"2-2-1-2-1\" data-name=\"dots menu icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n            </button>\n        </div>\n        <section class=\"rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] px-4 py-4 shadow-[0_1px_2px_rgba(15,23,42,0.04)]\" data-kid=\"2-2-2\" data-name=\"active conversation identity card\">\n            <div class=\"flex items-start gap-3\" data-kid=\"2-2-2-1\" data-name=\"active conversation header\">\n                <span class=\"grid size-11 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-2-1-1\" data-name=\"workshop initials avatar\">\n                    TR\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"2-2-2-1-2\" data-name=\"active conversation details\">\n                    <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"2-2-2-1-2-1\" data-name=\"workshop identity row\">\n                        <h2 class=\"truncate font-heading text-[18px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"workshop name\">\n                            Taller Rápido\n                        </h2>\n                        <span class=\"flex items-center gap-1.5 text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-2-2-1-2-1-2\" data-name=\"online status\">\n                            <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-2-2-1-2-1-2-1\" data-name=\"online status dot\">\n                            </span>\n                            En línea\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-2-1-2-2\" data-name=\"vehicle context\">\n                        Toyota Corolla 2022 · P 482-916\n                    </p>\n                </div>\n            </div>\n            <button class=\"mt-4 flex min-h-11 w-full items-center justify-center gap-2 border border-[#CBD5E1] bg-white px-3 text-[12px] font-semibold text-[#1E88E5]\" data-kid=\"2-2-2-2\" data-name=\"view vehicle button\">\n                <i class=\"ti ti-car\" data-kid=\"2-2-2-2-1\" data-name=\"car icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                </i>\n                Ver vehículo\n            </button>\n        </section>\n        <section aria-label=\"Mensajes de Taller Rápido\" class=\"mt-6\" data-kid=\"2-2-3\" data-name=\"message history\">\n            <div class=\"mb-6 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.14em] text-[#94A3B8]\" data-kid=\"2-2-3-1\" data-name=\"message date divider\">\n                <span class=\"h-px flex-1 bg-[#E2E8F0]\" data-kid=\"2-2-3-1-1\">\n                </span>\n                <span class=\"shrink-0\" data-kid=\"2-2-3-1-2\">\n                    Hoy · 15 jul 2026\n                </span>\n                <span class=\"h-px flex-1 bg-[#E2E8F0]\" data-kid=\"2-2-3-1-3\">\n                </span>\n            </div>\n            <div class=\"space-y-6\" data-kid=\"2-2-3-2\" data-name=\"message groups\">\n                <div class=\"flex items-end gap-2.5\" data-kid=\"2-2-3-2-1\" data-name=\"workshop message group\">\n                    <span class=\"grid size-8 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[10px] font-bold text-[#1E88E5]\" data-kid=\"2-2-3-2-1-1\" data-name=\"workshop message avatar\">\n                        TR\n                    </span>\n                    <div class=\"min-w-0 max-w-[calc(100%-42px)]\" data-kid=\"2-2-3-2-1-2\" data-name=\"workshop message content\">\n                        <p class=\"mb-1.5 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-2-3-2-1-2-1\" data-name=\"workshop message metadata\">\n                            Taller Rápido · 09:36\n                        </p>\n                        <div class=\"border border-[#CBD5E1] bg-white px-4 py-3.5 text-[14px] leading-6 text-[#0F172A] shadow-[0_1px_2px_rgba(15,23,42,0.03)]\" data-kid=\"2-2-3-2-1-2-2\" data-name=\"workshop message bubble\">\n                            Hola Juan, revisamos el Corolla y encontramos desgaste en las pastillas.\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex justify-end\" data-kid=\"2-2-3-2-2\" data-name=\"owner message group\">\n                    <div class=\"max-w-[86%]\" data-kid=\"2-2-3-2-2-1\" data-name=\"owner message content\">\n                        <p class=\"mb-1.5 text-right text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-2-3-2-2-1-1\" data-name=\"owner message metadata\">\n                            Tú · 09:38\n                        </p>\n                        <div class=\"border border-[#BFDBFE] bg-[#DBEAFE] px-4 py-3.5 text-[14px] leading-6 text-[#0F172A]\" data-kid=\"2-2-3-2-2-1-2\" data-name=\"owner message bubble\">\n                            ¿Cuánto tardaría el cambio?\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex items-end gap-2.5\" data-kid=\"2-2-3-2-3\" data-name=\"workshop reply and quote group\">\n                    <span class=\"grid size-8 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[10px] font-bold text-[#1E88E5]\" data-kid=\"2-2-3-2-3-1\" data-name=\"workshop reply avatar\">\n                        TR\n                    </span>\n                    <div class=\"min-w-0 max-w-[calc(100%-42px)]\" data-kid=\"2-2-3-2-3-2\" data-name=\"workshop reply content\">\n                        <p class=\"mb-1.5 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-2-3-2-3-2-1\" data-name=\"workshop reply metadata\">\n                            Taller Rápido · 09:40\n                        </p>\n                        <div class=\"border border-[#CBD5E1] bg-white px-4 py-3.5 text-[14px] leading-6 text-[#0F172A]\" data-kid=\"2-2-3-2-3-2-2\" data-name=\"workshop reply bubble\">\n                            Aproximadamente 45 minutos. Te comparto la cotización.\n                        </div>\n                        <div class=\"mt-3 border-l-4 border-[#1E88E5] bg-white px-4 py-4 shadow-[0_1px_2px_rgba(15,23,42,0.04)]\" data-kid=\"2-2-3-2-3-3\" data-name=\"service quote card\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-2-3-3-1\" data-name=\"quote card header\">\n                                <div class=\"min-w-0\" data-kid=\"2-2-3-2-3-3-1-1\" data-name=\"quote title group\">\n                                    <div class=\"flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.12em] text-[#1E88E5]\" data-kid=\"2-2-3-2-3-3-1-1-1\" data-name=\"quote type label\">\n                                        <i class=\"ti ti-file-invoice\" data-kid=\"2-2-3-2-3-3-1-1-1-1\" data-name=\"file invoice icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                                        </i>\n                                        <span data-kid=\"2-2-3-2-3-3-1-1-1-2\">\n                                            Cotización de servicio\n                                        </span>\n                                    </div>\n                                    <h3 class=\"mt-2 font-heading text-[16px] font-bold text-[#0F172A]\" data-kid=\"2-2-3-2-3-3-1-1-2\" data-name=\"quote title\">\n                                        Cambio de pastillas\n                                    </h3>\n                                </div>\n                                <span class=\"shrink-0 border border-[#FDE68A] bg-[#FFFBEB] px-2 py-1 text-[10px] font-bold text-[#92400E]\" data-kid=\"2-2-3-2-3-3-1-2\" data-name=\"quote status badge\">\n                                    Pendiente\n                                </span>\n                            </div>\n                            <div class=\"mt-4 flex flex-wrap items-end justify-between gap-3 border-t border-[#E2E8F0] pt-3\" data-kid=\"2-2-3-2-3-3-2\" data-name=\"quote details and action\">\n                                <div class=\"flex items-center gap-4 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-2-3-3-2-1\" data-name=\"quote price and duration\">\n                                    <span data-kid=\"2-2-3-2-3-3-2-1-1\">\n                                        <strong class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-3-2-3-3-2-1-1-1\">\n                                            $180.00\n                                        </strong>\n                                    </span>\n                                    <span data-kid=\"2-2-3-2-3-3-2-1-2\">\n                                        45 min\n                                    </span>\n                                </div>\n                                <button class=\"flex min-h-11 items-center gap-2 border border-[#1E88E5] px-3 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-3-2-3-3-2-2\" data-name=\"view reservation button\">\n                                    Ver reserva\n                                    <i class=\"ti ti-arrow-up-right\" data-kid=\"2-2-3-2-3-3-2-2-1\" data-name=\"arrow up right icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                                    </i>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex justify-end\" data-kid=\"2-2-3-2-4\" data-name=\"owner acknowledgement message\">\n                    <div class=\"max-w-[86%]\" data-kid=\"2-2-3-2-4-1\" data-name=\"owner acknowledgement content\">\n                        <p class=\"mb-1.5 text-right text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-2-3-2-4-1-1\" data-name=\"acknowledgement metadata\">\n                            Tú · 09:42\n                        </p>\n                        <div class=\"border border-[#BFDBFE] bg-[#DBEAFE] px-4 py-3.5 text-[14px] leading-6 text-[#0F172A]\" data-kid=\"2-2-3-2-4-1-2\" data-name=\"acknowledgement message bubble\">\n                            Perfecto, la reviso y te confirmo en un momento.\n                        </div>\n                        <p class=\"mt-1.5 text-right text-[10px] font-medium text-[#10B981]\" data-kid=\"2-2-3-2-4-1-3\" data-name=\"delivery status\">\n                            Entregado\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <footer class=\"sticky bottom-[76px] z-10 mt-6 border-t border-[#CBD5E1] bg-[#F8FAFC]/95 py-3 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"mobile message composer footer\">\n            <div data-kid=\"2-3-1\" data-name=\"message composer container\">\n                <div class=\"flex items-center gap-1.5 border border-[#CBD5E1] bg-white p-1.5\" data-kid=\"2-3-1-1\" data-name=\"message composer input shell\">\n                    <button aria-label=\"Adjuntar archivo\" class=\"grid size-11 shrink-0 place-items-center text-[18px] text-[#64748B]\" data-kid=\"2-3-1-1-1\" data-name=\"attach file button\">\n                        <i class=\"ti ti-paperclip\" data-kid=\"2-3-1-1-1-1\" data-name=\"paperclip icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Añadir emoji\" class=\"grid size-11 shrink-0 place-items-center text-[18px] text-[#64748B]\" data-kid=\"2-3-1-1-2\" data-name=\"emoji button\">\n                        <i class=\"ti ti-mood-smile\" data-kid=\"2-3-1-1-2-1\" data-name=\"smiley face icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                        </i>\n                    </button>\n                    <div aria-label=\"Escribe un mensaje\" class=\"min-w-0 flex-1 px-1 text-[14px] text-[#94A3B8]\" data-kid=\"2-3-1-1-3\" data-name=\"message text input\" role=\"textbox\">\n                        Escribe un mensaje\n                    </div>\n                    <button aria-label=\"Enviar mensaje\" class=\"grid min-h-[48px] min-w-[48px] shrink-0 place-items-center rounded-full bg-gradient-to-br from-[#522C81] to-[#45256D] text-white shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.97]\" data-kid=\"2-3-1-1-4\" data-name=\"send message button\">\n                        <i class=\"ti ti-send\" data-kid=\"2-3-1-1-4-1\" data-name=\"send icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF\">\n                        </i>\n                    </button>\n                </div>\n                <p class=\"mt-2 text-[10px] text-[#94A3B8]\" data-kid=\"2-3-1-2\">\n                    Taller Rápido responde normalmente en menos de 10 minutos.\n                </p>\n            </div>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-40 border-t border-[#CBD5E1] bg-white px-2 pb-[env(safe-area-inset-bottom)] pt-2 shadow-[0_-4px_16px_rgba(15,23,42,0.06)]\" data-kid=\"2-4\" data-name=\"fixed mobile bottom navigation\">\n        <div class=\"mx-auto flex max-w-[375px] items-center justify-between gap-1\" data-kid=\"2-4-1\" data-name=\"bottom navigation items\">\n            <button aria-label=\"Inicio\" class=\"flex min-h-11 min-w-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-4-1-1\" data-name=\"home navigation item\">\n                <i class=\"ti ti-dashboard\" data-kid=\"2-4-1-1-1\" data-name=\"dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-4-1-1-2\">\n                    Inicio\n                </span>\n            </button>\n            <button aria-label=\"Mi garaje\" class=\"flex min-h-11 min-w-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-4-1-2\" data-name=\"garage navigation item\">\n                <i class=\"ti ti-car\" data-kid=\"2-4-1-2-1\" data-name=\"car icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-4-1-2-2\">\n                    Garaje\n                </span>\n            </button>\n            <button aria-label=\"Talleres\" class=\"flex min-h-11 min-w-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-4-1-3\" data-name=\"workshops navigation item\">\n                <i class=\"ti ti-tool\" data-kid=\"2-4-1-3-1\" data-name=\"tool icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-4-1-3-2\">\n                    Talleres\n                </span>\n            </button>\n            <button aria-current=\"page\" aria-label=\"Conversaciones\" class=\"flex min-h-11 min-w-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-lg bg-[#E8F2FD] text-[#1E88E5]\" data-kid=\"2-4-1-4\" data-name=\"active conversations navigation item\">\n                <i class=\"ti ti-message-2\" data-kid=\"2-4-1-4-1\" data-name=\"message icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                </i>\n                <span class=\"text-[10px] font-bold\" data-kid=\"2-4-1-4-2\">\n                    Mensajes\n                </span>\n            </button>\n            <button aria-label=\"Alertas\" class=\"flex min-h-11 min-w-[44px] flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[#64748B]\" data-kid=\"2-4-1-5\" data-name=\"alerts navigation item\">\n                <i class=\"ti ti-alert-triangle\" data-kid=\"2-4-1-5-1\" data-name=\"alert icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-4-1-5-2\">\n                    Alertas\n                </span>\n            </button>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
      "created": "2026-08-17T20:12:05.153720+00:00",
      "modified": "2026-08-17T21:07:45.775416+00:00",
      "id": "var_3b2a8844d091"
    },
    "var_aaf600d6a07a": {
      "type": "variant",
      "label": "AutoDoc Workshop Directory — Hadrian Dark Mobile",
      "parentId": "var_882de3ea92c2",
      "themeId": null,
      "rect": {
        "x": 36625,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style data-name=\"AppButton AppCard AppMotion tokens\">\n    button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]) {\n    min-height: 48px;\n    border-radius: 999px !important;\n    transition: transform 150ms cubic-bezier(.23,1,.32,1), box-shadow 150ms ease-out, background-color 150ms ease-out, color 150ms ease-out;\n  }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]):hover { transform: scale(1.02); }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]):active { transform: scale(.97); }\n  [data-name=\"header actions container\"] button, [data-name=\"zoom buttons\"] button {\n    min-width: 44px !important;\n    min-height: 44px !important;\n    border-radius: 999px !important;\n    border: 1px solid #334155 !important;\n    background: #141E36 !important;\n    box-shadow: 0 2px 4px rgba(0,0,0,.2) !important;\n  }\n  [data-name=\"use location button\"], [data-name=\"contact button\"] {\n    border-radius: 999px !important;\n    min-height: 48px !important;\n    background: linear-gradient(135deg,#81E6D9,#6FC8BC) !important;\n    color: #0F172A !important;\n    box-shadow: 0 2px 4px rgba(0,0,0,.2) !important;\n  }\n  [data-name=\"filter and search bar\"], [data-name=\"recommended workshops section\"], [data-name=\"workshop card selected\"], [data-name=\"workshop card\"], [data-name=\"live map section\"] {\n    border-radius: 16px !important;\n    border: 1px solid #334155 !important;\n    background: #141E36 !important;\n    box-shadow: 0 2px 4px rgba(0,0,0,.2) !important;\n    overflow: hidden;\n  }\n  [data-name=\"workshop card selected\"] { border-left: 4px solid #38BDF8 !important; }\n  a:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]) { transition: color 150ms ease-out; }\n  @media (prefers-reduced-motion: reduce) { button, a { transition: none !important; } }\n</style>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"page layout container\">\n    <header class=\"sticky top-0 z-40 border-b border-[#334155] bg-[#0F172A]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"header section\">\n        <div class=\"flex items-center gap-3\" data-kid=\"2-1-1\" data-name=\"header top row\">\n            <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo container\">\n                <span class=\"text-[17px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo text\">\n                    AD\n                </span>\n            </div>\n            <div class=\"min-w-0 flex-1\" data-kid=\"2-1-1-2\" data-name=\"user status container\">\n                <div class=\"text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"status label text\">\n                    Propietario\n                </div>\n                <div class=\"mt-0.5 flex items-center gap-2 [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-2-2\" data-name=\"status name container\">\n                    <span class=\"truncate text-[16px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-1-2-2-1\" data-name=\"application name text\">\n                        Auto\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-2-2-1-1\" data-name=\"application name highlighted text\">\n                            Doc\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-2-2-2\" data-name=\"status indicator dot\">\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-3\" data-name=\"header actions container\">\n                <button aria-label=\"Cambiar tema\" class=\"flex min-h-11 min-w-11 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-1-3-1\" data-name=\"theme toggle button\">\n                    <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-1-3-1-1\" data-name=\"sun-moon icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Notificaciones\" class=\"relative flex min-h-11 min-w-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-1-3-2\" data-name=\"notifications button\">\n                    <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-1-3-2-1\" data-name=\"bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-3-2-2\" data-name=\"notifications indicator dot\">\n                    </span>\n                </button>\n                <button aria-label=\"Perfil de Juan Pérez\" class=\"flex min-h-11 min-w-11 items-center justify-center\" data-kid=\"2-1-1-3-3\" data-name=\"user profile button\">\n                    <span class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-1-3-3-1\" data-name=\"user initials label\">\n                        JP\n                    </span>\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-3 flex items-center justify-between border-t border-[#334155] pt-2.5\" data-kid=\"2-1-2\" data-name=\"header bottom row\">\n            <div class=\"flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"breadcrumb navigation\">\n                <span data-kid=\"2-1-2-1-1\" data-name=\"breadcrumb current section\">\n                    Propietario\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-1-2-1-2\" data-name=\"breadcrumb arrow icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-1-2-1-3\" data-name=\"breadcrumb sub-section\">\n                    Talleres\n                </span>\n            </div>\n            <div class=\"text-right text-[10px] leading-4 text-[#64748B]\" data-kid=\"2-1-2-2\" data-name=\"date time container\">\n                <div data-dynamic=\"true\" data-kid=\"2-1-2-2-1\" data-name=\"current date text\" data-reason=\"date updated dynamically by script\">\n                    Sábado, 25 jul 2026\n                </div>\n                <div class=\"font-semibold text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-2\" data-name=\"current time text\" data-reason=\"time updated dynamically by script\">\n                    08:42 a. m.\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-32 pt-6\" data-kid=\"2-2\" data-name=\"main content area\">\n        <div class=\"flex flex-col gap-4\" data-kid=\"2-2-1\" data-name=\"hero section\">\n            <div data-kid=\"2-2-1-1\" data-name=\"hero text container\">\n                <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[28px] font-extrabold leading-tight tracking-[-0.04em] text-white\" data-kid=\"2-2-1-1-1\" data-name=\"hero headline\">\n                    Talleres cerca de ti\n                </h1>\n                <p class=\"mt-2 max-w-[320px] text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-1-2\" data-name=\"hero description\">\n                    Encuentra un equipo confiable para el siguiente servicio de tu vehículo.\n                </p>\n            </div>\n            <button class=\"flex min-h-12 w-full items-center justify-center gap-2 bg-[#38BDF8] px-4 py-3 text-[12px] font-bold text-[#082F49]\" data-kid=\"2-2-1-2\" data-name=\"use location button\">\n                <i class=\"ti ti-current-location text-[16px]\" data-kid=\"2-2-1-2-1\" data-name=\"location icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Usar mi ubicación\n            </button>\n        </div>\n        <div class=\"mt-6 space-y-3 border-y border-[#334155] py-4\" data-kid=\"2-2-2\" data-name=\"filter and search bar\">\n            <div class=\"flex min-h-12 w-full items-center gap-3 border border-[#475569] bg-[#111C2E] px-4 text-[13px] text-[#94A3B8]\" data-kid=\"2-2-2-1\" data-name=\"search input container\">\n                <i class=\"ti ti-search shrink-0 text-[17px] text-[#64748B]\" data-kid=\"2-2-2-1-1\" data-name=\"search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"min-w-0 flex-1 truncate\" data-kid=\"2-2-2-1-2\" data-name=\"search placeholder text\">\n                    Buscar talleres, servicios o ciudad\n                </span>\n                <span class=\"shrink-0 rounded border border-[#475569] px-1.5 py-0.5 text-[10px] text-[#64748B]\" data-kid=\"2-2-2-1-3\" data-name=\"keyboard shortcut hint\">\n                    ⌘ K\n                </span>\n            </div>\n            <div class=\"grid grid-cols-3 gap-2\" data-kid=\"2-2-2-2\" data-name=\"filter options grid\">\n                <button class=\"flex min-h-12 min-w-0 items-center justify-center gap-1 border border-[#475569] px-1.5 text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-1\" data-name=\"distance filter button\">\n                    <i class=\"ti ti-arrows-sort shrink-0 text-[14px] text-[#38BDF8]\" data-kid=\"2-2-2-2-1-1\" data-name=\"distance icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"2-2-2-2-1-2\" data-name=\"distance text\">\n                        Distancia\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[12px] text-[#64748B]\" data-kid=\"2-2-2-2-1-3\" data-name=\"distance chevron icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-12 min-w-0 items-center justify-center gap-1 border border-[#475569] px-1.5 text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-2\" data-name=\"rating filter button\">\n                    <i class=\"ti ti-star-filled shrink-0 text-[13px] text-[#FBBF24]\" data-kid=\"2-2-2-2-2-1\" data-name=\"rating star icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"2-2-2-2-2-2\" data-name=\"rating text\">\n                        Calificación\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[12px] text-[#64748B]\" data-kid=\"2-2-2-2-2-3\" data-name=\"rating chevron icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-12 min-w-0 items-center justify-center gap-1 border border-[#475569] px-1.5 text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-3\" data-name=\"specialty filter button\">\n                    <i class=\"ti ti-tool shrink-0 text-[14px] text-[#818CF8]\" data-kid=\"2-2-2-2-3-1\" data-name=\"specialty tool icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"2-2-2-2-3-2\" data-name=\"specialty text\">\n                        Especialidad\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[12px] text-[#64748B]\" data-kid=\"2-2-2-2-3-3\" data-name=\"specialty chevron icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-5 flex items-center justify-between gap-3\" data-kid=\"2-2-3\" data-name=\"results summary header\">\n            <div class=\"min-w-0 text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-1\" data-name=\"location and count text\">\n                <span data-kid=\"2-2-3-1-1\" data-name=\"location name text\">\n                    Bogotá, Colombia\n                </span>\n                <span class=\"mx-1.5 text-[#475569]\" data-kid=\"2-2-3-1-2\" data-name=\"separator dot\">\n                    ·\n                </span>\n                <span class=\"font-normal text-[#94A3B8]\" data-kid=\"2-2-3-1-3\" data-name=\"result count text\">\n                    12 resultados\n                </span>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-3-2\" data-name=\"live map status\">\n                <span class=\"h-2 w-2 rounded-full bg-[#38BDF8]\" data-kid=\"2-2-3-2-1\" data-name=\"live map indicator\">\n                </span>\n                Mapa en vivo\n            </div>\n        </div>\n        <section aria-label=\"Talleres recomendados\" class=\"mt-3 overflow-hidden border border-[#475569] bg-[#0B1220]\" data-kid=\"2-2-4\" data-name=\"recommended workshops section\">\n            <div class=\"flex items-center justify-between border-b border-[#334155] px-4 py-4\" data-kid=\"2-2-4-1\" data-name=\"section header\">\n                <span class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-4-1-1\" data-name=\"section title\">\n                    Talleres recomendados\n                </span>\n                <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-4-1-2\" data-name=\"ordering note text\">\n                    Orden: cercanía\n                </span>\n            </div>\n            <article class=\"border-b border-l-2 border-l-[#38BDF8] bg-[#1E293B] px-4 py-4\" data-kid=\"2-2-4-2\" data-name=\"workshop card selected\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-2-1\" data-name=\"card top row\">\n                    <div class=\"min-w-0\" data-kid=\"2-2-4-2-1-1\" data-name=\"workshop name and rating container\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"2-2-4-2-1-1-1\" data-name=\"workshop name and rating row\">\n                            <h2 class=\"text-[15px] font-bold text-white\" data-kid=\"2-2-4-2-1-1-1-1\" data-name=\"workshop title\">\n                                Taller Rápido\n                            </h2>\n                            <span class=\"flex items-center gap-1 text-[12px] font-bold text-[#FCD34D]\" data-kid=\"2-2-4-2-1-1-1-2\" data-name=\"workshop rating\">\n                                <i class=\"ti ti-star-filled text-[12px]\" data-kid=\"2-2-4-2-1-1-1-2-1\" data-name=\"star icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                4.9\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-4-2-1-1-2\" data-name=\"workshop details\">\n                            1.8 km\n                            <span class=\"mx-1 text-[#475569]\" data-kid=\"2-2-4-2-1-1-2-1\" data-name=\"details separator\">\n                                ·\n                            </span>\n                            Cambio de aceite, frenos\n                        </p>\n                    </div>\n                    <span class=\"shrink-0 rounded-full border border-[#34D399]/40 bg-[#064E3B]/30 px-2 py-1 text-[10px] font-semibold text-[#6EE7B7]\" data-kid=\"2-2-4-2-1-2\" data-name=\"status badge\">\n                        Abierto\n                    </span>\n                </div>\n                <div class=\"mt-4 flex flex-col gap-3 border-t border-[#334155] pt-3\" data-kid=\"2-2-4-2-2\" data-name=\"card bottom row\">\n                    <span class=\"flex items-center gap-2 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-4-2-2-1\" data-name=\"availability text\">\n                        <i class=\"ti ti-clock text-[14px] text-[#34D399]\" data-kid=\"2-2-4-2-2-1-1\" data-name=\"clock icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Abierto hoy hasta 18:00\n                    </span>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-4-2-2-2\" data-name=\"card actions container\">\n                        <button class=\"min-h-11 flex-1 border border-[#475569] px-3 text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-4-2-2-2-1\" data-name=\"view details button\">\n                            Ver ficha\n                        </button>\n                        <button class=\"min-h-11 flex-1 bg-[#38BDF8] px-3 text-[11px] font-bold text-[#082F49]\" data-kid=\"2-2-4-2-2-2-2\" data-name=\"contact button\">\n                            Contactar\n                        </button>\n                    </div>\n                </div>\n            </article>\n            <article class=\"border-b border-[#334155] px-4 py-4\" data-kid=\"2-2-4-3\" data-name=\"workshop card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-3-1\" data-name=\"card top row\">\n                    <div class=\"min-w-0\" data-kid=\"2-2-4-3-1-1\" data-name=\"workshop name and rating container\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"2-2-4-3-1-1-1\" data-name=\"workshop name and rating row\">\n                            <h2 class=\"text-[15px] font-bold text-[#E2E8F0]\" data-kid=\"2-2-4-3-1-1-1-1\" data-name=\"workshop title\">\n                                MotorLab\n                            </h2>\n                            <span class=\"flex items-center gap-1 text-[12px] font-bold text-[#FCD34D]\" data-kid=\"2-2-4-3-1-1-1-2\" data-name=\"workshop rating\">\n                                <i class=\"ti ti-star-filled text-[12px]\" data-kid=\"2-2-4-3-1-1-1-2-1\" data-name=\"star icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                4.8\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-4-3-1-1-2\" data-name=\"workshop details\">\n                            3.4 km\n                            <span class=\"mx-1 text-[#475569]\" data-kid=\"2-2-4-3-1-1-2-1\" data-name=\"details separator\">\n                                ·\n                            </span>\n                            Diagnóstico\n                        </p>\n                    </div>\n                    <span class=\"shrink-0 rounded-full border border-[#FBBF24]/40 bg-[#78350F]/20 px-2 py-1 text-[10px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-4-3-1-2\" data-name=\"status badge\">\n                        Cierra 19:00\n                    </span>\n                </div>\n                <div class=\"mt-4 flex flex-col gap-3 border-t border-[#334155] pt-3\" data-kid=\"2-2-4-3-2\" data-name=\"card bottom row\">\n                    <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-4-3-2-1\" data-name=\"availability text\">\n                        Próxima disponibilidad mañana\n                    </span>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-4-3-2-2\" data-name=\"card actions container\">\n                        <button class=\"min-h-11 flex-1 border border-[#475569] px-3 text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-4-3-2-2-1\" data-name=\"view details button\">\n                            Ver ficha\n                        </button>\n                        <button class=\"min-h-11 flex-1 bg-[#38BDF8] px-3 text-[11px] font-bold text-[#082F49]\" data-kid=\"2-2-4-3-2-2-2\" data-name=\"contact button\">\n                            Contactar\n                        </button>\n                    </div>\n                </div>\n            </article>\n            <article class=\"border-b border-[#334155] px-4 py-4\" data-kid=\"2-2-4-4\" data-name=\"workshop card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-4-1\" data-name=\"card top row\">\n                    <div class=\"min-w-0\" data-kid=\"2-2-4-4-1-1\" data-name=\"workshop name and rating container\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"2-2-4-4-1-1-1\" data-name=\"workshop name and rating row\">\n                            <h2 class=\"text-[15px] font-bold text-[#E2E8F0]\" data-kid=\"2-2-4-4-1-1-1-1\" data-name=\"workshop title\">\n                                Centro Auto\n                            </h2>\n                            <span class=\"flex items-center gap-1 text-[12px] font-bold text-[#FCD34D]\" data-kid=\"2-2-4-4-1-1-1-2\" data-name=\"workshop rating\">\n                                <i class=\"ti ti-star-filled text-[12px]\" data-kid=\"2-2-4-4-1-1-1-2-1\" data-name=\"star icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                4.6\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-4-4-1-1-2\" data-name=\"workshop details\">\n                            5.1 km\n                            <span class=\"mx-1 text-[#475569]\" data-kid=\"2-2-4-4-1-1-2-1\" data-name=\"details separator\">\n                                ·\n                            </span>\n                            Mantenimiento general\n                        </p>\n                    </div>\n                    <span class=\"shrink-0 rounded-full border border-[#475569] px-2 py-1 text-[10px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-4-4-1-2\" data-name=\"status badge\">\n                        Cierra 17:30\n                    </span>\n                </div>\n                <div class=\"mt-4 flex flex-col gap-3 border-t border-[#334155] pt-3\" data-kid=\"2-2-4-4-2\" data-name=\"card bottom row\">\n                    <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-4-4-2-1\" data-name=\"review count text\">\n                        12 reseñas verificadas\n                    </span>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-4-4-2-2\" data-name=\"card actions container\">\n                        <button class=\"min-h-11 flex-1 border border-[#475569] px-3 text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-4-4-2-2-1\" data-name=\"view details button\">\n                            Ver ficha\n                        </button>\n                        <button class=\"min-h-11 flex-1 bg-[#38BDF8] px-3 text-[11px] font-bold text-[#082F49]\" data-kid=\"2-2-4-4-2-2-2\" data-name=\"contact button\">\n                            Contactar\n                        </button>\n                    </div>\n                </div>\n            </article>\n            <div class=\"flex items-center justify-between px-4 py-3 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-5\" data-name=\"show more results bar\">\n                <span data-kid=\"2-2-4-5-1\" data-name=\"results summary text\">\n                    Mostrando 3 de 12 talleres\n                </span>\n                <button class=\"min-h-11 px-2 font-semibold text-[#38BDF8]\" data-kid=\"2-2-4-5-2\" data-name=\"show all button\">\n                    Ver todos\n                </button>\n            </div>\n        </section>\n        <section aria-label=\"Mapa en vivo\" class=\"mt-5 overflow-hidden border border-[#475569] bg-[#111C2E]\" data-kid=\"2-2-5\" data-name=\"live map section\">\n            <div class=\"relative h-[310px] overflow-hidden\" data-kid=\"2-2-5-1\" data-name=\"map display area\">\n                <div class=\"absolute inset-0 opacity-70\" data-kid=\"2-2-5-1-1\" data-name=\"map grid background\">\n                    <div class=\"absolute inset-0 bg-[linear-gradient(90deg,transparent_0%,transparent_49%,#26364d_50%,transparent_51%,transparent_100%),linear-gradient(0deg,transparent_0%,transparent_49%,#26364d_50%,transparent_51%,transparent_100%)] bg-[length:68px_68px]\" data-kid=\"2-2-5-1-1-1\" data-name=\"grid lines\">\n                    </div>\n                    <div class=\"absolute left-[-18%] top-[35%] h-5 w-[135%] rotate-[22deg] bg-[#26364D] shadow-[0_0_0_2px_#1A2940]\" data-kid=\"2-2-5-1-1-2\" data-name=\"map road one\">\n                    </div>\n                    <div class=\"absolute left-[-18%] top-[70%] h-4 w-[135%] rotate-[-16deg] bg-[#26364D] shadow-[0_0_0_2px_#1A2940]\" data-kid=\"2-2-5-1-1-3\" data-name=\"map road two\">\n                    </div>\n                    <div class=\"absolute left-[28%] top-[-15%] h-[135%] w-5 rotate-[11deg] bg-[#26364D] shadow-[0_0_0_2px_#1A2940]\" data-kid=\"2-2-5-1-1-4\" data-name=\"map road three\">\n                    </div>\n                    <div class=\"absolute left-[70%] top-[-10%] h-[130%] w-4 rotate-[-24deg] bg-[#26364D] shadow-[0_0_0_2px_#1A2940]\" data-kid=\"2-2-5-1-1-5\" data-name=\"map road four\">\n                    </div>\n                    <div class=\"absolute left-[48%] top-[45%] h-24 w-32 rotate-[-12deg] border border-[#334155] bg-[#172238]\" data-kid=\"2-2-5-1-1-6\" data-name=\"map building\">\n                    </div>\n                    <div class=\"absolute left-[10%] top-[16%] text-[9px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-5-1-1-7\" data-name=\"neighborhood label\">\n                        Chapinero\n                    </div>\n                    <div class=\"absolute left-[62%] top-[20%] text-[9px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-5-1-1-8\" data-name=\"neighborhood label\">\n                        Teusaquillo\n                    </div>\n                    <div class=\"absolute left-[58%] top-[77%] text-[9px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-5-1-1-9\" data-name=\"neighborhood label\">\n                        Centro\n                    </div>\n                    <div class=\"absolute left-[20%] top-[78%] text-[9px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-5-1-1-10\" data-name=\"neighborhood label\">\n                        La Soledad\n                    </div>\n                </div>\n                <div class=\"absolute left-4 right-4 top-4 flex items-start justify-between gap-2\" data-kid=\"2-2-5-1-2\" data-name=\"map controls row\">\n                    <div class=\"flex min-h-11 items-center gap-2 border border-[#475569] bg-[#0B1220]/90 px-3 py-2 text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-5-1-2-1\" data-name=\"results count pill\">\n                        <i class=\"ti ti-map-pin text-[15px] text-[#38BDF8]\" data-kid=\"2-2-5-1-2-1-1\" data-name=\"map pin icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span data-kid=\"2-2-5-1-2-1-2\" data-name=\"map results text\">\n                            12 talleres en la zona\n                        </span>\n                    </div>\n                    <div class=\"flex shrink-0\" data-kid=\"2-2-5-1-2-2\" data-name=\"zoom buttons\">\n                        <button aria-label=\"Acercar mapa\" class=\"flex min-h-11 min-w-11 items-center justify-center border border-[#475569] bg-[#0B1220] text-[#CBD5E1]\" data-kid=\"2-2-5-1-2-2-1\" data-name=\"zoom in button\">\n                            <i class=\"ti ti-plus text-[17px]\" data-kid=\"2-2-5-1-2-2-1-1\" data-name=\"plus icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                        <button aria-label=\"Alejar mapa\" class=\"flex min-h-11 min-w-11 items-center justify-center border-y border-r border-[#475569] bg-[#0B1220] text-[#CBD5E1]\" data-kid=\"2-2-5-1-2-2-2\" data-name=\"zoom out button\">\n                            <i class=\"ti ti-minus text-[17px]\" data-kid=\"2-2-5-1-2-2-2-1\" data-name=\"minus icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"absolute left-[25%] top-[31%] flex flex-col items-center\" data-kid=\"2-2-5-1-3\" data-name=\"workshop map marker 1\">\n                    <span class=\"relative flex h-9 w-9 items-center justify-center rounded-full border-2 border-[#E0F2FE] bg-[#38BDF8] text-[#082F49] shadow-[0_4px_14px_rgba(56,189,248,0.25)]\" data-kid=\"2-2-5-1-3-1\" data-name=\"marker icon\">\n                        <i class=\"ti ti-tool text-[16px]\" data-kid=\"2-2-5-1-3-1-1\" data-name=\"tool icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"mt-1 border border-[#475569] bg-[#0B1220]/95 px-2 py-1 text-[10px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-5-1-3-2\" data-name=\"marker name label\">\n                        Taller Rápido\n                    </span>\n                </div>\n                <div class=\"absolute left-[65%] top-[46%] flex flex-col items-center\" data-kid=\"2-2-5-1-4\" data-name=\"workshop map marker 2\">\n                    <span class=\"relative flex h-8 w-8 items-center justify-center rounded-full border-2 border-[#FEF3C7] bg-[#FBBF24] text-[#451A03]\" data-kid=\"2-2-5-1-4-1\" data-name=\"marker icon\">\n                        <i class=\"ti ti-tool text-[14px]\" data-kid=\"2-2-5-1-4-1-1\" data-name=\"tool icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"mt-1 border border-[#475569] bg-[#0B1220]/95 px-2 py-1 text-[10px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-5-1-4-2\" data-name=\"marker name label\">\n                        MotorLab\n                    </span>\n                </div>\n                <div class=\"absolute left-[49%] top-[68%] flex flex-col items-center\" data-kid=\"2-2-5-1-5\" data-name=\"workshop map marker 3\">\n                    <span class=\"relative flex h-8 w-8 items-center justify-center rounded-full border-2 border-[#E0F2FE] bg-[#38BDF8] text-[#082F49]\" data-kid=\"2-2-5-1-5-1\" data-name=\"marker icon\">\n                        <i class=\"ti ti-tool text-[14px]\" data-kid=\"2-2-5-1-5-1-1\" data-name=\"tool icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"mt-1 border border-[#475569] bg-[#0B1220]/95 px-2 py-1 text-[10px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-5-1-5-2\" data-name=\"marker name label\">\n                        Centro Auto\n                    </span>\n                </div>\n                <div class=\"absolute bottom-4 left-4 right-4 border border-[#475569] bg-[#0B1220]/95 px-3 py-3\" data-kid=\"2-2-5-1-6\" data-name=\"map tooltip card\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"2-2-5-1-6-1\" data-name=\"tooltip content\">\n                        <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#38BDF8] text-[#082F49]\" data-kid=\"2-2-5-1-6-1-1\" data-name=\"marker icon container\">\n                            <i class=\"ti ti-tool text-[15px]\" data-kid=\"2-2-5-1-6-1-1-1\" data-name=\"tool icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"2-2-5-1-6-1-2\" data-name=\"workshop summary\">\n                            <div class=\"text-[12px] font-semibold text-white\" data-kid=\"2-2-5-1-6-1-2-1\" data-name=\"workshop title\">\n                                Taller Rápido\n                            </div>\n                            <div class=\"mt-0.5 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-5-1-6-1-2-2\" data-name=\"workshop details\">\n                                1.8 km · 4.9 · Abierto hasta 18:00\n                            </div>\n                        </div>\n                        <button class=\"min-h-11 shrink-0 px-1 text-[11px] font-bold text-[#38BDF8]\" data-kid=\"2-2-5-1-6-1-3\" data-name=\"view details link\">\n                            Ver ficha\n                            <i class=\"ti ti-arrow-up-right text-[13px]\" data-kid=\"2-2-5-1-6-1-3-1\" data-name=\"arrow icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <footer class=\"mt-6 flex flex-col gap-3 border-t border-[#334155] pt-4 text-[11px] text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"footer bar\">\n            <span data-kid=\"2-2-6-1\" data-name=\"footer description text\">\n                AutoDoc · Diagnóstico y mantenimiento para tu vehículo\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-2-6-2\" data-name=\"sync status container\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-6-2-1\" data-name=\"sync indicator dot\">\n                </span>\n                Datos sincronizados hace 4 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-50 border-t border-[#334155] bg-[#020617] px-2 pt-2\" data-kid=\"2-3\" data-name=\"bottom navigation bar\" style=\"padding-bottom:env(safe-area-inset-bottom, 0px)\">\n        <div class=\"grid grid-cols-4 gap-1\" data-kid=\"2-3-1\" data-name=\"navigation grid\">\n            <button aria-label=\"Inicio\" class=\"flex min-h-14 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" data-name=\"home navigation button\">\n                <i class=\"ti ti-home-2 text-[18px]\" data-kid=\"2-3-1-1-1\" data-name=\"home icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </button>\n            <button aria-label=\"Mi garaje\" class=\"flex min-h-14 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"my-garage navigation button\">\n                <i class=\"ti ti-car text-[18px]\" data-kid=\"2-3-1-2-1\" data-name=\"car icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"my-garage label\">\n                    Mi garaje\n                </span>\n            </button>\n            <button aria-label=\"Talleres\" class=\"flex min-h-14 flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-3-1-3\" data-name=\"workshops navigation button\">\n                <i class=\"ti ti-tool text-[18px]\" data-kid=\"2-3-1-3-1\" data-name=\"tool icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </button>\n            <button aria-label=\"Mensajes\" class=\"flex min-h-14 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-4\" data-name=\"messages navigation button\">\n                <i class=\"ti ti-message-2 text-[18px]\" data-kid=\"2-3-1-4-1\" data-name=\"message icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"messages label\">\n                    Mensajes\n                </span>\n            </button>\n        </div>\n    </nav>\n</div>\n",
