ata-kid=\"2-3-1-4-2\" data-name=\"catalog navigation label\">\n                    Catálogo\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-5\" data-name=\"chat navigation item\" href=\"#conversaciones\">\n                <i class=\"ti ti-message-2 text-[19px]\" data-kid=\"2-3-1-5-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-5-2\">\n                    Chat\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
