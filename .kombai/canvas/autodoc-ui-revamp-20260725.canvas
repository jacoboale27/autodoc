    "var_04c8e22d496a": {
      "type": "variant",
      "label": "AutoDoc Dashboard — Hadrian Dark Mobile",
      "parentId": "var_a24d007b02bc",
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-white [font-family:'IBM_Plex_Sans',sans-serif] antialiased\" data-kid=\"2\" data-name=\"page layout container\">\n    <header class=\"sticky top-0 z-20 border-b border-[#334155] bg-[#0B1220]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"sticky header\">\n        <div class=\"flex min-h-[44px] items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"header content container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"user profile and breadcrumb container\">\n                <div class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1-1\" data-name=\"brand initials icon container\">\n                    <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1-1\" data-name=\"brand initials text\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"user profile status container\">\n                    <div class=\"truncate text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"profile role text\">\n                        Propietario\n                    </div>\n                    <div class=\"flex items-center gap-2 text-[13px] font-semibold text-white\" data-kid=\"2-1-1-1-2-2\" data-name=\"profile status and breadcrumb section\">\n                        <span data-kid=\"2-1-1-1-2-2-1\" data-name=\"breadcrumb current page name\">\n                            Inicio\n                        </span>\n                        <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-1-2-2-2\" data-name=\"online status indicator\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"header action buttons container\">\n                <button aria-label=\"Cambiar tema\" class=\"flex size-11 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-1-2-1\" data-name=\"theme toggle button\">\n                    <i class=\"ti ti-sun-moon text-[18px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"theme toggle icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Notificaciones\" class=\"relative flex size-11 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-1-2-2\" data-name=\"notifications button\">\n                    <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"notifications icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-2-2-2\" data-name=\"notifications badge indicator\">\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[calc(112px+env(safe-area-inset-bottom))] pt-5\" data-kid=\"2-2\" data-name=\"main content area\">\n        <div class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"header information and actions\">\n            <div class=\"mb-3 flex items-center justify-between gap-3 text-[10px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"breadcrumb and timestamp section\">\n                <span class=\"truncate\" data-kid=\"2-2-1-1-1\" data-name=\"breadcrumb path\">\n                    Propietario\n                    <span class=\"px-1 text-[#475569]\" data-kid=\"2-2-1-1-1-1\" data-name=\"breadcrumb separator\">\n                        ›\n                    </span>\n                    <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-2-1-1-1-2\" data-name=\"breadcrumb current page name\">\n                        Inicio\n                    </span>\n                </span>\n                <span class=\"shrink-0 text-right\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2\" data-name=\"current date and time display\" data-reason=\"date and time updated by script\">\n                    Sábado, 25 jul 2026\n                    <br data-kid=\"2-2-1-1-2-1\" data-name=\"timestamp line break\"/>\n                    <strong class=\"text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-2\" data-name=\"clock time display\" data-reason=\"time updated every minute by script\">\n                        08:42 a. m.\n                    </strong>\n                </span>\n            </div>\n            <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[27px] font-extrabold leading-[1.1] tracking-[-0.04em] text-white\" data-kid=\"2-2-1-2\" data-name=\"page headline\">\n                Tu vehículo, en control\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-3\" data-name=\"page subheadline text\">\n                Revisa el estado actual y actúa antes de que un detalle se convierta en una avería.\n            </p>\n            <div class=\"mt-4 flex items-center justify-between gap-3 border-y border-[#334155] py-3\" data-kid=\"2-2-1-4\" data-name=\"user profile summary section\">\n                <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"2-2-1-4-1\" data-name=\"profile user identity\">\n                    <div class=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-[#334155] text-[11px] font-bold text-[#E2E8F0]\" data-kid=\"2-2-1-4-1-1\" data-name=\"user avatar placeholder\">\n                        JP\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-2-1-4-1-2\" data-name=\"user name and plan container\">\n                        <div class=\"truncate text-[12px] font-semibold text-white\" data-kid=\"2-2-1-4-1-2-1\" data-name=\"user name\">\n                            Juan Pérez\n                        </div>\n                        <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-1-4-1-2-2\" data-name=\"subscription plan\">\n                            Plan personal\n                        </div>\n                    </div>\n                </div>\n                <button class=\"flex min-h-[44px] shrink-0 items-center gap-2 border border-[#475569] px-3 text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-1-4-2\" data-name=\"refresh data button\">\n                    <i class=\"ti ti-refresh text-[15px] text-[#38BDF8]\" data-kid=\"2-2-1-4-2-1\" data-name=\"refresh data icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Actualizar datos\n                </button>\n            </div>\n        </div>\n        <section class=\"overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-2\" data-name=\"vehicle overview card\">\n            <div class=\"relative aspect-[16/10] overflow-hidden bg-[#111827]\" data-kid=\"2-2-2-1\" data-name=\"vehicle card hero image area\">\n                <img alt=\"Vehículo en estudio, Hyundai Motor Group on Pexels\" class=\"h-full w-full object-cover opacity-90\" data-kid=\"2-2-2-1-1\" data-name=\"vehicle image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14696345/pexels-photo-14696345.jpeg?auto=compress&cs=tinysrgb&w=720&q=80\"/>\n                <div class=\"absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-[#020617]/80 px-4 py-4\" data-kid=\"2-2-2-1-2\" data-name=\"vehicle connectivity status overlay\">\n                    <div data-kid=\"2-2-2-1-2-1\" data-name=\"vehicle image label container\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.18em] text-[#94A3B8]\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"vehicle category label\">\n                            Vehículo principal\n                        </div>\n                        <div class=\"mt-1 text-[13px] font-semibold text-white\" data-kid=\"2-2-2-1-2-1-2\" data-name=\"vehicle image caption\">\n                            Vista de referencia\n                        </div>\n                    </div>\n                    <div class=\"flex shrink-0 items-center gap-2 text-[11px] text-[#CBD5E1]\" data-kid=\"2-2-2-1-2-2\" data-name=\"vehicle connection status label\">\n                        <span class=\"size-2 rounded-full bg-[#34D399]\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"connection status dot indicator\">\n                        </span>\n                        Conectado\n                    </div>\n                </div>\n            </div>\n            <div class=\"p-5\" data-kid=\"2-2-2-2\" data-name=\"vehicle details section\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-2-2-1\" data-name=\"vehicle identity header\">\n                    <div data-kid=\"2-2-2-2-1-1\" data-name=\"vehicle status label\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-[#64748B]\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"vehicle status text\">\n                            Activo\n                        </div>\n                        <h2 class=\"mt-2 [font-family:'Plus_Jakarta_Sans',sans-serif] text-[24px] font-bold leading-tight tracking-[-0.04em] text-white\" data-kid=\"2-2-2-2-1-1-2\" data-name=\"vehicle model year\">\n                            Toyota Corolla 2022\n                        </h2>\n                    </div>\n                    <span class=\"shrink-0 border border-[#34D399]/50 bg-[#064E3B]/30 px-2 py-1 text-[10px] font-bold tracking-[0.14em] text-[#6EE7B7]\" data-kid=\"2-2-2-2-1-2\" data-name=\"active status badge\">\n                        ACTIVO\n                    </span>\n                </div>\n                <div class=\"mt-5 grid grid-cols-2 gap-4 border-y border-[#475569] py-4\" data-kid=\"2-2-2-2-2\" data-name=\"vehicle metrics grid\">\n                    <div data-kid=\"2-2-2-2-2-1\" data-name=\"license plate info\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-2-2-2-1-1\" data-name=\"license plate label\">\n                            Placa\n                        </div>\n                        <div class=\"mt-2 text-[16px] font-bold tracking-[0.12em] text-[#E2E8F0]\" data-kid=\"2-2-2-2-2-1-2\" data-name=\"license plate text\">\n                            P 482-916\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-2-2-2-2\" data-name=\"mileage info\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-2-2-2-2-1\" data-name=\"mileage label\">\n                            Kilometraje\n                        </div>\n                        <div class=\"mt-2 text-[20px] font-bold tabular-nums text-[#38BDF8]\" data-kid=\"2-2-2-2-2-2-2\" data-name=\"mileage value\">\n                            48,260\n                            <span class=\"text-[12px] font-medium text-[#94A3B8]\" data-kid=\"2-2-2-2-2-2-2-1\" data-name=\"mileage unit\">\n                                km\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-4 flex items-start justify-between gap-3 text-[12px]\" data-kid=\"2-2-2-2-3\" data-name=\"last service info\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-2-2-2-3-1\" data-name=\"last service label\">\n                        Último servicio\n                    </span>\n                    <span class=\"text-right font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-3-2\" data-name=\"last service date and mileage\">\n                        18 may 2026\n                        <span class=\"text-[#64748B]\" data-kid=\"2-2-2-2-3-2-1\" data-name=\"last service separator\">\n                            •\n                        </span>\n                        46,520 km\n                    </span>\n                </div>\n                <div class=\"mt-5 flex items-center justify-between gap-3\" data-kid=\"2-2-2-2-4\" data-name=\"maintenance compliance section\">\n                    <span class=\"flex items-center gap-2 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-2-4-1\" data-name=\"compliance status text\">\n                        <i class=\"ti ti-shield-check text-[15px] text-[#34D399]\" data-kid=\"2-2-2-2-4-1-1\" data-name=\"shield check icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Perfil actualizado\n                    </span>\n                </div>\n                <button class=\"mt-4 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-5 py-3 text-[12px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-2-2-2-5\" data-name=\"view full vehicle profile button\">\n                    Ver ficha completa\n                    <i class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"2-2-2-2-5-1\" data-name=\"view profile arrow icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <section class=\"mt-8\" data-kid=\"2-2-3\" data-name=\"maintenance status section\">\n            <div class=\"mb-4 flex items-end justify-between gap-3\" data-kid=\"2-2-3-1\" data-name=\"maintenance header\">\n                <div data-kid=\"2-2-3-1-1\" data-name=\"maintenance title section\">\n                    <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[19px] font-bold tracking-[-0.02em] text-white\" data-kid=\"2-2-3-1-1-1\" data-name=\"maintenance title\">\n                        Estado de mantenimiento\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-3-1-1-2\" data-name=\"maintenance description\">\n                        Lectura rápida de los sistemas que requieren seguimiento.\n                    </p>\n                </div>\n                <span class=\"shrink-0 text-right text-[10px] font-semibold text-[#FBBF24]\" data-kid=\"2-2-3-1-2\" data-name=\"priority alert label\">\n                    1 revisión\n                    <br data-kid=\"2-2-3-1-2-1\" data-name=\"alert label break\"/>\n                    prioritaria\n                </span>\n            </div>\n            <div class=\"overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-3-2\" data-name=\"maintenance systems list container\">\n                <div 