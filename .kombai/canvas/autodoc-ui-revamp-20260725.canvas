      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component tokens dark\">\n    button { min-height:44px; min-width:44px; border-radius:999px !important; transition:transform 150ms cubic-bezier(.23,1,.32,1),box-shadow 150ms cubic-bezier(.23,1,.32,1),background-color 150ms cubic-bezier(.23,1,.32,1),color 150ms cubic-bezier(.23,1,.32,1); }\n  button:active { transform:scale(.97); }\n  button:hover { box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  button[data-name*=\"primary button\"], button[data-name*=\"create user button\"] { background:linear-gradient(135deg,#81E6D9,#6FC8BC) !important; color:#0F172A !important; border:0 !important; box-shadow:0 2px 4px rgba(0,0,0,.20); }\n  button[data-name*=\"refresh\"], button[data-name*=\"export\"], button[data-name*=\"filter\"], button[data-name*=\"page\"] { background:#141E36 !important; border:1px solid rgba(51,65,85,.20) !important; color:#E2E8F0 !important; box-shadow:0 2px 4px rgba(0,0,0,.20); }\n  button[aria-label*=\"Notificaciones\"], button[aria-label*=\"Cambiar tema\"], button[aria-label*=\"Cambiar a modo\"], button[aria-label*=\"Configuración\"], button[aria-label*=\"Ayuda\"] { background:#141E36 !important; border:1px solid rgba(51,65,85,.20) !important; }\n  section[data-name*=\"metrics\"], section[data-name*=\"panel\"], section[data-name*=\"Logs\"], section[data-name*=\"logs\"], section[data-name*=\"table\"], article[data-name*=\"user card\"], article[data-name*=\"account row\"] { background:#141E36; border-color:rgba(51,65,85,.20) !important; border-radius:16px; box-shadow:0 2px 4px rgba(0,0,0,.20); overflow:hidden; }\n</style>\n<div class=\"font-body min-h-screen bg-[#0F172A] text-[#E2E8F0] antialiased\" data-kid=\"2\" data-name=\"admin users application root\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"admin shell wrapper\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"admin icon rail\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\" data-name=\"admin rail primary group\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    AD\n                </div>\n                <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-1-2\" data-name=\"admin rail destinations\">\n                    <button aria-label=\"Resumen\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"summary rail button\">\n                        <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Usuarios\" class=\"flex h-10 w-10 items-center justify-center text-[#38BDF8]\" data-kid=\"2-1-1-1-2-2\" data-name=\"users rail button\">\n                        <i class=\"ti ti-users text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-3\" data-name=\"workshops rail button\">\n                        <i class=\"ti ti-building-store text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Logs\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-4\" data-name=\"logs rail button\">\n                        <i class=\"ti ti-terminal-2 text-[19px]\" data-kid=\"2-1-1-1-2-4-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\" data-name=\"admin rail utility group\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-1\" data-name=\"settings rail button\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-2\" data-name=\"help rail button\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\" data-name=\"admin contextual sidebar\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\" data-name=\"admin account header\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\" data-name=\"admin role label\">\n                    Administración\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 font-heading\" data-kid=\"2-1-2-1-2\" data-name=\"admin brand identity\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em] text-[#F8FAFC]\" data-kid=\"2-1-2-1-2-1\">\n                        Auto\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\">\n                            Doc\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-2-1-2-2\">\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación de administración\" class=\"flex-1 px-4 py-6\" data-kid=\"2-1-2-2\" data-name=\"admin navigation\">\n                <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-1\" data-name=\"admin navigation heading\">\n                    Panel operativo\n                </div>\n                <div class=\"space-y-1\" data-kid=\"2-1-2-2-2\" data-name=\"admin primary links\">\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-1\" data-name=\"summary link\" href=\"#resumen\">\n                        <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"2-1-2-2-2-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Resumen\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-3 py-3 text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"2-1-2-2-2-2\" data-name=\"active users link\" href=\"#usuarios\">\n                        <i class=\"ti ti-users text-[17px] text-[#38BDF8]\" data-kid=\"2-1-2-2-2-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Usuarios\n                        <span class=\"ml-auto rounded-[4px] bg-[#075985] px-1.5 py-0.5 text-[10px] font-bold tabular-nums text-[#BAE6FD]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"active users count label\" data-reason=\"text content updated by backend state\">\n                            1,284\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-3\" data-name=\"workshops link\" href=\"#talleres\">\n                        <i class=\"ti ti-building-store text-[17px]\" data-kid=\"2-1-2-2-2-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Talleres\n                        <span class=\"ml-auto text-[11px] tabular-nums text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-2-3-2\" data-name=\"workshops count label\" data-reason=\"text content updated by backend state\">\n                            86\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-4\" data-name=\"reviews link\" href=\"#resenas\">\n                        <i class=\"ti ti-star text-[17px]\" data-kid=\"2-1-2-2-2-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Reseñas\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-5\" data-name=\"logs link\" href=\"#logs\">\n                        <i class=\"ti ti-list-details text-[17px]\" data-kid=\"2-1-2-2-2-5-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Logs\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-6\" data-name=\"seed link\" href=\"#seed\">\n                        <i class=\"ti ti-database-import text-[17px]\" data-kid=\"2-1-2-2-2-6-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Seed\n                    </a>\n                </div>\n            </nav>\n            <div class=\"border-t border-[#334155] px-5 py-5\" data-kid=\"2-1-2-3\" data-name=\"admin user summary\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\" data-name=\"admin identity row\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-3-1-1\" data-name=\"superadmin avatar\">\n                        SA\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\">\n                        <div class=\"truncate text-[12px] font-semibold text-[#F8FAFC]\" data-kid=\"2-1-2-3-1-2-1\">\n                            Superadmin\n                        </div>\n                        <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\">\n                            Acceso interno\n                        </div>\n                    </div>\n                    <i class=\"ti ti-dots text-[16px] text-[#64748B]\" data-kid=\"2-1-2-3-1-3\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[#0F172A]\" data-kid=\"2-1-3\" data-name=\"admin users main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#334155] px-8\" data-kid=\"2-1-3-1\" data-name=\"admin users header\">\n                <div class=\"flex items-center gap-3 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumb\">\n                    <span data-kid=\"2-1-3-1-1-1\">\n                        Admin\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-1-3-1-1-2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-1-1-3\">\n                        Usuarios\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-1-2\" data-name=\"header actions\">\n                    <button aria-label=\"Notificaciones\" class=\"relative flex h-9 w-9 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-3-1-2-1\">\n                        <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-3-1-2-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-3-1-2-1-2\" data-name=\"notification dot\">\n                        </span>\n                    </button>\n                    <div class=\"h-5 w-px bg-[#334155]\" data-kid=\"2-1-3-1-2-3\">\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-1-2-2\">\n                        <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-1-2-2-1\">\n                            SA\n                        </div>\n                        <span class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-1-2-2-2\">\n                            Superadmin\n                        </span>\n                        <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-1-3-1-2-2-3\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1160px] px-8 pb-10 pt-8\" data-kid=\"2-1-3-2\" data-name=\"admin users content wrapper\">\n                <div class=\"mb-7 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"users title row\">\n                    <div data-kid=\"2-1-3-2-1-1\">\n                        <h1 class=\"font-heading text-[30px] font-extrabold tracking-[-0.04em] text-[#F8FAFC]\" data-kid=\"2-1-3-2-1-1-1\">\n                            Usuarios\n                        </h1>\n                        <p class=\"mt-2 text-[14px] text-[#94A3B8]\" data-kid=\"2-1-3-2-1-1-2\">\n                            Gestiona acceso, roles y estado de las cuentas.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-1-2\">\n                        <button class=\"flex items-center gap-2 border border-[#475569] px-4 py-2.5 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-1-2-1\">\n                            <i class=\"ti ti-download text-[15px] text-[#38BDF8]\" data-kid=\"2-1-3-2-1-2-1-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Exportar\n                        </button>\n                        <button class=\"flex items-center gap-2 bg-[#38BDF8] px-4 py-2.5 text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-2-1-2-2\">\n                            <i class=\"ti ti-user-plus text-[15px]\" data-kid=\"2-1-3-2-1-2-2-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Nuevo usuario\n                        </button>\n                    </div>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 border-y border-[#334155] py-4\" data-kid=\"2-1-3-2-2\" data-name=\"users filters toolbar\">\n                    <div class=\"flex min-w-0 flex-1 items-center gap-3\" data-kid=\"2-1-3-2-2-1\">\n                        <div class=\"flex h-11 min-w-0 flex-1 items-center gap-3 border border-[#475569] bg-[#111C2E] px-3 text-[13px] text-[#64748B]\" data-kid=\"2-1-3-2-2-1-1\">\n                            <i class=\"ti ti-search text-[17px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span data-kid=\"2-1-3-2-2-1-1-2\">\n                                Buscar por nombre o correo\n                            </span>\n                        </div>\n                        <button class=\"flex h-11 shrink-0 items-center gap-3 border border-[#475569] px-3 text-[12px] font-medium text-[#CBD5E1]\" data-kid=\"2-1-3-2-2-1-2\">\n                            <i class=\"ti ti-chevron-down text-[14px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Todos los roles\n                        </button>\n                        <button class=\"flex h-11 shrink-0 items-center gap-3 border border-[#475569] px-3 text-[12px] font-medium text-[#CBD5E1]\" data-kid=\"2-1-3-2-2-1-3\">\n                            <i class=\"ti ti-adjustments-horizontal text-[15px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-3-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Estado\n                        </button>\n                    </div>\n                    <span class=\"shrink-0 text-[12px] font-semibold tabular-nums text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-2\" data-name=\"total users count label\" data-reason=\"text content updated by backend state\">\n                        1,284 usuarios\n                    </span>\n                </div>\n                <div class=\"mt-5 overflow-hidden border-y border-[#475569]\" data-kid=\"2-1-3-2-3\" data-name=\"users data table\">\n                    <div class=\"grid grid-cols-[minmax(260px,1.8fr)_1fr_1fr_1.1fr_72px] items-center border-b border-[#334155] bg-[#111C2E] px-5 py-3 text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-3-2-3-1\" data-name=\"table header\">\n                        <div data-kid=\"2-1-3-2-3-1-1\">\n                            Usuario\n                        </div>\n                        <div data-kid=\"2-1-3-2-3-1-2\">\n                            Rol\n                        </div>\n                        <div data-kid=\"2-1-3-2-3-1-3\">\n                            Estado\n                        </div>\n                        <div data-kid=\"2-1-3-2-3-1-4\">\n                            Último acceso\n                        </div>\n                        <div class=\"text-right\" data-kid=\"2-1-3-2-3-1-5\">\n                            Acciones\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-[minmax(260px,1.8fr)_1fr_1fr_1.1fr_72px] items-center border-b border-[#334155] px-5 py-4\" data-kid=\"2-1-3-2-3-2\" data-name=\"Juan Perez user row\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-3-2-1\">\n                            <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#075985] text-[12px] font-bold text-[#BAE6FD]\" data-kid=\"2-1-3-2-3-2-1-1\">\n                                JP\n                            </div>\n                            <div data-kid=\"2-1-3-2-3-2-1-2\">\n                                <div class=\"text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"2-1-3-2-3-2-1-2-1\">\n                                    Juan Pérez\n                                </div>\n                                <div class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-2-2\">\n                                    juan.perez@autodoc.co\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"text-[12px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-2-2\">\n                            Propietario\n                        </div>\n                        <div class=\"flex items-center gap-2 text-[12px] font-semibold text-[#6EE7B7]\" data-kid=\"2-1-3-2-3-2-3\">\n                            <i class=\"ti ti-circle-check-filled text-[14px]\" data-kid=\"2-1-3-2-3-2-3-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Activo\n                        </div>\n                        <div class=\"text-[12px] tabular-nums text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-3-2-4\" data-name=\"Juan Perez last access timestamp\" data-reason=\"text content updated by backend state\">\n                            Hoy · 09:42\n                        </div>\n                        <div class=\"flex justify-end\" data-kid=\"2-1-3-2-3-2-5\">\n                            <button aria-label=\"Más acciones para Juan Pérez\" class=\"flex h-9 w-9 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-3-2-3-2-5-1\">\n                                <i class=\"ti ti-dots-vertical text-[18px]\" data-kid=\"2-1-3-2-3-2-5-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-[minmax(260px,1.8fr)_1fr_1fr_1.1fr_72px] items-center border-b border-[#334155] px-5 py-4\" data-kid=\"2-1-3-2-3-3\" data-name=\"Maria Rodriguez user row\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-3-3-1\">\n                            <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#4338CA] text-[12px] font-bold text-[#E0E7FF]\" data-kid=\"2-1-3-2-3-3-1-1\">\n                                MR\n                            </div>\n                            <div data-kid=\"2-1-3-2-3-3-1-2\">\n                                <div class=\"text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"2-1-3-2-3-3-1-2-1\">\n                                    María Rodríguez\n                                </div>\n                                <div class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-3-1-2-2\">\n                                    maria.rodriguez@tallerrapido.co\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"text-[12px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-3-2\">\n                            Mecánico\n                        </div>\n                        <div class=\"flex items-center gap-2 text-[12px] font-semibold text-[#6EE7B7]\" data-kid=\"2-1-3-2-3-3-3\">\n                            <i class=\"ti ti-shield-check-filled text-[14px]\" data-kid=\"2-1-3-2-3-3-3-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Aprobado\n                        </div>\n                        <div class=\"text-[12px] tabular-nums text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-3-3-4\" data-name=\"Maria Rodriguez last access timestamp\" data-reason=\"text content updated by backend state\">\n                            Hace 2 h\n                        </div>\n                        <div class=\"flex justify-end\" data-kid=\"2-1-3-2-3-3-5\">\n                            <button aria-label=\"Más acciones para María Rodríguez\" class=\"flex h-9 w-9 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-3-2-3-3-5-1\">\n                                <i class=\"ti ti-dots-vertical text-[18px]\" data-kid=\"2-1-3-2-3-3-5-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-[minmax(260px,1.8fr)_1fr_1fr_1.1fr_72px] items-center px-5 py-4\" data-kid=\"2-1-3-2-3-4\" data-name=\"Suspicious account row\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-3-4-1\">\n                            <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#7F1D1D] text-[12px] font-bold text-[#FCA5A5]\" data-kid=\"2-1-3-2-3-4-1-1\">\n                                ?\n                            </div>\n                            <div data-kid=\"2-1-3-2-3-4-1-2\">\n                                <div class=\"text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"2-1-3-2-3-4-1-2-1\">\n                                    Cuenta sospechosa\n                                </div>\n                                <div class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-4-1-2-2\">\n                                    revisión.manual@autodoc.co\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"text-[12px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-4-2\">\n                            Propietario\n                        </div>\n                        <div class=\"flex items-center gap-2 text-[12px] font-semibold text-[#FCA5A5]\" data-kid=\"2-1-3-2-3-4-3\">\n                            <i class=\"ti ti-ban text-[14px]\" data-kid=\"2-1-3-2-3-4-3-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Suspendido\n                        </div>\n                        <div class=\"text-[12px] tabular-nums text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-3-4-4\" data-name=\"Suspicious account last access timestamp\" data-reason=\"text content updated by backend state\">\n                            Hace 44 min\n                        </div>\n                        <div class=\"flex justify-end\" data-kid=\"2-1-3-2-3-4-5\">\n                            <button aria-label=\"Más acciones para cuenta sospechosa\" class=\"flex h-9 w-9 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-3-2-3-4-5-1\">\n                                <i class=\"ti ti-dots-vertical text-[18px]\" data-kid=\"2-1-3-2-3-4-5-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex items-center justify-between border-b border-[#334155] py-5\" data-kid=\"2-1-3-2-4\" data-name=\"users table footer\">\n                    <span class=\"text-[12px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-4-1\" data-name=\"pagination status summary text\" data-reason=\"text content updated by backend state\">\n                        Mostrando 1–3 de 1,284 usuarios\n                    </span>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-4-2\">\n                        <button aria-label=\"Página anterior\" class=\"flex h-9 w-9 items-center justify-center border border-[#475569] text-[#64748B]\" data-kid=\"2-1-3-2-4-2-1\">\n                            <i class=\"ti ti-chevron-left text-[16px]\" data-kid=\"2-1-3-2-4-2-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                        <button aria-label=\"Página 1\" class=\"flex h-9 w-9 items-center justify-center bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-2-4-2-2\">\n                            1\n                        </button>\n                        <button aria-label=\"Página 2\" class=\"flex h-9 w-9 items-center justify-center border border-[#475569] text-[12px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-2-3\">\n                            2\n                        </button>\n                        <button aria-label=\"Página siguiente\" class=\"flex h-9 w-9 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-2-4\">\n                            <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-1-3-2-4-2-4-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"mt-6 flex items-center gap-3 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-5\" data-name=\"empty state hint\">\n                    <i class=\"ti ti-info-circle text-[16px] text-[#38BDF8]\" data-kid=\"2-1-3-2-5-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-3-2-5-2\">\n                        Si no encuentras una cuenta, revisa los filtros avanzados o crea un nuevo usuario.\n                    </span>\n                </div>\n                <footer class=\"mt-7 flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-6\" data-name=\"admin users footer\">\n                    <span data-kid=\"2-1-3-2-6-1\">\n                        AutoDoc · Consola de administración\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-6-2\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-6-2-1\">\n                        </span>\n                        Datos sincronizados hace 2 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
