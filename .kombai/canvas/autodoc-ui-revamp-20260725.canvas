>\n                            <div class=\"h-full min-h-[92px] bg-[#FBBF24]\" data-kid=\"2-1-3-2-4-1-2-2\">\n                            </div>\n                            <div class=\"flex items-start gap-4\" data-kid=\"2-1-3-2-4-1-2-3\">\n                                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center border border-[#FBBF24]/50 bg-[#3F3212] text-[#FBBF24]\" data-kid=\"2-1-3-2-4-1-2-3-1\">\n                                    <i class=\"ti ti-tool text-[20px]\" data-kid=\"2-1-3-2-4-1-2-3-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </div>\n                                <div data-kid=\"2-1-3-2-4-1-2-3-2\">\n                                    <div class=\"mb-1 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#FCD34D]\" data-kid=\"2-1-3-2-4-1-2-3-2-1\">\n                                        <span data-kid=\"2-1-3-2-4-1-2-3-2-1-1\">\n                                            Preventiva\n                                        </span>\n                                        <span class=\"h-1 w-1 rounded-full bg-[#FBBF24]\" data-kid=\"2-1-3-2-4-1-2-3-2-1-2\">\n                                        </span>\n                                        <span data-kid=\"2-1-3-2-4-1-2-3-2-1-3\">\n                                            Frenos\n                                        </span>\n                                    </div>\n                                    <h3 class=\"text-[16px] font-bold text-[#F8FAFC]\" data-kid=\"2-1-3-2-4-1-2-3-2-2\">\n                                        Pastillas de freno próximas\n                                    </h3>\n                                    <p class=\"mt-1 text-[13px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-1-2-3-2-3\">\n                                        Toyota Corolla 2022\n                                        <span class=\"text-[#64748B]\" data-kid=\"2-1-3-2-4-1-2-3-2-3-1\">\n                                            ·\n                                        </span>\n                                        P 482-916\n                                    </p>\n                                    <p class=\"mt-2 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-2-3-2-4\">\n                                        Revisar en\n                                        <strong class=\"tabular-nums text-[#FCD34D]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-4-1-2-3-2-4-1\" data-name=\"preventive threshold distance\" data-reason=\"distance value updated by backend data\">\n                                            420 km\n                                        </strong>\n                                        .\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-2-4\">\n                                <div class=\"mb-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-1-3-2-4-1-2-4-1\">\n                                    Próxima revisión\n                                </div>\n                                <div class=\"font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-4-1-2-4-2\">\n                                    En 12 días\n                                </div>\n                                <div class=\"mt-1\" data-kid=\"2-1-3-2-4-1-2-4-3\">\n                                    06 ago 2026\n                                </div>\n                            </div>\n                            <button class=\"flex min-h-[48px] items-center justify-center gap-2 rounded-full border border-[#FBBF24]/60 bg-[#3F3212] px-4 py-3 text-[12px] font-bold text-[#FCD34D] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#523F16] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-3-2-4-1-2-1\" data-name=\"schedule preventive service button\">\n                                Agendar servicio\n                                <i class=\"ti ti-calendar-plus text-[15px]\" data-kid=\"2-1-3-2-4-1-2-1-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </article>\n                        <article class=\"grid grid-cols-[4px_minmax(0,1fr)_150px_150px] items-center gap-5 py-5\" data-kid=\"2-1-3-2-4-1-3\" data-name=\"informational alert row\">\n                            <div class=\"h-full min-h-[92px] bg-[#38BDF8]\" data-kid=\"2-1-3-2-4-1-3-2\">\n                            </div>\n                            <div class=\"flex items-start gap-4\" data-kid=\"2-1-3-2-4-1-3-3\">\n                                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center border border-[#38BDF8]/50 bg-[#082F49] text-[#38BDF8]\" data-kid=\"2-1-3-2-4-1-3-3-1\">\n                                    <i class=\"ti ti-file-alert text-[20px]\" data-kid=\"2-1-3-2-4-1-3-3-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </div>\n                                <div data-kid=\"2-1-3-2-4-1-3-3-2\">\n                                    <div class=\"mb-1 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#7DD3FC]\" data-kid=\"2-1-3-2-4-1-3-3-2-1\">\n                                        <span data-kid=\"2-1-3-2-4-1-3-3-2-1-1\">\n                                            Informativa\n                                        </span>\n                                        <span class=\"h-1 w-1 rounded-full bg-[#38BDF8]\" data-kid=\"2-1-3-2-4-1-3-3-2-1-2\">\n                                        </span>\n                                        <span data-kid=\"2-1-3-2-4-1-3-3-2-1-3\">\n                                            Perfil\n                                        </span>\n                                    </div>\n                                    <h3 class=\"text-[16px] font-bold text-[#F8FAFC]\" data-kid=\"2-1-3-2-4-1-3-3-2-2\">\n                                        Perfil de vehículo incompleto\n                                    </h3>\n                                    <p class=\"mt-1 text-[13px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-1-3-3-2-3\">\n                                        Renault Duster 2021\n                                        <span class=\"text-[#64748B]\" data-kid=\"2-1-3-2-4-1-3-3-2-3-1\">\n                                            ·\n                                        </span>\n                                        J 204-118\n                                    </p>\n                                    <p class=\"mt-2 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-3-3-2-4\">\n                                        Completa la ficha para activar recordatorios de kilometraje y vencimientos.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-3-4\">\n                                <div class=\"mb-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-1-3-2-4-1-3-4-1\">\n                                    Actualización\n                                </div>\n                                <div class=\"font-semibold text-[#7DD3FC]\" data-kid=\"2-1-3-2-4-1-3-4-2\">\n                                    Sin datos recientes\n                                </div>\n                                <div class=\"mt-1\" data-kid=\"2-1-3-2-4-1-3-4-3\">\n                                    18 jul 2026\n                                </div>\n                            </div>\n                            <button class=\"flex min-h-[48px] items-center justify-center gap-2 rounded-full border border-[#38BDF8]/60 bg-[#082F49] px-4 py-3 text-[12px] font-bold text-[#7DD3FC] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#0C4567] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-3-2-4-1-3-1\" data-name=\"complete vehicle profile button\">\n                                Completar ficha\n                                <i class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"2-1-3-2-4-1-3-1-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </article>\n                    </div>\n                </section>\n                <footer class=\"mt-8 flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-5\" data-name=\"alerts footer\">\n                    <span data-kid=\"2-1-3-2-5-1\">\n                        AutoDoc · Alertas de mantenimiento para tu vehículo\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-5-2\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-5-2-1\">\n                        </span>\n                        Última sincronización hace 8 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
