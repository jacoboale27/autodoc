        "h": 812
      },
      "html": "<style data-name=\"AppButton AppCard AppMotion tokens\">\n    button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]) {\n    min-height: 48px;\n    border-radius: 999px !important;\n    transition: transform 150ms cubic-bezier(.23,1,.32,1), box-shadow 150ms ease-out, background-color 150ms ease-out, color 150ms ease-out;\n  }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]):hover { transform: scale(1.02); }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]):active { transform: scale(.97); }\n  [data-name=\"mobile header controls\"] button, [data-name=\"mobile map panel\"] button {\n    min-width: 44px !important;\n    min-height: 44px !important;\n    border-radius: 999px !important;\n    border: 1px solid #CBD5E1 !important;\n    background: #EEEDF0 !important;\n    box-shadow: 0 2px 4px rgba(15,23,42,.05) !important;\n  }\n  [data-kid=\"2-2-1-4\"], [data-name=\"contact button\"] {\n    border-radius: 999px !important;\n    min-height: 48px !important;\n    background: linear-gradient(135deg,#522C81,#45256E) !important;\n    color: #FFFFFF !important;\n    box-shadow: 0 2px 4px rgba(15,23,42,.05) !important;\n  }\n  [data-name=\"recommended workshops section\"], [data-name=\"selected workshop card\"], [data-name=\"workshop card\"], [data-name=\"mobile map panel\"] {\n    border-radius: 16px !important;\n    border: 1px solid #CBD5E1 !important;\n    background: #EEEDF0 !important;\n    box-shadow: 0 2px 4px rgba(15,23,42,.05) !important;\n    overflow: hidden;\n  }\n  [data-name=\"selected workshop card\"] { border-left: 4px solid #1E88E5 !important; }\n  a:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]) { transition: color 150ms ease-out; }\n  @media (prefers-reduced-motion: reduce) { button, a { transition: none !important; } }\n</style>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .map-surface { background-color: #E8EEF4; }\n  .map-road { position: absolute; background: #FFFFFF; border: 1px solid #D5DEE8; }\n  .map-park { position: absolute; background: #D8E8DF; border: 1px solid #C2DACC; }\n  .map-water { position: absolute; background: #C9E4F1; border: 1px solid #B0D6E8; }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"workshop directory mobile page\">\n    <header class=\"sticky top-0 z-30 flex h-[68px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"compact mobile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2-1\">\n                    Propietario\n                </p>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-2-2\">\n                    <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-1-1-2-2-1\">\n                    </span>\n                    <p class=\"truncate font-heading text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-1-1-2-2-2\">\n                        Talleres\n                    </p>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header controls\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-[9px] top-[8px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-2\" data-name=\"toggle dark mode button\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-2-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <div aria-label=\"Juan Pérez\" class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3\">\n                JP\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[520px] px-4 pb-28 pt-5\" data-kid=\"2-2\" data-name=\"directory mobile content\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"directory heading\">\n            <div class=\"mb-2 flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1-1\">\n                <span data-kid=\"2-2-1-1-1\">\n                    Propietario\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-1-2\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-1-3\">\n                    Talleres\n                </span>\n            </div>\n            <h1 class=\"font-heading text-[27px] font-extrabold leading-[1.1] tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2\">\n                Talleres cerca de ti\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-3\">\n                Encuentra un equipo confiable para el siguiente servicio de tu vehículo.\n            </p>\n            <button class=\"mt-4 flex min-h-[44px] w-full items-center justify-center gap-2 border border-[#1E88E5] bg-white px-4 py-2.5 text-[13px] font-semibold text-[#1E88E5]\" data-kid=\"2-2-1-4\" data-name=\"use location button\">\n                <i class=\"ti ti-current-location text-[17px]\" data-kid=\"2-2-1-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Usar mi ubicación\n            </button>\n        </div>\n        <section aria-label=\"Buscar y filtrar talleres\" class=\"mb-5 space-y-2\" data-kid=\"2-2-2\" data-name=\"mobile search and filters\">\n            <div class=\"flex min-h-[48px] items-center gap-3 border border-[#CBD5E1] bg-white px-4 text-[13px] text-[#94A3B8]\" data-kid=\"2-2-2-1\">\n                <i class=\"ti ti-search shrink-0 text-[18px] text-[#64748B]\" data-kid=\"2-2-2-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"truncate\" data-kid=\"2-2-2-1-2\">\n                    Buscar talleres, servicios o ciudad\n                </span>\n            </div>\n            <div class=\"grid grid-cols-3 gap-2\" data-kid=\"2-2-2-2\">\n                <button class=\"flex min-h-[44px] min-w-0 items-center justify-center gap-1 border border-[#CBD5E1] bg-white px-2 text-[10px] font-semibold text-[#334155]\" data-kid=\"2-2-2-2-1\" data-name=\"sort by distance button\">\n                    <i class=\"ti ti-arrows-sort shrink-0 text-[15px] text-[#1E88E5]\" data-kid=\"2-2-2-2-1-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"2-2-2-2-1-2\">\n                        Distancia\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-2-1-3\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-[44px] min-w-0 items-center justify-center gap-1 border border-[#CBD5E1] bg-white px-2 text-[10px] font-semibold text-[#334155]\" data-kid=\"2-2-2-2-2\" data-name=\"sort by rating button\">\n                    <i class=\"ti ti-star shrink-0 text-[15px] text-[#F59E0B]\" data-kid=\"2-2-2-2-2-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"2-2-2-2-2-2\">\n                        Calificación\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-2-2-3\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-[44px] min-w-0 items-center justify-center gap-1 border border-[#CBD5E1] bg-white px-2 text-[10px] font-semibold text-[#334155]\" data-kid=\"2-2-2-2-3\" data-name=\"sort by specialty button\">\n                    <i class=\"ti ti-adjustments-horizontal shrink-0 text-[15px] text-[#1E88E5]\" data-kid=\"2-2-2-2-3-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"2-2-2-2-3-2\">\n                        Especialidad\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-2-3-3\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <div class=\"mb-4 flex flex-col gap-2 text-[12px]\" data-kid=\"2-2-3\" data-name=\"directory result summary\">\n            <p class=\"font-medium text-[#64748B]\" data-kid=\"2-2-3-1\">\n                Bogotá, Colombia · 12 resultados\n            </p>\n            <span class=\"inline-flex items-center gap-2 text-[#10B981]\" data-dynamic=\"true\" data-kid=\"2-2-3-2\" data-name=\"map update status indicator\" data-reason=\"text updated to reflect relative time\">\n                <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-2-3-2-1\">\n                </span>\n                Mapa actualizado hace 2 min\n            </span>\n        </div>\n        <section aria-labelledby=\"workshop-list-heading\" class=\"overflow-hidden border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4\" data-name=\"recommended workshops section\">\n            <div class=\"flex items-center justify-between border-b border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-4-1\">\n                <h2 class=\"font-heading text-[16px] font-bold tracking-[-0.02em] text-[#0F172A]\" data-kid=\"2-2-4-1-1\" id=\"workshop-list-heading\">\n                    Talleres recomendados\n                </h2>\n                <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-4-1-2\">\n                    12 cerca\n                </span>\n            </div>\n            <div class=\"divide-y divide-[#E2E8F0]\" data-kid=\"2-2-4-2\" data-name=\"workshop list cards\">\n                <article class=\"bord