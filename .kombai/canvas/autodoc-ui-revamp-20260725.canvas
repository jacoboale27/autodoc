    "var_09f89342171d": {
      "type": "variant",
      "label": "AutoDoc Profile — Hadrian Dark Mobile",
      "parentId": "var_b5202379f6b0",
      "themeId": null,
      "rect": {
        "x": 19930,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    [data-name=\"Mobile theme toggle button\"], [data-name=\"Mobile notifications button\"] { min-width:44px; min-height:44px; border-radius:999px; border:1px solid #334155; background:#141E36; color:#CBD5E1; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"Mobile theme toggle button\"]:hover, [data-name=\"Mobile notifications button\"]:hover { background:#1E293B; color:#81E6D9; box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"Mobile theme toggle button\"]:active, [data-name=\"Mobile notifications button\"]:active { transform:scale(.97); }\n  [data-name=\"Mobile profile owner header\"], [data-name=\"Mobile preferences list\"] { overflow:hidden; border:1px solid rgba(51,65,85,.2); border-radius:16px; background:#141E36; box-shadow:0 2px 4px rgba(0,0,0,.2); }\n  [data-name=\"Mobile change photo button\"], [data-name=\"Language selector button\"] { min-height:48px; border-radius:999px; border:1px solid #334155; background:#141E36; color:#CBD5E1; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"Mobile change photo button\"]:hover, [data-name=\"Language selector button\"]:hover { background:#1E293B; color:#81E6D9; box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"Mobile change photo button\"]:active, [data-name=\"Language selector button\"]:active { transform:scale(.97); }\n  [data-name=\"Mobile owner role selection button\"] { border-radius:16px; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"Mobile owner role selection button\"]:hover { transform:scale(1.01); box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"Mobile owner role selection button\"]:active { transform:scale(.99); }\n  [data-name=\"Cancel button\"] { min-height:48px; border-radius:999px; border:1px solid #334155; background:#141E36; color:#CBD5E1; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"Cancel button\"]:hover { background:#1E293B; box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"Cancel button\"]:active { transform:scale(.97); }\n  [data-name=\"Save changes button\"] { min-height:48px; border-radius:999px; background:linear-gradient(135deg,#81E6D9,#6FC8BC); color:#0F172A; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"Save changes button\"]:hover { transform:scale(1.02); box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"Save changes button\"]:active { transform:scale(.97); }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"Mobile profile application root\">\n    <header class=\"sticky top-0 z-20 flex min-h-[68px] items-center justify-between border-b border-[#334155] bg-[#0B1220]/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"Mobile profile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"Mobile profile context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-[12px] bg-[#38BDF8] text-[17px] text-[#082F49] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc mobile mark\">\n                <span class=\"font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc brand initials\">\n                    AD\n                </span>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"Mobile user context\">\n                <p class=\"truncate text-[10px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"Context label text\">\n                    Propietario\n                </p>\n                <p class=\"truncate text-[15px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-1-2-2\" data-name=\"Context title text\">\n                    Mi perfil\n                </p>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"Mobile header controls\">\n            <button aria-label=\"Cambiar tema\" class=\"grid min-h-11 min-w-11 place-items-center border border-[#475569] text-[18px] text-[#94A3B8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-2-1\" data-name=\"Mobile theme toggle button\" type=\"button\">\n                <i class=\"ti ti-sun-moon\" data-kid=\"2-1-2-1-1\" data-name=\"Sun-moon icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative grid min-h-11 min-w-11 place-items-center border border-[#475569] text-[18px] text-[#CBD5E1] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-2-2\" data-name=\"Mobile notifications button\" type=\"button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-2-2\" data-name=\"Bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-1\" data-name=\"Mobile notification indicator\">\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"min-w-0 px-4 pb-[calc(104px+env(safe-area-inset-bottom))] pt-6\" data-kid=\"2-2\" data-name=\"Mobile profile content\" style=\"padding-bottom:calc(104px + env(safe-area-inset-bottom))\">\n        <div class=\"border-b border-[#334155] pb-6\" data-kid=\"2-2-1\" data-name=\"Mobile profile heading\">\n            <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-2-1-2\" data-name=\"Mobile heading details\">\n                <div class=\"min-w-0\" data-kid=\"2-2-1-2-1\" data-name=\"Heading text block\">\n                    <p class=\"mb-2 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-2-1-2-1-1\" data-name=\"Breadcrumb navigation\">\n                        Propietario /\n                        <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-2-1-1-1\" data-name=\"Active page breadcrumb\">\n                            Mi perfil\n                        </span>\n                    </p>\n                    <h1 class=\"font-heading text-[28px] font-extrabold tracking-[-0.045em] text-white\" data-kid=\"2-2-1-2-1-2\" data-name=\"Main page title\">\n                        Mi perfil\n                    </h1>\n                    <p class=\"mt-2 max-w-[250px] text-[13px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-2-1-3\" data-name=\"Page description text\">\n                        Mantén tus datos y preferencias al día.\n                    </p>\n                </div>\n                <div class=\"shrink-0 pt-1 text-right\" data-kid=\"2-2-1-1\" data-name=\"Mobile completion progress\">\n                    <div class=\"text-[9px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-1-1-1\" data-name=\"Completion status text\">\n                        Perfil completo\n                    </div>\n                    <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-2-1-1-2\" data-name=\"Progress bar container\">\n                        <div class=\"h-1.5 w-16 bg-[#334155]\" data-kid=\"2-2-1-1-2-1\" data-name=\"Background progress track\">\n                            <div class=\"h-1.5 w-[80%] bg-[#38BDF8]\" data-kid=\"2-2-1-1-2-1-1\" data-name=\"Active progress fill\">\n                            </div>\n                        </div>\n                        <span class=\"text-[12px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-1-1-2-2\" data-name=\"Completion percentage text\">\n                            80%\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <section aria-labelledby=\"profile-owner-heading\" class=\"border-b border-[#334155] py-6\" data-kid=\"2-2-2\" data-name=\"Mobile profile owner header\">\n            <div class=\"flex items-center gap-3\" data-kid=\"2-2-2-1\" data-name=\"Mobile owner identity\">\n                <div class=\"grid size-14 shrink-0 place-items-center rounded-full bg-[#38BDF8] text-[18px] font-extrabold text-[#082F49] font-heading\" data-kid=\"2-2-2-1-1\" data-name=\"Mobile large avatar initials\">\n                    JP\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-2-2-1-2\" data-name=\"Owner name details\">\n                    <h2 class=\"font-heading truncate text-[18px] font-bold tracking-[-0.025em] text-white\" data-kid=\"2-2-2-1-2-1\" data-name=\"Owner full name heading\" id=\"profile-owner-heading\">\n                        Juan Pérez\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-1-2-2\" data-name=\"Account type label\">\n                        Cuenta personal\n                    </p>\n                </div>\n            </div>\n            <button class=\"mt-4 flex min-h-11 w-full items-center justify-center gap-2 border border-[#475569] px-4 py-2.5 text-[12px] font-semibold text-[#E2E8F0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-2-2-2\" data-name=\"Mobile change photo button\" type=\"button\">\n                <i class=\"ti ti-camera text-[16px] text-[#38BDF8]\" data-kid=\"2-2-2-2-1\" data-name=\"Camera icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Cambiar foto\n            </button>\n        </section>\n        <form aria-label=\"Editar perfil\" class=\"pt-6\" data-kid=\"2-2-3\" data-name=\"Mobile profile settings form\">\n            <section aria-labelledby=\"personal-data-title\" data-kid=\"2-2-3-1\" data-name=\"Mobile personal data section\">\n                <div class=\"mb-4\" data-kid=\"2-2-3-1-2\" data-name=\"Personal data header\">\n                    <h3 class=\"font-heading text-[17px] font-bold text-white\" data-kid=\"2-2-3-1-2-1\" data-name=\"Personal data title\" id=\"personal-data-title\">\n                        Datos personales\n                    </h3>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-3-1-2-2\" data-name=\"Personal data description\">\n                        Información que usaremos para identificarte y contactarte.\n                    </p>\n                </div>\n                <div class=\"space-y-4\" data-kid=\"2-2-3-1-1\" data-name=\"Mobile personal data fields\">\n                    <label class=\"block\" data-kid=\"2-2-3-1-1-1\" data-name=\"Full name field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-3-1-1-1-1\" data-name=\"Field label\">\n                            Nombre completo\n                        </span>\n                        <input class=\"min-h-11 w-full border border-[#475569] bg-[#1E293B] px-3.5 text-[13px] text-white outline-none placeholder:text-[#64748B] focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8]\" data-kid=\"2-2-3-1-1-1-2\" data-name=\"Full name input\" value=\"Juan Pérez\"/>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-2-3-1-1-2\" data-name=\"Email field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-3-1-1-2-1\" data-name=\"Email field label\">\n                            Correo electrónico\n                        </span>\n                        <div class=\"relative\" data-kid=\"2-2-3-1-1-2-2\" data-name=\"Email input container\">\n                            <input class=\"min-h-11 w-full border border-[#34D399] bg-[#1E293B] px-3.5 pr-10 text-[13px] text-white outline-none placeholder:text-[#64748B] focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8]\" data-kid=\"2-2-3-1-1-2-2-1\" data-name=\"Email input field\" value=\"juan.perez@email.com\"/>\n                            <i aria-hidden=\"true\" class=\"ti ti-circle-check absolute right-3 top-1/2 -translate-y-1/2 text-[17px] text-[#34D399]\" data-kid=\"2-2-3-1-1-2-2-2\" data-name=\"Verified checkmark icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <span class=\"mt-1.5 block text-[11px] text-[#6EE7B7]\" data-kid=\"2-2-3-1-1-2-3\" data-name=\"Verified status message\">\n                            Correo verificado\n                        </span>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-2-3-1-1-3\" data-name=\"Phone number field\">\n                        <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-3-1-1-3-1\" data-name=\"Phone label\">\n                            Teléfono\n                        </span>\n                        <input class=\"min-h-11 w-full border border-[#475569] bg-[#1E293B] px-3.5 text-[13px] text-white outline-none placeholder:text-[#64748B] focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8]\" data-kid=\"2-2-3-1-1-3-2\" data-name=\"Phone input field\" value=\"+57 300 555 0182\"/>\n                        <span class=\"mt-1.5 block text-[11px] text-[#94A3B8]\" data-kid=\"2-2-3-1-1-3-3\" data-name=\"Phone help text\">\n                            Incluye el indicativo de tu país.\n                        </span>\n                    </label>\n                </div>\n            </section>\n            <section aria-labelledby=\"preferences-title\" class=\"mt-7 border-t border-[#334155] pt-6\" data-kid=\"2-2-3-2\" data-name=\"Mobile preferences section\">\n                <div class=\"mb-4\" data-kid=\"2-2-3-2-2\" data-name=\"Preferences header\">\n                    <h3 class=\"font-heading text-[17px] font-bold text-white\" data-kid=\"2-2-3-2-2-1\" data-name=\"Preferences title\" id=\"preferences-title\">\n                        Preferencias\n                    </h3>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-3-2-2-2\" data-name=\"Preferences description\">\n                        Controla cómo se adapta AutoDoc a tu forma de usarlo.\n                    </p>\n                </div>\n                <div class=\"divide-y divide-[#334155] border-y border-[#334155]\" data-kid=\"2-2-3-2-1\" data-name=\"Mobile preferences list\">\n                    <div class=\"flex min-h-[72px] items-center justify-between gap-4 py-3\" data-kid=\"2-2-3-2-1-1\" data-name=\"Language preference item\">\n                        <div class=\"min-w-0\" data-kid=\"2-2-3-2-1-1-1\" data-name=\"Language label container\">\n                            <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-1-1-1-1\" data-name=\"Language label\">\n                                Idioma\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-3-2-1-1-1-2\" data-name=\"Selected language text\">\n                                Español\n                            </div>\n                        </div>\n                        <button aria-label=\"Cambiar idioma\" class=\"grid min-h-11 min-w-11 shrink-0 place-items-center text-[17px] text-[#94A3B8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-2-3-2-1-1-2\" data-name=\"Language selector button\" type=\"button\">\n                            <i class=\"ti ti-chevron-down\" data-kid=\"2-2-3-2-1-1-2-1\" data-name=\"Chevron icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"flex min-h-[72px] items-center justify-between gap-4 py-3\" data-kid=\"2-2-3-2-1-2\" data-name=\"Appearance mode item\">\n                        <div class=\"min-w-0\" data-kid=\"2-2-3-2-1-2-1\" data-name=\"Appearance label container\">\n                            <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-1-2-1-1\" data-name=\"Appearance label\">\n                                Modo de apariencia\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-3-2-1-2-1-2\" data-name=\"Selected appearance text\">\n                                Oscuro\n                            </div>\n                        </div>\n                        <button aria-checked=\"true\" aria-label=\"Modo oscuro activado\" class=\"relative h-6 w-11 shrink-0 rounded-full bg-[#38BDF8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-2-3-2-1-2-2\" data-name=\"Dark mode toggle switch\" role=\"switch\" type=\"button\">\n                            <span class=\"absolute right-1 top-1 h-4 w-4 rounded-full bg-[#082F49]\" data-kid=\"2-2-3-2-1-2-2-1\" data-name=\"Toggle switch handle\">\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"flex min-h-[80px] items-center justify-between gap-4 py-3\" data-kid=\"2-2-3-2-1-3\" data-name=\"Notifications preference item\">\n                        <div class=\"min-w-0\" data-kid=\"2-2-3-2-1-3-1\" data-name=\"Notifications label container\">\n                            <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-1-3-1-1\" data-name=\"Notifications label\">\n                                Notificaciones\n                            </div>\n                            <div class=\"mt-1 max-w-[220px] text-[11px] leading-4 text-[#6EE7B7]\" data-kid=\"2-2-3-2-1-3-1-2\" data-name=\"Notifications status text\">\n                                Activadas para alertas de mantenimiento\n                            </div>\n                        </div>\n                        <button aria-checked=\"true\" aria-label=\"Notificaciones activadas\" class=\"relative h-6 w-11 shrink-0 rounded-full bg-[#34D399] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-2-3-2-1-3-2\" data-name=\"Notifications toggle switch\" role=\"switch\" type=\"button\">\n                            <span class=\"absolute right-1 top-1 h-4 w-4 rounded-full bg-[#064E3B]\" data-kid=\"2-2-3-2-1-3-2-1\" data-name=\"Notifications toggle handle\">\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"role-title\" class=\"mt-7 border-t border-[#334155] pt-6\" data-kid=\"2-2-3-3\" data-name=\"Mobile role selection section\">\n                <div class=\"mb-4\" data-kid=\"2-2-3-3-2\" data-name=\"Role selection header\">\n                    <h3 class=\"font-heading text-[17px] font-bold text-white\" data-kid=\"2-2-3-3-2-1\" data-name=\"Role section title\" id=\"role-title\">\n                        Tu rol en AutoDoc\n                    </h3>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-3-3-2-2\" data-name=\"Role section description\">\n                        Define qué herramientas aparecen en tu espacio de trabajo.\n                    </p>\n                </div>\n                <button aria-pressed=\"true\" class=\"flex min-h-[96px] w-full items-start justify-between gap-3 border border-[#38BDF8] bg-[#082F49]/45 px-4 py-4 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-2-3-3-1\" data-name=\"Mobile owner role selection button\" type=\"button\">\n                    <span class=\"flex min-w-0 items-start gap-3\" data-kid=\"2-2-3-3-1-1\" data-name=\"Selected role content\">\n                        <span class=\"mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full border border-[#38BDF8] bg-[#38BDF8] text-[#082F49]\" data-kid=\"2-2-3-3-1-1-1\" data-name=\"Checkmark icon container\">\n                            <i class=\"ti ti-check text-[13px]\" data-kid=\"2-2-3-3-1-1-1-1\" data-name=\"Checkmark icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <span class=\"min-w-0\" data-kid=\"2-2-3-3-1-1-2\" data-name=\"Role text details\">\n                            <span class=\"block text-[14px] font-bold text-white\" data-kid=\"2-2-3-3-1-1-2-1\" data-name=\"Role title\">\n                                Propietario\n                            </span>\n                            <span class=\"mt-1 block text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-3-3-1-1-2-2\" data-name=\"Role description\">\n                                Gestiona vehículos, mantenimientos, talleres y conversaciones.\n                            </span>\n                        </span>\n                    </span>\n                    <span class=\"shrink-0 text-[10px] font-semibold text-[#7DD3FC]\" data-kid=\"2-2-3-3-1-2\" data-name=\"Role selected label\">\n                        Seleccionado\n                    </span>\n                </button>\n            </section>\n            <div class=\"mt-7 border-t border-[#334155] pt-6\" data-kid=\"2-2-3-4\" data-name=\"Mobile profile form actions\">\n                <div class=\"flex items-start gap-2 text-[11px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-3-4-1\" data-name=\"Security notice container\">\n                    <i class=\"ti ti-shield-lock mt-0.5 shrink-0 text-[15px] text-[#34D399]\" data-kid=\"2-2-3-4-1-1\" data-name=\"Shield lock icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-2-3-4-1-2\" data-name=\"Security notice text\">\n                        Tus datos se almacenan de forma segura.\n                    </span>\n                </div>\n                <div class=\"mt-5 grid grid-cols-2 gap-3\" data-kid=\"2-2-3-4-2\" data-name=\"Form action buttons container\">\n                    <button class=\"min-h-11 border border-[#475569] px-3 py-2.5 text-[12px] font-semibold text-[#CBD5E1] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-2-3-4-2-1\" data-name=\"Cancel button\" type=\"button\">\n                        Cancelar\n                    </button>\n                    <button class=\"min-h-11 bg-[#38BDF8] px-3 py-2.5 text-[12px] font-bold text-[#082F49] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-2-3-4-2-2\" data-name=\"Save changes button\" type=\"submit\">\n                        Guardar cambios\n                    </button>\n                </div>\n            </div>\n        </form>\n    </main>\n    <nav aria-label=\"Navegación principal móvil\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/[.98] px-2 pt-2\" data-kid=\"2-3\" data-name=\"Mobile fixed bottom navigation\" style=\"padding-bottom:env(safe-area-inset-bottom)\">\n        <div class=\"grid grid-cols-5 gap-1\" data-kid=\"2-3-1\" data-name=\"Bottom navigation links container\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-16 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" data-name=\"Home link\" href=\"#\">\n                <i class=\"ti ti-home-2 text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"Home icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"Home link text\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-16 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"Garage link\" href=\"#\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"Car icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"Garage link text\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-16 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"Workshops link\" href=\"#\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"Tool icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"Workshops link text\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-label=\"Alertas\" class=\"flex min-h-16 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-4\" data-name=\"Alerts link\" href=\"#\">\n                <span class=\"relative\" data-kid=\"2-3-1-4-1\" data-name=\"Alerts icon container\">\n                    <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-1-4-1-1\" data-name=\"Alert triangle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute -right-1 -top-1 size-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-3-1-4-1-2\" data-name=\"Alerts indicator\">\n                    </span>\n                </span>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"Alerts link text\">\n                    Alertas\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Mi perfil\" class=\"flex min-h-16 flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] text-[#38BDF8]\" data-kid=\"2-3-1-5\" data-name=\"Profile link\" href=\"#\">\n                <i class=\"ti ti-user-circle text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"User circle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-5-2\" data-name=\"Profile link text\">\n                    Perfil\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
