      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  aside button { min-width: 44px; min-height: 44px; border: 1px solid rgba(203,213,225,.4); border-radius: 9999px; background: #EEEDF0; box-shadow: 0 2px 4px rgba(15,23,42,.05); transition: transform 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  aside button:hover { background: #E2D9EE; box-shadow: 0 6px 14px rgba(15,23,42,.10); }\n  aside button:active { transform: scale(.97); }\n  aside button[class*=\"bg-[#1E88E5]\"] { background: #1E88E5; border-color: #1E88E5; color: #FFFFFF; }\n  .map-surface { background-color: #E8EEF4; }\n  .map-road { position: absolute; background: #FFFFFF; border: 1px solid #D5DEE8; }\n  .map-road-dark { position: absolute; background: #D6E0EA; }\n  .map-park { position: absolute; background: #D8E8DF; border: 1px solid #C2DACC; }\n  .map-water { position: absolute; background: #C9E4F1; border: 1px solid #B0D6E8; }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"workshop directory page\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\">\n                AD\n            </div>\n            <nav aria-label=\"Navegación rápida\" class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\">\n                <a aria-label=\"Inicio\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"navigation home link\" href=\"#inicio\">\n                    <i class=\"ti ti-dashboard\" data-kid=\"2-1-1-2-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </a>\n                <a aria-label=\"Mi garaje\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"navigation garage link\" href=\"#garaje\">\n                    <i class=\"ti ti-car\" data-kid=\"2-1-1-2-2-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </a>\n                <a aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-3\" data-name=\"navigation workshops link\" href=\"#talleres\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-3-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </a>\n                <a aria-label=\"Alertas\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-4\" data-name=\"navigation alerts link\" href=\"#alertas\">\n                    <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-1-2-4-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </a>\n                <a aria-label=\"Historial\" class=\"grid size-11 place-items-center rounded-xl text