y-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"2-1-3-2-4-1-1-2\">\n                                <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-1-3-2-4-1-1-2-1\">\n                                    <h3 class=\"text-[13px] font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-1-1-2-1-1\">\n                                        Reseña recibida\n                                    </h3>\n                                    <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-4-1-1-2-1-2\" data-name=\"relative time string\" data-reason=\"text updated as time elapses by script\">\n                                        Ayer\n                                    </time>\n                                </div>\n                                <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-1-2-2\">\n                                    MotorLab · servicio del 02 jun 2026\n                                </p>\n                                <p class=\"mt-2 text-[12px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-1-1-2-3\">\n                                    Gracias por valorar la atención de tu taller.\n                                </p>\n                            </div>\n                            <button aria-label=\"Abrir reseña recibida\" class=\"mt-1 text-[#64748B]\" data-kid=\"2-1-3-2-4-1-1-3\">\n                                <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-1-3-2-4-1-1-3-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"flex items-start gap-4 px-4 py-4\" data-kid=\"2-1-3-2-4-1-2\" data-name=\"read service notification\">\n                            <div class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#38BDF8]/40 bg-[#075985]/30 text-[#7DD3FC]\" data-kid=\"2-1-3-2-4-1-2-1\">\n                                <i class=\"ti ti-file-check text-[18px]\" data-kid=\"2-1-3-2-4-1-2-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"2-1-3-2-4-1-2-2\">\n                                <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-1-3-2-4-1-2-2-1\">\n                                    <h3 class=\"text-[13px] font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-1-2-2-1-1\">\n                                        Servicio completado\n                                    </h3>\n                                    <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-4-1-2-2-1-2\" data-name=\"relative time string\" data-reason=\"text updated as time elapses by script\">\n                                        Hace 2 días\n                                    </time>\n                                </div>\n                                <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-2-2-2\">\n                                    Cambio de aceite · Taller Rápido\n                                </p>\n                                <p class=\"mt-2 text-[12px] text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-1-2-2-3\">\n                                    El historial de tu vehículo fue actualizado.\n                                </p>\n                            </div>\n                            <button aria-label=\"Abrir servicio completado\" class=\"mt-1 text-[#64748B]\" data-kid=\"2-1-3-2-4-1-2-3\">\n                                <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-1-3-2-4-1-2-3-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </section>\n                <div class=\"mt-7 flex items-center gap-3 border-t border-[#334155] pt-5 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-5\" data-name=\"contextual empty state\">\n                    <i class=\"ti ti-bell-off text-[16px]\" data-kid=\"2-1-3-2-5-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-3-2-5-2\">\n                        No hay más notificaciones en este periodo.\n                    </span>\n                </div>\n                <footer class=\"mt-8 flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-6\" data-name=\"notifications sync footer\">\n                    <span data-kid=\"2-1-3-2-6-1\">\n                        AutoDoc · Centro de notificaciones\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-6-2\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-6-2-1\">\n                        </span>\n                        Sincronizado hace 2 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
