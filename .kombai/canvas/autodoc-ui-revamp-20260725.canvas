      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen overflow-x-hidden bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"admin logs application shell\" style=\"--surface:#F7F6F8;--surface-container:#EEEDF0;--surface-variant:#E2E8F0;--outline:#CBD5E1;--outline-strong:#94A3B8;--primary:#522C81;--secondary:#81E6D9;--on-primary:#FFFFFF;--text-primary:#0F172A;--text-secondary:#5B6B80;--success:#2F855A;--warning:#B45309;--error:#C2414B;--error-surface:#FFF1F2;--warning-surface:#FFFBEB;--success-surface:#ECFDF5;font-family:'IBM Plex Sans',sans-serif\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\" data-name=\"admin layout wrapper\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"1-1-1\" data-name=\"primary admin icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[var(--secondary)] text-[18px] font-extrabold tracking-[-0.08em] text-[#0F172A]\" data-kid=\"1-1-1-1\" data-name=\"admin logo placeholder\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                AD\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"1-1-1-2\" data-name=\"admin primary navigation\">\n                <button aria-label=\"Resumen\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"1-1-1-2-1\" data-name=\"dashboard navigation button\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Usuarios\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"1-1-1-2-2\" data-name=\"users navigation button\">\n                    <i class=\"ti ti-users\" data-kid=\"1-1-1-2-2-1\" data-name=\"users icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"1-1-1-2-3\" data-name=\"workshops navigation button\">\n                    <i class=\"ti ti-tool\" data-kid=\"1-1-1-2-3-1\" data-name=\"workshops icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Reseñas\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"1-1-1-2-4\" data-name=\"reviews navigation button\">\n                    <i class=\"ti ti-star\" data-kid=\"1-1-1-2-4-1\" data-name=\"reviews icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Logs\" class=\"grid size-11 place-items-center rounded-xl bg-[var(--primary)] text-[20px] text-white shadow-[0_8px_20px_rgba(82,44,129,0.24)]\" data-kid=\"1-1-1-2-5\" data-name=\"logs navigation button\">\n                    <i class=\"ti ti-list-details\" data-kid=\"1-1-1-2-5-1\" data-name=\"logs icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Seed\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"1-1-1-