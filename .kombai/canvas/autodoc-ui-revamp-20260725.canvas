    "var_502038def3b4": {
      "type": "variant",
      "label": "AutoDoc Alerts — Hadrian Dark Mobile",
      "parentId": "var_bea4a2950694",
      "themeId": null,
      "rect": {
        "x": 31060,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style data-name=\"AppButton AppCard AppMotion tokens\">\n    button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"filter\"]):not([data-name*=\"export\"]):not([data-name*=\"show all\"]):not([data-name*=\"view vehicle alerts\"]) {\n    min-height: 48px;\n    border-radius: 999px !important;\n    transition: transform 150ms cubic-bezier(.23,1,.32,1), box-shadow 150ms ease-out, background-color 150ms ease-out, color 150ms ease-out;\n  }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"filter\"]):not([data-name*=\"export\"]):not([data-name*=\"show all\"]):not([data-name*=\"view vehicle alerts\"]):hover { transform: scale(1.02); }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"filter\"]):not([data-name*=\"export\"]):not([data-name*=\"show all\"]):not([data-name*=\"view vehicle alerts\"]):active { transform: scale(.97); }\n  [data-name=\"theme toggle\"], [data-name=\"notifications button\"], [data-name=\"profile avatar\"], [data-name=\"more options\"], [data-name=\"edit mileage button\"] {\n    min-width: 44px !important;\n    min-height: 44px !important;\n    border-radius: 999px !important;\n    border: 1px solid #334155 !important;\n    background: #141E36 !important;\n    box-shadow: 0 2px 4px rgba(0,0,0,.2) !important;\n  }\n  [data-name=\"update mileage action\"] {\n    border-radius: 999px !important;\n    min-height: 48px !important;\n    box-shadow: 0 2px 4px rgba(0,0,0,.2) !important;\n  }\n  [data-name=\"primary action button\"] { border-radius: 999px !important; min-height: 48px !important; box-shadow: 0 2px 4px rgba(0,0,0,.2) !important; }\n  [data-name=\"critical alert card\"], [data-name=\"preventive alert card\"], [data-name=\"informational alert card\"] {\n    border-radius: 16px !important;\n    border: 1px solid #334155 !important;\n    background: #141E36 !important;\n    box-shadow: 0 2px 4px rgba(0,0,0,.2) !important;\n    overflow: hidden;\n  }\n  [data-name=\"critical alert card\"] { border-left: 4px solid #F87171 !important; }\n  [data-name=\"preventive alert card\"] { border-left: 4px solid #FBBF24 !important; }\n  [data-name=\"informational alert card\"] { border-left: 4px solid #38BDF8 !important; }\n  a:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]) { transition: color 150ms ease-out; }\n  @media (prefers-reduced-motion: reduce) { button, a { transition: none !important; } }\n</style>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"alerts mobile application root\">\n    <header class=\"sticky top-0 z-20 flex h-16 items-center justify-between border-b border-[#334155] bg-[#0B1220]/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile alerts top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and screen context\">\n            <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc initials\">\n                    AD\n                </span>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"screen context container\">\n                <div class=\"truncate text-[10px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"context breadcrumb\">\n                    Propietario\n                </div>\n                <div class=\"mt-0.5 truncate text-[15px] font-bold text-white [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-2-2\" data-name=\"page title\">\n                    Alertas\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header utilities\">\n            <button aria-label=\"Cambiar tema\" class=\"flex h-11 w-11 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-2-1\" data-name=\"theme toggle\">\n                <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-2-1-1\" data-name=\"sun-moon icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative flex h-11 w-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-2-2\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-2-2-1\" data-name=\"bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-2\" data-name=\"notification dot indicator\">\n                </span>\n            </button>\n            <button aria-label=\"Abrir perfil\" class=\"ml-1 flex h-11 w-11 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-2-3\" data-name=\"profile avatar\">\n                JP\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[520px] px-4 pb-[116px] pt-5\" data-kid=\"2-2\" data-name=\"mobile alerts page body\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"mobile alerts page heading\">\n            <div class=\"mb-2 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-3\" data-name=\"page breadcrumb navigation\">\n                <span data-kid=\"2-2-1-3-1\" data-name=\"breadcrumb path label\">\n                    Propietario\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-2-1-3-2\" data-name=\"breadcrumb arrow icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-medium text-[#CBD5E1]\" data-kid=\"2-2-1-3-3\" data-name=\"breadcrumb current page\">\n                    Alertas\n                </span>\n            </div>\n            <div class=\"flex items-end justify-between gap-3\" data-kid=\"2-2-1-4\" data-name=\"heading and primary action row\">\n                <div data-kid=\"2-2-1-4-1\" data-name=\"heading text content\">\n                    <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[28px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-2-1-4-1-1\" data-name=\"page main title\">\n                        Alertas\n                    </h1>\n                    <p class=\"mt-2 max-w-[300px] text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-4-1-2\" data-name=\"page description text\">\n                        Lo que requiere atención para mantener tus vehículos en regla.\n                    </p>\n                </div>\n                <button aria-label=\"Más opciones\" class=\"flex h-11 w-11 shrink-0 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"2-2-1-1\" data-name=\"mobile heading actions\">\n                    <i class=\"ti ti-dots text-[18px]\" data-kid=\"2-2-1-1-1\" data-name=\"dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <button class=\"mt-4 flex min-h-12 w-full items-center justify-center gap-2 border border-[#475569] px-4 py-2.5 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-1-2\" data-name=\"update mileage action\">\n                <i class=\"ti ti-refresh text-[15px] text-[#38BDF8]\" data-kid=\"2-2-1-2-1\" data-name=\"refresh icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Actualizar datos\n            </button>\n        </div>\n        <div class=\"mb-6 border-y border-[#334155] py-4\" data-kid=\"2-2-2\" data-name=\"mobile alerts summary strip\">\n            <div class=\"flex items-start gap-3\" data-kid=\"2-2-2-1\" data-name=\"alerts summary summary section\">\n                <span class=\"flex h-10 w-10 shrink-0 items-center justify-center border border-[#F87171]/50 text-[#F87171]\" data-kid=\"2-2-2-1-1\" data-name=\"alert octagon icon container\">\n                    <i class=\"ti ti-alert-octagon text-[18px]\" data-kid=\"2-2-2-1-1-1\" data-name=\"alert octagon icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <div class=\"min-w-0\" data-kid=\"2-2-2-1-2\" data-name=\"alerts summary text block\">\n                    <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-dynamic=\"true\" data-kid=\"2-2-2-1-2-1\" data-name=\"active alerts count\" data-reason=\"number text fetched from server\">\n                        3 alertas activas\n                    </div>\n                    <div class=\"mt-1 text-[12px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-2-1-2-2\" data-name=\"summary description\">\n                        Una requiere resolución antes de circular.\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-4 flex items-center justify-between gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-2-2-2\" data-name=\"mobile mileage summary\">\n                <div class=\"flex min-w-0 items-center gap-2 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-2-1\" data-name=\"mileage label and value container\">\n                    <i class=\"ti ti-gauge shrink-0 text-[16px] text-[#38BDF8]\" data-kid=\"2-2-2-2-1-1\" data-name=\"gauge icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"2-2-2-2-1-2\" data-name=\"mileage label\">\n                        Kilometraje actual\n                    </span>\n                    <strong class=\"shrink-0 tabular-nums text-[#E2E8F0]\" data-dynamic=\"true\" data-kid=\"2-2-2-2-1-3\" data-name=\"current mileage value\" data-reason=\"number text fetched from server\">\n                        48,260 km\n                    </strong>\n                </div>\n                <button aria-label=\"Editar kilometraje\" class=\"flex h-11 w-11 shrink-0 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"2-2-2-2-2\" data-name=\"edit mileage button\">\n                    <i class=\"ti ti-pencil text-[15px]\" data-kid=\"2-2-2-2-2-1\" data-name=\"pencil icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <div class=\"mb-6 -mx-1 flex gap-1 overflow-x-auto border-b border-[#334155] px-1\" data-kid=\"2-2-3\" data-name=\"mobile alert filters\">\n            <button class=\"min-h-12 shrink-0 border-b-2 border-[#38BDF8] px-3 text-[13px] font-semibold text-white\" data-kid=\"2-2-3-1\" data-name=\"all alerts filter button\">\n                Todas\n                <span class=\"ml-1 text-[#38BDF8]\" data-dynamic=\"true\" data-kid=\"2-2-3-1-1\" data-name=\"all alerts filter count\" data-reason=\"count text fetched from server\">\n                    3\n                </span>\n            </button>\n            <button class=\"min-h-12 shrink-0 px-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-2-3-2\" data-name=\"critical alerts filter button\">\n                Críticas\n                <span class=\"ml-1 text-[#F87171]\" data-dynamic=\"true\" data-kid=\"2-2-3-2-1\" data-name=\"critical alerts filter count\" data-reason=\"count text fetched from server\">\n                    1\n                </span>\n            </button>\n            <button class=\"min-h-12 shrink-0 px-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-2-3-3\" data-name=\"preventive alerts filter button\">\n                Preventivas\n                <span class=\"ml-1 text-[#FBBF24]\" data-dynamic=\"true\" data-kid=\"2-2-3-3-1\" data-name=\"preventive alerts filter count\" data-reason=\"count text fetched from server\">\n                    1\n                </span>\n            </button>\n            <button class=\"min-h-12 shrink-0 px-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-2-3-4\" data-name=\"informative alerts filter button\">\n                Informativas\n                <span class=\"ml-1 text-[#38BDF8]\" data-dynamic=\"true\" data-kid=\"2-2-3-4-1\" data-name=\"informative alerts filter count\" data-reason=\"count text fetched from server\">\n                    1\n                </span>\n            </button>\n        </div>\n        <section aria-labelledby=\"active-alerts-heading\" data-kid=\"2-2-4\" data-name=\"mobile operational alerts list\">\n            <div class=\"mb-3 flex items-end justify-between gap-3\" data-kid=\"2-2-4-2\" data-name=\"list header row\">\n                <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[19px] font-bold tracking-[-0.02em] text-white\" data-kid=\"2-2-4-2-1\" data-name=\"list section title\" id=\"active-alerts-heading\">\n                    Alertas activas\n                </h2>\n                <span class=\"text-right text-[10px] text-[#64748B]\" data-kid=\"2-2-4-2-2\" data-name=\"sorting instruction text\">\n                    Ordenadas por prioridad\n                </span>\n            </div>\n            <div class=\"space-y-3\" data-kid=\"2-2-4-1\" data-name=\"mobile alert cards container\">\n                <article class=\"border-l-4 border-[#F87171] bg-[#172033] p-4\" data-kid=\"2-2-4-1-1\" data-name=\"critical alert card\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"2-2-4-1-1-1\" data-name=\"alert info container\">\n                        <div class=\"flex h-11 w-11 shrink-0 items-center justify-center border border-[#F87171]/50 bg-[#3F1D25] text-[#F87171]\" data-kid=\"2-2-4-1-1-1-1\" data-name=\"alert category icon container\">\n                            <i class=\"ti ti-alert-triangle text-[20px]\" data-kid=\"2-2-4-1-1-1-1-1\" data-name=\"alert triangle icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-2-4-1-1-1-2\" data-name=\"alert details\">\n                            <div class=\"flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#FCA5A5]\" data-kid=\"2-2-4-1-1-1-2-1\" data-name=\"alert category labels\">\n                                <span data-kid=\"2-2-4-1-1-1-2-1-1\" data-name=\"alert level label\">\n                                    Crítica\n                                </span>\n                                <span class=\"h-1 w-1 rounded-full bg-[#F87171]\" data-kid=\"2-2-4-1-1-1-2-1-2\" data-name=\"separator dot\">\n                                </span>\n                                <span data-kid=\"2-2-4-1-1-1-2-1-3\" data-name=\"alert subject\">\n                                    SOAT\n                                </span>\n                            </div>\n                            <h3 class=\"mt-1 text-[16px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-4-1-1-1-2-2\" data-name=\"alert title\">\n                                SOAT vencido\n                            </h3>\n                            <p class=\"mt-1 text-[13px] text-[#CBD5E1]\" data-kid=\"2-2-4-1-1-1-2-3\" data-name=\"alert vehicle model\">\n                                Toyota Corolla 2022\n                                <span class=\"text-[#64748B]\" data-kid=\"2-2-4-1-1-1-2-3-1\" data-name=\"separator dot\">\n                                    ·\n                                </span>\n                                P 482-916\n                            </p>\n                            <p class=\"mt-2 text-[12px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-4-1-1-1-2-4\" data-name=\"alert explanation\">\n                                Renueva la cobertura antes de circular.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-3 border-t border-[#334155] pt-3 text-[12px]\" data-kid=\"2-2-4-1-1-2\" data-name=\"alert actions container\">\n                        <div data-kid=\"2-2-4-1-1-2-1\" data-name=\"alert status and date\">\n                            <div class=\"mb-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-1-1-2-1-1\" data-name=\"expiry status label\">\n                                Vencimiento\n                            </div>\n                            <div class=\"font-semibold text-[#FCA5A5]\" data-kid=\"2-2-4-1-1-2-1-2\" data-name=\"expiry relative time\">\n                                Hace 3 días\n                            </div>\n                            <div class=\"mt-1 text-[#94A3B8]\" data-kid=\"2-2-4-1-1-2-1-3\" data-name=\"expiry absolute date\">\n                                25 jul 2026\n                            </div>\n                        </div>\n                        <button class=\"flex min-h-12 items-center justify-center gap-2 bg-[#F87171] px-3 text-[12px] font-bold text-[#450A0A]\" data-kid=\"2-2-4-1-1-2-2\" data-name=\"primary action button\">\n                            Resolver ahora\n                            <i class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"2-2-4-1-1-2-2-1\" data-name=\"arrow-up-right icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </article>\n                <article class=\"border-l-4 border-[#FBBF24] bg-[#172033] p-4\" data-kid=\"2-2-4-1-2\" data-name=\"preventive alert card\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"2-2-4-1-2-1\" data-name=\"alert info container\">\n                        <div class=\"flex h-11 w-11 shrink-0 items-center justify-center border border-[#FBBF24]/50 bg-[#3F3212] text-[#FBBF24]\" data-kid=\"2-2-4-1-2-1-1\" data-name=\"alert category icon container\">\n                            <i class=\"ti ti-tool text-[20px]\" data-kid=\"2-2-4-1-2-1-1-1\" data-name=\"tool icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-2-4-1-2-1-2\" data-name=\"alert details\">\n                            <div class=\"flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#FCD34D]\" data-kid=\"2-2-4-1-2-1-2-1\" data-name=\"alert category labels\">\n                                <span data-kid=\"2-2-4-1-2-1-2-1-1\" data-name=\"alert level label\">\n                                    Preventiva\n                                </span>\n                                <span class=\"h-1 w-1 rounded-full bg-[#FBBF24]\" data-kid=\"2-2-4-1-2-1-2-1-2\" data-name=\"separator dot\">\n                                </span>\n                                <span data-kid=\"2-2-4-1-2-1-2-1-3\" data-name=\"alert subject\">\n                                    Frenos\n                                </span>\n                            </div>\n                            <h3 class=\"mt-1 text-[16px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-4-1-2-1-2-2\" data-name=\"alert title\">\n                                Pastillas de freno próximas\n                            </h3>\n                            <p class=\"mt-1 text-[13px] text-[#CBD5E1]\" data-kid=\"2-2-4-1-2-1-2-3\" data-name=\"alert vehicle model\">\n                                Toyota Corolla 2022\n                                <span class=\"text-[#64748B]\" data-kid=\"2-2-4-1-2-1-2-3-1\" data-name=\"separator dot\">\n                                    ·\n                                </span>\n                                P 482-916\n                            </p>\n                            <p class=\"mt-2 text-[12px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-4-1-2-1-2-4\" data-name=\"alert explanation\">\n                                Revisar en\n                                <strong class=\"tabular-nums text-[#FCD34D]\" data-dynamic=\"true\" data-kid=\"2-2-4-1-2-1-2-4-1\" data-name=\"mileage threshold value\" data-reason=\"number text fetched from server\">\n                                    420 km\n                                </strong>\n                                .\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-3 border-t border-[#334155] pt-3 text-[12px]\" data-kid=\"2-2-4-1-2-2\" data-name=\"alert actions container\">\n                        <div data-kid=\"2-2-4-1-2-2-1\" data-name=\"expiry status and date\">\n                            <div class=\"mb-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-1-2-2-1-1\" data-name=\"revision status label\">\n                                Próxima revisión\n                            </div>\n                            <div class=\"font-semibold text-[#FCD34D]\" data-kid=\"2-2-4-1-2-2-1-2\" data-name=\"revision relative time\">\n                                En 12 días\n                            </div>\n                            <div class=\"mt-1 text-[#94A3B8]\" data-kid=\"2-2-4-1-2-2-1-3\" data-name=\"revision absolute date\">\n                                06 ago 2026\n                            </div>\n                        </div>\n                        <button class=\"flex min-h-12 items-center justify-center gap-2 border border-[#FBBF24]/60 px-3 text-[12px] font-bold text-[#FCD34D]\" data-kid=\"2-2-4-1-2-2-2\" data-name=\"primary action button\">\n                            Agendar servicio\n                            <i class=\"ti ti-calendar-plus text-[15px]\" data-kid=\"2-2-4-1-2-2-2-1\" data-name=\"calendar plus icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </article>\n                <article class=\"border-l-4 border-[#38BDF8] bg-[#172033] p-4\" data-kid=\"2-2-4-1-3\" data-name=\"informational alert card\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"2-2-4-1-3-1\" data-name=\"alert info container\">\n                        <div class=\"flex h-11 w-11 shrink-0 items-center justify-center border border-[#38BDF8]/50 bg-[#082F49] text-[#38BDF8]\" data-kid=\"2-2-4-1-3-1-1\" data-name=\"alert category icon container\">\n                            <i class=\"ti ti-file-alert text-[20px]\" data-kid=\"2-2-4-1-3-1-1-1\" data-name=\"file alert icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-2-4-1-3-1-2\" data-name=\"alert details\">\n                            <div class=\"flex flex-wrap items-center gap-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#7DD3FC]\" data-kid=\"2-2-4-1-3-1-2-1\" data-name=\"alert category labels\">\n                                <span data-kid=\"2-2-4-1-3-1-2-1-1\" data-name=\"alert level label\">\n                                    Informativa\n                                </span>\n                                <span class=\"h-1 w-1 rounded-full bg-[#38BDF8]\" data-kid=\"2-2-4-1-3-1-2-1-2\" data-name=\"separator dot\">\n                                </span>\n                                <span data-kid=\"2-2-4-1-3-1-2-1-3\" data-name=\"alert subject\">\n                                    Perfil\n                                </span>\n                            </div>\n                            <h3 class=\"mt-1 text-[16px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-4-1-3-1-2-2\" data-name=\"alert title\">\n                                Perfil de vehículo incompleto\n                            </h3>\n                            <p class=\"mt-1 text-[13px] text-[#CBD5E1]\" data-kid=\"2-2-4-1-3-1-2-3\" data-name=\"alert vehicle model\">\n                                Renault Duster 2021\n                                <span class=\"text-[#64748B]\" data-kid=\"2-2-4-1-3-1-2-3-1\" data-name=\"separator dot\">\n                                    ·\n                                </span>\n                                J 204-118\n                            </p>\n                            <p class=\"mt-2 text-[12px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-4-1-3-1-2-4\" data-name=\"alert explanation\">\n                                Completa la ficha para activar recordatorios de kilometraje y vencimientos.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-3 border-t border-[#334155] pt-3 text-[12px]\" data-kid=\"2-2-4-1-3-2\" data-name=\"alert actions container\">\n                        <div data-kid=\"2-2-4-1-3-2-1\" data-name=\"update status and date\">\n                            <div class=\"mb-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-1-3-2-1-1\" data-name=\"update status label\">\n                                Actualización\n                            </div>\n                            <div class=\"font-semibold text-[#7DD3FC]\" data-kid=\"2-2-4-1-3-2-1-2\" data-name=\"update status text\">\n                                Sin datos recientes\n                            </div>\n                            <div class=\"mt-1 text-[#94A3B8]\" data-kid=\"2-2-4-1-3-2-1-3\" data-name=\"update absolute date\">\n                                18 jul 2026\n                            </div>\n                        </div>\n                        <button class=\"flex min-h-12 items-center justify-center gap-2 border border-[#38BDF8]/60 px-3 text-[12px] font-bold text-[#7DD3FC]\" data-kid=\"2-2-4-1-3-2-2\" data-name=\"primary action button\">\n                            Completar ficha\n                            <i class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"2-2-4-1-3-2-2-1\" data-name=\"arrow-up-right icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <footer class=\"mt-8 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-2-5\" data-name=\"mobile alerts footer\">\n            <div data-kid=\"2-2-5-1\" data-name=\"footer copyright text\">\n                AutoDoc · Alertas de mantenimiento para tu vehículo\n            </div>\n            <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-2-5-2\" data-name=\"sync status container\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-5-2-1\" data-name=\"sync status indicator\">\n                </span>\n                Última sincronización hace 8 min\n            </div>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación móvil\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617] px-2\" data-kid=\"3\" data-name=\"mobile bottom navigation\" style=\"padding-bottom:max(10px,env(safe-area-inset-bottom))\">\n        <div class=\"mx-auto flex max-w-[520px] items-center justify-around pt-2\" data-kid=\"3-1\" data-name=\"nav items container\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"3-1-1\" data-name=\"home link\" href=\"#inicio\">\n                <i class=\"ti ti-home-2 text-[19px]\" data-kid=\"3-1-1-1\" data-name=\"home icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"3-1-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"3-1-2\" data-name=\"garage link\" href=\"#garaje\">\n                <i class=\"ti ti-steering-wheel text-[19px]\" data-kid=\"3-1-2-1\" data-name=\"garage icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"3-1-2-2\" data-name=\"garage label\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"3-1-3\" data-name=\"workshops link\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"3-1-3-1\" data-name=\"workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Alertas\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-1 text-[#38BDF8]\" data-kid=\"3-1-4\" data-name=\"alerts link\" href=\"#alertas\">\n                <span class=\"relative\" data-kid=\"3-1-4-1\" data-name=\"alerts icon container\">\n                    <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"3-1-4-1-1\" data-name=\"alerts icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute -right-2 -top-1 rounded-[4px] bg-[#7F1D1D] px-1 text-[9px] font-bold text-[#FCA5A5]\" data-dynamic=\"true\" data-kid=\"3-1-4-1-2\" data-name=\"alerts badge count\" data-reason=\"count text fetched from server\">\n                        03\n                    </span>\n                </span>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"3-1-4-2\" data-name=\"alerts label\">\n                    Alertas\n                </span>\n            </a>\n            <a aria-label=\"Historial\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"3-1-5\" data-name=\"history link\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"3-1-5-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"3-1-5-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
