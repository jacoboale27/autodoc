      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<style data-name=\"AutoDoc shared component tokens dark\">\n    button { min-height:44px; min-width:44px; border-radius:999px !important; transition:transform 150ms cubic-bezier(.23,1,.32,1),box-shadow 150ms cubic-bezier(.23,1,.32,1),background-color 150ms cubic-bezier(.23,1,.32,1),color 150ms cubic-bezier(.23,1,.32,1); }\n  button:active { transform:scale(.97); }\n  button:hover { box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  button[data-name*=\"primary button\"], button[data-name*=\"create user button\"] { background:linear-gradient(135deg,#81E6D9,#6FC8BC) !important; color:#0F172A !important; border:0 !important; box-shadow:0 2px 4px rgba(0,0,0,.20); }\n  button[data-name*=\"refresh\"], button[data-name*=\"export\"], button[data-name*=\"filter\"], button[data-name*=\"page\"] { background:#141E36 !important; border:1px solid rgba(51,65,85,.20) !important; color:#E2E8F0 !important; box-shadow:0 2px 4px rgba(0,0,0,.20); }\n  button[aria-label*=\"Notificaciones\"], button[aria-label*=\"Cambiar tema\"], button[aria-label*=\"Cambiar a modo\"], button[aria-label*=\"Configuración\"], button[aria-label*=\"Ayuda\"] { background:#141E36 !important; border:1px solid rgba(51,65,85,.20) !important; }\n  section[data-name*=\"metrics\"], section[data-name*=\"panel\"], section[data-name*=\"Logs\"], section[data-name*=\"logs\"], section[data-name*=\"table\"], article[data-name*=\"user card\"], article[data-name*=\"account row\"] { background:#141E36; border-color:rgba(51,65,85,.20) !important; border-radius:16px; box-shadow:0 2px 4px rgba(0,0,0,.20); overflow:hidden; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"main layout wrapper\" style=\"font-family:'IBM Plex Sans',sans-serif\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"flex container\">\n        <aside aria-label=\"Barra principal de administración\" class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"admin sidebar menu container\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\" data-name=\"top section of sidebar menu\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#082F49]\" data-kid=\"2-1-1-1-1\" data-name=\"logo square container\">\n                    <span class=\"text-[18px] font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1-1-1\" data-name=\"logo initials text\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center gap-5 text-[#64748B]\" data-kid=\"2-1-1-1-2\" data-name=\"navigation icons list\">\n                    <button aria-label=\"Resumen\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"dashboard button\">\n                        <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Usuarios\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-2\" data-name=\"users button\">\n                        <i class=\"ti ti-users text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"users icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-3\" data-name=\"workshops button\">\n                        <i class=\"ti ti-building-store text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" data-name=\"workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Logs\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-4\" data-name=\"logs button\">\n                        <i class=\"ti ti-terminal-2 text-[19px]\" data-kid=\"2-1-1-1-2-4-1\" data-name=\"logs icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\" data-name=\"bottom utility buttons container\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-1\" data-name=\"settings button\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-2\" data-name=\"help button\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"help icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside aria-label=\"Navegación de administración\" class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\" data-name=\"admin side navigation bar\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\" data-name=\"navigation brand header\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\" data-name=\"navigation section label\">\n                    Administración\n                </div>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"brand name section\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-2-1-2-1\" data-name=\"main brand text\">\n                        Auto\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"brand suffix text\">\n                            Doc\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-2-1-2-2\" data-name=\"online status indicator\">\n                    </span>\n                </div>\n            </div>\n            <nav class=\"flex-1 px-4 py-6\" data-kid=\"2-1-2-2\" data-name=\"nav links list\">\n                <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-1\" data-name=\"nav section header\">\n                    Panel operativo\n                </div>\n                <div class=\"space-y-1\" data-kid=\"2-1-2-2-2\" data-name=\"nav items list\">\n                    <a class=\"flex items-center gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-3 py-3 text-[13px] font-semibold text-white\" data-kid=\"2-1-2-2-2-1\" data-name=\"dashboard nav link\" href=\"#resumen\">\n                        <i class=\"ti ti-layout-dashboard text-[17px] text-[#38BDF8]\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"dashboard icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Resumen\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-2\" data-name=\"users nav link\" href=\"#usuarios\">\n                        <i class=\"ti ti-users text-[17px]\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"users icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Usuarios\n                        <span class=\"ml-auto text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"user count badge\">\n                            1,284\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-3\" data-name=\"workshops nav link\" href=\"#talleres\">\n                        <i class=\"ti ti-building-store text-[17px]\" data-kid=\"2-1-2-2-2-3-1\" data-name=\"workshops icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Talleres\n                        <span class=\"ml-auto text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-1-2-2-2-3-2\" data-name=\"workshop count badge\">\n                            86\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-4\" data-name=\"reviews nav link\" href=\"#resenias\">\n                        <i class=\"ti ti-star text-[17px]\" data-kid=\"2-1-2-2-2-4-1\" data-name=\"reviews icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Reseñas\n                        <span class=\"ml-auto rounded-[4px] bg-[#422006] px-1.5 py-0.5 text-[10px] font-bold text-[#FCD34D]\" data-kid=\"2-1-2-2-2-4-2\" data-name=\"review count badge\">\n                            7\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-5\" data-name=\"logs nav link\" href=\"#logs\">\n                        <i class=\"ti ti-terminal-2 text-[17px]\" data-kid=\"2-1-2-2-2-5-1\" data-name=\"logs icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Logs\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-6\" data-name=\"seed nav link\" href=\"#seed\">\n                        <i class=\"ti ti-database-import text-[17px]\" data-kid=\"2-1-2-2-2-6-1\" data-name=\"seed icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Seed\n                    </a>\n                </div>\n            </nav>\n            <div class=\"border-t border-[#334155] px-5 py-5\" data-kid=\"2-1-2-3\" data-name=\"user profile summary section\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\" data-name=\"user account container\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-3-1-1\" data-name=\"user initials avatar\">\n                        SA\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\" data-name=\"user info container\">\n                        <div class=\"truncate text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-2-3-1-2-1\" data-name=\"user display name\">\n                            Superadmin\n                        </div>\n                        <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\" data-name=\"user account status text\">\n                            Acceso interno\n                        </div>\n                    </div>\n                    <i class=\"ti ti-dots ml-auto text-[16px] text-[#64748B]\" data-kid=\"2-1-2-3-1-3\" data-name=\"profile options icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[#0F172A]\" data-kid=\"2-1-3\" data-name=\"main page content area\" id=\"resumen\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#334155] px-8\" data-kid=\"2-1-3-1\" data-name=\"page header\">\n                <div class=\"flex items-center gap-3 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumbs container\">\n                    <span data-kid=\"2-1-3-1-1-1\" data-name=\"breadcrumb parent\">\n                        Admin\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-1-3-1-1-2\" data-name=\"breadcrumb separator icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-1-1-3\" data-name=\"current page breadcrumb\">\n                        Resumen\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-6\" data-kid=\"2-1-3-1-2\" data-name=\"header utilities container\">\n                    <div class=\"text-right\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1\" data-name=\"current date and time\" data-reason=\"date and time text updated by clock script\">\n                        <div class=\"text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-1\" data-name=\"date text\" data-reason=\"date text updated by clock script\">\n                            Sábado, 15 ago 2026\n                        </div>\n                        <div class=\"mt-0.5 text-[12px] font-semibold text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-2\" data-name=\"time text\" data-reason=\"time text updated by clock script\">\n                            09:14 a. m.\n                        </div>\n                    </div>\n                    <div class=\"h-5 w-px bg-[#334155]\" data-kid=\"2-1-3-1-2-2\" data-name=\"separator line\">\n                    </div>\n                    <button aria-label=\"Cambiar tema\" class=\"flex h-9 w-9 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-3-1-2-3\" data-name=\"theme toggle button\">\n                        <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"theme icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex h-9 w-9 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-3-1-2-4\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-3-1-2-4-1\" data-name=\"notifications bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-3-1-2-4-2\" data-name=\"notification indicator dot\">\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-3 border-l border-[#334155] pl-5\" data-kid=\"2-1-3-1-2-5\" data-name=\"header user menu container\">\n                        <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-1-2-5-1\" data-name=\"user avatar\">\n                            SA\n                        </div>\n                        <div class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-1-2-5-2\" data-name=\"header user name\">\n                            Superadmin\n                        </div>\n                        <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-1-3-1-2-5-3\" data-name=\"chevron dropdown icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1160px] px-8 pb-14 pt-8\" data-kid=\"2-1-3-2\" data-name=\"page dashboard content\">\n                <div class=\"mb-7 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"dashboard page header\">\n                    <div data-kid=\"2-1-3-2-1-1\" data-name=\"page title and description\">\n                        <h1 class=\"text-[30px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-1-3-2-1-1-1\" data-name=\"page title heading\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Resumen operativo\n                        </h1>\n                        <p class=\"mt-2 text-[14px] text-[#94A3B8]\" data-kid=\"2-1-3-2-1-1-2\" data-name=\"page description text\">\n                            Salud de la plataforma y actividad reciente.\n                        </p>\n                    </div>\n                    <button class=\"flex items-center gap-2 border border-[#475569] px-4 py-2.5 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-1-2\" data-name=\"refresh data button\">\n                        <i class=\"ti ti-refresh text-[15px] text-[#38BDF8]\" data-kid=\"2-1-3-2-1-2-1\" data-name=\"refresh icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Actualizar datos\n                    </button>\n                </div>\n                <section aria-label=\"Métricas operativas\" class=\"border-y border-[#475569] bg-[#1E293B]\" data-kid=\"2-1-3-2-2\" data-name=\"metrics overview section\">\n                    <div class=\"grid grid-cols-4 divide-x divide-[#475569]\" data-kid=\"2-1-3-2-2-1\" data-name=\"metrics grid\">\n                        <div class=\"px-5 py-5\" data-kid=\"2-1-3-2-2-1-1\" data-name=\"users metric container\">\n                            <div class=\"text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-1-1\" data-name=\"users metric label\">\n                                Usuarios\n                            </div>\n                            <div class=\"mt-1 flex items-end justify-between gap-3\" data-kid=\"2-1-3-2-2-1-1-2\" data-name=\"users metric value section\">\n                                <strong class=\"text-[25px] font-bold tabular-nums text-[#F8FAFC]\" data-kid=\"2-1-3-2-2-1-1-2-1\" data-name=\"users count value\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                                    1,284\n                                </strong>\n                                <span class=\"mb-1 text-[11px] font-semibold text-[#34D399]\" data-kid=\"2-1-3-2-2-1-1-2-2\" data-name=\"users change percentage\">\n                                    +8.4%\n                                </span>\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-1 text-[10px] text-[#64748B]\" data-kid=\"2-1-3-2-2-1-1-3\" data-name=\"users growth trend indicator\">\n                                <i class=\"ti ti-trending-up text-[13px] text-[#34D399]\" data-kid=\"2-1-3-2-2-1-1-3-1\" data-name=\"users growth trend icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                vs. mes anterior\n                            </div>\n                        </div>\n                        <div class=\"px-5 py-5\" data-kid=\"2-1-3-2-2-1-2\" data-name=\"workshops metric container\">\n                            <div class=\"text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-2-1\" data-name=\"workshops metric label\">\n                                Talleres\n                            </div>\n                            <div class=\"mt-1 flex items-end justify-between gap-3\" data-kid=\"2-1-3-2-2-1-2-2\" data-name=\"workshops metric value section\">\n                                <strong class=\"text-[25px] font-bold tabular-nums text-[#F8FAFC]\" data-kid=\"2-1-3-2-2-1-2-2-1\" data-name=\"workshops count value\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                                    86\n                                </strong>\n                                <span class=\"mb-1 text-[11px] font-semibold text-[#34D399]\" data-kid=\"2-1-3-2-2-1-2-2-2\" data-name=\"workshops increase count\">\n                                    +3\n                                </span>\n                            </div>\n                            <div class=\"mt-2 flex items-center gap-1 text-[10px] text-[#64748B]\" data-kid=\"2-1-3-2-2-1-2-3\" data-name=\"workshops trend info\">\n                                <i class=\"ti ti-building-store text-[13p