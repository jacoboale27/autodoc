        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen w-full max-w-full overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"mobile service form root\">\n    <header class=\"sticky top-0 z-20 flex min-h-[68px] items-center justify-between border-b border-[#334155] bg-[#0B1220]/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile application header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#082F49]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo initials\">\n                    AD\n                </span>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"mobile workshop context\">\n                <div class=\"truncate text-[11px] font-semibold uppercase tracking-[0.12em] text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"workshop label\">\n                    Taller\n                </div>\n                <div class=\"mt-0.5 flex items-center gap-2 truncate [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-2-2\" data-name=\"workshop status container\">\n                    <span class=\"truncate text-[15px] font-extrabold\" data-kid=\"2-1-1-2-2-1\" data-name=\"workshop name text\">\n                        Taller\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-2-2-1-1\" data-name=\"workshop fast suffix\">\n                            Rápido\n                        </span>\n                    </span>\n                    <span aria-label=\"Taller activo\" class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-2-2-2\" data-name=\"active status indicator dot\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header actions\">\n            <button aria-label=\"Cambiar tema\" class=\"flex min-h-[44px] min-w-[44px] items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-2-1\" data-name=\"toggle theme button\">\n                <i class=\"ti ti-sun-moon text-[18px]\" data-kid=\"2-1-2-1-1\" data-name=\"sun moon icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative flex min-h-[44px] min-w-[44px] items-center justify-center text-[#CBD5E1]\" data-kid=\"2-1-2-2\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-2-2-1\" data-name=\"notification bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-[9px] top-[9px] h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-2\" data-name=\"notification indicator\">\n                </span>\n            </button>\n            <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-2-3\" data-name=\"workshop avatar\">\n                TR\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-32 pt-5\" data-kid=\"2-2\" data-name=\"mobile service form page body\">\n        <div class=\"mb-5 flex items-start justify-between gap-3\" data-kid=\"2-2-1\" data-name=\"mobile breadcrumb and title header\">\n            <div class=\"min-w-0\" data-kid=\"2-2-1-1\" data-name=\"mobile page heading\">\n                <div class=\"mb-3 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-1-1\" data-name=\"mobile breadcrumb navigation\">\n                    <span data-kid=\"2-2-1-1-1-1\" data-name=\"breadcrumb workshop label\">\n                        Taller\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-2-1-1-1-2\" data-name=\"breadcrumb chevron icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-semibold text-[#E2E8F0]\" data-kid=\"2-2-1-1-1-3\" data-name=\"breadcrumb page title\">\n                        Nueva reparación\n                    </span>\n                </div>\n                <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[26px] font-extrabold leading-tight tracking-[-0.04em] text-white\" data-kid=\"2-2-1-1-2\" data-name=\"page title\">\n                    Registrar servicio\n                </h1>\n                <p class=\"mt-2 text-[13px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-1-3\" data-name=\"page description\">\n                    Documenta el trabajo realizado y deja el historial listo para el propietario.\n                </p>\n            </div>\n            <button aria-label=\"Guardar borrador\" class=\"flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center border border-[#475569] px-3 text-[#38BDF8]\" data-kid=\"2-2-1-2\" data-name=\"save draft icon button\">\n                <i class=\"ti ti-device-floppy text-[17px]\" data-kid=\"2-2-1-2-1\" data-name=\"save icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n        <button class=\"mb-5 flex min-h-[44px] w-full items-center justify-center gap-2 border border-[#475569] px-4 py-2.5 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-1-3\" data-name=\"save draft mobile action\">\n            <i class=\"ti ti-device-floppy text-[15px] text-[#38BDF8]\" data-kid=\"2-2-1-3-1\" data-name=\"save icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            Guardar borrador\n        </button>\n        <div class=\"mb-5 flex items-start gap-3 border-l-4 border-[#FBBF24] bg-[#422006] px-4 py-3.5\" data-kid=\"2-2-2\" data-name=\"unsaved changes inline notice\">\n            <i class=\"ti ti-alert-circle mt-0.5 shrink-0 text-[18px] text-[#FCD34D]\" data-kid=\"2-2-2-3\" data-name=\"alert circle icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <div class=\"min-w-0 flex-1\" data-kid=\"2-2-2-1\" data-name=\"notice content\">\n                <div class=\"text-[12px] font-bold text-[#FDE68A\" data-kid=\"2-2-2-1-1\" data-name=\"notice title\">\n                    Cambios sin guardar\n                </div>\n                <div class=\"mt-1 text-[11px] leading-4 text-[#FCD34D]\" data-kid=\"2-2-2-1-2\" data-name=\"notice description\">\n                    El servicio se guardará en el historial cuando confirmes la acción.\n                </div>\n            </div>\n            <button class=\"min-h-[44px] shrink-0 px-1 text-[11px] font-bold text-[#FDE68A] underline underline-offset-2\" data-kid=\"2-2-2-2\" data-name=\"discard changes button\">\n                Descartar\n            </button>\n        </div>\n        <section class=\"mb-7 border border-[#475569] bg-[#1E293B]\" data-kid=\"2-2-3\" data-name=\"vehicle service context strip\">\n            <div class=\"flex flex-col gap-4 px-4 py-4\" data-kid=\"2-2-3-1\" data-name=\"mobile vehicle context layout\">\n                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-2-3-1-1\" data-name=\"vehicle identity container\">\n                    <div class=\"flex h-11 w-11 shrink-0 items-center justify-center border border-[#38BDF8]/50 bg-[#082F49] text-[#38BDF8]\" data-kid=\"2-2-3-1-1-1\" data-name=\"vehicle icon wrapper\">\n                        <i class=\"ti ti-steering-wheel text-[20px]\" data-kid=\"2-2-3-1-1-1-1\" data-name=\"steering wheel icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-2-3-1-1-2\" data-name=\"vehicle details container\">\n                        <div class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#94A3B8]\" data-kid=\"2-2-3-1-1-2-1\" data-name=\"vehicle service context label\">\n                            Vehículo en servicio\n                        </div>\n                        <div class=\"mt-1 truncate text-[16px] font-bold text-white [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-2-3-1-1-2-2\" data-name=\"vehicle model and plate\">\n                            Toyota Corolla 2022\n                            <span class=\"font-normal text-[#64748B]\" data-kid=\"2-2-3-1-1-2-2-1\" data-name=\"separator dot\">\n                                ·\n                            </span>\n                            <span class=\"text-[13px] tracking-[0.12em] text-[#CBD5E1]\" data-kid=\"2-2-3-1-1-2-2-2\" data-name=\"license plate number\">\n                                P 482-916\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-2 gap-3 border-t border-[#334155] pt-3\" data-kid=\"2-2-3-1-2\" data-name=\"vehicle metrics and status\">\n                    <div data-kid=\"2-2-3-1-2-1\" data-name=\"mileage container\">\n                        <div class=\"text-[10px] uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-3-1-2-1-1\" data-name=\"mileage label\">\n                            Kilometraje actual\n                        </div>\n                        <div class=\"mt-1 text-[17px] font-bold tabular-nums text-[#38BDF8]\" data-kid=\"2-2-3-1-2-1-2\" data-name=\"mileage value text\">\n                            48,260\n                            <span class=\"text-[11px] font-medium text-[#94A3B8]\" data-kid=\"2-2-3-1-2-1-2-1\" data-name=\"mileage unit label\">\n                                km\n                            </span>\n                        </div>\n                    </div>\n                    <span class=\"inline-flex min-h-[36px] items-center justify-center gap-2 self-end border border-[#34D399]/50 bg-[#064E3B]/30 px-2 text-center text-[10px] font-bold tracking-[0.08em] text-[#6EE7B7]\" data-kid=\"2-2-3-1-2-2\" data-name=\"status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-3-1-2-2-1\" data-name=\"status indicator dot\">\n                        </span>\n                        Servicio abierto\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-t border-[#475569]\" data-kid=\"2-2-4\" data-name=\"vehicle reception section\">\n            <div class=\"flex items-end justify-between gap-3 border-b border-[#334155] py-4\" data-kid=\"2-2-4-1\" data-name=\"reception header\">\n                <div class=\"min-w-0\" data-kid=\"2-2-4-1-1\" data-name=\"reception header text\">\n                    <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold text-white\" data-kid=\"2-2-4-1-1-1\" data-name=\"reception title\">\n                        Recepción del vehículo\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-4-1-1-2\" data-name=\"reception description\">\n                        Confirma la entrada y el alcance del trabajo.\n                    </p>\n                </div>\n                <span class=\"shrink-0 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-1-2\" data-name=\"step indicator text\">\n                    Paso 01\n                </span>\n            </div>\n            <div class=\"py-5\" data-kid=\"2-2-4-2\" data-name=\"reception fields\">\n                <label class=\"block text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-4-2-5\" data-name=\"mileage label\">\n                    Kilometraje de ingreso\n                    <span class=\"text-[#F87171]\" data-kid=\"2-2-4-2-5-1\" data-name=\"required asterisk\">\n                        *\n                    </span>\n                </label>\n                <div class=\"mt-2 flex min-h-[48px] items-center border border-[#475569] bg-[#111827]\" data-kid=\"2-2-4-2-1\" data-name=\"mileage input field\">\n                    <span class=\"flex h-12 w-12 shrink-0 items-center justify-center border-r border-[#334155] text-[#38BDF8]\" data-kid=\"2-2-4-2-1-1\" data-name=\"mileage icon wrapper\">\n                        <i class=\"ti ti-gauge text-[18px]\" data-kid=\"2-2-4-2-1-1-1\" data-name=\"gauge icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"px-3 text-[16px] font-bold tabular-nums text-[#F8FAFC]\" data-kid=\"2-2-4-2-1-2\" data-name=\"mileage value text\">\n                        48,260\n                    </span>\n                    <span class=\"ml-auto px-3 text-[11px] font-bold tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-1-3\" data-name=\"mileage unit label\">\n                        KM\n                    </span>\n                </div>\n                <div class=\"mt-1 flex items-start gap-1.5 text-[11px] leading-4 text-[#FCA5A5]\" data-kid=\"2-2-4-2-2\" data-name=\"mileage validation error\">\n                    <i class=\"ti ti-alert-circle mt-0.5 shrink-0 text-[13px]\" data-kid=\"2-2-4-2-2-1\" data-name=\"error alert icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-2-4-2-2-2\" data-name=\"error message\">\n                        El kilometraje debe ser mayor o igual al registrado.\n                    </span>\n                </div>\n                <label class=\"mt-6 block text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-4-2-8\" data-name=\"notes label\">\n                    Observaciones técnicas\n                </label>\n                <textarea class=\"mt-2 h-[92px] w-full resize-none border border-[#F87171] bg-[#111827] px-3 py-3 text-[13px] leading-5 text-[#E2E8F0] outline-none\" data-kid=\"2-2-4-2-3\" data-name=\"notes textarea\">Cliente reporta vibración leve al frenar en carretera.</textarea>\n                <div class=\"mt-1 flex items-start gap-1.5 text-[11px] leading-4 text-[#FCA5A5]\" data-kid=\"2-2-4-2-4\" data-name=\"notes validation error\">\n                    <i class=\"ti ti-alert-circle mt-0.5 shrink-0 text-[13px]\" data-kid=\"2-2-4-2-4-1\" data-name=\"error alert icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-2-4-2-4-2\" data-name=\"error message\">\n                        Añade el detalle de la revisión de frenos para cerrar el servicio.\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-t border-[#334155] py-5\" data-kid=\"2-2-5\" data-name=\"detected alerts section\">\n            <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"2-2-5-2\" data-name=\"alerts header\">\n                <h3 class=\"text-[13px] font-bold text-white\" data-kid=\"2-2-5-2-1\" data-name=\"alerts title\">\n                    Alertas detectadas\n                </h3>\n                <span class=\"text-right text-[11px] font-semibold text-[#F87171]\" data-kid=\"2-2-5-2-2\" data-name=\"alerts count status\">\n                    2 requieren acción\n                </span>\n            </div>\n            <div class=\"space-y-2\" data-kid=\"2-2-5-1\" data-name=\"alerts list\">\n                <div class=\"flex items-start gap-3 border-l-4 border-[#F87171] bg-[#3F1D25] px-3 py-3\" data-kid=\"2-2-5-1-1\" data-name=\"critical alert item\">\n                    <i class=\"ti ti-alert-triangle mt-0.5 shrink-0 text-[17px] text-[#F87171]\" data-kid=\"2-2-5-1-1-1\" data-name=\"alert triangle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <div data-kid=\"2-2-5-1-1-2\" data-name=\"alert item content\">\n                        <div class=\"text-[12px] font-semibold text-[#FCA5A5]\" data-kid=\"2-2-5-1-1-2-1\" data-name=\"alert title\">\n                            SOAT vencido\n                        </div>\n                        <div class=\"mt-0.5 text-[11px] leading-4 text-[#FDA4AF]\" data-kid=\"2-2-5-1-1-2-2\" data-name=\"alert description\">\n                            Renovar antes de entregar el vehículo.\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex items-start gap-3 border-l-4 border-[#FBBF24] bg-[#422006] px-3 py-3\" data-kid=\"2-2-5-1-2\" data-name=\"warning alert item\">\n                    <i class=\"ti ti-alert-circle mt-0.5 shrink-0 text-[17px] text-[#FBBF24]\" data-kid=\"2-2-5-1-2-1\" data-name=\"alert circle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <div data-kid=\"2-2-5-1-2-2\" data-name=\"alert item content\">\n                        <div class=\"text-[12px] font-semibold text-[#FDE68A]\" data-kid=\"2-2-5-1-2-2-1\" data-name=\"alert title\">\n                            Revisión de frenos\n                        </div>\n                        <div class=\"mt-0.5 text-[11px] leading-4 text-[#FCD34D]\" data-kid=\"2-2-5-1-2-2-2\" data-name=\"alert description\">\n                            Pastillas cerca del límite recomendado.\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-t border-[#334155] py-5\" data-kid=\"2-2-6\" data-name=\"maintenance tasks section\">\n            <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"2-2-6-2\" data-name=\"tasks header\">\n                <h3 class=\"text-[13px] font-bold text-white\" data-kid=\"2-2-6-2-1\" data-name=\"tasks title\">\n                    Tareas realizadas\n                </h3>\n                <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-6-2-2\" data-name=\"tasks progress count\">\n                    1 de 3 seleccionadas\n                </span>\n            </div>\n            <div class=\"divide-y divide-[#334155] border-y border-[#334155]\" data-kid=\"2-2-6-1\" data-name=\"tasks list\">\n                <label class=\"flex min-h-[52px] items-center gap-3 py-3\" data-kid=\"2-2-6-1-1\" data-name=\"task item completed\">\n                    <span class=\"flex h-5 w-5 shrink-0 items-center justify-center border border-[#34D399] bg-[#064E3B] text-[#6EE7B7]\" data-kid=\"2-2-6-1-1-1\" data-name=\"checkbox icon wrapper\">\n                        <i class=\"ti ti-check text-[14px]\" data-kid=\"2-2-6-1-1-1-1\" data-name=\"checkmark icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"flex-1 text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-6-1-1-2\" data-name=\"task title\">\n                        Cambio de aceite\n                    </span>\n                    <span class=\"text-[11px] text-[#34D399]\" data-kid=\"2-2-6-1-1-3\" data-name=\"task status label\">\n                        Realizada\n                    </span>\n                </label>\n                <label class=\"flex min-h-[52px] items-center gap-3 py-3\" data-kid=\"2-2-6-1-2\" data-name=\"task item pending\">\n                    <span class=\"flex h-5 w-5 shrink-0 items-center justify-center border border-[#475569] text-transparent\" data-kid=\"2-2-6-1-2-1\" data-name=\"checkbox icon wrapper\">\n                        <i class=\"ti ti-check text-[14px]\" data-kid=\"2-2-6-1-2-1-1\" data-name=\"checkmark icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"flex-1 text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-6-1-2-2\" data-name=\"task title\">\n                        Revisión de frenos\n                    </span>\n                    <span class=\"text-[11px] text-[#FBBF24]\" data-kid=\"2-2-6-1-2-3\" data-name=\"task status label\">\n                        Pendiente\n                    </span>\n                </label>\n                <label class=\"flex min-h-[52px] items-center gap-3 py-3\" data-kid=\"2-2-6-1-3\" data-name=\"task item pending\">\n                    <span class=\"flex h-5 w-5 shrink-0 items-center justify-center border border-[#475569] text-transparent\" data-kid=\"2-2-6-1-3-1\" data-name=\"checkbox icon wrapper\">\n                        <i class=\"ti ti-check text-[14px]\" data-kid=\"2-2-6-1-3-1-1\" data-name=\"checkmark icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"flex-1 text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-6-1-3-2\" data-name=\"task title\">\n                        Diagnóstico general\n                    </span>\n                    <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-6-1-3-3\" data-name=\"task status label\">\n                        Pendiente\n                    </span>\n                </label>\n            </div>\n        </section>\n        <section class=\"border-t border-[#475569]\" data-kid=\"2-2-7\" data-name=\"materials and labor section\">\n            <div class=\"flex items-end justify-between gap-3 border-b border-[#334155] py-4\" data-kid=\"2-2-7-1\" data-name=\"materials header\">\n                <div class=\"min-w-0\" data-kid=\"2-2-7-1-1\" data-name=\"materials header text\">\n                    <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold text-white\" data-kid=\"2-2-7-1-1-1\" data-name=\"materials title\">\n                        Materiales y mano de obra\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-7-1-1-2\" data-name=\"materials description\">\n                        Desglose que verá el propietario.\n                    </p>\n                </div>\n                <span class=\"shrink-0 text-[11px] text-[#64748B]\" data-kid=\"2-2-7-1-2\" data-name=\"step indicator text\">\n                    Paso 02\n                </span>\n            </div>\n            <div class=\"py-5\" data-kid=\"2-2-7-2\" data-name=\"materials table section\">\n                <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"2-2-7-2-2\" data-name=\"materials list header\">\n                    <h3 class=\"text-[13px] font-bold text-white\" data-kid=\"2-2-7-2-2-1\" data-name=\"materials title\">\n                        Materiales / repuestos\n                    </h3>\n                    <button class=\"min-h-[44px] px-1 text-[11px] font-bold text-[#38BDF8]\" data-kid=\"2-2-7-2-2-2\" data-name=\"add material button\">\n                        + Agregar material\n                    </button>\n                </div>\n                <div class=\"border-y border-[#334155]\" data-kid=\"2-2-7-2-1\" data-name=\"mobile materials list\">\n                    <div class=\"grid grid-cols-[minmax(0,1fr)_auto] gap-3 border-b border-[#334155] px-3 py-2.5 text-[10px] font-bold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-7-2-1-3\" data-name=\"list header row\">\n                        <span data-kid=\"2-2-7-2-1-3-1\" data-name=\"header label\">\n                            Material\n                        </span>\n                        <span class=\"text-right\" data-kid=\"2-2-7-2-1-3-2\" data-name=\"header subtotal label\">\n                            Subtotal\n                        </span>\n                    </div>\n                    <div class=\"border-b border-[#334155] px-3 py-3\" data-kid=\"2-2-7-2-1-1\" data-name=\"material card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-7-2-1-1-1\" data-name=\"material info row\">\n                            <span class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-7-2-1-1-1-1\" data-name=\"material name\">\n                                Aceite 5W-30\n                            </span>\n                            <span class=\"text-[13px] font-semibold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-7-2-1-1-1-2\" data-name=\"material cost\">\n                                $45.00\n                            </span>\n                        </div>\n                        <div class=\"mt-1 flex gap-4 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-7-2-1-1-2\" data-name=\"material details row\">\n                            <span data-kid=\"2-2-7-2-1-1-2-1\" data-name=\"quantity label\">\n                                Cant. 1\n                            </span>\n                            <span data-kid=\"2-2-7-2-1-1-2-2\" data-name=\"price label\">\n                                Precio $45.00\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"px-3 py-3\" data-kid=\"2-2-7-2-1-2\" data-name=\"material card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-7-2-1-2-1\" data-name=\"material info row\">\n                            <span class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-7-2-1-2-1-1\" data-name=\"material name\">\n                                Filtro de aceite\n                            </span>\n                            <span class=\"text-[13px] font-semibold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-7-2-1-2-1-2\" data-name=\"material cost\">\n                                $25.00\n                            </span>\n                        </div>\n                        <div class=\"mt-1 flex gap-4 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-7-2-1-2-2\" data-name=\"material details row\">\n                            <span data-kid=\"2-2-7-2-1-2-2-1\" data-name=\"quantity label\">\n                                Cant. 1\n                            </span>\n                            <span data-kid=\"2-2-7-2-1-2-2-2\" data-name=\"price label\">\n                                Precio $25.00\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"border-t border-[#334155] pt-5\" data-kid=\"2-2-7-3\" data-name=\"labor cost section\">\n                <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"2-2-7-3-2\" data-name=\"labor header\">\n                    <h3 class=\"text-[13px] font-bold text-white\" data-kid=\"2-2-7-3-2-1\" data-name=\"labor title\">\n                        Mano de obra\n                    </h3>\n                    <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-7-3-2-2\" data-name=\"labor time estimate label\">\n                        Tiempo estimado\n                    </span>\n                </div>\n                <div class=\"flex min-h-[52px] items-center justify-between border border-[#475569] bg-[#111827] px-3 py-3\" data-kid=\"2-2-7-3-1\" data-name=\"labor cost input row\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-2-7-3-1-1\" data-name=\"labor time container\">\n                        <i class=\"ti ti-clock-hour-4 text-[18px] text-[#818CF8]\" data-kid=\"2-2-7-3-1-1-1\" data-name=\"clock icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-7-3-1-1-2\" data-name=\"time duration text\">\n                            45 min\n                        </span>\n                    </div>\n                    <span class=\"text-[16px] font-bold tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-7-3-1-2\" data-name=\"labor total cost\">\n                        $110.00\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-6 flex items-end justify-between gap-4 border-y border-[#475569] py-5\" data-kid=\"2-2-7-4\" data-name=\"service total section\">\n                <div data-kid=\"2-2-7-4-1\" data-name=\"total description container\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[#94A3B8]\" data-kid=\"2-2-7-4-1-1\" data-name=\"total label\">\n                        Costo del servicio\n                    </div>\n                    <div class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-7-4-1-2\" data-name=\"total sublabel\">\n                        Incluye materiales y mano de obra\n                    </div>\n                </div>\n                <span class=\"shrink-0 text-[26px] font-bold tabular-nums text-[#38BDF8] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-2-7-4-2\" data-name=\"total amount\">\n                    $180.00\n                </span>\n            </div>\n            <div class=\"mt-6\" data-kid=\"2-2-7-5\" data-name=\"invoice upload section\">\n                <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"2-2-7-5-2\" data-name=\"invoice header\">\n                    <h3 class=\"text-[13px] font-bold text-white\" data-kid=\"2-2-7-5-2-1\" data-name=\"invoice title\">\n                        Factura / comprobante\n                    </h3>\n                    <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-7-5-2-2\" data-name=\"optional badge\">\n                        Opcional\n                    </span>\n                </div>\n                <div class=\"flex flex-col gap-3 border border-dashed border-[#475569] bg-[#111827] px-4 py-4\" data-kid=\"2-2-7-5-1\" data-name=\"invoice drop zone\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-2-7-5-1-1\" data-name=\"drop zone content\">\n                        <i class=\"ti ti-file-invoice shrink-0 text-[20px] text-[#94A3B8]\" data-kid=\"2-2-7-5-1-1-1\" data-name=\"invoice icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <div data-kid=\"2-2-7-5-1-1-2\" data-name=\"drop zone text\">\n                            <div class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-7-5-1-1-2-1\" data-name=\"drop zone title\">\n                                Adjuntar factura\n                            </div>\n                            <div class=\"mt-0.5 text-[11px] leading-4 text-[#64748B]\" data-kid=\"2-2-7-5-1-1-2-2\" data-name=\"drop zone help text\">\n                                PDF, JPG o PNG · máximo 10 MB\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"flex min-h-[44px] items-center justify-center gap-2 border border-[#475569] px-3 text-[11px] font-bold text-[#CBD5E1]\" data-kid=\"2-2-7-5-1-2\" data-name=\"choose file button\">\n                        <i class=\"ti ti-paperclip text-[15px] text-[#38BDF8]\" data-kid=\"2-2-7-5-1-2-1\" data-name=\"paperclip icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Elegir archivo\n                    </button>\n                </div>\n            </div>\n            <button class=\"mt-7 flex min-h-[52px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-5 py-3 text-[13px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-2-7-6\" data-name=\"save service button\">\n                <i class=\"ti ti-check text-[16px]\" data-kid=\"2-2-7-6-1\" data-name=\"check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Guardar servicio\n            </button>\n        </section>\n        <footer class=\"mt-9 flex flex-col gap-2 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-3\" data-name=\"mobile footer\">\n            <span data-kid=\"2-3-1\" data-name=\"brand footer text\">\n                AutoDoc · Operación del taller\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-3-2\" data-name=\"sync status container\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-3-2-1\" data-name=\"sync status dot\">\n                </span>\n                Datos sincronizados hace 4 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación móvil del taller\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/95 px-2 pt-2 backdrop-blur-sm\" data-kid=\"3\" data-name=\"fixed mobile bottom navigation\" style=\"padding-bottom:max(10px, env(safe-area-inset-bottom));\">\n        <div class=\"grid grid-cols-5 gap-1\" data-kid=\"3-1\" data-name=\"mobile navigation destinations\">\n            <a aria-current=\"page\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"3-1-1\" data-name=\"navigation link dashboard\" href=\"#panel\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"3-1-1-1\" data-name=\"dashboard icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"3-1-1-2\" data-name=\"navigation link text\">\n                    Panel\n                </span>\n            </a>\n            <a class=\"relative flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"3-1-2\" data-name=\"navigation link repairs\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[18px]\" data-kid=\"3-1-2-1\" data-name=\"repairs icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"3-1-2-2\" data-name=\"navigation link text\">\n                    Reparaciones\n                </span>\n                <span class=\"absolute right-2 top-1 rounded-[4px] bg-[#075985] px-1 text-[9px] font-bold text-[#BAE6FD]\" data-kid=\"3-1-2-3\" data-name=\"repairs count badge\">\n                    04\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"3-1-3\" data-name=\"navigation link search\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[18px]\" data-kid=\"3-1-3-1\" data-name=\"search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"3-1-3-2\" data-name=\"navigation link text\">\n                    Buscar\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"3-1-4\" data-name=\"navigation link history\" href=\"#historial\">\n                <i class=\"ti ti-history text-[18px]\" data-kid=\"3-1-4-1\" data-name=\"history icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"3-1-4-2\" data-name=\"navigation link text\">\n                    Historial\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"3-1-5\" data-name=\"navigation link messages\" href=\"#conversaciones\">\n                <i class=\"ti ti-message-2 text-[18px]\" data-kid=\"3-1-5-1\" data-name=\"messages icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"3-1-5-2\" data-name=\"navigation link text\">\n                    Mensajes\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
