   <span class=\"sr-only\" data-kid=\"1-2-3-2-2\">\n                    Vehículo:\n                </span>\n                Corolla\n            </span>\n        </div>\n        <section aria-labelledby=\"mobile-active-alerts-heading\" class=\"mt-3 space-y-3\" data-kid=\"1-2-4\" data-name=\"mobile operational alerts list\">\n            <article class=\"border border-[#CBD5E1] border-l-4 border-l-[#EF4444] bg-white px-4 py-4\" data-kid=\"1-2-4-1\" data-name=\"mobile critical SOAT alert card\">\n                <div class=\"flex items-start gap-3\" data-kid=\"1-2-4-1-4\">\n                    <div class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#FEF2F2] text-[20px] text-[#EF4444]\" data-kid=\"1-2-4-1-1\" data-name=\"critical alert icon container\">\n                        <i class=\"ti ti-alert-triangle\" data-kid=\"1-2-4-1-1-1\" data-name=\"alert triangle icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-1-4-2\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-4-1-4-2-1\">\n                            <span class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#B91C1C]\" data-kid=\"1-2-4-1-4-2-1-1\" data-name=\"critical status label\">\n                                Crítica\n                            </span>\n                            <span class=\"size-1 rounded-full bg-[#CBD5E1]\" data-kid=\"1-2-4-1-4-2-1-2\">\n                            </span>\n                            <span class=\"text-[11px] font-medium text-[#64748B]\" data-dynamic=\"true\" data-kid=\"1-2-4-1-4-2-1-3\" data-name=\"alert time label\" data-reason=\"relative time string updated by script\">\n                                Hoy\n                            </span>\n                        </div>\n                        <h3 class=\"mt-1 font-heading text-[16px] font-bold leading-5 text-[#0F172A]\" data-kid=\"1-2-4-1-4-2-2\" data-name=\"SOAT alert title\">\n                            SOAT vencido\n                        </h3>\n                        <p class=\"mt-1 text-[13px] text-[#475569]\" data-kid=\"1-2-4-1-4-2-3\" data-name=\"SOAT alert vehicle info\">\n                            Toyota Corolla 2022\n                            <span class=\"text-[#CBD5E1]\" data-kid=\"1-2-4-1-4-2-3-1\">\n                                ·\n                            </span>\n                            P 482-916\n                        </p>\n                        <p class=\"mt-2 text-[13px] font-medium leading-5 text-[#7F1D1D]\" data-kid=\"1-2-4-1-4-2-4\" data-name=\"SOAT alert message\">\n                            Renueva la cobertura antes de circular.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-4 border-t border-[#F1F5F9] pt-3\" data-kid=\"1-2-4-1-2\" data-name=\"critical alert action details\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"1-2-4-1-2-1\">\n                        Acción requerida\n                    </p>\n                    <p class=\"mt-1 text-[12px] text-[#475569]\" data-kid=\"1-2-4-1-2-2\">\n                        Vehículo no habilitado\n                    </p>\n                    <button class=\"mt-3 flex min-h-[44px] w-full items-center justify-center gap-1 border border-[#EF4444] bg-white px-3.5 py-2.5 text-[12px] font-bold text-[#B91C1C]\" data-kid=\"1-2-4-1-3\" data-name=\"resolve SOAT button\">\n                        Resolver ahora\n                        <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-4-1-3-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </article>\n            <article