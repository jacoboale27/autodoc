      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"relative min-h-screen overflow-hidden bg-[#522C81] text-white antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"splash loading screen\">\n    <div class=\"pointer-events-none absolute -left-44 -top-44 size-[560px] rounded-full\" data-kid=\"2-1\" data-name=\"success decorative radial blob\" style=\"background:radial-gradient(circle,rgba(72,187,120,0.18) 0%,rgba(72,187,120,0.05) 43%,transparent 70%)\">\n    </div>\n    <div class=\"pointer-events-none absolute -bottom-64 -right-56 size-[680px] rounded-full\" data-kid=\"2-2\" data-name=\"secondary decorative radial blob\" style=\"background:radial-gradient(circle,rgba(129,230,217,0.18) 0%,rgba(129,230,217,0.05) 44%,transparent 70%)\">\n    </div>\n    <button aria-label=\"Configuración\" class=\"absolute right-10 top-9 z-10 flex size-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/35 shadow-[0_2px_4px_rgba(15,23,42,0.08)] transition duration-150 ease-out hover:bg-white/10 hover:text-white/70 active:scale-[0.97] motion-reduce:transition-none\" data-kid=\"2-3\" data-name=\"quiet settings action\">\n        <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-3-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n        </i>\n    </button>\n    <main class=\"relative mx-auto flex min-h-screen w-full max-w-[1280px] flex-col items-center justify-center px-12 py-16\" data-kid=\"2-4\" data-name=\"splash content frame\">\n        <section class=\"flex flex-col items-center text-center\" data-kid=\"2-4-1\" data-name=\"splash branding group\">\n            <div class=\"relative flex size-[168px] items-center justify-center\" data-kid=\"2-4-1-1\" data-name=\"isotype logo stage\">\n                <div class=\"absolute size-[126px] rotate-45 rounded-[24px] border border-white/10 bg-white/10\" data-kid=\"2-4-1-1-1\" data-name=\"rotated logo surface\">\n                </div>\n                <div class=\"absolute size-[142px] -rotate-[12deg] rounded-[30px] border-[4px] border-[#81E6D9]/45\" data-kid=\"2-4-1-1-2\" data-name=\"rotated secondary outline\">\n                </div>\n                <div class=\"relative flex size-[96px] items-center justify-center rounded-[18px] bg-white p-4 shadow-[0_18px_36px_rgba(15,23,42,0.24)]\" data-kid=\"2-4-1-1-3\" data-name=\"isotype logo tile\">\n                    <img alt=\"AutoDoc\" class=\"size-full object-contain\" data-kid=\"2-4-1-1-3-1\" data-name=\"AutoDoc isotype logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/logo/autodoc_isotype.svg\"/>\n                </div>\n            </div>\n            <div class=\"mt-9 [font-family:'Plus_Jakarta_Sans',sans-serif] text-[52px] font-extrabold leading-none tracking-[-0.065em]\" data-kid=\"2-4-1-2\" data-name=\"AutoDoc wordmark\">\n                <span class=\"text-white\" data-kid=\"2-4-1-2-1\" data-name=\"wordmark prefix text\">\n                    Auto\n                </span>\n                <span class=\"text-[#81E6D9]\" data-kid=\"2-4-1-2-2\" data-name=\"wordmark suffix text\">\n                    Doc\n                </span>\n            </div>\n            <p class=\"mt-4 text-[12px] font-semibold uppercase tracking-[0.42em] text-white/80\" data-kid=\"2-4-1-3\" data-name=\"professional diagnostic slogan\">\n                DIAGNÓSTICO PROFESIONAL\n            </p>\n        </section>\n        <section class=\"mt-24 flex flex-col items-center\" data-kid=\"2-4-2\" data-name=\"session resolution loading state\">\n            <div class=\"relative flex size-[58px] items-center justify-center\" data-kid=\"2-4-2-1\" data-name=\"circular car loading indicator\">\n                <div class=\"absolute inset-0 rounded-full border-[4px] border-[#81E6D9]/20\" data-kid=\"2-4-2-1-1\" data-name=\"loading ring track\">\n                </div>\n                <div class=\"absolute inset-0 animate-spin rounded-full border-[4px] border-transparent border-t-[#81E6D9] border-r-[#81E6D9] motion-reduce:animate-none\" data-kid=\"2-4-2-1-2\" data-name=\"loading ring progress\">\n                </div>\n                <i class=\"ti ti-car text-[17px] text-[#81E6D9]\" data-kid=\"2-4-2-1-3\" data-name=\"loading car icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <p class=\"mt-7 text-[16px] font-semibold tracking-[-0.01em] text-white/90\" data-kid=\"2-4-2-2\" data-name=\"loading status label\">\n                Cargando datos...\n            </p>\n            <div class=\"mt-4 h-1 w-[240px] overflow-hidden rounded-full bg-white/15\" data-kid=\"2-4-2-3\" data-name=\"indeterminate progress track\">\n                <div class=\"h-full w-2/5 animate-pulse rounded-full bg-[#81E6D9] motion-reduce:animate-none\" data-kid=\"2-4-2-3-1\" data-name=\"indeterminate progress value\">\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n",
