      "themeId": null,
      "rect": {
        "x": 60740,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"google icons library\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#E2E8F0] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"mobile conversation inbox root\">\n    <header class=\"sticky top-0 z-20 flex h-16 items-center justify-between border-b border-[#334155] bg-[#0B1220]/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[18px] font-extrabold tracking-[-0.08em] text-[#082F49] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1\" data-name=\"autodoc mobile logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"mobile title group\">\n                <div class=\"truncate text-[10px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"mobile role label\">\n                    Propietario\n                </div>\n                <div class=\"truncate text-[16px] font-extrabold tracking-[-0.03em] text-[#F8FAFC] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-2-2\" data-name=\"mobile page title\">\n                    Conversaciones\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header actions\">\n            <button aria-label=\"Cambiar tema\" class=\"flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-2-1\" data-name=\"mobile theme button\">\n                <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-2-1-1\" data-name=\"theme icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-2-2\" data-name=\"mobile notifications button\">\n                <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-2-2-1\" data-name=\"notifications icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-2\" data-name=\"notification indicator\">\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"px-4 pb-28 pt-4\" data-kid=\"2-2\" data-name=\"mobile inbox content\">\n        <div class=\"mb-4 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-1\" data-name=\"mobile breadcrumb\">\n            <span data-kid=\"2-2-1-1\" data-name=\"breadcrumb role text\">\n                Propietario\n            </span>\n            <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-2-1-2\" data-name=\"breadcrumb separator\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"font-semibold text-[#E2E8F0]\" data-kid=\"2-2-1-3\" data-name=\"breadcrumb page title\">\n                Conversaciones\n            </span>\n        </div>\n        <section class=\"border border-[#334155] bg-[#0B1220]\" data-kid=\"2-2-2\" data-name=\"conversation list section\">\n            <div class=\"border-b border-[#334155] px-4 pb-4 pt-4\" data-kid=\"2-2-2-1\" data-name=\"inbox controls\">\n                <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-2-1-1\" data-name=\"inbox heading row\">\n                    <div data-kid=\"2-2-2-1-1-1\" data-name=\"inbox title container\">\n                        <div class=\"text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"inbox title role label\">\n                            Propietario\n                        </div>\n                        <h1 class=\"mt-1 text-[20px] font-extrabold tracking-[-0.035em] text-[#F8FAFC] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"inbox page title\">\n                            Conversaciones\n                        </h1>\n                    </div>\n                    <button aria-label=\"Nueva conversación\" class=\"flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#38BDF8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:scale-[1.02] active:scale-[0.97]\" data-kid=\"2-2-2-1-1-2\" data-name=\"new conversation button\">\n                        <i class=\"ti ti-edit text-[18px]\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"new conversation icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"mt-4 flex h-12 items-center gap-3 border border-[#475569] bg-[#0F172A] px-3 text-[#94A3B8]\" data-kid=\"2-2-2-1-2\" data-name=\"conversation search field\">\n                    <i class=\"ti ti-search text-[17px]\" data-kid=\"2-2-2-1-2-1\" data-name=\"search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 truncate text-[12px]\" data-kid=\"2-2-2-1-2-2\" data-name=\"search placeholder\">\n                        Buscar conversación\n                    </span>\n                    <span class=\"text-[10px] text-[#64748B]\" data-kid=\"2-2-2-1-2-3\" data-name=\"search keyboard shortcut\">\n                        ⌘ K\n                    </span>\n                </div>\n                <div aria-label=\"Filtros de conversaciones\" class=\"mt-4 flex items-center gap-6 text-[12px]\" data-kid=\"2-2-2-1-3\" data-name=\"conversation filter tabs\" role=\"tablist\">\n                    <button aria-selected=\"true\" class=\"relative min-h-[32px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-2-1-3-1\" data-name=\"all conversations tab\" role=\"tab\">\n                        Todas\n                        <span class=\"tabular-nums\" data-kid=\"2-2-2-1-3-1-1\" data-name=\"all conversations count\">\n                            3\n                        </span>\n                        <span class=\"absolute -bottom-[17px] left-0 h-0.5 w-full bg-[#38BDF8]\" data-kid=\"2-2-2-1-3-1-2\" data-name=\"active tab indicator\">\n                        </span>\n                    </button>\n                    <button aria-selected=\"false\" class=\"min-h-[32px] text-[#94A3B8]\" data-kid=\"2-2-2-1-3-2\" data-name=\"unread conversations tab\" role=\"tab\">\n                        No leídas\n                        <span class=\"tabular-nums\" data-kid=\"2-2-2-1-3-2-1\" data-name=\"unread conversations count\">\n                            1\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <div data-kid=\"2-2-2-2\" data-name=\"conversation thread list\">\n                <button class=\"flex min-h-[104px] w-full items-start gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-4 py-4 text-left\" data-kid=\"2-2-2-2-1\" data-name=\"selected taller rapido conversation\">\n                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#075985] text-[12px] font-bold text-[#BAE6FD]\" data-kid=\"2-2-2-2-1-1\" data-name=\"taller rapido avatar\">\n                        TR\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"2-2-2-2-1-2\" data-name=\"taller rapido info\">\n                        <span class=\"flex items-center justify-between gap-2\" data-kid=\"2-2-2-2-1-2-1\" data-name=\"taller rapido header\">\n                            <strong class=\"truncate text-[13px] text-[#F8FAFC]\" data-kid=\"2-2-2-2-1-2-1-1\" data-name=\"taller rapido name\">\n                                Taller Rápido\n                            </strong>\n                            <span class=\"text-[11px] font-semibold tabular-nums text-[#38BDF8]\" data-kid=\"2-2-2-2-1-2-1-2\" data-name=\"taller rapido time\">\n                                09:42\n                            </span>\n                        </span>\n                        <span class=\"mt-1 block truncate text-[12px] text-[#E2E8F0]\" data-kid=\"2-2-2-2-1-2-2\" data-name=\"taller rapido preview\">\n                            La revisión estará lista mañana\n                        </span>\n                        <span class=\"mt-2 flex items-center gap-2 text-[10px] text-[#34D399]\" data-kid=\"2-2-2-2-1-2-3\" data-name=\"taller rapido status\">\n                            <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-2-2-1-2-3-1\" data-name=\"taller rapido status dot\">\n                            </span>\n                            En línea · Toyota Corolla\n                        </span>\n                    </span>\n                </button>\n                <button class=\"flex min-h-[104px] w-full items-start gap-3 border-t border-[#334155] px-4 py-4 text-left\" data-kid=\"2-2-2-2-2\" data-name=\"motorlab conversation\">\n                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#312E81] text-[12px] font-bold text-[#C7D2FE]\" data-kid=\"2-2-2-2-2-1\" data-name=\"motorlab avatar\">\n                        ML\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"2-2-2-2-2-2\" data-name=\"motorlab info\">\n                        <span class=\"flex items-center justify-between gap-2\" data-kid=\"2-2-2-2-2-2-1\" data-name=\"motorlab header\">\n                            <strong class=\"truncate text-[13px] text-[#E2E8F0]\" data-kid=\"2-2-2-2-2-2-1-1\" data-name=\"motorlab name\">\n                                MotorLab\n                            </strong>\n                            <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-2-2-1-2\" data-name=\"motorlab time\">\n                                Ayer\n                            </span>\n                        </span>\n                        <span class=\"mt-1 block truncate text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-2-2-2-2\" data-name=\"motorlab preview\">\n                            Te enviamos la cotización\n                        </span>\n                        <span class=\"mt-2 block text-[10px] text-[#FBBF24]\" data-kid=\"2-2-2-2-2-2-3\" data-name=\"motorlab status\">\n                            Cotización pendiente\n                        </span>\n                    </span>\n                </button>\n                <button class=\"flex min-h-[104px] w-full items-start gap-3 border-t border-[#334155] px-4 py-4 text-left\" data-kid=\"2-2-2-2-3\" data-name=\"centro auto conversation\">\n                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#CBD5E1]\" data-kid=\"2-2-2-2-3-1\" data-name=\"centro auto avatar\">\n                        CA\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"2-2-2-2-3-2\" data-name=\"centro auto info\">\n                        <span class=\"flex items-center justify-between gap-2\" data-kid=\"2-2-2-2-3-2-1\" data-name=\"centro auto header\">\n                            <strong class=\"truncate text-[13px] text-[#E2E8F0]\" data-kid=\"2-2-2-2-3-2-1-1\" data-name=\"centro auto name\">\n                                Centro Auto\n                            </strong>\n                            <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-3-2-1-2\" data-name=\"centro auto time\">\n                                Lun\n                            </span>\n                        </span>\n                        <span class=\"mt-1 block truncate text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-2-3-2-2\" data-name=\"centro auto preview\">\n                            ¿Podemos ayudarte?\n                        </span>\n                        <span class=\"mt-2 block text-[10px] text-[#64748B]\" data-kid=\"2-2-2-2-3-2-3\" data-name=\"centro auto status\">\n                            Sin mensajes nuevos\n                        </span>\n                    </span>\n                </button>\n            </div>\n            <div class=\"border-t border-[#334155] px-4 py-3 text-[11px] text-[#64748B]\" data-kid=\"2-2-2-3\" data-name=\"inbox footer status\">\n                3 conversaciones activas\n            </div>\n        </section>\n        <section class=\"mt-6 rounded-[16px] border border-[#334155] bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-3\" data-name=\"selected conversation preview container\">\n            <div class=\"border-b border-[#334155] px-4 py-4\" data-kid=\"2-2-3-1\" data-name=\"selected conversation header\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-1-3\" data-name=\"selected header content\">\n                    <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-2-3-1-3-1\" data-name=\"selected header info\">\n                        <span class=\"flex size-11 shrink-0 items-center justify-center rounded-full bg-[#075985] text-[12px] font-bold text-[#BAE6FD]\" data-kid=\"2-2-3-1-3-1-1\" data-name=\"selected header avatar\">\n                            TR\n                        </span>\n                        <div class=\"min-w-0\" data-kid=\"2-2-3-1-3-1-2\" data-name=\"selected header details\">\n                            <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"2-2-3-1-3-1-2-1\" data-name=\"selected header title row\">\n                                <h2 class=\"text-[16px] font-bold tracking-[-0.02em] text-[#F8FAFC] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-2-3-1-3-1-2-1-1\" data-name=\"selected conversation name\">\n                                    Taller Rápido\n                                </h2>\n                                <span class=\"flex items-center gap-1 text-[10px] font-semibold text-[#34D399]\" data-kid=\"2-2-3-1-3-1-2-1-2\" data-name=\"selected status text\">\n                                    <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-3-1-3-1-2-1-2-1\" data-name=\"selected status dot\">\n                                    </span>\n                                    En línea\n                                </span>\n                            </div>\n                            <p class=\"mt-1 truncate text-[11px] text-[#94A3B8]\" data-kid=\"2-2-3-1-3-1-2-2\" data-name=\"selected vehicle description\">\n                                Toyota Corolla 2022 · P 482-916\n                            </p>\n                        </div>\n                    </div>\n                    <button aria-label=\"Más opciones\" class=\"flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-2-3-1-1\" data-name=\"more options button\">\n                        <i class=\"ti ti-dots text-[17px]\" data-kid=\"2-2-3-1-1-1\" data-name=\"more options icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <button class=\"mt-3 flex min-h-[48px] w-full items-center justify-center gap-2 border border-[#475569] px-4 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-3-1-2\" data-name=\"view vehicle button\">\n                    <i class=\"ti ti-car text-[15px] text-[#38BDF8]\" data-kid=\"2-2-3-1-2-1\" data-name=\"view vehicle icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Ver vehículo\n                </button>\n            </div>\n            <div class=\"px-4 py-5\" data-kid=\"2-2-3-2\" data-name=\"conversation reading column\">\n                <div class=\"mb-5 flex items-center gap-3 text-[9px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-3-2-2\" data-name=\"date divider\">\n                    <span class=\"h-px flex-1 bg-[#334155]\" data-kid=\"2-2-3-2-2-1\" data-name=\"divider line left\">\n                    </span>\n                    <span class=\"shrink-0\" data-kid=\"2-2-3-2-2-2\" data-name=\"date text\">\n                        Hoy · 15 jul 2026\n                    </span>\n                    <span class=\"h-px flex-1 bg-[#334155]\" data-kid=\"2-2-3-2-2-3\" data-name=\"divider line right\">\n                    </span>\n                </div>\n                <div class=\"space-y-5\" data-kid=\"2-2-3-2-1\" data-name=\"conversation message preview\">\n                    <div class=\"flex items-start gap-2\" data-kid=\"2-2-3-2-1-1\" data-name=\"received message container\">\n                        <span class=\"mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-[#075985] text-[10px] font-bold text-[#BAE6FD]\" data-kid=\"2-2-3-2-1-1-1\" data-name=\"received message avatar\">\n                            TR\n                        </span>\n                        <div class=\"min-w-0\" data-kid=\"2-2-3-2-1-1-2\" data-name=\"received message content\">\n                            <div class=\"mb-2 text-[10px] text-[#64748B]\" data-kid=\"2-2-3-2-1-1-2-1\" data-name=\"received message meta\">\n                                Taller Rápido · 09:36\n                            </div>\n                            <div class=\"border border-[#475569] bg-[#1E293B] px-3 py-3 text-[13px] leading-6 text-[#E2E8F0]\" data-kid=\"2-2-3-2-1-1-2-2\" data-name=\"received message text\">\n                                Hola Juan, revisamos el Corolla y encontramos desgaste en las pastillas.\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex items-start justify-end gap-2\" data-kid=\"2-2-3-2-1-2\" data-name=\"sent message container\">\n                        <div class=\"min-w-0 max-w-[82%]\" data-kid=\"2-2-3-2-1-2-1\" data-name=\"sent message content\">\n                            <div class=\"mb-2 text-right text-[10px] text-[#64748B]\" data-kid=\"2-2-3-2-1-2-1-1\" data-name=\"sent message meta\">\n                                Tú · 09:38\n                            </div>\n                            <div class=\"border border-[#0E7490] bg-[#075985] px-3 py-3 text-[13px] leading-6 text-[#F0F9FF]\" data-kid=\"2-2-3-2-1-2-1-2\" data-name=\"sent message text\">\n                                ¿Cuánto tardaría el cambio?\n                            </div>\n                        </div>\n                        <span class=\"mt-6 flex size-8 shrink-0 items-center justify-center rounded-full bg-[#38BDF8] text-[10px] font-bold text-[#082F49]\" data-kid=\"2-2-3-2-1-2-2\" data-name=\"sent message avatar\">\n                            JP\n                        </span>\n                    </div>\n                    <div class=\"flex items-start gap-2\" data-kid=\"2-2-3-2-1-3\" data-name=\"received message with quote\">\n                        <span class=\"mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-[#075985] text-[10px] font-bold text-[#BAE6FD]\" data-kid=\"2-2-3-2-1-3-2\" data-name=\"received message avatar\">\n                            TR\n                        </span>\n                        <div class=\"min-w-0\" data-kid=\"2-2-3-2-1-3-3\" data-name=\"received message content\">\n                            <div class=\"mb-2 text-[10px] text-[#64748B]\" data-kid=\"2-2-3-2-1-3-3-1\" data-name=\"received message meta\">\n                                Taller Rápido · 09:40\n                            </div>\n                            <div class=\"border border-[#475569] bg-[#1E293B] px-3 py-3 text-[13px] leading-6 text-[#E2E8F0]\" data-kid=\"2-2-3-2-1-3-3-2\" data-name=\"received message text\">\n                                Aproximadamente 45 minutos. Te comparto la cotización.\n                            </div>\n                            <div class=\"mt-3 border-l-2 border-[#38BDF8] bg-[#1E293B]\" data-kid=\"2-2-3-2-1-3-1\" data-name=\"quote preview card\">\n                                <div class=\"flex flex-wrap items-center justify-between gap-2 border-b border-[#475569] px-3 py-3\" data-kid=\"2-2-3-2-1-3-1-2\" data-name=\"quote header\">\n                                    <span class=\"flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.12em] text-[#7DD3FC]\" data-kid=\"2-2-3-2-1-3-1-2-1\" data-name=\"quote title\">\n                                        <i class=\"ti ti-file-invoice text-[15px]\" data-kid=\"2-2-3-2-1-3-1-1\" data-name=\"quote icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                        Cotización de servicio\n                                    </span>\n                                    <span class=\"border border-[#FBBF24]/50 px-2 py-1 text-[10px] font-bold text-[#FCD34D]\" data-kid=\"2-2-3-2-1-3-1-2-2\" data-name=\"quote status\">\n                                        Pendiente\n                                    </span>\n                                </div>\n                                <div class=\"flex flex-col gap-3 px-3 py-4\" data-kid=\"2-2-3-2-1-3-1-3\" data-name=\"quote body\">\n                                    <div data-kid=\"2-2-3-2-1-3-1-3-1\" data-name=\"quote service details\">\n                                        <strong class=\"block text-[14px] font-semibold text-[#F8FAFC]\" data-kid=\"2-2-3-2-1-3-1-3-1-1\" data-name=\"quote service name\">\n                                            Cambio de pastillas\n                                        </strong>\n                                        <span class=\"mt-1 block text-[11px] text-[#94A3B8]\" data-kid=\"2-2-3-2-1-3-1-3-1-2\" data-name=\"quote service description\">\n                                            Incluye mano de obra · 45 min\n                                        </span>\n                                    </div>\n                                    <span class=\"text-[20px] font-bold tabular-nums text-[#F8FAFC]\" data-kid=\"2-2-3-2-1-3-1-3-3\" data-name=\"quote price\">\n                                        $180.00\n                                    </span>\n                                </div>\n                                <div class=\"border-t border-[#475569] px-3 py-3\" data-kid=\"2-2-3-2-1-3-1-4\" data-name=\"quote footer\">\n                                    <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-3-2-1-3-1-4-1\" data-name=\"quote note\">\n                                        Reserva sugerida · mañana 10:00\n                                    </div>\n                                    <button class=\"mt-3 flex min-h-[48px] w-full items-center justify-center gap-2 bg-[#38BDF8] px-4 text-[11px] font-bold text-[#082F49]\" data-kid=\"2-2-3-2-1-3-1-3-2\" data-name=\"quote action button\">\n                                        Abrir conversación\n                                        <i class=\"ti ti-arrow-up-right text-[14px]\" data-kid=\"2-2-3-2-1-3-1-3-2-1\" data-name=\"quote arrow\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                        </i>\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-6 border-t border-[#334155] pt-4\" data-kid=\"2-2-3-3\" data-name=\"open conversation action area\">\n                    <div class=\"text-[12px] text-[#94A3B8]\" data-kid=\"2-2-3-3-2\" data-name=\"action helper text\">\n                        Vista previa de la conversación seleccionada\n                    </div>\n                    <button class=\"mt-3 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full border border-[#81E6D9] bg-transparent px-5 text-[12px] font-bold text-[#81E6D9] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#141E36] hover:scale-[1.02] active:scale-[0.97]\" data-kid=\"2-2-3-3-1\" data-name=\"open conversation button\">\n                        Abrir conversación\n                        <i class=\"ti ti-arrow-right text-[15px]\" data-kid=\"2-2-3-3-1-1\" data-name=\"open conversation arrow\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </section>\n    </main>\n    <nav aria-label=\"Navegación móvil\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/95 px-2 pb-[max(10px,env(safe-area-inset-bottom))] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"fixed mobile navigation\">\n        <div class=\"mx-auto flex max-w-[375px] items-center justify-around\" data-kid=\"2-3-1\" data-name=\"navigation items container\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-[44px] min-w-[60px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"navigation home link\" href=\"#\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"2-3-1-1\" data-name=\"home icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"navigation home label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-[44px] min-w-[60px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"navigation garage link\" href=\"#\">\n                <i class=\"ti ti-steering-wheel text-[18px]\" data-kid=\"2-3-2-1\" data-name=\"garage icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"navigation garage label\">\n                    Mi garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-[44px] min-w-[60px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-4\" data-name=\"navigation workshops link\" href=\"#\">\n                <i class=\"ti ti-tool text-[18px]\" data-kid=\"2-3-3-1\" data-name=\"workshops icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"navigation workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Conversaciones\" class=\"flex min-h-[44px] min-w-[60px] flex-col items-center justify-center gap-1 text-[#38BDF8]\" data-kid=\"2-3-1-5\" data-name=\"navigation messages link\" href=\"#\">\n                <i class=\"ti ti-message-2 text-[18px]\" data-kid=\"2-3-4-1\" data-name=\"messages icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-5-2\" data-name=\"navigation messages label\">\n                    Conversaciones\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
