    "var_5f8c07a0f0da": {
      "type": "variant",
      "label": "AutoDoc Profile Setup — Hadrian Dark Mobile",
      "parentId": "var_9d01d712154b",
      "themeId": null,
      "rect": {
        "x": 105260,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .profile-mobile-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .profile-mobile-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"profile-mobile-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"1\" data-name=\"profile setup dark mobile\">\n    <header class=\"sticky top-0 z-20 border-b border-[#334155] bg-[#0B1220]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"profile setup mobile header\">\n        <div class=\"flex min-h-[48px] items-center justify-between gap-3\" data-kid=\"1-1-1\" data-name=\"header contents container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"logo and branding group\">\n                <div class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[#81E6D9] text-[#0F172A] shadow-[0_8px_24px_rgba(129,230,217,0.14)]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon container\">\n                    <i class=\"ti ti-car text-[19px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"car icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"app title group\">\n                    <div class=\"profile-mobile-heading truncate text-[15px] font-bold tracking-[-0.03em] text-[#F8FAFC]\" data-kid=\"1-1-1-1-2-1\" data-name=\"app name text\">\n                        AutoDoc\n                    </div>\n                    <div class=\"text-[10px] font-semibold uppercase tracking-[0.18em] text-[#64748B]\" data-kid=\"1-1-1-1-2-2\" data-name=\"page title label\">\n                        Configuración de perfil\n                    </div>\n                </div>\n            </div>\n            <button aria-label=\"Salir\" class=\"flex min-h-[48px] min-w-[48px] shrink-0 items-center justify-center gap-2 rounded-full border border-[#334155] bg-[#141E36] px-3 text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-1-1-2\" data-name=\"logout button\">\n                <i class=\"ti ti-logout text-[17px]\" data-kid=\"1-1-1-2-1\" data-name=\"logout icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[11px] font-semibold\" data-kid=\"1-1-1-2-2\" data-name=\"logout text\">\n                    Salir\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[132px] pt-6\" data-kid=\"1-2\" data-name=\"main form area\">\n        <div class=\"mx-auto w-full max-w-[560px]\" data-kid=\"1-2-1\" data-name=\"form layout constraint wrapper\">\n            <div class=\"mb-5\" data-kid=\"1-2-1-1\" data-name=\"hero form header\">\n                <p class=\"mb-3 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[#81E6D9]\" data-kid=\"1-2-1-1-1\" data-name=\"section breadcrumb indicator\">\n                    <span class=\"size-1.5 rounded-full bg-[#81E6D9]\" data-kid=\"1-2-1-1-1-1\" data-name=\"breadcrumb dot\">\n                    </span>\n                    Tu espacio personal\n                </p>\n                <h1 class=\"profile-mobile-heading text-[25px] font-extrabold leading-[1.12] tracking-[-0.05em] text-[#F8FAFC]\" data-kid=\"1-2-1-1-2\" data-name=\"form welcome heading\">\n                    ¡Bienvenido a AutoDoc!\n                </h1>\n                <p class=\"mt-3 text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"1-2-1-1-3\" data-name=\"form description text\">\n                    Configura tu perfil para obtener diagnósticos personalizados y alertas precisas para tu vehículo.\n                </p>\n            </div>\n            <section class=\"overflow-hidden rounded-[16px] border border-[#334155] bg-[#141E36] shadow-[0_8px_24px_rgba(2,6,23,0.26)]\" data-kid=\"1-2-1-2\" data-name=\"profile setup form card\">\n                <div class=\"p-4\" data-kid=\"1-2-1-2-1\" data-name=\"form fields wrapper\">\n                    <div class=\"flex items-center gap-4 border-b border-[#334155] pb-5\" data-kid=\"1-2-1-2-1-1\" data-name=\"profile photo picker row\">\n                        <div class=\"relative flex size-[88px] shrink-0 items-center justify-center rounded-full border-[3px] border-[#81E6D9]/60 bg-[#1E293B] text-[#81E6D9]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"avatar preview container\">\n                            <i class=\"ti ti-user text-[45px]\" data-kid=\"1-2-1-2-1-1-1-1\" data-name=\"user icon\" style=\"width:45px;height:45px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <button aria-label=\"Elegir foto de perfil\" class=\"absolute -bottom-1 -right-1 flex size-12 items-center justify-center rounded-full border-2 border-[#141E36] bg-[#81E6D9] text-[#0F172A] shadow-[0_4px_12px_rgba(0,0,0,0.28)]\" data-kid=\"1-2-1-2-1-1-1-2\" data-name=\"edit photo button\">\n                                <i class=\"ti ti-camera text-[18px]\" data-kid=\"1-2-1-2-1-1-1-2-1\" data-name=\"camera icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"avatar instruction text group\">\n                            <h2 class=\"profile-mobile-heading text-[15px] font-bold text-[#F8FAFC]\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"photo title\">\n                                Foto de perfil\n                            </h2>\n                            <p class=\"mt-1 text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"photo description\">\n                                Añade una imagen para identificar tu espacio de trabajo.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-5\" data-kid=\"1-2-1-2-1-2\" data-name=\"full name field\">\n                        <label class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#94A3B8]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"name field label\">\n                            NOMBRE COMPLETO\n                        </label>\n                        <div class=\"mt-2 flex min-h-[52px] items-center gap-3 rounded-[12px] border border-[#334155] bg-[#1E293B] px-4\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"name input display\">\n                            <i class=\"ti ti-user text-[18px] text-[#64748B]\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"user icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span class=\"text-[14px] text-[#64748B]\" data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"name placeholder text\">\n                                Ej. Juan Pérez\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-6\" data-kid=\"1-2-1-2-1-3\" data-name=\"role selection\">\n                        <div class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#94A3B8]\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"role selection label\">\n                            SELECCIONA TU ROL\n                        </div>\n                        <div class=\"mt-3 grid grid-cols-2 gap-3\" data-kid=\"1-2-1-2-1-3-2\" data-name=\"role options grid\">\n                            <button aria-pressed=\"true\" class=\"flex min-h-[92px] flex-col items-start justify-between rounded-[14px] border-2 border-[#81E6D9] bg-[#1B3640] p-3 text-left shadow-[0_0_0_1px_rgba(129,230,217,0.08)]\" data-kid=\"1-2-1-2-1-3-2-1\" data-name=\"owner role option button\">\n                                <span class=\"flex size-8 items-center justify-center rounded-full bg-[#81E6D9] text-[#0F172A]\" data-kid=\"1-2-1-2-1-3-2-1-1\" data-name=\"check icon container\">\n                                    <i class=\"ti ti-check text-[17px]\" data-kid=\"1-2-1-2-1-3-2-1-1-1\" data-name=\"check icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[13px] font-bold text-[#F8FAFC]\" data-kid=\"1-2-1-2-1-3-2-1-2\" data-name=\"owner role label\">\n                                    Propietario\n                                </span>\n                            </button>\n                            <button aria-pressed=\"false\" class=\"flex min-h-[92px] flex-col items-start justify-between rounded-[14px] border border-[#334155] bg-[#1E293B] p-3 text-left text-[#CBD5E1]\" data-kid=\"1-2-1-2-1-3-2-2\" data-name=\"mechanic role option button\">\n                                <span class=\"flex size-8 items-center justify-center rounded-full bg-[#334155] text-[#94A3B8]\" data-kid=\"1-2-1-2-1-3-2-2-1\" data-name=\"tool icon container\">\n                                    <i class=\"ti ti-tool text-[17px]\" data-kid=\"1-2-1-2-1-3-2-2-1-1\" data-name=\"tool icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[13px] font-semibold\" data-kid=\"1-2-1-2-1-3-2-2-2\" data-name=\"mechanic role label\">\n                                    Mecánico\n                                </span>\n                            </button>\n                        </div>\n                        <div class=\"mt-3 flex items-start gap-3 rounded-[12px] border border-[#81E6D9]/25 bg-[#81E6D9]/[0.08] p-3\" data-kid=\"1-2-1-2-1-3-3\" data-name=\"selected owner role explanation\">\n                            <i class=\"ti ti-info-circle mt-0.5 shrink-0 text-[18px] text-[#81E6D9]\" data-kid=\"1-2-1-2-1-3-3-1\" data-name=\"info icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <p class=\"text-[12px] leading-5 text-[#CBD5E1]\" data-kid=\"1-2-1-2-1-3-3-2\" data-name=\"role explanation text\">\n                                Como propietario, podrás agregar vehículos a tu garaje virtual y dar seguimiento a sus mantenimientos.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-6\" data-kid=\"1-2-1-2-1-4\" data-name=\"maintenance notification preference\">\n                        <div class=\"mb-3 text-[10px] font-bold uppercase tracking-[0.18em] text-[#94A3B8]\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"preference label\">\n                            PREFERENCIAS\n                        </div>\n                        <div class=\"flex min-h-[76px] items-center gap-3 rounded-[14px] border border-[#334155] bg-[#1E293B] p-3\" data-kid=\"1-2-1-2-1-4-2\" data-name=\"toggle notification row\">\n                            <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#81E6D9]/[0.12] text-[#81E6D9]\" data-kid=\"1-2-1-2-1-4-2-1\" data-name=\"bell icon container\">\n                                <i class=\"ti ti-bell-ringing text-[19px]\" data-kid=\"1-2-1-2-1-4-2-1-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-1-4-2-2\" data-name=\"notification info group\">\n                                <div class=\"text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"1-2-1-2-1-4-2-2-1\" data-name=\"notification title text\">\n                                    Notificaciones de mantenimiento\n                                </div>\n                                <div class=\"mt-1 text-[11px] leading-4 text-[#94A3B8]\" data-kid=\"1-2-1-2-1-4-2-2-2\" data-name=\"notification description text\">\n                                    Alertas sobre cambios de aceite, frenos y revisiones.\n                                </div>\n                            </div>\n                            <div aria-label=\"Notificaciones de mantenimiento activadas\" class=\"relative flex h-8 w-14 shrink-0 items-center rounded-full bg-[#81E6D9] px-1\" data-kid=\"1-2-1-2-1-4-2-3\" data-name=\"notification toggle switch\">\n                                <span class=\"ml-auto size-6 rounded-full bg-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.22)]\" data-kid=\"1-2-1-2-1-4-2-3-1\" data-name=\"toggle handle\">\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n    <footer class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#0B1220]/95 px-4 pb-[calc(12px+env(safe-area-inset-bottom))] pt-3 backdrop-blur-sm\" data-kid=\"1-3\" data-name=\"profile setup submit footer\">\n        <button class=\"flex min-h-[52px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-5 text-[13px] font-bold text-[#0F172A] shadow-[0_6px_16px_rgba(129,230,217,0.16)]\" data-kid=\"1-3-1\" data-name=\"submit action button\">\n            Finalizar Configuración\n            <i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"1-3-1-1\" data-name=\"arrow right icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n        </button>\n    </footer>\n</div>\n",
