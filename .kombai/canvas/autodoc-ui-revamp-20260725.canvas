    "var_4f110a9133b0": {
      "type": "variant",
      "label": "AutoDoc Admin Logs — Hadrian Dark Mobile",
      "parentId": "var_eee20aaf8e29",
      "themeId": null,
      "rect": {
        "x": 112680,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .admin-logs-mobile-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .admin-logs-mobile-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .admin-logs-sheet { transform: translateY(110%); opacity: 0; pointer-events: none; }\n  .admin-logs-sheet.is-open { transform: translateY(0); opacity: 1; pointer-events: auto; }\n  .admin-logs-scrim { opacity: 0; pointer-events: none; }\n  .admin-logs-scrim.is-open { opacity: 1; pointer-events: auto; }\n  @media (prefers-reduced-motion: reduce) {\n    .admin-logs-sheet, .admin-logs-scrim { transition: none !important; }\n  }\n</style>\n<div class=\"admin-logs-mobile-body min-h-screen overflow-x-hidden bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"admin logs dark mobile page\" style=\"--surface:#0F172A;--surface-container:#141E36;--surface-variant:#1E293B;--outline:#334155;--outline-strong:#475569;--primary:#81E6D9;--secondary:#38BDF8;--on-primary:#0F172A;--text-primary:#F8FAFC;--text-secondary:#94A3B8;--success:#34D399;--warning:#FBBF24;--error:#F87171;--success-surface:#064E3B;--warning-surface:#422006;--error-surface:#3F1D25;--scrim:rgba(2,6,23,.72)\">\n    <header class=\"sticky top-0 z-30 flex min-h-[68px] items-center justify-between border-b border-[var(--outline)] bg-[#020617]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"compact admin header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"admin identity group\">\n            <div aria-label=\"AutoDoc administración\" class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[var(--primary)] text-[17px] font-extrabold tracking-[-0.08em] text-[var(--on-primary)] shadow-[0_8px_24px_rgba(129,230,217,.14)] admin-logs-mobile-heading\" data-kid=\"1-1-1-1\" data-name=\"admin initials avatar\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"admin identity info\">\n                <div class=\"truncate text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--text-secondary)]\" data-kid=\"1-1-1-2-1\" data-name=\"subheading administration label\">\n                    Administración\n                </div>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"1-1-1-2-2\" data-name=\"status indicator container\">\n                    <span class=\"admin-logs-mobile-heading truncate text-[15px] font-bold tracking-[-0.03em] text-[var(--text-primary)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"page title\">\n                        Registro de actividad\n                    </span>\n                    <span class=\"size-1.5 shrink-0 rounded-full bg-[var(--success)]\" data-kid=\"1-1-1-2-2-2\" data-name=\"status active indicator\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-1-2\" data-name=\"header action buttons\">\n            <button aria-label=\"Notificaciones\" class=\"relative flex size-11 items-center justify-center rounded-full border border-[var(--outline-strong)] bg-[var(--surface-container)] text-[var(--text-secondary)] shadow-[0_2px_4px_rgba(0,0,0,.2)] transition duration-150 ease-out hover:bg-[var(--surface-variant)] hover:text-[var(--primary)] active:scale-[.97]\" data-kid=\"1-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[18px]\" data-kid=\"1-1-2-1-1\" data-name=\"bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[var(--error)]\" data-kid=\"1-1-2-1-2\" data-name=\"unread notification indicator\">\n                </span>\n            </button>\n            <button aria-label=\"Abrir menú de Superadmin\" class=\"flex size-11 items-center justify-center rounded-full bg-[var(--secondary)] text-[12px] font-bold text-[#082F49]\" data-kid=\"1-1-2-2\" data-name=\"superadmin profile initials\">\n                SA\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[480px] px-4 pb-[calc(104px+env(safe-area-inset-bottom))] pt-5\" data-kid=\"1-2\" data-name=\"admin logs mobile content\">\n        <div class=\"mb-5\" data-kid=\"1-2-1\" data-name=\"logs page introduction\">\n            <div class=\"mb-3 flex items-center gap-2 text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation\">\n                <span data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb parent text\">\n                    Admin\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator chevron icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-semibold text-[var(--text-primary)]\" data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb current page text\">\n                    Logs\n                </span>\n            </div>\n            <h1 class=\"admin-logs-mobile-heading text-[27px] font-extrabold leading-tight tracking-[-0.045em] text-[var(--text-primary)]\" data-kid=\"1-2-1-2\" data-name=\"page main headline\">\n                Registro de actividad\n            </h1>\n            <p class=\"mt-2 max-w-[315px] text-[14px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-2-1-3\" data-name=\"page description paragraph\">\n                Historial de acciones administrativas y cambios sensibles de la plataforma.\n            </p>\n            <div class=\"mt-4 grid grid-cols-[1fr_48px_48px] gap-2\" data-kid=\"1-2-1-4\" data-name=\"logs toolbar actions\">\n                <button class=\"flex min-h-[48px] items-center justify-center gap-2 rounded-full border border-[var(--outline-strong)] bg-[var(--surface-container)] px-3 text-[12px] font-semibold text-[var(--text-primary)] shadow-[0_2px_4px_rgba(0,0,0,.2)] transition duration-150 ease-out hover:bg-[var(--surface-variant)] active:scale-[.97]\" data-kid=\"1-2-1-4-1\" data-name=\"refresh logs button\">\n                    <i class=\"ti ti-refresh text-[16px] text-[var(--secondary)]\" data-kid=\"1-2-1-4-1-1\" data-name=\"refresh icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Actualizar\n                </button>\n                <button aria-label=\"Exportar CSV\" class=\"flex min-h-[48px] min-w-[48px] items-center justify-center rounded-full border border-[var(--outline-strong)] bg-[var(--surface-container)] text-[var(--text-secondary)] shadow-[0_2px_4px_rgba(0,0,0,.2)] transition duration-150 ease-out hover:bg-[var(--surface-variant)] hover:text-[var(--primary)] active:scale-[.97]\" data-kid=\"1-2-1-4-2\" data-name=\"export csv button\">\n                    <i class=\"ti ti-download text-[18px]\" data-kid=\"1-2-1-4-2-1\" data-name=\"download icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Filtros\" class=\"flex min-h-[48px] min-w-[48px] items-center justify-center rounded-full bg-[var(--primary)] text-[var(--on-primary)] shadow-[0_4px_12px_rgba(129,230,217,.16)] transition duration-150 ease-out hover:brightness-105 active:scale-[.97]\" data-kid=\"1-2-1-4-3\" data-name=\"open filters bottom sheet button\" id=\"adminLogsFilterTrigger\">\n                    <i class=\"ti ti-adjustments-horizontal text-[18px]\" data-kid=\"1-2-1-4-3-1\" data-name=\"