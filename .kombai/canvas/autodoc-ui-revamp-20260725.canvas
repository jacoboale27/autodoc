      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component treatment\">\n    :root { --app-primary: #81E6D9; --app-surface-container: #141E36; --app-outline: #334155; --app-on-primary: #0F172A; --app-shadow-sm: 0 2px 4px rgba(0,0,0,0.20); --app-shadow-hover: 0 6px 14px rgba(0,0,0,0.35); }\n  button { min-height: 48px; border-radius: 999px !important; transition: transform 150ms cubic-bezier(0.23,1,0.32,1), box-shadow 150ms cubic-bezier(0.23,1,0.32,1), background-color 150ms cubic-bezier(0.23,1,0.32,1), border-color 150ms cubic-bezier(0.23,1,0.32,1), color 150ms cubic-bezier(0.23,1,0.32,1); }\n  button:active { transform: scale(0.97); }\n  button:focus-visible { outline: 3px solid rgba(129,230,217,0.35); outline-offset: 2px; }\n  button[class*=\"bg-[#1E88E5]\"], button[class*=\"bg-[#38BDF8]\"] { background: var(--app-primary) !important; color: var(--app-on-primary) !important; box-shadow: var(--app-shadow-sm); }\n  button[class*=\"border-[#1E88E5]\"], button[class*=\"border-[#38BDF8]\"] { border-color: var(--app-primary) !important; color: var(--app-primary) !important; }\n  button[class*=\"bg-\"]:hover, button[class*=\"border-\"]:hover { box-shadow: var(--app-shadow-hover); }\n  button[aria-label] { min-width: 48px; min-height: 48px; padding: 0.75rem; border: 1px solid var(--app-outline) !important; background: var(--app-surface-container) !important; box-shadow: var(--app-shadow-sm); }\n  main section { border: 1px solid rgba(51,65,85,0.70); border-radius: 16px; background: var(--app-surface-container); box-shadow: var(--app-shadow-sm); overflow: hidden; }\n</style>\n<div class=\"font-body min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"mechanic pending state page\">\n    <header class=\"flex h-[84px] items-center justify-between border-b border-[#334155] bg-[#020617] px-8\" data-kid=\"2-1\" data-name=\"pending page brand header\">\n        <div class=\"flex items-center gap-3\" data-kid=\"2-1-1\" data-name=\"AutoDoc brand group\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 place-items-center rounded-[10px] bg-[#38BDF8] text-[17px] font-heading font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo mark\">\n                AD\n            </div>\n            <div class=\"font-heading text-[18px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-1-2\" data-name=\"AutoDoc wordmark\">\n                Auto\n                <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-2-1\" data-name=\"AutoDoc wordmark highlight\">\n                    Doc\n                </span>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-5 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-2\" data-name=\"pending page utility group\">\n            <span class=\"hidden md:inline\" data-kid=\"2-1-2-1\" data-name=\"support hint\">\n                ¿Necesitas ayuda?\n            </span>\n            <button aria-label=\"Contactar soporte\" class=\"inline-flex min-h-10 items-center gap-2 border border-[#475569] px-3.5 font-semibold text-[#CBD5E1] hover:border-[#38BDF8] hover:text-[#F8FAFC]\" data-kid=\"2-1-2-2\" data-name=\"header support button\">\n                <span class=\"text-[16px]\" data-kid=\"2-1-2-2-1\" data-name=\"support icon container\">\n                    <i class=\"ti ti-headset\" data-kid=\"2-1-2-2-1-1\" data-name=\"support headset icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                Contactar soporte\n            </button>\n            <div class=\"hidden h-7 w-px bg-[#334155] md:block\" data-kid=\"2-1-2-3\" data-name=\"header divider\">\n            </div>\n            <div class=\"hidden items-center gap-2 sm:flex\" data-kid=\"2-1-2-4\" data-name=\"workshop account identity\">\n                <div class=\"grid size-8 place-items-center rounded-full bg-[#334155] text-[11px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-4-1\" data-name=\"workshop initials\">\n                    TR\n                </div>\n                <span class=\"font-semibold text-[#CBD5E1]\" data-kid=\"2-1-2-4-2\" data-name=\"workshop account name\">\n                    Taller Rápido\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1080px] px-8 py-12\" data-kid=\"2-2\" data-name=\"pending page main content\">\n        <div class=\"mb-8 flex items-center gap-3 text-[12px] text-[#64748B]\" data-kid=\"2-2-1\" data-name=\"pending breadcrumb\">\n            <span data-kid=\"2-2-1-1\" data-name=\"breadcrumb parent\">\n                Acceso de taller\n            </span>\n            <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-2-1-2\" data-name=\"breadcrumb separator\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"font-semibold text-[#CBD5E1]\" data-kid=\"2-2-1-3\" data-name=\"breadcrumb current\">\n                Estado de solicitud\n            </span>\n        </div>\n        <section aria-labelledby=\"pending-title\" class=\"grid overflow-hidden border border-[#334155] bg-[#1E293B] lg:grid-cols-[330px_minmax(0,1fr)]\" data-kid=\"2-2-2\" data-name=\"approval status panel\">\n            <aside class=\"flex flex-col justify-between border-b border-[#334155] bg-[#111827] p-8 lg:border-b-0 lg:border-r\" data-kid=\"2-2-2-1\" data-name=\"approval status summary rail\">\n                <div data-kid=\"2-2-2-1-1\" data-name=\"approval status icon region\">\n                    <div aria-label=\"Solicitud pendiente, representada por un reloj junto a un escudo\" class=\"mb-7 flex size-24 items-center justify-center border border-[#38BDF8]/60 bg-[#0B2535] text-[38px] text-[#38BDF8]\" data-kid=\"2-2-2-1-1-1\" data-name=\"pending clock shield icon\" role=\"img\">\n                        <span class=\"relative flex items-center justify-center\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"clock shield icon group\">\n                            <i class=\"ti ti-shield-check\" data-kid=\"2-2-2-1-1-1-1-1\" data-name=\"shield check icon\" style=\"width:38px;height:38px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span aria-hidden=\"true\" class=\"absolute -bottom-1 -right-2 grid size-7 place-items-center border border-[#1E293B] bg-[#FBBF24] text-[14px] text-[#451A03]\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"pending clock badge\">\n                                <i class=\"ti ti-clock\" data-kid=\"2-2-2-1-1-1-2-1\" data-name=\"clock icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                        </span>\n                    </div>\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.18em] text-[#FBBF24]\" data-kid=\"2-2-2-1-1-2\" data-name=\"current status eyebrow\">\n                        Solicitud enviada\n                    </p>\n                    <h2 class=\"mt-3 font-heading text-[23px] font-bold tracking-[-0.04em] text-[#F8FAFC]\" data-kid=\"2-2-2-1-1-3\" data-name=\"status summary heading\">\n                        Estamos revisando tus datos.\n                    </h2>\n                    <p class=\"mt-3 text-[13px] leading-6 text-[#94A3B8]\" data-kid=\"2-2-2-1-1-4\" data-name=\"status summary copy\">\n                        Tu taller ha sido registrado correctamente. Un administrador revisará la solicitud antes de habilitar el acceso operativo.\n                    </p>\n                </div>\n                <div class=\"mt-10 border-t border-[#334155] pt-5\" data-kid=\"2-2-2-1-2\" data-name=\"submitted timestamp group\">\n                    <div class=\"flex items-center justify-between gap-4 text-[12px]\" data-kid=\"2-2-2-1-2-1\" data-name=\"submitted date row\">\n                        <span class=\"text-[#64748B]\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"submitted date label\">\n                            Enviada\n                        </span>\n                        <span class=\"font-semibold tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-2-1-2-1-2\" data-name=\"submitted date value\">\n                            Hoy · 09:42\n                        </span>\n                    </div>\n                    <div class=\"mt-3 flex items-center justify-between gap-4 text-[12px]\" data-kid=\"2-2-2-1-2-2\" data-name=\"estimated review row\">\n                        <span class=\"text-[#64748B]\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"estimated review label\">\n                            Tiempo estimado\n                        </span>\n                        <span class=\"font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-1-2-2-2\" data-name=\"estimated review value\">\n                            1–2 días hábiles\n                        </span>\n                    </div>\n                </div>\n            </aside>\n            <div class=\"p-8 lg:p-10\" data-kid=\"2-2-2-2\" data-name=\"approval status details\">\n                <div class=\"flex items-start justify-between gap-6\" data-kid=\"2-2-2-2-1\" data-name=\"pending title row\">\n                    <div data-kid=\"2-2-2-2-1-1\" data-name=\"pending title group\">\n                        <p class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"workshop role label\">\n                            Registro de taller\n                        </p>\n                        <h1 class=\"mt-2 max-w-[560px] font-heading text-[32px] font-extrabold leading-tight tracking-[-0.05em] text-[#F8FAFC]\" data-kid=\"2-2-2-2-1-1-2\" data-name=\"pending page title\" id=\"pending-title\">\n                            Tu taller está pendiente de aprobación\n                        </h1>\n                    </div>\n                    <span class=\"hidden shrink-0 items-center gap-2 border border-[#FBBF24]/50 bg-[#3A2B0B] px-3 py-2 text-[11px] font-bold text-[#FCD34D] sm:inline-flex\" data-kid=\"2-2-2-2-1-2\" data-name=\"pending state badge\">\n                        <span class=\"size-2 rounded-full bg-[#FBBF24]\" data-kid=\"2-2-2-2-1-2-1\" data-name=\"pending state dot\">\n                        </span>\n                        Pendiente\n                    </span>\n                </div>\n                <p class=\"mt-4 max-w-[640px] text-[15px] leading-7 text-[#CBD5E1]\" data-kid=\"2-2-2-2-2\" data-name=\"pending page copy\">\n                    Recibirás una notificación cuando un administrador termine la revisión. Mientras tanto, puedes cerrar sesión; tu solicitud seguirá guardada y no tendrás que repetir el registro.\n                </p>\n                <div class=\"mt-9\" data-kid=\"2-2-2-2-3\" data-name=\"approval progress section\">\n                    <div class=\"mb-4 flex items-center justify-between gap-4\" data-kid=\"2-2-2-2-3-1\" data-name=\"approval progress header\">\n                        <h2 class=\"font-heading text-[15px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-2-2-3-1-1\" data-name=\"approval progress title\">\n                            Estado de la solicitud\n                        </h2>\n                        <span class=\"text-[12px] text-[#94A3B8]\" data-kid=\"2-2-2-2-3-1-2\" data-name=\"approval progress date\">\n                            Enviada hoy\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-[1fr_1fr_1fr] gap-3\" data-kid=\"2-2-2-2-3-2\" data-name=\"approval progress steps\">\n                        <div class=\"relative border-t-2 border-[#38BDF8] pt-4\" data-kid=\"2-2-2-2-3-2-1\" data-name=\"submitted step\">\n                            <div class=\"mb-2 flex items-center gap-2\" data-kid=\"2-2-2-2-3-2-1-1\" data-name=\"submitted step marker\">\n                                <span class=\"grid size-7 place-items-center bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-2-2-2-3-2-1-1-1\" data-name=\"submitted step count\">\n                                    1\n                                </span>\n                                <i class=\"ti ti-check text-[15px] text-[#34D399]\" data-kid=\"2-2-2-2-3-2-1-1-2\" data-name=\"submitted check icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <p class=\"text-[13px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-2-2-3-2-1-2\" data-name=\"submitted step label\">\n                                Enviada\n                            </p>\n                            <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-2-3-2-1-3\" data-name=\"submitted step detail\">\n                                Solicitud recibida\n                            </p>\n                        </div>\n                        <div class=\"relative border-t-2 border-[#FBBF24] pt-4\" data-kid=\"2-2-2-2-3-2-2\" data-name=\"review step\">\n                            <div class=\"mb-2 flex items-center gap-2\" data-kid=\"2-2-2-2-3-2-2-1\" data-name=\"review step marker\">\n                                <span class=\"grid size-7 place-items-center border border-[#FBBF24] bg-[#3A2B0B] text-[12px] font-bold text-[#FCD34D]\" data-kid=\"2-2-2-2-3-2-2-1-1\" data-name=\"review step count\">\n                                    2\n                                </span>\n                                <span class=\"text-[11px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-2-2-3-2-2-1-2\" data-name=\"review step status\">\n                                    En curso\n                                </span>\n                            </div>\n                            <p class=\"text-[13px] font-bold text-[#F8FAFC]\" data-kid=\"2-2-2-2-3-2-2-2\" data-name=\"review step label\">\n                                En revisión\n                            </p>\n                            <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-2-3-2-2-3\" data-name=\"review step detail\">\n                                Validación administrativa\n                            </p>\n                        </div>\n                        <div class=\"relative border-t-2 border-[#475569] pt-4\" data-kid=\"2-2-2-2-3-2-3\" data-name=\"approved step\">\n                            <div class=\"mb-2 flex items-center gap-2\" data-kid=\"2-2-2-2-3-2-3-1\" data-name=\"approved step marker\">\n                                <span class=\"grid size-7 place-items-center border border-[#475569] text-[12px] font-bold text-[#94A3B8]\" data-kid=\"2-2-2-2-3-2-3-1-1\" data-name=\"approved step count\">\n                                    3\n                                </span>\n                                <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-3-2-3-1-2\" data-name=\"approved step status\">\n                                    Pendiente\n                                </span>\n                            </div>\n                            <p class=\"text-[13px] font-bold text-[#CBD5E1]\" data-kid=\"2-2-2-2-3-2-3-2\" data-name=\"approved step label\">\n                                Aprobada\n                            </p>\n                            <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-3-2-3-3\" data-name=\"approved step detail\">\n                                Acceso al panel del taller\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-9 border-y border-[#334155] py-5\" data-kid=\"2-2-2-2-4\" data-name=\"pending information list\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"2-2-2-2-4-1\" data-name=\"email notification information\">\n                        <span class=\"mt-0.5 text-[18px] text-[#38BDF8]\" data-kid=\"2-2-2-2-4-1-1\" data-name=\"email icon container\">\n                            <i class=\"ti ti-mail\" data-kid=\"2-2-2-2-4-1-1-1\" data-name=\"email icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <p class=\"text-[13px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-2-2-4-1-2\" data-name=\"email notification text\">\n                            Te avisaremos por correo cuando la revisión avance.\n                        </p>\n                    </div>\n                    <div class=\"mt-4 flex items-start gap-3\" data-kid=\"2-2-2-2-4-2\" data-name=\"push notification information\">\n                        <span class=\"mt-0.5 text-[18px] text-[#38BDF8]\" data-kid=\"2-2-2-2-4-2-1\" data-name=\"notification icon container\">\n                            <i class=\"ti ti-bell\" data-kid=\"2-2-2-2-4-2-1-1\" data-name=\"notification icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <p class=\"text-[13px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-2-2-4-2-2\" data-name=\"push notification text\">\n                            Recibirás una notificación push cuando tu cuenta sea aprobada.\n                        </p>\n                    </div>\n                    <div class=\"mt-4 flex items-start gap-3\" data-kid=\"2-2-2-2-4-3\" data-name=\"time estimate information\">\n                        <span class=\"mt-0.5 text-[18px] text-[#FBBF24]\" data-kid=\"2-2-2-2-4-3-1\" data-name=\"calendar icon container\">\n                            <i class=\"ti ti-calendar-time\" data-kid=\"2-2-2-2-4-3-1-1\" data-name=\"calendar time icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <p class=\"text-[13px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-2-2-4-3-2\" data-name=\"time estimate text\">\n                            Tiempo estimado de aprobación:\n                            <strong class=\"font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-4-3-2-1\" data-name=\"time estimate value\">\n                                1–2 días hábiles\n                            </strong>\n                            .\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-8 flex flex-wrap items-center justify-between gap-4\" data-kid=\"2-2-2-2-5\" data-name=\"pending actions row\">\n                    <button class=\"inline-flex min-h-12 items-center gap-2 bg-[#38BDF8] px-5 text-[13px] font-bold text-[#082F49] hover:bg-[#7DD3FC]\" data-kid=\"2-2-2-2-5-1\" data-name=\"check approval button\">\n                        <i class=\"ti ti-refresh text-[16px]\" data-kid=\"2-2-2-2-5-1-1\" data-name=\"refresh icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Verificar estado\n                    </button>\n                    <div class=\"flex items-center gap-4\" data-kid=\"2-2-2-2-5-2\" data-name=\"secondary pending actions\">\n                        <button class=\"min-h-12 px-2 text-[13px] font-semibold text-[#94A3B8] hover:text-[#F8FAFC]\" data-kid=\"2-2-2-2-5-2-1\" data-name=\"logout button\">\n                            Cerrar sesión\n                        </button>\n                        <button class=\"inline-flex min-h-12 items-center gap-2 border border-[#475569] px-4 text-[13px] font-semibold text-[#CBD5E1] hover:border-[#38BDF8] hover:text-[#F8FAFC]\" data-kid=\"2-2-2-2-5-2-2\" data-name=\"support action button\">\n                            <i class=\"ti ti-headset text-[16px]\" data-kid=\"2-2-2-2-5-2-2-1\" data-name=\"support action icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Contactar soporte\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <footer class=\"mt-7 flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-3\" data-name=\"pending page footer\">\n            <span data-kid=\"2-3-1\" data-name=\"pending footer brand\">\n                AutoDoc · Gestión operativa para talleres\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-3-2\" data-name=\"pending support footer\">\n                <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-3-2-1\" data-name=\"status online indicator\">\n                </span>\n                Tu solicitud está guardada de forma segura\n            </span>\n        </footer>\n    </main>\n</div>\n",
