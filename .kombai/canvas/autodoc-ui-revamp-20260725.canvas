        "x": 83000,
        "y": 0,
        "w": 375,
        "h": 1528
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"employees mobile page root\">\n    <header class=\"sticky top-0 z-20 flex min-h-[68px] items-center justify-between border-b border-[#CBD5E1] bg-white/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-4\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2\">\n                    Taller\n                </p>\n                <div class=\"mt-0.5 flex min-w-0 items-center gap-2\" data-kid=\"2-1-1-3\">\n                    <span class=\"size-2 shrink-0 rounded-full bg-[#10B981]\" data-kid=\"2-1-1-3-1\" data-name=\"active workshop dot\">\n                    </span>\n                    <span class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-1-3-2\">\n                        Taller Rápido\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header controls\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-[9px] top-[8px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\" data-name=\"notifications dot\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-2\" data-name=\"theme toggle button\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-2-2-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"px-4 pb-32 pt-6\" data-kid=\"2-2\" data-name=\"employees mobile content\">\n        <div class=\"mb-5 flex items-end justify-between gap-3\" data-kid=\"2-2-1\" data-name=\"mobile breadcrumb row\">\n            <div class=\"flex items-center gap-2 text-[12px]\" data-kid=\"2-2-1-1\" data-name=\"breadcrumb group\">\n                <span class=\"text-[#64748B]\" data-kid=\"2-2-1-1-1\">\n                    Taller\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-1-2\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-1-3\">\n                    Empleados\n                </span>\n            </div>\n            <span class=\"shrink-0 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-2\">\n                Operación activa\n            </span>\n        </div>\n        <section class=\"mb-6\" data-kid=\"2-2-2\" data-name=\"page heading section\">\n            <h1 class=\"font-heading text-[28px] font-extrabold leading-tight tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-2-1\">\n                Equipo del taller\n            </h1>\n            <p class=\"mt-2 max-w-[310px] text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-2-2\">\n                Administra quién puede trabajar en las reparaciones.\n            </p>\n            <button class=\"mt-5 inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#46256F] px-4 py-3 text-[13px] font-semibold text-white shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.10)] active:scale-[0.97]\" data-kid=\"2-2-2-3\" data-name=\"invite employee button\">\n                <i class=\"ti ti-user-plus text-[16px]\" data-kid=\"2-2-2-3-1\" data-name=\"user plus icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Invitar empleado\n            </button>\n        </section>\n        <section class=\"mb-7 border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-3\" data-name=\"employees toolbar\">\n            <label class=\"flex min-h-[52px] items-center gap-3 border-b border-[#E2E8F0] px-4 text-[13px] text-[#64748B]\" data-kid=\"2-2-3-1\" data-name=\"employee search field\">\n                <i class=\"ti ti-search text-[18px] text-[#94A3B8]\" data-kid=\"2-2-3-1-1\" data-name=\"search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"sr-only\" data-kid=\"2-2-3-1-2\">\n                    Buscar empleado\n                </span>\n                <span data-kid=\"2-2-3-1-3\">\n                    Buscar empleado\n                </span>\n            </label>\n            <div class=\"flex min-h-[58px] items-center justify-between gap-3 px-4\" data-kid=\"2-2-3-2\" data-name=\"employee toolbar metadata\">\n                <span class=\"text-[12px] font-medium text-[#64748B]\" data-kid=\"2-2-3-2-1\">\n                    3 miembros\n                </span>\n                <button class=\"inline-flex min-h-[44px] items-center gap-2 border border-[#CBD5E1] bg-white px-3 text-[12px] font-semibold text-[#334155]\" data-kid=\"2-2-3-2-2\" data-name=\"role filter button\">\n                    <i class=\"ti ti-adjustments-horizontal text-[15px] text-[#1E88E5]\" data-kid=\"2-2-3-2-2-1\" data-name=\"adjustments icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Todos los roles\n                    <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-2-3-2-2-2\" data-name=\"chevron down icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <div class=\"mb-4\" data-kid=\"2-2-4\" data-name=\"employees list introduction\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-4\">\n                <div data-kid=\"2-2-4-4-1\">\n                    <h2 class=\"font-heading text-[19px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-2-4-1\">\n                        Personas con acceso\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-4-2\">\n                        Solo el propietario y la administración pueden gestionar permisos.\n                    </p>\n                </div>\n                <span class=\"mt-1 flex shrink-0 items-center gap-1.5 text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-2-4-3\" data-name=\"operation active status\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-2-4-3-1\">\n                    </span>\n                    Activa\n                </span>\n            </div>\n        </div>\n        <section class=\"space-y-3\" data-kid=\"2-2-5\" data-name=\"employees card list\">\n            <article class=\"border border-[#CBD5E1] bg-white p-4\" data-kid=\"2-2-5-1\" data-name=\"active administrator employee card\">\n                <div class=\"flex items-start gap-3\" data-kid=\"2-2-5-1-2\">\n                    <div class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-5-1-1\" data-name=\"manager avatar\">\n                        MR\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-5-1-2-3\">\n                        <p class=\"truncate text-[14px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-1-2-1\">\n                            María Rodríguez\n                        </p>\n                        <p class=\"mt-0.5 break-all text-[11px] leading-4 text-[#64748B]\" data-kid=\"2-2-5-1-2-2\">\n                            maria.rodriguez@tallerrapido.co\n                        </p>\n                    </div>\n                    <button aria-label=\"Más acciones para María Rodríguez\" class=\"grid size-11 shrink-0 place-items-center rounded-lg text-[18px] text-[#64748B]\" data-kid=\"2-2-5-1-3\" data-name=\"actions button\">\n                        <i class=\"ti ti-dots-vertical\" data-kid=\"2-2-5-1-3-1\" data-name=\"vertical dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"mt-4 grid grid-cols-2 gap-4 border-t border-[#E2E8F0] pt-3 text-[12px]\" data-kid=\"2-2-5-1-4\">\n                    <div data-kid=\"2-2-5-1-4-2\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#94A3B8]\" data-kid=\"2-2-5-1-4-2-1\">\n                            Rol\n                        </p>\n                        <p class=\"mt-1 font-medium text-[#334155]\" data-kid=\"2-2-5-1-4-2-2\">\n                            Administradora\n                        </p>\n                    </div>\n                    <div data-kid=\"2-2-5-1-4-3\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#94A3B8]\" data-kid=\"2-2-5-1-4-3-1\">\n                            Estado\n                        </p>\n                        <p class=\"mt-1 flex items-center gap-1.5 font-semibold text-[#10B981]\" data-kid=\"2-2-5-1-4-3-2\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"2-2-5-1-4-1\" data-name=\"check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Activa\n                        </p>\n                    </div>\n                    <div class=\"col-span-2\" data-kid=\"2-2-5-1-4-4\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#94A3B8]\" data-kid=\"2-2-5-1-4-4-1\">\n                            Último acceso\n                        </p>\n                        <p class=\"mt-1 text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-5-1-4-4-2\" data-name=\"last access time display\" data-reason=\"time string updated periodically from backend data\">\n                            Hoy, 08:32\n                        </p>\n                    </div>\n                </div>\n            </article>\n            <article class=\"border border-[#CBD5E1] bg-white p-4\" data-kid=\"2-2-5-2\" data-name=\"active mechanic employee card\">\n                <div class=\"flex items-start gap-3\" data-kid=\"2-2-5-2-2\">\n                    <div class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#E0F2FE] text-[12px] font-bold text-[#0284C7]\" data-kid=\"2-2-5-2-1\" data-name=\"mechanic avatar\">\n                        CM\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-5-2-2-3\">\n                        <p class=\"truncate text-[14px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-2-1\">\n                            Carlos Méndez\n                        </p>\n                        <p class=\"mt-0.5 break-all text-[11px] leading-4 text-[#64748B]\" data-kid=\"2-2-5-2-2-2\">\n                            carlos.mendez@tallerrapido.co\n                        </p>\n                    </div>\n                    <button aria-label=\"Más acciones para Carlos Méndez\" class=\"grid size-11 shrink-0 place-items-center rounded-lg text-[18px] text-[#64748B]\" data-kid=\"2-2-5-2-3\" data-name=\"actions button\">\n                        <i class=\"ti ti-dots-vertical\" data-kid=\"2-2-5-2-3-1\" data-name=\"vertical dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"mt-4 grid grid-cols-2 gap-4 border-t border-[#E2E8F0] pt-3 text-[12px]\" data-kid=\"2-2-5-2-4\">\n                    <div data-kid=\"2-2-5-2-4-2\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#94A3B8]\" data-kid=\"2-2-5-2-4-2-1\">\n                            Rol\n                        </p>\n                        <p class=\"mt-1 font-medium text-[#334155]\" data-kid=\"2-2-5-2-4-2-2\">\n                            Mecánico\n                        </p>\n                    </div>\n                    <div data-kid=\"2-2-5-2-4-3\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#94A3B8]\" data-kid=\"2-2-5-2-4-3-1\">\n                            Estado\n                        </p>\n                        <p class=\"mt-1 flex items-center gap-1.5 font-semibold text-[#10B981]\" data-kid=\"2-2-5-2-4-3-2\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"2-2-5-2-4-1\" data-name=\"check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Activo\n                        </p>\n                    </div>\n                    <div class=\"col-span-2\" data-kid=\"2-2-5-2-4-4\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#94A3B8]\" data-kid=\"2-2-5-2-4-4-1\">\n                            Último acceso\n                        </p>\n                        <p class=\"mt-1 text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-5-2-4-4-2\" data-name=\"last access time display\" data-reason=\"time string updated periodically from backend data\">\n                            Hoy, 07:54\n                        </p>\n                    </div>\n                </div>\n            </article>\n            <article class=\"border border-[#FCD34D] bg-[#FFFBEB] p-4\" data-kid=\"2-2-5-3\" data-name=\"pending invitation employee card\">\n                <div class=\"flex items-start gap-3\" data-kid=\"2-2-5-3-2\">\n                    <div class=\"grid size-10 shrink-0 place-items-center rounded-full border border-dashed border-[#F59E0B] text-[12px] font-bold text-[#B45309]\" data-kid=\"2-2-5-3-1\" data-name=\"pending avatar\">\n                        CL\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"2-2-5-3-2-3\">\n                        <p class=\"truncate text-[14px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-3-2-1\">\n                            Carlos López\n                        </p>\n                        <p class=\"mt-0.5 break-words text-[11px] leading-4 text-[#92400E]\" data-kid=\"2-2-5-3-2-2\">\n                            Invitación enviada ayer · carlos.lopez@tallerrapido.co\n                        </p>\n                    </div>\n                    <button aria-label=\"Más acciones para Carlos López\" class=\"grid size-11 shrink-0 place-items-center rounded-lg text-[18px] text-[#92400E]\" data-kid=\"2-2-5-3-3\" data-name=\"actions button\">\n                        <i class=\"ti ti-dots-vertical\" data-kid=\"2-2-5-3-3-1\" data-name=\"vertical dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"mt-4 grid grid-cols-2 gap-4 border-t border-[#FDE68A] pt-3 text-[12px]\" data-kid=\"2-2-5-3-4\">\n                    <div data-kid=\"2-2-5-3-4-2\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#B45309]\" data-kid=\"2-2-5-3-4-2-1\">\n                            Rol\n                        </p>\n                        <p class=\"mt-1 font-medium text-[#334155]\" data-kid=\"2-2-5-3-4-2-2\">\n                            Técnico\n                        </p>\n                    </div>\n                    <div data-kid=\"2-2-5-3-4-3\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#B45309]\" data-kid=\"2-2-5-3-4-3-1\">\n                            Estado\n                        </p>\n                        <p class=\"mt-1 flex items-center gap-1.5 font-semibold text-[#B45309]\" data-kid=\"2-2-5-3-4-3-2\">\n                            <i class=\"ti ti-clock\" data-kid=\"2-2-5-3-4-1\" data-name=\"clock icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Pendiente\n                        </p>\n                    </div>\n                    <div class=\"col-span-2\" data-kid=\"2-2-5-3-4-4\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#B45309]\" data-kid=\"2-2-5-3-4-4-1\">\n                            Último acceso\n                        </p>\n                        <p class=\"mt-1 text-[#92400E]\" data-kid=\"2-2-5-3-4-4-2\">\n                            Sin acceso\n                        </p>\n                    </div>\n                </div>\n            </article>\n        </section>\n        <div class=\"mt-4 flex items-start justify-between gap-3 border-t border-[#E2E8F0] pt-4 text-[11px] text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"employees list footer\">\n            <span data-kid=\"2-2-6-1\">\n                Mostrando 3 de 3 empleados\n            </span>\n            <span class=\"text-right text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-2-6-2\" data-name=\"last update time display\" data-reason=\"time string updated by periodic sync script\">\n                Última actualización hace 4 min\n            </span>\n        </div>\n        <p class=\"mt-5 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-7\">\n            ¿No encuentras a una persona? Ajusta el filtro o envía una nueva invitación.\n        </p>\n        <div class=\"mt-4 flex items-center justify-end gap-1\" data-kid=\"2-2-8\" data-name=\"employees pagination\">\n            <button aria-label=\"Página anterior\" class=\"grid size-11 place-items-center border border-[#CBD5E1] bg-white text-[15px] text-[#94A3B8]\" data-kid=\"2-2-8-1\" data-name=\"previous page button\">\n                <i class=\"ti ti-chevron-left\" data-kid=\"2-2-8-1-1\" data-name=\"left chevron icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Página 1\" class=\"grid size-11 place-items-center bg-[#1E88E5] text-[12px] font-bold text-white\" data-kid=\"2-2-8-2\" data-name=\"page 1 button\">\n                1\n            </button>\n            <button aria-label=\"Página siguiente\" class=\"grid size-11 place-items-center border border-[#CBD5E1] bg-white text-[15px] text-[#64748B]\" data-kid=\"2-2-8-3\" data-name=\"next page button\">\n                <i class=\"ti ti-chevron-right\" data-kid=\"2-2-8-3-1\" data-name=\"right chevron icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n        <p class=\"mt-8 pb-2 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-9\" data-name=\"footer copy\">\n            AutoDoc · Gestión operativa del taller · Datos sincronizados con tu equipo\n        </p>\n    </main>\n    <nav aria-label=\"Navegación del taller\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pb-[max(10px,env(safe-area-inset-bottom))] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-5 gap-1\" data-kid=\"2-3-6\">\n            <a aria-label=\"Panel\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-1\" data-name=\"dashboard navigation item\" href=\"#panel\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-3-1-1\" data-name=\"dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2\">\n                    Panel\n                </span>\n            </a>\n            <a aria-label=\"Reparaciones\" class=\"relative flex min-h-[52px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-2\" data-name=\"repairs navigation item\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-2-1\" data-name=\"tools icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-2-2\">\n                    Reparaciones\n                </span>\n                <span class=\"absolute right-3 top-1 size-2 rounded-full bg-[#1E88E5]\" data-kid=\"2-3-2-3\">\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Empleados\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 rounded-lg bg-[#E8F2FD] text-[#1E88E5]\" data-kid=\"2-3-3\" data-name=\"active employees navigation item\" href=\"#empleados\">\n                <i class=\"ti ti-users text-[19px]\" data-kid=\"2-3-3-1\" data-name=\"users icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-3-2\">\n                    Empleados\n                </span>\n            </a>\n            <a aria-label=\"Buscar vehículo\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-4\" data-name=\"vehicle search navigation item\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[19px]\" data-kid=\"2-3-4-1\" data-name=\"search icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-4-2\">\n                    Buscar\n                </span>\n            </a>\n            <a aria-label=\"Conversaciones\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-5\" data-name=\"chat navigation item\" href=\"#conversaciones\">\n                <i class=\"ti ti-message-circle text-[19px]\" data-kid=\"2-3-5-1\" data-name=\"message icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-5-2\">\n                    Chat\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
