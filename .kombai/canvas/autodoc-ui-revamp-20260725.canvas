ustify-content:center\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-2-3-1-2\" data-name=\"Workshop name text\">\n                                    MotorLab\n                                </span>\n                            </div>\n                            <div class=\"text-[12px] tabular-nums text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-2-3-2\" data-name=\"Workshop distance value\">\n                                3.4 km\n                            </div>\n                            <div class=\"flex items-center gap-1 text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-4-2-3-3\" data-name=\"Workshop rating value\">\n                                <i class=\"ti ti-star-filled text-[13px]\" data-kid=\"2-1-3-2-4-2-3-3-1\" data-name=\"Star icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                4.8\n                            </div>\n                            <div class=\"text-right\" data-kid=\"2-1-3-2-4-2-3-4\" data-name=\"Contact workshop action button\">\n                                <button class=\"text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-3-4-1\">\n                                    Contactar\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-[1.5fr_0.7fr_0.7fr_1fr] items-center px-4 py-4\" data-kid=\"2-1-3-2-4-2-4\" data-name=\"Third workshop row\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-4-2-4-1\" data-name=\"Workshop name\">\n                                <span class=\"flex h-8 w-8 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-4-1-1\" data-name=\"Workshop icon wrapper\">\n                                    <i class=\"ti ti-tool text-[16px]\" data-kid=\"2-1-3-2-4-2-4-1-1-1\" data-name=\"Workshop icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-2-4-1-2\" data-name=\"Workshop name text\">\n                                    Centro Auto\n                                </span>\n                            </div>\n                            <div class=\"text-[12px] tabular-nums text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-2-4-2\" data-name=\"Workshop distance value\">\n                                5.1 km\n                            </div>\n                            <div class=\"flex items-center gap-1 text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-4-2-4-3\" data-name=\"Workshop rating value\">\n                                <i class=\"ti ti-star-filled text-[13px]\" data-kid=\"2-1-3-2-4-2-4-3-1\" data-name=\"Star icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                4.6\n                            </div>\n                            <div class=\"text-right\" data-kid=\"2-1-3-2-4-2-4-4\" data-name=\"Contact workshop action button\">\n                                <button class=\"text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-4-4-1\">\n                                    Contactar\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <footer class=\"mt-9 flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-5\" data-name=\"Dashboard footer\">\n                    <span data-kid=\"2-1-3-2-5-1\" data-name=\"Footer branding text\">\n                        AutoDoc · Diagnóstico y mantenimiento para tu vehículo\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-1-3-2-5-2\" data-name=\"sync status section\" data-reason=\"text updated periodically by synchronization script\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-5-2-1\" data-name=\"Sync status indicator dot\">\n                        </span>\n                        Datos sincronizados hace 4 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
