      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    :root { --app-primary:#81E6D9; --app-on-primary:#0F172A; --app-surface-container:#141E36; --app-outline:#334155; --app-shadow-sm:0 2px 4px rgba(0,0,0,.2); --app-shadow-hover:0 6px 14px rgba(0,0,0,.35); }\n  button { min-height:48px; border-radius:999px; transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  button[aria-label] { min-width:44px; min-height:44px; background:var(--app-surface-container); border:1px solid rgba(51,65,85,.35); border-radius:999px; box-shadow:var(--app-shadow-sm); }\n  button:not([aria-label])[class*=\"bg-[#38BDF8]\"] { min-height:48px; border-radius:999px; background:linear-gradient(135deg,#81E6D9,#6FC8BC); color:#0F172A; box-shadow:var(--app-shadow-sm); }\n  button:not([aria-label])[class*=\"bg-[#38BDF8]\"]:hover, button:not([aria-label])[class*=\"bg-[#38BDF8]\"]:focus-visible { transform:scale(1.02); box-shadow:var(--app-shadow-hover); }\n  button:not([aria-label])[class*=\"border\"] { background:var(--app-surface-container); border-color:rgba(51,65,85,.5); box-shadow:var(--app-shadow-sm); }\n  button:active { transform:scale(.97); }\n  button[aria-label][class*=\"bg-[#1E293B]\"] { background:#1E293B; border-color:#38BDF8; color:#38BDF8; }\n  [data-name=\"Filter controls bar\"], [data-name=\"Column items list\"] { border-radius:16px; border:1px solid rgba(51,65,85,.35); background:var(--app-surface-container); box-shadow:var(--app-shadow-sm); overflow:hidden; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#0F172A] text-[#F8FAFC]\" data-kid=\"2\" data-name=\"Application wrapper container\" style=\"font-family:'IBM Plex Sans',sans-serif\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"Main dashboard layout container\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"Primary navigation sidebar\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\" data-name=\"Sidebar top menu\">\n                <div class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[18px] font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-1-1-1\" data-name=\"Logo placeholder\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    AD\n                </div>\n                <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-1-2\" data-name=\"Main navigation menu\">\n                    <button aria-label=\"Panel del taller\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-transparent\" data-kid=\"2-1-1-1-2-1\" data-name=\"Dashboard navigation button\">\n                        <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"Dashboard icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Reparaciones\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-2\" data-name=\"Repairs navigation button\">\n                        <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"Repairs icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Buscar vehículo\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-1-2-3\" data-name=\"Search navigation button\">\n                        <i class=\"ti ti-search text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" data-name=\"Search icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Conversaciones\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-1-2-4\" data-name=\"Messages navigation button\">\n                        <i class=\"ti ti-message-circle text-[19px]\" data-kid=\"2-1-1-1-2-4-1\" data-name=\"Messages icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\" data-name=\"Sidebar bottom menu\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-1\" data-name=\"Settings navigation button\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"Settings icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-2\" data-name=\"Help navigation button\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"Help icon\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\" data-name=\"Secondary navigation sidebar\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\" data-name=\"Workspace header\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\" data-name=\"Workspace label\">\n                    Taller\n                </div>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"Workspace name container\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-2-1-2-1\" data-name=\"Workspace name text\">\n                        Taller\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"Workspace name colored text\">\n                            Rápido\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-2-1-2-2\" data-name=\"Workspace status dot\">\n                    </span>\n                </div>\n            </div>\n            <nav class=\"flex-1 px-4 py-6\" data-kid=\"2-1-2-2\" data-name=\"Secondary navigation links\">\n                <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-1\" data-name=\"Operation group header\">\n                    Operación\n                </div>\n                <div class=\"space-y-1\" data-kid=\"2-1-2-2-2\" data-name=\"Operation links\">\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-1\" data-name=\"Dashboard link\" href=\"#panel\">\n                        <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"Dashboard link icon\">\n                        </i>\n                        Panel\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-3 py-3 text-[13px] font-semibold text-white\" data-kid=\"2-1-2-2-2-2\" data-name=\"Repairs link\" href=\"#reparaciones\">\n                        <i class=\"ti ti-tool text-[17px] text-[#38BDF8]\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"Repairs link icon\">\n                        </i>\n                        Reparaciones\n                        <span class=\"ml-auto rounded-[4px] bg-[#075985] px-1.5 py-0.5 text-[10px] font-bold text-[#BAE6FD]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"Repairs counter badge\" data-reason=\"number text fetched or generated by system\">\n                            09\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-3\" data-name=\"Search link\" href=\"#buscar\">\n                        <i class=\"ti ti-search text-[17px]\" data-kid=\"2-1-2-2-2-3-1\" data-name=\"Search link icon\">\n                        </i>\n                        Buscar vehículo\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-4\" data-name=\"History link\" href=\"#historial\">\n                        <i class=\"ti ti-history text-[17px]\" data-kid=\"2-1-2-2-2-4-1\" data-name=\"History link icon\">\n                        </i>\n                        Historial\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-5\" data-name=\"Reviews link\" href=\"#resenas\">\n                        <i class=\"ti ti-star text-[17px]\" data-kid=\"2-1-2-2-2-5-1\" data-name=\"Reviews link icon\">\n                        </i>\n                        Reseñas\n                    </a>\n                </div>\n                <div class=\"mt-10 border-t border-[#334155] pt-7\" data-kid=\"2-1-2-2-3\" data-name=\"Quick access group\">\n                    <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-3-1\" data-name=\"Quick access header\">\n                        Acceso rápido\n                    </div>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-2\" data-name=\"Catalog link\" href=\"#catalogo\">\n                        <i class=\"ti ti-list-details text-[17px] text-[#818CF8]\" data-kid=\"2-1-2-2-3-2-1\" data-name=\"Catalog link icon\">\n                        </i>\n                        Catálogo\n                    </a>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-3\" data-name=\"Employees link\" href=\"#empleados\">\n                        <i class=\"ti ti-users text-[17px]\" data-kid=\"2-1-2-2-3-3-1\" data-name=\"Employees link icon\">\n                        </i>\n                        Empleados\n                    </a>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-4\" data-name=\"Configuration link\" href=\"#configuracion\">\n                        <i class=\"ti ti-settings text-[17px]\" data-kid=\"2-1-2-2-3-4-1\" data-name=\"Configuration link icon\">\n                        </i>\n                        Configuración\n                    </a>\n                </div>\n            </nav>\n            <div class=\"border-t border-[#334155] px-5 py-5\" data-kid=\"2-1-2-3\" data-name=\"User profile container\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\" data-name=\"User profile info\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-3-1-1\" data-name=\"User profile initials badge\">\n                        TR\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\" data-name=\"User details container\">\n                        <div class=\"truncate text-[12px] font-semibold text-white\" data-kid=\"2-1-2-3-1-2-1\" data-name=\"User business name\">\n                            Taller Rápido\n                        </div>\n                        <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\" data-name=\"User plan name\">\n                            Plan profesional\n                        </div>\n                    </div>\n                    <i class=\"ti ti-dots ml-auto text-[16px] text-[#64748B]\" data-kid=\"2-1-2-3-1-3\" data-name=\"Profile menu dots\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[#0F172A]\" data-kid=\"2-1-3\" data-name=\"Main content area\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#334155] px-8\" data-kid=\"2-1-3-1\" data-name=\"Main header\">\n                <div class=\"flex items-center gap-3 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-1-1\" data-name=\"Breadcrumb container\">\n                    <span data-kid=\"2-1-3-1-1-1\" data-name=\"Parent breadcrumb page name\">\n                        Taller\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-1-3-1-1-2\" data-name=\"Breadcrumb chevron\">\n                    </i>\n                    <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-1-1-3\" data-name=\"Current breadcrumb page name\">\n                        Reparaciones\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-6\" data-kid=\"2-1-3-1-2\" data-name=\"Header right controls\">\n                    <div class=\"text-right\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1\" data-name=\"Date and time container\" data-reason=\"text updated by live system clock\">\n                        <div class=\"text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-1\" data-name=\"Date text\" data-reason=\"text updated by system date\">\n                            Sábado, 15 ago 2026\n                        </div>\n                        <div class=\"mt-0.5 text-[12px] font-semibold text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-2\" data-name=\"Time text\" data-reason=\"text updated by system clock\">\n                            09:14 a. m.\n                        </div>\n                    </div>\n                    <div class=\"h-5 w-px bg-[#334155]\" data-kid=\"2-1-3-1-2-2\" data-name=\"Header separator\">\n                    </div>\n                    <button aria-label=\"Cambiar tema\" class=\"flex h-9 w-9 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-3-1-2-3\" data-name=\"Theme toggle button\">\n                        <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"Theme icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex h-9 w-9 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-3-1-2-4\" data-name=\"Notifications button\">\n                        <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-3-1-2-4-1\" data-name=\"Notifications bell icon\">\n                        </i>\n                        <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-3-1-2-4-2\" data-name=\"Notification unread indicator\">\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-3 border-l border-[#334155] pl-5\" data-kid=\"2-1-3-1-2-5\" data-name=\"User account header info\">\n                        <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-1-2-5-1\" data-name=\"User account initials\">\n                            TR\n                        </div>\n                        <div class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-1-2-5-2\" data-name=\"User account name\">\n                            Taller Rápido\n                        </div>\n                        <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-1-3-1-2-5-3\" data-name=\"Account dropdown chevron\">\n                        </i>\n                    </div>\n                </div>\n            </header>\n            <div class=\"px-8 pb-14 pt-8\" data-kid=\"2-1-3-2\" data-name=\"Main content body\">\n                <div class=\"mb-7 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"Page heading section\">\n                    <div data-kid=\"2-1-3-2-1-1\" data-name=\"Page title container\">\n                        <h1 class=\"text-[30px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-1-3-2-1-1-1\" data-name=\"Page main title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Reparaciones\n                        </h1>\n                        <p class=\"mt-2 text-[14px] text-[#94A3B8]\" data-kid=\"2-1-3-2-1-1-2\" data-name=\"Page description text\">\n                            Sigue cada vehículo desde la recepción hasta la entrega.\n                        </p>\n                    </div>\n                    <button class=\"flex items-center gap-2 bg-[#38BDF8] px-4 py-2.5 text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-2-1-2\" data-name=\"New repair action button\">\n                        <i class=\"ti ti-plus text-[15px]\" data-kid=\"2-1-3-2-1-2-1\" data-name=\"Plus icon\">\n                        </i>\n                        Nueva reparación\n                    </button>\n                </div>\n                <div class=\"mb-6 flex items-center justify-between border-y border-[#334155] py-3\" data-kid=\"2-1-3-2-2\" data-name=\"Filter controls bar\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-2-1\" data-name=\"Filter buttons container\">\n                        <button class=\"border border-[#475569] bg-[#1E293B] px-3 py-2 text-[12px] font-semibold text-[#F8FAFC]\" data-kid=\"2-1-3-2-2-1-1\" data-name=\"All repairs filter button\">\n                            Todas\n                            <span class=\"ml-1 text-[#38BDF8]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-1-1-1\" data-name=\"All repairs count\" data-reason=\"count updated from system state\">\n                                09\n                            </span>\n                        </button>\n                        <button class=\"border border-transparent px-3 py-2 text-[12px] font-medium text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-2\" data-name=\"High priority filter button\">\n                            Alta prioridad\n                            <span class=\"ml-1 text-[#F87171]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-1-2-1\" data-name=\"High priority count\" data-reason=\"count updated from system state\">\n                                03\n                            </span>\n                        </button>\n                        <button class=\"border border-transparent px-3 py-2 text-[12px] font-medium text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-3\" data-name=\"Today filter button\">\n                            Hoy\n                            <span class=\"ml-1 text-[#FBBF24]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-1-3-1\" data-name=\"Today count\" data-reason=\"count updated from system state\">\n                                05\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-2-2\" data-name=\"View controls info\">\n                        <i class=\"ti ti-layout-columns text-[15px]\" data-kid=\"2-1-3-2-2-2-1\" data-name=\"Layout icon\">\n                        </i>\n                        Vista de tablero\n                        <span class=\"text-[#475569]\" data-kid=\"2-1-3-2-2-2-2\" data-name=\"View status separator\">\n                            ·\n                        </span>\n                        En pantallas estrechas se cambia a pestañas\n                    </div>\n                </div>\n                <section aria-label=\"Estados de reparaciones\" class=\"grid grid-cols-3 gap-5\" data-kid=\"2-1-3-2-3\" data-name=\"Repairs board section\">\n                    <div class=\"min-w-0 border-t-2 border-[#FBBF24]\" data-kid=\"2-1-3-2-3-1\" data-name=\"Todo status column\">\n                        <div class=\"flex items-end justify-between border-b border-[#334155] py-3\" data-kid=\"2-1-3-2-3-1-1\" data-name=\"Column header\">\n                            <div data-kid=\"2-1-3-2-3-1-1-1\" data-name=\"Column title container\">\n                                <h2 class=\"text-[16px] font-bold text-white\" data-kid=\"2-1-3-2-3-1-1-1-1\" data-name=\"Column title text\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                                    Por revisar\n                                </h2>\n                                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1-1-2\" data-name=\"Column description\">\n                                    Recepción y diagnóstico\n                                </p>\n                            </div>\n                            <span class=\"text-[20px] font-bold tabular-nums text-[#FBBF24]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-3-1-1-2\" data-name=\"Column items count\" data-reason=\"count updated from system state\">\n                                04\n                            </span>\n                        </div>\n                        <div class=\"divide-y divide-[#334155]\" data-kid=\"2-1-3-2-3-1-2\" data-name=\"Column items list\">\n                            <article class=\"py-4\" data-kid=\"2-1-3-2-3-1-2-1\" data-name=\"Repair card\">\n                                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-1-3-2-3-1-2-1-1\" data-name=\"Repair card header\">\n                               