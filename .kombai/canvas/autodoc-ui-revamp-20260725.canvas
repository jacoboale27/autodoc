    "var_26e69b16ce26": {
      "type": "variant",
      "label": "AutoDoc Admin Dashboard — Hadrian Dark Mobile",
      "parentId": "var_caca20492ecf",
      "themeId": null,
      "rect": {
        "x": 8800,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<style data-name=\"AutoDoc shared component tokens dark\">\n    button { min-height:44px; min-width:44px; border-radius:999px !important; transition:transform 150ms cubic-bezier(.23,1,.32,1),box-shadow 150ms cubic-bezier(.23,1,.32,1),background-color 150ms cubic-bezier(.23,1,.32,1),color 150ms cubic-bezier(.23,1,.32,1); }\n  button:active { transform:scale(.97); }\n  button:hover { box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  button[data-name*=\"primary button\"], button[data-name*=\"create user button\"] { background:linear-gradient(135deg,#81E6D9,#6FC8BC) !important; color:#0F172A !important; border:0 !important; box-shadow:0 2px 4px rgba(0,0,0,.20); }\n  button[data-name*=\"refresh\"], button[data-name*=\"export\"], button[data-name*=\"filter\"], button[data-name*=\"page\"] { background:#141E36 !important; border:1px solid rgba(51,65,85,.20) !important; color:#E2E8F0 !important; box-shadow:0 2px 4px rgba(0,0,0,.20); }\n  button[aria-label*=\"Notificaciones\"], button[aria-label*=\"Cambiar tema\"], button[aria-label*=\"Abrir menú\"], button[aria-label*=\"Configuración\"], button[aria-label*=\"Ayuda\"] { background:#141E36 !important; border:1px solid rgba(51,65,85,.20) !important; }\n  section[data-name*=\"metrics\"], section[data-name*=\"panel\"], section[data-name*=\"Logs\"], section[data-name*=\"logs\"], section[data-name*=\"table\"] { background:#141E36; border-color:rgba(51,65,85,.20) !important; border-radius:16px; box-shadow:0 2px 4px rgba(0,0,0,.20); overflow:hidden; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"Application dashboard container\" style=\"font-family:'IBM Plex Sans',sans-serif\">\n    <header aria-label=\"Barra superior de administración\" class=\"sticky top-0 z-20 flex h-[68px] items-center justify-between border-b border-[#334155] bg-[#020617]/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"Top administrative navigation bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"Application identity container\">\n            <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#082F49]\" data-kid=\"2-1-1-1\" data-name=\"Application logo container\">\n                <span class=\"text-[18px] font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1-1\" data-name=\"Application logo initials text\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    AD\n                </span>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"Context branding container\">\n                <div class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"Context label text\">\n                    Administración\n                </div>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-2-2\" data-name=\"Application title group\">\n                    <span class=\"truncate text-[15px] font-extrabold tracking-[-0.03em]\" data-kid=\"2-1-1-2-2-1\" data-name=\"Application title text\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                        Auto\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-2-2-1-1\" data-name=\"Application title suffix text\">\n                            Doc\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-2-2-2\" data-name=\"Status online indicator\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"User navigation action buttons\">\n            <button aria-label=\"Cambiar tema\" class=\"flex h-11 w-11 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-2-1\" data-name=\"Theme toggle button\">\n                <i class=\"ti ti-sun-moon text-[18px]\" data-kid=\"2-1-2-1-1\" data-name=\"Sun-moon theme icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative flex h-11 w-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-2-2\" data-name=\"Notifications button\">\n                <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-2-2-1\" data-name=\"Bell notification icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-2\" data-name=\"Notification badge indicator\">\n                </span>\n            </button>\n            <button aria-label=\"Abrir menú de Superadmin\" class=\"flex h-11 w-11 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-2-3\" data-name=\"Superadmin user menu button\">\n                SA\n            </button>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[116px] pt-6\" data-kid=\"2-2\" data-name=\"Main content container\" id=\"resumen\">\n        <div class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"Page header section\">\n            <div class=\"mb-3 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"Breadcrumb navigation trail\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"Breadcrumb root label\">\n                    Admin\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-2-1-1-2\" data-name=\"Breadcrumb separator icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-2-1-1-3\" data-name=\"Current page label\">\n                    Resumen\n                </span>\n            </div>\n            <h1 class=\"text-[27px] font-extrabold leading-tight tracking-[-0.045em] text-white\" data-kid=\"2-2-1-2\" data-name=\"Page title heading\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                Resumen operativo\n            </h1>\n            <p class=\"mt-2 max-w-[310px] text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-3\" data-name=\"Page description text\">\n                Salud de la plataforma y actividad reciente.\n            </p>\n            <button class=\"mt-5 flex min-h-[46px] w-full items-center justify-center gap-2 border border-[#475569] px-4 py-3 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-1-4\" data-name=\"Data refresh button\">\n                <i class=\"ti ti-refresh text-[16px] text-[#38BDF8]\" data-kid=\"2-2-1-4-1\" data-name=\"Refresh icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Actualizar datos\n            </button>\n        </div>\n        <section aria-label=\"Métricas operativas\" class=\"grid grid-cols-2 border border-[#475569] bg-[#1E293B]\" data-kid=\"2-2-2\" data-name=\"Operational metrics grid\">\n            <div class=\"min-h-[126px] border-b border-r border-[#475569] px-4 py-4\" data-kid=\"2-2-2-1\" data-name=\"Users metric card\">\n                <div class=\"text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-1-1\" data-name=\"Users label\">\n                    Usuarios\n                </div>\n                <div class=\"mt-2 text-[23px] font-bold tabular-nums text-[#F8FAFC]\" data-dynamic=\"true\" data-kid=\"2-2-2-1-2\" data-name=\"Total users count\" data-reason=\"number text periodically updated by dashboard script\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    1,284\n                </div>\n                <div class=\"mt-2 flex items-center gap-1 text-[10px] text-[#64748B]\" data-kid=\"2-2-2-1-3\" data-name=\"Users growth trend container\">\n                    <i class=\"ti ti-trending-up text-[13px] text-[#34D399]\" data-kid=\"2-2-2-1-3-1\" data-name=\"Trending-up icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-semibold text-[#34D399]\" data-dynamic=\"true\" data-kid=\"2-2-2-1-3-2\" data-name=\"Users percentage change text\" data-reason=\"percentage updated by stats script\">\n                        +8.4%\n                    </span>\n                    <span data-kid=\"2-2-2-1-3-3\" data-name=\"Users growth context text\">\n                        vs. mes anterior\n                    </span>\n                </div>\n            </div>\n            <div class=\"min-h-[126px] border-b border-[#475569] px-4 py-4\" data-kid=\"2-2-2-2\" data-name=\"Workshops metric card\">\n                <div class=\"text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-2-1\" data-name=\"Workshops label\">\n                    Talleres\n                </div>\n                <div class=\"mt-2 text-[23px] font-bold tabular-nums text-[#F8FAFC]\" data-dynamic=\"true\" data-kid=\"2-2-2-2-2\" data-name=\"Total workshops count\" data-reason=\"number text periodically updated by dashboard script\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    86\n                </div>\n                <div class=\"mt-2 flex items-center gap-1 text-[10px] text-[#64748B]\" data-kid=\"2-2-2-2-3\" data-name=\"Workshops growth trend container\">\n                    <i class=\"ti ti-building-store text-[13px] text-[#38BDF8]\" data-kid=\"2-2-2-2-3-1\" data-name=\"Workshops building icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-semibold text-[#34D399]\" data-dynamic=\"true\" data-kid=\"2-2-2-2-3-2\" data-name=\"New workshops count\" data-reason=\"number updated by stats script\">\n                        +3\n                    </span>\n                    <span data-kid=\"2-2-2-2-3-3\" data-name=\"Workshops growth context text\">\n                        aprobados este mes\n                    </span>\n                </div>\n            </div>\n            <div class=\"min-h-[126px] border-r border-[#475569] px-4 py-4\" data-kid=\"2-2-2-3\" data-name=\"Services monthly metric card\">\n                <div class=\"text-[11px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-2-3-1\" data-name=\"Services label\">\n                    Servicios este mes\n                </div>\n                <div class=\"mt-2 text-[23px] font-bold tabular-nums text-[#F8FAFC]\" data-dynamic=\"true\" data-kid=\"2-2-2-3-2\" data-name=\"Total services count\" data-reason=\"number text periodically updated by dashboard script\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    642\n                </div>\n                <div class=\"mt-2 flex items-center gap-1 text-[10px] text-[#64748B]\" data-kid=\"2-2-2-3-3\" data-name=\"Services growth trend container\">\n                    <i class=\"ti ti-tool text-[13px] text-[#FBBF24]\" data-kid=\"2-2-2-3-3-1\" data-name=\"Tools icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-semibold text-[#FBBF24]\" data-dynamic=\"true\" data-kid=\"2-2-2-3-3-2\" data-name=\"Services growth percentage text\" d