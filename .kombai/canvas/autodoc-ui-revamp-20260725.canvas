    "var_ab10314ab481": {
      "type": "variant",
      "label": "AutoDoc Auth — Hadrian Dark",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 37100,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#0F172A] text-[#F8FAFC] [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"auth application shell\">\n    <div class=\"flex min-h-screen flex-col lg:flex-row\" data-kid=\"2-1\" data-name=\"auth split layout\">\n        <section aria-label=\"Marca AutoDoc\" class=\"relative hidden min-h-screen overflow-hidden border-r border-[#1E293B] bg-[#020617] lg:flex lg:w-[54%]\" data-kid=\"2-1-1\" data-name=\"brand panel\">\n            <img alt=\"Sedán Hyundai en estudio, fotografía de Hyundai Motor Group en Pexels\" class=\"absolute inset-0 h-full w-full object-cover opacity-45\" data-kid=\"2-1-1-1\" data-name=\"brand vehicle image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14696345/pexels-photo-14696345.jpeg?auto=compress&cs=tinysrgb&w=1400&q=80\"/>\n            <div class=\"absolute inset-0 bg-[#020617]/75\" data-kid=\"2-1-1-2\" data-name=\"brand image overlay\">\n            </div>\n            <div class=\"relative z-10 flex min-h-screen w-full flex-col justify-between px-14 py-12\" data-kid=\"2-1-1-3\" data-name=\"brand panel content\">\n                <div class=\"flex items-center justify-between\" data-kid=\"2-1-1-3-1\" data-name=\"brand top row\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-1-1-3-1-1\" data-name=\"brand identity\">\n                        <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-[12px] bg-[#38BDF8] text-[18px] font-extrabold tracking-[-0.09em] text-[#082F49] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-3-1-1-1\" data-name=\"brand logo mark\">\n                            AD\n                        </div>\n                        <div class=\"[font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-3-1-2\" data-name=\"brand wordmark\">\n                            <div class=\"text-[18px] font-extrabold tracking-[-0.05em]\" data-kid=\"2-1-1-3-1-2-1\" data-name=\"brand name\">\n                                Auto\n                                <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-3-1-2-1-1\" data-name=\"brand name highlight\">\n                                    Doc\n                                </span>\n                            </div>\n                            <div class=\"mt-0.5 text-[10px] font-semibold uppercase tracking-[0.22em] text-[#94A3B8]\" data-kid=\"2-1-1-3-1-2-2\" data-name=\"brand tagline\">\n                                Control vehicular\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-2 text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-3-1-3\" data-name=\"brand language control\">\n                        <span class=\"rounded-[4px] border border-[#334155] px-2.5 py-1.5 text-[#E2E8F0]\" data-kid=\"2-1-1-3-1-3-1\" data-name=\"active language option\">\n                            ES\n                        </span>\n                        <span data-kid=\"2-1-1-3-1-3-2\" data-name=\"inactive language option\">\n                            EN\n                        </span>\n                    </div>\n                </div>\n                <div class=\"max-w-[520px] pb-7\" data-kid=\"2-1-1-3-2\" data-name=\"brand statement block\">\n                    <div class=\"mb-6 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-[#38BDF8]\" data-kid=\"2-1-1-3-2-1\" data-name=\"brand eyebrow\">\n                        <span class=\"h-px w-10 bg-[#38BDF8]\" data-kid=\"2-1-1-3-2-1-1\" data-name=\"eyebrow decorative line\">\n                        </span>\n                        Seguridad antes que sorpresa\n                    </div>\n                    <h1 class=\"max-w-[500px] [font-family:'Plus_Jakarta_Sans',sans-serif] text-[44px] font-extrabold leading-[1.08] tracking-[-0.055em] text-white\" data-kid=\"2-1-1-3-2-2\" data-name=\"brand headline\">\n                        Mantenimiento claro.\n                        <br data-kid=\"2-1-1-3-2-2-1\" data-name=\"headline line break\"/>\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-3-2-2-2\" data-name=\"headline highlight\">\n                            Decisiones seguras.\n                        </span>\n                    </h1>\n                    <p class=\"mt-6 max-w-[420px] text-[17px] leading-7 text-[#CBD5E1]\" data-kid=\"2-1-1-3-2-3\" data-name=\"brand supporting copy\">\n                        Consulta el estado de tus vehículos, entiende lo que necesitan y llega al taller con la información correcta.\n                    </p>\n                    <div class=\"mt-9 grid max-w-[440px] grid-cols-2 border-y border-[#334155] py-5\" data-kid=\"2-1-1-3-2-4\" data-name=\"brand trust metrics\">\n                        <div class=\"border-r border-[#334155] pr-6\" data-kid=\"2-1-1-3-2-4-1\" data-name=\"brand metric one\">\n                            <div class=\"text-[24px] font-bold tabular-nums text-[#F8FAFC] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-3-2-4-1-1\" data-name=\"metric one value\">\n                                01\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-1-3-2-4-1-2\" data-name=\"metric one label\">\n                                Garaje conectado\n                            </div>\n                        </div>\n                        <div class=\"pl-6\" data-kid=\"2-1-1-3-2-4-2\" data-name=\"brand metric two\">\n                            <div class=\"text-[24px] font-bold tabular-nums text-[#F8FAFC] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-3-2-4-2-1\" data-name=\"metric two value\">\n                                24/7\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-1-3-2-4-2-2\" data-name=\"metric two label\">\n                                Historial disponible\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-1-3-3\" data-name=\"brand footer\">\n                    <span data-kid=\"2-1-1-3-3-1\" data-name=\"brand copyright notice\">\n                        AutoDoc · Diagnóstico y mantenimiento vehicular\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-1-1-3-3-2\" data-name=\"brand status indicator\">\n                        <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-3-3-2-1\" data-name=\"status dot icon\">\n                        </span>\n                        Servicio protegido\n                    </span>\n                </div>\n            </div>\n        </section>\n        <main class=\"flex min-h-screen flex-1 items-center justify-center bg-[#0F172A] px-6 py-10 sm:px-10 lg:w-[46%] lg:px-12\" data-kid=\"2-1-2\" data-name=\"auth form panel\">\n            <div class=\"w-full max-w-[420px] rounded-[16px] border border-[#334155]/20 bg-[#141E36] p-6 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-1-2-1\" data-name=\"auth form container\">\n                <div class=\"mb-10 flex items-center justify-between lg:hidden\" data-kid=\"2-1-2-1-1\" data-name=\"mobile brand row\">\n                    <div class=\"flex items-center gap-2 [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-2-1-1-1\" data-name=\"mobile brand identity\">\n                        <div class=\"grid size-9 place-items-center rounded-[10px] bg-[#38BDF8] text-[15px] font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-2-1-1-1-1\" data-name=\"mobile logo mark\">\n                            AD\n                        </div>\n                        <span class=\"text-[17px] font-extrabold tracking-[-0.05em]\" data-kid=\"2-1-2-1-1-1-2\" data-name=\"mobile brand name\">\n                            Auto\n                            <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-1-1-2-1\" data-name=\"mobile brand highlight\">\n                                Doc\n                            </span>\n                        </span>\n                    </div>\n                    <span class=\"text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1-2\" data-name=\"mobile language selector\">\n                        ES / EN\n                    </span>\n                </div>\n                <div class=\"mb-9\" data-kid=\"2-1-2-1-2\" data-name=\"auth form introduction\">\n                    <div class=\"mb-4 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1\" data-name=\"auth eyebrow\">\n                        <span class=\"size-1.5 rounded-full bg-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"eyebrow bullet\">\n                        </span>\n                        Acceso seguro\n                    </div>\n                    <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[32px] font-extrabold tracking-[-0.05em] text-[#F8FAFC]\" data-kid=\"2-1-2-1-2-2\" data-name=\"auth heading\">\n                        Bienvenido a AutoDoc\n                    </h2>\n                    <p class=\"mt-3 max-w-[380px] text-[15px] leading-6 text-[#94A3B8]\" data-kid=\"2-1-2-1-2-3\" data-name=\"auth description\">\n                        Accede para ver el estado de tus vehículos y tus servicios.\n                    </p>\n                </div>\n                <div class=\"mb-6 flex items-start gap-3 border-l-4 border-[#F87171] bg-[#3F1D25] px-4 py-3.5\" data-kid=\"2-1-2-1-3\" data-name=\"inline authentication error\" role=\"alert\">\n                    <i aria-hidden=\"true\" class=\"ti ti-alert-triangle mt-0.5 text-[18px] text-[#FCA5A5]\" data-kid=\"2-1-2-1-3-1\" data-name=\"error alert icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <div data-kid=\"2-1-2-1-3-2\" data-name=\"error message block\">\n                        <div class=\"text-[13px] font-bold text-[#FCA5A5]\" data-kid=\"2-1-2-1-3-2-1\" data-name=\"error title\">\n                            Revisa tu correo y contraseña\n                        </div>\n                        <div class=\"mt-1 text-[12px] leading-5 text-[#FECACA]\" data-kid=\"2-1-2-1-3-2-2\" data-name=\"error detail\">\n                            No pudimos validar estas credenciales. Inténtalo de nuevo.\n                        </div>\n                    </div>\n                </div>\n                <form aria-label=\"Iniciar sesión\" class=\"space-y-5\" data-kid=\"2-1-2-1-4\" data-name=\"login form\">\n                    <label class=\"block\" data-kid=\"2-1-2-1-4-1\" data-name=\"email field\">\n                        <span class=\"mb-2 block text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-2-1-4-1-2\" data-name=\"email field label\">\n                            Correo electrónico\n                        </span>\n                        <div class=\"flex h-[54px] items-center gap-3 border border-[#38BDF8] bg-[#0F172A] px-4 ring-2 ring-[#38BDF8]/20\" data-kid=\"2-1-2-1-4-1-1\" data-name=\"focused email input wrapper\">\n                            <i aria-hidden=\"true\" class=\"ti ti-mail text-[18px] text-[#38BDF8]\" data-kid=\"2-1-2-1-4-1-1-1\" data-name=\"email input icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <input aria-label=\"Correo electrónico\" class=\"min-w-0 flex-1 bg-transparent text-[15px] text-[#F8FAFC] outline-hidden placeholder:text-[#64748B]\" data-kid=\"2-1-2-1-4-1-1-2\" data-name=\"email input field\" type=\"email\" value=\"juan@ejemplo.com\"/>\n                        </div>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-1-2-1-4-2\" data-name=\"password field\">\n                        <span class=\"mb-2 block text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-2-1-4-2-2\" data-name=\"password field label\">\n                            Contraseña\n                        </span>\n                        <div class=\"flex h-[54px] items-center gap-3 border border-[#475569] bg-[#0F172A] px-4\" data-kid=\"2-1-2-1-4-2-1\" data-name=\"password input wrapper\">\n                            <i aria-hidden=\"true\" class=\"ti ti-lock text-[18px] text-[#94A3B8]\" data-kid=\"2-1-2-1-4-2-1-1\" data-name=\"password input icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <input aria-label=\"Contraseña\" class=\"min-w-0 flex-1 bg-transparent text-[15px] tracking-[0.16em] text-[#F8FAFC] outline-hidden placeholder:text-[#64748B]\" data-kid=\"2-1-2-1-4-2-1-2\" data-name=\"password input field\" type=\"password\" value=\"autodoc2026\"/>\n                            <button aria-label=\"Mostrar contraseña\" class=\"grid size-12 shrink-0 place-items-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:text-[#81E6D9] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-2-1-4-2-1-3\" data-name=\"password visibility toggle button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-eye text-[18px]\" data-kid=\"2-1-2-1-4-2-1-3-1\" data-name=\"visibility toggle icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                    </label>\n                    <div class=\"flex min-h-[48px] items-center justify-between gap-4\" data-kid=\"2-1-2-1-4-3\" data-name=\"auth form options\">\n                        <label class=\"flex min-h-[48px] items-center gap-3 text-[13px] text-[#CBD5E1]\" data-kid=\"2-1-2-1-4-3-1\" data-name=\"remember me option\">\n                            <input aria-label=\"Recordarme\" checked=\"\" class=\"size-5 accent-[#38BDF8]\" data-kid=\"2-1-2-1-4-3-1-1\" data-name=\"remember me checkbox\" type=\"checkbox\"/>\n                            <span data-kid=\"2-1-2-1-4-3-1-2\" data-name=\"remember me label\">\n                                Recordarme\n                            </span>\n                        </label>\n                        <button class=\"min-h-[48px] px-1 text-[13px] font-semibold text-[#38BDF8] hover:text-[#7DD3FC]\" data-kid=\"2-1-2-1-4-3-2\" data-name=\"forgot password button\" type=\"button\">\n                            ¿Olvidaste tu contraseña?\n                        </button>\n                    </div>\n                    <button class=\"flex h-[54px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-5 text-[14px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-2-1-4-4\" data-name=\"primary login button\" type=\"submit\">\n                        <i aria-hidden=\"true\" class=\"ti ti-login-2 text-[18px]\" data-kid=\"2-1-2-1-4-4-1\" data-name=\"login button icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Iniciar sesión\n                    </button>\n                </form>\n                <div class=\"my-7 flex items-center gap-4\" data-kid=\"2-1-2-1-5\" data-name=\"auth divider\">\n                    <span class=\"h-px flex-1 bg-[#334155]\" data-kid=\"2-1-2-1-5-1\" data-name=\"left divider line\">\n                    </span>\n                    <span class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-2-1-5-2\" data-name=\"divider label\">\n                        o\n                    </span>\n                    <span class=\"h-px flex-1 bg-[#334155]\" data-kid=\"2-1-2-1-5-3\" data-name=\"right divider line\">\n                    </span>\n                </div>\n                <button class=\"flex h-[54px] w-full items-center justify-center gap-3 rounded-full border border-[#334155] bg-[#141E36] px-5 text-[14px] font-semibold text-[#E2E8F0] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:border-[#81E6D9] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-1-2-1-6\" data-name=\"google login button\" type=\"button\">\n                    <span class=\"grid size-6 place-items-center rounded-full bg-white text-[14px] font-bold text-[#4285F4]\" data-kid=\"2-1-2-1-6-1\" data-name=\"google icon container\">\n                        G\n                    </span>\n                    Continuar con Google\n                </button>\n                <p class=\"mt-8 text-center text-[13px] text-[#94A3B8]\" data-kid=\"2-1-2-1-7\" data-name=\"auth mode switch\">\n                    ¿No tienes cuenta?\n                    <button class=\"font-bold text-[#38BDF8] underline decoration-[#38BDF8]/50 underline-offset-4 hover:text-[#7DD3FC]\" data-kid=\"2-1-2-1-7-1\" data-name=\"create account button\" type=\"button\">\n                        Crear cuenta\n                    </button>\n                </p>\n                <p class=\"mt-10 text-center text-[11px] leading-5 text-[#64748B]\" data-kid=\"2-1-2-1-8\" data-name=\"auth legal note\">\n                    Al continuar, aceptas los términos de uso y la política de privacidad de AutoDoc.\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-08-15T15:37:09.562530+00:00",
      "modified": "2026-08-17T21:04:09.737626+00:00",
      "id": "var_ab10314ab481"
    },
    "var_26604e73179b": {
      "type": "variant",
      "label": "AutoDoc Initiate Service — Hadrian Light",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 38955,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style data-name=\"AutoDoc shared component treatment\">\n    :root { --app-primary: #522C81; --app-secondary: #81E6D9; --app-surface-container: #EEEDF0; --app-outline: #CBD5E1; --app-on-primary: #FFFFFF; --app-shadow-sm: 0 2px 4px rgba(15,23,42,0.05); --app-shadow-hover: 0 6px 14px rgba(15,23,42,0.10); }\n  button { min-height: 48px; border-radius: 999px !important; transition: transform 150ms cubic-bezier(0.23,1,0.32,1), box-shadow 150ms cubic-bezier(0.23,1,0.32,1), background-color 150ms cubic-bezier(0.23,1,0.32,1), border-color 150ms cubic-bezier(0.23,1,0.32,1), color 150ms cubic-bezier(0.23,1,0.32,1); }\n  button:active { transform: scale(0.97); }\n  button:focus-visible { outline: 3px solid rgba(82,44,129,0.35); outline-offset: 2px; }\n  button[class*=\"bg-[#1E88E5]\"], button[class*=\"bg-[#38BDF8]\"] { background: var(--app-primary) !important; color: var(--app-on-primary) !important; box-shadow: var(--app-shadow-sm); }\n  button[class*=\"border-[#1E88E5]\"], button[class*=\"border-[#38BDF8]\"] { border-color: var(--app-primary) !important; color: var(--app-primary) !important; }\n  button[class*=\"bg-\"]:hover, button[class*=\"border-\"]:hover { box-shadow: var(--app-shadow-hover); }\n  button[aria-label=\"Notificaciones\"], button[aria-label=\"Cambiar a modo oscuro\"], button[aria-label=\"Cambiar tema\"], button[aria-label=\"Panel del taller\"], button[aria-label=\"Reparaciones\"], button[aria-label=\"Buscar vehículo\"], button[aria-label=\"Conversaciones\"], button[aria-label=\"Ayuda\"], button[aria-label=\"Configuración\"], button[aria-label^=\"Más acciones\"], button[aria-label^=\"Acciones para\"], button[aria-label=\"Ordenar reseñas\"], button[aria-label=\"Limpiar filtros\"], button[aria-label=\"Página anterior\"], button[aria-label=\"Página siguiente\"] { min-width: 48px !important; min-height: 48px !important; padding: 0.75rem !important; border: 1px solid var(--app-outline) !important; border-radius: 999px !important; background: var(--app-surface-container) !important; box-shadow: var(--app-shadow-sm); }\n  button[aria-label=\"Notificaciones\"]:hover, button[aria-label=\"Cambiar a modo oscuro\"]:hover, button[aria-label=\"Cambiar tema\"]:hover, button[aria-label^=\"Más acciones\"]:hover, button[aria-label^=\"Acciones para\"]:hover { box-shadow: var(--app-shadow-hover); }\n  main section { border: 1px solid rgba(203,213,225,0.70); border-radius: 16px; background: var(--app-surface-container); box-shadow: var(--app-shadow-sm); overflow: hidden; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"initiate service application\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"mechanic icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <div class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary mechanic navigation\">\n                <button aria-label=\"Panel del taller\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard navigation button\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </button>\n                <button aria-label=\"Reparaciones\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-2\" data-name=\"repairs navigation button\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-2-1\" data-name=\"tools icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF\">\n                    </i>\n                </button>\n                <button aria-label=\"Buscar vehículo\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"2-1-1-2-3\" data-name=\"vehicle search navigation button\">\n                    <i class=\"ti ti-car-search\" data-kid=\"2-1-1-2-3-1\" data-name=\"car search icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </button>\n                <button aria-label=\"Chat\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8]\" data-kid=\"2-1-1-2-4\" data-name=\"chat navigation button\">\n                    <i class=\"ti ti-message-circle\" data-kid=\"2-1-1-2-4-1\" data-name=\"chat icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"utility navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8]\" data-kid=\"2-1-1-3-1\" data-name=\"help button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8]\" data-kid=\"2-1-1-3-2\" data-name=\"settings button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"workshop contextual sidebar\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"workshop identity\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"role label\">\n                    Taller\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"workshop status\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"online status dot\">\n                    </span>\n                    <span class=\"font-heading text-[16px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"workshop name\">\n                        Taller Rápido\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-2-1-3\" data-name=\"workshop activity status\">\n                    Operación activa\n                </p>\n            </div>\n            <nav aria-label=\"Navegación del taller\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"workshop navigation\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B]\" data-kid=\"2-1-2-2-1\" data-name=\"panel link\" href=\"#\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"2-1-2-2-1-1\" data-name=\"dashboard icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Panel\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-2.5 text-[14px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-2-2\" data-name=\"active repairs link\" href=\"#servicio\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-2-2-2-1\" data-name=\"tools icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                    </i>\n                    Reparaciones\n                    <span class=\"ml-auto text-[11px] font-bold tabular-nums text-[#1E88E5]\" data-kid=\"2-1-2-2-2-2\" data-name=\"active repairs count badge\">\n                        04\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B]\" data-kid=\"2-1-2-2-3\" data-name=\"vehicle search link\" href=\"#\">\n                    <i class=\"ti ti-car-search\" data-kid=\"2-1-2-2-3-1\" data-name=\"car search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Buscar vehículo\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B]\" data-kid=\"2-1-2-2-4\" data-name=\"history link\" href=\"#\">\n                    <i class=\"ti ti-history\" data-kid=\"2-1-2-2-4-1\" data-name=\"history icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Historial\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B]\" data-kid=\"2-1-2-2-5\" data-name=\"reviews link\" href=\"#\">\n                    <i class=\"ti ti-star\" data-kid=\"2-1-2-2-5-1\" data-name=\"star icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Reseñas\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"workshop management navigation\">\n                <p class=\"mb-2 px-3 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-3-1\" data-name=\"management label\">\n                    Gestión\n                </p>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-2-3-2\" data-name=\"catalog link\" href=\"#\">\n                    <i class=\"ti ti-list-details\" data-kid=\"2-1-2-3-2-1\" data-name=\"catalog icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Catálogo\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-2-3-3\" data-name=\"employees link\" href=\"#\">\n                    <i class=\"ti ti-users\" data-kid=\"2-1-2-3-3-1\" data-name=\"employees icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Empleados\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B]\" data-kid=\"2-1-2-3-4\" data-name=\"settings link\" href=\"#\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-2-3-4-1\" data-name=\"settings icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Configuración\n                </a>\n                <div class=\"mt-5 flex items-center gap-3 border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3-5\" data-name=\"workshop user profile\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3-5-1\" data-name=\"user initials\">\n                        MR\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-5-2\" data-name=\"user profile name container\">\n                        <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-3-5-2-1\" data-name=\"user full name\">\n                            María Rodríguez\n                        </p>\n                        <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-5-2-2\" data-name=\"user role\">\n                            Administradora\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"2-1-3\" data-name=\"service registration content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-white px-8\" data-kid=\"2-1-3-1\" data-name=\"top header\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumb\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-1-3-1-1-1\" data-name=\"breadcrumb parent\">\n                        Taller\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-3-1-1-2\" data-name=\"breadcrumb separator\">\n                        /\n                    </span>\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-1-3\" data-name=\"breadcrumb current page\">\n                        Nueva reparación\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-4\" data-kid=\"2-1-3-1-2\" data-name=\"header actions\">\n                    <button class=\"inline-flex min-h-12 items-center gap-2 border border-[#CBD5E1] bg-white px-4 text-[13px] font-semibold text-[#334155]\" data-kid=\"2-1-3-1-2-1\" data-name=\"save draft button\">\n                        <i class=\"ti ti-device-floppy\" data-kid=\"2-1-3-1-2-1-1\" data-name=\"save draft icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                        </i>\n                        Guardar borrador\n                    </button>\n                    <button aria-label=\"Notificaciones\" class=\"grid size-11 place-items-center text-[19px] text-[#64748B]\" data-kid=\"2-1-3-1-2-2\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-2-2-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                        </i>\n                    </button>\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-1-2-3\" data-name=\"user avatar\">\n                        MR\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1160px] px-8 py-7\" data-kid=\"2-1-3-2\" data-name=\"service form body\">\n                <div class=\"mb-5 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"page heading\">\n                    <div data-kid=\"2-1-3-2-1-4\">\n                        <h1 class=\"font-heading text-[30px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-1-3-2-1-1\" data-name=\"page headline\">\n                            Registrar servicio\n                        </h1>\n                        <p class=\"mt-2 text-[14px] text-[#334155]\" data-kid=\"2-1-3-2-1-2\" data-name=\"page description\">\n                            Documenta el trabajo realizado y deja el historial listo para el propietario.\n                        </p>\n                    </div>\n                    <span class=\"inline-flex min-h-10 items-center gap-2 border border-[#F59E0B]/40 bg-[#FFFBEB] px-3 text-[12px] font-semibold text-[#92400E]\" data-kid=\"2-1-3-2-1-3\" data-name=\"unsaved changes notice\">\n                        <span class=\"size-2 rounded-full bg-[#F59E0B]\" data-kid=\"2-1-3-2-1-3-1\" data-name=\"warning dot\">\n                        </span>\n                        Cambios sin guardar\n                    </span>\n                </div>\n                <section class=\"flex items-center justify-between border-y border-[#CBD5E1] bg-white px-5 py-4\" data-kid=\"2-1-3-2-2\" data-name=\"vehicle service strip\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"2-1-3-2-2-1\" data-name=\"vehicle identity\">\n                        <span class=\"grid size-11 place-items-center border border-[#CBD5E1] text-[21px] text-[#1E88E5]\" data-kid=\"2-1-3-2-2-1-1\" data-name=\"vehicle icon wrapper\">\n                            <i class=\"ti ti-car\" data-kid=\"2-1-3-2-2-1-1-1\" data-name=\"car icon\" style=\"width:21px;height:21px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                            </i>\n                        </span>\n                        <div data-kid=\"2-1-3-2-2-1-2\" data-name=\"vehicle info\">\n                            <p class=\"font-heading text-[16px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-2-1-2-1\" data-name=\"vehicle model\">\n                                Toyota Corolla 2022\n                            </p>\n                            <p class=\"mt-1 text-[12px] tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-2-1-2-2\" data-name=\"vehicle registration\">\n                                P 482-916\n                                <span class=\"mx-2 text-[#CBD5E1]\" data-kid=\"2-1-3-2-2-1-2-2-1\" data-name=\"separator dot\">\n                                    ·\n                                </span>\n                                48,260 km\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-2-2-2\" data-name=\"open service status\">\n                        <span class=\"inline-flex items-center gap-2 text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-2-2-1\" data-name=\"service status label\">\n                            <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-3-2-2-2-1-1\" data-name=\"status dot\">\n                            </span>\n                            Servicio abierto\n                        </span>\n                        <span class=\"text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-2-2-2\" data-name=\"service reference number\">\n                            REP-1048\n                        </span>\n                    </div>\n                </section>\n                <div class=\"mt-6 grid grid-cols-[minmax(0,1fr)_minmax(0,0.92fr)] gap-7\" data-kid=\"2-1-3-2-3\" data-name=\"two column service form\">\n                    <section aria-labelledby=\"reception-heading\" data-kid=\"2-1-3-2-3-1\" data-name=\"vehicle reception section\">\n                        <div class=\"mb-4 flex items-end justify-between border-b border-[#CBD5E1] pb-3\" data-kid=\"2-1-3-2-3-1-5\" data-name=\"reception header\">\n                            <div data-kid=\"2-1-3-2-3-1-5-1\" data-name=\"reception title container\">\n                                <h2 class=\"font-heading text-[19px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-1-3-2-3-1-5-1-1\" data-name=\"reception heading\" id=\"reception-heading\">\n                                    Recepción del vehículo\n                                </h2>\n                                <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-5-1-2\" data-name=\"reception description\">\n                                    Registra la entrada y las condiciones observadas.\n                                </p>\n                            </div>\n                            <span class=\"text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-3-2-3-1-5-2\" data-name=\"reception step indicator\">\n                                01 / 02\n                            </span>\n                        </div>\n                        <div class=\"border-b border-[#E2E8F0] pb-5\" data-kid=\"2-1-3-2-3-1-1\" data-name=\"mileage field group\">\n                            <label class=\"mb-2 block text-[12px] font-semibold text-[#334155]\" data-kid=\"2-1-3-2-3-1-1-2\" data-name=\"mileage label\" for=\"km\">\n                                Kilometraje actual\n                            </label>\n                            <div class=\"flex min-h-12 items-center border border-[#EF4444] bg-white px-3\" data-kid=\"2-1-3-2-3-1-1-1\" data-name=\"mileage input container\">\n                                <i class=\"ti ti-gauge\" data-kid=\"2-1-3-2-3-1-1-1-1\" data-name=\"gauge icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                                </i>\n                                <input aria-describedby=\"km-error\" class=\"min-w-0 flex-1 border-0 bg-transparent px-3 text-[18px] font-bold tabular-nums text-[#0F172A] outline-hidden\" data-kid=\"2-1-3-2-3-1-1-1-2\" data-name=\"mileage input field\" id=\"km\" value=\"48,100\"/>\n                                <span class=\"text-[12px] font-bold text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1-1-3\" data-name=\"unit label\">\n                                    KM\n                                </span>\n                            </div>\n                            <p class=\"mt-1 flex items-center gap-1 text-[11px] font-semibold text-[#B91C1C]\" data-kid=\"2-1-3-2-3-1-1-4\" data-name=\"mileage error message\" id=\"km-error\">\n                                <i class=\"ti ti-alert-circle\" data-kid=\"2-1-3-2-3-1-1-4-1\" data-name=\"alert icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center;color:#B91C1C\">\n                                </i>\n                                Debe ser mayor o igual a 48,260 km.\n                            </p>\n                        </div>\n                        <div class=\"border-b border-[#E2E8F0] py-5\" data-kid=\"2-1-3-2-3-1-2\" data-name=\"observations field group\">\n                            <label class=\"mb-2 block text-[12px] font-semibold text-[#334155]\" data-kid=\"2-1-3-2-3-1-2-1\" data-name=\"observations label\" for=\"notes\">\n                                Observaciones\n                            </label>\n                            <textarea class=\"h-20 w-full resize-none border border-[#CBD5E1] bg-white p-3 text-[13px] text-[#0F172A] outline-hidden\" data-kid=\"2-1-3-2-3-1-2-2\" data-name=\"observations textarea\" id=\"notes\" placeholder=\"Detalles del trabajo realizado...\"></textarea>\n                            <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-2-3\" data-name=\"observations hint\">\n                                Visible para el propietario en el historial.\n                            </p>\n                        </div>\n                        <div cl