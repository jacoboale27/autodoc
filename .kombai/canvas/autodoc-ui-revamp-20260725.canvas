-2-3-4-4\" data-name=\"status label\">\n                            <i class=\"ti ti-clock text-[15px]\" data-kid=\"2-1-3-2-3-4-4-1\" data-name=\"status icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Pendiente\n                        </span>\n                        <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-4-5\" data-name=\"last access time\">\n                            Invitación enviada · 13 ago\n                        </span>\n                        <button aria-label=\"Acciones para Carlos López\" class=\"ml-auto flex h-12 w-12 items-center justify-center text-[17px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-4-1\" data-name=\"actions menu button\">\n                            <i class=\"ti ti-dots\" data-kid=\"2-1-3-2-3-4-1-1\" data-name=\"dots icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </section>\n                <div class=\"flex flex-wrap items-center justify-between gap-4 border-b border-[#334155] px-4 py-4\" data-kid=\"2-1-3-2-4\" data-name=\"Employees pagination\">\n                    <span class=\"text-[12px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-4-3\" data-name=\"pagination summary text\" data-reason=\"updated via data sync\">\n                        Mostrando 1–3 de 3 empleados\n                    </span>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-4-4\" data-name=\"pagination controls\">\n                        <button class=\"flex min-h-12 items-center gap-2 border border-[#334155] px-3 text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-3-2-4-1\" data-name=\"previous page button\" disabled=\"\">\n                            <i class=\"ti ti-chevron-left text-[14px]\" data-kid=\"2-1-3-2-4-1-1\" data-name=\"chevron left icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Anterior\n                        </button>\n                        <span class=\"flex h-12 min-w-12 items-center justify-center bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-2-4-4-2\" data-name=\"active page indicator\">\n                            1\n                        </span>\n                        <button aria-label=\"Siguiente página\" class=\"flex min-h-12 items-center gap-2 border border-[#475569] px-3 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-2\" data-name=\"next page button\">\n                            Siguiente\n                            <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-1-3-2-4-2-1\" data-name=\"chevron right icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <p class=\"mt-5 flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-5\" data-name=\"Employees helper\">\n                    <i class=\"ti ti-info-circle text-[15px] text-[#38BDF8]\" data-kid=\"2-1-3-2-5-1\" data-name=\"info circle icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Las cuentas activas pueden operar el panel según el rol asignado.\n                </p>\n                <footer class=\"mt-8 flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-6\" data-name=\"Employees footer\">\n                    <span data-kid=\"2-1-3-2-6-1\" data-name=\"footer brand text\">\n                        AutoDoc · Gestión operativa del taller\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-6-2\" data-name=\"footer status container\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-6-2-1\" data-name=\"footer status indicator\">\n                        </span>\n                        Datos sincronizados hace 4 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
