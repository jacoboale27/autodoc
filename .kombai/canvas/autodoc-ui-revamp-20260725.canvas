      "themeId": null,
      "rect": {
        "x": 12510,
        "y": 0,
        "w": 375,
        "h": 484
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .safe-bottom { padding-bottom: max(12px, env(safe-area-inset-bottom)); }\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js\">\n</script>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mechanic mobile dashboard page\">\n    <header class=\"sticky top-0 z-20 flex min-h-[64px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"mobile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[16px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo initials\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-4\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2\" data-name=\"workshop context label\">\n                    Taller\n                </p>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-3\" data-name=\"workshop context name\">\n                    <span class=\"size-2 shrink-0 rounded-full bg-[#10B981]\" data-kid=\"2-1-1-3-1\" data-name=\"operation status dot\">\n                    </span>\n                    <span class=\"truncate font-heading text-[14px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-1-1-3-2\" data-name=\"workshop name\">\n                        Taller Rápido\n                    </span>\n                    <span class=\"text-[12px] text-[#CBD5E1]\" data-kid=\"2-1-1-3-4\">\n                        /\n                    </span>\n                    <span class=\"truncate text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-3-3\" data-name=\"current screen name\">\n                        Panel\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header actions\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid min-h-[44px] min-w-[44px] place-items-center rounded-full border border-[#CBD5E1]/40 bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"absolute right-[10px] top-[9px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\" data-name=\"notification indicator dot\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid min-h-[44px] min-w-[44px] place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-2\" data-name=\"theme toggle button\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-2-2-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n            </button>\n            <div class=\"ml-1 grid size-9 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3\" data-name=\"user initials avatar\">\n                MR\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[520px] px-4 pb-32 pt-6\" data-kid=\"2-2\" data-name=\"mobile dashboard body\" id=\"panel\">\n        <div class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"mobile page heading\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-1-4\">\n                <div class=\"min-w-0\" data-kid=\"2-2-1-4-1\">\n                    <h1 class=\"font-heading text-[28px] font-extrabold leading-tight tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-1\" data-name=\"page heading text\">\n                        Panel del taller\n                    </h1>\n                    <p class=\"mt-2 text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-2\" data-name=\"page description text\">\n                        Una vista clara de las reparaciones que mueven tu día.\n                    </p>\n                </div>\n            </div>\n            <button class=\"mt-5 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#47256F] px-4 py-3 text-[13px] font-semibold text-white shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.1)] active:scale-[0.97]\" data-kid=\"2-2-1-3\" data-name=\"new repair button\">\n                <i class=\"ti ti-plus\" data-kid=\"2-2-1-3-1\" data-name=\"plus icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF\">\n                </i>\n                Nueva reparación\n            </button>\n        </div>\n        <section aria-labelledby=\"scoreboard-heading\" data-kid=\"2-2-2\" data-name=\"operations scoreboard\" id=\"reparaciones\">\n            <div class=\"mb-3 flex items-start justify-between gap-3\" data-kid=\"2-2-2-1\" data-name=\"scoreboard header\">\n                <div data-kid=\"2-2-2-1-4\">\n                    <h2 class=\"font-heading text-[19px] font-bold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-2-1-1\" data-name=\"scoreboard title\" id=\"scoreboard-heading\">\n                        Ritmo de operación\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-2-2-1-2\" data-name=\"scoreboard update time\">\n                        Datos del taller actualizados hace 8 min\n                    </p>\n                </div>\n                <span class=\"inline-flex shrink-0 items-center gap-2 pt-1 text-right text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-2-2-1-3\" data-name=\"operation status indicator\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-2-2-1-3-1\">\n                    </span>\n                    Estable\n                </span>\n            </div>\n            <div class=\"grid grid-cols-2 overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] shadow-[0_2px_4px_rgba(0,0,0,0.05)]\" data-kid=\"2-2-2-2\" data-name=\"mobile scoreboard grid container\">\n                <div class=\"border-b border-r border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-2-1\" data-name=\"services today stat container\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-2-2-1-1\">\n                        Servicios hoy\n                    </p>\n                    <strong class=\"mt-2 block font-heading text-[26px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-2-2-2-1-2\">\n                        12\n                    </strong>\n                    <p class=\"mt-1 text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-2-2-2-1-3\">\n                        +3 vs. ayer\n                    </p>\n                </div>\n                <div class=\"border-b border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-2-2\" data-name=\"in progress stat container\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-2-2-2-1\">\n                        En curso\n                    </p>\n                    <strong class=\"mt-2 block font-heading text-[26px] font-bold tabular-nums text-[#1E88E5]\" data-kid=\"2-2-2-2-2-2\">\n                        4\n                    </strong>\n                    <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-2-3\">\n                        2 entregas hoy\n                    </p>\n                </div>\n                <div class=\"border-b border-r border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-2-3\" data-name=\"pending stat container\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-2-2-3-1\">\n                        Pendientes\n                    </p>\n                    <strong class=\"mt-2 block font-heading text-[26px] font-bold tabular-nums text-[#F59E0B]\" data-kid=\"2-2-2-2-3-2\">\n                        7\n                    </strong>\n                    <p class=\"mt-1 text-[11px] font-semibold text-[#B45309]\" data-kid=\"2-2-2-2-3-3\">\n                        3 requieren acción\n                    </p>\n                </div>\n                <div class=\"border-b border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-2-4\" data-name=\"monthly revenue stat container\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-2-2-4-1\">\n                        Ingresos del mes\n                    </p>\n                    <strong class=\"mt-2 block font-heading text-[22px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-2-2-2-4-2\">\n                        $8,420\n                    </strong>\n                    <p class=\"mt-1 text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-2-2-2-4-3\">\n                        +8.4% mensual\n                    </p>\n                </div>\n                <div class=\"border-r border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-2-5\" data-name=\"average time stat container\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-2-2-5-1\">\n                        Tiempo medio\n                    </p>\n                    <strong class=\"mt-2 block font-heading text-[19px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-2-2-2-5-2\">\n                        2 h 15 min\n                    </strong>\n                    <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-2-2-2-5-3\">\n                        objetivo 2 h\n                    </p>\n                </div>\n                <div class=\"px-4 py-4\" data-kid=\"2-2-2-2-6\" data-name=\"satisfaction stat container\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-2-2-6-1\">\n                        Satisfacción\n                    </p>\n                    <strong class=\"mt-2 block font-heading text-[26px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-2-2-2-6-2\">\n                        4.8\n                        <span class=\"text-[14px] text-[#64748B]\" data-kid=\"2-2-2-2-6-2-1\">\n                            /5\n                        </span>\n                    </strong>\n                    <p class=\"mt-1 text-[11px] font-semibold text-[#F59E0B]\" data-kid=\"2-2-2-2-6-3\">\n                        86 reseñas\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"income-heading\" class=\"mt-7 overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] px-4 py-5 shadow-[0_2px_4px_rgba(0,0,0,0.05)]\" data-kid=\"2-2-3\" data-name=\"income trend panel container\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-1\" data-name=\"income header\">\n                <div class=\"min-w-0\" data-kid=\"2-2-3-1-4\">\n                    <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.02em] text-[#0F172A]\" data-kid=\"2-2-3-1-1\" data-name=\"income title\" id=\"income-heading\">\n                        Ingresos últimos 7 días\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-2-3-1-2\" data-name=\"income description\">\n                        La línea muestra facturación registrada por día.\n                    </p>\n                </div>\n                <span class=\"shrink-0 font-heading text-[17px] font-bold tabular-nums text-[#1E88E5]\" data-kid=\"2-2-3-1-3\" data-name=\"income total value\">\n                    $2,184\n                </span>\n            </div>\n            <div class=\"mt-5 h-[190px] w-full\" data-kid=\"2-2-3-2\" data-name=\"mobile chart container\">\n                <canvas aria-label=\"Gráfica de ingresos últimos siete días\" data-dynamic=\"true\" data-kid=\"2-2-3-2-1\" data-name=\"income chart\" data-reason=\"rendered and initialized by Chart.js library\" id=\"mechanic-income-chart\">\n                </canvas>\n            </div>\n        </section>\n        <section aria-labelledby=\"active-repairs-heading\" class=\"mt-7 border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-4\" data-name=\"active repairs queue\">\n            <div class=\"flex items-center justify-between gap-3 border-b border-[#E2E8F0] px-4 py-5\" data-kid=\"2-2-4-1\" data-name=\"queue header\">\n                <div class=\"min-w-0\" data-kid=\"2-2-4-1-4\">\n                    <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.02em] text-[#0F172A]\" data-kid=\"2-2-4-1-1\" data-name=\"queue title\" id=\"active-repairs-heading\">\n                        Reparaciones activas\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-4-1-2\" data-name=\"queue description\">\n                        Cola priorizada del taller\n                    </p>\n                </div>\n                <span class=\"shrink-0 text-[12px] font-semibold text-[#1E88E5]\" data-kid=\"2-2-4-1-3\" data-name=\"active count badge\">\n                    4 abiertas\n                </span>\n            </div>\n            <div class=\"divide-y divide-[#E2E8F0]\" data-kid=\"2-2-4-2\" data-name=\"repairs list\">\n                <div class=\"px-4 py-4\" data-kid=\"2-2-4-2-1\" data-name=\"repair item 1\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-2-1-1\">\n                        <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-1-1-1\">\n                            Toyota Corolla\n                        </p>\n                        <span class=\"inline-flex shrink-0 items-center gap-1.5 text-right text-[11px] font-semibold text-[#1E88E5]\" data-kid=\"2-2-4-2-1-1-2\">\n                            <span class=\"size-1.5 rounded-full bg-[#1E88E5]\" data-kid=\"2-2-4-2-1-1-2-1\">\n                            </span>\n                            En curso\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-2-4-2-1-2\">\n                        P 482-916 · Cambio de aceite\n                    </p>\n                </div>\n                <div class=\"px-4 py-4\" data-kid=\"2-2-4-2-2\" data-name=\"repair item 2\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-2-2-1\">\n                        <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-2-1-1\">\n                            Mazda 3\n                        </p>\n                        <span class=\"inline-flex max-w-[150px] shrink-0 items-center gap-1.5 text-right text-[11px] font-semibold leading-4 text-[#B45309]\" data-kid=\"2-2-4-2-2-1-2\">\n                            <span class=\"size-1.5 shrink-0 rounded-full bg-[#F59E0B]\" data-kid=\"2-2-4-2-2-1-2-1\">\n                            </span>\n                            Esperando aprobación\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-2-4-2-2-2\">\n                        H 731-204 · Frenos\n                    </p>\n                </div>\n                <div class=\"px-4 py-4\" data-kid=\"2-2-4-2-3\" data-name=\"repair item 3\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-2-3-1\">\n                        <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-3-1-1\">\n                            Renault Duster\n                        </p>\n                        <span class=\"inline-flex shrink-0 items-center gap-1.5 text-right text-[11px] font-semibold text-[#B91C1C]\" data-kid=\"2-2-4-2-3-1-2\">\n                            <span class=\"size-1.5 rounded-full bg-[#EF4444]\" data-kid=\"2-2-4-2-3-1-2-1\">\n                            </span>\n                            Prioridad alta\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-2-4-2-3-2\">\n                        J 204-118 · Diagnóstico\n                    </p>\n                </div>\n            </div>\n            <button class=\"mx-4 my-4 flex min-h-[44px] items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-4-3\" data-name=\"view all repairs button\">\n                Ver reparaciones\n                <i class=\"ti ti-arrow-right\" data-kid=\"2-2-4-3-1\" data-name=\"arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                </i>\n            </button>\n        </section>\n        <section aria-labelledby=\"quick-heading\" class=\"mt-7 border-t border-[#CBD5E1] pt-6\" data-kid=\"2-2-5\" data-name=\"quick actions section\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-5-1\" data-name=\"quick actions header\">\n                <div class=\"min-w-0\" data-kid=\"2-2-5-1-4\">\n                    <h2 class=\"font-heading text-[19px] font-bold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-5-1-1\" data-name=\"quick actions title\" id=\"quick-heading\">\n                        Accesos rápidos\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-2-5-1-2\" data-name=\"quick actions description\">\n                        Herramientas para resolver la siguiente tarea sin salir del panel.\n                    </p>\n                </div>\n                <a class=\"flex min-h-[44px] shrink-0 items-center text-[11px] font-bold text-[#1E88E5]\" data-kid=\"2-2-5-1-3\" data-name=\"configure panel link\" href=\"#configuracion\">\n                    Configurar\n                </a>\n            </div>\n            <div class=\"mt-4 divide-y divide-[#E2E8F0] border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-5-2\" data-name=\"quick actions list\">\n                <a class=\"flex min-h-[56px] items-center gap-3 px-4 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-1\" data-name=\"quick action button 1\" href=\"#buscar\">\n                    <i class=\"ti ti-car-search text-[20px]\" data-kid=\"2-2-5-2-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                    </i>\n                    Buscar vehículo\n                    <i class=\"ti ti-arrow-up-right ml-auto text-[14px]\" data-kid=\"2-2-5-2-1-2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </a>\n                <a class=\"flex min-h-[56px] items-center gap-3 px-4 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-2\" data-name=\"quick action button 2\" href=\"#catalogo\">\n                    <i class=\"ti ti-list-details text-[20px]\" data-kid=\"2-2-5-2-2-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                    </i>\n                    Catálogo de servicios\n                    <i class=\"ti ti-arrow-up-right ml-auto text-[14px]\" data-kid=\"2-2-5-2-2-2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </a>\n                <a class=\"flex min-h-[56px] items-center gap-3 px-4 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-3\" data-name=\"quick action button 3\" href=\"#historial\">\n                    <i class=\"ti ti-history text-[20px]\" data-kid=\"2-2-5-2-3-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                    </i>\n                    Historial\n                    <i class=\"ti ti-arrow-up-right ml-auto text-[14px]\" data-kid=\"2-2-5-2-3-2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </a>\n            </div>\n        </section>\n        <p class=\"mt-7 pb-2 text-[11px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-6\" data-name=\"footer credits\">\n            AutoDoc · Gestión operativa del taller · Datos sincronizados hace 8 min\n        </p>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"safe-bottom fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[520px] grid-cols-4 gap-1\" data-kid=\"2-3-1\" data-name=\"bottom navigation items\">\n            <a aria-current=\"page\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 border-t-2 border-[#1E88E5] text-[#1E88E5]\" data-kid=\"2-3-1-1\" data-name=\"panel bottom navigation item\" href=\"#panel\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-1-2\">\n                    Panel\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 border-t-2 border-transparent text-[#64748B]\" data-kid=\"2-3-1-2\" data-name=\"repairs bottom navigation item\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-2-2\">\n                    Reparaciones\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 border-t-2 border-transparent text-[#64748B]\" data-kid=\"2-3-1-3\" data-name=\"search bottom navigation item\" href=\"#buscar\">\n                <i class=\"ti ti-car-search text-[19px]\" data-kid=\"2-3-1-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-3-2\">\n                    Buscar\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 border-t-2 border-transparent text-[#64748B]\" data-kid=\"2-3-1-4\" data-name=\"chat bottom navigation item\" href=\"#chat\">\n                <i class=\"ti ti-message-circle text-[19px]\" data-kid=\"2-3-1-4-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-4-2\">\n                    Chat\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n<script>\n    const chartCanvas = document.getElementById('mechanic-income-chart');\n  if (chartCanvas && window.Chart) {\n    new Chart(chartCanvas, {\n      type: 'line',\n      data: { labels: ['L', 'M', 'X', 'J', 'V', 'S', 'D'], datasets: [{ data: [210, 320, 280, 460, 390, 520, 490], borderColor: '#1E88E5', backgroundColor: 'rgba(30,136,229,0.10)', borderWidth: 3, pointBackgroundColor: '#10B981', pointBorderColor: '#FFFFFF', pointBorderWidth: 2, pointRadius: 3, fill: true, tension: 0.35 }] },\n      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { displayColors: false, callbacks: { label: (context) => '$' + context.parsed.y } } }, scales: { x: { grid: { display: false }, ticks: { color: '#64748B', font: { family: 'IBM Plex Sans', size: 11, weight: '600' } } }, y: { beginAtZero: true, grid: { color: '#E2E8F0' }, border: { display: false }, ticks: { color: '#64748B', font: { family: 'IBM Plex Sans', size: 9 }, maxTicksLimit: 4, callback: (value) => '$' + value } } } }\n    });\n  }\n</script>\n",
