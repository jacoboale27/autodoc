      },
      "html": "<style data-name=\"AppButton AppCard AppMotion tokens\">\n    button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"filter\"]):not([data-name*=\"export\"]):not([data-name*=\"show all\"]):not([data-name*=\"view vehicle alerts\"]) {\n    min-height: 48px;\n    border-radius: 999px !important;\n    transition: transform 150ms cubic-bezier(.23,1,.32,1), box-shadow 150ms ease-out, background-color 150ms ease-out, color 150ms ease-out;\n  }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"filter\"]):not([data-name*=\"export\"]):not([data-name*=\"show all\"]):not([data-name*=\"view vehicle alerts\"]):hover { transform: scale(1.02); }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"filter\"]):not([data-name*=\"export\"]):not([data-name*=\"show all\"]):not([data-name*=\"view vehicle alerts\"]):active { transform: scale(.97); }\n  [data-name=\"mobile notifications button\"], [data-name=\"mobile theme button\"], [data-name=\"mobile refresh alerts button\"] {\n    min-width: 44px !important;\n    min-height: 44px !important;\n    border-radius: 999px !important;\n    border: 1px solid #CBD5E1 !important;\n    background: #EEEDF0 !important;\n    box-shadow: 0 2px 4px rgba(15,23,42,.05) !important;\n  }\n  [data-name=\"resolve SOAT button\"], [data-name=\"schedule brakes button\"] {\n    border-radius: 999px !important;\n    min-height: 48px !important;\n    box-shadow: 0 2px 4px rgba(15,23,42,.05) !important;\n  }\n  [data-name=\"complete profile button\"] {\n    border-radius: 999px !important;\n    min-height: 48px !important;\n    background: linear-gradient(135deg,#522C81,#45256E) !important;\n    color: #FFFFFF !important;\n    box-shadow: 0 2px 4px rgba(15,23,42,.05) !important;\n  }\n  [data-name=\"mobile critical SOAT alert card\"], [data-name=\"mobile preventive brakes alert card\"], [data-name=\"mobile informational profile alert card\"] {\n    border-radius: 16px !important;\n    border: 1px solid #CBD5E1 !important;\n    background: #EEEDF0 !important;\n    box-shadow: 0 2px 4px rgba(15,23,42,.05) !important;\n    overflow: hidden;\n  }\n  [data-name=\"mobile critical SOAT alert card\"] { border-left: 4px solid #EF4444 !important; }\n  [data-name=\"mobile preventive brakes alert card\"] { border-left: 4px solid #F59E0B !important; }\n  [data-name=\"mobile informational profile alert card\"] { border-left: 4px solid #1E88E5 !important; }\n  a:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]) { transition: color 150ms ease-out; }\n  @media (prefers-reduced-motion: reduce) { button, a { transition: none !important; } }\n</style>\n<link data-kid=\"2\" data-name=\"icon stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen w-full overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"1\" data-name=\"mobile alerts page\">\n    <header class=\"sticky top-0 z-20 flex h-[72px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"1-1\" data-name=\"mobile alerts top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"1-1-1-1\" data-name=\"AutoDoc mobile logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"mobile breadcrumb/context container\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"1-1-1-2-1\" data-name=\"mobile role label\">\n                    Propietario\n                </p>\n                <p class=\"truncate font-heading text-[16px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"1-1-1-2-2\" data-name=\"mobile screen context\">\n                    Alertas\n                </p>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-1-2\" data-name=\"mobile top actions\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"1-1-2-1\" data-name=\"mobile notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"1-1-2-1-1\" data-name=\"notification bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-[9px] top-[8px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"1-1-2-1-2\" data-name=\"notification dot\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"1-1-2-2\" data-name=\"mobile theme button\">\n                <i class=\"ti ti-moon\" data-kid=\"1-1-2-2-1\" data-name=\"moon theme icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"1-1-2-3\" data-name=\"mobile user initials\">\n                JP\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[132px] pt-6\" data-kid=\"1-2\" data-name=\"mobile alerts content\">\n        <div class=\"mb-5\"