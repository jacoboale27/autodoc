      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .about-mobile-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .about-mobile-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"about-mobile-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"1\" data-name=\"about dark mobile page\">\n    <header class=\"sticky top-0 z-20 flex min-h-[64px] items-center gap-3 border-b border-[#334155] bg-[#0B1220]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"about mobile app bar\">\n        <button aria-label=\"Volver\" class=\"flex size-11 shrink-0 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-1-1\" data-name=\"back button\">\n            <i class=\"ti ti-arrow-left text-[18px]\" data-kid=\"1-1-1-1\" data-name=\"back icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n        </button>\n        <div class=\"min-w-0\" data-kid=\"1-1-2\" data-name=\"app bar text container\">\n            <h1 class=\"about-mobile-heading truncate text-[17px] font-bold tracking-[-0.035em] text-[#F8FAFC]\" data-kid=\"1-1-2-1\" data-name=\"about app bar title\">\n                Acerca de AutoDoc\n            </h1>\n            <p class=\"mt-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#64748B]\" data-kid=\"1-1-2-2\" data-name=\"about app bar eyebrow\">\n                Información del producto\n            </p>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[520px] px-4 pb-8 pt-8\" data-kid=\"1-2\" data-name=\"about mobile content\">\n        <section class=\"flex flex-col items-center text-center\" data-kid=\"1-2-1\" data-name=\"product identity section\">\n            <div class=\"flex size-[92px] items-center justify-center rounded-full border border-[#81E6D9]/30 bg-[#141E36] text-[#81E6D9] shadow-[0_8px_24px_rgba(2,6,23,0.28)]\" data-kid=\"1-2-1-1\" data-name=\"vehicle identity icon container\">\n                <i aria-label=\"AutoDoc\" class=\"ti ti-car text-[46px]\" data-kid=\"1-2-1-1-1\" data-name=\"vehicle identity icon\" style=\"width:46px;height:46px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <h2 class=\"about-mobile-heading mt-6 text-[27px] font-extrabold tracking-[-0.05em] text-[#F8FAFC]\" data-kid=\"1-2-1-2\" data-name=\"product name\">\n                AutoDoc\n            </h2>\n            <p class=\"mt-2 max-w-[300px] text-[14px] leading-5 text-[#CBD5E1]\" data-kid=\"1-2-1-3\" data-name=\"product tagline\">\n                Tu copiloto digital para el cuidado del vehículo\n            </p>\n        </section>\n        <section class=\"mt-8 overflow-hidden rounded-[16px] border border-[#334155] bg-[#141E36] shadow-[0_2px_4px_rgba(2,6,23,0.2)]\" data-kid=\"1-2-2\" data-name=\"about information card\">\n            <div class=\"flex min-h-[68px] items-center gap-3 border-b border-[#334155] px-4 py-3\" data-kid=\"1-2-2-1\" data-name=\"version information row\">\n                <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#81E6D9]/[0.10] text-[#81E6D9]\" data-kid=\"1-2-2-1-1\" data-name=\"version icon container\">\n                    <i class=\"ti ti-info-circle text-[19px]\" data-kid=\"1-2-2-1-1-1\" data-name=\"version icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <span class=\"flex-1 text-[15px] font-semibold text-[#F8FAFC]\" data-kid=\"1-2-2-1-2\" data-name=\"version title\">\n                    Versión\n                </span>\n                <span class=\"text-[14px] font-medium text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-3\" data-name=\"version value\" data-reason=\"version string expected to be fetched or updated by system\">\n                    —\n                </span>\n            </div>\n            <button class=\"flex min-h-[68px] w-full items-center gap-3 border-b border-[#334155] px-4 py-3 text-left\" data-kid=\"1-2-2-2\" data-name=\"technical support row\">\n                <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#81E6D9]/[0.10] text-[#81E6D9]\" data-kid=\"1-2-2-2-1\" data-name=\"support icon container\">\n                    <i class=\"ti ti-mail text-[19px]\" data-kid=\"1-2-2-2-1-1\" data-name=\"support icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <span class=\"flex-1 text-[15px] font-semibold text-[#F8FAFC]\" data-kid=\"1-2-2-2-2\" data-name=\"support title\">\n                    Soporte Técnico\n                </span>\n                <i class=\"ti ti-arrow-up-right text-[18px] text-[#94A3B8]\" data-kid=\"1-2-2-2-3\" data-name=\"support arrow icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button class=\"flex min-h-[68px] w-full items-center gap-3 border-b border-[#334155] px-4 py-3 text-left\" data-kid=\"1-2-2-3\" data-name=\"privacy policy row\">\n                <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#81E6D9]/[0.10] text-[#81E6D9]\" data-kid=\"1-2-2-3-1\" data-name=\"privacy icon container\">\n                    <i class=\"ti ti-shield-lock text-[19px]\" data-kid=\"1-2-2-3-1-1\" data-name=\"privacy icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <span class=\"flex-1 text-[15px] font-semibold text-[#F8FAFC]\" data-kid=\"1-2-2-3-2\" data-name=\"privacy title\">\n                    Política de Privacidad\n                </span>\n                <i class=\"ti ti-arrow-up-right text-[18px] text-[#94A3B8]\" data-kid=\"1-2-2-3-3\" data-name=\"privacy arrow icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button class=\"flex min-h-[68px] w-full items-center gap-3 px-4 py-3 text-left\" data-kid=\"1-2-2-4\" data-name=\"terms row\">\n                <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#81E6D9]/[0.10] text-[#81E6D9]\" data-kid=\"1-2-2-4-1\" data-name=\"terms icon container\">\n                    <i class=\"ti ti-gavel text-[19px]\" data-kid=\"1-2-2-4-1-1\" data-name=\"terms icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <span class=\"flex-1 text-[15px] font-semibold text-[#F8FAFC]\" data-kid=\"1-2-2-4-2\" data-name=\"terms title\">\n                    Términos y Condiciones\n                </span>\n                <i class=\"ti ti-arrow-up-right text-[18px] text-[#94A3B8]\" data-kid=\"1-2-2-4-3\" data-name=\"terms arrow icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </section>\n        <footer class=\"mt-8 border-t border-[#334155] pt-5 text-center text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"1-2-3\" data-name=\"about copyright footer\">\n            <p data-kid=\"1-2-3-1\" data-name=\"copyright line one\">\n                © 2026 AutoDoc Inc.\n            </p>\n            <p data-kid=\"1-2-3-2\" data-name=\"copyright line two\">\n                Todos los derechos reservados.\n            </p>\n        </footer>\n    </main>\n</div>\n",
