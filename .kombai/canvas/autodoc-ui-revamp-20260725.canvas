      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"profile page root\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"profile shell layout\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"profile primary rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary rail navigation\">\n                <button aria-label=\"Inicio\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"home rail button\">\n                    <i class=\"ti ti-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Mi garaje\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"garage rail button\">\n                    <i class=\"ti ti-car\" data-kid=\"2-1-1-2-2-1\" data-name=\"car icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"workshops rail button\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-3-1\" data-name=\"tool icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Alertas\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-4\" data-name=\"alerts rail button\">\n                    <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-1-2-4-1\" data-name=\"alert triangle icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Mi perfil\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-5\" data-name=\"profile active rail button\">\n                    <i class=\"ti ti-user\" data-kid=\"2-1-1-2-5-1\" data-name=\"user icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </nav>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"utility rail navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help rail button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help circle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings rail button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"profile contextual sidebar\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"account header\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"space label\">\n                    Espacio personal\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"role status row\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"online status dot\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"role label\">\n                        Propietario\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación de propietario\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"owner navigation\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-1\" data-name=\"inicio link\" href=\"#inicio\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-1-1\">\n                        <i class=\"ti ti-dashboard\" data-kid=\"2-1-2-2-1-1-1\" data-name=\"dashboard icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Inicio\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-2\" data-name=\"garage link\" href=\"#garaje\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-2-1\">\n                        <i class=\"ti ti-car\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"car icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Mi garaje\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-3\" data-name=\"workshops link\" href=\"#talleres\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-3-1\">\n                        <i class=\"ti ti-tool\" data-kid=\"2-1-2-2-3-1-1\" data-name=\"tool icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Talleres\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-4\" data-name=\"alerts link\" href=\"#alertas\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-4-1\">\n                        <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-2-2-4-1-1\" data-name=\"alert triangle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Alertas\n                    <span class=\"ml-auto text-[11px] font-bold text-[#EF4444]\" data-kid=\"2-1-2-2-4-2\" data-name=\"alerts count\">\n                        1\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-5\" data-name=\"history link\" href=\"#historial\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-5-1\">\n                        <i class=\"ti ti-history\" data-kid=\"2-1-2-2-5-1-1\" data-name=\"history icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Historial\n                </a>\n            </nav>\n            <div class=\"mt-8 border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"profile secondary navigation\">\n                <p class=\"mb-3 px-3 text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-3-1\" data-name=\"account tools label\">\n                    Cuenta\n                </p>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-2.5 text-[14px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-3-2\" data-name=\"active profile link\" href=\"#perfil\">\n                    <i class=\"ti ti-user-circle text-[17px]\" data-kid=\"2-1-2-3-2-1\" data-name=\"user circle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Mi perfil\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-3-3\" data-name=\"security link\" href=\"#seguridad\">\n                    <i class=\"ti ti-shield-check text-[17px]\" data-kid=\"2-1-2-3-3-1\" data-name=\"shield check icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Seguridad\n                </a>\n            </div>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-4\" data-name=\"sidebar user summary\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-4-1\" data-name=\"sidebar user details\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-4-1-1\" data-name=\"sidebar initials\">\n                        JP\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-4-1-2\">\n                        <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-4-1-2-1\">\n                            Juan Pérez\n                        </p>\n                        <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-2-4-1-2-2\">\n                            Cuenta personal\n                        </p>\n                    </div>\n                    <i class=\"ti ti-chevron-down ml-auto text-[16px] text-[#94A3B8]\" data-kid=\"2-1-2-4-1-3\" data-name=\"chevron down icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"2-1-3\" data-name=\"profile main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-white px-8\" data-kid=\"2-1-3-1\" data-name=\"profile top bar\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"2-1-3-1-1\" data-name=\"profile breadcrumb\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-1-3-1-1-1\">\n                        Propietario\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-3-1-1-2\">\n                        /\n                    </span>\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-1-3\">\n                        Mi perfil\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-1-2\" data-name=\"profile top actions\">\n                    <span class=\"hidden text-[12px] text-[#64748B] lg:block\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1\" data-name=\"current date text\" data-reason=\"text set by client-side date injection\">\n                        Sábado, 15 ago 2026\n                    </span>\n                    <button aria-label=\"Notificaciones\" class=\"relative grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-2\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-2-2-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-[7px] top-[6px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-3-1-2-2-2\" data-name=\"notification status dot\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-3\" data-name=\"toggle dark mode button\">\n                        <i class=\"ti ti-moon\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <div class=\"h-6 w-px bg-[#E2E8F0]\" data-kid=\"2-1-3-1-2-4\">\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-1-2-5\" data-name=\"top bar user info\">\n                        <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-1-2-5-1\" data-name=\"top bar user initials\">\n                            JP\n                        </div>\n                        <span class=\"hidden text-[13px] font-semibold text-[#0F172A] xl:block\" data-kid=\"2-1-3-1-2-5-2\">\n                            Juan Pérez\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[960px] px-8 py-7\" data-kid=\"2-1-3-2\" data-name=\"profile content wrapper\">\n                <div class=\"mb-6 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"profile page heading\">\n                    <div data-kid=\"2-1-3-2-1-4\">\n                        <h1 class=\"font-heading text-[30px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-1-3-2-1-1\">\n                            Mi perfil\n                        </h1>\n                        <p class=\"mt-2 text-[14px] text-[#475569]\" data-kid=\"2-1-3-2-1-2\">\n                            Mantén tus datos y preferencias al día.\n                        </p>\n                    </div>\n                    <span class=\"text-[12px] font-semibold text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-1-3\" data-name=\"last updated timestamp\" data-reason=\"text set by client-side time injection\">\n                        Última actualización: hoy\n                    </span>\n                </div>\n                <section class=\"flex items-center justify-between gap-6 rounded-[16px] border border-[#CBD5E1] bg-white px-6 py-5 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-1-3-2-2\" data-name=\"editorial profile header card\">\n                    <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"2-1-3-2-2-1\">\n                        <div class=\"grid size-[72px] shrink-0 place-items-center rounded-full border-4 border-[#E8F2FD] bg-[#DBEAFE] font-heading text-[22px] font-extrabold text-[#1E88E5]\" data-kid=\"2-1-3-2-2-1-1\" data-name=\"profile avatar initials\">\n                            JP\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-1-3-2-2-1-3\">\n                            <h2 class=\"font-heading text-[20px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-1-3-2-2-1-3-1\">\n                                Juan Pérez\n                            </h2>\n                            <p class=\"mt-1 text-[13px] text-[#64748B]\" data-kid=\"2-1-3-2-2-1-3-2\">\n                                Cuenta personal\n                            </p>\n                            <div class=\"mt-2 flex items-center gap-2 text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-2-1-3-3\">\n                                <i class=\"ti ti-circle-check-filled\" data-kid=\"2-1-3-2-2-1-2\" data-name=\"circle check icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Perfil completo 80%\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex shrink-0 flex-col items-end gap-2\" data-kid=\"2-1-3-2-2-2\">\n                        <div class=\"h-2 w-40 overflow-hidden rounded-full bg-[#E2E8F0]\" data-kid=\"2-1-3-2-2-2-2\">\n                            <div class=\"h-full w-4/5 rounded-full bg-[#10B981]\" data-kid=\"2-1-3-2-2-2-2-1\" data-name=\"completion progress bar fill\">\n                            </div>\n                        </div>\n                        <button class=\"inline-flex min-h-12 items-center gap-2 text-[12px] font-bold text-[#1E88E5] hover:text-[#176FBB]\" data-kid=\"2-1-3-2-2-2-1\">\n                            <i class=\"ti ti-camera-plus text-[16px]\" data-kid=\"2-1-3-2-2-2-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Cambiar foto\n                        </button>\n                    </div>\n                </section>\n                <form class=\"mt-6 max-w-[760px]\" data-kid=\"2-1-3-2-3\" data-name=\"profile form\">\n                    <section class=\"border-t border-[#CBD5E1] pt-5\" data-kid=\"2-1-3-2-3-1\" data-name=\"personal data section\">\n                        <div class=\"mb-4 flex items-end justify-between\" data-kid=\"2-1-3-2-3-1-2\">\n                            <div data-kid=\"2-1-3-2-3-1-2-1\">\n                                <h2 class=\"font-heading text-[17px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-3-1-2-1-1\">\n                                    Datos personales\n                                </h2>\n                                <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-2-1-2\">\n                                    Información básica para tu cuenta.\n                                </p>\n                            </div>\n                            <span class=\"text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-3-1-2-2\">\n                                <i class=\"ti ti-check\" data-kid=\"2-1-3-2-3-1-2-2-1\" data-name=\"check icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Verificado\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-x-5 gap-y-4\" data-kid=\"2-1-3-2-3-1-1\" data-name=\"personal fields\">\n                            <label class=\"block\" data-kid=\"2-1-3-2-3-1-1-1\">\n                                <span class=\"mb-2 block text-[12px] font-semibold text-[#334155]\" data-kid=\"2-1-3-2-3-1-1-1-1\">\n                                    Nombre completo\n                                </span>\n                                <div class=\"flex min-h-12 items-center gap-3 border border-[#CBD5E1] bg-white px-3\" data-kid=\"2-1-3-2-3-1-1-1-2\">\n                                    <i class=\"ti ti-user text-[17px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1-1-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <span class=\"text-[14px] font-medium text-[#0F172A]\" data-kid=\"2-1-3-2-3-1-1-1-2-2\">\n                                        Juan Pérez\n                                    </span>\n                                    <i class=\"ti ti-circle-check-filled ml-auto text-[16px] text-[#10B981]\" data-kid=\"2-1-3-2-3-1-1-1-2-3\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </div>\n                                <span class=\"mt-1.5 block text-[11px] font-medium text-[#10B981]\" data-kid=\"2-1-3-2-3-1-1-1-3\">\n                                    Formato válido\n                                </span>\n                            </label>\n                            <label class=\"block\" data-kid=\"2-1-3-2-3-1-1-2\">\n                                <span class=\"mb-2 block text-[12px] font-semibold text-[#334155]\" data-kid=\"2-1-3-2-3-1-1-2-1\">\n                                    Correo electrónico\n                                </span>\n                                <div class=\"flex min-h-12 items-center gap-3 border border-[#CBD5E1] bg-[#F8FAFC] px-3\" data-kid=\"2-1-3-2-3-1-1-2-2\">\n                                    <i class=\"ti ti-mail text-[17px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1-2-2-1\" data-name=\"mail icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <span class=\"truncate text-[14px] font-medium text-[#0F172A]\" data-kid=\"2-1-3-2-3-1-1-2-2-2\">\n                                        juan.perez@email.com\n                                    </span>\n                                    <i class=\"ti ti-lock-check ml-auto text-[16px] text-[#10B981]\" data-kid=\"2-1-3-2-3-1-1-2-2-3\" data-name=\"lock check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </div>\n                                <span class=\"mt-1.5 block text-[11px] font-medium text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1-2-3\">\n                                    Correo verificado\n                                </span>\n                            </label>\n                            <label class=\"col-span-2 block\" data-kid=\"2-1-3-2-3-1-1-3\">\n                                <span class=\"mb-2 block text-[12px] font-semibold text-[#334155]\" data-kid=\"2-1-3-2-3-1-1-3-1\">\n                                    Teléfono\n                                </span>\n                                <div class=\"flex min-h-12 items-center gap-3 border border-[#CBD5E1] bg-white px-3\" data-kid=\"2-1-3-2-3-1-1-3-2\">\n                                    <i class=\"ti ti-phone text-[17px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1-3-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <span class=\"text-[14px] font-medium text-[#0F172A]\" data-kid=\"2-1-3-2-3-1-1-3-2-2\">\n                                        +57 315 482 9160\n                                    </span>\n                                </div>\n                            </label>\n                        </div>\n                    </section>\n                    <section class=\"mt-7 border-t border-[#CBD5E1] pt-5\" data-kid=\"2-1-3-2-3-2\" data-name=\"preferences section\">\n                        <div class=\"mb-4\" data-kid=\"2-1-3-2-3-2-2\">\n                            <h2 class=\"font-heading text-[17px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-2-1\">\n                                Preferencias\n                            </h2>\n                            <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2-2\">\n                                Personaliza cómo recibes la información de AutoDoc.\n                            </p>\n                        </div>\n                        <div class=\"divide-y divide-[#E2E8F0] border-y border-[#E2E8F0] bg-white\" data-kid=\"2-1-3-2-3-2-1\" data-name=\"preferences rows\">\n                            <div class=\"flex min-h-[64px] items-center justify-between gap-4 px-4\" data-kid=\"2-1-3-2-3-2-1-1\">\n                                <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-3-2-1-1-1\">\n                                    <i class=\"ti ti-language text-[19px] text-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-1-1-1-1\" data-name=\"language icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <div data-kid=\"2-1-3-2-3-2-1-1-1-2\">\n                                        <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-1-1-1-2-1\">\n                                            Idioma\n                                        </p>\n                                        <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-1-1-2-2\">\n                                            Español\n                                        </p>\n                                    </div>\n                                </div>\n                                <button class=\"inline-flex min-h-12 items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-1-1-2\" type=\"button\">\n                                    <span data-kid=\"2-1-3-2-3-2-1-1-2-1\">\n                                        Español\n                                    </span>\n                                    <i class=\"ti ti-chevron-down text-[15px]\" data-kid=\"2-1-3-2-3-2-1-1-2-2\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </button>\n                            </div>\n                            <div class=\"flex min-h-[64px] items-center justify-between gap-4 px-4\" data-kid=\"2-1-3-2-3-2-1-2\">\n                                <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-3-2-1-2-1\">\n                                    <i class=\"ti ti-sun text-[19px] text-[#F59E0B]\" data-kid=\"2-1-3-2-3-2-1-2-1-1\" data-name=\"appearance icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <div data-kid=\"2-1-3-2-3-2-1-2-1-2\">\n                                        <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-1-2-1-2-1\">\n                                            Apariencia\n                                        </p>\n                                        <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-2-1-2-2\">\n                                            Modo claro\n                                        </p>\n                                    </div>\n                                </div>\n                                <button class=\"inline-flex min-h-12 items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-1-2-2\" type=\"button\">\n                                    <span data-kid=\"2-1-3-2-3-2-1-2-2-1\">\n                                        Claro\n                                    </span>\n                                    <i class=\"ti ti-chevron-down text-[15px]\" data-kid=\"2-1-3-2-3-2-1-2-2-2\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </button>\n                            </div>\n                            <div class=\"flex min-h-[64px] items-center justify-between gap-4 px-4\" data-kid=\"2-1-3-2-3-2-1-3\">\n                                <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-3-2-1-3-1\">\n                                    <i class=\"ti ti-bell-ringing text-[19px] text-[#10B981]\" data-kid=\"2-1-3-2-3-2-1-3-1-1\" data-name=\"notifications bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <div data-kid=\"2-1-3-2-3-2-1-3-1-2\">\n                                        <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-1-3-1-2-1\">\n                                            Notificaciones\n                                        </p>\n                                        <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-3-1-2-2\">\n                                            Alertas de mantenimiento activadas\n                                        </p>\n                                    </div>\n                                </div>\n                                <div aria-checked=\"true\" aria-label=\"Notificaciones activadas\" class=\"flex h-7 w-12 items-center rounded-full bg-[#1E88E5] p-1\" data-kid=\"2-1-3-2-3-2-1-3-2\" data-name=\"notifications toggle switch\" role=\"switch\">\n                                    <span class=\"ml-auto size-5 rounded-full bg-white shadow-sm\" data-kid=\"2-1-3-2-3-2-1-3-2-1\">\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                    <section class=\"mt-7 border-t border-[#CBD5E1] pt-5\" data-kid=\"2-1-3-2-3-3\" data-name=\"role section\">\n                        <div class=\"mb-4\" data-kid=\"2-1-3-2-3-3-2\">\n                            <h2 class=\"font-heading text-[17px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-3-3-2-1\">\n                                Rol de cuenta\n                            </h2>\n                            <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-3-2-2\">\n                                Define qué herramientas aparecen en tu espacio.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-5 border border-[#1E88E5] bg-[#E8F2FD] px-4 py-4\" data-kid=\"2-1-3-2-3-3-1\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-3-3-1-1\">\n                                <div class=\"grid size-10 place-items-center rounded-full bg-white text-[#1E88E5]\" data-kid=\"2-1-3-2-3-3-1-1-1\">\n                                    <i class=\"ti ti-user-check text-[19px]\" data-kid=\"2-1-3-2-3-3-1-1-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </div>\n                                <div data-kid=\"2-1-3-2-3-3-1-1-2\">\n                                    <p class=\"text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-3-3-1-1-2-1\">\n                                        Propietario\n                                    </p>\n                                    <p class=\"mt-1 text-[12px] text-[#475569]\" data-kid=\"2-1-3-2-3-3-1-1-2-2\">\n                                        Puedes gestionar tus vehículos y servicios.\n                                    </p>\n                                </div>\n                            </div>\n                            <span class=\"inline-flex items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-3-3-1-2\">\n                                <i class=\"ti ti-circle-check-filled text-[17px]\" data-kid=\"2-1-3-2-3-3-1-2-1\" data-name=\"check icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Seleccionado\n                            </span>\n                        </div>\n                    </section>\n                    <div class=\"mt-7 flex items-center justify-between gap-4 border-t border-[#CBD5E1] pt-5\" data-kid=\"2-1-3-2-3-4\" data-name=\"profile form actions\">\n                        <p class=\"flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-4-1\">\n                            <i class=\"ti ti-shield-lock text-[16px] text-[#10B981]\" data-kid=\"2-1-3-2-3-4-1-1\" data-name=\"shield lock icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Tus datos se almacenan de forma segura.\n                        </p>\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-3-4-2\">\n                            <button class=\"min-h-12 border border-[#CBD5E1] bg-white px-5 text-[13px] font-semibold text-[#334155] hover:border-[#1E88E5]\" data-kid=\"2-1-3-2-3-4-2-1\" type=\"button\">\n                                Cancelar\n                            </button>\n                            <button class=\"inline-flex min-h-12 items-center gap-2 bg-[#1E88E5] px-5 text-[13px] font-bold text-white hover:bg-[#176FBB]\" data-kid=\"2-1-3-2-3-4-2-2\" type=\"submit\">\n                                Guardar cambios\n                                <i class=\"ti ti-check text-[16px]\" data-kid=\"2-1-3-2-3-4-2-2-1\" data-name=\"check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </form>\n            </div>\n        </main>\n    </div>\n</div>\n",
