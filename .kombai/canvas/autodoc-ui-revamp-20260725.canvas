        "x": 122430,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .seed-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .seed-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"seed-body min-h-screen bg-[var(--surface)] text-[var(--text-primary)] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"--surface:#F7F6F8;--surface-container:#EEEDF0;--surface-variant:#E2E8F0;--outline:#CBD5E1;--outline-strong:#94A3B8;--primary:#522C81;--success:#2F855A;--text-primary:#0F172A;--text-secondary:#5B6B80;--on-primary:#FFFFFF\">\n    <header class=\"flex h-[72px] items-center justify-center border-b border-[var(--outline)] bg-[var(--surface-container)] px-8\" data-kid=\"1-1\" data-name=\"standalone admin seed app bar\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"app bar title group\">\n            <span class=\"flex size-9 items-center justify-center rounded-[12px] bg-[var(--primary)] text-[var(--on-primary)] shadow-[0_2px_4px_rgba(15,23,42,0.08)]\" data-kid=\"1-1-1-1\" data-name=\"admin configuration icon\">\n                <i class=\"ti ti-shield-cog text-[18px]\" data-kid=\"1-1-1-1-1\" data-name=\"shield gear icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </span>\n            <h1 class=\"seed-heading text-[18px] font-bold tracking-[-0.03em] text-[var(--text-primary)]\" data-kid=\"1-1-1-2\" data-name=\"app bar title\">\n                Configuración de administradores\n            </h1>\n        </div>\n    </header>\n    <main class=\"mx-auto flex min-h-[calc(100vh-72px)] w-full max-w-[860px] flex-col items-center justify-center px-8 py-16\" data-kid=\"1-2\" data-name=\"standalone admin seed content\">\n        <section class=\"w-full max-w-[640px] rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-10 text-center shadow-[0_8px_24px_rgba(15,23,42,0.08)]\" data-kid=\"1-2-1\" data-name=\"migration completed status card\">\n            <div class=\"mx-auto flex size-[88px] items-center justify-center rounded-full border border-[var(--success)]/30 bg-[var(--success)]/10 text-[var(--success)]\" data-kid=\"1-2-1-1\" data-name=\"security success icon container\">\n                <i class=\"ti ti-shield-check text-[42px]\" data-kid=\"1-2-1-1-1\" data-name=\"security success icon\" style=\"width:42px;height:42px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <p class=\"mt-7 text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--success)]\" data-kid=\"1-2-1-2\" data-name=\"completion eyebrow\">\n                Estado de configuración\n            </p>\n            <h2 class=\"seed-heading mt-3 text-[30px] font-extrabold tracking-[-0.045em] text-[var(--text-primary)]\" data-kid=\"1-2-1-3\" data-name=\"migration completed heading\">\n                Migración Completada\n            </h2>\n            <p class=\"mx-auto mt-4 max-w-[520px] text-[16px] leading-7 text-[var(--text-secondary)]\" data-kid=\"1-2-1-4\" data-name=\"migration explanation\">\n                Las cuentas administrativas ya fueron configuradas y los secretos se eliminaron del código fuente por motivos de seguridad.\n            </p>\n            <div class=\"mt-8 flex items-center justify-center gap-2 border-t border-[var(--outline)] pt-6 text-[12px] font-semibold text-[var(--success)]\" data-kid=\"1-2-1-5\" data-name=\"secure completion note\">\n                <i class=\"ti ti-lock-check text-[16px]\" data-kid=\"1-2-1-5-1\" data-name=\"secure lock icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Configuración segura verificada\n            </div>\n        </section>\n        <aside class=\"mt-6 flex w-full max-w-[640px] items-start gap-3 rounded-[12px] border border-dashed border-[var(--outline-strong)] bg-transparent px-5 py-4 text-left\" data-kid=\"1-2-2\" data-name=\"release access denied alternate cue\">\n            <i class=\"ti ti-lock text-[19px] mt-0.5 shrink-0 text-[var(--text-secondary)]\" data-kid=\"1-2-2-1\" data-name=\"access denied icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <div data-kid=\"1-2-2-2\" data-name=\"access denied text container\">\n                <p class=\"text-[12px] font-bold uppercase tracking-[0.16em] text-[var(--text-secondary)]\" data-kid=\"1-2-2-2-1\" data-name=\"access denied title\">\n                    Acceso denegado\n                </p>\n                <p class=\"mt-1 text-[13px] leading-5 text-[var(--text-secondary)]\" data-kid=\"1-2-2-2-2\" data-name=\"access denied description\">\n                    Esta sección solo está disponible durante la configuración interna de la aplicación.\n                </p>\n            </div>\n        </aside>\n        <p class=\"mt-8 text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-3\" data-name=\"admin seed footer\">\n            AutoDoc · Configuración interna · Sin acciones pendientes\n        </p>\n    </main>\n</div>\n",
