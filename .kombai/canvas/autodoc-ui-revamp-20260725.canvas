      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .seed-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .seed-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"seed-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"1\" data-name=\"standalone admin seed mobile screen\" style=\"--seed-surface:#0F172A;--seed-container:#141E36;--seed-variant:#1E293B;--seed-outline:#334155;--seed-outline-strong:#475569;--seed-primary:#81E6D9;--seed-on-primary:#0F172A;--seed-text:#F8FAFC;--seed-muted:#CBD5E1;--seed-secondary:#94A3B8;--seed-success:#34D399;--seed-success-surface:#123B3A;--seed-danger:#F87171;--seed-danger-surface:#3F1D25;\">\n    <header class=\"sticky top-0 z-20 flex min-h-[64px] items-center justify-center border-b border-[var(--seed-outline)] bg-[#0B1220]/95 px-4 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"admin seed app bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"admin configuration title group\">\n            <span class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[var(--seed-primary)] text-[var(--seed-on-primary)] shadow-[0_6px_16px_rgba(129,230,217,0.14)]\" data-kid=\"1-1-1-1\" data-name=\"security icon container\">\n                <i class=\"ti ti-shield-lock text-[20px]\" data-kid=\"1-1-1-1-1\" data-name=\"security icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </span>\n            <h1 class=\"seed-heading truncate text-[16px] font-bold tracking-[-0.035em] text-[var(--seed-text)]\" data-kid=\"1-1-1-2\" data-name=\"admin configuration page title\">\n                Configuración de administradores\n            </h1>\n        </div>\n    </header>\n    <main class=\"mx-auto flex w-full max-w-[480px] flex-col items-center gap-5 px-4 pb-10 pt-8\" data-kid=\"1-2\" data-name=\"admin seed informational content\">\n        <section class=\"w-full rounded-[16px] border border-[var(--seed-outline)] bg-[var(--seed-container)] p-5 shadow-[0_8px_24px_rgba(2,6,23,0.28)]\" data-kid=\"1-2-1\" data-name=\"migration completed status card\">\n            <div class=\"flex flex-col items-center text-center\" data-kid=\"1-2-1-1\" data-name=\"migration status content\">\n                <span class=\"flex size-[72px] items-center justify-center rounded-full border border-[var(--seed-success)]/30 bg-[var(--seed-success-surface)] text-[var(--seed-success)]\" data-kid=\"1-2-1-1-1\" data-name=\"migration security status icon container\">\n                    <i class=\"ti ti-shield-check text-[34px]\" data-kid=\"1-2-1-1-1-1\" data-name=\"migration security status icon\" style=\"width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <p class=\"mt-6 text-[10px] font-bold uppercase tracking-[0.22em] text-[var(--seed-success)]\" data-kid=\"1-2-1-1-2\" data-name=\"configuration state eyebrow\">\n                    ESTADO DE CONFIGURACIÓN\n                </p>\n                <h2 class=\"seed-heading mt-3 text-[25px] font-extrabold leading-tight tracking-[-0.05em] text-[var(--seed-text)]\" data-kid=\"1-2-1-1-3\" data-name=\"migration completed heading\">\n                    Migración Completada\n                </h2>\n                <p class=\"mt-4 max-w-[310px] text-[14px] leading-5 text-[var(--seed-muted)]\" data-kid=\"1-2-1-1-4\" data-name=\"migration completed explanation\">\n                    Las cuentas administrativas ya fueron configuradas y los secretos se eliminaron del código fuente por motivos de seguridad.\n                </p>\n                <div class=\"mt-6 flex w-full items-center gap-3 border-t border-[var(--seed-outline)] pt-5 text-left\" data-kid=\"1-2-1-1-5\" data-name=\"verified configuration status row\">\n                    <i class=\"ti ti-lock-check shrink-0 text-[18px] text-[var(--seed-success)]\" data-kid=\"1-2-1-1-5-1\" data-name=\"verified lock icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"text-[12px] font-semibold text-[var(--seed-muted)]\" data-kid=\"1-2-1-1-5-2\" data-name=\"verified configuration text\">\n                        Configuración segura verificada\n                    </span>\n                </div>\n            </div>\n        </section>\n        <aside class=\"w-full rounded-[16px] border border-dashed border-[var(--seed-outline-strong)] bg-[var(--seed-variant)]/70 p-4\" data-kid=\"1-2-2\" data-name=\"release access denied alternate cue\">\n            <div class=\"flex items-start gap-3\" data-kid=\"1-2-2-1\" data-name=\"access denied content container\">\n                <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[var(--seed-danger-surface)] text-[var(--seed-danger)]\" data-kid=\"1-2-2-1-1\" data-name=\"access denied icon container\">\n                    <i class=\"ti ti-lock-off text-[18px]\" data-kid=\"1-2-2-1-1-1\" data-name=\"access denied icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <div class=\"min-w-0\" data-kid=\"1-2-2-1-2\" data-name=\"access denied text container\">\n                    <h3 class=\"seed-heading text-[13px] font-bold text-[var(--seed-text)]\" data-kid=\"1-2-2-1-2-1\" data-name=\"access denied heading\">\n                        Acceso denegado\n                    </h3>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[var(--seed-secondary)]\" data-kid=\"1-2-2-1-2-2\" data-name=\"access denied description\">\n                        Esta pantalla informativa no está disponible en compilaciones de producción.\n                    </p>\n                </div>\n            </div>\n        </aside>\n        <p class=\"pt-2 text-center text-[11px] text-[var(--seed-secondary)]\" data-kid=\"1-2-3\" data-name=\"admin seed footer\">\n            AutoDoc · Configuración interna · Sin acciones pendientes\n        </p>\n    </main>\n</div>\n",
