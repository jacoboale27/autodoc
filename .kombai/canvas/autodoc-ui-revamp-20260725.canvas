      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#0F172A] text-white [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"Application root container\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"Main dashboard layout wrapper\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"Sidebar navigation container\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\" data-name=\"Sidebar primary navigation group\">\n                <div class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1-1\" data-name=\"Application logo wrapper\">\n                    <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1-1\" data-name=\"Application logo text\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center gap-5 text-[#64748B]\" data-kid=\"2-1-1-1-2\" data-name=\"Sidebar primary navigation buttons container\">\n                    <button aria-label=\"Inicio\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"Dashboard navigation button\">\n                        <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"Dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Mi garaje\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-2\" data-name=\"Garage navigation button\">\n                        <i class=\"ti ti-steering-wheel text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"Garage icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-3\" data-name=\"Workshops navigation button\">\n                        <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" data-name=\"Workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Mensajes\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-4\" data-name=\"Messages navigation button\">\n                        <i class=\"ti ti-message-2 text-[19px]\" data-kid=\"2-1-1-1-2-4-1\" data-name=\"Messages icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\" data-name=\"Sidebar secondary navigation group\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-1\" data-name=\"Settings navigation button\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"Settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-2\" data-name=\"Help navigation button\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"Help icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\" data-name=\"User account and sub-navigation sidebar\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\" data-name=\"User brand header\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\" data-name=\"brand label\">\n                    Propietario\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-2-1-2\" data-name=\"Brand name container\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-2-1-2-1\" data-name=\"Brand name text\">\n                        Auto\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"Brand name highlight\">\n                            Doc\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-2-1-2-2\" data-name=\"Status indicator\">\n                    </span>\n                </div>\n            </div>\n            <nav class=\"flex-1 px-4 py-6\" data-kid=\"2-1-2-2\" data-name=\"Main navigation link list\">\n                <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-1\" data-name=\"workspace navigation section header\">\n                    Espacio de trabajo\n                </div>\n                <div class=\"space-y-1\" data-kid=\"2-1-2-2-2\" data-name=\"Workspace navigation link group\">\n                    <a class=\"flex items-center gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-3 py-3 text-[13px] font-semibold text-white\" data-kid=\"2-1-2-2-2-1\" data-name=\"Inicio link\" href=\"#\">\n                        <i class=\"ti ti-home-2 text-[17px] text-[#38BDF8]\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"Inicio icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Inicio\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-2\" data-name=\"Mi garaje link\" href=\"#\">\n                        <i class=\"ti ti-car text-[17px] text-[#94A3B8]\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"Mi garaje icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Mi garaje\n                        <span class=\"ml-auto text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"Garage count badge\">\n                            02\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-3\" data-name=\"Talleres link\" href=\"#\">\n                        <i class=\"ti ti-tool text-[17px] text-[#94A3B8]\" data-kid=\"2-1-2-2-2-3-1\" data-name=\"Talleres icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Talleres\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-4\" data-name=\"Alertas link\" href=\"#\">\n                        <i class=\"ti ti-alert-triangle text-[17px] text-[#FBBF24]\" data-kid=\"2-1-2-2-2-4-1\" data-name=\"Alertas icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Alertas\n                        <span class=\"ml-auto rounded-[4px] bg-[#7F1D1D] px-1.5 py-0.5 text-[10px] font-bold text-[#FCA5A5]\" data-kid=\"2-1-2-2-2-4-2\" data-name=\"Alertas count badge\">\n                            02\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-5\" data-name=\"Historial link\" href=\"#\">\n                        <i class=\"ti ti-history text-[17px] text-[#94A3B8]\" data-kid=\"2-1-2-2-2-5-1\" data-name=\"Historial icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Historial\n                    </a>\n                </div>\n                <div class=\"mt-10 border-t border-[#334155] pt-7\" data-kid=\"2-1-2-2-3\" data-name=\"Secondary navigation section\">\n                    <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-3-1\" data-name=\"quick access navigation header\">\n                        Acceso rápido\n                    </div>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-2\" data-name=\"Agendar servicio link\" href=\"#\">\n                        <i class=\"ti ti-calendar-plus text-[17px] text-[#818CF8]\" data-kid=\"2-1-2-2-3-2-1\" data-name=\"Agendar servicio icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Agendar servicio\n                    </a>\n                    <a class=\"flex items-center gap-3 px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-3-3\" data-name=\"Conversaciones link\" href=\"#\">\n                        <i class=\"ti ti-message-circle text-[17px] text-[#94A3B8]\" data-kid=\"2-1-2-2-3-3-1\" data-name=\"Conversaciones icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Conversaciones\n                    </a>\n                </div>\n            </nav>\n            <div class=\"border-t border-[#334155] px-5 py-5\" data-kid=\"2-1-2-3\" data-name=\"User profile summary container\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\" data-name=\"User profile info\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-3-1-1\" data-name=\"User avatar initials\">\n                        JP\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\" data-name=\"User details container\">\n                        <div class=\"truncate text-[12px] font-semibold text-white\" data-kid=\"2-1-2-3-1-2-1\" data-name=\"User name text\">\n                            Juan Pérez\n                        </div>\n                        <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\" data-name=\"User plan type text\">\n                            Plan personal\n                        </div>\n                    </div>\n                    <i class=\"ti ti-dots text-[16px] text-[#64748B]\" data-kid=\"2-1-2-3-1-3\" data-name=\"User options icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[#0F172A]\" data-kid=\"2-1-3\" data-name=\"Dashboard main content area\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#334155] px-8\" data-kid=\"2-1-3-1\" data-name=\"Main dashboard header\">\n                <div class=\"flex items-center gap-3 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-1-1\" data-name=\"Breadcrumb navigation container\">\n                    <span data-kid=\"2-1-3-1-1-1\" data-name=\"Breadcrumb current parent\">\n                        Propietario\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-1-3-1-1-2\" data-name=\"Chevron separator icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-1-1-3\" data-name=\"Breadcrumb active page text\">\n                        Inicio\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-6\" data-kid=\"2-1-3-1-2\" data-name=\"Header utility tools container\">\n                    <div class=\"text-right\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1\" data-name=\"Current date and time display\" data-reason=\"text replaced by real-time script\">\n                        <div class=\"text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-1\" data-name=\"Date text\" data-reason=\"text replaced by real-time script\">\n                            Sábado, 25 jul 2026\n                        </div>\n                        <div class=\"mt-0.5 text-[12px] font-semibold text-[#CBD5E1]\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1-2\" data-name=\"Time text\" data-reason=\"text replaced by real-time script\">\n                            08:42 a. m.\n                        </div>\n                    </div>\n                    <div class=\"h-5 w-px bg-[#334155]\" data-kid=\"2-1-3-1-2-2\" data-name=\"Divider line\">\n                    </div>\n                    <button aria-label=\"Cambiar tema\" class=\"flex h-9 w-9 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-3-1-2-3\" data-name=\"Theme toggle button\">\n                        <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"Theme icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex h-9 w-9 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-3-1-2-4\" data-name=\"Notifications button\">\n                        <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-3-1-2-4-1\" data-name=\"Notification bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-3-1-2-4-2\" data-name=\"Unread notification indicator dot\">\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-3 border-l border-[#334155] pl-5\" data-kid=\"2-1-3-1-2-5\" data-name=\"Header user profile section\">\n                        <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-1-2-5-1\" data-name=\"Header user avatar initials\">\n                            JP\n                        </div>\n                        <div class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-1-2-5-2\" data-name=\"Header user name text\">\n                            Juan Pérez\n                        </div>\n                        <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-1-3-1-2-5-3\" data-name=\"Dropdown chevron icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                </div>\n            </header>\n            <div class=\"px-8 pb-14 pt-8\" data-kid=\"2-1-3-2\" data-name=\"Dashboard main content wrapper\">\n                <div class=\"mb-7 flex items-end justify-between\" data-kid=\"2-1-3-2-1\" data-name=\"Content header section\">\n                    <div data-kid=\"2-1-3-2-1-1\" data-name=\"Header title and subtitle\">\n                        <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[30px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-1-3-2-1-1-2\" data-name=\"Dashboard main title\">\n                            Tu vehículo, en control\n                        </h1>\n                        <p class=\"mt-2 text-[14px] text-[#94A3B8]\" data-kid=\"2-1-3-2-1-1-3\" data-name=\"Dashboard description text\">\n                            Revisa el estado actual y actúa antes de que un detalle se convierta en una avería.\n                        </p>\n                    </div>\n                    <button class=\"flex items-center gap-2 border border-[#475569] px-4 py-2.5 text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-1-2\" data-name=\"Update data action button\">\n                        <i class=\"ti ti-refresh text-[15px] text-[#38BDF8]\" data-kid=\"2-1-3-2-1-2-1\" data-name=\"Refresh icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Actualizar datos\n                    </button>\n                </div>\n                <section class=\"overflow-hidden rounde