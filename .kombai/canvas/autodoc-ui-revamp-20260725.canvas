      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"Profile application root\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"Profile shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"Primary icon rail\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\" data-name=\"Primary rail group\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#082F49] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc mark\">\n                    <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1-1\" data-name=\"AutoDoc logo text\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-1-2\" data-name=\"Primary rail navigation\">\n                    <button aria-label=\"Inicio\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-1-2-1\" data-name=\"Inicio navigation button\">\n                        <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Mi garaje\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-1-2-2\" data-name=\"Mi garaje navigation button\">\n                        <i class=\"ti ti-steering-wheel text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"steering wheel icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-1-2-3\" data-name=\"Talleres navigation button\">\n                        <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" data-name=\"tool icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Alertas\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-1-2-4\" data-name=\"Alertas navigation button\">\n                        <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-1-1-1-2-4-1\" data-name=\"alert triangle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Mi perfil\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-1-1-2-5\" data-name=\"Mi perfil navigation button\">\n                        <i class=\"ti ti-user-circle text-[19px]\" data-kid=\"2-1-1-1-2-5-1\" data-name=\"user circle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\" data-name=\"Utility rail navigation\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"Configuración navigation button\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"Ayuda navigation button\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"help circle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\" data-name=\"Owner contextual sidebar\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\" data-name=\"Owner identity header\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\" data-name=\"Owner label\">\n                    Propietario\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-2-1-2\" data-name=\"Brand mark group\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-2-1-2-1\" data-name=\"AutoDoc wordmark\">\n                        Auto\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"Doc highlight text\">\n                            Doc\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-2-1-2-2\" data-name=\"Online status indicator\">\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación del propietario\" class=\"flex-1 px-4 py-6\" data-kid=\"2-1-2-2\" data-name=\"Owner navigation\">\n                <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-1\" data-name=\"Workspace section label\">\n                    Espacio de trabajo\n                </div>\n                <div class=\"space-y-1\" data-kid=\"2-1-2-2-2\" data-name=\"Workspace nav links\">\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8] hover:bg-[#1E293B] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-2-2-2-1\" data-name=\"Inicio nav link\" href=\"#\">\n                        <i class=\"ti ti-home-2 text-[17px]\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"home icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Inicio\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8] hover:bg-[#1E293B] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-2-2-2-2\" data-name=\"Mi garaje nav link\" href=\"#\">\n                        <i class=\"ti ti-car text-[17px]\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"car icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Mi garaje\n                        <span class=\"ml-auto text-[11px] text-[#64748B]\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"garaje count badge\">\n                            03\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8] hover:bg-[#1E293B] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-2-2-2-3\" data-name=\"Talleres nav link\" href=\"#\">\n                        <i class=\"ti ti-tool text-[17px]\" data-kid=\"2-1-2-2-2-3-1\" data-name=\"tool icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Talleres\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8] hover:bg-[#1E293B] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-2-2-2-4\" data-name=\"Alertas nav link\" href=\"#\">\n                        <i class=\"ti ti-alert-triangle text-[17px] text-[#FBBF24]\" data-kid=\"2-1-2-2-2-4-1\" data-name=\"alert triangle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Alertas\n                        <span class=\"ml-auto rounded-[4px] bg-[#7F1D1D] px-1.5 py-0.5 text-[10px] font-bold text-[#FCA5A5]\" data-kid=\"2-1-2-2-2-4-2\" data-name=\"alert count badge\">\n                            02\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8] hover:bg-[#1E293B] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-2-2-2-5\" data-name=\"Historial nav link\" href=\"#\">\n                        <i class=\"ti ti-history text-[17px]\" data-kid=\"2-1-2-2-2-5-1\" data-name=\"history icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Historial\n                    </a>\n                </div>\n                <div class=\"mt-10 border-t border-[#334155] pt-7\" data-kid=\"2-1-2-2-3\" data-name=\"Account section group\">\n                    <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-3-1\" data-name=\"Account section label\">\n                        Cuenta\n                    </div>\n                    <div class=\"space-y-1\" data-kid=\"2-1-2-2-3-2\" data-name=\"Account nav links\">\n                        <a aria-current=\"page\" class=\"flex items-center gap-3 border-l-2 border-[#38BDF8] bg-[#1E293B] px-3 py-3 text-[13px] font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-2-2-3-2-1\" data-name=\"Mi perfil nav link\" href=\"#\">\n                            <i class=\"ti ti-user-circle text-[17px] text-[#38BDF8]\" data-kid=\"2-1-2-2-3-2-1-1\" data-name=\"user circle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Mi perfil\n                        </a>\n                        <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8] hover:bg-[#1E293B] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-2-2-3-2-2\" data-name=\"Conversaciones nav link\" href=\"#\">\n                            <i class=\"ti ti-message-circle text-[17px]\" data-kid=\"2-1-2-2-3-2-2-1\" data-name=\"message circle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Conversaciones\n                        </a>\n                    </div>\n                </div>\n            </nav>\n            <div class=\"border-t border-[#334155] px-5 py-5\" data-kid=\"2-1-2-3\" data-name=\"Owner profile summary\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\" data-name=\"Owner profile summary content\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-3-1-1\" data-name=\"Owner avatar initials\">\n                        JP\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\" data-name=\"Owner name details\">\n                        <div class=\"truncate text-[12px] font-semibold text-white\" data-kid=\"2-1-2-3-1-2-1\" data-name=\"Owner full name\">\n                            Juan Pérez\n                        </div>\n                        <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\" data-name=\"Subscription plan name\">\n                            Plan personal\n                        </div>\n                    </div>\n                    <i class=\"ti ti-dots ml-auto text-[16px] text-[#64748B]\" data-kid=\"2-1-2-3-1-3\" data-name=\"Profile options icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[#0F172A]\" data-kid=\"2-1-3\" data-name=\"Profile main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#334155] px-8\" data-kid=\"2-1-3-1\" data-name=\"Profile top header\">\n                <div class=\"flex items-center gap-3 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-1-1\" data-name=\"Profile breadcrumb\">\n                    <span data-kid=\"2-1-3-1-1-1\" data-name=\"breadcrumb parent text\">\n                        Propietario\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-1-3-1-1-2\" data-name=\"breadcrumb chevron icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-medium text-[#E2E8F0]\" data-kid=\"2-1-3-1-1-3\" data-name=\"breadcrumb child text\">\n                        Mi perfil\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-1-2\" data-name=\"Profile header controls\">\n                    <span class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-1-2-1\" data-name=\"header date text\">\n                        Sábado, 15 ago 2026\n                    </span>\n                    <button aria-label=\"Cambiar tema\" class=\"flex h-9 w-9 items-center justify-center border border-[#475569] text-[#94A3B8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:border-[#38BDF8] hover:text-white\" data-kid=\"2-1-3-1-2-2\" data-name=\"theme toggle button\">\n                        <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-3-1-2-2-1\" data-name=\"sun moon icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Notificaciones\" class=\"relative flex h-9 w-9 items-center justify-center border border-[#475569] text-[#CBD5E1] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:border-[#38BDF8] hover:text-white\" data-kid=\"2-1-3-1-2-3\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-3-1-2-3-2\" data-name=\"notification indicator\">\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-3 border-l border-[#334155] pl-5\" data-kid=\"2-1-3-1-2-4\" data-name=\"current user display\">\n                        <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-1-3-1-2-4-1\" data-name=\"user avatar initials\">\n                            JP\n                        </div>\n                        <span class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-1-2-4-2\" data-name=\"user full name\">\n                            Juan Pérez\n                        </span>\n                        <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-1-3-1-2-4-3\" data-name=\"user menu chevron icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1000px] px-8 pb-12 pt-8\" data-kid=\"2-1-3-2\" data-name=\"Profile content wrapper\">\n                <div class=\"flex items-end justify-between gap-6 border-b border-[#334155] pb-7\" data-kid=\"2-1-3-2-1\" data-name=\"Profile page heading\">\n                    <div data-kid=\"2-1-3-2-1-1\" data-name=\"page title group\">\n                        <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[30px] font-extrabold tracking-[-0.04em] text-white\" data-kid=\"2-1-3-2-1-1-1\" data-name=\"profile title\">\n                            Mi perfil\n                        </h1>\n                        <p class=\"mt-2 text-[14px] text-[#94A3B8]\" data-kid=\"2-1-3-2-1-1-2\" data-name=\"profile description text\">\n                            Mantén tus datos y preferencias al día.\n                        </p>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"2-1-3-2-1-2\" data-name=\"completion progress container\">\n                        <div class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-3-2-1-2-1\" data-name=\"progress label\">\n                            Perfil completo\n                        </div>\n                        <div class=\"mt-2 flex items-center gap-3\" data-kid=\"2-1-3-2-1-2-2\" data-name=\"progress bar group\">\n                            <div class=\"h-1.5 w-28 bg-[#334155]\" data-kid=\"2-1-3-2-1-2-2-1\" data-name=\"progress track\">\n                                <div class=\"h-1.5 w-[80%] bg-[#38BDF8]\" data-kid=\"2-1-3-2-1-2-2-1-1\" data-name=\"progress fill\">\n                                </div>\n                            </div>\n                            <span class=\"text-[13px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-1-3-2-1-2-2-2\" data-name=\"progress percentage text\">\n                                80%\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <section aria-labelledby=\"profile-owner-heading\" class=\"flex items-center justify-between gap-6 border-b border-[#334155] py-7\" data-kid=\"2-1-3-2-2\" data-name=\"Editorial profile header\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"2-1-3-2-2-1\" data-name=\"profile owner identification\">\n                        <div class=\"flex h-16 w-16 items-center justify-center rounded-full bg-[#38BDF8] text-[20px] font-extrabold text-[#082F49] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-3-2-2-1-1\" data-name=\"large avatar initials\">\n                            JP\n                        </div>\n                        <div data-kid=\"2-1-3-2-2-1-2\" data-name=\"owner name role container\">\n                            <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[20px] font-bold tracking-[-0.025em] text-white\" data-kid=\"2-1-3-2-2-1-2-1\" data-name=\"owner name\" id=\"profile-owner-heading\">\n                                Juan Pérez\n                            </h2>\n                            <p class=\"mt-1 text-[13px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-2-2\" data-name=\"owner account type text\">\n                                Cuenta personal\n                            </p>\n                        </div>\n                    </div>\n                    <button class=\"flex min-h-10 items-center gap-2 border border-[#475569] px-4 py-2.5 text-[12px] font-semibold text-[#E2E8F0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:border-[#38BDF8] hover:text-white\" data-kid=\"2-1-3-2-2-2\" data-name=\"change photo button\">\n                        <i class=\"ti ti-camera text-[16px] text-[#38BDF8]\" data-kid=\"2-1-3-2-2-2-1\" data-name=\"camera icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Cambiar foto\n                    </button>\n                </section>\n                <form aria-label=\"Editar perfil\" class=\"mx-auto mt-8 max-w-[760px]\" data-kid=\"2-1-3-2-3\" data-name=\"Profile settings form\">\n                    <section aria-labelledby=\"personal-data-title\" data-kid=\"2-1-3-2-3-1\" data-name=\"Personal data section\">\n                        <div class=\"mb-5\" data-kid=\"2-1-3-2-3-1-1\" data-name=\"Personal data section header\">\n                            <h3 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[17px] font-bold text-white\" data-kid=\"2-1-3-2-3-1-1-1\" data-name=\"Personal data title\" id=\"personal-data-title\">\n                                Datos personales\n                            </h3>\n                            <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-1-1-2\" data-name=\"Personal data description\">\n                                Información que usaremos para identificarte y contactarte.\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-x-5 gap-y-5\" data-kid=\"2-1-3-2-3-1-2\" data-name=\"form input grid\">\n                            <label class=\"block\" data-kid=\"2-1-3-2-3-1-2-1\" data-name=\"full name input group\">\n                                <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-1-2-1-1\" data-name=\"full name input label\">\n                                    Nombre completo\n                                </span>\n                                <input class=\"h-11 w-full border border-[#475569] bg-[#1E293B] px-3.5 text-[13px] text-white outline-none placeholder:text-[#64748B] focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8]\" data-kid=\"2-1-3-2-3-1-2-1-2\" data-name=\"full name input\" value=\"Juan Pérez\"/>\n                            </label>\n                            <label class=\"block\" data-kid=\"2-1-3-2-3-1-2-2\" data-name=\"email input group\">\n                                <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-1-2-2-1\" data-name=\"email input label\">\n                                    Correo electrónico\n                                </span>\n                                <div class=\"relative\" data-kid=\"2-1-3-2-3-1-2-2-2\" data-name=\"email input wrapper\">\n                                    <input class=\"h-11 w-full border border-[#34D399] bg-[#1E293B] px-3.5 pr-10 text-[13px] text-white outline-none placeholder:text-[#64748B] focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8]\" data-kid=\"2-1-3-2-3-1-2-2-2-1\" data-name=\"email input\" value=\"juan.perez@email.com\"/>\n                                    <i aria-hidden=\"true\" class=\"ti ti-circle-check absolute right-3 top-1/2 -translate-y-1/2 text-[17px] text-[#34D399]\" data-kid=\"2-1-3-2-3-1-2-2-2-2\" data-name=\"email verified check icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </div>\n                                <span class=\"mt-1.5 block text-[11px] text-[#6EE7B7]\" data-kid=\"2-1-3-2-3-1-2-2-3\" data-name=\"email verification status text\">\n                                    Correo verificado\n                                </span>\n                            </label>\n                            <label class=\"block\" data-kid=\"2-1-3-2-3-1-2-3\" data-name=\"phone input group\">\n                                <span class=\"mb-2 block text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-1-2-3-1\" data-name=\"phone input label\">\n                                    Teléfono\n                                </span>\n                                <input class=\"h-11 w-full border border-[#475569] bg-[#1E293B] px-3.5 text-[13px] text-white outline-none placeholder:text-[#64748B] focus:border-[#38BDF8] focus:ring-1 focus:ring-[#38BDF8]\" data-kid=\"2-1-3-2-3-1-2-3-2\" data-name=\"phone input\" value=\"+57 300 555 0182\"/>\n                                <span class=\"mt-1.5 block text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-1-2-3-3\" data-name=\"phone help text\">\n                                    Incluye el indicativo de tu país.\n                                </span>\n                            </label>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"preferences-title\" class=\"mt-8 border-t border-[#334155] pt-7\" data-kid=\"2-1-3-2-3-2\" data-name=\"Preferences section\">\n                        <div class=\"mb-5\" data-kid=\"2-1-3-2-3-2-1\" data-name=\"Preferences section header\">\n                            <h3 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[17px] font-bold text-white\" data-kid=\"2-1-3-2-3-2-1-1\" data-name=\"Preferences title\" id=\"preferences-title\">\n                                Preferencias\n                            </h3>\n                            <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-2-1-2\" data-name=\"Preferences description\">\n                                Controla cómo se adapta AutoDoc a tu forma de usarlo.\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-x-5 gap-y-4\" data-kid=\"2-1-3-2-3-2-2\" data-name=\"Preferences options grid\">\n                            <div class=\"flex items-center justify-between border-b border-[#334155] py-3\" data-kid=\"2-1-3-2-3-2-2-1\" data-name=\"language option\">\n                                <div data-kid=\"2-1-3-2-3-2-2-1-1\" data-name=\"language label group\">\n                                    <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-3-2-2-1-1-1\" data-name=\"language label\">\n                                        Idioma\n                                    </div>\n                                    <div class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-2-2-1-1-2\" data-name=\"language value text\">\n                                        Español\n                                    </div>\n                                </div>\n                                <button aria-label=\"Cambiar idioma\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:text-white\" data-kid=\"2-1-3-2-3-2-2-1-2\" data-name=\"change language button\" type=\"button\">\n                                    <i class=\"ti ti-chevron-down text-[16px]\" data-kid=\"2-1-3-2-3-2-2-1-2-1\" data-name=\"chevron icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </button>\n                            </div>\n                            <div class=\"flex items-center justify-between border-b border-[#334155] py-3\" data-kid=\"2-1-3-2-3-2-2-2\" data-name=\"dark mode option\">\n                                <div data-kid=\"2-1-3-2-3-2-2-2-1\" data-name=\"dark mode label group\">\n                                    <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-3-2-2-2-1-1\" data-name=\"dark mode label\">\n                                        Modo de apariencia\n                                    </div>\n                                    <div class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-2-2-2-1-2\" data-name=\"dark mode value text\">\n                                        Oscuro\n                                    </div>\n                                </div>\n                                <button aria-checked=\"true\" aria-label=\"Modo oscuro activado\" class=\"relative h-6 w-11 rounded-full bg-[#38BDF8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-3-2-3-2-2-2-2\" data-name=\"dark mode toggle switch\" role=\"switch\" type=\"button\">\n                                    <span class=\"absolute right-1 top-1 h-4 w-4 rounded-full bg-[#082F49]\" data-kid=\"2-1-3-2-3-2-2-2-2-1\" data-name=\"toggle switch thumb\">\n                                    </span>\n                                </button>\n                            </div>\n                            <div class=\"flex items-center justify-between border-b border-[#334155] py-3\" data-kid=\"2-1-3-2-3-2-2-3\" data-name=\"notifications option\">\n                                <div data-kid=\"2-1-3-2-3-2-2-3-1\" data-name=\"notifications label group\">\n                                    <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-3-2-2-3-1-1\" data-name=\"notifications label\">\n                                        Notificaciones\n                                    </div>\n                                    <div class=\"mt-1 text-[11px] text-[#6EE7B7]\" data-kid=\"2-1-3-2-3-2-2-3-1-2\" data-name=\"notifications value text\">\n                                        Activadas para alertas de mantenimiento\n                                    </div>\n                                </div>\n                                <button aria-checked=\"true\" aria-label=\"Notificaciones activadas\" class=\"relative h-6 w-11 rounded-full bg-[#34D399] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8]\" data-kid=\"2-1-3-2-3-2-2-3-2\" data-name=\"notifications toggle switch\" role=\"switch\" type=\"button\">\n                                    <span class=\"absolute right-1 top-1 h-4 w-4 rounded-full bg-[#064E3B]\" data-kid=\"2-1-3-2-3-2-2-3-2-1\" data-name=\"toggle switch thumb\">\n                                    </span>\n                                </button>\n                            </div>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"role-title\" class=\"mt-8 border-t border-[#334155] pt-7\" data-kid=\"2-1-3-2-3-3\" data-name=\"Role selection section\">\n                        <div class=\"mb-5\" data-kid=\"2-1-3-2-3-3-1\" data-name=\"Role selection section header\">\n                            <h3 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[17px] font-bold text-white\" data-kid=\"2-1-3-2-3-3-1-1\" data-name=\"Role title\" id=\"role-title\">\n                                Tu rol en AutoDoc\n                            </h3>\n                            <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-3-1-2\" data-name=\"Role description\">\n                                Define qué herramientas aparecen en tu espacio de trabajo.\n                            </p>\n                        </div>\n                        <button aria-pressed=\"true\" class=\"flex min-h-12 w-full items-start justify-between gap-5 rounded-[16px] border border-[#81E6D9]/60 bg-[#082F49]/45 px-4 py-4 text-left shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#81E6D9]\" data-kid=\"2-1-3-2-3-3-2\" data-name=\"Owner role selection card\" type=\"button\">\n                            <span class=\"flex items-start gap-3\" data-kid=\"2-1-3-2-3-3-2-1\" data-name=\"Role content group\">\n                                <span class=\"mt-0.5 flex h-5 w-5 items-center justify-center rounded-full border border-[#38BDF8] bg-[#38BDF8] text-[#082F49]\" data-kid=\"2-1-3-2-3-3-2-1-1\" data-name=\"Role selection check container\">\n                                    <i class=\"ti ti-check text-[13px]\" data-kid=\"2-1-3-2-3-3-2-1-1-1\" data-name=\"check icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <span data-kid=\"2-1-3-2-3-3-2-1-2\" data-name=\"Role text group\">\n                                    <span class=\"block text-[14px] font-bold text-white\" data-kid=\"2-1-3-2-3-3-2-1-2-1\" data-name=\"Role name\">\n                                        Propietario\n                                    </span>\n                                    <span class=\"mt-1 block text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-3-2-1-2-2\" data-name=\"Role description text\">\n                                        Gestiona vehículos, mantenimientos, talleres y conversaciones.\n                                    </span>\n                                </span>\n                            </span>\n                            <span class=\"text-[11px] font-semibold text-[#7DD3FC]\" data-kid=\"2-1-3-2-3-3-2-2\" data-name=\"Role selected badge\">\n                                Seleccionado\n                            </span>\n                        </button>\n                    </section>\n                    <div class=\"mt-8 flex items-center justify-between border-t border-[#334155] pt-6\" data-kid=\"2-1-3-2-3-4\" data-name=\"Profile form actions\">\n                        <span class=\"flex items-center gap-2 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-4-1\" data-name=\"security notice group\">\n                            <i class=\"ti ti-shield-lock text-[15px] text-[#34D399]\" data-kid=\"2-1-3-2-3-4-1-1\" data-name=\"shield lock icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Tus datos se almacenan de forma segura.\n                        </span>\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-3-4-2\" data-name=\"action buttons container\">\n                            <button class=\"min-h-11 border border-[#475569] px-4 py-2.5 text-[12px] font-semibold text-[#CBD5E1] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:border-[#94A3B8] hover:text-white\" data-kid=\"2-1-3-2-3-4-2-1\" data-name=\"cancel button\" type=\"button\">\n                                Cancelar\n                            </button>\n                            <button class=\"min-h-11 bg-[#38BDF8] px-5 py-2.5 text-[12px] font-bold text-[#082F49] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#38BDF8] hover:bg-[#7DD3FC]\" data-kid=\"2-1-3-2-3-4-2-2\" data-name=\"save changes button\" type=\"submit\">\n                                Guardar cambios\n                            </button>\n                        </div>\n                    </div>\n                </form>\n            </div>\n        </main>\n    </div>\n</div>\n",
