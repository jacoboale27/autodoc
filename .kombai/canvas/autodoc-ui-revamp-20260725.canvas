3-2-3-5-5-1\" data-name=\"Edit button\">\n                                <i class=\"ti ti-pencil text-[16px]\" data-kid=\"2-1-3-2-3-5-5-1-1\" data-name=\"Edit icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                            <button aria-label=\"Más opciones diagnóstico general\" class=\"flex h-11 w-11 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-3-2-3-5-5-2\" data-name=\"More options button\">\n                                <i class=\"ti ti-dots text-[16px]\" data-kid=\"2-1-3-2-3-5-5-2-1\" data-name=\"More options icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-[minmax(0,1.7fr)_0.8fr_0.8fr_0.7fr_120px] items-center px-5 py-4\" data-kid=\"2-1-3-2-3-6\" data-name=\"Service row 3\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-3-6-1\" data-name=\"Service details column\">\n                            <span class=\"flex h-9 w-9 items-center justify-center border border-[#334155] text-[#64748B]\" data-kid=\"2-1-3-2-3-6-1-1\" data-name=\"Service icon container\">\n                                <i class=\"ti ti-sparkles text-[16px]\" data-kid=\"2-1-3-2-3-6-1-1-1\" data-name=\"Service icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                            <div data-kid=\"2-1-3-2-3-6-1-2\" data-name=\"Service label container\">\n                                <div class=\"text-[13px] font-semibold text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-6-1-2-1\" data-name=\"Service name\">\n                                    Lavado premium\n                                </div>\n                                <div class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-6-1-2-2\" data-name=\"Service category\">\n                                    Servicio adicional\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"text-[12px] tabular-nums text-[#94A3B8]\" data-kid=\"2-1-3-2-3-6-2\" data-name=\"Duration text\">\n                            40 min\n                        </div>\n                        <div class=\"text-[13px] font-semibold tabular-nums text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-6-3\" data-name=\"Price text\">\n                            $30.00\n                        </div>\n                        <div class=\"flex items-center gap-2 text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-1-3-2-3-6-4\" data-name=\"Service status indicator\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#FBBF24]\" data-kid=\"2-1-3-2-3-6-4-1\" data-name=\"Status indicator dot\">\n                            </span>\n                            Inactivo\n                        </div>\n                        <div class=\"flex justify-end gap-1\" data-kid=\"2-1-3-2-3-6-5\" data-name=\"Service action buttons\">\n                            <button aria-label=\"Editar lavado premium\" class=\"flex h-11 w-11 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-3-2-3-6-5-1\" data-name=\"Edit button\">\n                                <i class=\"ti ti-pencil text-[16px]\" data-kid=\"2-1-3-2-3-6-5-1-1\" data-name=\"Edit icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                            <button aria-label=\"Más opciones lavado premium\" class=\"flex h-11 w-11 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-3-2-3-6-5-2\" data-name=\"More options button\">\n                                <i class=\"ti ti-dots text-[16px]\" data-kid=\"2-1-3-2-3-6-5-2-1\" data-name=\"More options icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </section>\n                <div class=\"mt-5 flex items-center justify-between border-t border-[#334155] pt-5 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-4\" data-name=\"Helpful tips footer\">\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-4-1\" data-name=\"Info message\">\n                        <i class=\"ti ti-info-circle text-[16px] text-[#38BDF8]\" data-kid=\"2-1-3-2-4-1-1\" data-name=\"Info icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        ¿No encuentras un servicio? Añade uno para reutilizarlo al facturar.\n                    </span>\n                    <button class=\"font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2\" data-name=\"Inactive services link\">\n                        Ver servicios inactivos\n                        <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"2-1-3-2-4-2-1\" data-name=\"Arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <footer class=\"mt-8 flex items-center justify-between border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-5\" data-name=\"Content page footer\">\n                    <span data-kid=\"2-1-3-2-5-1\" data-name=\"Footer copyright text\">\n                        AutoDoc · Catálogo del taller\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-5-2\" data-name=\"Sync time container\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-5-2-1\" data-name=\"Sync status dot\">\n                        </span>\n                        Datos sincronizados hace 4 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
