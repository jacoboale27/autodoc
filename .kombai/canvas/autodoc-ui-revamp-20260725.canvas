      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component tokens light\">\n    button { min-height:44px; min-width:44px; border-radius:999px !important; transition:transform 150ms cubic-bezier(.23,1,.32,1),box-shadow 150ms cubic-bezier(.23,1,.32,1),background-color 150ms cubic-bezier(.23,1,.32,1),color 150ms cubic-bezier(.23,1,.32,1); }\n  button:active { transform:scale(.97); }\n  button:hover { box-shadow:0 6px 14px rgba(15,23,42,.10); }\n  button[data-name*=\"primary button\"], button[data-name*=\"new user primary button\"] { background:linear-gradient(135deg,#522C81,#47266F) !important; color:#FFFFFF !important; border:0 !important; box-shadow:0 2px 4px rgba(0,0,0,.05); }\n  button[data-name*=\"refresh\"], button[data-name*=\"export\"], button[data-name*=\"filter\"], button[data-name*=\"page\"] { background:#EEEDF0 !important; border:1px solid rgba(203,213,225,.40) !important; color:#0F172A !important; box-shadow:0 2px 4px rgba(0,0,0,.05); }\n  button[aria-label*=\"Notificaciones\"], button[aria-label*=\"Actualizar\"], button[aria-label*=\"Ayuda\"], button[aria-label*=\"Configuración\"] { background:#EEEDF0 !important; border:1px solid rgba(203,213,225,.40) !important; }\n  section[data-name*=\"metrics\"], section[data-name*=\"panel\"], section[data-name*=\"logs\"], section[data-name*=\"audit\"], section[data-name*=\"table\"] { background:#EEEDF0; border-color:rgba(203,213,225,.40) !important; border-radius:16px; box-shadow:0 2px 4px rgba(0,0,0,.05); overflow:hidden; }\n</style>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"admin light application shell\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"admin L frame layout\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"admin icon rail\">\n            <div aria-label=\"AutoDoc administración\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc rail logo\">\n                AD\n            </div>\n            <div class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"admin rail primary actions\">\n                <button aria-label=\"Resumen\" class=\"grid size-12 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-1\" data-name=\"active summary rail action\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"2-1-1-2-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Usuarios\" class=\"grid size-12 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"users rail action\">\n                    <i class=\"ti ti-users\" data-kid=\"2-1-1-2-2-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Talleres\" class=\"grid size-12 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"workshops rail action\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-3-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Logs\" class=\"grid size-12 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-4\" data-name=\"logs rail action\">\n                    <i class=\"ti ti-list-details\" data-kid=\"2-1-1-2-4-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"admin rail utility actions\">\n                <button aria-label=\"Ayuda\" class=\"grid size-12 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help rail action\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-12 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings rail action\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"admin contextual sidebar\">\n            <div class=\"mb-8 border-b border-[#E2E8F0] pb-6\" data-kid=\"2-1-2-1\" data-name=\"admin identity block\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"admin area label\">\n                    Administración\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"admin identity row\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"admin online status\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"admin role label\">\n                        Superadmin\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación de administración\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"admin primary navigation\">\n                <p class=\"mb-2 px-3 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-2-1\" data-name=\"workspace nav label\">\n                    Centro de control\n                </p>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-3 text-[14px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-2-2\" data-name=\"active summary navigation link\" href=\"#resumen\">\n                    <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"2-1-2-2-2-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Resumen\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-3 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-3\" data-name=\"users navigation link\" href=\"#usuarios\">\n                    <i class=\"ti ti-users text-[17px]\" data-kid=\"2-1-2-2-3-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Usuarios\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-3 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-4\" data-name=\"workshops navigation link\" href=\"#talleres\">\n                    <i class=\"ti ti-tool text-[17px]\" data-kid=\"2-1-2-2-4-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Talleres\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-3 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-5\" data-name=\"reviews navigation link\" href=\"#resenias\">\n                    <i class=\"ti ti-star text-[17px]\" data-kid=\"2-1-2-2-5-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Reseñas\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-3 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-6\" data-name=\"logs navigation link\" href=\"#logs\">\n                    <i class=\"ti ti-list-details text-[17px]\" data-kid=\"2-1-2-2-6-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Logs\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-3 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-7\" data-name=\"seed navigation link\" href=\"#seed\">\n                    <i class=\"ti ti-database-import text-[17px]\" data-kid=\"2-1-2-2-7-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Seed\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"admin profile footer\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\" data-name=\"superadmin profile row\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3-1-1\" data-name=\"superadmin initials\">\n                        SA\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\">\n                        <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-3-1-2-1\">\n                            Superadmin\n                        </p>\n                        <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\">\n                            Acceso interno\n                        </p>\n                    </div>\n                    <i class=\"ti ti-chevron-down ml-auto text-[16px] text-[#94A3B8]\" data-kid=\"2-1-2-3-1-3\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"2-1-3\" data-name=\"admin main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-white px-8\" data-kid=\"2-1-3-1\" data-name=\"admin top header\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"2-1-3-1-1\" data-name=\"admin breadcrumb\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-1-3-1-1-1\">\n                        Admin\n                    </span>\n                    <i class=\"ti ti-chevron-right text-[14px] text-[#94A3B8]\" data-kid=\"2-1-3-1-1-2\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-1-3\">\n                        Resumen\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-1-2\" data-name=\"admin header utilities\">\n                    <span class=\"hidden text-[12px] text-[#64748B] lg:block\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-3\" data-name=\"current date text\" data-reason=\"date text rendered by script on load\">\n                        Sábado, 15 ago 2026\n                    </span>\n                    <button aria-label=\"Actualizar datos\" class=\"flex min-h-12 items-center gap-2 border border-[#CBD5E1] bg-white px-4 text-[13px] font-semibold text-[#0F172A] hover:border-[#1E88E5]\" data-kid=\"2-1-3-1-2-1\" data-name=\"refresh admin data\">\n                        <i class=\"ti ti-refresh text-[17px] text-[#1E88E5]\" data-kid=\"2-1-3-1-2-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Actualizar datos\n                    </button>\n                    <button aria-label=\"Notificaciones\" class=\"relative grid size-12 place-items-center rounded-lg text-[20px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-2\" data-name=\"admin notifications\">\n                        <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-2-2-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-2 top-2 size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-3-1-2-2-2\">\n                        </span>\n                    </button>\n                    <div class=\"h-7 w-px bg-[#E2E8F0]\" data-kid=\"2-1-3-1-2-6\">\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-1-2-7\">\n                        <div class=\"grid size-10 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-1-2-7-1\">\n                            SA\n                        </div>\n                        <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-2-7-2\">\n                            Superadmin\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1160px] px-8 py-7\" data-kid=\"2-1-3-2\" data-name=\"admin page body\" id=\"resumen\">\n                <div class=\"mb-6 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"admin page heading\">\n                    <div data-kid=\"2-1-3-2-1-1\">\n                        <h1 class=\"font-heading text-[30px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-1-3-2-1-1-1\">\n                            Resumen operativo\n                        </h1>\n                        <p class=\"mt-2 text-[14px] text-[#475569]\" data-kid=\"2-1-3-2-1-1-2\">\n                            Salud de la plataforma y actividad reciente.\n                        </p>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"2-1-3-2-1-2\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-3-2-1-2-1\">\n                            Última sincronización\n                        </p>\n                        <p class=\"mt-1 text-[13px] font-semibold text-[#0F172A]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-1-2-2\" data-name=\"last sync time and status text\" data-reason=\"sync status text periodically updated by script\">\n                            Hace 4 min · estable\n                        </p>\n                    </div>\n                </div>\n                <section class=\"grid grid-cols-4 border-y border-[#CBD5E1] bg-white\" data-kid=\"2-1-3-2-2\" data-name=\"admin editorial metrics band\">\n                    <div class=\"min-h-[108px] border-r border-[#E2E8F0] px-5 py-5\" data-kid=\"2-1-3-2-2-1\">\n                        <p class=\"text-[12px] font-medium text-[#64748B]\" data-kid=\"2-1-3-2-2-1-1\">\n                            Usuarios\n                        </p>\n                        <div class=\"mt-2 flex items-end gap-3\" data-kid=\"2-1-3-2-2-1-2\">\n                            <strong class=\"font-heading text-[26px] font-bold tabular-nums text-[#0F172A]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-1-2-1\" data-name=\"total users count\" data-reason=\"count replaced by data fetched from API\">\n                                1,284\n                            </strong>\n                            <span class=\"mb-1 text-[12px] font-semibold text-[#10B981]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-1-2-2\" data-name=\"user growth percentage\" data-reason=\"percentage replaced by data fetched from API\">\n                                +8.4%\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-3\">\n                            vs. mes anterior\n                        </p>\n                    </div>\n                    <div class=\"min-h-[108px] border-r border-[#E2E8F0] px-5 py-5\" data-kid=\"2-1-3-2-2-2\">\n                        <p class=\"text-[12px] font-medium text-[#64748B]\" data-kid=\"2-1-3-2-2-2-1\">\n                            Talleres\n                        </p>\n                        <div class=\"mt-2 flex items-end gap-3\" data-kid=\"2-1-3-2-2-2-2\">\n                            <strong class=\"font-heading text-[26px] font-bold tabular-nums text-[#0F172A]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-2-2-1\" data-name=\"total workshops count\" data-reason=\"count replaced by data fetched from API\">\n                                86\n                            </strong>\n                            <span class=\"mb-1 text-[12px] font-semibold text-[#10B981]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-2-2-2\" data-name=\"workshop growth count\" data-reason=\"count replaced by data fetched from API\">\n                                +3\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-2-3\">\n                            aprobados este mes\n                        </p>\n                    </div>\n                    <div class=\"min-h-[108px] border-r border-[#E2E8F0] px-5 py-5\" data-kid=\"2-1-3-2-2-3\">\n                        <p class=\"text-[12px] font-medium text-[#64748B]\" data-kid=\"2-1-3-2-2-3-1\">\n                            Servicios este mes\n                        </p>\n                        <div class=\"mt-2 flex items-end gap-3\" data-kid=\"2-1-3-2-2-3-2\">\n                            <strong class=\"font-heading text-[26px] font-bold tabular-nums text-[#0F172A]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-3-2-1\" data-name=\"monthly services count\" data-reason=\"count replaced by data fetched from API\">\n                                642\n                            </strong>\n                            <span class=\"mb-1 text-[12px] font-semibold text-[#1E88E5]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-3-2-2\" data-name=\"monthly services growth percentage\" data-reason=\"percentage replaced by data fetched from API\">\n                                +5.1%\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-3-3\">\n                            últimos 30 días\n                        </p>\n                    </div>\n                    <div class=\"min-h-[108px] px-5 py-5\" data-kid=\"2-1-3-2-2-4\">\n                        <p class=\"text-[12px] font-medium text-[#64748B]\" data-kid=\"2-1-3-2-2-4-1\">\n                            Alertas abiertas\n                        </p>\n                        <div class=\"mt-2 flex items-end gap-3\" data-kid=\"2-1-3-2-2-4-2\">\n                            <strong class=\"font-heading text-[26px] font-bold tabular-nums text-[#991B1B]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-4-2-1\" data-name=\"open alerts count\" data-reason=\"count replaced by data fetched from API\">\n                                12\n                            </strong>\n                            <span class=\"mb-1 flex items-center gap-1 text-[12px] font-semibold text-[#EF4444]\" data-kid=\"2-1-3-2-2-4-2-2\">\n                                <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-3-2-2-4-2-2-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                requieren acción\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-4-3\">\n                            revisión prioritaria\n                        </p>\n                    </div>\n                </section>\n                <div class=\"mt-7 grid grid-cols-[1.3fr_0.7fr] gap-7\" data-kid=\"2-1-3-2-3\" data-name=\"admin trend and activity split\">\n                    <section class=\"border-y border-[#CBD5E1] bg-white px-5 py-5\" data-kid=\"2-1-3-2-3-1\" data-name=\"platform trend panel\">\n                        <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-1-3-2-3-1-1\">\n                            <div data-kid=\"2-1-3-2-3-1-1-1\">\n                                <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em] text-[#0F172A]\" data-kid=\"2-1-3-2-3-1-1-1-1\">\n                                    Usuarios y talleres\n                                </h2>\n                                <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1-1-2\">\n                                    Crecimiento acumulado · últimos seis meses\n                                </p>\n                            </div>\n                            <span class=\"flex items-center gap-3 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1-2\">\n                                <span class=\"flex items-center gap-1.5\" data-kid=\"2-1-3-2-3-1-1-2-1\">\n                                    <span class=\"size-2 rounded-full bg-[#1E88E5]\" data-kid=\"2-1-3-2-3-1-1-2-1-1\">\n                                    </span>\n                                    Usuarios\n                                </span>\n                                <span class=\"flex items-center gap-1.5\" data-kid=\"2-1-3-2-3-1-1-2-2\">\n                                    <span class=\"size-2 rounded-full bg-[#F59E0B]\" data-kid=\"2-1-3-2-3-1-1-2-2-1\">\n                                    </span>\n                                    Talleres\n                                </span>\n                            </span>\n                        </div>\n                        <div class=\"mt-5 h-[206px] w-full\" data-kid=\"2-1-3-2-3-1-2\">\n                            <canvas aria-label=\"Gráfico de crecimiento de usuarios y talleres\" data-dynamic=\"true\" data-kid=\"2-1-3-2-3-1-2-1\" data-name=\"growth trend chart\" data-reason=\"chart rendered into canvas by Chart.js library\" id=\"adminTrend\">\n                            </canvas>\n                        </div>\n                    </section>\n                    <section class=\"border-y border-[#CBD5E1] border-l border-[#E2E8F0] bg-white px-5 py-5\" data-kid=\"2-1-3-2-3-2\" data-name=\"recent activity panel\">\n                        <div class=\"flex items-start justify-between\" data-kid=\"2-1-3-2-3-2-2\">\n                            <div data-kid=\"2-1-3-2-3-2-2-1\">\n                                <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em] text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-2-1-1\">\n                                    Actividad reciente\n                                </h2>\n                                <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2-1-2\">\n                                    Eventos que requieren contexto\n                                </p>\n                            </div>\n                            <i class=\"ti ti-activity text-[18px] text-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-2-2\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <div class=\"mt-4 divide-y divide-[#E2E8F0]\" data-kid=\"2-1-3-2-3-2-1\" data-name=\"activity rows\">\n                            <div class=\"flex gap-3 py-3\" data-kid=\"2-1-3-2-3-2-1-1\">\n                                <i class=\"ti ti-circle-check mt-0.5 text-[18px] text-[#10B981]\" data-kid=\"2-1-3-2-3-2-1-1-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                <div class=\"min-w-0\" data-kid=\"2-1-3-2-3-2-1-1-2\">\n                                    <p class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-1-1-2-1\">\n                                        Nuevo taller aprobado\n                                    </p>\n                                    <p class=\"mt-0.5 truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-1-2-2\">\n                                        Taller Rápido · hace 8 min\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-3 py-3\" data-kid=\"2-1-3-2-3-2-1-2\">\n                                <i class=\"ti ti-flag-3 mt-0.5 text-[18px] text-[#F59E0B]\" data-kid=\"2-1-3-2-3-2-1-2-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                <div class=\"min-w-0\" data-kid=\"2-1-3-2-3-2-1-2-2\">\n                                    <p class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-1-2-2-1\">\n                                        Reseña reportada\n                                    </p>\n                                    <p class=\"mt-0.5 truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-2-2-2\">\n                                        MotorLab · hace 21 min\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-3 py-3\" data-kid=\"2-1-3-2-3-2-1-3\">\n                                <i class=\"ti ti-user-off mt-0.5 text-[18px] text-[#EF4444]\" data-kid=\"2-1-3-2-3-2-1-3-1\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                <div class=\"min-w-0\" data-kid=\"2-1-3-2-3-2-1-3-2\">\n                                    <p class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-1-3-2-1\">\n                                        Usuario bloqueado\n                                    </p>\n                                    <p class=\"mt-0.5 truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-3-2-2\">\n                                        Cuenta sospechosa · hace 44 min\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"mt-3 inline-flex min-h-12 items-center gap-2 text-[12px] font-bold text-[#1E88E5] hover:text-[#176FBB]\" data-kid=\"2-1-3-2-3-2-4\">\n                            Ver actividad completa\n                            <i class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"2-1-3-2-3-2-4-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </section>\n                </div>\n                <section class=\"mt-7 border-y border-[#CBD5E1] bg-white\" data-kid=\"2-1-3-2-4\" data-name=\"admin audit log table\" id=\"logs\">\n                    <div class=\"flex items-end justify-between gap-4 border-b border-[#E2E8F0] px-5 py-5\" data-kid=\"2-1-3-2-4-1\">\n                        <div data-kid=\"2-1-3-2-4-1-1\">\n                            <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em] text-[#0F172A]\" data-kid=\"2-1-3-2-4-1-1-1\">\n                                Últimos logs\n                            </h2>\n                            <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-4-1-1-2\">\n                                Traza de actividad administrativa reciente\n                            </p>\n                        </div>\n                        <a class=\"inline-flex min-h-12 items-center gap-2 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-4-1-2\" href=\"#logs\">\n                            Ver todos los logs\n                            <i class=\"ti ti-arrow-right text-[15px]\" data-kid=\"2-1-3-2-4-1-2-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"grid grid-cols-[90px_150px_minmax(0,1fr)_110px] border-b border-[#E2E8F0] px-5 py-3 text-[10px] font-bold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-3-2-4-2\">\n                        <span data-kid=\"2-1-3-2-4-2-1\">\n                            Hora\n                        </span>\n                        <span data-kid=\"2-1-3-2-4-2-2\">\n                            Actor\n                        </span>\n                        <span data-kid=\"2-1-3-2-4-2-3\">\n                            Evento\n                        </span>\n                        <span data-kid=\"2-1-3-2-4-2-4\">\n                            Estado\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-[90px_150px_minmax(0,1fr)_110px] items-center border-b border-[#E2E8F0] px-5 py-3.5 text-[12px]\" data-kid=\"2-1-3-2-4-3\">\n                        <span class=\"tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-4-3-1\">\n                            08:42\n                        </span>\n                        <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-3-2\">\n                            Superadmin\n                        </span>\n                        <span class=\"text-[#475569]\" data-kid=\"2-1-3-2-4-3-3\">\n                            Aprobó el registro de Taller Rápido\n                        </span>\n                        <span class=\"flex items-center gap-1.5 font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-4-3-4\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"2-1-3-2-4-3-4-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Completado\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-[90px_150px_minmax(0,1fr)_110px] items-center border-b border-[#E2E8F0] px-5 py-3.5 text-[12px]\" data-kid=\"2-1-3-2-4-4\">\n                        <span class=\"tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-4-4-1\">\n                            08:21\n                        </span>\n                        <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-4-2\">\n                            Moderación\n                        </span>\n                        <span class=\"text-[#475569]\" data-kid=\"2-1-3-2-4-4-3\">\n                            Marcó una reseña para revisión\n                        </span>\n                        <span class=\"flex items-center gap-1.5 font-semibold text-[#F59E0B]\" data-kid=\"2-1-3-2-4-4-4\">\n                            <i class=\"ti ti-clock\" data-kid=\"2-1-3-2-4-4-4-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Pendiente\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-[90px_150px_minmax(0,1fr)_110px] items-center px-5 py-3.5 text-[12px]\" data-kid=\"2-1-3-2-4-5\">\n                        <span class=\"tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-4-5-1\">\n                            07:58\n                        </span>\n                        <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-5-2\">\n                            Seguridad\n                        </span>\n                        <span class=\"text-[#475569]\" data-kid=\"2-1-3-2-4-5-3\">\n                            Bloqueó una cuenta por actividad sospechosa\n                        </span>\n                        <span class=\"flex items-center gap-1.5 font-semibold text-[#EF4444]\" data-kid=\"2-1-3-2-4-5-4\">\n                            <i class=\"ti ti-alert-circle\" data-kid=\"2-1-3-2-4-5-4-1\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Revisar\n                        </span>\n                    </div>\n                </section>\n                <p class=\"mt-6 pb-2 text-[11px] text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-1-3-2-5\" data-name=\"system status sync message\" data-reason=\"sync time updated periodically by script\">\n                    AutoDoc · Consola de administración · Datos sincronizados hace 4 min\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js\">\n</script>\n<script>\n    const trendCanvas = document.getElementById('adminTrend');\n  if (trendCanvas && window.Chart) {\n    new Chart(trendCanvas, {\n      type: 'line',\n      data: {\n        labels: ['Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago'],\n        datasets: [\n          { label: 'Usuarios', data: [920, 1008, 1088, 1160, 1220, 1284], borderColor: '#1E88E5', backgroundColor: 'rgba(30,136,229,0.08)', fill: true, tension: 0.32, pointRadius: 3, pointBackgroundColor: '#1E88E5', borderWidth: 2 },\n          { label: 'Talleres', data: [62, 68, 71, 77, 83, 86], borderColor: '#F59E0B', backgroundColor: 'transparent', fill: false, tension: 0.32, pointRadius: 3, pointBackgroundColor: '#F59E0B', borderWidth: 2 }\n        ]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: { legend: { display: false }, tooltip: { enabled: true } },\n        scales: { x: { grid: { display: false }, ticks: { color: '#64748B', font: { family: 'IBM Plex Sans', size: 11 } } }, y: { grid: { color: '#E2E8F0' }, ticks: { color: '#64748B', font: { family: 'IBM Plex Sans', size: 10 } }, border: { display: false } } }\n      }\n    });\n  }\n</script>\n",
