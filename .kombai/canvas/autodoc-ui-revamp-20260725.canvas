    "var_0342043cf2d3": {
      "type": "variant",
      "label": "AutoDoc About — Hadrian Light",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 107590,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"tabler icons library\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#F7F6F8] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"app background container\" style=\"font-family:'IBM Plex Sans',sans-serif\">\n    <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-[#F7F6F8] px-10\" data-kid=\"2-1\" data-name=\"about app bar\">\n        <div class=\"flex items-center gap-3\" data-kid=\"2-1-1\" data-name=\"navigation group\">\n            <button aria-label=\"Volver\" class=\"flex h-11 w-11 items-center justify-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-1-1-1\" data-name=\"back button\">\n                <i class=\"ti ti-arrow-left text-[18px]\" data-kid=\"2-1-1-1-1\" data-name=\"back arrow icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <h1 class=\"text-[18px] font-bold tracking-[-0.025em] text-[#0F172A]\" data-kid=\"2-1-1-2\" data-name=\"page title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                Acerca de AutoDoc\n            </h1>\n        </div>\n        <div class=\"flex items-center gap-3 text-[#5B6B80]\" data-kid=\"2-1-2\" data-name=\"utility buttons group\">\n            <button aria-label=\"Notificaciones\" class=\"flex h-11 w-11 items-center justify-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-2-1-1\" data-name=\"notification bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Cambiar tema\" class=\"flex h-11 w-11 items-center justify-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-1-2-2\" data-name=\"toggle theme button\">\n                <i class=\"ti ti-moon text-[18px]\" data-kid=\"2-1-2-2-1\" data-name=\"moon theme icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[720px] px-8 py-12\" data-kid=\"2-2\" data-name=\"about readable page body\">\n        <section class=\"flex flex-col items-center text-center\" data-kid=\"2-2-1\" data-name=\"about product identity\">\n            <div class=\"flex h-[112px] w-[112px] items-center justify-center rounded-full border border-[#522C81]/20 bg-[#522C81]/10 text-[#522C81] shadow-[0_8px_24px_rgba(82,44,129,0.10)]\" data-kid=\"2-2-1-1\" data-name=\"about vehicle icon identity\">\n                <i class=\"ti ti-car text-[58px]\" data-kid=\"2-2-1-1-1\" data-name=\"car icon\" style=\"width:58px;height:58px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <h2 class=\"mt-7 text-[32px] font-extrabold tracking-[-0.05em] text-[#0F172A]\" data-kid=\"2-2-1-2\" data-name=\"product name\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                AutoDoc\n            </h2>\n            <p class=\"mt-3 max-w-[520px] text-[16px] leading-6 text-[#5B6B80]\" data-kid=\"2-2-1-3\" data-name=\"product slogan\">\n                Tu copiloto digital para el cuidado del vehículo\n            </p>\n        </section>\n        <section class=\"mt-10 overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-2-2\" data-name=\"about information card\">\n            <div class=\"flex min-h-[68px] items-center justify-between gap-5 border-b border-[#CBD5E1] px-6 py-4\" data-kid=\"2-2-2-1\" data-name=\"about version row\">\n                <div class=\"flex items-center gap-4\" data-kid=\"2-2-2-1-1\" data-name=\"version label group\">\n                    <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#522C81]/10 text-[#522C81]\" data-kid=\"2-2-2-1-1-1\" data-name=\"version icon container\">\n                        <i class=\"ti ti-info-circle text-[19px]\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"info icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"text-[15px] font-semibold text-[#0F172A]\" data-kid=\"2-2-2-1-1-2\" data-name=\"version label\">\n                        Versión\n                    </span>\n                </div>\n                <span class=\"text-[14px] font-medium text-[#5B6B80]\" data-kid=\"2-2-2-1-2\" data-name=\"app version text\">\n                    —\n                </span>\n            </div>\n            <button class=\"flex min-h-[68px] w-full items-center justify-between gap-5 border-b border-[#CBD5E1] px-6 py-4 text-left\" data-kid=\"2-2-2-2\" data-name=\"about support row\">\n                <span class=\"flex items-center gap-4\" data-kid=\"2-2-2-2-1\" data-name=\"support label group\">\n                    <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#522C81]/10 text-[#522C81]\" data-kid=\"2-2-2-2-1-1\" data-name=\"support icon container\">\n                        <i class=\"ti ti-mail text-[19px]\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"mail icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"text-[15px] font-semibold text-[#0F172A]\" data-kid=\"2-2-2-2-1-2\" data-name=\"support label\">\n                        Soporte Técnico\n                    </span>\n                </span>\n                <i class=\"ti ti-arrow-up-right text-[18px] text-[#5B6B80]\" data-kid=\"2-2-2-2-2\" data-name=\"external link arrow icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button class=\"flex min-h-[68px] w-full items-center justify-between gap-5 border-b border-[#CBD5E1] px-6 py-4 text-left\" data-kid=\"2-2-2-3\" data-name=\"about privacy row\">\n                <span class=\"flex items-center gap-4\" data-kid=\"2-2-2-3-1\" data-name=\"privacy label group\">\n                    <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#522C81]/10 text-[#522C81]\" data-kid=\"2-2-2-3-1-1\" data-name=\"privacy icon container\">\n                        <i class=\"ti ti-shield-lock text-[19px]\" data-kid=\"2-2-2-3-1-1-1\" data-name=\"shield lock icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"text-[15px] font-semibold text-[#0F172A]\" data-kid=\"2-2-2-3-1-2\" data-name=\"privacy label\">\n                        Política de Privacidad\n                    </span>\n                </span>\n                <i class=\"ti ti-arrow-up-right text-[18px] text-[#5B6B80]\" data-kid=\"2-2-2-3-2\" data-name=\"external link arrow icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button class=\"flex min-h-[68px] w-full items-center justify-between gap-5 px-6 py-4 text-left\" data-kid=\"2-2-2-4\" data-name=\"about terms row\">\n                <span class=\"flex items-center gap-4\" data-kid=\"2-2-2-4-1\" data-name=\"terms label group\">\n                    <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#522C81]/10 text-[#522C81]\" data-kid=\"2-2-2-4-1-1\" data-name=\"terms icon container\">\n                        <i class=\"ti ti-gavel text-[19px]\" data-kid=\"2-2-2-4-1-1-1\" data-name=\"gavel icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"text-[15px] font-semibold text-[#0F172A]\" data-kid=\"2-2-2-4-1-2\" data-name=\"terms label\">\n                        Términos y Condiciones\n                    </span>\n                </span>\n                <i class=\"ti ti-arrow-up-right text-[18px] text-[#5B6B80]\" data-kid=\"2-2-2-4-2\" data-name=\"external link arrow icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </section>\n        <footer class=\"mt-10 border-t border-[#CBD5E1] pt-6 text-center text-[13px] leading-5 text-[#5B6B80]\" data-kid=\"2-2-3\" data-name=\"about copyright footer\">\n            <p data-kid=\"2-2-3-1\" data-name=\"copyright year text\">\n                © 2026 AutoDoc Inc.\n            </p>\n            <p data-kid=\"2-2-3-2\" data-name=\"copyright rights text\">\n                Todos los derechos reservados.\n            </p>\n        </footer>\n    </main>\n</div>\n",
