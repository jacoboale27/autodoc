    "var_d738b34ff9ec": {
      "type": "variant",
      "label": "AutoDoc Workshop Employees — Hadrian Dark Mobile",
      "parentId": "var_3436f5d3c8bd",
      "themeId": null,
      "rect": {
        "x": 79290,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"Application main wrapper\">\n    <header class=\"sticky top-0 z-20 border-b border-[#334155] bg-[#0B1220]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"Header section\">\n        <div class=\"flex min-h-10 items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"Header content container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"Branding and user info container\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[11px] bg-[#38BDF8] text-[16px] font-extrabold tracking-[-0.08em] text-[#082F49] shadow-[0_8px_24px_rgba(56,189,248,0.16)] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo initials\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"Workplace identity info\">\n                    <p class=\"truncate text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"Company name label\">\n                        Taller\n                    </p>\n                    <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-1-2-2\" data-name=\"Status indicator container\">\n                        <span class=\"truncate text-[15px] font-extrabold tracking-[-0.04em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"Workplace name\">\n                            Taller\n                            <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-1-2-2-1-1\" data-name=\"Workplace accent name\">\n                                Rápido\n                            </span>\n                        </span>\n                        <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-1-2-2-2\" data-name=\"Online status dot\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"Header action buttons container\">\n                <button aria-label=\"Cambiar tema\" class=\"flex h-11 w-11 items-center justify-center border border-[#475569] text-[17px] text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"Theme toggle button\">\n                    <i class=\"ti ti-sun-moon\" data-kid=\"2-1-1-2-1-1\" data-name=\"Moon-sun icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Notificaciones\" class=\"relative flex h-11 w-11 items-center justify-center border border-[#475569] text-[17px] text-[#CBD5E1]\" data-kid=\"2-1-1-2-2\" data-name=\"Notification button\">\n                    <i class=\"ti ti-bell\" data-kid=\"2-1-1-2-2-1\" data-name=\"Bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-2-2-2\" data-name=\"Notification badge indicator\">\n                    </span>\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-3 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-1-2\" data-name=\"Breadcrumb navigation\">\n            <span data-kid=\"2-1-2-1\" data-name=\"Breadcrumb home link\">\n                Taller\n            </span>\n            <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-1-2-2\" data-name=\"Breadcrumb separator icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"font-semibold text-[#E2E8F0]\" data-kid=\"2-1-2-3\" data-name=\"Current page title\">\n                Empleados\n            </span>\n        </div>\n    </header>\n    <main class=\"px-4 pb-32 pt-6\" data-kid=\"2-2\" data-name=\"Main content area\">\n        <section data-kid=\"2-2-1\" data-name=\"Page title and action section\">\n            <div class=\"flex flex-col gap-4\" data-kid=\"2-2-1-1\" data-name=\"Title and invite button stack\">\n                <div data-kid=\"2-2-1-1-1\" data-name=\"Page title container\">\n                    <h1 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[27px] font-extrabold leading-tight tracking-[-0.045em] text-white\" data-kid=\"2-2-1-1-1-1\" data-name=\"Main page heading\">\n                        Equipo del taller\n                    </h1>\n                    <p class=\"mt-2 text-[13px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-1-1-2\" data-name=\"Page description text\">\n                        Gestiona quién puede operar el panel y qué puede hacer.\n                    </p>\n                </div>\n                <button class=\"flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-4 py-3 text-[12px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-2-1-1-2\" data-name=\"invite employee button\">\n                    <i class=\"ti ti-user-plus text-[16px]\" data-kid=\"2-2-1-1-2-1\" data-name=\"User-plus icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Invitar empleado\n                </button>\n            </div>\n        </section>\n        <section aria-label=\"Filtros de empleados\" class=\"mt-6 border-y border-[#334155] py-4\" data-kid=\"2-2-2\" data-name=\"Employee search and filter section\">\n            <label class=\"relative block\" data-kid=\"2-2-2-1\" data-name=\"Search input container\">\n                <i class=\"ti ti-search pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[17px] text-[#64748B]\" data-kid=\"2-2-2-1-1\" data-name=\"Search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <input aria-label=\"Buscar empleado\" class=\"min-h-12 w-full border border-[#475569] bg-[#1E293B] pl-11 pr-4 text-[13px] text-[#F8FAFC] outline-hidden placeholder:text-[#64748B] focus:border-[#38BDF8]\" data-kid=\"2-2-2-1-2\" data-name=\"Search input field\" placeholder=\"Buscar por nombre o correo\" type=\"search\"/>\n            </label>\n            <div class=\"mt-3 grid grid-cols-2 gap-3\" data-kid=\"2-2-2-2\" data-name=\"Filter buttons grid\">\n                <button class=\"flex min-h-12 min-w-0 items-center justify-between gap-2 border border-[#475569] bg-[#1E293B] px-3 text-left text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-1\" data-name=\"Role filter button\">\n                    <span class=\"flex min-w-0 items-center gap-2\" data-kid=\"2-2-2-2-1-1\" data-name=\"Filter role inner container\">\n                        <i class=\"ti ti-adjustments-horizontal shrink-0 text-[16px] text-[#38BDF8]\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"Adjustments icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"truncate\" data-kid=\"2-2-2-2-1-1-2\" data-name=\"Filter role label\">\n                            Todos los roles\n                        </span>\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[14px] text-[#64748B]\" data-kid=\"2-2-2-2-1-2\" data-name=\"Dropdown arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-12 min-w-0 items-center justify-between gap-2 border border-[#475569] bg-[#1E293B] px-3 text-left text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-2\" data-name=\"Status filter button\">\n                    <span class=\"flex min-w-0 items-center gap-2\" data-kid=\"2-2-2-2-2-1\" data-name=\"Filter status inner container\">\n                        <i class=\"ti ti-activity shrink-0 text-[16px] text-[#38BDF8]\" data-kid=\"2-2-2-2-2-1-1\" data-name=\"Activity icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"truncate\" data-kid=\"2-2-2-2-2-1-2\" data-name=\"Filter status label\">\n                            Todos los estados\n                        </span>\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[14px] text-[#64748B]\" data-kid=\"2-2-2-2-2-2\" data-name=\"Dropdown arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"mt-3 text-right text-[12px] tabular-nums text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-2-2-3\" data-name=\"Employee count text\" data-reason=\"text updated when employee search results change\">\n                3 empleados\n            </div>\n        </section>\n        <section aria-labelledby=\"employees-mobile-heading\" class=\"mt-6\" data-kid=\"2-2-3\" data-name=\"Employees list container\">\n            <div class=\"border-y border-[#475569]\" data-kid=\"2-2-3-1\" data-name=\"Employees grid\">\n                <div class=\"flex flex-col gap-2 border-b border-[#334155] px-4 py-4\" data-kid=\"2-2-3-1-1\" data-name=\"List header section\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-1-1-1\" data-name=\"List title and sync status container\">\n                        <div data-kid=\"2-2-3-1-1-1-1\" data-name=\"Employees heading section\">\n                            <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[17px] font-bold text-white\" data-kid=\"2-2-3-1-1-1-1-1\" data-name=\"Employees list heading\" id=\"employees-mobile-heading\">\n                                Cuentas del taller\n                            </h2>\n                            <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-3-1-1-1-1-2\" data-name=\"Employees list description\">\n                                Permisos y acceso de las personas vinculadas.\n                            </p>\n                        </div>\n                        <span class=\"shrink-0 pt-1 text-right text-[10px] font-semibold leading-4 text-[#34D399]\" data-dynamic=\"true\" data-kid=\"2-2-3-1-1-1-2\" data-name=\"Sync status text\" data-reason=\"timestamp updated every few minutes by script\">\n                            Sincronizado\n                            <br data-kid=\"2-2-3-1-1-1-2-1\" data-name=\"Line break\"/>\n                            hace 4 min\n                        </span>\n                    </div>\n                </div>\n                <article class=\"border-b border-[#334155] px-4 py-4\" data-kid=\"2-2-3-1-2\" data-name=\"First employee card\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"2-2-3-1-2-1\" data-name=\"Employee basic info header\">\n                        <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-2-3-1-2-1-1\" data-name=\"Employee avatar initial\">\n                            MR\n                        </div>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"2-2-3-1-2-1-2\" data-name=\"Employee identity details\">\n                            <div class=\"truncate text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"2-2-3-1-2-1-2-1\" data-name=\"Employee full name\">\n                                María Rodríguez\n                            </div>\n                            <div class=\"mt-0.5 truncate text-[11px] text-[#64748B]\" data-kid=\"2-2-3-1-2-1-2-2\" data-name=\"Employee email\">\n                                maria.rodriguez@tallerrapido.co\n                            </div>\n                        </div>\n                        <button aria-label=\"Acciones para María Rodríguez\" class=\"flex h-11 w-11 shrink-0 items-center justify-center text-[17px] text-[#94A3B8]\" data-kid=\"2-2-3-1-2-1-3\" data-name=\"Employee menu button\">\n                            <i class=\"ti ti-dots\" data-kid=\"2-2-3-1-2-1-3-1\" data-name=\"Options dots icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-x-3 gap-y-3 border-t border-[#334155] pt-3\" data-kid=\"2-2-3-1-2-2\" data-name=\"Employee stats container\">\n                        <div data-kid=\"2-2-3-1-2-2-1\" data-name=\"Role stat column\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-1-2-2-1-1\" data-name=\"Stat label\">\n                                Rol\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#CBD5E1]\" data-kid=\"2-2-3-1-2-2-1-2\" data-name=\"Stat value\">\n                                Administradora\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-3-1-2-2-2\" data-name=\"Status stat column\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-1-2-2-2-1\" data-name=\"Stat label\">\n                                Estado\n                            </p>\n                            <p class=\"mt-1 inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#6EE7B7]\" data-kid=\"2-2-3-1-2-2-2-2\" data-name=\"Status badge\">\n                                <i class=\"ti ti-circle-check text-[15px]\" data-kid=\"2-2-3-1-2-2-2-2-1\" data-name=\"Status check icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Activa\n                            </p>\n                        </div>\n                        <div class=\"col-span-2\" data-kid=\"2-2-3-1-2-2-3\" data-name=\"Last access stat row\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-1-2-2-3-1\" data-name=\"Stat label\">\n                                Último acceso\n                            </p>\n                            <p class=\"mt-1 text-[12px] tabular-nums text-[#94A3B8]\" data-kid=\"2-2-3-1-2-2-3-2\" data-name=\"Last access time\">\n                                Hoy · 09:12\n                            </p>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"border-b border-[#334155] px-4 py-4\" data-kid=\"2-2-3-1-3\" data-name=\"Second employee card\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"2-2-3-1-3-1\" data-name=\"Employee basic info header\">\n                        <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#075985] text-[12px] font-bold text-[#BAE6FD]\" data-kid=\"2-2-3-1-3-1-1\" data-name=\"Employee avatar initial\">\n                            CM\n                        </div>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"2-2-3-1-3-1-2\" data-name=\"Employee identity details\">\n                            <div class=\"truncate text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"2-2-3-1-3-1-2-1\" data-name=\"Employee full name\">\n                                Carlos Méndez\n                            </div>\n                            <div class=\"mt-0.5 truncate text-[11px] text-[#64748B]\" data-kid=\"2-2-3-1-3-1-2-2\" data-name=\"Employee email\">\n                                carlos.mendez@tallerrapido.co\n                            </div>\n                        </div>\n                        <button aria-label=\"Acciones para Carlos Méndez\" class=\"flex h-11 w-11 shrink-0 items-center justify-center text-[17px] text-[#94A3B8]\" data-kid=\"2-2-3-1-3-1-3\" data-name=\"Employee menu button\">\n                            <i class=\"ti ti-dots\" data-kid=\"2-2-3-1-3-1-3-1\" data-name=\"Options dots icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-x-3 gap-y-3 border-t border-[#334155] pt-3\" data-kid=\"2-2-3-1-3-2\" data-name=\"Employee stats container\">\n                        <div data-kid=\"2-2-3-1-3-2-1\" data-name=\"Role stat column\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-1-3-2-1-1\" data-name=\"Stat label\">\n                                Rol\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#CBD5E1]\" data-kid=\"2-2-3-1-3-2-1-2\" data-name=\"Stat value\">\n                                Mecánico\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-3-1-3-2-2\" data-name=\"Status stat column\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-1-3-2-2-1\" data-name=\"Stat label\">\n                                Estado\n                            </p>\n                            <p class=\"mt-1 inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#6EE7B7]\" data-kid=\"2-2-3-1-3-2-2-2\" data-name=\"Status badge\">\n                                <i class=\"ti ti-circle-check text-[15px]\" data-kid=\"2-2-3-1-3-2-2-2-1\" data-name=\"Status check icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Activo\n                            </p>\n                        </div>\n                        <div class=\"col-span-2\" data-kid=\"2-2-3-1-3-2-3\" data-name=\"Last access stat row\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-1-3-2-3-1\" data-name=\"Stat label\">\n                                Último acceso\n                            </p>\n                            <p class=\"mt-1 text-[12px] tabular-nums text-[#94A3B8]\" data-kid=\"2-2-3-1-3-2-3-2\" data-name=\"Last access time\">\n                                Ayer · 17:40\n                            </p>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"px-4 py-4\" data-kid=\"2-2-3-1-4\" data-name=\"Third employee card\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"2-2-3-1-4-1\" data-name=\"Employee basic info header\">\n                        <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#3F2D12] text-[12px] font-bold text-[#FCD34D]\" data-kid=\"2-2-3-1-4-1-1\" data-name=\"Employee avatar initial\">\n                            CL\n                        </div>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"2-2-3-1-4-1-2\" data-name=\"Employee identity details\">\n                            <div class=\"truncate text-[13px] font-semibold text-[#F8FAFC]\" data-kid=\"2-2-3-1-4-1-2-1\" data-name=\"Employee full name\">\n                                Carlos López\n                            </div>\n                            <div class=\"mt-0.5 truncate text-[11px] text-[#64748B]\" data-kid=\"2-2-3-1-4-1-2-2\" data-name=\"Employee email\">\n                                carlos.lopez@tallerrapido.co\n                            </div>\n                        </div>\n                        <button aria-label=\"Acciones para Carlos López\" class=\"flex h-11 w-11 shrink-0 items-center justify-center text-[17px] text-[#94A3B8]\" data-kid=\"2-2-3-1-4-1-3\" data-name=\"Employee menu button\">\n                            <i class=\"ti ti-dots\" data-kid=\"2-2-3-1-4-1-3-1\" data-name=\"Options dots icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-x-3 gap-y-3 border-t border-[#334155] pt-3\" data-kid=\"2-2-3-1-4-2\" data-name=\"Employee stats container\">\n                        <div data-kid=\"2-2-3-1-4-2-1\" data-name=\"Role stat column\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-1-4-2-1-1\" data-name=\"Stat label\">\n                                Rol\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#CBD5E1]\" data-kid=\"2-2-3-1-4-2-1-2\" data-name=\"Stat value\">\n                                Técnico\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-3-1-4-2-2\" data-name=\"Status stat column\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-1-4-2-2-1\" data-name=\"Stat label\">\n                                Estado\n                            </p>\n                            <p class=\"mt-1 inline-flex items-center gap-1.5 text-[12px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-3-1-4-2-2-2\" data-name=\"Status badge\">\n                                <i class=\"ti ti-clock text-[15px]\" data-kid=\"2-2-3-1-4-2-2-2-1\" data-name=\"Status clock icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Pendiente\n                            </p>\n                        </div>\n                        <div class=\"col-span-2\" data-kid=\"2-2-3-1-4-2-3\" data-name=\"Last access stat row\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-1-4-2-3-1\" data-name=\"Stat label\">\n                                Último acceso\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-1-4-2-3-2\" data-name=\"Last access date\">\n                                Invitación enviada · 13 ago\n                            </p>\n                        </div>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section aria-label=\"Paginación de empleados\" class=\"flex flex-col gap-4 border-b border-[#334155] px-0 py-4\" data-kid=\"2-2-4\" data-name=\"Pagination section\">\n            <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-2-4-1\" data-name=\"Pagination status\">\n                Mostrando 1–3 de 3 empleados\n            </span>\n            <div class=\"grid grid-cols-[1fr_48px_1fr] gap-2\" data-kid=\"2-2-4-2\" data-name=\"Pagination controls\">\n                <button class=\"flex min-h-12 items-center justify-center gap-1 border border-[#334155] px-2 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-2-4-2-1\" data-name=\"Previous page button\" disabled=\"\">\n                    <i class=\"ti ti-chevron-left text-[14px]\" data-kid=\"2-2-4-2-1-1\" data-name=\"Chevron left icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Anterior\n                </button>\n                <span class=\"flex min-h-12 items-center justify-center bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-2-4-2-2\" data-name=\"Current page number badge\">\n                    1\n                </span>\n                <button aria-label=\"Siguiente página\" class=\"flex min-h-12 items-center justify-center gap-1 border border-[#475569] px-2 text-[11px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-4-2-3\" data-name=\"Next page button\">\n                    Siguiente\n                    <i class=\"ti ti-chevron-right text-[14px]\" data-kid=\"2-2-4-2-3-1\" data-name=\"Chevron right icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <p class=\"mt-5 flex items-start gap-2 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-5\" data-name=\"Informational message\">\n            <i class=\"ti ti-info-circle mt-0.5 shrink-0 text-[15px] text-[#38BDF8]\" data-kid=\"2-2-5-1\" data-name=\"Information circle icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span data-kid=\"2-2-5-2\" data-name=\"Information text\">\n                Las cuentas activas pueden operar el panel según el rol asignado.\n            </span>\n        </p>\n        <footer class=\"mt-8 flex flex-col gap-2 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"Footer content\">\n            <span data-kid=\"2-2-6-1\" data-name=\"Platform copyright text\">\n                AutoDoc · Gestión operativa del taller\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-2-6-2\" data-name=\"Sync status text container\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-6-2-1\" data-name=\"Sync status dot\">\n                </span>\n                Datos sincronizados hace 4 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación móvil del taller\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#0B1220]/98 px-2 pt-2 shadow-[0_-8px_24px_rgba(2,6,23,0.24)]\" data-kid=\"2-3\" data-name=\"Mobile navigation bar\" style=\"padding-bottom:max(10px,env(safe-area-inset-bottom))\">\n        <div class=\"grid grid-cols-5 gap-1\" data-kid=\"2-3-1\" data-name=\"Mobile navigation links grid\">\n            <a class=\"flex min-h-12 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" data-name=\"Dashboard nav item\" href=\"#panel\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"2-3-1-1-1\" data-name=\"Dashboard icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"Dashboard label\">\n                    Panel\n                </span>\n            </a>\n            <a class=\"relative flex min-h-12 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"Repairs nav item\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[18px]\" data-kid=\"2-3-1-2-1\" data-name=\"Repairs icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"Repairs label\">\n                    Reparaciones\n                </span>\n                <span class=\"absolute right-2 top-1 text-[9px] font-bold text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-3-1-2-3\" data-name=\"Repairs notification count\" data-reason=\"count badge updated by notification script\">\n                    07\n                </span>\n            </a>\n            <a class=\"flex min-h-12 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"Search nav item\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[18px]\" data-kid=\"2-3-1-3-1\" data-name=\"Search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"Search label\">\n                    Buscar\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-12 flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] text-[#38BDF8]\" data-kid=\"2-3-1-4\" data-name=\"Employees nav item\" href=\"#empleados\">\n                <i class=\"ti ti-users text-[18px]\" data-kid=\"2-3-1-4-1\" data-name=\"Employees icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-4-2\" data-name=\"Employees label\">\n                    Empleados\n                </span>\n            </a>\n            <a class=\"flex min-h-12 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-5\" data-name=\"Settings nav item\" href=\"#configuracion\">\n                <i class=\"ti ti-settings text-[18px]\" data-kid=\"2-3-1-5-1\" data-name=\"Settings icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-5-2\" data-name=\"Settings label\">\n                    Configuración\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
