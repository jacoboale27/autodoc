    "var_2c913bd5d78e": {
      "type": "variant",
      "label": "AutoDoc Workshop Settings — Hadrian Dark",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 98315,
        "y": 0,
        "w": 1280,
        "h": 800
