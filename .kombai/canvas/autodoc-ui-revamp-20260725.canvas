        "x": 6945,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#E2E8F0] antialiased [font-family:'IBM_Plex_Sans',sans-serif]\" data-kid=\"2\" data-name=\"page layout container\">\n    <header aria-label=\"Encabezado de AutoDoc\" class=\"sticky top-0 z-30 flex min-h-16 items-center justify-between border-b border-[#334155] bg-[#020617] px-4 py-3\" data-kid=\"2-1\" data-name=\"header section\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"brand logo and profile name container\">\n            <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#082F49] shadow-[0_8px_24px_rgba(56,189,248,0.16)]\" data-kid=\"2-1-1-1\" data-name=\"brand logo avatar container\">\n                <span class=\"text-[18px] font-extrabold tracking-[-0.08em] [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-1-1\" data-name=\"brand logo initials\">\n                    AD\n                </span>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"profile information text container\">\n                <p class=\"truncate text-[10px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"profile type label\">\n                    Propietario\n                </p>\n                <h1 class=\"truncate text-[17px] font-extrabold tracking-[-0.04em] text-white [font-family:'Plus_Jakarta_Sans',sans-serif]\" data-kid=\"2-1-1-2-2\" data-name=\"page title header\">\n                    Conversaciones\n                </h1>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"header action buttons container\">\n            <button aria-label=\"Cambiar tema\" class=\"flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-2-1\" data-name=\"theme toggle button\">\n                <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-2-1-1\" data-name=\"sun moon theme icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1-2-2\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-1-2-2-1\" data-name=\"notifications bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-2\" data-name=\"notification indicator dot\">\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"px-4 pb-32\" data-kid=\"2-2\" data-name=\"main content area\">\n        <section aria-label=\"Lista de conversaciones\" class=\"border-b border-[#334155] py-5\" data-kid=\"2-2-1\" data-name=\"conversations list section\">\n            <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-1-1\" data-name=\"recent conversations header container\">\n                <div data-kid=\"2-2-1-1-1\" data-name=\"recent conversations title container\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-1-1-1-1\" data-name=\"recent conversations label\">\n                        Recientes\n                    </p>\n                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-1-1-1-2\" data-name=\"recent conversations description\">\n                        Mensajes de tus talleres\n                    </p>\n                </div>\n                <button aria-label=\"Nueva conversación\" class=\"flex min-h-11 min-w-11 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"2-2-1-1-2\" data-name=\"new conversation button\">\n                    <i class=\"ti ti-edit text-[17px]\" data-kid=\"2-2-1-1-2-1\" data-name=\"new conversation edit icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"relative mt-4\" data-kid=\"2-2-1-2\" data-name=\"search input container\">\n                <i class=\"ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-[16px] text-[#64748B]\" data-kid=\"2-2-1-2-1\" data-name=\"search magnifying glass icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <input aria-label=\"Buscar conversación\" class=\"h-11 w-full border border-[#334155] bg-[#111827] pl-10 pr-3 text-[12px] text-[#E2E8F0] outline-none placeholder:text-[#64748B]\" data-kid=\"2-2-1-2-2\" data-name=\"search conversation input field\" placeholder=\"Buscar conversación\"/>\n            </div>\n            <div class=\"mt-4 flex items-center justify-between\" data-kid=\"2-2-1-3\" data-name=\"conversations count header container\">\n                <span class=\"text-[11px] font-semibold uppercase tracking-[0.14em] 