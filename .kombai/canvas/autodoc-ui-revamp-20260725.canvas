      "html": "<link data-kid=\"1\" data-name=\"Tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component tokens dark\">\n    button { min-height:44px; min-width:44px; border-radius:999px !important; transition:transform 150ms cubic-bezier(.23,1,.32,1),box-shadow 150ms cubic-bezier(.23,1,.32,1),background-color 150ms cubic-bezier(.23,1,.32,1),color 150ms cubic-bezier(.23,1,.32,1); }\n  button:active { transform:scale(.97); }\n  button:hover { box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  button[data-name*=\"primary button\"], button[data-name*=\"create user button\"] { background:linear-gradient(135deg,#81E6D9,#6FC8BC) !important; color:#0F172A !important; border:0 !important; box-shadow:0 2px 4px rgba(0,0,0,.20); }\n  button[data-name*=\"refresh\"], button[data-name*=\"export\"], button[data-name*=\"filter\"], button[data-name*=\"page\"] { background:#141E36 !important; border:1px solid rgba(51,65,85,.20) !important; color:#E2E8F0 !important; box-shadow:0 2px 4px rgba(0,0,0,.20); }\n  button[aria-label*=\"Notificaciones\"], button[aria-label*=\"Cambiar tema\"], button[aria-label*=\"Abrir perfil\"], button[aria-label*=\"Más acciones\"], button[aria-label*=\"Página\"] { background:#141E36 !important; border:1px solid rgba(51,65,85,.20) !important; }\n  section[data-name*=\"metrics\"], section[data-name*=\"panel\"], section[data-name*=\"Logs\"], section[data-name*=\"logs\"], section[data-name*=\"table\"], article[data-name*=\"user card\"] { background:#141E36; border-color:rgba(51,65,85,.20) !important; border-radius:16px; box-shadow:0 2px 4px rgba(0,0,0,.20); overflow:hidden; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#E2E8F0] antialiased\" data-kid=\"2\" data-name=\"mobile admin users application root\">\n    <header class=\"sticky top-0 z-20 border-b border-[#334155] bg-[#0B1220]/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile admin users top bar\">\n        <div class=\"flex h-[68px] items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"mobile top bar row\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"mobile brand and context group\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc mobile logo\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"mobile admin context\">\n                    <div class=\"truncate text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"mobile role label\">\n                        Administración\n                    </div>\n                    <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-1-2-2\" data-name=\"mobile screen context row\">\n                        <span class=\"truncate font-heading text-[16px] font-bold tracking-[-0.03em] text-[#F8FAFC]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"mobile screen title\">\n                            Usuarios\n                        </span>\n                        <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-1-2-2-2\" data-name=\"admin status indicator\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"mobile header actions\">\n       