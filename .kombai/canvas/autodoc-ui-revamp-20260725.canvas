 data-name=\"inline SOAT alert\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"2-1-3-2-3-1-2-1\" data-name=\"alert message block\">\n                                <i class=\"ti ti-shield-exclamation mt-0.5 text-[17px] text-[#FCA5A5]\" data-kid=\"2-1-3-2-3-1-2-1-1\" data-name=\"alert shield icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                <div data-kid=\"2-1-3-2-3-1-2-1-2\" data-name=\"alert text content\">\n                                    <div class=\"text-[12px] font-bold text-[#FCA5A5]\" data-kid=\"2-1-3-2-3-1-2-1-2-1\" data-name=\"alert action label\">\n                                        Acción requerida: SOAT vencido\n                                    </div>\n                                    <div class=\"mt-1 text-[11px] text-[#FECACA]\" data-kid=\"2-1-3-2-3-1-2-1-2-2\" data-name=\"alert sub-text\">\n                                        Renueva la póliza para mantener tu vehículo en regla.\n                                    </div>\n                                </div>\n                            </div>\n                            <button class=\"flex min-h-12 shrink-0 items-center border border-[#F87171] px-3 text-[11px] font-bold text-[#FCA5A5]\" data-kid=\"2-1-3-2-3-1-2-2\" data-name=\"resolve alert button\">\n                                Resolver ahora\n                            </button>\n                        </div>\n                    </section>\n                    <aside class=\"border-l border-[#334155] pl-6\" data-kid=\"2-1-3-2-3-2\" data-name=\"expense summary aside\">\n                        <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.02em] text-[#F8FAFC]\" data-kid=\"2-1-3-2-3-2-1\" data-name=\"expense summary heading\">\n                            Resumen de gastos\n                        </h2>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-3-2-2\" data-name=\"expense summary sub-label\">\n                            Mantenimiento acumulado\n                        </p>\n                        <div class=\"mt-5 border-y border-[#475569]\" data-kid=\"2-1-3-2-3-2-3\" data-name=\"stats list container\">\n                            <div class=\"border-b border-[#334155] py-3.5\" data-kid=\"2-1-3-2-3-2-3-1\" data-name=\"total expense stat\">\n                                <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-3-1-1\" data-name=\"total expense label\">\n                                    Total mantenimiento\n                                </div>\n                                <div class=\"mt-1 text-[22px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-1-3-2-3-2-3-1-2\" data-name=\"total expense value\">\n                                    $684.50\n                                </div>\n                            </div>\n                            <div class=\"border-b border-[#334155] py-3.5\" data-kid=\"2-1-3-2-3-2-3-2\" data-name=\"service count stat\">\n                                <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-3-2-1\" data-name=\"service count label\">\n                                    Servicios registrados\n                                </div>\n                                <div class=\"mt-1 text-[17px] font-bold tabular-nums text-[#CBD5E1]\" data-kid=\"2-1-3-2-3-2-3-2-2\" data-name=\"service count value\">\n                                    7\n                                </div>\n                            </div>\n                            <div class=\"py-3.5\" data-kid=\"2-1-3-2-3-2-3-3\" data-name=\"average visit stat\">\n                                <div class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-3-3-1\" data-name=\"average visit label\">\n                                    Promedio por visita\n                                </div>\n                                <div class=\"mt-1 text-[17px] font-bold tabular-nums text-[#38BDF8]\" data-kid=\"2-1-3-2-3-2-3-3-2\" data-name=\"average visit value\">\n                                    $97.79\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"mt-4 flex min-h-12 items-center gap-2 text-[11px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-3-2-4\" data-name=\"view history button\">\n                            Ver historial completo\n                            <i class=\"ti ti-arrow-right text-[14px]\" data-kid=\"2-1-3-2-3-2-4-1\" data-name=\"view history icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </aside>\n                </div>\n                <div class=\"mt-7 grid grid-cols-[1.38fr_0.62fr] gap-7\" data-kid=\"2-1-3-2-4\" data-name=\"history and documents row\">\n                    <section data-kid=\"2-1-3-2-4-1\" data-name=\"recent history timeline\">\n                        <div class=\"mb-3 flex items-center justify-between\" data-kid=\"2-1-3-2-4-1-1\" data-name=\"history header\">\n                            <div data-kid=\"2-1-3-2-4-1-1-1\" data-name=\"history title block\">\n                                <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.02em] text-[#F8FAFC]\" data-kid=\"2-1-3-2-4-1-1-1-1\" data-name=\"history heading\">\n                                    Historial reciente\n                                </h2>\n                                <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-1-1-2\" data-name=\"history description\">\n                                    Últimos servicios registrados para tu vehículo.\n                                </p>\n                            </div>\n                            <button class=\"text-[11px] font-semibold text-[#38BDF8]\" data-kid=\"2-1-3-2-4-1-1-2\" data-name=\"view all history button\">\n                                Ver todo\n                            </button>\n                        </div>\n                        <div class=\"border-y border-[#475569]\" data-kid=\"2-1-3-2-4-1-2\" data-name=\"history list\">\n                            <div class=\"grid grid-cols-[92px_1fr_112px] items-center border-b border-[#334155] px-4 py-3.5\" data-kid=\"2-1-3-2-4-1-2-1\" data-name=\"history item 1\">\n                                <div class=\"text-[11px] font-semibold tabular-nums text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-2-1-1\" data-name=\"history item date\">\n                                    12 jun 2026\n                                </div>\n                                <div data-kid=\"2-1-3-2-4-1-2-1-2\" data-name=\"history item details\">\n                                    <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-1-2-1-2-1\" data-name=\"history item title\">\n                                        Servicio preventivo\n                                    </div>\n                                    <div class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-4-1-2-1-2-2\" data-name=\"history item subtitle\">\n                                        Taller Rápido · Cambio de aceite y filtros\n                                    </div>\n                                </div>\n                                <div class=\"text-right text-[12px] font-bold tabular-nums text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-1-2-1-3\" data-name=\"history item cost\">\n                                    $97.79\n                                </div>\n                            </div>\n                            <div class=\"grid grid-cols-[92px_1fr_112px] items-center border-b border-[#334155] px-4 py-3.5\" data-kid=\"2-1-3-2-4-1-2-2\" data-name=\"history item 2\">\n                                <div class=\"text-[11px] font-semibold tabular-nums text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-2-2-1\" data-name=\"history item date\">\n                                    18 mar 2026\n                                </div>\n                                <div data-kid=\"2-1-3-2-4-1-2-2-2\" data-name=\"history item details\">\n                                    <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-1-2-2-2-1\" data-name=\"history item title\">\n                                        Revisión de frenos\n                                    </div>\n                                    <div class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-4-1-2-2-2-2\" data-name=\"history item subtitle\">\n                                        MotorLab · Pastillas inspeccionadas\n                                    </div>\n                                </div>\n                                <div class=\"text-right text-[12px] font-bold tabular-nums text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-1-2-2-3\" data-name=\"history item cost\">\n                                    $140.00\n                                </div>\n                            </div>\n                            <div class=\"grid grid-cols-[92px_1fr_112px] items-center px-4 py-3.5\" data-kid=\"2-1-3-2-4-1-2-3\" data-name=\"history item 3\">\n                                <div class=\"text-[11px] font-semibold tabular-nums text-[#94A3B8]\" data-kid=\"2-1-3-2-4-1-2-3-1\" data-name=\"history item date\">\n                                    04 ene 2026\n                                </div>\n                                <div data-kid=\"2-1-3-2-4-1-2-3-2\" data-name=\"history item details\">\n                                    <div class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-1-2-3-2-1\" data-name=\"history item title\">\n                                        Diagnóstico general\n                                    </div>\n                                    <div class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-4-1-2-3-2-2\" data-name=\"history item subtitle\">\n                                        Taller Rápido · Inspección multipunto\n                                    </div>\n                                </div>\n                                <div class=\"text-right text-[12px] font-bold tabular-nums text-[#CBD5E1]\" data-kid=\"2-1-3-2-4-1-2-3-3\" data-name=\"history item cost\">\n                                    $82.50\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                    <aside data-kid=\"2-1-3-2-4-2\" data-name=\"vehicle documents\">\n                        <div class=\"mb-3\" data-kid=\"2-1-3-2-4-2-1\" data-name=\"documents header\">\n                            <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.02em] text-[#F8FAFC]\" data-kid=\"2-1-3-2-4-2-1-1\" data-name=\"documents heading\">\n                                Documentos\n                            </h2>\n                            <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-4-2-1-2\" data-name=\"documents description\">\n                                Vigencia y acceso rápido.\n                            </p>\n                        </div>\n                        <div class=\"border-y border-[#475569]\" data-kid=\"2-1-3-2-4-2-2\" data-name=\"documents list\">\n                            <div class=\"flex items-center justify-between border-b border-[#334155] py-3.5\" data-kid=\"2-1-3-2-4-2-2-1\" data-name=\"document row soat\">\n                                <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-4-2-2-1-1\" data-name=\"document icon row\">\n                                    <i class=\"ti ti-file-certificate text-[18px] text-[#F87171]\" data-kid=\"2-1-3-2-4-2-2-1-1-1\" data-name=\"document icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <div data-kid=\"2-1-3-2-4-2-2-1-1-2\" data-name=\"document info block\">\n                                        <div class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-2-2-1-1-2-1\" data-name=\"document title\">\n                                            SOAT\n                                        </div>\n                                        <div class=\"mt-0.5 text-[11px] text-[#FCA5A5]\" data-kid=\"2-1-3-2-4-2-2-1-1-2-2\" data-name=\"document status\">\n                                            Vencido · 18 ago 2026\n                                        </div>\n                                    </div>\n                                </div>\n                                <button aria-label=\"Actualizar SOAT\" class=\"flex h-12 w-12 items-center justify-center text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-2-1-2\" data-name=\"edit document button\">\n                                    <i class=\"ti ti-pencil text-[16px]\" data-kid=\"2-1-3-2-4-2-2-1-2-1\" data-name=\"edit icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </button>\n                            </div>\n                            <div class=\"flex items-center justify-between py-3.5\" data-kid=\"2-1-3-2-4-2-2-2\" data-name=\"document row tecno\">\n                                <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-4-2-2-2-1\" data-name=\"document icon row\">\n                                    <i class=\"ti ti-file-check text-[18px] text-[#34D399]\" data-kid=\"2-1-3-2-4-2-2-2-1-1\" data-name=\"document icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                    <div data-kid=\"2-1-3-2-4-2-2-2-1-2\" data-name=\"document info block\">\n                                        <div class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-3-2-4-2-2-2-1-2-1\" data-name=\"document title\">\n                                            Tecnomecánica\n                                        </div>\n                                        <div class=\"mt-0.5 text-[11px] text-[#6EE7B7]\" data-kid=\"2-1-3-2-4-2-2-2-1-2-2\" data-name=\"document status\">\n                                            Vigente · 10 dic 2026\n                                        </div>\n                                    </div>\n                                </div>\n                                <button aria-label=\"Actualizar Tecnomecánica\" class=\"flex h-12 w-12 items-center justify-center text-[#38BDF8]\" data-kid=\"2-1-3-2-4-2-2-2-2\" data-name=\"edit document button\">\n                                    <i class=\"ti ti-pencil text-[16px]\" data-kid=\"2-1-3-2-4-2-2-2-2-1\" data-name=\"edit icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </button>\n                            </div>\n                        </div>\n                    </aside>\n                </div>\n                <footer class=\"mt-7 flex items-center justify-between border-t border-[#334155] pt-4 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-5\" data-name=\"profile footer\">\n                    <span data-kid=\"2-1-3-2-5-1\" data-name=\"footer copy\">\n                        AutoDoc · Ficha técnica del vehículo\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-1-3-2-5-2\" data-name=\"sync status\" data-reason=\"time replaced by script\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-3-2-5-2-1\" data-name=\"sync status dot\">\n                        </span>\n                        Datos sincronizados hace 4 min\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
