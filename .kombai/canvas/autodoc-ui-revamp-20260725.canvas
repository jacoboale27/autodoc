      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  aside button { min-width: 44px; min-height: 44px; border: 1px solid rgba(203,213,225,.4); border-radius: 9999px; background: #EEEDF0; box-shadow: 0 2px 4px rgba(15,23,42,.05); transition: transform 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  aside button:hover { background: #E2D9EE; box-shadow: 0 6px 14px rgba(15,23,42,.10); }\n  aside button:active { transform: scale(.97); }\n  aside button[class*=\"bg-[#1E88E5]\"] { background: #1E88E5; border-color: #1E88E5; color: #FFFFFF; }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"alerts page layout container\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"main application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"primary icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <div class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary rail navigation\">\n                <button aria-label=\"Inicio\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"home navigation button\">\n                    <i class=\"ti ti-dashboard\" data-kid=\"2-1-1-2-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Mi garaje\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"garage navigation button\">\n                    <i class=\"ti ti-car\" data-kid=\"2-1-1-2-2-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"workshops navigation button\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-3-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Alertas\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-4\" data-name=\"active alerts navigation button\">\n                    <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-1-2-4-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Historial\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-5\" data-name=\"history navigation button\">\n                    <i class=\"ti ti-history\" data-kid=\"2-1-1-2-5-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"utility rail navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"owner contextual sidebar\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"owner account header\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"personal space label\">\n                    Espacio personal\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"owner role status\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\">\n                        Propietario\n                    </span>\n                