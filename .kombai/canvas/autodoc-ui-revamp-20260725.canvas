    },
    "var_6c972ab01e56": {
      "type": "variant",
      "label": "AutoDoc Notifications — Hadrian Light Mobile",
      "parentId": "var_77bd3d3f2267",
      "themeId": null,
      "rect": {
        "x": 94130,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"Application wrapper container\">\n    <header class=\"sticky top-0 z-20 border-b border-[#CBD5E1] bg-white/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"Sticky header bar\" style=\"padding-top: max(10px, env(safe-area-inset-top));\">\n        <div class=\"flex min-h-[56px] items-center justify-between gap-3\" data-kid=\"2-1-1\" data-name=\"Header content layout\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"Logo and title area\">\n                <div aria-label=\"AutoDoc\" class=\"grid size-11 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo initials\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"Header descriptive text container\">\n                    <div class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-1-2-1\" data-name=\"Owner label text\">\n                        Propietario\n                    </div>\n                    <div class=\"truncate font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-1-1-1-2-2\" data-name=\"Notifications section title\">\n                        Notificaciones\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"Header action buttons container\">\n                <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[19px] text-[#522C81] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-[#E4E2E8] hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-1-2-1\" data-name=\"notifications button\">\n                    <i class=\"ti ti-bell\" data-kid=\"2-1-1-2-1-1\" data-name=\"Bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-[9px] top-[8px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-1-2-1-2\" data-name=\"Notification unread indicator dot\">\n                    </span>\n                </button>\n                <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-[#E4E2E8] hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-1-2-2\" data-name=\"Dark mode toggle button\">\n                    <i class=\"ti ti-moon\" data-kid=\"2-1-1-2-2-1\" data-name=\"Moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-1-2-3\" data-name=\"User initials badge\">\n                    JP\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[calc(112px+env(safe-area-inset-bottom))] pt-6\" data-kid=\"2-2\" data-name=\"Main content area\" id=\"notificaciones\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"Page breadcrumb and header section\">\n            <div class=\"mb-2 flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"Breadcrumb navigation container\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"Breadcrumb owner link\">\n                    Propietario\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-1-2\" data-name=\"Breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-1-3\" data-name=\"Breadcrumb current page title\">\n                    Notificaciones\n                </span>\n            </div>\n            <h1 class=\"font-heading text-[28px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2\" data-name=\"Main page heading\">\n                Notificaciones\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-3\" data-name=\"Page description paragraph\">\n                Mantente al día con tus vehículos, talleres y reservas.\n            </p>\n        </div>\n        <button class=\"mb-5 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#46236F] px-5 py-3 text-[13px] font-semibold text-white shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.97]\" data-kid=\"2-2-2\" data-name=\"mark all as read action button\">\n            <i class=\"ti ti-checks text-[17px]\" data-kid=\"2-2-2-1\" data-name=\"Checks icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            Marcar todas como leídas\n        </button>\n        <div class=\"flex items-center justify-between border-b border-[#CBD5E1]\" data-kid=\"2-2-3\" data-name=\"Notification filter bar\">\n            <div class=\"flex items-center gap-5\" data-kid=\"2-2-3-1\" data-name=\"Filter options container\">\n                <button class=\"relative min-h-[48px] border-b-[3px] border-[#1E88E5] px-1 text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-2-3-1-1\" data-name=\"All notifications filter button\">\n                    Todas\n                    <span class=\"ml-1 text-[11px]\" data-kid=\"2-2-3-1-1-1\" data-name=\"All notifications count badge\">\n                        5\n                    </span>\n                </button>\n                <button class=\"relative min-h-[48px] px-1 text-[13px] font-semibold text-[#64748B]\" data-kid=\"2-2-3-1-2\" data-name=\"Unread notifications filter button\">\n                    No leídas\n                    <span class=\"ml-1 text-[11px]\" data-kid=\"2-2-3-1-2-1\" data-name=\"Unread notifications count badge\">\n                        2\n                    </span>\n                </button>\n            </div>\n            <span class=\"text-right text-[11px] text-[#64748B]\" data-kid=\"2-2-3-2\" data-name=\"Pending review summary text\">\n                2 pendientes\n                <br data-kid=\"2-2-3-2-1\" data-name=\"Line break element\"/>\n                de revisar\n            </span>\n        </div>\n        <section aria-labelledby=\"today-heading\" class=\"mt-6\" data-kid=\"2-2-4\" data-name=\"Today notifications section\">\n            <div class=\"mb-2 flex items-center justify-between\" data-kid=\"2-2-4-1\" data-name=\"Today section header\">\n                <h2 class=\"font-heading text-[13px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-1-1\" data-name=\"Today section heading\" id=\"today-heading\">\n                    Hoy\n                </h2>\n                <span class=\"text-[12px] text-[#94A3B8]\" data-kid=\"2-2-4-1-2\" data-name=\"Today notifications count\">\n                    3 avisos\n                </span>\n            </div>\n            <div class=\"space-y-2\" data-kid=\"2-2-4-2\" data-name=\"Today notifications list\">\n                <button class=\"flex min-h-[116px] w-full items-start gap-3 rounded-[16px] border border-[#CBD5E1]/40 border-l-4 border-l-[#EF4444] bg-[#EEEDF0] px-3 py-4 text-left shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.99]\" data-kid=\"2-2-4-2-1\" data-name=\"SOAT expiry notification card\">\n                    <span class=\"grid size-11 shrink-0 place-items-center rounded-lg bg-[#FEE2E2] text-[20px] text-[#EF4444]\" data-kid=\"2-2-4-2-1-1\" data-name=\"Warning icon container\">\n                        <i class=\"ti ti-alert-triangle\" data-kid=\"2-2-4-2-1-1-1\" data-name=\"Warning triangle icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"2-2-4-2-1-2\" data-name=\"Notification card details container\">\n                        <span class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-4-2-1-2-1\" data-name=\"Notification header container\">\n                            <strong class=\"text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-2-4-2-1-2-1-1\" data-name=\"Notification title\">\n                                SOAT vencido\n                            </strong>\n                            <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-1-2-1-2\" data-name=\"Notification timestamp\">\n                                Hace 8 min\n                            </time>\n                        </span>\n                        <span class=\"mt-1 block text-[13px] leading-5 text-[#475569]\" data-kid=\"2-2-4-2-1-2-2\" data-name=\"Notification body description\">\n                            Toyota Corolla · Requiere atención\n                        </span>\n                        <span class=\"mt-2 inline-flex items-center gap-1.5 text-[11px] font-bold text-[#B91C1C]\" data-kid=\"2-2-4-2-1-2-3\" data-name=\"Notification status badge\">\n                            <span class=\"size-2 rounded-full bg-[#EF4444]\" data-kid=\"2-2-4-2-1-2-3-1\" data-name=\"Status indicator dot\">\n                            </span>\n                            No leída\n                        </span>\n                    </span>\n                </button>\n                <button class=\"flex min-h-[116px] w-full items-start gap-3 rounded-[16px] border border-[#CBD5E1]/40 border-l-4 border-l-[#F59E0B] bg-[#EEEDF0] px-3 py-4 text-left shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.99]\" data-kid=\"2-2-4-2-2\" data-name=\"Brake pad notification card\">\n                    <span class=\"grid size-11 shrink-0 place-items-center rounded-lg bg-[#FEF3C7] text-[20px] text-[#D97706]\" data-kid=\"2-2-4-2-2-1\" data-name=\"Brake icon container\">\n                        <i class=\"ti ti-disc-brake\" data-kid=\"2-2-4-2-2-1-1\" data-name=\"Brake disc icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"2-2-4-2-2-2\" data-name=\"Notification card details container\">\n                        <span class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-4-2-2-2-1\" data-name=\"Notification header container\">\n                            <strong class=\"text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-2-4-2-2-2-1-1\" data-name=\"Notification title\">\n                                Pastillas próximas\n                            </strong>\n                            <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-2-2-1-2\" data-name=\"Notification timestamp\">\n                                Hace 42 min\n                            </time>\n                        </span>\n                        <span class=\"mt-1 block text-[13px] leading-5 text-[#475569]\" data-kid=\"2-2-4-2-2-2-2\" data-name=\"Notification body description\">\n                            Toyota Corolla · Revisión en 420 km\n                        </span>\n                        <span class=\"mt-2 inline-flex items-center gap-1.5 text-[11px] font-bold text-[#A16207]\" data-kid=\"2-2-4-2-2-2-3\" data-name=\"Notification status badge\">\n                            <span class=\"size-2 rounded-full bg-[#F59E0B]\" data-kid=\"2-2-4-2-2-2-3-1\" data-name=\"Status indicator dot\">\n                            </span>\n                            No leída\n                        </span>\n                    </span>\n                </button>\n                <button class=\"flex min-h-[116px] w-full items-start gap-3 rounded-[16px] border border-[#CBD5E1]/40 border-l-4 border-l-[#10B981] bg-[#EEEDF0] px-3 py-4 text-left shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.99]\" data-kid=\"2-2-4-2-3\" data-name=\"reservation confirmed notification card\">\n                    <span class=\"grid size-11 shrink-0 place-items-center rounded-lg bg-[#D1FAE5] text-[20px] text-[#059669]\" data-kid=\"2-2-4-2-3-1\" data-name=\"Confirmation icon container\">\n                        <i class=\"ti ti-calendar-check\" data-kid=\"2-2-4-2-3-1-1\" data-name=\"Checkmark icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"2-2-4-2-3-2\" data-name=\"Notification card details container\">\n                        <span class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-4-2-3-2-1\" data-name=\"Notification header container\">\n                            <strong class=\"text-[14px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-3-2-1-1\" data-name=\"Notification title\">\n                                Reserva confirmada\n                            </strong>\n                            <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-3-2-1-2\" data-name=\"Notification timestamp\">\n                                Hace 2 h\n                            </time>\n                        </span>\n                        <span class=\"mt-1 block text-[13px] leading-5 text-[#475569]\" data-kid=\"2-2-4-2-3-2-2\" data-name=\"Notification body description\">\n                            Taller Rápido · Mañana 10:00\n                        </span>\n                        <span class=\"mt-2 inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#047857]\" data-kid=\"2-2-4-2-3-2-3\" data-name=\"Notification status badge\">\n                            <i class=\"ti ti-check\" data-kid=\"2-2-4-2-3-2-3-1\" data-name=\"Check icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Confirmada\n                        </span>\n                    </span>\n                </button>\n            </div>\n        </section>\n        <section aria-labelledby=\"previous-heading\" class=\"mt-7\" data-kid=\"2-2-5\" data-name=\"Previous notifications section\">\n            <div class=\"mb-2 flex items-center justify-between\" data-kid=\"2-2-5-1\" data-name=\"Previous section header\">\n                <h2 class=\"font-heading text-[13px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-5-1-1\" data-name=\"Previous section heading\" id=\"previous-heading\">\n                    Anteriores\n                </h2>\n                <span class=\"text-[12px] text-[#94A3B8]\" data-kid=\"2-2-5-1-2\" data-name=\"Previous notifications count\">\n                    2 avisos\n                </span>\n            </div>\n            <div class=\"space-y-2\" data-kid=\"2-2-5-2\" data-name=\"Previous notifications list\">\n                <button class=\"flex min-h-[128px] w-full items-start gap-3 rounded-[16px] border border-[#CBD5E1]/40 border-l-4 border-l-[#F59E0B] bg-[#EEEDF0] px-3 py-4 text-left shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.99]\" data-kid=\"2-2-5-2-1\" data-name=\"Review received notification card\">\n                    <span class=\"grid size-11 shrink-0 place-items-center rounded-lg bg-[#FEF3C7] text-[20px] text-[#D97706]\" data-kid=\"2-2-5-2-1-1\" data-name=\"Star icon container\">\n                        <i class=\"ti ti-star\" data-kid=\"2-2-5-2-1-1-1\" data-name=\"Star icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"2-2-5-2-1-2\" data-name=\"Notification card details container\">\n                        <span class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-5-2-1-2-1\" data-name=\"Notification header container\">\n                            <strong class=\"text-[14px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-1-2-1-1\" data-name=\"Notification title\">\n                                Reseña recibida\n                            </strong>\n                            <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-kid=\"2-2-5-2-1-2-1-2\" data-name=\"Notification timestamp\">\n                                Ayer\n                            </time>\n                        </span>\n                        <span class=\"mt-1 block text-[13px] leading-5 text-[#475569]\" data-kid=\"2-2-5-2-1-2-2\" data-name=\"Notification body description\">\n                            MotorLab · Tu servicio recibió una nueva valoración.\n                        </span>\n                        <span class=\"mt-2 inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#A16207]\" data-kid=\"2-2-5-2-1-2-3\" data-name=\"Notification status badge\">\n                            <i class=\"ti ti-star-filled\" data-kid=\"2-2-5-2-1-2-3-1\" data-name=\"Filled star icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            4.8 sobre 5\n                        </span>\n                    </span>\n                </button>\n                <button class=\"flex min-h-[140px] w-full items-start gap-3 rounded-[16px] border border-[#CBD5E1]/40 border-l-4 border-l-[#1E88E5] bg-[#EEEDF0] px-3 py-4 text-left shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.99]\" data-kid=\"2-2-5-2-2\" data-name=\"workshop message notification card\">\n                    <span class=\"grid size-11 shrink-0 place-items-center rounded-lg bg-[#DBEAFE] text-[20px] text-[#1E88E5]\" data-kid=\"2-2-5-2-2-1\" data-name=\"Message icon container\">\n                        <i class=\"ti ti-message-circle\" data-kid=\"2-2-5-2-2-1-1\" data-name=\"Message icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"2-2-5-2-2-2\" data-name=\"Notification card details container\">\n                        <span class=\"flex items-start justify-between gap-2\" data-kid=\"2-2-5-2-2-2-1\" data-name=\"Notification header container\">\n                            <strong class=\"text-[14px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-2-2-2-1-1\" data-name=\"Notification title\">\n                                Mensaje de Taller Rápido\n                            </strong>\n                            <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-kid=\"2-2-5-2-2-2-1-2\" data-name=\"Notification timestamp\">\n                                Hace 2 días\n                            </time>\n                        </span>\n                        <span class=\"mt-1 block text-[13px] leading-5 text-[#475569]\" data-kid=\"2-2-5-2-2-2-2\" data-name=\"Notification body description\">\n                            La revisión estará lista mañana. Puedes ver la reserva desde la conversación.\n                        </span>\n                        <span class=\"mt-2 inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#1D4ED8]\" data-kid=\"2-2-5-2-2-2-3\" data-name=\"Notification status badge\">\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"2-2-5-2-2-2-3-1\" data-name=\"Arrow icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Ver conversación\n                        </span>\n                    </span>\n                </button>\n            </div>\n        </section>\n        <div class=\"mt-7 flex items-start gap-3 rounded-[16px] border border-[#CBD5E1]/40 bg-[#EEEDF0] px-3 py-4 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"2-2-6\" data-name=\"empty state notification box\">\n            <span class=\"grid size-10 shrink-0 place-items-center bg-[#F1F5F9] text-[19px] text-[#64748B]\" data-kid=\"2-2-6-1\" data-name=\"Inbox icon container\">\n                <i class=\"ti ti-inbox\" data-kid=\"2-2-6-1-1\" data-name=\"Inbox icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </span>\n            <p class=\"text-[13px] leading-5 text-[#64748B]\" data-kid=\"2-2-6-2\" data-name=\"Empty state helper text\">\n                Cuando no haya más avisos, aparecerán aquí para que puedas revisar tu historial de actividad.\n            </p>\n        </div>\n        <footer class=\"mt-7 border-t border-[#CBD5E1] pt-5 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-7\" data-name=\"Main content footer\">\n            <span data-kid=\"2-2-7-1\" data-name=\"AutoDoc footer title\">\n                AutoDoc · Centro de notificaciones\n            </span>\n            <span class=\"mt-2 flex items-center gap-2\" data-kid=\"2-2-7-2\" data-name=\"Sync status container\">\n                <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-2-7-2-1\" data-name=\"Sync status indicator\">\n                </span>\n                Última sincronización hace 8 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"Main bottom navigation bar\" style=\"padding-bottom: max(8px, env(safe-area-inset-bottom));\">\n        <div class=\"mx-auto flex max-w-[375px] items-center justify-around gap-1 pt-2\" data-kid=\"2-3-1\" data-name=\"Navigation links layout\">\n            <a class=\"flex min-h-[52px] min-w-[56px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-1\" data-name=\"Dashboard nav link\" href=\"#inicio\">\n                <i class=\"ti ti-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"Dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-1-2\" data-name=\"Dashboard link text\">\n                    Inicio\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] min-w-[56px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-2\" data-name=\"Garage nav link\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"Garage icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-2-2\" data-name=\"Garage link text\">\n                    Garaje\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] min-w-[56px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-3\" data-name=\"Workshops nav link\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"Workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-3-2\" data-name=\"Workshops link text\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"relative flex min-h-[52px] min-w-[56px] flex-col items-center justify-center gap-1 rounded-lg bg-[#E8F2FD] text-[#1E88E5]\" data-kid=\"2-3-1-4\" data-name=\"Notifications nav link\" href=\"#notificaciones\">\n                <i class=\"ti ti-bell text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"Notifications icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-bold\" data-kid=\"2-3-1-4-2\" data-name=\"Notifications link text\">\n                    Avisos\n                </span>\n                <span class=\"absolute right-2 top-1 size-1.5 rounded-full bg-[#EF4444]\" data-kid=\"2-3-1-4-3\" data-name=\"Nav notification indicator dot\">\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] min-w-[56px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-1-5\" data-name=\"History nav link\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"History icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-5-2\" data-name=\"History link text\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
