 </button>\n                <button aria-label=\"Página 1\" class=\"flex h-11 w-11 items-center justify-center bg-[#38BDF8] text-[12px] font-bold text-[#082F49]\" data-kid=\"2-2-5-2-2\" data-name=\"mobile current page button\">\n                    1\n                </button>\n                <button aria-label=\"Página siguiente\" class=\"flex h-11 w-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-2-5-2-3\" data-name=\"mobile next page button\">\n                    <i class=\"ti ti-chevron-right text-[16px]\" data-kid=\"2-2-5-2-3-1\" data-name=\"next page icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <div class=\"mt-5 flex items-start gap-3 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"mobile empty state hint\">\n            <i class=\"ti ti-info-circle mt-0.5 shrink-0 text-[16px] text-[#38BDF8]\" data-kid=\"2-2-6-1\" data-name=\"mobile hint icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span data-kid=\"2-2-6-2\" data-name=\"mobile hint text\">\n                Si no encuentras una cuenta, revisa los filtros avanzados o crea un nuevo usuario.\n            </span>\n        </div>\n        <footer class=\"mt-7 flex flex-col gap-3 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-2-7\" data-name=\"mobile admin users footer\">\n            <span data-kid=\"2-2-7-1\" data-name=\"mobile footer branding\">\n                AutoDoc · Consola de administración\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-2-7-2\" data-name=\"mobile sync status\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-7-2-1\" data-name=\"mobile sync dot\">\n                </span>\n                Datos sincronizados hace 2 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación de administración\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/98 px-2 pb-[max(10px,env(safe-area-inset-bottom))] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"mobile admin bottom navigation\">\n        <div class=\"mx-auto grid max-w-[420px] grid-cols-4 gap-1\" data-kid=\"2-3-1\" data-name=\"mobile admin bottom navigation items\">\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" data-name=\"mobile summary navigation item\" href=\"#resumen\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"mobile summary icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"mobile summary label\">\n                    Resumen\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-3-1-2\" data-name=\"mobile active users navigation item\" href=\"#usuarios\">\n                <i class=\"ti ti-users text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"mobile users icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-2-2\" data-name=\"mobile users label\">\n                    Usuarios\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"mobile workshops navigation item\" href=\"#talleres\">\n                <i class=\"ti ti-building-store text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"mobile workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"mobile workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-4\" data-name=\"mobile logs navigation item\" href=\"#logs\">\n                <i class=\"ti ti-terminal-2 text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"mobile logs icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"mobile logs label\">\n                    Logs\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
