      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .profile-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .profile-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  @keyframes profile-spin { to { transform: rotate(360deg); } }\n  .profile-spin { animation: profile-spin 1s linear infinite; }\n  @media (prefers-reduced-motion: reduce) { .profile-spin { animation: none; } }\n</style>\n<div class=\"profile-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"1\" data-name=\"profile setup dark desktop\">\n    <div class=\"pointer-events-none absolute -left-40 -top-48 size-[560px] rounded-full\" data-kid=\"1-1\" data-name=\"primary ambient blob\" style=\"background:radial-gradient(circle,rgba(129,230,217,.16) 0%,rgba(129,230,217,.04) 40%,transparent 72%)\">\n    </div>\n    <div class=\"pointer-events-none absolute -bottom-56 -right-48 size-[640px] rounded-full\" data-kid=\"1-2\" data-name=\"secondary ambient blob\" style=\"background:radial-gradient(circle,rgba(82,44,129,.22) 0%,rgba(82,44,129,.05) 44%,transparent 74%)\">\n    </div>\n    <header class=\"relative z-10 flex h-[72px] items-center justify-between border-b border-[#334155] bg-[#0B1220]/90 px-10 backdrop-blur-sm\" data-kid=\"1-3\" data-name=\"translucent profile setup top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-3-1\" data-name=\"logo and title container\">\n            <span class=\"flex size-10 shrink-0 items-center justify-center rounded-[12px] bg-[#81E6D9] text-[#0F172A] shadow-[0_8px_24px_rgba(129,230,217,.12)]\" data-kid=\"1-3-1-1\" data-name=\"AutoDoc car icon container\">\n                <i class=\"ti ti-car text-[20px]\" data-kid=\"1-3-1-1-1\" data-name=\"AutoDoc car icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </span>\n            <span class=\"profile-heading truncate text-[18px] font-extrabold tracking-[-0.04em] text-[#F8FAFC]\" data-kid=\"1-3-1-2\" data-name=\"AutoDoc title\">\n                AutoDoc\n            </span>\n        </div>\n        <button aria-label=\"Salir\" class=\"flex min-h-[48px] items-center gap-2 rounded-full border border-[#334155] bg-[#141E36] px-4 text-[12px] font-semibold text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#F8FAFC] active:scale-[.97]\" data-kid=\"1-3-2\" data-name=\"logout button\">\n            <i class=\"ti ti-logout text-[17px]\" data-kid=\"1-3-2-1\" data-name=\"logout icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            Salir\n        </button>\n    </header>\n    <main class=\"relative z-10 mx-auto w-full max-w-[760px] px-8 pb-28 pt-10\" data-kid=\"1-4\" data-name=\"profile setup content\">\n        <section class=\"rounded-[20px] border border-[#334155] bg-[#141E36]/90 p-9 shadow-[0_18px_44px_rgba(2,6,23,.34)]\" data-kid=\"1-4-1\" data-name=\"profile setup form card\">\n            <div class=\"mb-8\" data-kid=\"1-4-1-1\" data-name=\"header section container\">\n                <p class=\"mb-3 text-[10px] font-bold uppercase tracking-[.22em] text-[#81E6D9]\" data-kid=\"1-4-1-1-1\" data-name=\"setup context label\">\n                    CONFIGURACIÓN DE CUENTA\n                </p>\n                <h1 class=\"profile-heading text-[30px] font-extrabold leading-tight tracking-[-.045em] text-[#F8FAFC]\" data-kid=\"1-4-1-1-2\" data-name=\"setup headline\">\n                    ¡Bienvenido a AutoDoc!\n                </h1>\n                <p class=\"mt-3 max-w-[600px] text-[14px] leading-6 text-[#94A3B8]\" data-kid=\"1-4-1-1-3\" data-name=\"setup description\">\n                    Configura tu perfil para obtener diagnósticos personalizados y alertas precisas para tu vehículo.\n                </p>\n            </div>\n            <div class=\"mb-8 flex items-center gap-5 border-y border-[#334155] py-6\" data-kid=\"1-4-1-2\" data-name=\"profile photo picker section\">\n                <div class=\"relative\" data-kid=\"1-4-1-2-1\" data-name=\"avatar container\">\n                    <div class=\"flex size-[104px] items-center justify-center overflow-hidden rounded-full border-[3px] border-[#81E6D9]/60 bg-[#1E293B] shadow-[0_12px_28px_rgba(2,6,23,.32)]\" data-kid=\"1-4-1-2-1-1\" data-name=\"profile avatar placeholder\">\n                        <i class=\"ti ti-user text-[48px] text-[#81E6D9]\" data-kid=\"1-4-1-2-1-1-1\" data-name=\"profile placeholder icon\" style=\"width:48px;height:48px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <button aria-label=\"Elegir foto de perfil\" class=\"absolute -bottom-1 -right-1 flex size-[48px] items-center justify-center rounded-full border-2 border-[#141E36] bg-[#81E6D9] text-[#0F172A] shadow-[0_8px_18px_rgba(2,6,23,.32)] transition duration-150 ease-out hover:scale-[1.02] active:scale-[.97]\" data-kid=\"1-4-1-2-1-2\" data-name=\"choose profile photo button\">\n                        <i class=\"ti ti-camera text-[19px]\" data-kid=\"1-4-1-2-1-2-1\" data-name=\"camera icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div data-kid=\"1-4-1-2-2\" data-name=\"photo labels container\">\n                    <p class=\"text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"1-4-1-2-2-1\" data-name=\"photo title\">\n                        Foto de perfil\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"1-4-1-2-2-2\" data-name=\"photo helper\">\n                        Añade una imagen para identificar tu espacio de trabajo.\n                    </p>\n                </div>\n            </div>\n            <div class=\"space-y-8\" data-kid=\"1-4-1-3\" data-name=\"profile setup fields\">\n                <div data-kid=\"1-4-1-3-1\" data-name=\"full name field group\">\n                    <label class=\"mb-2 block text-[10px] font-bold uppercase tracking-[.18em] text-[#94A3B8]\" data-kid=\"1-4-1-3-1-1\" data-name=\"full name label\">\n                        NOMBRE COMPLETO\n                    </label>\n                    <div class=\"flex min-h-[56px] items-center gap-3 rounded-[14px] border border-[#334155] bg-[#1E293B]/70 px-4 shadow-[inset_0_1px_0_rgba(255,255,255,.02)]\" data-kid=\"1-4-1-3-1-2\" data-name=\"full name input\">\n                        <i class=\"ti ti-user text-[18px] text-[#64748B]\" data-kid=\"1-4-1-3-1-2-1\" data-name=\"full name icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"text-[15px] text-[#64748B]\" data-kid=\"1-4-1-3-1-2-2\" data-name=\"full name placeholder\">\n                            Ej. Juan Pérez\n                        </span>\n                    </div>\n                </div>\n                <div data-kid=\"1-4-1-3-2\" data-name=\"role selection group\">\n                    <label class=\"mb-3 block text-[10px] font-bold uppercase tracking-[.18em] text-[#94A3B8]\" data-kid=\"1-4-1-3-2-1\" data-name=\"role label\">\n                        SELECCIONA TU ROL\n                    </label>\n                    <div class=\"grid grid-cols-2 gap-4\" data-kid=\"1-4-1-3-2-2\" data-name=\"role options\">\n                        <button aria-pressed=\"true\" class=\"flex min-h-[112px] flex-col items-start justify-between rounded-[16px] border-2 border-[#81E6D9] bg-[#81E6D9]/10 p-4 text-left shadow-[0_0_0_1px_rgba(129,230,217,.08)] transition duration-150 ease-out active:scale-[.98]\" data-kid=\"1-4-1-3-2-2-1\" data-name=\"selected owner role option\">\n                            <span class=\"flex size-9 items-center justify-center rounded-full bg-[#81E6D9] text-[#0F172A]\" data-kid=\"1-4-1-3-2-2-1-1\" data-name=\"owner role selected check icon container\">\n                                <i class=\"ti ti-check text-[18px]\" data-kid=\"1-4-1-3-2-2-1-1-1\" data-name=\"check mark icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                            <span class=\"text-[14px] font-bold text-[#F8FAFC]\" data-kid=\"1-4-1-3-2-2-1-2\" data-name=\"owner role title\">\n                                Propietario\n                            </span>\n                        </button>\n                        <button aria-pressed=\"false\" class=\"flex min-h-[112px] flex-col items-start justify-between rounded-[16px] border border-[#334155] bg-[#1E293B]/60 p-4 text-left text-[#CBD5E1] transition duration-150 ease-out hover:border-[#64748B] active:scale-[.98]\" data-kid=\"1-4-1-3-2-2-2\" data-name=\"mechanic role option\">\n                            <span class=\"flex size-9 items-center justify-center rounded-full bg-[#334155] text-[#94A3B8]\" data-kid=\"1-4-1-3-2-2-2-1\" data-name=\"mechanic role icon container\">\n                                <i class=\"ti ti-tool text-[18px]\" data-kid=\"1-4-1-3-2-2-2-1-1\" data-name=\"mechanic tool icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                            <span class=\"text-[14px] font-semibold\" data-kid=\"1-4-1-3-2-2-2-2\" data-name=\"mechanic role title\">\n                                Mecánico\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"mt-4 flex items-start gap-3 border-l-4 border-[#81E6D9] bg-[#0B1220]/70 px-4 py-3\" data-kid=\"1-4-1-3-2-3\" data-name=\"selected role explanation\">\n                        <i class=\"ti ti-info-circle mt-0.5 shrink-0 text-[17px] text-[#81E6D9]\" data-kid=\"1-4-1-3-2-3-1\" data-name=\"role information icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <p class=\"text-[13px] leading-5 text-[#CBD5E1]\" data-kid=\"1-4-1-3-2-3-2\" data-name=\"owner role explanation\">\n                            Como propietario, podrás agregar vehículos a tu garaje virtual y dar seguimiento a sus mantenimientos.\n                        </p>\n                    </div>\n                </div>\n                <div data-kid=\"1-4-1-3-3\" data-name=\"preferences group\">\n                    <label class=\"mb-3 block text-[10px] font-bold uppercase tracking-[.18em] text-[#94A3B8]\" data-kid=\"1-4-1-3-3-1\" data-name=\"preferences label\">\n                        PREFERENCIAS\n                    </label>\n                    <div class=\"flex min-h-[80px] items-center gap-4 rounded-[16px] border border-[#334155] bg-[#1E293B]/60 px-4 py-4\" data-kid=\"1-4-1-3-3-2\" data-name=\"maintenance notifications preference\">\n                        <span class=\"flex size-11 shrink-0 items-center justify-center rounded-full bg-[#81E6D9]/10 text-[#81E6D9]\" data-kid=\"1-4-1-3-3-2-1\" data-name=\"notifications icon container\">\n                            <i class=\"ti ti-bell-ringing text-[20px]\" data-kid=\"1-4-1-3-3-2-1-1\" data-name=\"notifications icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-4-1-3-3-2-2\" data-name=\"notifications text container\">\n                            <span class=\"block text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"1-4-1-3-3-2-2-1\" data-name=\"notifications title\">\n                                Notificaciones de mantenimiento\n                            </span>\n                            <span class=\"mt-1 block text-[12px] leading-5 text-[#64748B]\" data-kid=\"1-4-1-3-3-2-2-2\" data-name=\"notifications description\">\n                                Alertas sobre cambios de aceite, frenos y revisiones.\n                            </span>\n                        </span>\n                        <span class=\"relative flex h-7 w-12 shrink-0 items-center rounded-full bg-[#81E6D9] p-1\" data-kid=\"1-4-1-3-3-2-3\" data-name=\"enabled notifications switch\">\n                            <span class=\"ml-auto size-5 rounded-full bg-[#0F172A] shadow-[0_2px_5px_rgba(2,6,23,.32)]\" data-kid=\"1-4-1-3-3-2-3-1\" data-name=\"switch toggle handle\">\n                            </span>\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"fixed inset-x-0 bottom-0 z-20 border-t border-[#334155] bg-[#0B1220]/95 px-10 py-4 backdrop-blur-sm\" data-kid=\"1-5\" data-name=\"profile setup bottom action bar\">\n        <div class=\"mx-auto flex max-w-[760px] justify-end\" data-kid=\"1-5-1\" data-name=\"footer buttons container\">\n            <button class=\"flex min-h-[52px] min-w-[250px] items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-6 text-[13px] font-bold text-[#0F172A] shadow-[0_8px_18px_rgba(2,6,23,.28)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_12px_24px_rgba(2,6,23,.34)] active:scale-[.97]\" data-kid=\"1-5-1-1\" data-name=\"finish profile setup button\">\n                Finalizar Configuración\n                <i class=\"ti ti-arrow-right text-[17px]\" data-kid=\"1-5-1-1-1\" data-name=\"finish button arrow\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-08-17T21:54:19.790690+00:00",
      "modified": "2026-08-17T21:54:39.191573+00:00",
