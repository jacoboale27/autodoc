      "html": "<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile conversation inbox application\">\n    <header class=\"sticky top-0 z-20 flex min-h-[68px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"mobile conversation top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and page context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc mobile logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"page context container\">\n                <p class=\"text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"owner role label\">\n                    Propietario\n                </p>\n                <h1 class=\"truncate font-heading text-[18px] font-extrabold tracking-[-0.04em] text-[#0F172A]\" data-kid=\"2-1-1-2-2\" data-name=\"page title\">\n                    Conversaciones\n                </h1>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile top bar actions\">\n            <button aria-label=\"Notificaciones\" class=\"grid min-h-[44px] min-w-[44px] place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[19px] text-[#64748B] shadow-[0_1px_2px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-[#F8FAFC] hover:scale-[1.02] active:scale-[0.97]\" data-kid=\"2-1-2-1\" data-name=\"mobile notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"notification bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid min-h-[44px] min-w-[44px] place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[19px] text-[#64748B] shadow-[0_1px_2px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-[#F8FAFC] hover:scale-[1.02] active:scale-[0.97]\" data-kid=\"2-1-2-2\" data-name=\"mobile theme toggle button\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-2-2-1\" data-name=\"moon theme icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[560px] px-4 pb-[112px] pt-5\" data-kid=\"2-2\" data-name=\"mobile conversation content\">\n        <section data-kid=\"2-2-1\" data-name=\"mobile conversation controls\">\n            <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-1-4\" data-name=\"header controls container\">\n                <div data-kid=\"2-2-1-4-1\" data-name=\"inbox summary group\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-1-4-1-1\" data-name=\"inbox section label\">\n                        Bandeja de entrada\n                    </p>\n                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-1-4-1-2\" data-name=\"conversation count text\" data-reason=\"count text updated by script\">\n                        3 conversaciones activas\n                    </p>\n                </div>\n                <button aria-label=\"Nueva conversación\" class=\"grid min-h-[44px] min-w-[44px] shrink-0 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[18px] text-[#1E88E5] shadow-[0_1px_2px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:bg-[#F8FAFC] hover:scale-[1.02] active:scale-[0.97]\" data-kid=\"2-2-1-1\" data-name=\"mobile new conversation button\">\n                    <i class=\"ti ti-edit\" data-kid=\"2-2-1-1-1\" data-name=\"edit pen icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <label class=\"mt-5 flex min-h-11 items-center gap-3 border border-[#CBD5E1] bg-white px-3 text-[16px] text-[#64748B]\" data-kid=\"2-2-1-2\" data-name=\"mobile conversation search field\">\n                <i class=\"ti ti-search shrink-0\" data-kid=\"2-2-1-2-1\" data-name=\"search magnifying glass icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"sr-only\" data-kid=\"2-2-1-2-2\" data-name=\"search screen-reader label\">\n                    Buscar conversación\n                </span>\n                <input aria-label=\"Buscar conversación\" class=\"min-w-0 flex-1 bg-transparent text-[13px] text-[#0F172A] outline-hidden placeholder:text-[#94A3B8]\" data-kid=\"2-2-1-2-3\" data-name=\"search input field\" placeholder=\"Buscar conversación\" type=\"search\"/>\n                <span class=\"text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-2-1-2-4\" data-name=\"search shortcut hint\">\n                    ⌘K\n                </span>\n            </label>\n            <div class=\"mt-4 flex items-center gap-6 border-b border-[#CBD5E1] text-[12px] font-semibold\" data-kid=\"2-2-1-3\" data-name=\"mobile conversation filter tabs\">\n                <button aria-current=\"page\" class=\"min-h-11 border-b-2 border-[#1E88E5] pb-3 text-[#1E88E5]\" data-kid=\"2-2-1-3-1\" data-name=\"mobile all conversations tab\">\n                    Todas\n                    <span class=\"ml-1 tabular-nums\" data-dynamic=\"true\" data-kid=\"2-2-1-3-1-1\" data-name=\"all conversations count\" data-reason=\"number updated by script\">\n                        3\n                    </span>\n                </button>\n                <button class=\"min-h-11 pb-3 text-[#64748B]\" data-kid=\"2-2-1-3-2\" data-name=\"mobile unread conversations tab\">\n                    No leídas\n                    <span class=\"ml-1 tabular-nums\" data-dynamic=\"true\" data-kid=\"2-2-1-3-2-1\" data-name=\"unread conversations count\" data-reason=\"number updated by script\">\n                        1\n                    </span>\n                </button>\n            </div>\n        </section>\n        <section aria-label=\"Lista de conversaciones\" class=\"mt-4\" data-kid=\"2-2-2\" data-name=\"mobile conversation thread list\">\n            <button aria-current=\"true\" class=\"flex min-h-[92px] w-full items-start gap-3 border-l-3 border-[#1E88E5] bg-[#E8F2FD] px-4 py-4 text-left\" data-kid=\"2-2-2-1\" data-name=\"selected Taller Rápido mobile thread\">\n                <span class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-2-2-1-1\" data-name=\"Taller Rápido avatar\">\n                    TR\n                </span>\n                <span class=\"min-w-0 flex-1\" data-kid=\"2-2-2-1-2\" data-name=\"thread details container\">\n                    <span class=\"flex items-center justify-between gap-2\" data-kid=\"2-2-2-1-2-1\" data-name=\"thread header row\">\n                        <strong class=\"truncate text-[13px] font-bold text-[#0F172A]\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"thread title\">\n                            Taller Rápido\n                        </strong>\n                        <time class=\"shrink-0 text-[11px] font-bold text-[#1E88E5]\" data-dynamic=\"true\" data-kid=\"2-2-2-1-2-1-2\" data-name=\"thread timestamp\" data-reason=\"time text updated by script\">\n                            09:42\n                        </time>\n                    </span>\n                    <span class=\"mt-1 block truncate text-[12px] font-semibold text-[#334155]\" data-kid=\"2-2-2-1-2-2\" data-name=\"thread preview message\">\n                        La revisión estará lista mañana\n                    </span>\n                    <span class=\"mt-2 flex items-center gap-1.5 text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-2-2-1-2-3\" data-name=\"thread status indicator group\">\n                        <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-2-2-1-2-3-1\" data-name=\"thread status dot icon\">\n                        </span>\n                        En línea · Toyota Corolla\n                    </span>\n                </span>\n            </button>\n            <button class=\"flex min-h-[92px] w-full items-start gap-3 border-b border-[#E2E8F0] bg-white px-4 py-4 text-left\" data-kid=\"2-2-2-2\" data-name=\"MotorLab mobile thread\">\n                <span class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#F1F5F9] text-[12px] font-bold text-[#64748B]\" data-kid=\"2-2-2-2-1\" data-name=\"MotorLab avatar\">\n                    ML\n                </span>\n                <span class=\"min-w-0 flex-1\" data-kid=\"2-2-2-2-2\" data-name=\"thread details container\">\n                    <span class=\"flex items-center justify-between gap-2\" data-kid=\"2-2-2-2-2-1\" data-name=\"thread header row\">\n                        <strong class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-2-2-2-1-1\" data-name=\"thread title\">\n                            MotorLab\n                        </strong>\n                        <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-2-2-2-1-2\" data-name=\"thread timestamp\" data-reason=\"time text updated by script\">\n                            Ayer\n                        </time>\n                    </span>\n                    <span class=\"mt-1 block truncate text-[12px] text-[#64748B]\" data-kid=\"2-2-2-2-2-2\" data-name=\"thread preview message\">\n                        Te enviamos la cotización\n                    </span>\n                    <span class=\"mt-2 block text-[11px] font-semibold text-[#F59E0B]\" data-kid=\"2-2-2-2-2-3\" data-name=\"thread status label\">\n                        Cotización pendiente\n                    </span>\n                </span>\n            </button>\n            <button class=\"flex min-h-[92px] w-full items-start gap-3 border-b border-[#E2E8F0] bg-white px-4 py-4 text-left\" data-kid=\"2-2-2-3\" data-name=\"Centro Auto mobile thread\">\n                <span class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#F1F5F9] text-[12px] font-bold text-[#64748B]\" data-kid=\"2-2-2-3-1\" data-name=\"Centro Auto avatar\">\n                    CA\n                </span>\n                <span class=\"min-w-0 flex-1\" data-kid=\"2-2-2-3-2\" data-name=\"thread details container\">\n                    <span class=\"flex items-center justify-between gap-2\" data-kid=\"2-2-2-3-2-1\" data-name=\"thread header row\">\n                        <strong class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-2-3-2-1-1\" data-name=\"thread title\">\n                            Centro Auto\n                        </strong>\n                        <time class=\"shrink-0 text-[11px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-2-3-2-1-2\" data-name=\"thread timestamp\" data-reason=\"time text updated by script\">\n                            Lun\n                        </time>\n                    </span>\n                    <span class=\"mt-1 block truncate text-[12px] text-[#64748B]\" data-kid=\"2-2-2-3-2-2\" data-name=\"thread preview message\">\n                        ¿Podemos ayudarte?\n                    </span>\n                    <span class=\"mt-2 block text-[11px] text-[#94A3B8]\" data-kid=\"2-2-2-3-2-3\" data-name=\"thread status label\">\n                        Sin mensajes nuevos\n                    </span>\n                </span>\n            </button>\n            <p class=\"border-b border-[#E2E8F0] bg-white px-4 py-3 text-[11px] text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"2-2-2-4\" data-name=\"inbox total active count text\" data-reason=\"count text updated by script\">\n                3 conversaciones activas\n            </p>\n        </section>\n        <section class=\"mt-8 rounded-[16px] border border-l-4 border-[#1E88E5] bg-[#EEEDF0] px-4 py-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)]\" data-kid=\"2-2-3\" data-name=\"selected conversation mobile preview card\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-1\" data-name=\"selected preview mobile header\">\n                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-2-3-1-1\" data-name=\"business info container\">\n                    <span class=\"grid size-11 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-2-3-1-1-1\" data-name=\"business avatar\">\n                        TR\n                    </span>\n                    <div class=\"min-w-0\" data-kid=\"2-2-3-1-1-2\" data-name=\"business name and status\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"2-2-3-1-1-2-1\" data-name=\"title and status row\">\n                            <h2 class=\"font-heading text-[17px] font-bold text-[#0F172A]\" data-kid=\"2-2-3-1-1-2-1-1\" data-name=\"business name\">\n                                Taller Rápido\n                            </h2>\n                            <span class=\"flex items-center gap-1 text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-2-3-1-1-2-1-2\" data-name=\"business online status\">\n                                <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-2-3-1-1-2-1-2-1\" data-name=\"status dot icon\">\n                                </span>\n                                En línea\n                            </span>\n                        </div>\n                        <p class=\"mt-1 truncate text-[12px] text-[#64748B]\" data-kid=\"2-2-3-1-1-2-2\" data-name=\"vehicle details text\">\n                            Toyota Corolla 2022 · P 482-916\n                        </p>\n                    </div>\n                </div>\n                <time class=\"shrink-0 pt-1 text-[11px] font-semibold text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-3-1-2\" data-name=\"message timestamp\" data-reason=\"time text updated by script\">\n                    09:42\n                </time>\n            </div>\n            <div class=\"mt-5 border-y border-[#E2E8F0] py-4\" data-kid=\"2-2-3-2\" data-name=\"selected preview mobile message\">\n                <p class=\"text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-2-3-2-1\" data-name=\"last message label\">\n                    Último mensaje\n                </p>\n                <p class=\"mt-2 text-[15px] leading-6 text-[#0F172A]\" data-kid=\"2-2-3-2-2\" data-name=\"message content text\">\n                    La revisión estará lista mañana\n                </p>\n                <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-3-2-3\" data-name=\"message update status text\">\n                    El taller actualizó la conversación hace unos minutos.\n                </p>\n            </div>\n            <div class=\"mt-5\" data-kid=\"2-2-3-3\" data-name=\"mobile preview action row\">\n                <p class=\"text-[12px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"2-2-3-3-2\" data-name=\"unread message warning text\" data-reason=\"unread count updated by script\">\n                    Hay 1 mensaje sin leer.\n                </p>\n                <button class=\"mt-4 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#45256D] px-5 py-3 text-[13px] font-bold text-white shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(15,23,42,0.12)] active:scale-[0.97]\" data-kid=\"2-2-3-3-1\" data-name=\"mobile open conversation button\">\n                    Abrir conversación\n                    <i class=\"ti ti-arrow-up-right\" data-kid=\"2-2-3-3-1-1\" data-name=\"arrow-up-right icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <div class=\"mt-8 flex items-start gap-2 border-t border-[#CBD5E1] pt-5 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-4\" data-name=\"mobile inbox guidance\">\n            <i class=\"ti ti-info-circle mt-0.5 shrink-0 text-[17px] text-[#1E88E5]\" data-kid=\"2-2-4-1\" data-name=\"info icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span data-kid=\"2-2-4-2\" data-name=\"inbox helper text\">\n                Al abrir una conversación podrás ver mensajes, cotizaciones y reservas asociadas a tu vehículo.\n            </span>\n        </div>\n    </main>\n    <nav aria-label=\"Navegación inferior\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pb-[env(safe-area-inset-bottom)] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"mobile fixed bottom navigation\">\n        <div class=\"mx-auto grid max-w-[560px] grid-cols-5 gap-1\" data-kid=\"2-3-6\" data-name=\"nav items grid container\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1\" data-name=\"mobile home navigation item\" href=\"#inicio\">\n                <i class=\"ti ti-dashboard text-[19px]\" data-kid=\"2-3-1-1\" data-name=\"dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-2\" data-name=\"mobile garage navigation item\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-2-1\" data-name=\"car icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-2-2\" data-name=\"garage label\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-3\" data-name=\"mobile workshops navigation item\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-3-1\" data-name=\"tools icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Conversaciones\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[#1E88E5]\" data-kid=\"2-3-4\" data-name=\"active mobile conversations navigation item\" href=\"#conversaciones\">\n                <i class=\"ti ti-message-2 text-[19px]\" data-kid=\"2-3-4-1\" data-name=\"message icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-4-2\" data-name=\"messages label\">\n                    Mensajes\n                </span>\n            </a>\n            <a aria-label=\"Alertas\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-5\" data-name=\"mobile alerts navigation item\" href=\"#alertas\">\n                <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-5-1\" data-name=\"alert triangle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-5-2\" data-name=\"alerts label\">\n                    Alertas\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
