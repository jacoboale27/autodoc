      "html": "<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    [data-name=\"notifications button\"], [data-name=\"theme toggle button\"] { min-width:44px; min-height:44px; border-radius:999px; border:1px solid #CBD5E1; background:#EEEDF0; box-shadow:0 2px 4px rgba(15,23,42,.05); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"notifications button\"]:hover, [data-name=\"theme toggle button\"]:hover { background:#F7F6F8; color:#522C81; box-shadow:0 6px 14px rgba(15,23,42,.1); }\n  [data-name=\"notifications button\"]:active, [data-name=\"theme toggle button\"]:active { transform:scale(.97); }\n  [data-name=\"task summary section\"] { overflow:hidden; border:1px solid rgba(203,213,225,.4); border-radius:16px; background:#EEEDF0; box-shadow:0 2px 4px rgba(15,23,42,.05); }\n  [data-name=\"cancel button\"] { min-height:48px; border:1px solid #CBD5E1; border-radius:999px; background:#EEEDF0; color:#334155; box-shadow:0 2px 4px rgba(15,23,42,.05); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"cancel button\"]:hover { background:#F7F6F8; box-shadow:0 6px 14px rgba(15,23,42,.1); }\n  [data-name=\"cancel button\"]:active { transform:scale(.97); }\n  [data-name=\"submit button\"] { min-height:48px; border-radius:999px; background:linear-gradient(135deg,#522C81,#45236F); color:#FFFFFF; box-shadow:0 2px 4px rgba(15,23,42,.05); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"submit button\"]:hover { transform:scale(1.02); box-shadow:0 6px 14px rgba(15,23,42,.1); }\n  [data-name=\"submit button\"]:active { transform:scale(.97); }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"page layout wrapper\">\n    <header class=\"sticky top-0 z-20 flex h-[68px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"header container\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"header logo and title area\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[17px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"application logo initials\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"header profile information area\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"profile type label\">\n                    Propietario\n                </p>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-2-2\" data-name=\"profile title area\">\n                    <span class=\"truncate font-heading text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-1-1-2-2-1\" data-name=\"profile title text\">\n                        Recordatorios\n                    </span>\n                    <span class=\"size-1.5 shrink-0 rounded-full bg-[#1E88E5]\" data-kid=\"2-1-1-2-2-2\" data-name=\"status indicator dot\">\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"header actions container\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-[9px] top-[9px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\" data-name=\"notification unread indicator\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-2\" data-name=\"theme toggle button\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-2-2-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3\" data-name=\"user initials circle\">\n                JP\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[560px] px-4 pb-[112px] pt-6\" data-kid=\"2-2\" data-name=\"main content area\">\n        <div class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"breadcrumb and heading area\">\n            <div class=\"mb-3 flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"breadcrumb navigation\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"breadcrumb parent section\">\n                    Propietario\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-1-3\" data-name=\"breadcrumb current page\">\n                    Recordatorios\n                </span>\n            </div>\n            <p class=\"mb-2 text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-2-1-2\" data-name=\"reminder category label\">\n                Recordatorio de mantenimiento\n            </p>\n            <h1 class=\"font-heading text-[27px] font-extrabold leading-[1.1] tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-3\" data-name=\"main page headline\">\n                Configurar recordatorio\n            </h1>\n            <p class=\"mt-2 max-w-[320px] text-[14px] leading-5 text-[#475569]\" data-kid=\"2-2-1-4\" data-name=\"page description text\">\n                Define cuándo quieres volver a recibir esta alerta.\n            </p>\n        </div>\n        <section aria-labelledby=\"task-form-heading\" class=\"border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-2\" data-name=\"task summary section\">\n            <div class=\"flex items-start gap-3 px-0 py-4\" data-kid=\"2-2-2-1\" data-name=\"task item container\">\n                <span class=\"grid size-11 shrink-0 place-items-center border border-[#BFDBFE] bg-[#EFF6FF] text-[19px] text-[#1E88E5]\" data-kid=\"2-2-2-1-1\" data-name=\"task type icon container\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-2-2-1-1-1\" data-name=\"wrench tool icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"2-2-2-1-2\" data-name=\"task details area\">\n                    <h2 class=\"font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-2-2-1-2-1\" data-name=\"task title\" id=\"task-form-heading\">\n                        Cambio de aceite\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-2-2-1-2-2\" data-name=\"task description\">\n                        Toyota Corolla 2022 · P 482-916 · 48,260 km\n                    </p>\n                </div>\n                <span class=\"mt-1 inline-flex shrink-0 items-center gap-1.5 text-[11px] font-semibold text-[#F59E0B]\" data-kid=\"2-2-2-1-3\" data-name=\"task status badge\">\n                    <span class=\"size-2 rounded-full bg-[#F59E0B]\" data-kid=\"2-2-2-1-3-1\" data-name=\"task status indicator dot\">\n                    </span>\n                    Próximo\n                </span>\n            </div>\n        </section>\n        <form class=\"mt-6 space-y-5\" data-kid=\"2-2-3\" data-name=\"reminder configuration form\">\n            <div data-kid=\"2-2-3-1\" data-name=\"current mileage field container\">\n                <label class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-2-3-1-1\" data-name=\"current mileage label\" for=\"current-mileage\">\n                    Kilometraje actual\n                </label>\n                <div class=\"relative\" data-kid=\"2-2-3-1-2\" data-name=\"mileage input field wrapper\">\n                    <input aria-label=\"Kilometraje actual\" class=\"h-12 w-full border border-[#CBD5E1] bg-white px-4 pr-12 text-[15px] font-semibold tabular-nums text-[#0F172A] outline-hidden placeholder:text-[#94A3B8]\" data-kid=\"2-2-3-1-2-1\" data-name=\"mileage input field\" id=\"current-mileage\" value=\"48,260\"/>\n                    <span class=\"pointer-events-none absolute inset-y-0 right-4 flex items-center text-[13px] font-medium text-[#64748B]\" data-kid=\"2-2-3-1-2-2\" data-name=\"mileage unit suffix\">\n                        km\n                    </span>\n                </div>\n            </div>\n            <div data-kid=\"2-2-3-2\" data-name=\"frequency field container\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-2-1\" data-name=\"frequency label area\">\n                    <label class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-2-3-2-1-1\" data-name=\"frequency label\" for=\"frequency\">\n                        Recordar cada\n                    </label>\n                    <span class=\"max-w-[145px] text-right text-[11px] leading-4 text-[#64748B]\" data-kid=\"2-2-3-2-1-2\" data-name=\"suggested distance text\">\n                        Distancia sugerida: 10,000 km\n                    </span>\n                </div>\n                <div class=\"relative\" data-kid=\"2-2-3-2-2\" data-name=\"frequency input field wrapper\">\n                    <input aria-label=\"Recordar cada\" class=\"h-12 w-full border-2 border-[#1E88E5] bg-white px-4 pr-12 text-[15px] font-semibold tabular-nums text-[#0F172A] outline-hidden ring-3 ring-[#DBEAFE]\" data-kid=\"2-2-3-2-2-1\" data-name=\"frequency input field\" id=\"frequency\" value=\"10,000\"/>\n                    <span class=\"pointer-events-none absolute inset-y-0 right-4 flex items-center text-[13px] font-medium text-[#64748B]\" data-kid=\"2-2-3-2-2-2\" data-name=\"frequency unit suffix\">\n                        km\n                    </span>\n                </div>\n                <p class=\"mt-2 flex items-start gap-2 text-[12px] font-medium leading-4 text-[#B91C1C]\" data-kid=\"2-2-3-2-3\" data-name=\"validation alert message\" role=\"alert\">\n                    <i class=\"ti ti-alert-circle mt-0.5 shrink-0 text-[15px]\" data-kid=\"2-2-3-2-3-1\" data-name=\"alert warning icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-2-3-2-3-2\" data-name=\"validation error text\">\n                        Usa un intervalo mayor a 0 km para activar el recordatorio.\n                    </span>\n                </p>\n            </div>\n            <div data-kid=\"2-2-3-3\" data-name=\"next service field container\">\n                <label class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-2-3-3-1\" data-name=\"next service label\" for=\"next-service\">\n                    Próxima revisión\n                </label>\n                <div class=\"relative\" data-kid=\"2-2-3-3-2\" data-name=\"date input wrapper\">\n                    <input aria-label=\"Próxima revisión\" class=\"h-12 w-full border border-[#CBD5E1] bg-white px-4 pl-11 text-[15px] font-semibold text-[#0F172A] outline-hidden\" data-kid=\"2-2-3-3-2-1\" data-name=\"next service date input\" id=\"next-service\" value=\"12 jun 2027\"/>\n                    <i class=\"ti ti-calendar-event pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[17px] text-[#1E88E5]\" data-kid=\"2-2-3-3-2-2\" data-name=\"calendar icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n            <div class=\"flex items-center justify-between gap-4 border-y border-[#E2E8F0] py-4\" data-kid=\"2-2-3-4\" data-name=\"toggle notification setting container\">\n                <div class=\"min-w-0\" data-kid=\"2-2-3-4-1\" data-name=\"toggle notification info\">\n                    <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-3-4-1-1\" data-name=\"toggle notification title\">\n                        Avisarme con anticipación\n                    </p>\n                    <p class=\"mt-1 max-w-[245px] text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-2-3-4-1-2\" data-name=\"toggle notification description\">\n                        Recibirás una alerta antes de la fecha calculada.\n                    </p>\n                </div>\n                <button aria-label=\"Avisarme con anticipación activado\" aria-pressed=\"true\" class=\"relative h-7 w-12 shrink-0 rounded-full bg-[#1E88E5]\" data-kid=\"2-2-3-4-2\" data-name=\"notification toggle button\" type=\"button\">\n                    <span class=\"absolute right-1 top-1 size-5 rounded-full bg-white shadow-[0_1px_2px_rgba(15,23,42,0.2)]\" data-kid=\"2-2-3-4-2-1\" data-name=\"toggle slider handle\">\n                    </span>\n                </button>\n            </div>\n            <div class=\"flex items-start gap-3 border-l-4 border-[#10B981] bg-[#ECFDF5] px-4 py-3.5\" data-kid=\"2-2-3-5\" data-name=\"active reminder status box\">\n                <i class=\"ti ti-bell-check mt-0.5 shrink-0 text-[18px] text-[#059669]\" data-kid=\"2-2-3-5-1\" data-name=\"bell check icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <div data-kid=\"2-2-3-5-2\" data-name=\"active reminder info\">\n                    <p class=\"text-[13px] font-semibold text-[#065F46]\" data-kid=\"2-2-3-5-2-1\" data-name=\"active reminder title\">\n                        Recordatorio activo\n                    </p>\n                    <p class=\"mt-0.5 text-[12px] leading-4 text-[#047857]\" data-kid=\"2-2-3-5-2-2\" data-name=\"active reminder description\">\n                        Te avisaremos 500 km antes de la próxima revisión.\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex flex-col gap-3 border-t border-[#CBD5E1] pt-5\" data-kid=\"2-2-3-6\" data-name=\"form actions container\">\n                <button class=\"min-h-12 w-full border border-[#CBD5E1] bg-white px-5 text-[13px] font-semibold text-[#334155]\" data-kid=\"2-2-3-6-1\" data-name=\"cancel button\" type=\"button\">\n                    Cancelar\n                </button>\n                <button class=\"inline-flex min-h-12 w-full items-center justify-center gap-2 bg-[#1E88E5] px-5 text-[13px] font-bold text-white\" data-kid=\"2-2-3-6-2\" data-name=\"submit button\" type=\"submit\">\n                    Guardar recordatorio\n                    <i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"2-2-3-6-2-1\" data-name=\"arrow right icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </form>\n        <footer class=\"mt-7 border-t border-[#E2E8F0] pt-4 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-4\" data-name=\"footer section\">\n            <p data-kid=\"2-2-4-1\" data-name=\"footer brand name\">\n                AutoDoc · Recordatorios de mantenimiento\n            </p>\n            <p class=\"mt-2 flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-2-4-2\" data-name=\"sync status text\" data-reason=\"sync time updated by background script\">\n                <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-2-4-2-1\" data-name=\"sync status indicator dot\">\n                </span>\n                Datos sincronizados hace 8 min\n            </p>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pb-[env(safe-area-inset-bottom)] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"mobile navigation bar\">\n        <div class=\"mx-auto flex max-w-[420px] items-center justify-around\" data-kid=\"2-3-1\" data-name=\"navigation items container\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-1\" data-name=\"home link\" href=\"#\">\n                <i class=\"ti ti-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"home dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-2\" data-name=\"garage link\" href=\"#\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"garage car icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"garage label\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-3\" data-name=\"workshops link\" href=\"#\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"workshops tool icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Alertas\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-1 text-[#1E88E5]\" data-kid=\"2-3-1-4\" data-name=\"alerts link\" href=\"#\">\n                <i class=\"ti ti-bell-ringing text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"alerts bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-4-2\" data-name=\"alerts label\">\n                    Alertas\n                </span>\n            </a>\n            <a aria-label=\"Historial\" class=\"flex min-h-11 min-w-11 flex-1 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-5\" data-name=\"history link\" href=\"#\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-5-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
