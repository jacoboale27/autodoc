      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    :root { --app-primary:#522C81; --app-on-primary:#FFFFFF; --app-surface-container:#EEEDF0; --app-outline:#CBD5E1; --app-shadow-sm:0 2px 4px rgba(15,23,42,.05); --app-shadow-hover:0 6px 14px rgba(15,23,42,.1); }\n  button { min-height:48px; border-radius:999px; transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  button[aria-label] { min-width:44px; min-height:44px; background:var(--app-surface-container); border:1px solid rgba(203,213,225,.4); border-radius:999px; box-shadow:var(--app-shadow-sm); }\n  button:not([aria-label])[class*=\"bg-[#1E88E5]\"] { min-height:48px; border-radius:999px; background:linear-gradient(135deg,#522C81,#45236F); color:#FFFFFF; box-shadow:var(--app-shadow-sm); }\n  button:not([aria-label])[class*=\"bg-[#1E88E5]\"]:hover, button:not([aria-label])[class*=\"bg-[#1E88E5]\"]:focus-visible { transform:scale(1.02); box-shadow:var(--app-shadow-hover); }\n  button:not([aria-label])[class*=\"border\"] { background:var(--app-surface-container); border-color:rgba(203,213,225,.5); box-shadow:var(--app-shadow-sm); }\n  button:active { transform:scale(.97); }\n  button[aria-label][class*=\"bg-[#1E88E5]\"] { background:#522C81; border-color:#522C81; color:#FFFFFF; }\n  [data-name=\"board filters bar\"], [data-name=\"column items list\"] { border-radius:16px; border:1px solid rgba(203,213,225,.4); background:var(--app-surface-container); box-shadow:var(--app-shadow-sm); overflow:hidden; }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"repairs board application\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"main shell wrapper\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"workshop icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <div class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary rail navigation\">\n                <button aria-label=\"Panel del taller\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard rail button\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Reparaciones\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-2\" data-name=\"repairs active rail button\">\n                    <i class=\"ti ti-clipboard-list\" data-kid=\"2-1-1-2-2-1\" data-name=\"repairs list icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Buscar vehículo\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"vehicle search rail button\">\n                    <i class=\"ti ti-search\" data-kid=\"2-1-1-2-3-1\" data-name=\"search icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Conversaciones\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-4\" data-name=\"chat rail button\">\n                    <i class=\"ti ti-message-circle\" data-kid=\"2-1-1-2-4-1\" data-name=\"message circle icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"utility rail navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help rail button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help circle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings rail button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"workshop contextual sidebar\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"workshop identity block\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"workshop label\">\n                    Taller\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"workshop name status\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"workshop status indicator\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"workshop name text\">\n                        Taller Rápido\n                    </span>\n                </div>\n                <p class=\"mt-2 text-[11px] text-[#64748B]\" data-kid=\"2-1-2-1-3\" data-name=\"operation status text\">\n                    Operación activa\n                </p>\n            </div>\n            <nav aria-label=\"Navegación del taller\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"workshop navigation list\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-1\" data-name=\"panel navigation link\" href=\"#panel\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-1-1\" data-name=\"panel icon wrapper\">\n                        <i class=\"ti ti-layout-dashboard\" data-kid=\"2-1-2-2-1-1-1\" data-name=\"panel icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Panel\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-2.5 text-[14px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-2-2\" data-name=\"active repairs navigation link\" href=\"#reparaciones\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-2-1\" data-name=\"active repairs icon wrapper\">\n                        <i class=\"ti ti-clipboard-list\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"active repairs icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Reparaciones\n                    <span class=\"ml-auto rounded bg-[#DBEAFE] px-1.5 py-0.5 text-[11px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-2-2-2\" data-name=\"active repairs count badge\">\n                        09\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-3\" data-name=\"search navigation link\" href=\"#buscar\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-3-1\" data-name=\"search icon wrapper\">\n                        <i class=\"ti ti-search\" data-kid=\"2-1-2-2-3-1-1\" data-name=\"search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Buscar vehículo\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-4\" data-name=\"history navigation link\" href=\"#historial\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-4-1\" data-name=\"history icon wrapper\">\n                        <i class=\"ti ti-history\" data-kid=\"2-1-2-2-4-1-1\" data-name=\"history icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Historial\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-5\" data-name=\"reviews navigation link\" href=\"#resenas\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-5-1\" data-name=\"reviews icon wrapper\">\n                        <i class=\"ti ti-star\" data-kid=\"2-1-2-2-5-1-1\" data-name=\"reviews icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Reseñas\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"workshop management navigation\">\n                <p class=\"mb-3 px-3 text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-3-1\" data-name=\"management label\">\n                    Gestión\n                </p>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B] hover:text-[#0F172A]\" data-kid=\"2-1-2-3-2\" data-name=\"catalog navigation link\" href=\"#catalogo\">\n                    <i class=\"ti ti-list-details text-[17px]\" data-kid=\"2-1-2-3-2-1\" data-name=\"catalog icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Catálogo\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B] hover:text-[#0F172A]\" data-kid=\"2-1-2-3-3\" data-name=\"employees navigation link\" href=\"#empleados\">\n                    <i class=\"ti ti-users text-[17px]\" data-kid=\"2-1-2-3-3-1\" data-name=\"employees icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Empleados\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B] hover:text-[#0F172A]\" data-kid=\"2-1-2-3-4\" data-name=\"settings navigation link\" href=\"#configuracion\">\n                    <i class=\"ti ti-settings text-[17px]\" data-kid=\"2-1-2-3-4-1\" data-name=\"settings icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Configuración\n                </a>\n            </div>\n            <div class=\"mt-5 border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-4\" data-name=\"workshop user summary\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-4-1\" data-name=\"user summary content\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-4-1-1\" data-name=\"user initials avatar\">\n                        TR\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-4-1-2\" data-name=\"user details\">\n                        <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-4-1-2-1\" data-name=\"user name\">\n                            Taller Rápido\n                        </p>\n                        <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-1-2-4-1-2-2\" data-name=\"plan type\">\n                            Plan profesional\n                        </p>\n                    </div>\n                    <i class=\"ti ti-dots ml-auto text-[16px] text-[#94A3B8]\" data-kid=\"2-1-2-4-1-3\" data-name=\"options menu icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"2-1-3\" data-name=\"repairs board main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-white px-8\" data-kid=\"2-1-3-1\" data-name=\"top application header\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumb navigation\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-1-3-1-1-1\" data-name=\"breadcrumb parent\">\n                        Taller\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-3-1-1-2\" data-name=\"breadcrumb separator\">\n                        /\n                    </span>\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-1-3\" data-name=\"breadcrumb current\">\n                        Reparaciones\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-1-2\" data-name=\"header utilities\">\n                    <span class=\"hidden text-[12px] text-[#64748B] lg:block\" data-kid=\"2-1-3-1-2-1\" data-name=\"current date text\">\n                        Sábado, 25 jul 2026\n                    </span>\n                    <button aria-label=\"Notificaciones\" class=\"relative grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-2\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-2-2-1\" data-name=\"notifications bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-[7px] top-[6px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-3-1-2-2-2\" data-name=\"notifications badge indicator\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-3\" data-name=\"theme toggle button\">\n                        <i class=\"ti ti-moon\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <div class=\"h-6 w-px bg-[#E2E8F0]\" data-kid=\"2-1-3-1-2-4\" data-name=\"header separator\">\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-1-2-5\" data-name=\"header user profile\">\n                        <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-1-2-5-1\" data-name=\"header user initials\">\n                            TR\n                        </div>\n                        <span class=\"hidden text-[13px] font-semibold text-[#0F172A] xl:block\" data-kid=\"2-1-3-1-2-5-2\" data-name=\"header user name\">\n                            Taller Rápido\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1160px] px-8 py-7\" data-kid=\"2-1-3-2\" data-name=\"repairs page body\">\n                <div class=\"mb-6 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"page heading group\">\n                    <div data-kid=\"2-1-3-2-1-2\" data-name=\"page title block\">\n                        <h1 class=\"font-heading text-[32px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-1-3-2-1-2-1\" data-name=\"page headline\">\n                            Reparaciones\n                        </h1>\n                        <p class=\"mt-2 text-[15px] text-[#334155]\" data-kid=\"2-1-3-2-1-2-2\" data-name=\"page description\">\n                            Sigue cada vehículo desde la recepción hasta la entrega.\n                        </p>\n                    </div>\n                    <button class=\"inline-flex items-center gap-2 bg-[#1E88E5] px-4 py-2.5 text-[13px] font-semibold text-white hover:bg-[#176FBB]\" data-kid=\"2-1-3-2-1-1\" data-name=\"new repair button with primary gradient style\">\n                        <i class=\"ti ti-plus text-[17px]\" data-kid=\"2-1-3-2-1-1-1\" data-name=\"plus icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Nueva reparación\n                    </button>\n                </div>\n                <div class=\"mb-6 flex items-center justify-between gap-4 border-y border-[#CBD5E1] bg-white px-4 py-3\" data-kid=\"2-1-3-2-2\" data-name=\"board filters bar with container styles\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-2-2-1\" data-name=\"filter controls\">\n                        <span class=\"mr-2 text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-3-2-2-1-1\" data-name=\"filter label\">\n                            Filtrar:\n                        </span>\n                        <button class=\"border border-[#1E88E5] bg-[#E8F2FD] px-3 py-1.5 text-[12px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-3-2-2-1-2\" data-name=\"all filter button with surface style\">\n                            Todas\n                        </button>\n                        <button class=\"border border-transparent px-3 py-1.5 text-[12px] font-medium text-[#64748B] hover:border-[#CBD5E1]\" data-kid=\"2-1-3-2-2-1-3\" data-name=\"high priority filter button with surface style\">\n                            Alta prioridad\n                        </button>\n                        <b