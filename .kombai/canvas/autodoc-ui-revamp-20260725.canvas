      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    :root { --app-primary:#522C81; --app-on-primary:#FFFFFF; --app-surface-container:#EEEDF0; --app-outline:#CBD5E1; --app-shadow-sm:0 2px 4px rgba(15,23,42,.05); --app-shadow-hover:0 6px 14px rgba(15,23,42,.1); }\n  button { min-height:48px; border-radius:999px; transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  button[aria-label] { min-width:44px; min-height:44px; background:var(--app-surface-container); border:1px solid rgba(203,213,225,.4); border-radius:999px; box-shadow:var(--app-shadow-sm); }\n  button:not([aria-label])[class*=\"bg-[#1E88E5]\"] { min-height:48px; border-radius:999px; background:linear-gradient(135deg,#522C81,#45236F); color:#FFFFFF; box-shadow:var(--app-shadow-sm); }\n  button:not([aria-label])[class*=\"bg-[#1E88E5]\"]:hover, button:not([aria-label])[class*=\"bg-[#1E88E5]\"]:focus-visible { transform:scale(1.02); box-shadow:var(--app-shadow-hover); }\n  button:not([aria-label])[class*=\"border\"] { background:var(--app-surface-container); border-color:rgba(203,213,225,.5); box-shadow:var(--app-shadow-sm); }\n  button:active { transform:scale(.97); }\n  [data-name=\"primary search section\"], [data-name=\"vehicle results table\"], [data-name=\"selected vehicle detail panel\"] { border-radius:16px; border:1px solid rgba(203,213,225,.4); background:var(--app-surface-container); box-shadow:var(--app-shadow-sm); overflow:hidden; }\n</style>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"vehicle search app shell\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"workshop shell layout\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"workshop icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-12 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <nav aria-label=\"Navegación del taller\" class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"workshop rail navigation\">\n                <button aria-label=\"Panel del taller\" class=\"grid size-12 place-items-center rounded-xl text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard rail button\">\n                    <i class=\"ti ti-layout-dashboard text-[20px]\" data-kid=\"2-1-1-2-1-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Reparaciones\" class=\"grid size-12 place-items-center rounded-xl text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"repairs rail button\">\n                    <i class=\"ti ti-tool text-[20px]\" data-kid=\"2-1-1-2-2-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Buscar vehículo\" class=\"grid size-12 place-items-center rounded-xl border-l-[3px] border-[#1E88E5] bg-[#1E88E5] text-white\" data-kid=\"2-1-1-2-3\" data-name=\"vehicle search rail button\">\n                    <i class=\"ti ti-search text-[20px]\" data-kid=\"2-1-1-2-3-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Conversaciones\" class=\"grid size-12 place-items-center rounded-xl text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-4\" data-name=\"chat rail button\">\n                    <i class=\"ti ti-message-2 text-[20px]\" data-kid=\"2-1-1-2-4-1\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </nav>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"rail utility buttons\">\n                <button aria-label=\"Configuración\" class=\"grid size-12 place-items-center rounded-xl text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"settings rail button\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-3-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"grid size-12 place-items-center rounded-xl text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"help rail button\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-3-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"workshop contextual sidebar\">\n            <div class=\"mb-8 border-b border-[#E2E8F0] pb-6\" data-kid=\"2-1-2-1\" data-name=\"workshop identity block\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"role label\">\n                    Taller\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"workshop status row\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"online status dot\">\n                    </span>\n                    <span class=\"text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"workshop name\">\n                        Taller Rápido\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-2-1-3\" data-name=\"workshop status detail\">\n                    Operación activa\n                </p>\n            </div>\n            <nav aria-label=\"Menú del taller\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"contextual navigation\">\n                <a class=\"flex min-h-12 items-center gap-3 border-l-[3px] border-transparent px-3 py-3 text-[13px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-1\" data-name=\"panel link\" href=\"#panel\">\n                    <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"2-1-2-2-1-1\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Panel\n                </a>\n                <a class=\"flex min-h-12 items-center gap-3 border-l-[3px] border-transparent px-3 py-3 text-[13px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-2\" data-name=\"repairs link\" href=\"#reparaciones\">\n                    <i class=\"ti ti-tool text-[17px]\" data-kid=\"2-1-2-2-2-2\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                   