                      SOAT\n                            </div>\n                            <div class=\"mt-0.5 truncate text-[11px] text-[#FCA5A5]\" data-kid=\"2-2-8-2-1-1-2-2\">\n                                Vencido · 18 ago 2026\n                            </div>\n                        </div>\n                    </div>\n                    <button aria-label=\"Actualizar SOAT\" class=\"flex h-12 w-12 shrink-0 items-center justify-center text-[#38BDF8]\" data-kid=\"2-2-8-2-1-2\" data-name=\"edit SOAT button\" type=\"button\">\n                        <i class=\"ti ti-pencil text-[16px]\" data-kid=\"2-2-8-2-1-2-1\" data-name=\"edit icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"flex min-h-[72px] items-center justify-between gap-3 px-1 py-3\" data-kid=\"2-2-8-2-2\" data-name=\"document row tecno\">\n                    <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-2-8-2-2-1\" data-name=\"document tecno content\">\n                        <i class=\"ti ti-file-check shrink-0 text-[18px] text-[#34D399]\" data-kid=\"2-2-8-2-2-1-1\" data-name=\"document icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <div class=\"min-w-0\" data-kid=\"2-2-8-2-2-1-2\">\n                            <div class=\"text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-8-2-2-1-2-1\">\n                                Tecnomecánica\n                            </div>\n                            <div class=\"mt-0.5 truncate text-[11px] text-[#6EE7B7]\" data-kid=\"2-2-8-2-2-1-2-2\">\n                                Vigente · 10 dic 2026\n                            </div>\n                        </div>\n                    </div>\n                    <button aria-label=\"Actualizar Tecnomecánica\" class=\"flex h-12 w-12 shrink-0 items-center justify-center text-[#38BDF8]\" data-kid=\"2-2-8-2-2-2\" data-name=\"edit Tecnomecanica button\" type=\"button\">\n                        <i class=\"ti ti-pencil text-[16px]\" data-kid=\"2-2-8-2-2-2-1\" data-name=\"edit icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <footer class=\"mt-8 flex flex-col gap-2 border-t border-[#334155] pt-4 text-[10px] text-[#64748B]\" data-kid=\"2-2-9\" data-name=\"profile footer\">\n            <span data-kid=\"2-2-9-1\" data-name=\"footer copy\">\n                AutoDoc · Ficha técnica del vehículo\n            </span>\n            <span class=\"flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"2-2-9-2\" data-name=\"sync status\" data-reason=\"text updated to reflect time elapsed since last synchronization\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-9-2-1\" data-name=\"sync status dot\">\n                </span>\n                Datos sincronizados hace 4 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-40 border-t border-[#334155] bg-[#020617]/95 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"mobile bottom navigation\" style=\"padding-bottom:env(safe-area-inset-bottom)\">\n        <div class=\"grid min-h-[72px] grid-cols-5 items-center px-1\" data-kid=\"2-3-1\" data-name=\"bottom navigation items\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-[60px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" data-name=\"home navigation item\" href=\"#inicio\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"home icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Mi garaje\" class=\"flex min-h-[60px] flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] text-[#38BDF8]\" data-kid=\"2-3-1-2\" data-name=\"garage active navigation item\" href=\"#garaje\">\n                <i class=\"ti ti-steering-wheel text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"garage icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-2-2\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-[60px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"workshops navigation item\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-label=\"Alertas\" class=\"relative flex min-h-[60px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-4\" data-name=\"alerts navigation item\" href=\"#alertas\">\n                <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"alerts icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-3\">\n                    Alertas\n                </span>\n                <span class=\"absolute right-[20%] top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-dynamic=\"true\" data-kid=\"2-3-1-4-2\" data-name=\"alerts notification dot\" data-reason=\"visibility controlled by pending notifications script\">\n                </span>\n            </a>\n            <a aria-label=\"Historial\" class=\"flex min-h-[60px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-5\" data-name=\"history navigation item\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-5-2\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
      "created": "2026-08-17T20:18:06.037868+00:00",
      "modified": "2026-08-17T21:08:49.357220+00:00",
