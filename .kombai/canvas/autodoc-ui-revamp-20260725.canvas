      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC]\" data-kid=\"5\" data-name=\"page layout container\" style=\"font-family:'IBM Plex Sans',sans-serif\">\n    <header class=\"sticky top-0 z-20 border-b border-[#334155] bg-[#0B1220]/95 px-4 py-3 backdrop-blur-sm\" data-kid=\"2\" data-name=\"Mobile repairs header\">\n        <div class=\"flex min-h-[44px] items-center justify-between gap-3\" data-kid=\"2-4\" data-name=\"header contents wrapper\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-4-1\" data-name=\"header logo and title container\">\n                <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[18px] font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-4-1-1\" data-name=\"brand initials logo\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-4-1-2\" data-name=\"header branding text container\">\n                    <p class=\"truncate text-[10px] font-semibold uppercase tracking-[0.16em] text-[#94A3B8]\" data-kid=\"2-4-1-2-1\" data-name=\"brand name label\">\n                        Taller\n                    </p>\n                    <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-4-1-2-2\" data-name=\"header title container\">\n                        <span class=\"truncate text-[15px] font-extrabold tracking-[-0.03em] text-white\" data-kid=\"2-4-1-2-2-1\" data-name=\"header title text\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Reparaciones\n                        </span>\n                        <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-[#38BDF8]\" data-kid=\"2-4-1-2-2-2\" data-name=\"active status indicator dot\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-4-2\" data-name=\"header utility buttons container\">\n                <button aria-label=\"Cambiar tema\" class=\"flex h-11 w-11 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:bg-[#1E293B] hover:text-[#81E6D9] active:scale-[0.97]\" data-kid=\"2-1\" data-name=\"Theme toggle button\">\n                    <i class=\"ti ti-sun-moon text-[17px]\" data-kid=\"2-1-1\" data-name=\"sun moon icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Notificaciones\" class=\"relative flex h-11 w-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-2\" data-name=\"Notifications button\">\n                    <i class=\"ti ti-bell text-[17px]\" data-kid=\"2-2-1\" data-name=\"bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-2-2\" data-name=\"notifications unread badge\">\n                    </span>\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-3 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-3\" data-name=\"Mobile breadcrumb\">\n            <span data-kid=\"2-3-1\" data-name=\"breadcrumb parent page name\">\n                Taller\n            </span>\n            <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-3-2\" data-name=\"chevron right icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"font-semibold text-[#E2E8F0]\" data-kid=\"2-3-3\" data-name=\"breadcrumb current page name\">\n                Reparaciones\n            </span>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[116px] pt-6\" data-kid=\"3\" data-name=\"Mobile repairs content\">\n        <div class=\"mb-6\" data-kid=\"3-1\" data-name=\"Page heading section\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"3-1-2\" data-name=\"heading and action container\">\n                <div class=\"min-w-0\" data-kid=\"3-1-2-1\" data-name=\"heading text container\">\n                    <h1 class=\"text-[26px] font-extrabold leading-tight tracking-[-0.04em] text-white\" data-kid=\"3-1-2-1-1\" data-name=\"page main headline\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                        Reparaciones\n                    </h1>\n                    <p class=\"mt-2 max-w-[280px] text-[13px] leading-5 text-[#94A3B8]\" data-kid=\"3-1-2-1-2\" data-name=\"page description text\">\n                        Sigue cada vehículo desde la recepción hasta la entrega.\n                    </p>\n                </div>\n                <button aria-label=\"Nueva reparación\" class=\"flex min-h-[48px] shrink-0 items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-4 text-[11px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"3-1-1\" data-name=\"new repair action button\">\n                    <i class=\"ti ti-plus text-[15px]\" data-kid=\"3-1-1-1\" data-name=\"plus icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"sr-only\" data-kid=\"3-1-1-2\" data-name=\"new repair screen reader text\">\n                        Nueva reparación\n                    </span>\n                    <span aria-hidden=\"true\" data-kid=\"3-1-1-3\" data-name=\"new repair visual text\">\n                        Nueva\n                    </span>\n                </button>\n            </div>\n        </div>\n        <div class=\"mb-6 -mx-4 overflow-x-auto border-y border-[#334155] px-4\" data-kid=\"3-2\" data-name=\"Mobile filter tabs\">\n            <div class=\"flex min-w-max items-center gap-1 py-2\" data-kid=\"3-2-4\" data-name=\"tabs scrollable container\">\n                <button class=\"min-h-[44px] border border-[#475569] bg-[#1E293B] px-3 text-[12px] font-semibold text-[#F8FAFC]\" data-kid=\"3-2-1\" data-name=\"All repairs filter button\">\n                    Todas\n                    <span class=\"ml-1 text-[#38BDF8]\" data-dynamic=\"true\" data-kid=\"3-2-1-1\" data-name=\"all repairs count badge\" data-reason=\"count updated by backend data\">\n                        09\n                    </span>\n                </button>\n                <button class=\"min-h-[44px] border border-transparent px-3 text-[12px] font-medium text-[#94A3B8]\" data-kid=\"3-2-2\" data-name=\"High priority filter button\">\n                    Alta prioridad\n                    <span class=\"ml-1 text-[#F87171]\" data-dynamic=\"true\" data-kid=\"3-2-2-1\" data-name=\"high priority count badge\" data-reason=\"count updated by backend data\">\n                        03\n                    </span>\n                </button>\n                <button class=\"min-h-[44px] border border-transparent px-3 text-[12px] font-medium text-[#94A3B8]\" data-kid=\"3-2-3\" data-name=\"Today filter button\">\n                    Hoy\n                    <span class=\"ml-1 text-[#FBBF24]\" data-dynamic=\"true\" data-kid=\"3-2-3-1\" data-name=\"today count badge\" data-reason=\"count updated by backend data\">\n                        05\n                    </span>\n                </button>\n            </div>\n        </div>\n        <div class=\"mb-6 flex items-center gap-2 border-b border-[#334155] pb-4 text-[11px] text-[#64748B]\" data-kid=\"3-3\" data-name=\"Mobile board hint\">\n            <i class=\"ti ti-layout-list text-[15px] text-[#818CF8]\" data-kid=\"3-3-1\" data-name=\"list layout icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span data-kid=\"3-3-2\" data-name=\"hint label\">\n                Vista de tablero\n            </span>\n            <span class=\"text-[#475569]\" data-kid=\"3-3-3\" data-name=\"separator dot\">\n                ·\n            </span>\n            <span data-kid=\"3-3-4\" data-name=\"hint detail\">\n                En pantallas estrechas se cambia a pestañas\n            </span>\n        </div>\n        <section aria-label=\"Estados de reparaciones\" class=\"space-y-8\" data-kid=\"3-4\" data-name=\"Stacked mobile repairs board\">\n            <div class=\"border-t-2 border-[#FBBF24]\" data-kid=\"3-4-1\" data-name=\"Todo status column\">\n                <div class=\"flex items-end justify-between border-b border-[#334155] py-4\" data-kid=\"3-4-1-3\" data-name=\"column header container\">\n                    <div data-kid=\"3-4-1-3-1\" data-name=\"column title container\">\n                        <h2 class=\"text-[16px] font-bold text-white\" data-kid=\"3-4-1-3-1-1\" data-name=\"column title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Por revisar\n                        </h2>\n                        <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"3-4-1-3-1-2\" data-name=\"column description\">\n                            Recepción y diagnóstico\n                        </p>\n                    </div>\n                    <span class=\"text-[20px] font-bold tabular-nums text-[#FBBF24]\" data-dynamic=\"true\" data-kid=\"3-4-1-3-2\" data-name=\"todo status count\" data-reason=\"count updated by backend data\">\n                        04\n                    </span>\n                </div>\n                <div class=\"divide-y divide-[#334155] overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"3-4-1-4\" data-name=\"todo repairs list container\">\n                    <article class=\"py-5\" data-kid=\"3-4-1-1\" data-name=\"Toyota Corolla repair card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"3-4-1-1-1\" data-name=\"card top row\">\n                            <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"3-4-1-1-1-1\" data-name=\"car icon container\">\n                                <span class=\"mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center border border-[#475569] text-[#FBBF24]\" data-kid=\"3-4-1-1-1-1-1\" data-name=\"car icon\">\n                                    <i class=\"ti ti-car text-[16px]\" data-kid=\"3-4-1-1-1-1-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"3-4-1-1-1-1-2\" data-name=\"card details container\">\n                                    <h3 class=\"truncate text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"3-4-1-1-1-1-2-1\" data-name=\"vehicle model\">\n                                        Toyota Corolla\n                                    </h3>\n                                    <p class=\"mt-1 truncate text-[11px] text-[#94A3B8]\" data-kid=\"3-4-1-1-1-1-2-2\" data-name=\"plate and service description\">\n                                        P 482-916 · Cambio de aceite\n                                    </p>\n                                </div>\n                            </div>\n                            <span class=\"shrink-0 text-[11px] font-semibold text-[#FBBF24]\" data-kid=\"3-4-1-1-1-2\" data-name=\"priority tag\">\n                                Hoy\n                            </span>\n                        </div>\n                        <div class=\"mt-3 flex items-center justify-between pl-12 text-[11px]\" data-kid=\"3-4-1-1-2\" data-name=\"card bottom row\">\n                            <span class=\"flex items-center gap-1.5 text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"3-4-1-1-2-1\" data-name=\"time in queue display\" data-reason=\"time elapsed updated by script\">\n                                <i class=\"ti ti-clock text-[14px]\" data-kid=\"3-4-1-1-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                18 min en cola\n                            </span>\n                            <span class=\"text-right text-[#FBBF24]\" data-kid=\"3-4-1-1-2-2\" data-name=\"priority status label\">\n                                Prioridad media\n                            </span>\n                        </div>\n                        <button class=\"mt-3 ml-12 flex min-h-[44px] items-center gap-1 text-[11px] font-semibold text-[#38BDF8]\" data-kid=\"3-4-1-1-3\" data-name=\"review repair button\">\n                            Revisar vehículo\n                            <i class=\"ti ti-arrow-right text-[13px]\" data-kid=\"3-4-1-1-3-1\" data-name=\"arrow right icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </article>\n                    <article class=\"py-5\" data-kid=\"3-4-1-2\" data-name=\"Mazda 3 repair card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"3-4-1-2-1\" data-name=\"card top row\">\n                            <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"3-4-1-2-1-1\" data-name=\"car icon container\">\n                                <span class=\"mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center border border-[#475569] text-[#F87171]\" data-kid=\"3-4-1-2-1-1-1\" data-name=\"car icon\">\n                                    <i class=\"ti ti-car text-[16px]\" data-kid=\"3-4-1-2-1-1-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"3-4-1-2-1-1-2\" data-name=\"card details container\">\n                                    <h3 class=\"truncate text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"3-4-1-2-1-1-2-1\" data-name=\"vehicle model\">\n                                        Mazda 3\n                                    </h3>\n                                    <p class=\"mt-1 truncate text-[11px] text-[#94A3B8]\" data-kid=\"3-4-1-2-1-1-2-2\" data-name=\"plate and service description\">\n                                        H 731-204 · Frenos\n                                    </p>\n                                </div>\n                            </div>\n                            <span class=\"shrink-0 text-[11px] font-semibold text-[#F87171]\" data-kid=\"3-4-1-2-1-2\" data-name=\"priority tag\">\n                                Alta\n                            </span>\n                        </div>\n                        <div class=\"mt-3 flex items-center justify-between pl-12 text-[11px]\" data-kid=\"3-4-1-2-2\" data-name=\"card bottom row\">\n                            <span class=\"flex items-center gap-1.5 text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"3-4-1-2-2-1\" data-name=\"time in queue display\" data-reason=\"time elapsed updated by script\">\n                                <i class=\"ti ti-clock text-[14px]\" data-kid=\"3-4-1-2-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                42 min en cola\n                            </span>\n                            <span class=\"text-right text-[#F87171]\" data-kid=\"3-4-1-2-2-2\" data-name=\"priority status label\">\n                                Prioridad alta\n                            </span>\n                        </div>\n                        <button class=\"mt-3 ml-12 flex min-h-[44px] items-center gap-1 text-[11px] font-semibold text-[#38BDF8]\" data-kid=\"3-4-1-2-3\" data-name=\"review repair button\">\n                            Revisar vehículo\n                            <i class=\"ti ti-arrow-right text-[13px]\" data-kid=\"3-4-1-2-3-1\" data-name=\"arrow right icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </article>\n                </div>\n            </div>\n            <div class=\"border-t-2 border-[#38BDF8]\" data-kid=\"3-4-2\" data-name=\"In progress status column\">\n                <div class=\"flex items-end justify-between border-b border-[#334155] py-4\" data-kid=\"3-4-2-3\" data-name=\"column header container\">\n                    <div data-kid=\"3-4-2-3-1\" data-name=\"column title container\">\n                        <h2 class=\"text-[16px] font-bold text-white\" data-kid=\"3-4-2-3-1-1\" data-name=\"column title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            En curso\n                        </h2>\n                        <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"3-4-2-3-1-2\" data-name=\"column description\">\n                            Trabajo en taller\n                        </p>\n                    </div>\n                    <span class=\"text-[20px] font-bold tabular-nums text-[#38BDF8]\" data-dynamic=\"true\" data-kid=\"3-4-2-3-2\" data-name=\"in progress status count\" data-reason=\"count updated by backend data\">\n                        03\n                    </span>\n                </div>\n                <div class=\"divide-y divide-[#334155] overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"3-4-2-4\" data-name=\"in progress repairs list container\">\n                    <article class=\"py-5\" data-kid=\"3-4-2-1\" data-name=\"Renault Duster repair card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"3-4-2-1-1\" data-name=\"card top row\">\n                            <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"3-4-2-1-1-1\" data-name=\"tool icon container\">\n                                <span class=\"mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"3-4-2-1-1-1-1\" data-name=\"tool icon\">\n                                    <i class=\"ti ti-tool text-[16px]\" data-kid=\"3-4-2-1-1-1-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"3-4-2-1-1-1-2\" data-name=\"card details container\">\n                                    <h3 class=\"truncate text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"3-4-2-1-1-1-2-1\" data-name=\"vehicle model\">\n                                        Renault Duster\n                                    </h3>\n                                    <p class=\"mt-1 truncate text-[11px] text-[#94A3B8]\" data-kid=\"3-4-2-1-1-1-2-2\" data-name=\"plate and service description\">\n                                        J 204-118 · Diagnóstico\n                                    </p>\n                                </div>\n                            </div>\n                            <span class=\"shrink-0 text-[11px] font-semibold text-[#38BDF8]\" data-kid=\"3-4-2-1-1-2\" data-name=\"status tag\">\n                                Ahora\n                            </span>\n                        </div>\n                        <div class=\"mt-3 flex items-center justify-between pl-12 text-[11px]\" data-kid=\"3-4-2-1-2\" data-name=\"card bottom row\">\n                            <span class=\"flex items-center gap-1.5 text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"3-4-2-1-2-1\" data-name=\"time in progress display\" data-reason=\"time elapsed updated by script\">\n                                <i class=\"ti ti-clock text-[14px]\" data-kid=\"3-4-2-1-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                1 h 12 min\n                            </span>\n                            <span class=\"text-right text-[#38BDF8]\" data-kid=\"3-4-2-1-2-2\" data-name=\"status detail\">\n                                En diagnóstico\n                            </span>\n                        </div>\n                        <button class=\"mt-3 ml-12 flex min-h-[44px] items-center gap-1 text-[11px] font-semibold text-[#38BDF8]\" data-kid=\"3-4-2-1-3\" data-name=\"view repair button\">\n                            Ver reparación\n                            <i class=\"ti ti-arrow-right text-[13px]\" data-kid=\"3-4-2-1-3-1\" data-name=\"arrow right icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </article>\n                    <article class=\"py-5\" data-kid=\"3-4-2-2\" data-name=\"Toyota Corolla in-progress repair card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"3-4-2-2-1\" data-name=\"card top row\">\n                            <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"3-4-2-2-1-1\" data-name=\"tool icon container\">\n                                <span class=\"mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center border border-[#475569] text-[#38BDF8]\" data-kid=\"3-4-2-2-1-1-1\" data-name=\"tool icon\">\n                                    <i class=\"ti ti-tool text-[16px]\" data-kid=\"3-4-2-2-1-1-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"3-4-2-2-1-1-2\" data-name=\"card details container\">\n                                    <h3 class=\"truncate text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"3-4-2-2-1-1-2-1\" data-name=\"vehicle model\">\n                                        Toyota Corolla\n                                    </h3>\n                                    <p class=\"mt-1 truncate text-[11px] text-[#94A3B8]\" data-kid=\"3-4-2-2-1-1-2-2\" data-name=\"plate and service description\">\n                                        P 482-916 · Cambio de aceite\n                                    </p>\n                                </div>\n                            </div>\n                            <span class=\"shrink-0 text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"3-4-2-2-1-2\" data-name=\"status tag\">\n                                Hoy\n                            </span>\n                        </div>\n                        <div class=\"mt-3 flex items-center justify-between pl-12 text-[11px]\" data-kid=\"3-4-2-2-2\" data-name=\"card bottom row\">\n                            <span class=\"flex items-center gap-1.5 text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"3-4-2-2-2-1\" data-name=\"time in progress display\" data-reason=\"time elapsed updated by script\">\n                                <i class=\"ti ti-clock text-[14px]\" data-kid=\"3-4-2-2-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                35 min\n                            </span>\n                            <span class=\"text-right text-[#34D399]\" data-kid=\"3-4-2-2-2-2\" data-name=\"status detail\">\n                                En tiempo\n                            </span>\n                        </div>\n                        <button class=\"mt-3 ml-12 flex min-h-[44px] items-center gap-1 text-[11px] font-semibold text-[#38BDF8]\" data-kid=\"3-4-2-2-3\" data-name=\"view repair button\">\n                            Ver reparación\n                            <i class=\"ti ti-arrow-right text-[13px]\" data-kid=\"3-4-2-2-3-1\" data-name=\"arrow right icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </article>\n                </div>\n            </div>\n            <div class=\"border-t-2 border-[#34D399]\" data-kid=\"3-4-3\" data-name=\"Ready status column\">\n                <div class=\"flex items-end justify-between border-b border-[#334155] py-4\" data-kid=\"3-4-3-3\" data-name=\"column header container\">\n                    <div data-kid=\"3-4-3-3-1\" data-name=\"column title container\">\n                        <h2 class=\"text-[16px] font-bold text-white\" data-kid=\"3-4-3-3-1-1\" data-name=\"column title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Listas para entregar\n                        </h2>\n                        <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"3-4-3-3-1-2\" data-name=\"column description\">\n                            Confirmación del propietario\n                        </p>\n                    </div>\n                    <span class=\"text-[20px] font-bold tabular-nums text-[#34D399]\" data-dynamic=\"true\" data-kid=\"3-4-3-3-2\" data-name=\"ready status count\" data-reason=\"count updated by backend data\">\n                        02\n                    </span>\n                </div>\n                <div class=\"divide-y divide-[#334155]\" data-kid=\"3-4-3-4\" data-name=\"ready repairs list\">\n                    <article class=\"py-5\" data-kid=\"3-4-3-1\" data-name=\"Mazda 3 ready repair card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"3-4-3-1-1\" data-name=\"card top row\">\n                            <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"3-4-3-1-1-1\" data-name=\"check icon container\">\n                                <span class=\"mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center border border-[#475569] text-[#34D399]\" data-kid=\"3-4-3-1-1-1-1\" data-name=\"check circle icon\">\n                                    <i class=\"ti ti-circle-check text-[16px]\" data-kid=\"3-4-3-1-1-1-1-1\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"3-4-3-1-1-1-2\" data-name=\"card details container\">\n                                    <h3 class=\"truncate text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"3-4-3-1-1-1-2-1\" data-name=\"vehicle model\">\n                                        Mazda 3\n                                    </h3>\n                                    <p class=\"mt-1 truncate text-[11px] text-[#94A3B8]\" data-kid=\"3-4-3-1-1-1-2-2\" data-name=\"plate and service description\">\n                                        H 731-204 · Frenos\n                                    </p>\n                                </div>\n                            </div>\n                            <span class=\"shrink-0 text-[11px] font-semibold text-[#34D399]\" data-kid=\"3-4-3-1-1-2\" data-name=\"status tag\">\n                                Lista\n                            </span>\n                        </div>\n                        <div class=\"mt-3 flex items-center justify-between pl-12 text-[11px]\" data-kid=\"3-4-3-1-2\" data-name=\"card bottom row\">\n                            <span class=\"flex items-center gap-1.5 text-[#94A3B8]\" data-dynamic=\"true\" data-kid=\"3-4-3-1-2-1\" data-name=\"time ready display\" data-reason=\"time elapsed updated by script\">\n                                <i class=\"ti ti-clock text-[14px]\" data-kid=\"3-4-3-1-2-1-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Hace 24 min\n                            </span>\n                            <span class=\"text-right text-[#34D399]\" data-kid=\"3-4-3-1-2-2\" data-name=\"status detail\">\n                                Avisar al cliente\n                            </span>\n                        </div>\n                        <button class=\"mt-3 ml-12 flex min-h-[44px] items-center gap-1 text-[11px] font-semibold text-[#38BDF8]\" data-kid=\"3-4-3-1-3\" data-name=\"view repair button\">\n                            Ver reparación\n                            <i class=\"ti ti-arrow-right text-[13px]\" data-kid=\"3-4-3-1-3-1\" data-name=\"arrow right icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </article>\n                    <article class=\"py-5\" data-kid=\"3-4-3-2\" data-name=\"Toyota Corolla ready repair card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"3-4-3-2-1\" da