ass=\"flex min-h-[48px] flex-1 items-center justify-center gap-1 rounded-full border px-3 text-[11px] font-semibold\" data-kid=\"1-2-4-3-2-3-2\" data-name=\"suspend button\" style=\"border-color:#F87171;color:#FCA5A5\">\n                            <i class=\"ti ti-ban text-[14px]\" data-kid=\"1-2-4-3-2-3-2-1\" data-name=\"ban icon\">\n                            </i>\n                            Suspender\n                        </button>\n                    </div>\n                </article>\n                <article class=\"rounded-[16px] border p-4 shadow-[0_2px_4px_rgba(0,0,0,.20)]\" data-kid=\"1-2-4-3-3\" data-name=\"request card\" style=\"border-color:var(--outline);background:var(--surface-container)\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-4-3-3-1\" data-name=\"request header container\">\n                        <div class=\"min-w-0\" data-kid=\"1-2-4-3-3-1-1\" data-name=\"request info\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-2-4-3-3-1-1-1\" data-name=\"request title row\">\n                                <i class=\"ti ti-building-store text-[18px]\" data-kid=\"1-2-4-3-3-1-1-1-1\" data-name=\"store icon\" style=\"color:var(--primary);width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                <h3 class=\"truncate text-[16px] font-bold\" data-kid=\"1-2-4-3-3-1-1-1-2\" data-name=\"workshop name\">\n                                    Centro Auto\n                                </h3>\n                            </div>\n                            <span class=\"mt-2 inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-[.12em]\" data-kid=\"1-2-4-3-3-1-1-2\" data-name=\"suspended status badge\" style=\"background:#3F1D25;color:#FCA5A5\">\n                                <i class=\"ti ti-ban text-[12px]\" data-kid=\"1-2-4-3-3-1-1-2-1\" data-name=\"ban icon\">\n                                </i>\n                                Suspendido\n                            </span>\n                        </div>\n                        <button aria-label=\"Más acciones para Centro Auto\" class=\"flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border\" data-kid=\"1-2-4-3-3-1-2\" data-name=\"action menu button\" style=\"border-color:var(--outline-strong);color:var(--text-secondary)\">\n                            <i class=\"ti ti-dots text-[18px]\" data-kid=\"1-2-4-3-3-1-2-1\" data-name=\"dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-4 flex flex-wrap gap-2 text-[11px]\" data-kid=\"1-2-4-3-3-2\" data-name=\"workshop metadata container\" style=\"color:var(--text-secondary)\">\n                        <span class=\"rounded-full px-2.5 py-2\" data-kid=\"1-2-4-3-3-2-1\" data-name=\"specialty tag\" style=\"background:var(--surface-variant)\">\n                            <i class=\"ti ti-tool text-[12px]\" data-kid=\"1-2-4-3-3-2-1-1\" data-name=\"tool icon\" style=\"color:var(--primary)\">\n                            </i>\n                            Mecánica general\n                        </span>\n                        <span class=\"rounded-full px-2.5 py-2\" data-kid=\"1-2-4-3-3-2-2\" data-name=\"location tag\" style=\"background:var(--surface-variant)\">\n                            <i class=\"ti ti-map-pin text-[12px]\" data-kid=\"1-2-4-3-3-2-2-1\" data-name=\"map pin icon\" style=\"color:var(--primary)\">\n                            </i>\n                            Soyapango\n                        </span>\n                    </div>\n                    <div class=\"mt-4 flex items-center gap-2 border-t pt-3\" data-kid=\"1-2-4-3-3-3\" data-name=\"request actions footer\" style=\"border-color:var(--outline)\">\n                        <span class=\"flex flex-1 items-center gap-2 text-[11px]\" data-kid=\"1-2-4-3-3-3-1\" data-name=\"security warning text\" style=\"color:var(--muted)\">\n                            <i class=\"ti ti-shield-check text-[14px]\" data-kid=\"1-2-4-3-3-3-1-1\" data-name=\"shield check icon\" style=\"color:var(--error)\">\n                            </i>\n                            Acción protegida\n                        </span>\n                        <button class=\"flex min-h-[48px] flex-1 items-center justify-center gap-1 rounded-full px-3 text-[11px] font-bold\" data-kid=\"1-2-4-3-3-3-2\" data-name=\"reactivate button\" style=\"background:var(--success);color:var(--on-primary)\">\n                            <i class=\"ti ti-refresh text-[14px]\" data-kid=\"1-2-4-3-3-3-2-1\" data-name=\"refresh icon\">\n                            </i>\n                            Reactivar\n                        </button>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <footer class=\"mt-7 border-t pt-5 text-[11px]\" data-kid=\"1-2-5\" data-name=\"footer container\" style=\"border-color:var(--outline);color:var(--muted)\">\n            <div data-kid=\"1-2-5-1\" data-name=\"footer copyright text\">\n                AutoDoc · Consola de administración\n            </div>\n            <div class=\"mt-2 flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"1-2-5-2\" data-name=\"sync status indicator container\" data-reason=\"sync timestamp updated periodically by script\">\n                <span class=\"size-1.5 rounded-full\" data-kid=\"1-2-5-2-1\" data-name=\"status dot\" style=\"background:var(--success)\">\n                </span>\n                Datos sincronizados hace 3 min · Los cambios requieren confirmación.\n            </div>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación de administración\" class=\"fixed inset-x-0 bottom-0 z-40 border-t px-2 pb-[env(safe-area-inset-bottom)] pt-2 backdrop-blur-sm\" data-kid=\"1-3\" data-name=\"mobile navigation bar\" style=\"border-color:var(--outline);background:rgba(2,6,23,.98)\">\n        <div class=\"mx-auto grid max-w-[480px] grid-cols-5 gap-1\" data-kid=\"1-3-1\" data-name=\"navigation grid container\">\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[10px] font-medium\" data-kid=\"1-3-1-1\" data-name=\"navigation link\" href=\"#resumen\" style=\"color:var(--text-secondary)\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"1-3-1-1-1\" data-name=\"dashboard icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-1-2\" data-name=\"nav label\">\n                    Resumen\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[10px] font-medium\" data-kid=\"1-3-1-2\" data-name=\"navigation link\" href=\"#usuarios\" style=\"color:var(--text-secondary)\">\n                <i class=\"ti ti-users text-[18px]\" data-kid=\"1-3-1-2-1\" data-name=\"users icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-2-2\" data-name=\"nav label\">\n                    Usuarios\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 border-t-2 text-[10px] font-bold\" data-kid=\"1-3-1-3\" data-name=\"active navigation link\" href=\"#talleres\" style=\"border-color:var(--primary);background:var(--surface-variant);color:var(--primary)\">\n                <i class=\"ti ti-building-store text-[18px]\" data-kid=\"1-3-1-3-1\" data-name=\"workshop icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-3-2\" data-name=\"nav label\">\n                    Talleres\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[10px] font-medium\" data-kid=\"1-3-1-4\" data-name=\"navigation link\" href=\"#resenias\" style=\"color:var(--text-secondary)\">\n                <i class=\"ti ti-star text-[18px]\" data-kid=\"1-3-1-4-1\" data-name=\"reviews icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-4-2\" data-name=\"nav label\">\n                    Reseñas\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[10px] font-medium\" data-kid=\"1-3-1-5\" data-name=\"navigation link\" href=\"#logs\" style=\"color:var(--text-secondary)\">\n                <i class=\"ti ti-list-details text-[18px]\" data-kid=\"1-3-1-5-1\" data-name=\"logs icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-5-2\" data-name=\"nav label\">\n                    Logs\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
