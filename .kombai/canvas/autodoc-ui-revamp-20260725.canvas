    "var_2b1f63b300d5": {
      "type": "variant",
      "label": "AutoDoc Task Complete — Hadrian Light Mobile",
      "parentId": "var_5640eab77b38",
      "themeId": null,
      "rect": {
        "x": 66305,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    [data-name=\"back action button\"] { min-width:44px; min-height:44px; border-radius:999px; border:1px solid #334155; background:#141E36; color:#CBD5E1; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"back action button\"]:hover { background:#1E293B; color:#81E6D9; box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"back action button\"]:active { transform:scale(.97); }\n  [data-name=\"success header block\"], [data-name=\"service completion details\"] { overflow:hidden; border:1px solid rgba(203,213,225,.4); border-radius:16px; background:#EEEDF0; box-shadow:0 2px 4px rgba(15,23,42,.05); }\n  [data-name=\"return dashboard button\"] { min-height:48px; border-radius:999px; background:linear-gradient(135deg,#522C81,#45236F); color:#FFFFFF; box-shadow:0 2px 4px rgba(15,23,42,.05); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"return dashboard button\"]:hover { transform:scale(1.02); box-shadow:0 6px 14px rgba(15,23,42,.1); }\n  [data-name=\"return dashboard button\"]:active { transform:scale(.97); }\n  [data-name=\"view history button\"] { min-height:48px; border:1px solid #CBD5E1; border-radius:999px; background:#EEEDF0; color:#334155; box-shadow:0 2px 4px rgba(15,23,42,.05); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"view history button\"]:hover { background:#F7F6F8; box-shadow:0 6px 14px rgba(15,23,42,.1); }\n  [data-name=\"view history button\"]:active { transform:scale(.97); }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile task complete page\">\n    <section class=\"relative overflow-hidden bg-[#0F172A] px-4 pb-6 pt-4 text-white\" data-kid=\"2-1\" data-name=\"mobile technical record header\">\n        <div class=\"absolute inset-0 opacity-60 [background-image:linear-gradient(rgba(148,163,184,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.08)_1px,transparent_1px)] [background-size:32px_32px]\" data-kid=\"2-1-1\" data-name=\"technical grid background\">\n        </div>\n        <div class=\"relative flex min-h-[52px] items-center justify-between\" data-kid=\"2-1-2\" data-name=\"mobile top bar\">\n            <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-1\" data-name=\"brand lockup\">\n                <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-2-1-1\" data-name=\"brand mark\">\n                    AD\n                </div>\n                <div data-kid=\"2-1-2-1-2\" data-name=\"brand name container\">\n                    <div class=\"font-heading text-[17px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-2-1-2-1\" data-name=\"brand name text\">\n                        AutoDoc\n                    </div>\n                    <div class=\"mt-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#94A3B8]\" data-kid=\"2-1-2-1-2-2\" data-name=\"brand subtitle text\">\n                        Vehicle log\n                    </div>\n                </div>\n            </div>\n            <button aria-label=\"Volver al servicio\" class=\"grid min-h-[44px] min-w-[44px] place-items-center border border-[#334155] text-[18px] text-[#CBD5E1]\" data-kid=\"2-1-2-2\" data-name=\"back action button\">\n                <i class=\"ti ti-arrow-left\" data-kid=\"2-1-2-2-1\" data-name=\"back icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n        <div class=\"relative mt-6\" data-kid=\"2-1-3\" data-name=\"technical illustration content\">\n            <div class=\"mb-4 flex items-center gap-3 text-[#94A3B8]\" data-kid=\"2-1-3-1\" data-name=\"completion reference label\">\n                <span class=\"h-px w-8 bg-[#1E88E5]\" data-kid=\"2-1-3-1-1\" data-name=\"label horizontal rule\">\n                </span>\n                <span class=\"text-[9px] font-bold uppercase tracking-[0.18em]\" data-kid=\"2-1-3-1-2\" data-name=\"reference text\">\n                    Maintenance record / 042\n                </span>\n            </div>\n            <div class=\"relative flex h-[142px] items-center justify-center border-y border-[#334155]\" data-kid=\"2-1-3-2\" data-name=\"vehicle technical frame\">\n                <div class=\"absolute left-0 top-3 text-[9px] font-semibold tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-1\" data-name=\"mileage label\">\n                    48,260 KM\n                </div>\n                <div class=\"absolute bottom-3 right-0 text-[9px] font-semibold tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-2\" data-name=\"date label\">\n                    12 JUN 2026\n                </div>\n                <div class=\"absolute left-1/2 top-1/2 h-px w-[210px] -translate-x-1/2 bg-[#1E88E5]/50\" data-kid=\"2-1-3-2-3\" data-name=\"frame horizontal rule\">\n                </div>\n                <div class=\"absolute left-1/2 top-1/2 h-[94px] w-[94px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#1E88E5]/40\" data-kid=\"2-1-3-2-4\" data-name=\"outer circular outline\">\n                </div>\n                <div class=\"absolute left-1/2 top-1/2 h-[62px] w-[62px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#10B981]/60\" data-kid=\"2-1-3-2-5\" data-name=\"inner circular accent\">\n                </div>\n                <i aria-hidden=\"true\" class=\"ti ti-steering-wheel text-[44px] text-[#E2E8F0]\" data-kid=\"2-1-3-2-6\" data-name=\"steering wheel icon\" style=\"width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <div class=\"mt-5 grid grid-cols-2 gap-4\" data-kid=\"2-1-4\" data-name=\"technical metadata\">\n                <div class=\"border-l-2 border-[#10B981] pl-3\" data-kid=\"2-1-4-1\" data-name=\"registration status block\">\n                    <div class=\"text-[9px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-4-1-1\" data-name=\"registration status label\">\n                        Registro\n                    </div>\n                    <div class=\"mt-1 text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-4-1-2\" data-name=\"registration status value\">\n                        Sincronizado\n                    </div>\n                </div>\n                <div class=\"border-l-2 border-[#1E88E5] pl-3\" data-kid=\"2-1-4-2\" data-name=\"next service block\">\n                    <div class=\"text-[9px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-4-2-1\" data-name=\"next service label\">\n                        Próximo\n                    </div>\n                    <div class=\"mt-1 text-[12px] font-semibold text-[#E2E8F0]\" data-kid=\"2-1-4-2-2\" data-name=\"next service value\">\n                        10,000 km\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"relative mt-5 flex items-center justify-between border-t border-[#334155] pt-4 text-[10px] text-[#64748B]\" data-kid=\"2-1-5\" data-name=\"technical footer\">\n            <span data-kid=\"2-1-5-1\" data-name=\"copyright notice\">\n                AutoDoc · 2026\n            </span>\n            <span class=\"flex items-center gap-2\" data-kid=\"2-1-5-2\" data-name=\"connection status indicator\">\n                <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-1-5-2-1\" data-name=\"status dot\">\n                </span>\n                Registro seguro\n            </span>\n        </div>\n    </section>\n    <main class=\"px-4 pb-28 pt-5\" data-kid=\"2-2\" data-name=\"confirmation content area\">\n        <section aria-labelledby=\"complete-heading\" class=\"w-full\" data-kid=\"2-2-1\" data-name=\"completion confirmation section\">\n            <div class=\"mb-6 flex items-center justify-between gap-3 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"confirmation breadcrumb\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"breadcrumb path\">\n                    Propietario / Servicio\n                </span>\n                <span class=\"shrink-0 font-semibold tabular-nums text-[#94A3B8]\" data-kid=\"2-2-1-1-2\" data-name=\"breadcrumb registration ID\">\n                    Registro 042\n                </span>\n            </div>\n            <div class=\"border-y border-[#CBD5E1] py-7\" data-kid=\"2-2-1-2\" data-name=\"success header block\">\n                <div class=\"flex items-start gap-4\" data-kid=\"2-2-1-2-1\" data-name=\"success icon and heading\">\n                    <div aria-label=\"Tarea completada correctamente\" class=\"grid size-14 shrink-0 place-items-center rounded-full border-2 border-[#10B981] bg-[#ECFDF5] text-[#10B981]\" data-kid=\"2-2-1-2-1-1\" data-name=\"accessible success icon\" role=\"img\">\n                        <i aria-hidden=\"true\" class=\"ti ti-check text-[28px]\" data-kid=\"2-2-1-2-1-1-1\" data-name=\"checkmark icon\" style=\"width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-2-1-2-1-2\" data-name=\"success message text group\">\n                        <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-[#10B981]\" data-kid=\"2-2-1-2-1-2-1\" data-name=\"success category label\">\n                            Registro confirmado\n                        </p>\n                        <h1 class=\"font-heading text-[27px] font-extrabold leading-tight tracking-[-0.05em] text-[#0F172A]\" data-kid=\"2-2-1-2-1-2-2\" data-name=\"success headline\" id=\"complete-heading\">\n                            Tarea completada\n                        </h1>\n                        <p class=\"mt-2 text-[14px] leading-6 text-[#475569]\" data-kid=\"2-2-1-2-1-2-3\" data-name=\"success description text\">\n                            El mantenimiento de tu vehículo quedó registrado.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"border-b border-[#CBD5E1] py-6\" data-kid=\"2-2-1-3\" data-name=\"service completion details\">\n                <div data-kid=\"2-2-1-3-1\" data-name=\"service summary\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.15em] text-[#64748B]\" data-kid=\"2-2-1-3-1-1\" data-name=\"service label\">\n                        Servicio registrado\n                    </p>\n                    <h2 class=\"mt-3 font-heading text-[20px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-2-1-3-1-2\" data-name=\"vehicle model title\">\n                        Toyota Corolla 2022\n                    </h2>\n                    <p class=\"mt-1 text-[14px] text-[#475569]\" data-kid=\"2-2-1-3-1-3\" data-name=\"service description\">\n                        Cambio de aceite\n                    </p>\n                    <div class=\"mt-5 grid grid-cols-2 gap-3\" data-kid=\"2-2-1-3-1-4\" data-name=\"service metadata row\">\n                        <span class=\"flex min-h-[44px] items-center gap-2 text-[12px] text-[#334155]\" data-kid=\"2-2-1-3-1-4-1\" data-name=\"mileage metadata group\">\n                            <i aria-hidden=\"true\" class=\"ti ti-steering-wheel text-[16px] text-[#1E88E5]\" data-kid=\"2-2-1-3-1-4-1-1\" data-name=\"steering wheel icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <strong class=\"tabular-nums font-semibold\" data-kid=\"2-2-1-3-1-4-1-2\" data-name=\"mileage value\">\n                                48,260 km\n                            </strong>\n                        </span>\n                        <span class=\"flex min-h-[44px] items-center gap-2 text-[12px] text-[#334155]\" data-kid=\"2-2-1-3-1-4-2\" data-name=\"date metadata group\">\n                            <i aria-hidden=\"true\" class=\"ti ti-calendar-event text-[16px] text-[#1E88E5]\" data-kid=\"2-2-1-3-1-4-2-1\" data-name=\"calendar icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <strong class=\"font-semibold\" data-kid=\"2-2-1-3-1-4-2-2\" data-name=\"date value\">\n                                12 jun 2026\n                            </strong>\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-6 border-t border-[#E2E8F0] pt-5\" data-kid=\"2-2-1-3-2\" data-name=\"next reminder block\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.15em] text-[#64748B]\" data-kid=\"2-2-1-3-2-1\" data-name=\"next reminder label\">\n                        Siguiente recordatorio\n                    </p>\n                    <p class=\"mt-2 font-heading text-[21px] font-bold tabular-nums tracking-[-0.03em] text-[#1E88E5]\" data-kid=\"2-2-1-3-2-2\" data-name=\"next reminder value\">\n                        10,000 km\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"2-2-1-3-2-3\" data-name=\"reminder note\">\n                        Revisión recomendada\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex min-h-[52px] items-center gap-3 border-b border-[#CBD5E1] py-4 text-[12px] text-[#334155]\" data-kid=\"2-2-1-4\" data-name=\"sync confirmation message\">\n                <i aria-hidden=\"true\" class=\"ti ti-cloud-check shrink-0 text-[18px] text-[#10B981]\" data-kid=\"2-2-1-4-1\" data-name=\"cloud check icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"2-2-1-4-2\" data-name=\"sync status text\">\n                    Tus datos se sincronizaron con tu garaje\n                </span>\n            </div>\n            <div class=\"mt-6 flex flex-col gap-3\" data-kid=\"2-2-1-5\" data-name=\"completion actions\">\n                <button class=\"inline-flex min-h-[48px] w-full items-center justify-center gap-2 bg-[#1E88E5] px-5 py-3 text-[13px] font-bold text-white\" data-kid=\"2-2-1-5-1\" data-name=\"return dashboard button\">\n                    Volver al dashboard\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"2-2-1-5-1-1\" data-name=\"arrow icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"inline-flex min-h-[48px] w-full items-center justify-center gap-2 border border-[#94A3B8] bg-white px-5 py-3 text-[13px] font-bold text-[#1E3A5F]\" data-kid=\"2-2-1-5-2\" data-name=\"view history button\">\n                    Ver historial\n                    <i aria-hidden=\"true\" class=\"ti ti-history text-[16px]\" data-kid=\"2-2-1-5-2-1\" data-name=\"history icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <p class=\"mt-6 text-[11px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-6\" data-name=\"confirmation footer\">\n                Puedes consultar este registro y tus próximos recordatorios desde el historial de tu vehículo.\n            </p>\n        </section>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-20 border-t border-[#CBD5E1] bg-white/95 px-2 pt-2 shadow-[0_-4px_16px_rgba(15,23,42,0.08)] backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"fixed mobile bottom navigation\" style=\"padding-bottom:env(safe-area-inset-bottom)\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-4 gap-1\" data-kid=\"2-3-1\" data-name=\"bottom navigation items\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#1E88E5]\" data-kid=\"2-3-1-1\" data-name=\"home navigation item\" href=\"#inicio\">\n                <i class=\"ti ti-home-2 text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"home icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-1-2\" data-name=\"home text\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-2\" data-name=\"garage navigation item\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"garage icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"garage text\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-3\" data-name=\"workshops navigation item\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"workshops text\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-label=\"Historial\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-4\" data-name=\"history navigation item\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"history text\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
      "created": "2026-08-17T20:18:09.713580+00:00",
