-items:center;justify-content:center\">\n                                </i>\n                                Pendiente\n                            </span>\n                        </div>\n                        <button aria-label=\"Más acciones de Taller Rápido\" class=\"touch flex min-w-[48px] items-center justify-center rounded-full border border-[var(--outline)] bg-[var(--surface)] text-[var(--text-secondary)]\" data-kid=\"1-2-4-3-1-1-2\" data-name=\"card actions menu button\">\n                            <i class=\"ti ti-dots text-[17px]\" data-kid=\"1-2-4-3-1-1-2-1\" data-name=\"dots icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-3 border-t border-[var(--outline)] pt-3 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-2-4-3-1-2\" data-name=\"request meta info\">\n                        <span data-kid=\"1-2-4-3-1-2-1\" data-name=\"specialty info\">\n                            <i class=\"ti ti-tool text-[14px] text-[var(--primary)]\" data-kid=\"1-2-4-3-1-2-1-1\" data-name=\"tool icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Mantenimiento general\n                        </span>\n                        <span data-kid=\"1-2-4-3-1-2-2\" data-name=\"location info\">\n                            <i class=\"ti ti-map-pin text-[14px] text-[var(--primary)]\" data-kid=\"1-2-4-3-1-2-2-1\" data-name=\"location pin icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            San Salvador\n                        </span>\n                    </div>\n                    <div class=\"mt-4 border-t border-[var(--outline)] pt-3\" data-kid=\"1-2-4-3-1-3\" data-name=\"request confirmation footer\">\n                        <p class=\"flex items-center gap-2 text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-4-3-1-3-1\" data-name=\"protected action notice\">\n                            <i class=\"ti ti-shield-check text-[15px] text-[var(--primary)]\" data-kid=\"1-2-4-3-1-3-1-1\" data-name=\"shield check icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Acción protegida · Requiere confirmación\n                        </p>\n                        <div class=\"mt-3 grid grid-cols-2 gap-2\" data-kid=\"1-2-4-3-1-3-2\" data-name=\"confirmation buttons container\">\n                            <button class=\"touch rounded-full border border-[var(--error)] px-3 text-[12px] font-semibold text-[var(--error)]\" data-kid=\"1-2-4-3-1-3-2-1\" data-name=\"reject button\">\n                                Rechazar\n                            </button>\n                            <button class=\"touch rounded-full bg-[var(--success)] px-3 text-[12px] font-bold text-white\" data-kid=\"1-2-4-3-1-3-2-2\" data-name=\"approve button\">\n                                Aprobar\n                            </button>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"rounded-[16px] border border-[var(--outline)] bg-[var(--surface-container)] p-4 shadow-[0_2px_4px_rgba(15,23,42,0.05)]\" data-kid=\"1-2-4-3-2\" data-name=\"workshop request card approved\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-4-3-2-1\" data-name=\"request card header\">\n                        <div data-kid=\"1-2-4-3-2-1-1\" data-name=\"request name and status container\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-2-4-3-2-1-1-1\" data-name=\"request icon and name group\">\n                                <i class=\"ti ti-building-store text-[18px] text-[var(--primary)]\" data-kid=\"1-2-4-3-2-1-1-1-1\" data-name=\"workshop icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                <h3 class=\"font-heading text-[16px] font-bold\" data-kid=\"1-2-4-3-2-1-1-1-2\" data-name=\"workshop name\">\n                                    MotorLab\n                                </h3>\n                            </div>\n                            <span class=\"mt-2 inline-flex items-center gap-1 rounded-full bg-[var(--success-surface)] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.1em] text-[var(--success)]\" data-kid=\"1-2-4-3-2-1-1-2\" data-name=\"request status badge\">\n                                <i class=\"ti ti-circle-check text-[12px]\" data-kid=\"1-2-4-3-2-1-1-2-1\" data-name=\"status check icon\" style=\"width:12px;height:12px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                                Aprobado\n                            </span>\n                        </div>\n                        <button aria-label=\"Más acciones de MotorLab\" class=\"touch flex min-w-[48px] items-center justify-center rounded-full border border-[var(--outline)] bg-[var(--surface)] text-[var(--text-secondary)]\" data-kid=\"1-2-4-3-2-1-2\" data-name=\"card actions menu button\">\n                            <i class=\"ti ti-dots text-[17px]\" data-kid=\"1-2-4-3-2-1-2-1\" data-name=\"dots icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"mt-4 flex items-center gap-2 border-t border-[var(--outline)] pt-3 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-2-4-3-2-2\" data-name=\"request meta info\">\n                        <i class=\"ti ti-tool text-[14px] text-[var(--primary)]\" data-kid=\"1-2-4-3-2-2-1\" data-name=\"tool icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Diagnóstico y frenos\n                    </div>\n                    <button class=\"touch mt-4 flex w-full items-center justify-center gap-2 rounded-full border border-[var(--error)] text-[12px] font-semibold text-[var(--error)]\" data-kid=\"1-2-4-3-2-3\" data-name=\"suspend button\">\n                        <i class=\"ti ti-ban text-[15px]\" data-kid=\"1-2-4-3-2-3-1\" data-name=\"ban icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Suspender\n                    </button>\n                </article>\n                <div class=\"rounded-[16px] border border-dashed border-[var(--outline)] bg-[var(--surface-container)] p-4 text-[12px] text-[var(--text-secondary)]\" data-kid=\"1-2-4-3-3\" data-name=\"empty workshop state cue\">\n                    <i class=\"ti ti-inbox text-[17px] text-[var(--text-secondary)]\" data-kid=\"1-2-4-3-3-1\" data-name=\"inbox icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    No hay talleres con este filtro\n                </div>\n            </div>\n        </section>\n        <footer class=\"mt-7 border-t border-[var(--outline)] pt-5 text-[11px] text-[var(--text-secondary)]\" data-kid=\"1-2-5\" data-name=\"footer bar\">\n            <p class=\"flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"1-2-5-1\" data-name=\"footer sync status text\" data-reason=\"sync time updated periodically by script\">\n                <span class=\"size-1.5 rounded-full bg-[var(--success)]\" data-kid=\"1-2-5-1-1\" data-name=\"sync status indicator dot\">\n                </span>\n                Datos sincronizados hace 4 min · Cambios administrativos requieren confirmación.\n            </p>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación de administración\" class=\"fixed inset-x-0 bottom-0 z-40 border-t border-[var(--outline)] bg-[var(--surface)]/95 px-2 pb-[env(safe-area-inset-bottom)] pt-2 backdrop-blur-sm\" data-kid=\"1-3\" data-name=\"admin mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[480px] grid-cols-5 gap-1\" data-kid=\"1-3-1\" data-name=\"navigation items container\">\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-3-1-1\" data-name=\"resumen navigation link\" href=\"#resumen\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"1-3-1-1-1\" data-name=\"dashboard icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-1-2\">\n                    Resumen\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-3-1-2\" data-name=\"usuarios navigation link\" href=\"#usuarios\">\n                <i class=\"ti ti-users text-[18px]\" data-kid=\"1-3-1-2-1\" data-name=\"users icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-2-2\">\n                    Usuarios\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 border-t-2 border-[var(--primary)] bg-[#F0EAF7] text-[10px] font-bold text-[var(--primary)]\" data-kid=\"1-3-1-3\" data-name=\"talleres navigation link\" href=\"#talleres\">\n                <i class=\"ti ti-building-store text-[18px]\" data-kid=\"1-3-1-3-1\" data-name=\"workshop icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-3-2\">\n                    Talleres\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-3-1-4\" data-name=\"resenas navigation link\" href=\"#resenas\">\n                <i class=\"ti ti-star text-[18px]\" data-kid=\"1-3-1-4-1\" data-name=\"star icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-4-2\">\n                    Reseñas\n                </span>\n            </a>\n            <a class=\"flex min-h-[54px] flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[var(--text-secondary)]\" data-kid=\"1-3-1-5\" data-name=\"logs navigation link\" href=\"#logs\">\n                <i class=\"ti ti-list-details text-[18px]\" data-kid=\"1-3-1-5-1\" data-name=\"list details icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-3-1-5-2\">\n                    Logs\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
      "created": "2026-08-17T22:15:09.133909+00:00",
      "modified": "2026-08-17T22:15:39.695519+00:00",
