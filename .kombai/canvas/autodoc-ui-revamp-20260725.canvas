      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n    aside button { min-width: 44px; min-height: 44px; border: 1px solid rgba(51,65,85,.2); border-radius: 9999px; background: #141E36; box-shadow: 0 2px 4px rgba(0,0,0,.2); transition: transform 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n    aside button:hover { background: #1E293B; box-shadow: 0 6px 14px rgba(0,0,0,.35); }\n    aside button:active { transform: scale(.97); }\n    aside button[class*=\"bg-[#1E293B]\"] { background: #1E293B; border-color: #38BDF8; color: #38BDF8; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons CSS library\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"service history application root\" style=\"font-family:'IBM Plex Sans',sans-serif\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"service history shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center justify-between border-r border-[#334155] bg-[#020617] py-6\" data-kid=\"2-1-1\" data-name=\"navigation icon rail\">\n            <div class=\"flex flex-col items-center gap-9\" data-kid=\"2-1-1-1\" data-name=\"primary rail navigation\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    <span class=\"text-[18px] font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1-1-1\" data-name=\"AutoDoc logo initials\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-1-2\" data-name=\"rail destination buttons\">\n                    <button aria-label=\"Inicio\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-1\" data-name=\"navigation to dashboard\">\n                        <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Mi garaje\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-2\" data-name=\"navigation to garage\">\n                        <i class=\"ti ti-steering-wheel text-[19px]\" data-kid=\"2-1-1-1-2-2-1\" data-name=\"steering wheel icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Talleres\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-3\" data-name=\"navigation to workshops\">\n                        <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-1-1-1-2-3-1\" data-name=\"tool icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Alertas\" class=\"flex h-10 w-10 items-center justify-center text-[#94A3B8]\" data-kid=\"2-1-1-1-2-4\" data-name=\"navigation to alerts\">\n                        <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-1-1-1-2-4-1\" data-name=\"alert triangle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Historial\" class=\"flex h-10 w-10 items-center justify-center border-l-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-1-1-1-2-5\" data-name=\"navigation to history (active)\">\n                        <i class=\"ti ti-history text-[19px]\" data-kid=\"2-1-1-1-2-5-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center gap-5 text-[#94A3B8]\" data-kid=\"2-1-1-2\" data-name=\"rail utility buttons\">\n                <button aria-label=\"Configuración\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-1\" data-name=\"navigation to settings\">\n                    <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ayuda\" class=\"flex h-10 w-10 items-center justify-center\" data-kid=\"2-1-1-2-2\" data-name=\"navigation to help\">\n                    <i class=\"ti ti-help-circle text-[19px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"help icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#334155] bg-[#0B1220]\" data-kid=\"2-1-2\" data-name=\"contextual owner sidebar\">\n            <div class=\"border-b border-[#334155] px-6 py-7\" data-kid=\"2-1-2-1\" data-name=\"owner identity header\">\n                <div class=\"text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-1-1\" data-name=\"owner identity label\">\n                    Propietario\n                </div>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"brand name and status indicator\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    <span class=\"text-[19px] font-extrabold tracking-[-0.04em]\" data-kid=\"2-1-2-1-2-1\" data-name=\"brand name\">\n                        Auto\n                        <span class=\"text-[#38BDF8]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"brand accent text\">\n                            Doc\n                        </span>\n                    </span>\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-1-2-1-2-2\" data-name=\"active status indicator\">\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación del propietario\" class=\"flex-1 px-4 py-6\" data-kid=\"2-1-2-2\" data-name=\"owner contextual navigation\">\n                <div class=\"mb-3 px-3 text-[12px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-2-2-1\" data-name=\"workspace header\">\n                    Espacio de trabajo\n                </div>\n                <div class=\"space-y-1\" data-kid=\"2-1-2-2-2\" data-name=\"navigation links group\">\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-1\" data-name=\"home link\" href=\"#\">\n                        <i class=\"ti ti-home-2 text-[17px]\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"home icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Inicio\n                    </a>\n                    <a class=\"flex items-center gap-3 border-l-2 border-transparent px-3 py-3 text-[13px] font-medium text-[#94A3B8]\" data-kid=\"2-1-2-2-2-2\" data-name=\"garage link\" href=\"#\">\n                        <i class=\"ti ti-car text-[17px