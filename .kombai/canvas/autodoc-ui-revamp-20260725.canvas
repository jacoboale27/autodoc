    "var_9c5abfc1247e": {
      "type": "variant",
      "label": "AutoDoc Initiate Service — Hadrian Light Mobile",
      "parentId": "var_26604e73179b",
      "themeId": null,
      "rect": {
        "x": 40335,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .safe-bottom { padding-bottom: max(12px, env(safe-area-inset-bottom)); }\n</style>\n<div class=\"font-body min-h-screen w-full overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile initiate service application\">\n    <header class=\"sticky top-0 z-20 flex min-h-[72px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"mobile top header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile workshop context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-4\" data-name=\"mobile context wrapper\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2\" data-name=\"mobile workshop role\">\n                    Taller\n                </p>\n                <p class=\"truncate font-heading text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-1-1-3\" data-name=\"mobile current page\">\n                    Nueva reparación\n                </p>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header actions\">\n            <button aria-label=\"Guardar borrador\" class=\"grid min-h-11 min-w-11 place-items-center text-[19px] text-[#1E88E5]\" data-kid=\"2-1-2-1\" data-name=\"save draft icon button\">\n                <i class=\"ti ti-device-floppy\" data-kid=\"2-1-2-1-1\" data-name=\"floppy disk icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <button aria-label=\"Notificaciones\" class=\"relative grid min-h-11 min-w-11 place-items-center text-[19px] text-[#64748B]\" data-kid=\"2-1-2-2\" data-name=\"notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-2-2\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 size-2 rounded-full bg-[#EF4444]\" data-kid=\"2-1-2-2-1\" data-name=\"notification dot\">\n                </span>\n            </button>\n            <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3\" data-name=\"user avatar\">\n                MR\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[520px] px-4 pb-32 pt-6\" data-kid=\"2-2\" data-name=\"mobile service form body\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"mobile page heading\">\n            <div class=\"mb-2 flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"mobile breadcrumb\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"breadcrumb workshop label\">\n                    Taller\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-1-3\" data-name=\"breadcrumb current page label\">\n                    Nueva reparación\n                </span>\n            </div>\n            <h1 class=\"font-heading text-[27px] font-extrabold leading-tight tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2\" data-name=\"page headline\">\n                Registrar servicio\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-3\" data-name=\"page description\">\n                Documenta el trabajo realizado y deja el historial listo para el propietario.\n            </p>\n            <div class=\"mt-4 inline-flex min-h-10 items-center gap-2 border border-[#F59E0B]/40 bg-[#FFFBEB] px-3 text-[12px] font-semibold text-[#92400E]\" data-kid=\"2-2-1-4\" data-name=\"unsaved changes notice\">\n                <span class=\"size-2 shrink-0 rounded-full bg-[#F59E0B]\" data-kid=\"2-2-1-4-1\" data-name=\"unsaved changes indicator dot\">\n                </span>\n                Cambios sin guardar\n            </div>\n        </div>\n        <section class=\"border-y border-[#CBD5E1] bg-white px-4 py-4\" data-kid=\"2-2-2\" data-name=\"vehicle service strip\">\n            <div class=\"flex items-start gap-3\" data-kid=\"2-2-2-1\" data-name=\"vehicle identity\">\n                <span class=\"grid size-11 shrink-0 place-items-center border border-[#CBD5E1] text-[21px] text-[#1E88E5]\" data-kid=\"2-2-2-1-1\" data-name=\"vehicle icon wrapper\">\n                    <i class=\"ti ti-car\" data-kid=\"2-2-2-1-1-1\" data-name=\"car icon\" style=\"width:21px;height:21px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"2-2-2-1-2\" data-name=\"vehicle info\">\n                    <p class=\"font-heading text-[16px] font-bold text-[#0F172A]\" data-kid=\"2-2-2-1-2-1\" data-name=\"vehicle model and year\">\n                        Toyota Corolla 2022\n                    </p>\n                    <p class=\"mt-1 text-[12px] tabular-nums text-[#64748B]\" data-kid=\"2-2-2-1-2-2\" data-name=\"vehicle plate and mileage info\">\n                        P 482-916\n                        <span class=\"mx-1 text-[#CBD5E1]\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"vehicle info separator\">\n                            ·\n                        </span>\n                        48,260 km\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-4 flex items-center justify-between gap-3 border-t border-[#E2E8F0] pt-3\" data-kid=\"2-2-2-2\" data-name=\"service status row\">\n                <span class=\"inline-flex items-center gap-2 text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-2-2-2-1\" data-name=\"service status label\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-2-2-2-1-1\" data-name=\"service status indicator dot\">\n                    </span>\n                    Servicio abierto\n                </span>\n                <span class=\"text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-2-2-2-2\" data-name=\"service reference number\">\n                    REP-1048\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"reception-heading\" class=\"mt-7\" data-kid=\"2-2-3\" data-name=\"vehicle reception section\">\n            <div class=\"mb-4 flex items-end justify-between gap-3 border-b border-[#CBD5E1] pb-3\" data-kid=\"2-2-3-1\" data-name=\"reception header\">\n                <div data-kid=\"2-2-3-1-1\" data-name=\"reception title container\">\n                    <h2 class=\"font-heading text-[19px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-2-3-1-1-1\" data-name=\"reception section heading\" id=\"reception-heading\">\n                        Recepción del vehículo\n                    </h2>\n                    <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-2-3-1-1-2\" data-name=\"reception description\">\n                        Registra la entrada y las condiciones observadas.\n                    </p>\n                </div>\n                <span class=\"shrink-0 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-2-3-1-2\" data-name=\"reception progress indicator\">\n                    01 / 02\n                </span>\n            </div>\n            <div class=\"border-b border-[#E2E8F0] pb-5\" data-kid=\"2-2-3-2\" data-name=\"mileage field group\">\n                <label class=\"mb-2 block text-[12px] font-semibold text-[#334155]\" data-kid=\"2-2-3-2-1\" data-name=\"mileage label\" for=\"mobile-km\">\n                    Kilometraje actual\n                </label>\n                <div class=\"flex min-h-12 items-center border border-[#EF4444] bg-white px-3\" data-kid=\"2-2-3-2-2\" data-name=\"mileage input container\">\n                    <i class=\"ti ti-gauge shrink-0 text-[18px] text-[#1E88E5]\" data-kid=\"2-2-3-2-2-1\" data-name=\"gauge icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <input aria-describedby=\"mobile-km-error\" class=\"min-w-0 flex-1 border-0 bg-transparent px-3 text-[18px] font-bold tabular-nums text-[#0F172A] outline-hidden\" data-kid=\"2-2-3-2-2-2\" data-name=\"mileage input field\" id=\"mobile-km\" value=\"48,100\"/>\n                    <span class=\"text-[12px] font-bold text-[#64748B]\" data-kid=\"2-2-3-2-2-3\" data-name=\"mileage unit label\">\n                        KM\n                    </span>\n                </div>\n                <p class=\"mt-1 flex items-center gap-1 text-[11px] font-semibold text-[#B91C1C]\" data-kid=\"2-2-3-2-3\" data-name=\"mileage error message\" id=\"mobile-km-error\">\n                    <i class=\"ti ti-alert-circle\" data-kid=\"2-2-3-2-3-1\" data-name=\"error alert icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                  