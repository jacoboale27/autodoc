      "html": "<style data-name=\"AppButton AppCard AppMotion tokens\">\n    button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"export\"]):not([data-name*=\"change period\"]):not([data-name*=\"view vehicle alerts\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]) {\n    min-height: 48px;\n    border-radius: 999px !important;\n    transition: transform 150ms cubic-bezier(.23,1,.32,1), box-shadow 150ms ease-out, background-color 150ms ease-out, color 150ms ease-out;\n  }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"export\"]):not([data-name*=\"change period\"]):not([data-name*=\"view vehicle alerts\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]):hover { transform: scale(1.02); }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"export\"]):not([data-name*=\"change period\"]):not([data-name*=\"view vehicle alerts\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]):active { transform: scale(.97); }\n  [data-name=\"mobile notification button\"], [data-name=\"mobile theme button\"], [data-name=\"mobile export button\"], [data-name=\"mobile vehicle selector\"], [data-name=\"mobile date filter\"], [data-name=\"mobile status filter\"] {\n    min-width: 44px !important;\n    min-height: 44px !important;\n    border-radius: 999px !important;\n    border: 1px solid #CBD5E1 !important;\n    background: #EEEDF0 !important;\n    box-shadow: 0 2px 4px rgba(15,23,42,.05) !important;\n  }\n  [data-name=\"register service mobile button\"] {\n    background: linear-gradient(135deg,#522C81,#45256E) !important;\n    color: #FFFFFF !important;\n    box-shadow: 0 2px 4px rgba(15,23,42,.05) !important;\n  }\n  [data-name=\"mobile vehicle and filter controls\"], [data-name=\"oil service mobile card\"], [data-name=\"brake service mobile card\"], [data-name=\"diagnostic service mobile card\"], [data-name=\"mobile empty history row\"], [data-name=\"mobile annual summary\"] {\n    border-radius: 16px !important;\n    border: 1px solid #CBD5E1 !important;\n    background: #EEEDF0 !important;\n    box-shadow: 0 2px 4px rgba(15,23,42,.05) !important;\n    overflow: hidden;\n  }\n  a:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]) { transition: color 150ms ease-out; }\n  @media (prefers-reduced-motion: reduce) { button, a { transition: none !important; } }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile service history page\">\n    <header class=\"sticky top-0 z-20 border-b border-[#CBD5E1] bg-white/95 px-4 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile top bar\">\n        <div class=\"flex h-16 items-center justify-between gap-3\" data-kid=\"2-1-5\" data-name=\"mobile top bar inner container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-5-1\" data-name=\"mobile top bar branding and title\">\n                <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[17px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1\" data-name=\"AutoDoc mobile logo\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-5-1-2\" data-name=\"page title container\">\n                    <p class=\"truncate text-[11px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-1-5-1-2-1\" data-name=\"owner indicator text\">\n                        Propietario\n                    </p>\n                    <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-5-1-2-2\" data-name=\"page title row\">\n                        <h1 class=\"truncate font-heading text-[15px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-1-5-1-2-2-1\" data-name=\"page heading text\">\n                            Historial\n                        </h1>\n                        <span class=\"size-1.5 shrink-0 rounded-full bg-[#1E88E5]\" data-kid=\"2-1-5-1-2-2-2\" data-name=\"active status indicator dot\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-5-2\" data-name=\"mobile navigation actions container\">\n                <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-lg text-[20px] text-[#64748B] hover:bg-[#F1F5F9]\" data-kid=\"2-1-2\" data-name=\"mobile notification button\">\n                    <i class=\"ti ti-bell\" data-kid=\"2-1-2-1\" data-name=\"notification bell icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-[9px] top-[8px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-2\" data-name=\"notification unread indicator dot\">\n                    </span>\n                </button>\n                <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[20px] text-[#64748B] hover:bg-[#F1F5F9]\" data-kid=\"2-1-3\" data-name=\"mobile theme button\">\n                    <i class=\"ti ti-moon\" data-kid=\"2-1-3-1\" data-name=\"theme toggle icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-4\" data-name=\"mobile profile initials\">\n                    JP\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-28 pt-6\" data-kid=\"2-2\" data-name=\"mobile service history content\" id=\"historial\">\n        <div class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"mobile page heading\">\n            <div class=\"mb-3 flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1-4\" data-name=\"breadcrumb navigation container\">\n                <span data-kid=\"2-2-1-4-1\" data-name=\"breadcrumb parent\">\n                    Propietario\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-4-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-4-3\" data-name=\"breadcrumb current\">\n                    Historial\n                </span>\n            </div>\n            <h2 class=\"font-heading text-[28px] font-extrabold leading-[1.12] tracking-[-0.05em] text-[#0F172A]\" data-kid=\"2-2-1-1\" data-name=\"page main title\">\n                Historial de servicios\n            </h2>\n            <p class=\"mt-2 max-w-[330px] text-[14px] leading-5 text-[#475569]\" data-kid=\"2-2-1-2\" data-name=\"page description text\">\n                Consulta los trabajos realizados y el estado de mantenimiento de tu vehículo.\n            </p>\n            <button class=\"mt-5 flex min-h-11 w-full items-center justify-center gap-2 bg-[#1E88E5] px-4 py-3 text-[13px] font-semibold text-white hover:bg-[#176FBB]\" data-kid=\"2-2-1-3\" data-name=\"register service mobile button\">\n                <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-2-1-3-1\" data-name=\"plus icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Registrar servicio\n            </button>\n        </div>\n        <section class=\"mb-5 border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-2\" data-name=\"mobile vehicle and filter controls\">\n            <div class=\"border-b border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-1\" data-name=\"mobile vehicle selector group\">\n                <p class=\"mb-2 text-[11px] font-bold uppercase tracking-[0.13em] text-[#64748B]\" data-kid=\"2-2-2-1-2\" data-name=\"vehicle selector label\">\n                    Vehículo\n                </p>\n                <button class=\"flex min-h-11 w-full min-w-0 items-center gap-2 border border-[#CBD5E1] bg-[#F8FAFC] px-3 py-2.5 text-left text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-2-1-1\" data-name=\"mobile vehicle selector\">\n                    <i class=\"ti ti-car shrink-0 text-[16px] text-[#1E88E5]\" data-kid=\"2-2-2-1-1-1\" data-name=\"car icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 truncate\" data-kid=\"2-2-2-1-1-2\" data-name=\"selected vehicle name\">\n                        Toyota Corolla 2022 · P 482-916\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[14px] text-[#64748B]\" data-kid=\"2-2-2-1-1-3\" data-name=\"chevron down icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"grid grid-cols-2 gap-2 px-4 py-3\" data-kid=\"2-2-2-2\" data-name=\"mobile history filters\">\n                <button class=\"flex min-h-11 min-w-0 items-center justify-between gap-1 border border-[#CBD5E1] bg-white px-3 py-2 text-left text-[12px] font-medium text-[#475569]\" data-kid=\"2-2-2-2-1\" data-name=\"mobile date filter\">\n                    <span class=\"flex min-w-0 items-center gap-1.5\" data-kid=\"2-2-2-2-1-1\" data-name=\"date filter label container\">\n                        <i class=\"ti ti-calendar shrink-0 text-[15px] text-[#1E88E5]\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"calendar icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"truncate\" data-kid=\"2-2-2-2-1-1-2\" data-name=\"date filter text\">\n                            Últimos 12 meses\n                        </span>\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[13px] text-[#64748B]\" data-kid=\"2-2-2-2-1-2\" data-name=\"date filter chevron icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-11 min-w-0 items-center justify-between gap-1 border border-[#CBD5E1] bg-white px-3 py-2 text-left text-[12px] font-medium text-[#475569]\" data-kid=\"2-2-2-2-2\" data-name=\"mobile status filter\">\n                    <span class=\"truncate\" data-kid=\"2-2-2-2-2-1\" data-name=\"status filter text\">\n                        Todos los estados\n                    </span>\n                    <i class=\"ti ti-chevron-down shrink-0 text-[13px] text-[#64748B]\" data-kid=\"2-2-2-2-2-2\" data-name=\"status filter chevron icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <div class=\"mb-6 flex items-center justify-between gap-3\" data-kid=\"2-2-3\" data-name=\"mobile service search and count\">\n            <div class=\"flex min-w-0 flex-1 items-center gap-2 border-b border-[#CBD5E1] pb-2 text-[13px] text-[#94A3B8]\" data-kid=\"2-2-3-1\" data-name=\"mobile search field\">\n                <i class=\"ti ti-search shrink-0 text-[17px] text-[#64748B]\" data-kid=\"2-2-3-1-1\" data-name=\"search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"truncate\" data-kid=\"2-2-3-1-2\" data-name=\"search placeholder text\">\n                    Buscar servicio\n                </span>\n                <span class=\"ml-auto shrink-0 rounded bg-[#F1F5F9] px-1.5 py-0.5 text-[10px] text-[#64748B]\" data-kid=\"2-2-3-1-3\" data-name=\"search shortcut label\">\n                    ⌘K\n                </span>\n            </div>\n            <span class=\"shrink-0 text-right text-[11px] font-medium text-[#64748B]\" data-kid=\"2-2-3-2\" data-name=\"total services count text\">\n                3 servicios\n                <br data-kid=\"2-2-3-2-1\" data-name=\"line break\"/>\n                registrados\n            </span>\n        </div>\n        <section aria-labelledby=\"mobile-history-title\" data-kid=\"2-2-4\" data-name=\"mobile service records section\">\n            <div class=\"mb-3 flex items-end justify-between gap-3\" data-kid=\"2-2-4-1\" data-name=\"mobile records heading\">\n                <div data-kid=\"2-2-4-1-2\" data-name=\"records title container\">\n                    <h3 class=\"font-heading text-[20px] font-bold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-4-1-2-1\" data-name=\"records section heading\" id=\"mobile-history-title\">\n                        Servicios realizados\n                    </h3>\n                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-4-1-2-2\" data-name=\"records section description\">\n                        Detalle de actividad para el vehículo seleccionado.\n                    </p>\n                </div>\n                <button aria-label=\"Exportar historial\" class=\"grid size-11 shrink-0 place-items-center rounded-lg text-[18px] text-[#1E88E5] hover:bg-[#E8F2FD]\" data-kid=\"2-2-4-1-1\" data-name=\"mobile export button\">\n                    <i class=\"ti ti-download\" data-kid=\"2-2-4-1-1-1\" data-name=\"download icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"space-y-3\" data-kid=\"2-2-4-2\" data-name=\"mobile service record cards\">\n                <article class=\"border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4-2-1\" data-name=\"oil service mobile card\">\n                    <div class=\"flex items-start justify-between gap-3 border-b border-[#E2E8F0] bg-[#EDF2F7] px-4 py-3\" data-kid=\"2-2-4-2-1-1\" data-name=\"card header\">\n                        <div data-kid=\"2-2-4-2-1-1-1\" data-name=\"card date label container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-2-1-1-1-1\" data-name=\"card date label\">\n                                Fecha\n                            </p>\n                            <p class=\"mt-1 text-[12px] font-medium text-[#475569]\" data-kid=\"2-2-4-2-1-1-1-2\" data-name=\"card date value\">\n                                12 jun 2026\n                            </p>\n                        </div>\n                        <span class=\"flex items-center gap-1.5 text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-2-4-2-1-1-2\" data-name=\"card status label\">\n                            <i class=\"ti ti-circle-check-filled text-[15px]\" data-kid=\"2-2-4-2-1-1-2-1\" data-name=\"status checkmark icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Completado\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-x-4 gap-y-4 px-4 py-4\" data-kid=\"2-2-4-2-1-2\" data-name=\"card content grid\">\n                        <div data-kid=\"2-2-4-2-1-2-1\" data-name=\"service name container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-1-2-1-1\" data-name=\"service label\">\n                                Servicio\n                            </p>\n                            <p class=\"mt-1 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-1-2-1-2\" data-name=\"service value\">\n                                Cambio de aceite\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-1-2-2\" data-name=\"workshop name container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-1-2-2-1\" data-name=\"workshop label\">\n                                Taller\n                            </p>\n                            <p class=\"mt-1 text-[13px] text-[#475569]\" data-kid=\"2-2-4-2-1-2-2-2\" data-name=\"workshop value\">\n                                Taller Rápido\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-1-2-3\" data-name=\"mileage container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-1-2-3-1\" data-name=\"mileage label\">\n                                Kilometraje\n                            </p>\n                            <p class=\"mt-1 tabular-nums text-[13px] text-[#475569]\" data-kid=\"2-2-4-2-1-2-3-2\" data-name=\"mileage value\">\n                                48,260 km\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-1-2-4\" data-name=\"cost container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-1-2-4-1\" data-name=\"cost label\">\n                                Total\n                            </p>\n                            <p class=\"mt-1 tabular-nums text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-1-2-4-2\" data-name=\"cost value\">\n                                $82.00\n                            </p>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4-2-2\" data-name=\"brake service mobile card\">\n                    <div class=\"flex items-start justify-between gap-3 border-b border-[#E2E8F0] bg-[#EDF2F7] px-4 py-3\" data-kid=\"2-2-4-2-2-1\" data-name=\"card header\">\n                        <div data-kid=\"2-2-4-2-2-1-1\" data-name=\"card date label container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-2-2-1-1-1\" data-name=\"card date label\">\n                                Fecha\n                            </p>\n                            <p class=\"mt-1 text-[12px] font-medium text-[#475569]\" data-kid=\"2-2-4-2-2-1-1-2\" data-name=\"card date value\">\n                                18 may 2026\n                            </p>\n                        </div>\n                        <span class=\"flex items-center gap-1.5 text-[12px] font-semibold text-[#F59E0B]\" data-kid=\"2-2-4-2-2-1-2\" data-name=\"card status label\">\n                            <i class=\"ti ti-clock text-[15px]\" data-kid=\"2-2-4-2-2-1-2-1\" data-name=\"status clock icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Pendiente\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-x-4 gap-y-4 px-4 py-4\" data-kid=\"2-2-4-2-2-2\" data-name=\"card content grid\">\n                        <div data-kid=\"2-2-4-2-2-2-1\" data-name=\"service name container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-2-2-1-1\" data-name=\"service label\">\n                                Servicio\n                            </p>\n                            <p class=\"mt-1 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-2-2-1-2\" data-name=\"service value\">\n                                Revisión de frenos\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-2-2-2\" data-name=\"workshop name container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-2-2-2-1\" data-name=\"workshop label\">\n                                Taller\n                            </p>\n                            <p class=\"mt-1 text-[13px] text-[#475569]\" data-kid=\"2-2-4-2-2-2-2-2\" data-name=\"workshop value\">\n                                MotorLab\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-2-2-3\" data-name=\"mileage container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-2-2-3-1\" data-name=\"mileage label\">\n                                Kilometraje\n                            </p>\n                            <p class=\"mt-1 tabular-nums text-[13px] text-[#475569]\" data-kid=\"2-2-4-2-2-2-3-2\" data-name=\"mileage value\">\n                                46,520 km\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-2-2-4\" data-name=\"cost container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-2-2-4-1\" data-name=\"cost label\">\n                                Total\n                            </p>\n                            <p class=\"mt-1 tabular-nums text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-2-2-4-2\" data-name=\"cost value\">\n                                $180.00\n                            </p>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4-2-3\" data-name=\"diagnostic service mobile card\">\n                    <div class=\"flex items-start justify-between gap-3 border-b border-[#E2E8F0] bg-[#EDF2F7] px-4 py-3\" data-kid=\"2-2-4-2-3-1\" data-name=\"card header\">\n                        <div data-kid=\"2-2-4-2-3-1-1\" data-name=\"card date label container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-2-3-1-1-1\" data-name=\"card date label\">\n                                Fecha\n                            </p>\n                            <p class=\"mt-1 text-[12px] font-medium text-[#475569]\" data-kid=\"2-2-4-2-3-1-1-2\" data-name=\"card date value\">\n                                04 feb 2026\n                            </p>\n                        </div>\n                        <span class=\"flex items-center gap-1.5 text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-2-4-2-3-1-2\" data-name=\"card status label\">\n                            <i class=\"ti ti-circle-check-filled text-[15px]\" data-kid=\"2-2-4-2-3-1-2-1\" data-name=\"status checkmark icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Completado\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-x-4 gap-y-4 px-4 py-4\" data-kid=\"2-2-4-2-3-2\" data-name=\"card content grid\">\n                        <div data-kid=\"2-2-4-2-3-2-1\" data-name=\"service name container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-3-2-1-1\" data-name=\"service label\">\n                                Servicio\n                            </p>\n                            <p class=\"mt-1 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-3-2-1-2\" data-name=\"service value\">\n                                Diagnóstico\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-3-2-2\" data-name=\"workshop name container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-3-2-2-1\" data-name=\"workshop label\">\n                                Taller\n                            </p>\n                            <p class=\"mt-1 text-[13px] text-[#475569]\" data-kid=\"2-2-4-2-3-2-2-2\" data-name=\"workshop value\">\n                                Centro Auto\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-3-2-3\" data-name=\"mileage container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-3-2-3-1\" data-name=\"mileage label\">\n                                Kilometraje\n                            </p>\n                            <p class=\"mt-1 tabular-nums text-[13px] text-[#475569]\" data-kid=\"2-2-4-2-3-2-3-2\" data-name=\"mileage value\">\n                                43,100 km\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-4-2-3-2-4\" data-name=\"cost container\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.1em] text-[#64748B]\" data-kid=\"2-2-4-2-3-2-4-1\" data-name=\"cost label\">\n                                Total\n                            </p>\n                            <p class=\"mt-1 tabular-nums text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-4-2-3-2-4-2\" data-name=\"cost value\">\n                                $95.00\n                            </p>\n                        </div>\n                    </div>\n                </article>\n                <div class=\"border border-dashed border-[#CBD5E1] bg-white px-4 py-4 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-4-2-4\" data-name=\"mobile empty history row\">\n                    <div class=\"flex items-start gap-2\" data-kid=\"2-2-4-2-4-1\" data-name=\"empty row inner container\">\n                        <i class=\"ti ti-history-toggle mt-0.5 text-[16px]\" data-kid=\"2-2-4-2-4-1-1\" data-name=\"empty row history icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <div data-kid=\"2-2-4-2-4-1-2\" data-name=\"empty row text container\">\n                            <p data-kid=\"2-2-4-2-4-1-2-1\" data-name=\"empty row primary text\">\n                                No hay más servicios en este periodo\n                            </p>\n                            <p class=\"mt-1\" data-kid=\"2-2-4-2-4-1-2-2\" data-name=\"empty row secondary text\">\n                                Ajusta el rango para consultar más actividad\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <aside aria-labelledby=\"mobile-summary-title\" class=\"mt-8 border-t border-[#CBD5E1] pt-6\" data-kid=\"2-2-5\" data-name=\"mobile annual summary\">\n            <div class=\"border-b border-[#CBD5E1] pb-5\" data-kid=\"2-2-5-2\" data-name=\"summary stats container\">\n                <div class=\"flex items-center justify-between\" data-kid=\"2-2-5-2-1\" data-name=\"summary stats header\">\n                    <h3 class=\"font-heading text-[20px] font-bold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-5-2-1-1\" data-name=\"summary section heading\" id=\"mobile-summary-title\">\n                        Resumen anual\n                    </h3>\n                    <i class=\"ti ti-chart-line text-[18px] text-[#1E88E5]\" data-kid=\"2-2-5-2-1-2\" data-name=\"summary trend icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n                <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-5-2-2\" data-name=\"summary date range text\">\n                    Mantenimiento registrado · 2026\n                </p>\n                <div class=\"mt-4 font-heading text-[30px] font-extrabold tracking-[-0.05em] text-[#1E88E5] tabular-nums\" data-kid=\"2-2-5-2-3\" data-name=\"total invested amount text\">\n                    $684.50\n                </div>\n                <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-5-2-4\" data-name=\"total count summary text\">\n                    Total invertido en 3 servicios\n                </p>\n            </div>\n            <div class=\"space-y-4 py-5\" data-kid=\"2-2-5-3\" data-name=\"summary details list\">\n                <div class=\"flex items-center justify-between border-b border-[#E2E8F0] pb-3\" data-kid=\"2-2-5-3-1\" data-name=\"summary detail row 1\">\n                    <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-2-5-3-1-1\" data-name=\"detail label\">\n                        Servicios registrados\n                    </span>\n                    <strong class=\"font-heading text-[18px] text-[#0F172A] tabular-nums\" data-kid=\"2-2-5-3-1-2\" data-name=\"detail value\">\n                        3\n                    </strong>\n                </div>\n                <div class=\"flex items-center justify-between border-b border-[#E2E8F0] pb-3\" data-kid=\"2-2-5-3-2\" data-name=\"summary detail row 2\">\n                    <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-2-5-3-2-1\" data-name=\"detail label\">\n                        Promedio por visita\n                    </span>\n                    <strong class=\"font-heading text-[18px] text-[#0F172A] tabular-nums\" data-kid=\"2-2-5-3-2-2\" data-name=\"detail value\">\n                        $228.17\n                    </strong>\n                </div>\n                <div class=\"flex items-center justify-between\" data-kid=\"2-2-5-3-3\" data-name=\"summary detail row 3\">\n                    <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-2-5-3-3-1\" data-name=\"detail label\">\n                        Última visita\n                    </span>\n                    <strong class=\"text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-5-3-3-2\" data-name=\"detail value\">\n                        12 jun 2026\n                    </strong>\n                </div>\n            </div>\n            <button class=\"flex min-h-11 items-center gap-2 text-[12px] font-bold text-[#1E88E5] hover:text-[#176FBB]\" data-kid=\"2-2-5-1\" data-name=\"mobile full summary button\">\n                Ver resumen completo\n                <i class=\"ti ti-arrow-right text-[15px]\" data-kid=\"2-2-5-1-1\" data-name=\"arrow icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </aside>\n        <footer class=\"mt-8 border-t border-[#CBD5E1] pt-5 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-6\" data-name=\"mobile history footer\">\n            <p data-kid=\"2-2-6-1\" data-name=\"footer brand and info text\">\n                AutoDoc · Historial y mantenimiento vehicular · Datos sincronizados con tu garaje\n            </p>\n            <span class=\"mt-2 flex items-center gap-2\" data-kid=\"2-2-6-2\" data-name=\"sync status indicator container\">\n                <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-2-6-2-1\" data-name=\"sync status dot\">\n                </span>\n                Última sincronización hace 8 min\n            </span>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación móvil\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pb-[max(10px,env(safe-area-inset-bottom))] pt-2 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-5 gap-1\" data-kid=\"2-3-6\" data-name=\"navigation links container\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-1\" data-name=\"navigation home link\" href=\"#inicio\">\n                <i class=\"ti ti-dashboard text-[19px]\" data-kid=\"2-3-1-1\" data-name=\"home icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2\" data-name=\"home text\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-2\" data-name=\"navigation garage link\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"2-3-2-1\" data-name=\"garage icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-2-2\" data-name=\"garage text\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-3\" data-name=\"navigation workshops link\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-3-1\" data-name=\"workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-3-2\" data-name=\"workshops text\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-label=\"Alertas\" class=\"relative flex min-h-11 flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"2-3-4\" data-name=\"navigation alerts link\" href=\"#alertas\">\n                <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-4-1\" data-name=\"alerts icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-4-2\" data-name=\"alerts text\">\n                    Alertas\n                </span>\n                <span class=\"absolute right-4 top-1 size-1.5 rounded-full bg-[#EF4444]\" data-kid=\"2-3-4-3\" data-name=\"alerts unread indicator dot\">\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Historial\" class=\"flex min-h-11 flex-col items-center justify-center gap-1 rounded-lg bg-[#E8F2FD] text-[#1E88E5]\" data-kid=\"2-3-5\" data-name=\"navigation history link\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-5-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-5-2\" data-name=\"history text\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
