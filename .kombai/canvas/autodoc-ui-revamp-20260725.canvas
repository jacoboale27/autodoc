      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style>\n    button { transition: transform 160ms cubic-bezier(0.23,1,0.32,1), box-shadow 150ms cubic-bezier(0.23,1,0.32,1), background-color 150ms cubic-bezier(0.23,1,0.32,1), border-color 150ms cubic-bezier(0.23,1,0.32,1); }\n  button:active { transform: scale(0.97); }\n  button:hover:not([aria-label]) { transform: scale(1.02); }\n  button[class*=\"bg-[#1E88E5]\"] { min-height: 48px; border-radius: 999px !important; background: linear-gradient(135deg, #522C81, #45236F) !important; color: #FFFFFF !important; box-shadow: 0 2px 4px rgba(15,23,42,0.05); }\n  button[aria-label] { min-width: 44px !important; min-height: 44px !important; border-radius: 999px !important; border: 1px solid #CBD5E1 !important; background: #EEEDF0 !important; color: #5B6B80 !important; box-shadow: 0 2px 4px rgba(15,23,42,0.05); }\n  button[class*=\"border-\"]:not([aria-label]) { min-height: 48px; border-radius: 999px !important; box-shadow: 0 2px 4px rgba(15,23,42,0.05); }\n  section[aria-label*=\"Resumen\"], [data-name*=\"vehicle hero\"], [data-name=\"vehicle profile page\"] article { border-radius: 16px !important; border-color: #CBD5E1 !important; background: #EEEDF0 !important; box-shadow: 0 2px 4px rgba(15,23,42,0.05); }\n</style>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"vehicle profile page\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"vehicle profile application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"primary navigation rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"brand mark\">\n                AD\n            </div>\n            <nav aria-label=\"Navegación rápida\" class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"rail navigation\">\n                <button aria-label=\"Inicio\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard navigation link\">\n                    <i class=\"ti ti-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Mi garaje\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-2\" data-name=\"garage navigation link\">\n                    <i class=\"ti ti-car\" data-kid=\"2-1-1-2-2-1\" data-name=\"garage icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Talleres\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"workshops navigation link\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-3-1\" data-name=\"workshops icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Alertas\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-4\" data-name=\"alerts navigation link\">\n                    <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-1-2-4-1\" data-name=\"alerts icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Historial\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-5\" data-name=\"history navigation link\">\n                    <i class=\"ti ti-history\" data-kid=\"2-1-1-2-5-1\" data-name=\"history icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </nav>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"rail utility navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help navigation link\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings navigation link\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"contextual owner sidebar\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"owner context\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"owner status label\">\n                    Espacio personal\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"owner indicator container\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"status color dot\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"owner role label\">\n                        Propietario\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Navegación principal\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"owner navigation links\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-1\" data-name=\"inicio link\" href=\"#inicio\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-1-1\" data-name=\"inicio icon container\">\n                        <i class=\"ti ti-dashboard\" data-kid=\"2-1-2-2-1-1-1\" data-name=\"inicio icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Inicio\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-2.5 text-[14px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-2-2\" data-name=\"mi garaje link\" href=\"#garaje\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-2-1\" data-name=\"mi garaje icon container\">\n                        <i class=\"ti ti-car\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"mi garaje icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Mi garaje\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-3\" data-name=\"talleres link\" href=\"#talleres\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-3-1\" data-name=\"talleres icon container\">\n                        <i class=\"ti ti-tool\" data-kid=\"2-1-2-2-3-1-1\" data-name=\"talleres icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Talleres\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-4\" data-name=\"alertas link\" href=\"#alertas\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-4-1\" data-name=\"alertas icon container\">\n                        <i class=\"ti ti-alert-triangle\" data-kid=\"2-1-2-2-4-1-1\" data-name=\"alertas icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Alertas\n                    <span class=\"ml-auto text-[11px] font-bold text-[#EF4444]\" data-dynamic=\"true\" data-kid=\"2-1-2-2-4-2\" data-name=\"alerts badge count\" data-reason=\"number text replaced by dashboard alert count\">\n                        1\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-5\" data-name=\"historial link\" href=\"#historial\">\n                    <span class=\"text-[17px]\" data-kid=\"2-1-2-2-5-1\" data-name=\"historial icon container\">\n                        <i class=\"ti ti-history\" data-kid=\"2-1-2-2-5-1-1\" data-name=\"historial icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    Historial\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"owner account footer\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-3-1\" data-name=\"account identity summary\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3-1-1\" data-name=\"account avatar initials\">\n                        JP\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-1-2\" data-name=\"account user name and type\">\n                        <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-3-1-2-1\" data-name=\"user full name\">\n                            Juan Pérez\n                        </p>\n                        <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-1-2-2\" data-name=\"account type label\">\n                            Cuenta personal\n                        </p>\n                    </div>\n                    <span class=\"ml-auto text-[16px] text-[#94A3B8]\" data-kid=\"2-1-2-3-1-3\" data-name=\"account toggle icon container\">\n                        <i class=\"ti ti-chevron-down\" data-kid=\"2-1-2-3-1-3-1\" data-name=\"account toggle icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"2-1-3\" data-name=\"vehicle profile content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-white px-8\" data-kid=\"2-1-3-1\" data-name=\"vehicle profile top bar\">\n                <div class=\"flex min-w-0 items-center gap-3 text-[13px]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumb\">\n                    <span class=\"shrink-0 text-[#64748B]\" data-kid=\"2-1-3-1-1-1\" data-name=\"breadcrumb owner label\">\n                        Propietario\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-3-1-1-2\" data-name=\"breadcrumb separator 1\">\n                        /\n                    </span>\n                    <span class=\"shrink-0 text-[#64748B]\" data-kid=\"2-1-3-1-1-3\" data-name=\"breadcrumb garage label\">\n                        Mi garaje\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-3-1-1-4\" data-name=\"breadcrumb separator 2\">\n                        /\n                    </span>\n                    <span class=\"truncate font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-1-5\" data-name=\"breadcrumb vehicle name\">\n                        Toyota Corolla 2022\n                    </span>\n                </div>\n                <div class=\"flex shrink-0 items-center gap-5\" data-kid=\"2-1-3-1-2\" data-name=\"top bar tools\">\n                    <span class=\"hidden text-[12px] text-[#64748B] lg:block\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2-1\" data-name=\"current date text\" data-reason=\"date text replaced dynamically by current date script\">\n                        Sábado, 25 jul 2026\n                    </span>\n                    <button aria-label=\"Notificaciones\" class=\"relative grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-2\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-2-2-1\" data-name=\"notifications icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-[7px] top-[6px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-3-1-2-2-2\" data-name=\"notifications status dot\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-3\" data-name=\"theme toggle button\">\n                        <i class=\"ti ti-moon\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"theme toggle icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <div class=\"h-6 w-px bg-[#E2E8F0]\" data-kid=\"2-1-3-1-2-4\" data-name=\"top bar divider\">\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-1-2-5\" data-name=\"top bar account preview\">\n                        <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-1-2-5-1\" data-name=\"top bar avatar initials\">\n                            JP\n                        </div>\n                        <span class=\"hidden text-[13px] font-semibold text-[#0F172A] xl:block\" data-kid=\"2-1-3-1-2-5-2\" data-name=\"top bar user name\">\n                            Juan Pérez\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1160px] px-8 py-7\" data-kid=\"2-1-3-2\" data-name=\"vehicle profile body\">\n                <div class=\"mb-5 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"vehicle profile heading\">\n                    <div data-kid=\"2-1-3-2-1-1\" data-name=\"vehicle identity group\">\n                        <div class=\"mb-2 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-1-3-2-1-1-1\" data-name=\"vehicle active status container\">\n                            <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-3-2-1-1-1-1\" data-name=\"active status dot\">\n                            </span>\n                            Vehículo activo\n                        </div>\n                        <h1 class=\"font-heading text-[30px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-1-3-2-1-1-2\" data-name=\"vehicle headline title\">\n                            Toyota Corolla 2022\n                        </h1>\n                        <p class=\"mt-1 text-[14px] font-semibold tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-3-2-1-1-3\" data-name=\"vehicle license plate text\">\n                            P 482-916\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"2-1-3-2-1-2\" data-name=\"vehicle actions group\">\n                        <button class=\"inline-flex items-center gap-2 bg-[#1E88E5] px-4 py-2.5 text-[13px] font-semibold text-white hover:bg-[#176FBB]\" data-kid=\"2-1-3-2-1-2-1\" data-name=\"register service button\">\n                            <span class=\"text-[16px]\" data-kid=\"2-1-3-2-1-2-1-1\" data-name=\"register service icon container\">\n                                <i class=\"ti ti-tool\" data-kid=\"2-1-3-2-1-2-1-1-1\" data-name=\"register service icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                            Registrar servicio\n                        </button>\n                        <button aria-label=\"Más opciones del vehículo\" class=\"grid size-10 place-items-center border border-[#CBD5E1] bg-white text-[18px] text-[#64748B] hover:border-[#1E88E5] hover:text-[#1E88E5]\" data-kid=\"2-1-3-2-1-2-2\" data-name=\"vehicle options button\">\n                            <i class=\"ti ti-dots\" data-kid=\"2-1-3-2-1-2-2-1\" data-name=\"vehicle options icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <section aria-label=\"Resumen del vehículo\" class=\"grid overflow-hidden rounded-[18px] border border-[#CBD5E1] bg-white lg:grid-cols-[1.06fr_0.94fr]\" data-kid=\"2-1-3-2-2\" data-name=\"vehicle hero split\">\n                    <div class=\"relative min-h-[236px] bg-[#E2E8F0]\" data-kid=\"2-1-3-2-2-1\" data-name=\"vehicle image panel container\">\n                        <img alt=\"Sedán Hyundai en perfil, fotografía de Hyundai Motor Group en Pexels\" class=\"h-full min-h-[236px] w-full object-cover\" data-kid=\"2-1-3-2-2-1-1\" data-name=\"vehicle display image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14696345/pexels-photo-14696345.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                        <div class=\"absolute bottom-4 left-4 border border-white/70 bg-[#0F172A]/80 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.14em] text-white\" data-kid=\"2-1-3-2-2-1-2\" data-name=\"image tag label\">\n                            Vista principal\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col justify-between p-7\" data-kid=\"2-1-3-2-2-2\" data-name=\"vehicle hero data container\">\n                        <div data-kid=\"2-1-3-2-2-2-1\" data-name=\"vehicle overview info\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"2-1-3-2-2-2-1-1\" data-name=\"vehicle overview status bar\">\n                                <span class=\"inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#10B981]\" data-kid=\"2-1-3-2-2-2-1-1-1\" data-name=\"vehicle active label\">\n                                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-3-2-2-2-1-1-1-1\" data-name=\"active status dot\">\n                                    </span>\n                                    Activo\n                                </span>\n                                <span class=\"border border-[#F59E0B] bg-[#FFFBEB] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.1em] text-[#B45309]\" data-kid=\"2-1-3-2-2-2-1-1-2\" data-name=\"revision status tag\">\n                                    Revisión pronta\n                                </span>\n                            </div>\n                            <div class=\"mt-6 grid grid-cols-2 gap-6 border-y border-[#E2E8F0] py-5\" data-kid=\"2-1-3-2-2-2-1-2\" data-name=\"vehicle status metrics grid\">\n                                <div data-kid=\"2-1-3-2-2-2-1-2-1\" data-name=\"mileage column\">\n                                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-1-2-1-1\" data-name=\"mileage label\">\n                                        Kilometraje\n                                    </p>\n                                    <p class=\"mt-1 font-heading text-[26px] font-bold tracking-[-0.04em] text-[#0F172A] tabular-nums\" data-kid=\"2-1-3-2-2-2-1-2-1-2\" data-name=\"mileage value text\">\n                                        48,260\n                                        <span class=\"font-body text-[13px] font-semibold tracking-normal text-[#64748B]\" data-kid=\"2-1-3-2-2-2-1-2-1-2-1\" data-name=\"mileage unit text\">\n                                            km\n                                        </span>\n                                    </p>\n                                </div>\n                                <div data-kid=\"2-1-3-2-2-2-1-2-2\" data-name=\"last service column\">\n                                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-1-2-2-1\" data-name=\"last service label\">\n                                        Último servicio\n                                    </p>\n                                    <p class=\"mt-1 text-[16px] font-bold text-[#0F172A]\" data-kid=\"2-1-3-2-2-2-1-2-2-2\" data-name=\"last service date\">\n                                        12 jun 2026\n                                    </p>\n                                    <p class=\"mt-0.5 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-1-2-2-3\" data-name=\"last service location\">\n                                        Taller Rápido\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-4\" data-kid=\"2-1-3-2-2-2-2\" data-name=\"next service reminder group\">\n                            <span class=\"text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-2-1\" data-name=\"next service reminder text\">\n                                Próxima revisión en\n                                <strong class=\"font-semibold text-[#0F172A] tabular-nums\" data-kid=\"2-1-3-2-2-2-2-1-1\" data-name=\"next service distance\">\n                                