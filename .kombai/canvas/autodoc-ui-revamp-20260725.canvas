    "var_cc1c063fd2d2": {
      "type": "variant",
      "label": "AutoDoc Splash — Hadrian Light Mobile",
      "parentId": "var_62b0de7091ec",
      "themeId": null,
      "rect": {
        "x": 103405,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .splash-mobile-body {\n    font-family: 'IBM Plex Sans', sans-serif;\n  }\n\n  .splash-mobile-heading {\n    font-family: 'Plus Jakarta Sans', sans-serif;\n  }\n\n  @keyframes splash-mobile-spin {\n    to { transform: rotate(360deg); }\n  }\n\n  @keyframes splash-mobile-progress {\n    0% { transform: translateX(-120%); }\n    100% { transform: translateX(260%); }\n  }\n\n  .splash-mobile-spin {\n    animation: splash-mobile-spin 1.2s linear infinite;\n  }\n\n  .splash-mobile-progress {\n    animation: splash-mobile-progress 1.6s ease-in-out infinite alternate;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .splash-mobile-spin,\n    .splash-mobile-progress {\n      animation: none;\n      transform: translateX(0);\n    }\n  }\n</style>\n<div class=\"splash-mobile-body relative min-h-screen w-full overflow-x-hidden bg-[#522C81] text-white antialiased\" data-kid=\"1\" data-name=\"splash mobile light page\">\n    <div class=\"pointer-events-none absolute -left-[190px] -top-[170px] size-[420px] rounded-full\" data-kid=\"1-1\" data-name=\"success decorative radial blob\" style=\"background:radial-gradient(circle, rgba(72,187,120,.18) 0%, rgba(72,187,120,.05) 42%, transparent 72%)\">\n    </div>\n    <div class=\"pointer-events-none absolute -bottom-[210px] -right-[190px] size-[470px] rounded-full\" data-kid=\"1-2\" data-name=\"secondary decorative radial blob\" style=\"background:radial-gradient(circle, rgba(129,230,217,.18) 0%, rgba(129,230,217,.05) 44%, transparent 74%)\">\n    </div>\n    <main class=\"relative mx-auto flex min-h-screen w-full max-w-[420px] flex-col items-center px-4 pb-10 pt-6\" data-kid=\"1-3\" data-name=\"scroll-safe splash content\">\n        <div class=\"flex w-full items-center justify-end\" data-kid=\"1-3-1\" data-name=\"splash utility row\">\n            <button aria-label=\"Configuración\" class=\"flex min-h-11 min-w-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/45 shadow-[0_2px_4px_rgba(15,23,42,0.08)]\" data-kid=\"1-3-1-1\" data-name=\"quiet settings action\">\n                <i class=\"ti ti-settings-spark text-[18px]\" data-kid=\"1-3-1-1-1\" data-name=\"settings icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n        <section class=\"mt-9 flex flex-col items-center text-center\" data-kid=\"1-3-2\" data-name=\"splash mobile branding group\">\n            <div class=\"relative flex size-[138px] items-center justify-center\" data-kid=\"1-3-2-1\" data-name=\"isotype logo stage\">\n                <div class=\"absolute size-[104px] rotate-45 rounded-[20px] border border-white/10 bg-white/10\" data-kid=\"1-3-2-1-1\" data-name=\"rotated logo surface\">\n                </div>\n                <div class=\"absolute size-[118px] -rotate-[12deg] rounded-[26px] border-[3px] border-[#81E6D9]/45\" data-kid=\"1-3-2-1-2\" data-name=\"rotated secondary outline\">\n                </div>\n                <div class=\"relative flex size-[82px] items-center justify-center rounded-[16px] bg-white p-3.5 shadow-[0_14px_30px_rgba(15,23,42,0.24)]\" data-kid=\"1-3-2-1-3\" data-name=\"isotype logo tile\">\n                    <img alt=\"AutoDoc\" class=\"size-full object-contain\" data-kid=\"1-3-2-1-3-1\" data-name=\"AutoDoc SVG logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/logo/autodoc_isotype.svg\"/>\n                </div>\n            </div>\n            <div class=\"splash-mobile-heading mt-7 text-[42px] font-extrabold leading-none tracking-[-0.065em]\" data-kid=\"1-3-2-2\" data-name=\"AutoDoc wordmark\">\n                <span class=\"text-white\" data-kid=\"1-3-2-2-1\" data-name=\"Auto wordmark\">\n                    Auto\n                </span>\n                <span class=\"text-[#81E6D9]\" data-kid=\"1-3-2-2-2\" data-name=\"Doc wordmark\">\n                    Doc\n                </span>\n            </div>\n            <p class=\"mt-3 text-[9px] font-semibold uppercase tracking-[0.34em] text-white/80\" data-kid=\"1-3-2-3\" data-name=\"professional diagnostic slogan\">\n                DIAGNÓSTICO PROFESIONAL\n            </p>\n        </section>\n        <section class=\"mt-14 flex w-full flex-col items-center\" data-kid=\"1-3-3\" data-name=\"session resolution loading state\">\n            <div class=\"relative flex size-[56px] items-center justify-center\" data-kid=\"1-3-3-1\" data-name=\"circular car loading indicator\">\n                <div class=\"absolute inset-0 rounded-full border-[4px] border-[#81E6D9]/20\" data-kid=\"1-3-3-1-1\" data-name=\"loading ring track\">\n                </div>\n                <div class=\"splash-mobile-spin absolute inset-0 rounded-full border-[4px] border-transparent border-r-[#81E6D9] border-t-[#81E6D9]\" data-dynamic=\"true\" data-kid=\"1-3-3-1-2\" data-name=\"loading ring progress\" data-reason=\"infinite spin animation masks authored transform\">\n                </div>\n                <i class=\"ti ti-car text-[16px] text-[#81E6D9]\" data-kid=\"1-3-3-1-3\" data-name=\"loading car icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <p class=\"mt-5 text-[15px] font-semibold text-white/90\" data-kid=\"1-3-3-2\" data-name=\"loading status label\">\n                Cargando datos...\n            </p>\n            <div class=\"mt-3 h-1 w-[208px] overflow-hidden rounded-full bg-white/15\" data-kid=\"1-3-3-3\" data-name=\"indeterminate progress track\">\n                <div class=\"splash-mobile-progress h-full w-2/5 rounded-full bg-[#81E6D9]\" data-dynamic=\"true\" data-kid=\"1-3-3-3-1\" data-name=\"indeterminate progress value\" data-reason=\"infinite progress animation masks authored transform\">\n                </div>\n            </div>\n            <p class=\"mt-6 text-[9px] font-medium uppercase tracking-[0.24em] text-white/35\" data-kid=\"1-3-3-4\" data-name=\"session resolution hint\">\n                Sesión segura · preparando tu espacio\n            </p>\n        </section>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-08-17T22:10:54.259746+00:00",
      "modified": "2026-08-17T22:11:02.128498+00:00",
