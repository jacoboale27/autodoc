      "html": "<style data-name=\"AppButton AppCard AppMotion tokens\">\n    button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"export\"]):not([data-name*=\"change period\"]):not([data-name*=\"view vehicle alerts\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]) {\n    min-height: 48px;\n    border-radius: 999px !important;\n    transition: transform 150ms cubic-bezier(.23,1,.32,1), box-shadow 150ms ease-out, background-color 150ms ease-out, color 150ms ease-out;\n  }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"export\"]):not([data-name*=\"change period\"]):not([data-name*=\"view vehicle alerts\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]):hover { transform: scale(1.02); }\n  button:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]):not([data-name*=\"export\"]):not([data-name*=\"change period\"]):not([data-name*=\"view vehicle alerts\"]):not([data-name*=\"show all\"]):not([data-name*=\"view details link\"]):active { transform: scale(.97); }\n  [data-name=\"theme toggle\"], [data-name=\"notifications button\"], [data-name=\"time period filter\"], [data-name=\"status filter\"] {\n    min-width: 44px !important;\n    min-height: 44px !important;\n    border-radius: 999px !important;\n    border: 1px solid #334155 !important;\n    background: #141E36 !important;\n    box-shadow: 0 2px 4px rgba(0,0,0,.2) !important;\n  }\n  [data-name=\"register service button\"] {\n    background: linear-gradient(135deg,#81E6D9,#6FC8BC) !important;\n    color: #0F172A !important;\n    box-shadow: 0 2px 4px rgba(0,0,0,.2) !important;\n  }\n  [data-name=\"vehicle and filter controls\"], [data-name=\"registered services section\"], [data-name=\"service record card 1\"], [data-name=\"service record card 2\"], [data-name=\"service record card 3\"], [data-name=\"annual history summary\"] {\n    border-radius: 16px !important;\n    border: 1px solid #334155 !important;\n    background: #141E36 !important;\n    box-shadow: 0 2px 4px rgba(0,0,0,.2) !important;\n    overflow: hidden;\n  }\n  a:not([data-name*=\"navigation\"]):not([data-name^=\"nav\"]) { transition: color 150ms ease-out; }\n  @media (prefers-reduced-motion: reduce) { button, a { transition: none !important; } }\n</style>\n<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen w-full overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"mobile service history app\">\n    <header class=\"sticky top-0 z-20 border-b border-[#334155] bg-[#0F172A]/95 backdrop-blur-sm\" data-kid=\"2-1\" data-name=\"mobile top bar\">\n        <div class=\"flex h-[68px] items-center justify-between px-4\" data-kid=\"2-1-1\" data-name=\"mobile header row\">\n            <div class=\"flex items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"brand and page context\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-[#38BDF8] text-[#020617] shadow-[0_8px_24px_rgba(56,189,248,0.18)]\" data-kid=\"2-1-1-1-1\" data-name=\"AutoDoc logo\">\n                    <span class=\"font-heading text-[17px] font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1-1-1\" data-name=\"AD logo text\">\n                        AD\n                    </span>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-1-2\" data-name=\"page identifier container\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-1-1-2-1\" data-name=\"page breadcrumb label\">\n                        Propietario\n                    </p>\n                    <p class=\"font-heading truncate text-[15px] font-bold tracking-[-0.02em] text-white\" data-kid=\"2-1-1-1-2-2\" data-name=\"page current title\">\n                        Historial\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-1\" data-kid=\"2-1-1-2\" data-name=\"mobile header actions\">\n                <button aria-label=\"Cambiar tema\" class=\"flex h-11 w-11 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-1-2-1\" data-name=\"theme toggle\">\n                    <i class=\"ti ti-sun-moon text-[18px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"sun moon icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Notificaciones\" class=\"relative flex h-11 w-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-1-2-2\" data-name=\"notifications button\">\n                    <i class=\"ti ti-bell text-[18px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"bell icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-1-2-2-2\" data-name=\"unread notification indicator\">\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[118px] pt-6\" data-dynamic=\"true\" data-kid=\"2-2\" data-name=\"mobile service history content\" data-reason=\"padding bottom updated via script for safe area\" style=\"padding-bottom:calc(118px + env(safe-area-inset-bottom))\">\n        <div class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"history title group\">\n            <div class=\"mb-3 flex items-center gap-2 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"mobile breadcrumbs\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"breadcrumbs owner text\">\n                    Propietario\n                </span>\n                <i class=\"ti ti-chevron-right text-[13px]\" data-kid=\"2-2-1-1-2\" data-name=\"chevron right icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"font-semibold text-[#CBD5E1]\" data-kid=\"2-2-1-1-3\" data-name=\"breadcrumbs page text\">\n                    Historial\n                </span>\n            </div>\n            <h1 class=\"font-heading text-[25px] font-extrabold leading-[1.12] tracking-[-0.045em] text-white\" data-kid=\"2-2-1-2\" data-name=\"history headline\">\n                Historial de servicios\n            </h1>\n            <p class=\"mt-3 max-w-[320px] text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"2-2-1-3\" data-name=\"history subheadline\">\n                Consulta cada trabajo realizado y el costo acumulado de tu vehículo.\n            </p>\n            <button class=\"mt-5 flex min-h-[46px] w-full items-center justify-center gap-2 bg-[#38BDF8] px-4 py-3 text-[13px] font-bold text-[#082F49]\" data-kid=\"2-2-1-4\" data-name=\"register service button\">\n                <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-2-1-4-1\" data-name=\"plus icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Registrar servicio\n            </button>\n        </div>\n        <section class=\"mb-6 border-y border-[#334155] py-4\" data-kid=\"2-2-2\" data-name=\"vehicle and filter controls\">\n            <div class=\"flex items-start gap-3\" data-kid=\"2-2-2-1\" data-name=\"vehicle identity\">\n                <i class=\"ti ti-car mt-0.5 shrink-0 text-[19px] text-[#38BDF8]\" data-kid=\"2-2-2-1-1\" data-name=\"car icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <div class=\"min-w-0 flex-1\" data-kid=\"2-2-2-1-2\" data-name=\"vehicle details container\">\n                    <p class=\"text-[13px] font-semibold leading-5 text-[#E2E8F0]\" data-kid=\"2-2-2-1-2-1\" data-name=\"vehicle model info\">\n                        Toyota Corolla 2022 · P 482-916\n                    </p>\n                    <span class=\"mt-2 inline-flex rounded-[4px] border border-[#34D399]/40 bg-[#064E3B]/30 px-2 py-1 text-[10px] font-bold text-[#6EE7B7]\" data-kid=\"2-2-2-1-2-2\" data-name=\"active status badge\">\n                        Activo\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-4 grid gap-2\" data-kid=\"2-2-2-2\" data-name=\"mobile filter controls\">\n                <button class=\"flex min-h-[44px] w-full items-center justify-between gap-2 border border-[#475569] px-3 text-left text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-1\" data-name=\"time period filter\">\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-2-2-2-1-1\" data-name=\"time filter selection\">\n                        <i class=\"ti ti-calendar text-[16px] text-[#38BDF8]\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"calendar icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Últimos 12 meses\n                    </span>\n                    <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-2-2-2-1-2\" data-name=\"chevron down icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-[44px] w-full items-center justify-between gap-2 border border-[#475569] px-3 text-left text-[12px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-2-2-2\" data-name=\"status filter\">\n                    <span class=\"flex items-center gap-2\" data-kid=\"2-2-2-2-2-1\" data-name=\"status filter selection\">\n                        <i class=\"ti ti-adjustments-horizontal text-[16px] text-[#94A3B8]\" data-kid=\"2-2-2-2-2-1-1\" data-name=\"adjustments icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Todos los estados\n                    </span>\n                    <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-2-2-2-2-2\" data-name=\"chevron down icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <div class=\"flex min-h-[44px] items-center gap-2 border border-[#475569] px-3 text-[12px] text-[#64748B]\" data-kid=\"2-2-2-2-3\" data-name=\"search field\">\n                    <i class=\"ti ti-search text-[16px]\" data-kid=\"2-2-2-2-3-1\" data-name=\"search icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-2-2-2-3-2\" data-name=\"search placeholder text\">\n                        Buscar servicio\n                    </span>\n                    <span class=\"ml-auto text-[10px] text-[#64748B]\" data-kid=\"2-2-2-2-3-3\" data-name=\"keyboard shortcut hint\">\n                        ⌘K\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y border-[#475569]\" data-kid=\"2-2-3\" data-name=\"registered services section\">\n            <div class=\"flex items-start justify-between gap-3 border-b border-[#334155] py-4\" data-kid=\"2-2-3-1\" data-name=\"services section header\">\n                <div data-kid=\"2-2-3-1-1\" data-name=\"section title group\">\n                    <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em] text-white\" data-kid=\"2-2-3-1-1-1\" data-name=\"section title\">\n                        Servicios registrados\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-3-1-1-2\" data-name=\"section service count\">\n                        7 servicios en el periodo seleccionado\n                    </p>\n                </div>\n                <button class=\"flex min-h-[44px] shrink-0 items-center gap-1 text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-3-1-2\" data-name=\"export CSV button\">\n                    Exportar CSV\n                    <i class=\"ti ti-download text-[15px]\" data-kid=\"2-2-3-1-2-1\" data-name=\"download icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"divide-y divide-[#334155]\" data-kid=\"2-2-3-2\" data-name=\"mobile service cards\">\n                <article class=\"py-4\" data-kid=\"2-2-3-2-1\" data-name=\"service record card 1\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-2-1-1\" data-name=\"card head row\">\n                        <div data-kid=\"2-2-3-2-1-1-1\" data-name=\"card date and title\">\n                            <p class=\"text-[11px] tabular-nums text-[#94A3B8]\" data-kid=\"2-2-3-2-1-1-1-1\" data-name=\"service date text\">\n                                12 jun 2026\n                            </p>\n                            <h3 class=\"mt-1 text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-1-1-1-2\" data-name=\"service title\">\n                                Cambio de aceite\n                            </h3>\n                        </div>\n                        <span class=\"flex min-h-[28px] items-center gap-1 rounded-[4px] bg-[#064E3B]/30 px-2 text-[11px] font-semibold text-[#6EE7B7]\" data-kid=\"2-2-3-2-1-1-2\" data-name=\"status badge\">\n                            <i class=\"ti ti-circle-check text-[14px]\" data-kid=\"2-2-3-2-1-1-2-1\" data-name=\"check icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Completado\n                        </span>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-3 border-t border-[#334155] pt-3 text-[12px]\" data-kid=\"2-2-3-2-1-2\" data-name=\"card metrics row\">\n                        <div data-kid=\"2-2-3-2-1-2-1\" data-name=\"workshop name cell\">\n                            <p class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-1-2-1-1\" data-name=\"workshop label\">\n                                Taller\n                            </p>\n                            <p class=\"mt-1 text-[#CBD5E1]\" data-kid=\"2-2-3-2-1-2-1-2\" data-name=\"workshop value\">\n                                Taller Rápido\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-3-2-1-2-2\" data-name=\"mileage cell\">\n                            <p class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-1-2-2-1\" data-name=\"mileage label\">\n                                Kilometraje\n                            </p>\n                            <p class=\"mt-1 tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-3-2-1-2-2-2\" data-name=\"mileage value\">\n                                48,260 km\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-3 flex items-end justify-between\" data-kid=\"2-2-3-2-1-3\" data-name=\"card total row\">\n                        <span class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-1-3-1\" data-name=\"total cost label\">\n                            Total\n                        </span>\n                        <span class=\"text-[15px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-3-2-1-3-2\" data-name=\"total cost value\">\n                            $82.00\n                        </span>\n                    </div>\n                </article>\n                <article class=\"py-4\" data-kid=\"2-2-3-2-2\" data-name=\"service record card 2\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-2-2-1\" data-name=\"card head row\">\n                        <div data-kid=\"2-2-3-2-2-1-1\" data-name=\"card date and title\">\n                            <p class=\"text-[11px] tabular-nums text-[#94A3B8]\" data-kid=\"2-2-3-2-2-1-1-1\" data-name=\"service date text\">\n                                18 may 2026\n                            </p>\n                            <h3 class=\"mt-1 text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-2-1-1-2\" data-name=\"service title\">\n                                Revisión de frenos\n                            </h3>\n                        </div>\n                        <span class=\"flex min-h-[28px] items-center gap-1 rounded-[4px] bg-[#713F12]/30 px-2 text-[11px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-3-2-2-1-2\" data-name=\"status badge\">\n                            <i class=\"ti ti-clock text-[14px]\" data-kid=\"2-2-3-2-2-1-2-1\" data-name=\"clock icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Pendiente\n                        </span>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-3 border-t border-[#334155] pt-3 text-[12px]\" data-kid=\"2-2-3-2-2-2\" data-name=\"card metrics row\">\n                        <div data-kid=\"2-2-3-2-2-2-1\" data-name=\"workshop name cell\">\n                            <p class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-2-2-1-1\" data-name=\"workshop label\">\n                                Taller\n                            </p>\n                            <p class=\"mt-1 text-[#CBD5E1]\" data-kid=\"2-2-3-2-2-2-1-2\" data-name=\"workshop value\">\n                                MotorLab\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-3-2-2-2-2\" data-name=\"mileage cell\">\n                            <p class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-2-2-2-1\" data-name=\"mileage label\">\n                                Kilometraje\n                            </p>\n                            <p class=\"mt-1 tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-3-2-2-2-2-2\" data-name=\"mileage value\">\n                                46,520 km\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-3 flex items-end justify-between\" data-kid=\"2-2-3-2-2-3\" data-name=\"card total row\">\n                        <span class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-2-3-1\" data-name=\"total cost label\">\n                            Total\n                        </span>\n                        <span class=\"text-[15px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-3-2-2-3-2\" data-name=\"total cost value\">\n                            $180.00\n                        </span>\n                    </div>\n                </article>\n                <article class=\"py-4\" data-kid=\"2-2-3-2-3\" data-name=\"service record card 3\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-2-3-1\" data-name=\"card head row\">\n                        <div data-kid=\"2-2-3-2-3-1-1\" data-name=\"card date and title\">\n                            <p class=\"text-[11px] tabular-nums text-[#94A3B8]\" data-kid=\"2-2-3-2-3-1-1-1\" data-name=\"service date text\">\n                                04 feb 2026\n                            </p>\n                            <h3 class=\"mt-1 text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-3-1-1-2\" data-name=\"service title\">\n                                Diagnóstico\n                            </h3>\n                        </div>\n                        <span class=\"flex min-h-[28px] items-center gap-1 rounded-[4px] bg-[#064E3B]/30 px-2 text-[11px] font-semibold text-[#6EE7B7]\" data-kid=\"2-2-3-2-3-1-2\" data-name=\"status badge\">\n                            <i class=\"ti ti-circle-check text-[14px]\" data-kid=\"2-2-3-2-3-1-2-1\" data-name=\"check icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Completado\n                        </span>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-3 border-t border-[#334155] pt-3 text-[12px]\" data-kid=\"2-2-3-2-3-2\" data-name=\"card metrics row\">\n                        <div data-kid=\"2-2-3-2-3-2-1\" data-name=\"workshop name cell\">\n                            <p class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-3-2-1-1\" data-name=\"workshop label\">\n                                Taller\n                            </p>\n                            <p class=\"mt-1 text-[#CBD5E1]\" data-kid=\"2-2-3-2-3-2-1-2\" data-name=\"workshop value\">\n                                Centro Auto\n                            </p>\n                        </div>\n                        <div data-kid=\"2-2-3-2-3-2-2\" data-name=\"mileage cell\">\n                            <p class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-3-2-2-1\" data-name=\"mileage label\">\n                                Kilometraje\n                            </p>\n                            <p class=\"mt-1 tabular-nums text-[#CBD5E1]\" data-kid=\"2-2-3-2-3-2-2-2\" data-name=\"mileage value\">\n                                43,100 km\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-3 flex items-end justify-between\" data-kid=\"2-2-3-2-3-3\" data-name=\"card total row\">\n                        <span class=\"text-[10px] uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-3-3-1\" data-name=\"total cost label\">\n                            Total\n                        </span>\n                        <span class=\"text-[15px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-3-2-3-3-2\" data-name=\"total cost value\">\n                            $95.00\n                        </span>\n                    </div>\n                </article>\n            </div>\n            <div class=\"flex items-start gap-3 border-t border-dashed border-[#334155] px-1 py-5 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-3\" data-name=\"end of records state\">\n                <i class=\"ti ti-history-toggle mt-0.5 shrink-0 text-[17px]\" data-kid=\"2-2-3-3-1\" data-name=\"history toggle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"leading-5\" data-kid=\"2-2-3-3-2\" data-name=\"no records message\">\n                    No hay más registros en este periodo.\n                </span>\n                <button class=\"ml-auto min-h-[44px] shrink-0 px-1 text-right text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-3-3-3\" data-name=\"change period button\">\n                    Cambiar periodo\n                </button>\n            </div>\n        </section>\n        <aside class=\"mt-7 border-y border-[#475569]\" data-kid=\"2-2-4\" data-name=\"annual history summary\">\n            <div class=\"border-b border-[#334155] py-5\" data-kid=\"2-2-4-1\" data-name=\"annual summary header\">\n                <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em] text-white\" data-kid=\"2-2-4-1-1\" data-name=\"summary title\">\n                    Resumen anual\n                </h2>\n                <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-4-1-2\" data-name=\"summary subtitle\">\n                    Toyota Corolla 2022 · últimos 12 meses\n                </p>\n            </div>\n            <div class=\"border-b border-[#334155] py-5\" data-kid=\"2-2-4-2\" data-name=\"total maintenance block\">\n                <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-1\" data-name=\"total maintenance label\">\n                    Total mantenimiento\n                </p>\n                <p class=\"mt-1 font-heading text-[28px] font-extrabold tabular-nums text-[#38BDF8]\" data-kid=\"2-2-4-2-2\" data-name=\"total maintenance amount\">\n                    $684.50\n                </p>\n                <p class=\"mt-1 flex items-center gap-1 text-[11px] text-[#34D399]\" data-kid=\"2-2-4-2-3\" data-name=\"total services count summary\">\n                    <i class=\"ti ti-trending-up text-[13px]\" data-kid=\"2-2-4-2-3-1\" data-name=\"trending icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    7 servicios registrados\n                </p>\n            </div>\n            <div class=\"border-b border-[#334155] py-5\" data-kid=\"2-2-4-3\" data-name=\"average service block\">\n                <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-4-3-1\" data-name=\"average cost label\">\n                    Promedio por servicio\n                </p>\n                <p class=\"mt-1 text-[18px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-2-4-3-2\" data-name=\"average cost value\">\n                    $97.79\n                </p>\n            </div>\n            <div class=\"py-5\" data-kid=\"2-2-4-4\" data-name=\"next tracking block\">\n                <p class=\"text-[11px] text-[#64748B]\" data-kid=\"2-2-4-4-1\" data-name=\"next tracking label\">\n                    Próximo seguimiento\n                </p>\n                <p class=\"mt-1 flex items-center gap-2 text-[13px] font-semibold text-[#FCD34D]\" data-kid=\"2-2-4-4-2\" data-name=\"next tracking value\">\n                    <i class=\"ti ti-alert-triangle text-[15px]\" data-kid=\"2-2-4-4-2-1\" data-name=\"alert triangle icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Pastillas en 420 km\n                </p>\n            </div>\n            <button class=\"flex min-h-[44px] items-center gap-2 pb-5 text-[12px] font-semibold text-[#38BDF8]\" data-kid=\"2-2-4-5\" data-name=\"view vehicle alerts button\">\n                Ver alertas del vehículo\n                <i class=\"ti ti-arrow-up-right text-[14px]\" data-kid=\"2-2-4-5-1\" data-name=\"arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </aside>\n        <footer class=\"mt-8 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"2-2-5\" data-name=\"mobile footer\">\n            <p data-kid=\"2-2-5-1\" data-name=\"footer brand text\">\n                AutoDoc · Historial y trazabilidad del mantenimiento\n            </p>\n            <p class=\"mt-2 flex items-center gap-2\" data-kid=\"2-2-5-2\" data-name=\"sync status text\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-5-2-1\" data-name=\"status dot\">\n                </span>\n                Datos sincronizados hace 4 min\n            </p>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#334155] bg-[#020617]/98\" data-dynamic=\"true\" data-kid=\"2-3\" data-name=\"mobile bottom navigation\" data-reason=\"padding bottom updated via script for safe area\" style=\"padding-bottom:env(safe-area-inset-bottom)\">\n        <div class=\"grid h-[72px] grid-cols-5 px-1\" data-kid=\"2-3-1\" data-name=\"nav inner container\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-[44px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-1\" data-name=\"nav item home\" href=\"#inicio\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"home icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-[44px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"nav item garage\" href=\"#garaje\">\n                <i class=\"ti ti-steering-wheel text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"garage icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"garage label\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-[44px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"nav item workshops\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"workshops icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-label=\"Alertas\" class=\"relative flex min-h-[44px] flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-4\" data-name=\"nav item alerts\" href=\"#alertas\">\n                <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"alerts icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"alerts label\">\n                    Alertas\n                </span>\n                <span class=\"absolute right-[18px] top-[12px] h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-3-1-4-3\" data-name=\"alert notification dot\">\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Historial\" class=\"flex min-h-[44px] flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] text-[#38BDF8]\" data-kid=\"2-3-1-5\" data-name=\"nav item history\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-5-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
