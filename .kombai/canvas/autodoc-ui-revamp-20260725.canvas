      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons CSS library\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile workshop settings application shell\">\n    <header class=\"sticky top-0 z-20 flex min-h-[64px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"mobile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[17px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc mobile logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-4\" data-name=\"mobile page path container\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2\" data-name=\"mobile breadcrumb parent\">\n                    Taller\n                </p>\n                <p class=\"truncate text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-1-1-3\" data-name=\"mobile current page\">\n                    Configuración\n                </p>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header actions\">\n            <button aria-label=\"Notificaciones\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"mobile notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"notifications icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-2\" data-name=\"mobile user initials\">\n                MR\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[112px] pt-6\" data-kid=\"2-2\" data-name=\"mobile settings main area\">\n        <div class=\"mb-5\" data-kid=\"2-2-1\" data-name=\"mobile page title block\">\n            <h1 class=\"font-heading text-[26px] font-extrabold leading-tight tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-1\" data-name=\"mobile page title\">\n                Configuración del taller\n            </h1>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-2\" data-name=\"mobile page description\">\n                Mantén actualizada la información que ven tus clientes.\n            </p>\n            <button class=\"mt-4 inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#46256F] px-5 py-3 text-[13px] font-bold text-white shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.10)] active:scale-[0.97]\" data-kid=\"2-2-1-3\" data-name=\"mobile save changes button\">\n                <i class=\"ti ti-device-floppy text-[17px]\" data-kid=\"2-2-1-3-1\" data-name=\"floppy disk icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Guardar cambios\n            </button>\n        </div>\n        <div class=\"mb-6 flex items-start gap-3 border-l-4 border-[#F59E0B] bg-[#FFFBEB] px-3 py-3\" data-kid=\"2-2-2\" data-name=\"mobile unsaved changes notice\">\n            <i class=\"mt-0.5 shrink-0 text-[19px] text-[#B45309]\" data-kid=\"2-2-2-1\" data-name=\"alert icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <div class=\"min-w-0\" data-kid=\"2-2-2-2\" data-name=\"mobile notice content\">\n                <p class=\"text-[13px] font-bold text-[#92400E]\" data-kid=\"2-2-2-2-1\" data-name=\"notice title\">\n                    Cambios sin guardar\n                </p>\n                <p class=\"mt-1 text-[12px] leading-4 text-[#A16207]\" data-kid=\"2-2-2-2-2\" data-name=\"notice subtitle\">\n                    Revisa la información antes de salir de esta pantalla.\n                </p>\n                <p class=\"mt-2 text-[11px] font-semibold text-[#92400E]\" data-kid=\"2-2-2-2-3\" data-name=\"notice timestamp\">\n                    Última edición hace 2 min\n                </p>\n            </div>\n        </div>\n        <form class=\"space-y-6\" data-kid=\"2-3\" data-name=\"mobile workshop settings form\">\n            <section class=\"border-y border-[#CBD5E1] bg-white px-4 py-5\" data-kid=\"2-3-1\" data-name=\"mobile public information section\">\n                <div class=\"mb-5 flex items-start gap-3\" data-kid=\"2-3-1-1\" data-name=\"public information header\">\n                    <span class=\"mt-0.5 shrink-0 text-[20px] text-[#1E88E5]\" data-kid=\"2-3-1-1-1\" data-name=\"building store icon wrapper\">\n                        <i class=\"ti ti-building-store\" data-kid=\"2-3-1-1-1-1\" data-name=\"building store icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div data-kid=\"2-3-1-1-4\" data-name=\"public info header title container\">\n                        <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em]\" data-kid=\"2-3-1-1-2\" data-name=\"public information title\">\n                            Información pública\n                        </h2>\n                        <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-3-1-1-3\" data-name=\"public information subtitle\">\n                            Estos datos serán visibles en el directorio de talleres.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"space-y-5\" data-kid=\"2-3-1-2\" data-name=\"public information fields\">\n                    <label class=\"block\" data-kid=\"2-3-1-2-1\" data-name=\"workshop name field\">\n                        <span class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-3-1-2-1-2\" data-name=\"workshop name label\">\n                            Nombre del taller\n                        </span>\n                        <div class=\"flex min-h-[48px] items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3\" data-kid=\"2-3-1-2-1-1\" data-name=\"workshop name input wrapper\">\n                            <i class=\"ti ti-building text-[18px] text-[#64748B]\" data-kid=\"2-3-1-2-1-1-1\" data-name=\"building icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span class=\"ml-3 text-[14px] text-[#0F172A]\" data-kid=\"2-3-1-2-1-1-2\" data-name=\"workshop name display value\">\n                                Taller Rápido\n                            </span>\n                        </div>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-3-1-2-2\" data-name=\"specialty field\">\n                        <span class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-3-1-2-2-2\" data-name=\"specialty label\">\n                            Especialidad\n                        </span>\n                        <div class=\"flex min-h-[48px] items-center justify-between border border-[#CBD5E1] bg-[#F8FAFC] px-3\" data-kid=\"2-3-1-2-2-1\" data-name=\"specialty select wrapper\">\n                            <span class=\"text-[14px] text-[#0F172A]\" data-kid=\"2-3-1-2-2-1-2\" data-name=\"specialty display value\">\n                                Mantenimiento general\n                            </span>\n                            <i class=\"ti ti-chevron-down text-[17px] text-[#64748B]\" data-kid=\"2-3-1-2-2-1-1\" data-name=\"specialty chevron\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-3-1-2-3\" data-name=\"phone field\">\n                        <span class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-3-1-2-3-3\" data-name=\"phone label\">\n                            Teléfono de contacto\n                        </span>\n                        <div class=\"flex min-h-[48px] items-center border border-[#EF4444] bg-[#FFF7F7] px-3 ring-1 ring-[#EF4444]/10\" data-kid=\"2-3-1-2-3-1\" data-name=\"phone input wrapper\">\n                            <i class=\"ti ti-phone text-[18px] text-[#B91C1C]\" data-kid=\"2-3-1-2-3-1-1\" data-name=\"phone icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span class=\"ml-3 text-[14px] text-[#0F172A]\" data-kid=\"2-3-1-2-3-1-2\" data-name=\"phone display value\">\n                                +503 7788-990\n                            </span>\n                        </div>\n                        <span class=\"mt-2 flex items-start gap-1.5 text-[12px] font-medium leading-4 text-[#B91C1C]\" data-kid=\"2-3-1-2-3-2\" data-name=\"phone error message\">\n                            <i class=\"ti ti-alert-triangle mt-0.5 shrink-0 text-[14px]\" data-kid=\"2-3-1-2-3-2-1\" data-name=\"phone error icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            El número debe tener al menos 8 dígitos.\n                        </span>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-3-1-2-4\" data-name=\"department field\">\n                        <span class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-3-1-2-4-2\" data-name=\"department label\">\n                            Departamento\n                        </span>\n                        <div class=\"flex min-h-[48px] items-center justify-between border border-[#CBD5E1] bg-[#F8FAFC] px-3\" data-kid=\"2-3-1-2-4-1\" data-name=\"department select wrapper\">\n                            <span class=\"text-[14px] text-[#0F172A]\" data-kid=\"2-3-1-2-4-1-2\" data-name=\"department display value\">\n                                San Salvador\n                            </span>\n                            <i class=\"ti ti-chevron-down text-[17px] text-[#64748B]\" data-kid=\"2-3-1-2-4-1-1\" data-name=\"department chevron\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                    </label>\n                    <label class=\"block\" data-kid=\"2-3-1-2-5\" data-name=\"municipality field\">\n                        <span class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-3-1-2-5-2\" data-name=\"municipality label\">\n                            Municipio\n                        </span>\n                        <div class=\"flex min-h-[48px] items-center justify-between border border-[#CBD5E1] bg-[#F8FAFC] px-3\" data-kid=\"2-3-1-2-5-1\" data-name=\"municipality select wrapper\">\n                            <span class=\"text-[14px] text-[#0F172A]\" data-kid=\"2-3-1-2-5-1-2\" data-name=\"municipality display value\">\n                                San Salvador\n                            </span>\n                            <i class=\"ti ti-chevron-down text-[17px] text-[#64748B]\" data-kid=\"2-3-1-2-5-1-1\" data-name=\"municipality chevron\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                    </label>\n                </div>\n            </section>\n            <section class=\"border-y border-[#CBD5E1] bg-white px-4 py-5\" data-kid=\"2-3-2\" data-name=\"mobile opening hours section\">\n                <div class=\"mb-5 flex items-start gap-3\" data-kid=\"2-3-2-1\" data-name=\"opening hours header\">\n                    <span class=\"mt-0.5 shrink-0 text-[20px] text-[#1E88E5]\" data-kid=\"2-3-2-1-1\" data-name=\"clock icon wrapper\">\n                        <i class=\"ti ti-clock\" data-kid=\"2-3-2-1-1-1\" data-name=\"clock icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div data-kid=\"2-3-2-1-4\" data-name=\"opening hours title container\">\n                        <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em]\" data-kid=\"2-3-2-1-2\" data-name=\"opening hours title\">\n                            Horario\n                        </h2>\n                        <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-3-2-1-3\" data-name=\"opening hours subtitle\">\n                            Define cuándo pueden encontrarte tus clientes.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"divide-y divide-[#E2E8F0] border-y border-[#E2E8F0]\" data-kid=\"2-3-2-2\" data-name=\"mobile opening hours rows\">\n                    <div class=\"py-4\" data-kid=\"2-3-2-2-1\" data-name=\"monday row\">\n                        <div class=\"mb-3 flex items-center gap-3\" data-kid=\"2-3-2-2-1-1\" data-name=\"monday day badge container\">\n                            <span class=\"grid size-8 place-items-center bg-[#E8F2FD] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-3-2-2-1-1-1\" data-name=\"monday day label\">\n                                L\n                            </span>\n                            <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-2-2-1-1-2\" data-name=\"monday full name\">\n                                Lunes\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-2 pl-11\" data-kid=\"2-3-2-2-1-2\" data-name=\"monday time container\">\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-1-2-1\" data-name=\"monday start time\">\n                                08:00\n                            </span>\n                            <span class=\"text-[#94A3B8]\" data-kid=\"2-3-2-2-1-2-2\" data-name=\"time separator\">\n                                —\n                            </span>\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-1-2-3\" data-name=\"monday end time\">\n                                18:00\n                            </span>\n                            <span class=\"ml-1 size-2 shrink-0 rounded-full bg-[#10B981]\" data-kid=\"2-3-2-2-1-2-4\" data-name=\"status indicator\">\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"py-4\" data-kid=\"2-3-2-2-2\" data-name=\"tuesday row\">\n                        <div class=\"mb-3 flex items-center gap-3\" data-kid=\"2-3-2-2-2-1\" data-name=\"tuesday day badge container\">\n                            <span class=\"grid size-8 place-items-center bg-[#E8F2FD] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-3-2-2-2-1-1\" data-name=\"tuesday day label\">\n                                M\n                            </span>\n                            <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-2-2-2-1-2\" data-name=\"tuesday full name\">\n                                Martes\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-2 pl-11\" data-kid=\"2-3-2-2-2-2\" data-name=\"tuesday time container\">\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-2-2-1\" data-name=\"tuesday start time\">\n                                08:00\n                            </span>\n                            <span class=\"text-[#94A3B8]\" data-kid=\"2-3-2-2-2-2-2\" data-name=\"tuesday time separator\">\n                                —\n                            </span>\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-2-2-3\" data-name=\"tuesday end time\">\n                                18:00\n                            </span>\n                            <span class=\"ml-1 size-2 shrink-0 rounded-full bg-[#10B981]\" data-kid=\"2-3-2-2-2-2-4\" data-name=\"tuesday status indicator\">\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"py-4\" data-kid=\"2-3-2-2-3\" data-name=\"wednesday row\">\n                        <div class=\"mb-3 flex items-center gap-3\" data-kid=\"2-3-2-2-3-1\" data-name=\"wednesday day badge container\">\n                            <span class=\"grid size-8 place-items-center bg-[#E8F2FD] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-3-2-2-3-1-1\" data-name=\"wednesday day label\">\n                                X\n                            </span>\n                            <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-2-2-3-1-2\" data-name=\"wednesday full name\">\n                                Miércoles\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-2 pl-11\" data-kid=\"2-3-2-2-3-2\" data-name=\"wednesday time container\">\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-3-2-1\" data-name=\"wednesday start time\">\n                                08:00\n                            </span>\n                            <span class=\"text-[#94A3B8]\" data-kid=\"2-3-2-2-3-2-2\" data-name=\"wednesday time separator\">\n                                —\n                            </span>\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-3-2-3\" data-name=\"wednesday end time\">\n                                18:00\n                            </span>\n                            <span class=\"ml-1 size-2 shrink-0 rounded-full bg-[#10B981]\" data-kid=\"2-3-2-2-3-2-4\" data-name=\"wednesday status indicator\">\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"py-4\" data-kid=\"2-3-2-2-4\" data-name=\"thursday row\">\n                        <div class=\"mb-3 flex items-center gap-3\" data-kid=\"2-3-2-2-4-1\" data-name=\"thursday day badge container\">\n                            <span class=\"grid size-8 place-items-center bg-[#E8F2FD] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-3-2-2-4-1-1\" data-name=\"thursday day label\">\n                                J\n                            </span>\n                            <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-2-2-4-1-2\" data-name=\"thursday full name\">\n                                Jueves\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-2 pl-11\" data-kid=\"2-3-2-2-4-2\" data-name=\"thursday time container\">\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-4-2-1\" data-name=\"thursday start time\">\n                                08:00\n                            </span>\n                            <span class=\"text-[#94A3B8]\" data-kid=\"2-3-2-2-4-2-2\" data-name=\"thursday time separator\">\n                                —\n                            </span>\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-4-2-3\" data-name=\"thursday end time\">\n                                18:00\n                            </span>\n                            <span class=\"ml-1 size-2 shrink-0 rounded-full bg-[#10B981]\" data-kid=\"2-3-2-2-4-2-4\" data-name=\"thursday status indicator\">\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"py-4\" data-kid=\"2-3-2-2-5\" data-name=\"friday row\">\n                        <div class=\"mb-3 flex items-center gap-3\" data-kid=\"2-3-2-2-5-1\" data-name=\"friday day badge container\">\n                            <span class=\"grid size-8 place-items-center bg-[#E8F2FD] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-3-2-2-5-1-1\" data-name=\"friday day label\">\n                                V\n                            </span>\n                            <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-2-2-5-1-2\" data-name=\"friday full name\">\n                                Viernes\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-2 pl-11\" data-kid=\"2-3-2-2-5-2\" data-name=\"friday time container\">\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-5-2-1\" data-name=\"friday start time\">\n                                08:00\n                            </span>\n                            <span class=\"text-[#94A3B8]\" data-kid=\"2-3-2-2-5-2-2\" data-name=\"friday time separator\">\n                                —\n                            </span>\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-5-2-3\" data-name=\"friday end time\">\n                                18:00\n                            </span>\n                            <span class=\"ml-1 size-2 shrink-0 rounded-full bg-[#10B981]\" data-kid=\"2-3-2-2-5-2-4\" data-name=\"friday status indicator\">\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"py-4\" data-kid=\"2-3-2-2-6\" data-name=\"saturday row\">\n                        <div class=\"mb-3 flex items-center gap-3\" data-kid=\"2-3-2-2-6-1\" data-name=\"saturday day badge container\">\n                            <span class=\"grid size-8 place-items-center bg-[#E8F2FD] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-3-2-2-6-1-1\" data-name=\"saturday day label\">\n                                S\n                            </span>\n                            <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-2-2-6-1-2\" data-name=\"saturday full name\">\n                                Sábado\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-2 pl-11\" data-kid=\"2-3-2-2-6-2\" data-name=\"saturday time container\">\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-6-2-1\" data-name=\"saturday start time\">\n                                08:00\n                            </span>\n                            <span class=\"text-[#94A3B8]\" data-kid=\"2-3-2-2-6-2-2\" data-name=\"saturday time separator\">\n                                —\n                            </span>\n                            <span class=\"flex h-10 flex-1 items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-2-2-6-2-3\" data-name=\"saturday end time\">\n                                18:00\n                            </span>\n                            <span class=\"ml-1 size-2 shrink-0 rounded-full bg-[#10B981]\" data-kid=\"2-3-2-2-6-2-4\" data-name=\"saturday status indicator\">\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-4 py-4\" data-kid=\"2-3-2-2-7\" data-name=\"sunday row\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-3-2-2-7-1\" data-name=\"sunday day badge container\">\n                            <span class=\"grid size-8 place-items-center bg-[#F1F5F9] text-[13px] font-bold text-[#64748B]\" data-kid=\"2-3-2-2-7-1-1\" data-name=\"sunday day label\">\n                                D\n                            </span>\n                            <span class=\"text-[13px] font-semibold text-[#64748B]\" data-kid=\"2-3-2-2-7-1-2\" data-name=\"sunday full name\">\n                                Domingo\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-3-2-2-7-2\" data-name=\"sunday status container\">\n                            <span class=\"text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-3-2-2-7-2-1\" data-name=\"sunday status label\">\n                                Cerrado\n                            </span>\n                            <span class=\"size-2 rounded-full bg-[#CBD5E1]\" data-kid=\"2-3-2-2-7-2-2\" data-name=\"sunday status indicator\">\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section class=\"border-y border-[#CBD5E1] bg-white px-4 py-5\" data-kid=\"2-3-3\" data-name=\"mobile services offered section\">\n                <div class=\"mb-5 flex items-start gap-3\" data-kid=\"2-3-3-1\" data-name=\"services header\">\n                    <span class=\"mt-0.5 shrink-0 text-[20px] text-[#1E88E5]\" data-kid=\"2-3-3-1-3\" data-name=\"tools icon wrapper\">\n                        <i class=\"ti ti-tool\" data-kid=\"2-3-3-1-1\" data-name=\"tools icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div data-kid=\"2-3-3-1-4\" data-name=\"services title container\">\n                        <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em]\" data-kid=\"2-3-3-1-2\" data-name=\"services title\">\n                            Servicios ofrecidos\n                        </h2>\n                        <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-3-3-1-4-2\" data-name=\"services subtitle\">\n                            Aparecerán en el perfil público de tu taller.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"divide-y divide-[#E2E8F0] border-y border-[#E2E8F0]\" data-kid=\"2-3-3-2\" data-name=\"mobile service switches\">\n                    <div class=\"flex min-h-[56px] items-center justify-between gap-4\" data-kid=\"2-3-3-2-5\" data-name=\"oil change row\">\n                        <span class=\"flex items-center gap-3 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-3-2-5-1\" data-name=\"oil change label\">\n                            <i class=\"ti ti-droplet text-[18px] text-[#1E88E5]\" data-kid=\"2-3-3-2-1\" data-name=\"oil drop icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Cambio de aceite\n                        </span>\n                        <span class=\"relative h-6 w-11 shrink-0 rounded-full bg-[#1E88E5]\" data-kid=\"2-3-3-2-5-2\" data-name=\"oil change switch\">\n                            <span class=\"absolute right-1 top-1 size-4 rounded-full bg-white shadow-[0_1px_2px_rgba(15,23,42,0.15)]\" data-kid=\"2-3-3-2-5-2-1\" data-name=\"oil change toggle knob\">\n                            </span>\n                        </span>\n                    </div>\n                    <div class=\"flex min-h-[56px] items-center justify-between gap-4\" data-kid=\"2-3-3-2-6\" data-name=\"brakes row\">\n                        <span class=\"flex items-center gap-3 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-3-2-6-1\" data-name=\"brakes label\">\n                            <i class=\"ti ti-disc text-[18px] text-[#1E88E5]\" data-kid=\"2-3-3-2-2\" data-name=\"disc icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Frenos\n                        </span>\n                        <span class=\"relative h-6 w-11 shrink-0 rounded-full bg-[#1E88E5]\" data-kid=\"2-3-3-2-6-2\" data-name=\"brakes switch\">\n                            <span class=\"absolute right-1 top-1 size-4 rounded-full bg-white shadow-[0_1px_2px_rgba(15,23,42,0.15)]\" data-kid=\"2-3-3-2-6-2-1\" data-name=\"brakes toggle knob\">\n                            </span>\n                        </span>\n                    </div>\n                    <div class=\"flex min-h-[56px] items-center justify-between gap-4\" data-kid=\"2-3-3-2-7\" data-name=\"diagnostics row\">\n                        <span class=\"flex items-center gap-3 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-3-2-7-1\" data-name=\"diagnostics label\">\n                            <i class=\"ti ti-search text-[18px] text-[#1E88E5]\" data-kid=\"2-3-3-2-3\" data-name=\"search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Diagnóstico\n                        </span>\n                        <span class=\"relative h-6 w-11 shrink-0 rounded-full bg-[#1E88E5]\" data-kid=\"2-3-3-2-7-2\" data-name=\"diagnostics switch\">\n                            <span class=\"absolute right-1 top-1 size-4 rounded-full bg-white shadow-[0_1px_2px_rgba(15,23,42,0.15)]\" data-kid=\"2-3-3-2-7-2-1\" data-name=\"diagnostics toggle knob\">\n                            </span>\n                        </span>\n                    </div>\n                    <div class=\"flex min-h-[56px] items-center justify-between gap-4\" data-kid=\"2-3-3-2-8\" data-name=\"general maintenance row\">\n                        <span class=\"flex items-center gap-3 text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-3-2-8-1\" data-name=\"general maintenance label\">\n                            <i class=\"ti ti-settings-2 text-[18px] text-[#1E88E5]\" data-kid=\"2-3-3-2-4\" data-name=\"settings icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Mantenimiento general\n                        </span>\n                        <span class=\"relative h-6 w-11 shrink-0 rounded-full bg-[#CBD5E1]\" data-kid=\"2-3-3-2-8-2\" data-name=\"general maintenance switch\">\n                            <span class=\"absolute left-1 top-1 size-4 rounded-full bg-white shadow-[0_1px_2px_rgba(15,23,42,0.15)]\" data-kid=\"2-3-3-2-8-2-1\" data-name=\"general maintenance toggle knob\">\n                            </span>\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <section class=\"border-y border-[#CBD5E1] bg-white px-4 py-5\" data-kid=\"2-3-4\" data-name=\"mobile location and contact section\">\n                <div class=\"mb-5 flex items-start gap-3\" data-kid=\"2-3-4-1\" data-name=\"location header\">\n                    <span class=\"mt-0.5 shrink-0 text-[20px] text-[#1E88E5]\" data-kid=\"2-3-4-1-2\" data-name=\"map pin icon wrapper\">\n                        <i class=\"ti ti-map-pin\" data-kid=\"2-3-4-1-1\" data-name=\"map pin icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div data-kid=\"2-3-4-1-3\" data-name=\"location title container\">\n                        <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.025em]\" data-kid=\"2-3-4-1-3-1\" data-name=\"location title\">\n                            Ubicación y contacto\n                        </h2>\n                        <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-3-4-1-3-2\" data-name=\"location subtitle\">\n                            Ayuda a tus clientes a llegar y contactarte.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"space-y-5\" data-kid=\"2-3-4-2\" data-name=\"mobile location fields\">\n                    <div data-kid=\"2-3-4-2-4\" data-name=\"address field\">\n                        <span class=\"mb-2 block text-[13px] font-semibold text-[#334155]\" data-kid=\"2-3-4-2-4-1\" data-name=\"address label\">\n                            Dirección visible\n                        </span>\n                        <div class=\"flex min-h-[48px] items-center border border-[#CBD5E1] bg-[#F8FAFC] px-3\" data-kid=\"2-3-4-2-4-2\" data-name=\"address input wrapper\">\n                            <i class=\"ti ti-map-pin text-[18px] text-[#64748B]\" data-kid=\"2-3-4-2-1\" data-name=\"address icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <span class=\"ml-3 text-[13px] text-[#0F172A]\" data-kid=\"2-3-4-2-4-2-2\" data-name=\"address display value\">\n                                San Salvador, San Salvador\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex items-start justify-between gap-3 border border-[#D1FAE5] bg-[#F0FDF4] px-3 py-3\" data-kid=\"2-3-4-2-2\" data-name=\"location registered notice\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"2-3-4-2-2-3\" data-name=\"notice details container\">\n                            <i class=\"ti ti-map-check mt-0.5 shrink-0 text-[19px] text-[#15803D]\" data-kid=\"2-3-4-2-2-1\" data-name=\"map check icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <div data-kid=\"2-3-4-2-2-3-2\" data-name=\"notice text container\">\n                                <p class=\"text-[12px] font-bold text-[#166534]\" data-kid=\"2-3-4-2-2-3-2-1\" data-name=\"notice title\">\n                                    Ubicación registrada\n                                </p>\n                                <p class=\"mt-0.5 text-[11px] text-[#15803D]\" data-kid=\"2-3-4-2-2-3-2-2\" data-name=\"notice subtitle\">\n                                    13.692900, −89.218200\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"min-h-[44px] shrink-0 px-1 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-3-4-2-2-2\" data-name=\"map button\">\n                            En mapa\n                        </button>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-3 border-t border-[#E2E8F0] pt-5\" data-kid=\"2-3-4-2-3\" data-name=\"whatsapp contact row\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"2-3-4-2-3-2\" data-name=\"whatsapp details container\">\n                            <i class=\"ti ti-brand-whatsapp text-[20px] text-[#16A34A]\" data-kid=\"2-3-4-2-3-1\" data-name=\"whatsapp icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <div data-kid=\"2-3-4-2-3-2-2\" data-name=\"whatsapp text container\">\n                                <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-3-4-2-3-2-2-1\" data-name=\"whatsapp label\">\n                                    Contacto por WhatsApp\n                                </p>\n                                <p class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-3-4-2-3-2-2-2\" data-name=\"whatsapp number\">\n                                    +503 7788-990\n                                </p>\n                            </div>\n                        </div>\n                        <span class=\"relative h-6 w-11 shrink-0 rounded-full bg-[#1E88E5]\" data-kid=\"2-3-4-2-3-3\" data-name=\"whatsapp switch\">\n                            <span class=\"absolute right-1 top-1 size-4 rounded-full bg-white shadow-[0_1px_2px_rgba(15,23,42,0.15)]\" data-kid=\"2-3-4-2-3-3-1\" data-name=\"whatsapp toggle knob\">\n                            </span>\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <section class=\"border-t border-[#CBD5E1] pt-5\" data-kid=\"2-3-5\" data-name=\"mobile settings footer actions\">\n                <p class=\"flex items-start gap-2 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-3-5-1\" data-name=\"privacy notice\">\n                    <i class=\"ti ti-shield-check mt-0.5 shrink-0 text-[16px] text-[#10B981]\" data-kid=\"2-3-5-1-1\" data-name=\"shield icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Tu información se muestra solo en el directorio público.\n                </p>\n                <button class=\"mt-4 min-h-[48px] w-full border border-[#CBD5E1] bg-white px-4 py-3 text-[13px] font-semibold text-[#334155]\" data-kid=\"2-3-5-2\" data-name=\"public preview button\">\n                    Vista previa pública\n                </button>\n            </section>\n        </form>\n    </main>\n    <nav aria-label=\"Navegación del taller\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pb-[max(10px,env(safe-area-inset-bottom))] pt-2 backdrop-blur-sm\" data-kid=\"2-4\" data-name=\"mobile bottom navigation\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-5 gap-1\" data-kid=\"2-4-1\" data-name=\"mobile bottom navigation items\">\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-4-1-1\" data-name=\"panel mobile navigation item\" href=\"#panel\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-4-1-1-1\" data-name=\"panel icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-4-1-1-2\" data-name=\"panel label\">\n                    Panel\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-4-1-2\" data-name=\"repairs mobile navigation item\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-4-1-2-1\" data-name=\"repairs icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-4-1-2-2\" data-name=\"repairs label\">\n                    Reparaciones\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-4-1-3\" data-name=\"vehicle search mobile navigation item\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[19px]\" data-kid=\"2-4-1-3-1\" data-name=\"search icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-4-1-3-2\" data-name=\"search label\">\n                    Buscar\n                </span>\n            </a>\n            <a class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-4-1-4\" data-name=\"history mobile navigation item\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-4-1-4-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-4-1-4-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 border-t-2 border-[#1E88E5] text-[#1E88E5]\" data-kid=\"2-4-1-5\" data-name=\"active settings mobile navigation item\" href=\"#configuracion\">\n                <i class=\"ti ti-settings text-[19px]\" data-kid=\"2-4-1-5-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-bold\" data-kid=\"2-4-1-5-2\" data-name=\"settings label\">\n                    Configuración\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
