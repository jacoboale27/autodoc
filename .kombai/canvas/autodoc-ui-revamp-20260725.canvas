      "html": "<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js\">\n</script>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mechanic dashboard page\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"main application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"mechanic icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo initials\">\n                AD\n            </div>\n            <div class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary mechanic navigation\">\n                <button aria-label=\"Panel del taller\" class=\"grid size-11 place-items-center rounded-full bg-[#522C81] text-[20px] text-white shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.10)] active:scale-[0.97]\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard navigation button\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF\">\n                    </i>\n                </button>\n                <button aria-label=\"Reparaciones\" class=\"grid size-11 place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[20px] text-[#5B6B80] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-[#F7F6F8] hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-1-2-2\" data-name=\"repairs navigation button\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-2-1\" data-name=\"tool icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </button>\n                <button aria-label=\"Buscar vehículo\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-3\" data-name=\"vehicle search navigation button\">\n                    <i class=\"ti ti-car-search\" data-kid=\"2-1-1-2-3-1\" data-name=\"car search icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </button>\n                <button aria-label=\"Chat\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-4\" data-name=\"chat navigation button\">\n                    <i class=\"ti ti-message-circle\" data-kid=\"2-1-1-2-4-1\" data-name=\"message icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"utility navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help navigation button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings navigation button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"mechanic contextual sidebar\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"workshop identity\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"taller label\">\n                    Taller\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"workshop status indicator container\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"status dot\">\n                    </span>\n                    <span class=\"font-heading text-[16px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"workshop name\">\n                        Taller Rápido\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-2-1-3\" data-name=\"status text\">\n                    Operación activa\n                </p>\n            </div>\n            <nav aria-label=\"Navegación del taller\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"workshop navigation\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-2.5 text-[14px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-2-1\" data-name=\"panel navigation link\" href=\"#panel\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"2-1-2-2-1-1\" data-name=\"dashboard icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                    </i>\n                    Panel\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-2\" data-name=\"repairs navigation link\" href=\"#reparaciones\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-2-2-2-1\" data-name=\"tool icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Reparaciones\n                    <span class=\"ml-auto text-[11px] font-bold tabular-nums text-[#1E88E5]\" data-kid=\"2-1-2-2-2-2\" data-name=\"active repairs count\">\n                        04\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-3\" data-name=\"vehicle search navigation link\" href=\"#buscar\">\n                    <i class=\"ti ti-car-search\" data-kid=\"2-1-2-2-3-1\" data-name=\"car search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Buscar vehículo\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-4\" data-name=\"history navigation link\" href=\"#historial\">\n                    <i class=\"ti ti-history\" data-kid=\"2-1-2-2-4-1\" data-name=\"history icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Historial\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-5\" data-name=\"reviews navigation link\" href=\"#resenas\">\n                    <i class=\"ti ti-star\" data-kid=\"2-1-2-2-5-1\" data-name=\"star icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Reseñas\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"workshop secondary navigation\">\n                <p class=\"mb-2 px-3 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-3-1\" data-name=\"management label\">\n                    Gestión\n                </p>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-3-2\" data-name=\"catalog navigation link\" href=\"#catalogo\">\n                    <i class=\"ti ti-list-details\" data-kid=\"2-1-2-3-2-1\" data-name=\"list details icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Catálogo\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-3-3\" data-name=\"employees navigation link\" href=\"#empleados\">\n                    <i class=\"ti ti-users\" data-kid=\"2-1-2-3-3-1\" data-name=\"users icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Empleados\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-3-4\" data-name=\"settings navigation link\" href=\"#configuracion\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-2-3-4-1\" data-name=\"settings icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                    </i>\n                    Configuración\n                </a>\n                <div class=\"mt-5 flex items-center gap-3 border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3-5\" data-name=\"user profile section\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3-5-1\" data-name=\"user initials avatar\">\n                        MR\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-3-5-2\" data-name=\"user info container\">\n                        <p class=\"truncate text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-3-5-2-1\" data-name=\"user name\">\n                            María Rodríguez\n                        </p>\n                        <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-2-3-5-2-2\" data-name=\"user role\">\n                            Administradora\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"2-1-3\" data-name=\"mechanic dashboard content\" id=\"panel\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-white px-8\" data-kid=\"2-1-3-1\" data-name=\"top header\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumb navigation\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-1-3-1-1-1\" data-name=\"taller label\">\n                        Taller\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-3-1-1-2\" data-name=\"breadcrumb separator\">\n                        /\n                    </span>\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-1-3\" data-name=\"current page name\">\n                        Panel\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-1-2\" data-name=\"header action items\">\n                    <span class=\"hidden text-[12px] text-[#64748B] lg:block\" data-kid=\"2-1-3-1-2-1\" data-name=\"current date text\">\n                        Sábado, 25 jul 2026\n                    </span>\n                    <button aria-label=\"Notificaciones\" class=\"relative grid min-h-[44px] min-w-[44px] place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-[#F7F6F8] hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-3-1-2-2\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-2-2-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                        </i>\n                        <span class=\"absolute right-[7px] top-[6px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-3-1-2-2-2\" data-name=\"notification indicator dot\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Cambiar a modo oscuro\" class=\"grid min-h-[44px] min-w-[44px] place-items-center rounded-full border border-[#CBD5E1] bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-[#F7F6F8] hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-3-1-2-3\" data-name=\"theme toggle button\">\n                        <i class=\"ti ti-moon\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;color:#64748B\">\n                        </i>\n                    </button>\n                    <div class=\"h-6 w-px bg-[#E2E8F0]\" data-kid=\"2-1-3-1-2-4\" data-name=\"header separator\">\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-1-2-5\" data-name=\"user account display\">\n                        <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-1-2-5-1\" data-name=\"user initials avatar\">\n                            MR\n                        </div>\n                        <span class=\"hidden text-[13px] font-semibold text-[#0F172A] xl:block\" data-kid=\"2-1-3-1-2-5-2\" data-name=\"user name\">\n                            María Rodríguez\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1160px] px-8 py-8\" data-kid=\"2-1-3-2\" data-name=\"dashboard body\">\n                <div class=\"mb-7 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"page heading\">\n                    <div data-kid=\"2-1-3-2-1-1\" data-name=\"title container\">\n                        <h1 class=\"font-heading text-[32px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-1-3-2-1-1-1\" data-name=\"page heading text\">\n                            Panel del taller\n                        </h1>\n                        <p class=\"mt-2 text-[15px] text-[#334155]\" data-kid=\"2-1-3-2-1-1-2\" data-name=\"page description text\">\n                            Una vista clara de las reparaciones que mueven tu día.\n                        </p>\n                    </div>\n                    <button class=\"inline-flex min-h-[48px] items-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#47246F] px-5 py-3 text-[13px] font-semibold text-white shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.10)] active:scale-[0.97]\" data-kid=\"2-1-3-2-1-2\" data-name=\"new repair call-to-action button\">\n                        <i class=\"ti ti-plus\" data-kid=\"2-1-3-2-1-2-1\" data-name=\"plus icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF\">\n                        </i>\n                        Nueva reparación\n                    </button>\n                </div>\n                <section aria-labelledby=\"scoreboard-heading\" data-kid=\"2-1-3-2-2\" data-name=\"operations scoreboard\" id=\"reparaciones\">\n                    <div class=\"mb-3 flex items-end justify-between\" data-kid=\"2-1-3-2-2-1\" data-name=\"scoreboard header\">\n                        <div data-kid=\"2-1-3-2-2-1-1\" data-name=\"scoreboard title container\">\n                            <h2 class=\"font-heading text-[20px] font-bold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-1-3-2-2-1-1-1\" data-name=\"scoreboard title\" id=\"scoreboard-heading\">\n                                Ritmo de operación\n                            </h2>\n                            <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-2-1-1-2\" data-name=\"scoreboard update time\">\n                                Datos del taller actualizados hace 8 min\n                            </p>\n                        </div>\n                        <span class=\"inline-flex items-center gap-2 text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-2-1-2\" data-name=\"operation status indicator\">\n                            <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-3-2-2-1-2-1\" data-name=\"status indicator dot\">\n                            </span>\n                            Operación estable\n                        </span>\n                    </div>\n                    <div class=\"overflow-hidden rounded-[16px] border border-[#CBD5E1]/40 bg-[#EEEDF0] shadow-[0_2px_4px_rgba(0,0,0,0.05)]\" data-kid=\"2-1-3-2-2-2\" data-name=\"scoreboard grid\">\n                        <div class=\"grid grid-cols-6 border-b border-[#E2E8F0] bg-[#EDF2F7] px-5 py-3 text-[10px] font-bold uppercase tracking-[0.13em] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-1\" data-name=\"scoreboard grid header\">\n                            <span data-kid=\"2-1-3-2-2-2-1-1\">\n                                Servicios hoy\n                            </span>\n                            <span data-kid=\"2-1-3-2-2-2-1-2\">\n                                En curso\n                            </span>\n                            <span data-kid=\"2-1-3-2-2-2-1-3\">\n                                Pendientes\n                            </span>\n                            <span data-kid=\"2-1-3-2-2-2-1-4\">\n                                Ingresos del mes\n                            </span>\n                            <span data-kid=\"2-1-3-2-2-2-1-5\">\n                                Tiempo medio\n                            </span>\n                            <span data-kid=\"2-1-3-2-2-2-1-6\">\n                                Satisfacción\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-6 items-end px-5 py-5\" data-kid=\"2-1-3-2-2-2-2\" data-name=\"scoreboard grid values\">\n                            <div data-kid=\"2-1-3-2-2-2-2-1\" data-name=\"services today stat container\">\n                                <strong class=\"font-heading text-[26px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-1-3-2-2-2-2-1-1\" data-name=\"services today value\">\n                                    12\n                                </strong>\n                                <p class=\"mt-1 text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-2-2-2-1-2\" data-name=\"services today trend\">\n                                    +3 vs. ayer\n                                </p>\n                            </div>\n                            <div data-kid=\"2-1-3-2-2-2-2-2\" data-name=\"in progress stat container\">\n                                <strong class=\"font-heading text-[26px] font-bold tabular-nums text-[#1E88E5]\" data-kid=\"2-1-3-2-2-2-2-2-1\" data-name=\"in progress value\">\n                                    4\n                                </strong>\n                                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-2-2-2\" data-name=\"in progress description\">\n                                    2 entregas hoy\n                                </p>\n                            </div>\n                            <div data-kid=\"2-1-3-2-2-2-2-3\" data-name=\"pending stat container\">\n                                <strong class=\"font-heading text-[26px] font-bold tabular-nums text-[#F59E0B]\" data-kid=\"2-1-3-2-2-2-2-3-1\" data-name=\"pending value\">\n                                    7\n                                </strong>\n                                <p class=\"mt-1 text-[11px] font-semibold text-[#B45309]\" data-kid=\"2-1-3-2-2-2-2-3-2\" data-name=\"pending description\">\n                                    3 requieren acción\n                                </p>\n                            </div>\n                            <div data-kid=\"2-1-3-2-2-2-2-4\" data-name=\"monthly revenue stat container\">\n                                <strong class=\"font-heading text-[22px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-1-3-2-2-2-2-4-1\" data-name=\"monthly revenue value\">\n                                    $8,420\n                                </strong>\n                                <p class=\"mt-1 text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-2-2-2-4-2\" data-name=\"monthly revenue trend\">\n                                    +8.4% mensual\n                                </p>\n                            </div>\n                            <div data-kid=\"2-1-3-2-2-2-2-5\" data-name=\"average time stat container\">\n                                <strong class=\"font-heading text-[22px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-1-3-2-2-2-2-5-1\" data-name=\"average time value\">\n                                    2 h 15 min\n                                </strong>\n                                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-2-5-2\" data-name=\"average time description\">\n                                    objetivo 2 h\n                                </p>\n                            </div>\n                            <div data-kid=\"2-1-3-2-2-2-2-6\" data-name=\"satisfaction stat container\">\n                                <strong class=\"font-heading text-[26px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-1-3-2-2-2-2-6-1\" data-name=\"satisfaction value\">\n                                    4.8\n                                    <span class=\"text-[15px] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-2-6-1-1\" data-name=\"satisfaction base scale\">\n                                        /5\n                                    </span>\n                                </strong>\n                                <p class=\"mt-1 text-[11px] font-semibold text-[#F59E0B]\" data-kid=\"2-1-3-2-2-2-2-6-2\" data-name=\"satisfaction description\">\n                                    86 reseñas\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <div class=\"mt-8 grid gap-8 xl:grid-cols-[minmax(0,1.35fr)_minmax(310px,0.65fr)]\" data-kid=\"2-1-3-2-3\" data-name=\"operations details\">\n                    <section aria-labelledby=\"income-heading\" class=\"overflow-hidden rounded-[16px] border border-[#CBD5E1]/40 bg-[#EEEDF0] px-5 py-5 shadow-[0_2px_4px_rgba(0,0,0,0.05)]\" data-kid=\"2-1-3-2-3-1\" data-name=\"income trend panel container\">\n                        <div class=\"flex items-start justify-between\" data-kid=\"2-1-3-2-3-1-1\" data-name=\"income header\">\n                            <div data-kid=\"2-1-3-2-3-1-1-1\" data-name=\"income title container\">\n                                <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.02em] text-[#0F172A]\" data-kid=\"2-1-3-2-3-1-1-1-1\" data-name=\"income title\" id=\"income-heading\">\n                                    Ingresos últimos 7 días\n                                </h2>\n                                <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-1-1-2\" data-name=\"income description\">\n                                    La línea muestra facturación registrada por día.\n                                </p>\n                            </div>\n                            <span class=\"font-heading text-[18px] font-bold tabular-nums text-[#1E88E5]\" data-kid=\"2-1-3-2-3-1-1-2\" data-name=\"income total value\">\n                                $2,184\n                            </span>\n                        </div>\n                        <div class=\"mt-5 h-[220px]\" data-kid=\"2-1-3-2-3-1-2\" data-name=\"chart container\">\n                            <canvas aria-label=\"Gráfica de ingresos últimos siete días\" data-dynamic=\"true\" data-kid=\"2-1-3-2-3-1-2-1\" data-name=\"income chart\" data-reason=\"rendered by Chart.js\" id=\"mechanic-income-chart\">\n                            </canvas>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"active-repairs-heading\" class=\"overflow-hidden rounded-[16px] border border-[#CBD5E1]/40 bg-[#EEEDF0] shadow-[0_2px_4px_rgba(0,0,0,0.05)]\" data-kid=\"2-1-3-2-3-2\" data-name=\"active repairs queue panel\">\n                        <div class=\"flex items-center justify-between border-b border-[#E2E8F0] px-5 py-5\" data-kid=\"2-1-3-2-3-2-1\" data-name=\"queue header\">\n                            <div data-kid=\"2-1-3-2-3-2-1-1\" data-name=\"queue title container\">\n                                <h2 class=\"font-heading text-[18px] font-bold tracking-[-0.02em] text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-1-1-1\" data-name=\"queue title\" id=\"active-repairs-heading\">\n                                    Reparaciones activas\n                                </h2>\n                                <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-2-1-1-2\" data-name=\"queue description\">\n                                    Cola priorizada del taller\n                                </p>\n                            </div>\n                            <span class=\"text-[12px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-1-2\" data-name=\"active count badge\">\n                                4 abiertas\n                            </span>\n                        </div>\n                        <div class=\"divide-y divide-[#E2E8F0]\" data-kid=\"2-1-3-2-3-2-2\" data-name=\"repairs list\">\n                            <div class=\"px-5 py-4\" data-kid=\"2-1-3-2-3-2-2-1\" data-name=\"repair item 1\">\n                                <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-1-3-2-3-2-2-1-1\" data-name=\"item title container\">\n                                    <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-2-1-1-1\" data-name=\"repair vehicle name\">\n                                        Toyota Corolla\n                                    </p>\n                                    <span class=\"inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-2-1-1-2\" data-name=\"repair status badge\">\n                                        <span class=\"size-1.5 rounded-full bg-[#1E88E5]\" data-kid=\"2-1-3-2-3-2-2-1-1-2-1\" data-name=\"status dot\">\n                                        </span>\n                                        En curso\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2-1-2\" data-name=\"repair details text\">\n                                    P 482-916 · Cambio de aceite\n                                </p>\n                            </div>\n                            <div class=\"px-5 py-4\" data-kid=\"2-1-3-2-3-2-2-2\" data-name=\"repair item 2\">\n                                <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-1-3-2-3-2-2-2-1\" data-name=\"item title container\">\n                                    <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-2-2-1-1\" data-name=\"repair vehicle name\">\n                                        Mazda 3\n                                    </p>\n                                    <span class=\"inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#B45309]\" data-kid=\"2-1-3-2-3-2-2-2-1-2\" data-name=\"repair status badge\">\n                                        <span class=\"size-1.5 rounded-full bg-[#F59E0B]\" data-kid=\"2-1-3-2-3-2-2-2-1-2-1\" data-name=\"status dot\">\n                                        </span>\n                                        Esperando aprobación\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2-2-2\" data-name=\"repair details text\">\n                                    H 731-204 · Frenos\n                                </p>\n                            </div>\n                            <div class=\"px-5 py-4\" data-kid=\"2-1-3-2-3-2-2-3\" data-name=\"repair item 3\">\n                                <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-1-3-2-3-2-2-3-1\" data-name=\"item title container\">\n                                    <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-3-2-2-3-1-1\" data-name=\"repair vehicle name\">\n                                        Renault Duster\n                                    </p>\n                                    <span class=\"inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#B91C1C]\" data-kid=\"2-1-3-2-3-2-2-3-1-2\" data-name=\"repair status badge\">\n                                        <span class=\"size-1.5 rounded-full bg-[#EF4444]\" data-kid=\"2-1-3-2-3-2-2-3-1-2-1\" data-name=\"status dot\">\n                                        </span>\n                                        Prioridad alta\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[11px] tabular-nums text-[#64748B]\" data-kid=\"2-1-3-2-3-2-2-3-2\" data-name=\"repair details text\">\n                                    J 204-118 · Diagnóstico\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"m-5 inline-flex items-center gap-2 text-[12px] font-bold text-[#1E88E5] hover:text-[#176FBB]\" data-kid=\"2-1-3-2-3-2-3\" data-name=\"view all repairs button\">\n                            Ver reparaciones\n                            <i class=\"ti ti-arrow-right\" data-kid=\"2-1-3-2-3-2-3-1\" data-name=\"arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                            </i>\n                        </button>\n                    </section>\n                </div>\n                <section aria-labelledby=\"quick-heading\" class=\"mt-8 border-t border-[#CBD5E1] pt-6\" data-kid=\"2-1-3-2-4\" data-name=\"quick actions section\">\n                    <div class=\"flex items-end justify-between\" data-kid=\"2-1-3-2-4-1\" data-name=\"quick actions header\">\n                        <div data-kid=\"2-1-3-2-4-1-1\" data-name=\"header title container\">\n                            <h2 class=\"font-heading text-[20px] font-bold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-1-3-2-4-1-1-1\" data-name=\"quick actions title\" id=\"quick-heading\">\n                                Accesos rápidos\n                            </h2>\n                            <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-4-1-1-2\" data-name=\"quick actions description\">\n                                Herramientas para resolver la siguiente tarea sin salir del panel.\n                            </p>\n                        </div>\n                        <a class=\"inline-flex items-center gap-1 text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-4-1-2\" data-name=\"configure panel link\" href=\"#configuracion\">\n                            Configurar panel\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"2-1-3-2-4-1-2-1\" data-name=\"arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-3 divide-x divide-[#CBD5E1] overflow-hidden rounded-[16px] border border-[#CBD5E1]/40 bg-[#EEEDF0] shadow-[0_2px_4px_rgba(0,0,0,0.05)]\" data-kid=\"2-1-3-2-4-2\" data-name=\"quick actions grid container\">\n                        <a class=\"flex items-center gap-3 px-5 py-4 text-[13px] font-semibold text-[#0F172A] hover:bg-[#F8FAFC]\" data-kid=\"2-1-3-2-4-2-1\" data-name=\"quick action button 1\" href=\"#buscar\">\n                            <span class=\"text-[20px]\" data-kid=\"2-1-3-2-4-2-1-1\" data-name=\"icon wrapper\">\n                                <i class=\"ti ti-car-search\" data-kid=\"2-1-3-2-4-2-1-1-1\" data-name=\"car search icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                                </i>\n                            </span>\n                            Buscar vehículo\n                            <i class=\"ti ti-arrow-up-right ml-auto\" data-kid=\"2-1-3-2-4-2-1-2\" data-name=\"arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                            </i>\n                        </a>\n                        <a class=\"flex items-center gap-3 px-5 py-4 text-[13px] font-semibold text-[#0F172A] hover:bg-[#F8FAFC]\" data-kid=\"2-1-3-2-4-2-2\" data-name=\"quick action button 2\" href=\"#catalogo\">\n                            <span class=\"text-[20px]\" data-kid=\"2-1-3-2-4-2-2-1\" data-name=\"icon wrapper\">\n                                <i class=\"ti ti-list-details\" data-kid=\"2-1-3-2-4-2-2-1-1\" data-name=\"list details icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                                </i>\n                            </span>\n                            Catálogo de servicios\n                            <i class=\"ti ti-arrow-up-right ml-auto\" data-kid=\"2-1-3-2-4-2-2-2\" data-name=\"arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                            </i>\n                        </a>\n                        <a class=\"flex items-center gap-3 px-5 py-4 text-[13px] font-semibold text-[#0F172A] hover:bg-[#F8FAFC]\" data-kid=\"2-1-3-2-4-2-3\" data-name=\"quick action button 3\" href=\"#historial\">\n                            <span class=\"text-[20px]\" data-kid=\"2-1-3-2-4-2-3-1\" data-name=\"icon wrapper\">\n                                <i class=\"ti ti-history\" data-kid=\"2-1-3-2-4-2-3-1-1\" data-name=\"history icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;color:#1E88E5\">\n                                </i>\n                            </span>\n                            Historial\n                            <i class=\"ti ti-arrow-up-right ml-auto\" data-kid=\"2-1-3-2-4-2-3-2\" data-name=\"arrow icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center;color:#94A3B8\">\n                            </i>\n                        </a>\n                    </div>\n                </section>\n                <p class=\"mt-7 pb-2 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-5\" data-name=\"footer credits\">\n                    AutoDoc · Gestión operativa del taller · Datos sincronizados hace 8 min\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n<script>\n    const chartCanvas = document.getElementById('mechanic-income-chart');\n  if (chartCanvas && window.Chart) {\n    new Chart(chartCanvas, {\n      type: 'line',\n      data: { labels: ['L', 'M', 'X', 'J', 'V', 'S', 'D'], datasets: [{ data: [210, 320, 280, 460, 390, 520, 490], borderColor: '#1E88E5', backgroundColor: 'rgba(30,136,229,0.10)', borderWidth: 3, pointBackgroundColor: '#10B981', pointBorderColor: '#FFFFFF', pointBorderWidth: 2, pointRadius: 4, fill: true, tension: 0.35 }] },\n      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { displayColors: false, callbacks: { label: (context) => '$' + context.parsed.y } } }, scales: { x: { grid: { display: false }, ticks: { color: '#64748B', font: { family: 'IBM Plex Sans', size: 12, weight: '600' } } }, y: { beginAtZero: true, grid: { color: '#E2E8F0' }, border: { display: false }, ticks: { color: '#64748B', font: { family: 'IBM Plex Sans', size: 10 }, callback: (value) => '$' + value } } } }\n    });\n  }\n</script>\n",
