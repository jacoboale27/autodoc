    },
    "var_f0cb0c8de5de": {
      "type": "variant",
      "label": "AutoDoc Profile Setup — Hadrian Light",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 105735,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .profile-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .profile-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"profile-body min-h-screen overflow-x-hidden bg-[#F7F6F8] text-[#0F172A] antialiased\" data-kid=\"1\" data-name=\"profile setup light page\">\n    <header class=\"sticky top-0 z-20 border-b border-[#CBD5E1]/80 bg-[#F7F6F8]/90 px-10 py-4 backdrop-blur-xl\" data-kid=\"1-1\" data-name=\"translucent AutoDoc top bar\">\n        <div class=\"mx-auto flex min-h-[48px] max-w-[1200px] items-center justify-between gap-6\" data-kid=\"1-1-1\" data-name=\"top bar content\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand identity\">\n                <div class=\"flex size-11 shrink-0 items-center justify-center rounded-[14px] bg-[#522C81] text-white shadow-[0_8px_18px_rgba(82,44,129,0.18)]\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\">\n                    <i class=\"ti ti-car text-[21px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand car icon\" style=\"width:21px;height:21px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"brand text wrapper\">\n                    <div class=\"profile-heading truncate text-[17px] font-extrabold tracking-[-0.04em] text-[#0F172A]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand title\">\n                        AutoDoc\n                    </div>\n                    <div class=\"text-[11px] font-medium uppercase tracking-[0.14em] text-[#5B6B80]\" data-kid=\"1-1-1-1-2-2\" data-name=\"profile setup context\">\n                        Configuración de perfil\n                    </div>\n                </div>\n            </div>\n            <button aria-label=\"Salir\" class=\"flex min-h-[48px] min-w-[48px] items-center justify-center gap-2 rounded-full border border-[#CBD5E1] bg-[#EEEDF0] px-4 text-[13px] font-semibold text-[#5B6B80] shadow-[0_2px_4px_rgba(15,23,42,0.05)] transition duration-150 ease-out hover:border-[#522C81] hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"1-1-1-2\" data-name=\"logout button\">\n                <i class=\"ti ti-logout-2 text-[18px]\" data-kid=\"1-1-1-2-1\" data-name=\"logout icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"logout text\">\n                    Salir\n                </span>\n            </button>\n        </div>\n    </header>\n    <main class=\"relative mx-auto flex w-full max-w-[1200px] justify-center px-10 pb-[132px] pt-10\" data-kid=\"1-2\" data-name=\"profile setup content\">\n        <div class=\"pointer-events-none absolute -left-40 top-12 size-[360px] rounded-full opacity-40\" data-kid=\"1-2-1\" data-name=\"primary ambient decoration\" style=\"background:radial-gradient(circle,rgba(82,44,129,0.10) 0%,rgba(82,44,129,0.025) 48%,transparent 72%)\">\n        </div>\n        <div class=\"pointer-events-none absolute -right-36 bottom-8 size-[420px] rounded-full opacity-45\" data-kid=\"1-2-2\" data-name=\"secondary ambient decoration\" style=\"background:radial-gradient(circle,rgba(129,230,217,0.14) 0%,rgba(129,230,217,0.03) 48%,transparent 72%)\">\n        </div>\n        <section class=\"relative z-10 w-full max-w-[720px] rounded-[20px] border border-[#CBD5E1] bg-[#EEEDF0] p-8 shadow-[0_16px_36px_rgba(15,23,42,0.08)]\" data-kid=\"1-2-3\" data-name=\"profile setup form card\">\n            <div class=\"border-b border-[#CBD5E1] pb-7\" data-kid=\"1-2-3-1\" data-name=\"welcome header\">\n                <div class=\"mb-4 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[#522C81]\" data-kid=\"1-2-3-1-1\" data-name=\"setup eyebrow\">\n                    <span class=\"size-2 rounded-full bg-[#48BB78]\" data-kid=\"1-2-3-1-1-1\" data-name=\"setup status dot\">\n                    </span>\n                    Tu espacio personal\n                </div>\n                <h1 class=\"profile-heading text-[30px] font-extrabold leading-[1.12] tracking-[-0.045em] text-[#0F172A]\" data-kid=\"1-2-3-1-2\" data-name=\"welcome heading\">\n                    ¡Bienvenido a AutoDoc!\n                </h1>\n                <p class=\"mt-3 max-w-[600px] text-[15px] leading-6 text-[#5B6B80]\" data-kid=\"1-2-3-1-3\" data-name=\"welcome description\">\n                    Configura tu perfil para obtener diagnósticos personalizados y alertas precisas para tu vehículo.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-5 border-b border-[#CBD5E1] py-7\" data-kid=\"1-2-3-2\" data-name=\"profile photo section\">\n                <div class=\"relative\" data-kid=\"1-2-3-2-1\" data-name=\"profile photo picker\">\n                    <div class=\"flex size-[104px] items-center justify-center overflow-hidden rounded-full border-[3px] border-[#522C81]/60 bg-[#522C81]/10 text-[#522C81] shadow-[0_8px_18px_rgba(82,44,129,0.14)]\" data-kid=\"1-2-3-2-1-1\" data-name=\"profile avatar placeholder\">\n                        <i class=\"ti ti-user text-[52px]\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"profile avatar icon\" style=\"width:52px;height:52px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <button aria-label=\"Elegir foto de perfil\" class=\"absolute bottom-0 right-0 flex size-12 items-center justify-center rounded-full border-2 border-[#EEEDF0] bg-[#522C81] text-white shadow-[0_6px_14px_rgba(15,23,42,0.18)] transition duration-150 ease-out hover:scale-[1.02] active:scale-[0.97]\" data-kid=\"1-2-3-2-1-2\" data-name=\"choose profile photo button\">\n                        <i class=\"ti ti-camera text-[19px]\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"camera icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <div data-kid=\"1-2-3-2-2\" data-name=\"photo instructions\">\n                    <div class=\"profile-heading text-[16px] font-bold text-[#0F172A]\" data-kid=\"1-2-3-2-2-1\" data-name=\"photo title\">\n                        Foto de perfil\n                    </div>\n                    <p class=\"mt-1 max-w-[390px] text-[13px] leading-5 text-[#5B6B80]\" data-kid=\"1-2-3-2-2-2\" data-name=\"photo description\">\n                        Añade una imagen para que tu espacio se sienta más personal.\n                    </p>\n                </div>\n            </div>\n            <div class=\"pt-7\" data-kid=\"1-2-3-3\" data-name=\"profile form fields\">\n                <label class=\"block text-[11px] font-bold uppercase tracking-[0.16em] text-[#5B6B80]\" data-kid=\"1-2-3-3-1\" data-name=\"full name label\">\n                    NOMBRE COMPLETO\n                </label>\n                <div class=\"mt-3 flex min-h-[56px] items-center gap-3 rounded-[14px] border border-[#CBD5E1] bg-[#F7F6F8] px-4 shadow-[0_1px_2px_rgba(15,23,42,0.03)]\" data-kid=\"1-2-3-3-2\" data-name=\"full name input\">\n                    <i class=\"ti ti-user text-[20px] text-[#5B6B80]\" data-kid=\"1-2-3-3-2-1\" data-name=\"full name icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"text-[15px] text-[#5B6B80]\" data-kid=\"1-2-3-3-2-2\" data-name=\"full name placeholder\">\n                        Ej. Juan Pérez\n                    </span>\n                </div>\n                <div class=\"mt-8\" data-kid=\"1-2-3-3-3\" data-name=\"role selection section\">\n                    <div class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[#5B6B80]\" data-kid=\"1-2-3-3-3-1\" data-name=\"role label\">\n                        SELECCIONA TU ROL\n                    </div>\n                    <div class=\"mt-3 grid grid-cols-2 gap-4\" data-kid=\"1-2-3-3-3-2\" data-name=\"role options group\">\n                        <button aria-pressed=\"true\" class=\"flex min-h-[116px] flex-col items-start justify-between rounded-[16px] border-2 border-[#522C81] bg-[#522C81]/10 p-5 text-left shadow-[0_4px_10px_rgba(82,44,129,0.08)]\" data-kid=\"1-2-3-3-3-2-1\" data-name=\"selected owner role option\">\n                            <span class=\"flex size-10 items-center justify-center rounded-full bg-[#522C81] text-white\" data-kid=\"1-2-3-3-3-2-1-1\" data-name=\"owner role icon container\">\n                                <i class=\"ti ti-check text-[19px]\" data-kid=\"1-2-3-3-3-2-1-1-1\" data-name=\"selected check icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                            <span class=\"profile-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"1-2-3-3-3-2-1-2\" data-name=\"owner role label\">\n                                Propietario\n                            </span>\n                        </button>\n                        <button aria-pressed=\"false\" class=\"flex min-h-[116px] flex-col items-start justify-between rounded-[16px] border border-[#CBD5E1] bg-[#F7F6F8] p-5 text-left shadow-[0_2px_4px_rgba(15,23,42,0.04)] transition duration-150 ease-out hover:border-[#522C81] active:scale-[0.98]\" data-kid=\"1-2-3-3-3-2-2\" data-name=\"mechanic role option\">\n                            <span class=\"flex size-10 items-center justify-center rounded-full bg-[#E2E8F0] text-[#5B6B80]\" data-kid=\"1-2-3-3-3-2-2-1\" data-name=\"mechanic role icon container\">\n                                <i class=\"ti ti-tool text-[19px]\" data-kid=\"1-2-3-3-3-2-2-1-1\" data-name=\"mechanic role icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </span>\n                            <span class=\"profile-heading text-[15px] font-bold text-[#5B6B80]\" data-kid=\"1-2-3-3-3-2-2-2\" data-name=\"mechanic role label\">\n                                Mecánico\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"mt-4 flex items-start gap-3 rounded-[14px] border border-[#522C81]/30 bg-[#522C81]/[0.08] p-4\" data-kid=\"1-2-3-3-3-3\" data-name=\"selected role explanation\">\n                        <i class=\"ti ti-info-circle mt-0.5 shrink-0 text-[20px] text-[#522C81]\" data-kid=\"1-2-3-3-3-3-1\" data-name=\"role explanation icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <p class=\"text-[13px] leading-5 text-[#0F172A]\" data-kid=\"1-2-3-3-3-3-2\" data-name=\"owner role explanation\">\n                            Como propietario, podrás agregar vehículos a tu garaje virtual y dar seguimiento a sus mantenimientos.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-8\" data-kid=\"1-2-3-3-4\" data-name=\"preferences section\">\n                    <div class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[#5B6B80]\" data-kid=\"1-2-3-3-4-1\" data-name=\"preferences label\">\n                        PREFERENCIAS\n                    </div>\n                    <div class=\"mt-3 flex min-h-[88px] items-center gap-4 rounded-[16px] border border-[#CBD5E1] bg-[#F7F6F8] p-4\" data-kid=\"1-2-3-3-4-2\" data-name=\"maintenance notifications preference\">\n                        <span class=\"flex size-11 shrink-0 items-center justify-center rounded-full bg-[#522C81]/10 text-[#522C81]\" data-kid=\"1-2-3-3-4-2-1\" data-name=\"notifications icon container\">\n                            <i class=\"ti ti-bell-ringing text-[21px]\" data-kid=\"1-2-3-3-4-2-1-1\" data-name=\"maintenance notifications icon\" style=\"width:21px;height:21px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </span>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-2-3-3-4-2-2\" data-name=\"notification copy\">\n                            <div class=\"text-[14px] font-semibold text-[#0F172A]\" data-kid=\"1-2-3-3-4-2-2-1\" data-name=\"notification title\">\n                                Notificaciones de mantenimiento\n                            </div>\n                            <div class=\"mt-1 text-[12px] leading-4 text-[#5B6B80]\" data-kid=\"1-2-3-3-4-2-2-2\" data-name=\"notification description\">\n                                Alertas sobre cambios de aceite, frenos y revisiones.\n                            </div>\n                        </div>\n                        <div aria-checked=\"true\" aria-label=\"Notificaciones de mantenimiento activadas\" class=\"relative h-7 w-12 shrink-0 rounded-full bg-[#522C81]\" data-kid=\"1-2-3-3-4-2-3\" data-name=\"enabled maintenance notifications switch\" role=\"switch\">\n                            <span class=\"absolute right-1 top-1 size-5 rounded-full bg-white shadow-[0_1px_3px_rgba(15,23,42,0.2)]\" data-kid=\"1-2-3-3-4-2-3-1\" data-name=\"switch thumb\">\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-[#F7F6F8]/95 px-10 py-4 shadow-[0_-8px_24px_rgba(15,23,42,0.06)] backdrop-blur-xl\" data-kid=\"1-3\" data-name=\"profile setup action bar\">\n        <div class=\"mx-auto flex max-w-[1200px] items-center justify-between gap-6\" data-kid=\"1-3-1\" data-name=\"action bar content\">\n            <div class=\"hidden text-[12px] text-[#5B6B80] md:block\" data-kid=\"1-3-1-1\" data-name=\"setup completion hint\">\n                Un último paso para personalizar tu experiencia.\n            </div>\n            <button aria-label=\"Finalizar Configuración\" class=\"ml-auto flex min-h-[52px] min-w-[280px] items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#45236F] px-7 text-[14px] font-bold text-white shadow-[0_4px_12px_rgba(82,44,129,0.20)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_8px_20px_rgba(82,44,129,0.24)] active:scale-[0.97]\" data-kid=\"1-3-1-2\" data-name=\"finish profile setup button\">\n                Finalizar Configuración\n                <i class=\"ti ti-arrow-right text-[17px]\" data-kid=\"1-3-1-2-1\" data-name=\"finish arrow icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n        </div>\n    </footer>\n</div>\n",
