rofile alert card\">\n                <div class=\"flex items-start gap-3\" data-kid=\"1-2-4-3-4\">\n                    <div class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#E8F2FD] text-[20px] text-[#1E88E5]\" data-kid=\"1-2-4-3-1\" data-name=\"informational alert icon container\">\n                        <i class=\"ti ti-info-circle\" data-kid=\"1-2-4-3-1-1\" data-name=\"info icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-3-4-2\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-4-3-4-2-1\">\n                            <span class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#176FBB]\" data-kid=\"1-2-4-3-4-2-1-1\" data-name=\"informational status label\">\n                                Informativa\n                            </span>\n                            <span class=\"size-1 rounded-full bg-[#CBD5E1]\" data-kid=\"1-2-4-3-4-2-1-2\">\n                            </span>\n                            <span class=\"text-[11px] font-medium text-[#64748B]\" data-dynamic=\"true\" data-kid=\"1-2-4-3-4-2-1-3\" data-name=\"alert time label\" data-reason=\"relative time string updated by script\">\n                                Hace 2 días\n                            </span>\n                        </div>\n                        <h3 class=\"mt-1 font-heading text-[16px] font-bold leading-5 text-[#0F172A]\" data-kid=\"1-2-4-3-4-2-2\">\n                            Perfil de vehículo incompleto\n                        </h3>\n                        <p class=\"mt-1 text-[13px] text-[#475569]\" data-kid=\"1-2-4-3-4-2-3\">\n                            Renault Duster 2021\n                            <span class=\"text-[#CBD5E1]\" data-kid=\"1-2-4-3-4-2-3-1\">\n                                ·\n                            </span>\n                            J 204-118\n                        </p>\n                        <p class=\"mt-2 text-[13px] font-medium leading-5 text-[#1D4ED8]\" data-kid=\"1-2-4-3-4-2-4\">\n                            Completa la ficha para activar recordatorios de mantenimiento.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-4 border-t border-[#F1F5F9] pt-3\" data-kid=\"1-2-4-3-2\" data-name=\"informational alert action details\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"1-2-4-3-2-1\">\n                        Recomendación\n                    </p>\n                    <p class=\"mt-1 text-[12px] text-[#475569]\" data-kid=\"1-2-4-3-2-2\">\n                        Añadir kilometraje\n                    </p>\n                    <button class=\"mt-3 flex min-h-[44px] w-full items-center justify-center gap-1 bg-[#1E88E5] px-3.5 py-2.5 text-[12px] font-bold text-white\" data-kid=\"1-2-4-3-3\" data-name=\"complete profile button\">\n                        Completar ficha\n                        <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-4-3-3-1\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </article>\n        </section>\n        <div class=\"mt-6 space-y-3 border-t border-[#CBD5E1] pt-4\" data-kid=\"1-2-5\" data-name=\"mobile alerts sync footer\">\n            <span class=\"flex items-center gap-2 text-[12px] text-[#64748B]\" data-dynamic=\"true\" data-kid=\"1-2-5-1\" data-name=\"mobile sync status\" data-reason=\"sync time updated by periodic polling script\">\n                <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"1-2-5-1-1\" data-name=\"sync status indicator dot\">\n                </span>\n                Última sincronización hace 8 min\n            </span>\n            <span class=\"block text-[12px] leading-5 text-[#94A3B8]\" data-kid=\"1-2-5-2\" data-name=\"mobile sync explanation\">\n                Los estados se actualizan con el kilometraje registrado.\n            </span>\n        </div>\n        <p class=\"mt-7 pb-2 text-[11px] text-[#94A3B8]\" data-kid=\"1-2-6\" data-name=\"mobile footer copyright\">\n            AutoDoc · Diagnóstico y mantenimiento vehicular · Datos sincronizados con tu garaje\n        </p>\n    </main>\n    <nav aria-label=\"Navegación móvil\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pt-2 shadow-[0_-4px_18px_rgba(15,23,42,0.08)] backdrop-blur-sm\" data-kid=\"1-3\" data-name=\"mobile bottom navigation\" style=\"padding-bottom:calc(env(safe-area-inset-bottom) + 8px)\">\n        <div class=\"mx-auto grid max-w-[375px] grid-cols-5 gap-1\" data-kid=\"1-3-6\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"1-3-1\" data-name=\"mobile home navigation\" href=\"#inicio\">\n                <i class=\"ti ti-dashboard text-[19px]\" data-kid=\"1-3-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"1-3-1-2\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"1-3-2\" data-name=\"mobile garage navigation\" href=\"#garaje\">\n                <i class=\"ti ti-car text-[19px]\" data-kid=\"1-3-2-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"1-3-2-2\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"1-3-3\" data-name=\"mobile workshops navigation\" href=\"#talleres\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"1-3-3-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"1-3-3-2\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-current=\"page\" aria-label=\"Alertas\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 rounded-lg bg-[#E8F2FD] text-[#1E88E5]\" data-kid=\"1-3-4\" data-name=\"active mobile alerts navigation\" href=\"#alertas\">\n                <span class=\"relative\" data-kid=\"1-3-4-1\">\n                    <i class=\"ti ti-alert-triangle text-[19px]\" data-kid=\"1-3-4-1-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"absolute -right-2 -top-1 grid size-3.5 place-items-center rounded-full bg-[#EF4444] text-[8px] font-bold leading-none text-white\" data-dynamic=\"true\" data-kid=\"1-3-4-1-2\" data-name=\"mobile navigation alerts badge\" data-reason=\"count value updated by data sync script\">\n                        3\n                    </span>\n                </span>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"1-3-4-2\">\n                    Alertas\n                </span>\n            </a>\n            <a aria-label=\"Historial\" class=\"flex min-h-[52px] flex-col items-center justify-center gap-1 rounded-lg text-[#64748B]\" data-kid=\"1-3-5\" data-name=\"mobile history navigation\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"1-3-5-1\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"1-3-5-2\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
