      "html": "<link data-kid=\"1\" data-name=\"Tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"mobile vehicle search shell\">\n    <header class=\"sticky top-0 z-20 flex h-[68px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"mobile workshop top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[16px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc mobile logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"workshop info container\">\n                <p class=\"truncate text-[10px] font-semibold uppercase tracking-[0.12em] text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"workshop label text\">\n                    Taller\n                </p>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"2-1-1-2-2\" data-name=\"workshop status container\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-1-2-2-1\" data-name=\"workshop online status\">\n                    </span>\n                    <span class=\"truncate text-[13px] font-bold text-[#0F172A]\" data-kid=\"2-1-1-2-2-2\" data-name=\"workshop name text\">\n                        Taller Rápido\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header actions\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid min-h-11 min-w-11 place-items-center rounded-full border border-[#CBD5E1]/40 bg-[#EEEDF0] text-[19px] text-[#5B6B80] shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:bg-white hover:text-[#522C81] active:scale-[0.97]\" data-kid=\"2-1-2-1\" data-name=\"mobile notifications button\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"notification bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-[8px] top-[8px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\" data-name=\"notification indicator dot\">\n                </span>\n            </button>\n            <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[11px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-2\" data-name=\"operator avatar\">\n                MR\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[104px] pt-6\" data-kid=\"2-2\" data-name=\"mobile vehicle search page content\" style=\"padding-bottom:calc(104px + env(safe-area-inset-bottom));\">\n        <div class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"mobile search heading\">\n            <div class=\"mb-3 flex items-center gap-2 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"mobile breadcrumb\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"breadcrumb parent text\">\n                    Taller\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"text-[#0F172A]\" data-kid=\"2-2-1-1-3\" data-name=\"breadcrumb current page text\">\n                    Búsqueda\n                </span>\n            </div>\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-1-2\" data-name=\"mobile page header layout\">\n                <div class=\"min-w-0\" data-kid=\"2-2-1-2-1\" data-name=\"mobile page title container\">\n                    <h1 class=\"font-heading text-[27px] font-extrabold leading-[1.1] tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2-1-1\" data-name=\"mobile page title\">\n                        Buscar vehículo\n                    </h1>\n                    <p class=\"mt-2 max-w-[285px] text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-2-1-2\" data-name=\"mobile page subtitle\">\n                        Encuentra el vehículo del cliente para abrir o consultar un servicio.\n                    </p>\n                </div>\n                <button aria-label=\"Escanear QR\" class=\"grid min-h-11 min-w-11 shrink-0 place-items-center border border-[#CBD5E1] bg-white text-[18px] text-[#1E88E5]\" data-kid=\"2-2-1-2-2\" data-name=\"mobile scan qr button\">\n                    <i class=\"ti ti-qrcode\" data-kid=\"2-2-1-2-2-1\" data-name=\"qr code icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <section class=\"overflow-hidden rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] shadow-[0_2px_4px_rgba(0,0,0,0.05)]\" data-kid=\"2-2-2\" data-name=\"mobile primary search section container\">\n            <div class=\"border-b border-[#E2E8F0] px-4 py-4\" data-kid=\"2-2-2-1\" data-name=\"mobile search section header\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-2-1-1\" data-name=\"search section header layout\">\n                    <div data-kid=\"2-2-2-1-1-1\" data-name=\"search section title container\">\n                        <h2 class=\"font-heading text-[17px] font-bold tracking-[-0.02em] text-[#0F172A]\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"search section title\">\n                            Identificar vehículo\n                        </h2>\n                        <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"search section description\">\n                            Busca por placa, marca o nombre del cliente.\n                        </p>\n                    </div>\n                    <span class=\"pt-0.5 text-right text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-2-2-1-1-2\" data-name=\"search type badge\">\n                        Búsqueda\n                        <br data-kid=\"2-2-2-1-1-2-1\" data-name=\"badge break\"/>\n                        segura\n                    </span>\n                </div>\n            </div>\n            <div class=\"space-y-3 p-4\" data-kid=\"2-2-2-2\" data-name=\"mobile search controls\">\n                <label class=\"flex min-h-14 items-center gap-3 border border-[#94A3B8] bg-[#F8FAFC] px-4 focus-within:border-[#1E88E5] focus-within:ring-2 focus-within:ring-[#BFDBFE]\" data-kid=\"2-2-2-2-1\" data-name=\"mobile search field\">\n                    <i class=\"ti ti-search shrink-0 text-[21px] text-[#1E88E5]\" data-kid=\"2-2-2-2-1-1\" data-name=\"search icon\" style=\"width:21px;height:21px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <input aria-label=\"Buscar por placa, marca o cliente\" class=\"min-w-0 flex-1 bg-transparent text-[16px] text-[#0F172A] outline-hidden placeholder:text-[#64748B]\" data-kid=\"2-2-2-2-1-2\" data-name=\"search input field\" placeholder=\"Buscar por placa, marca o cliente\" value=\"P 482-916\"/>\n                    <span class=\"shrink-0 border-l border-[#CBD5E1] pl-3 text-[10px] font-semibold text-[#64748B]\" data-kid=\"2-2-2-2-1-3\" data-name=\"search type indicator\">\n                        Placa\n                    </span>\n                </label>\n                <button class=\"flex min-h-14 w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#522C81] to-[#47256F] px-4 text-[14px] font-bold text-white shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.1)] active:scale-[0.97]\" data-kid=\"2-2-2-2-2\" data-name=\"mobile search submit button\">\n                    <i class=\"ti ti-search text-[18px]\" data-kid=\"2-2-2-2-2-1\" data-name=\"submit search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Buscar\n                </button>\n            </div>\n        </section>\n        <section class=\"mt-7\" data-kid=\"2-2-3\" data-name=\"mobile vehicle results section\">\n            <div class=\"mb-4 flex items-end justify-between gap-3\" data-kid=\"2-2-3-1\" data-name=\"mobile results header\">\n                <div data-kid=\"2-2-3-1-1\" data-name=\"results summary container\">\n                    <h2 class=\"font-heading text-[20px] font-bold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-3-1-1-1\" data-name=\"results title\">\n                        Resultados encontrados\n                    </h2>\n                    <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-2-3-1-1-2\" data-name=\"results count\">\n                        3 vehículos coinciden con la búsqueda\n                    </p>\n                </div>\n                <span class=\"flex shrink-0 items-center gap-1 text-[10px] font-semibold text-[#10B981]\" data-kid=\"2-2-3-1-2\" data-name=\"verification status badge\">\n                    <i class=\"ti ti-check\" data-kid=\"2-2-3-1-2-1\" data-name=\"check icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Verificados\n                </span>\n            </div>\n            <div class=\"space-y-3\" data-kid=\"2-2-3-2\" data-name=\"mobile vehicle results list\">\n                <button class=\"block w-full border-l-4 border-[#1E88E5] border-y border-r border-[#CBD5E1] bg-[#E8F2FD] px-4 py-4 text-left\" data-kid=\"2-2-3-2-1\" data-name=\"selected Corolla mobile result\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-2-1-1\" data-name=\"result top row\">\n                        <span class=\"min-w-0\" data-kid=\"2-2-3-2-1-1-1\" data-name=\"result primary info\">\n                            <span class=\"block truncate text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-2-3-2-1-1-1-1\" data-name=\"result vehicle name\">\n                                Toyota Corolla 2022\n                            </span>\n                            <span class=\"mt-1 block text-[12px] font-semibold tabular-nums tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-1-1-1-2\" data-name=\"result plate number\">\n                                P 482-916\n                            </span>\n                        </span>\n                        <span class=\"flex shrink-0 items-center gap-1.5 text-[11px] font-semibold text-[#F59E0B]\" data-kid=\"2-2-3-2-1-1-2\" data-name=\"result vehicle status\">\n                            <span class=\"size-2 rounded-full bg-[#F59E0B]\" data-kid=\"2-2-3-2-1-1-2-1\" data-name=\"status color indicator\">\n                            </span>\n                            Revisión pronta\n                        </span>\n                    </div>\n                    <div class=\"mt-4 flex items-center justify-between border-t border-[#BFDBFE] pt-3 text-[12px]\" data-kid=\"2-2-3-2-1-2\" data-name=\"result footer row\">\n                        <span class=\"font-medium text-[#334155]\" data-kid=\"2-2-3-2-1-2-1\" data-name=\"result customer name\">\n                            Juan Pérez\n                        </span>\n                        <span class=\"text-[#475569]\" data-kid=\"2-2-3-2-1-2-2\" data-name=\"result last service info\">\n                            Último servicio · 12 jun 2026\n                        </span>\n                    </div>\n                </button>\n                <button class=\"block w-full rounded-[16px] border border-[#CBD5E1] bg-[#EEEDF0] px-4 py-4 text-left shadow-[0_2px_4px_rgba(0,0,0,0.05)] transition duration-150 ease-out hover:border-[#522C81] hover:shadow-[0_6px_14px_rgba(0,0,0,0.1)] active:scale-[0.99]\" data-kid=\"2-2-3-2-2\" data-name=\"Mazda mobile result\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-2-2-1\" data-name=\"Mazda result top row\">\n                        <span class=\"min-w-0\" data-kid=\"2-2-3-2-2-1-1\" data-name=\"Mazda primary info\">\n                            <span class=\"block truncate text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-2-3-2-2-1-1-1\" data-name=\"Mazda vehicle name\">\n                                Mazda 3 2019\n                            </span>\n                            <span class=\"mt-1 block text-[12px] font-semibold tabular-nums tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-2-1-1-2\" data-name=\"Mazda plate number\">\n                                H 731-204\n                            </span>\n                        </span>\n                        <span class=\"flex shrink-0 items-center gap-1.5 text-[11px] font-semibold text-[#10B981]\" data-kid=\"2-2-3-2-2-1-2\" data-name=\"Mazda status\">\n                            <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-2-3-2-2-1-2-1\" data-name=\"Mazda status indicator\">\n                            </span>\n                            Óptimo\n                        </span>\n                    </div>\n                    <div class=\"mt-4 flex items-center justify-between border-t border-[#E2E8F0] pt-3 text-[12px]\" data-kid=\"2-2-3-2-2-2\" data-name=\"Mazda result footer\">\n                        <span class=\"font-medium text-[#334155]\" data-kid=\"2-2-3-2-2-2-1\" data-name=\"Mazda customer name\">\n                            Laura Gómez\n                        </span>\n                        <span class=\"text-[#475569]\" data-kid=\"2-2-3-2-2-2-2\" data-name=\"Mazda service info\">\n                            Último servicio · 02 jun 2026\n                        </span>\n                    </div>\n                </button>\n                <button class=\"block w-full border border-[#CBD5E1] bg-white px-4 py-4 text-left\" data-kid=\"2-2-3-2-3\" data-name=\"Renault mobile result\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-3-2-3-1\" data-name=\"Renault result top row\">\n                        <span class=\"min-w-0\" data-kid=\"2-2-3-2-3-1-1\" data-name=\"Renault primary info\">\n                            <span class=\"block truncate text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-2-3-2-3-1-1-1\" data-name=\"Renault vehicle name\">\n                                Renault Duster 2021\n                            </span>\n                            <span class=\"mt-1 block text-[12px] font-semibold tabular-nums tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-3-2-3-1-1-2\" data-name=\"Renault plate number\">\n                                J 204-118\n                            </span>\n                        </span>\n                        <span class=\"flex shrink-0 items-center gap-1.5 text-[11px] font-semibold text-[#1E88E5]\" data-kid=\"2-2-3-2-3-1-2\" data-name=\"Renault status\">\n                            <span class=\"size-2 rounded-full bg-[#1E88E5]\" data-kid=\"2-2-3-2-3-1-2-1\" data-name=\"Renault status indicator\">\n                            </span>\n                            Sin datos\n                        </span>\n                    </div>\n                    <div class=\"mt-4 flex items-center justify-between border-t border-[#E2E8F0] pt-3 text-[12px]\" data-kid=\"2-2-3-2-3-2\" data-name=\"Renault result footer\">\n                        <span class=\"font-medium text-[#334155]\" data-kid=\"2-2-3-2-3-2-1\" data-name=\"Renault customer name\">\n                            Andrés Ruiz\n                        </span>\n                        <span class=\"text-[#64748B]\" data-kid=\"2-2-3-2-3-2-2\" data-name=\"Renault history status\">\n                            Sin historial\n                        </span>\n                    </div>\n                </button>\n            </div>\n            <div class=\"mt-5 border border-dashed border-[#CBD5E1] bg-white px-4 py-4\" data-kid=\"2-2-3-3\" data-name=\"mobile recent searches empty state\">\n                <div class=\"flex items-start gap-3\" data-kid=\"2-2-3-3-1\" data-name=\"empty state content container\">\n                    <span class=\"grid size-10 shrink-0 place-items-center bg-[#F1F5F9] text-[#64748B]\" data-kid=\"2-2-3-3-1-1\" data-name=\"history icon container\">\n                        <i class=\"ti ti-history text-[18px]\" data-kid=\"2-2-3-3-1-1-1\" data-name=\"history icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div data-kid=\"2-2-3-3-1-2\" data-name=\"empty state text container\">\n                        <p class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-2-3-3-1-2-1\" data-name=\"empty state title\">\n                            Búsquedas recientes\n                        </p>\n                        <p class=\"mt-1 text-[12px] leading-4 text-[#64748B]\" data-kid=\"2-2-3-3-1-2-2\" data-name=\"empty state description\">\n                            Aún no hay búsquedas recientes. Las placas consultadas aparecerán aquí.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <aside class=\"mt-7 border border-[#CBD5E1] bg-white\" data-kid=\"2-2-4\" data-name=\"mobile selected vehicle detail panel\">\n            <div class=\"border-b border-[#E2E8F0] px-4 py-5\" data-kid=\"2-2-4-1\" data-name=\"mobile selected vehicle header\">\n                <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-2-4-1-1\" data-name=\"header top row\">\n                    <span class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#1E88E5]\" data-kid=\"2-2-4-1-1-1\" data-name=\"header status label\">\n                        Vehículo encontrado\n                    </span>\n                    <button aria-label=\"Cerrar detalle\" class=\"grid min-h-11 min-w-11 place-items-center text-[18px] text-[#64748B]\" data-kid=\"2-2-4-1-1-2\" data-name=\"close detail button\">\n                        <i class=\"ti ti-x\" data-kid=\"2-2-4-1-1-2-1\" data-name=\"close icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n                <h2 class=\"mt-3 font-heading text-[22px] font-extrabold tracking-[-0.035em] text-[#0F172A]\" data-kid=\"2-2-4-1-2\" data-name=\"selected vehicle title\">\n                    Toyota Corolla 2022\n                </h2>\n                <p class=\"mt-1 text-[12px] font-semibold tabular-nums tracking-[0.12em] text-[#64748B]\" data-kid=\"2-2-4-1-3\" data-name=\"selected vehicle plate and owner\">\n                    P 482-916 · Juan Pérez\n                </p>\n            </div>\n            <div class=\"px-4 py-5\" data-kid=\"2-2-4-2\" data-name=\"mobile selected vehicle details\">\n                <div class=\"grid grid-cols-2 gap-4 border-b border-[#E2E8F0] pb-5\" data-kid=\"2-2-4-2-1\" data-name=\"details grid\">\n                    <div data-kid=\"2-2-4-2-1-1\" data-name=\"mileage column\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-4-2-1-1-1\" data-name=\"mileage label\">\n                            Kilometraje\n                        </p>\n                        <p class=\"mt-2 font-heading text-[23px] font-bold tabular-nums text-[#0F172A]\" data-kid=\"2-2-4-2-1-1-2\" data-name=\"mileage value\">\n                            48,260\n                            <span class=\"font-body text-[12px] text-[#64748B]\" data-kid=\"2-2-4-2-1-1-2-1\" data-name=\"mileage unit\">\n                                km\n                            </span>\n                        </p>\n                    </div>\n                    <div data-kid=\"2-2-4-2-1-2\" data-name=\"last service column\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-4-2-1-2-1\" data-name=\"last service label\">\n                            Último servicio\n                        </p>\n                        <p class=\"mt-2 text-[14px] font-bold text-[#0F172A]\" data-kid=\"2-2-4-2-1-2-2\" data-name=\"last service date\">\n                            12 jun 2026\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-5\" data-kid=\"2-2-4-2-2\" data-name=\"mobile vehicle active alerts\">\n                    <div class=\"mb-3 flex items-center justify-between\" data-kid=\"2-2-4-2-2-1\" data-name=\"alerts header\">\n                        <h3 class=\"font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-2-4-2-2-1-1\" data-name=\"alerts title\">\n                            Alertas activas\n                        </h3>\n                        <span class=\"text-[11px] font-semibold text-[#EF4444]\" data-kid=\"2-2-4-2-2-1-2\" data-name=\"pending alerts count\">\n                            2 pendientes\n                        </span>\n                    </div>\n                    <div class=\"border-y border-[#E2E8F0]\" data-kid=\"2-2-4-2-2-2\" data-name=\"alerts list\">\n                        <div class=\"flex items-start gap-3 border-b border-[#E2E8F0] py-4\" data-kid=\"2-2-4-2-2-2-1\" data-name=\"soat alert item\">\n                            <i class=\"ti ti-alert-triangle mt-0.5 shrink-0 text-[18px] text-[#EF4444]\" data-kid=\"2-2-4-2-2-2-1-1\" data-name=\"soat alert icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <div data-kid=\"2-2-4-2-2-2-1-2\" data-name=\"soat text container\">\n                                <p class=\"text-[13px] font-semibold text-[#991B1B]\" data-kid=\"2-2-4-2-2-2-1-2-1\" data-name=\"soat title\">\n                                    SOAT vencido\n                                </p>\n                                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-2-2-1-2-2\" data-name=\"soat description\">\n                                    Renovar antes de circular\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-start gap-3 py-4\" data-kid=\"2-2-4-2-2-2-2\" data-name=\"brakes alert item\">\n                            <i class=\"ti ti-tool mt-0.5 shrink-0 text-[18px] text-[#F59E0B]\" data-kid=\"2-2-4-2-2-2-2-1\" data-name=\"brakes alert icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            <div data-kid=\"2-2-4-2-2-2-2-2\" data-name=\"brakes text container\">\n                                <p class=\"text-[13px] font-semibold text-[#A16207]\" data-kid=\"2-2-4-2-2-2-2-2-1\" data-name=\"brakes title\">\n                                    Frenos próximos\n                                </p>\n                                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-2-4-2-2-2-2-2-2\" data-name=\"brakes description\">\n                                    Revisar en 420 km\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-6 flex flex-col gap-3\" data-kid=\"2-2-4-2-3\" data-name=\"action buttons container\">\n                    <button class=\"inline-flex min-h-12 w-full items-center justify-center gap-2 bg-[#1E88E5] px-4 text-[13px] font-bold text-white\" data-kid=\"2-2-4-2-3-1\" data-name=\"mobile start service button\">\n                        Iniciar servicio\n                        <i class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"2-2-4-2-3-1-1\" data-name=\"start service icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <button class=\"inline-flex min-h-12 w-full items-center justify-center gap-2 border border-[#CBD5E1] px-4 text-[13px] font-bold text-[#1E88E5]\" data-kid=\"2-2-4-2-3-2\" data-name=\"mobile view history button\">\n                        Ver historial\n                        <i class=\"ti ti-history text-[16px]\" data-kid=\"2-2-4-2-3-2-1\" data-name=\"view history icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </aside>\n        <footer class=\"mt-8 border-t border-[#CBD5E1] pt-5 text-[11px] text-[#94A3B8]\" data-kid=\"2-2-5\" data-name=\"mobile search footer\">\n            <div data-kid=\"2-2-5-1\" data-name=\"footer brand name\">\n                AutoDoc · Gestión operativa del taller\n            </div>\n            <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-2-5-2\" data-name=\"footer sync status container\">\n                <span class=\"size-1.5 rounded-full bg-[#10B981]\" data-kid=\"2-2-5-2-1\" data-name=\"sync indicator dot\">\n                </span>\n                Datos sincronizados hace 4 min\n            </div>\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación del taller\" class=\"fixed inset-x-0 bottom-0 z-30 border-t border-[#CBD5E1] bg-white/95 px-2 pb-[env(safe-area-inset-bottom)] backdrop-blur\" data-kid=\"2-3\" data-name=\"mobile fixed workshop navigation\">\n        <div class=\"mx-auto grid h-[74px] max-w-[420px] grid-cols-5 items-center gap-1\" data-kid=\"2-3-1\" data-name=\"navigation grid\">\n            <a class=\"flex min-h-14 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-1\" data-name=\"dashboard navigation link\" href=\"#panel\">\n                <i class=\"ti ti-layout-dashboard text-[19px]\" data-kid=\"2-3-1-1-1\" data-name=\"dashboard icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"dashboard label\">\n                    Panel\n                </span>\n            </a>\n            <a class=\"flex min-h-14 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-2\" data-name=\"repairs navigation link\" href=\"#reparaciones\">\n                <i class=\"ti ti-tool text-[19px]\" data-kid=\"2-3-1-2-1\" data-name=\"repairs icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"repairs label\">\n                    Reparaciones\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-14 flex-col items-center justify-center gap-1 border-t-[3px] border-[#1E88E5] text-[#1E88E5]\" data-kid=\"2-3-1-3\" data-name=\"search navigation link\" href=\"#buscar\">\n                <i class=\"ti ti-search text-[19px]\" data-kid=\"2-3-1-3-1\" data-name=\"search icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-3-2\" data-name=\"search label\">\n                    Buscar\n                </span>\n            </a>\n            <a class=\"flex min-h-14 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-4\" data-name=\"history navigation link\" href=\"#historial\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"2-3-1-4-1\" data-name=\"history icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </a>\n            <a class=\"flex min-h-14 flex-col items-center justify-center gap-1 text-[#64748B]\" data-kid=\"2-3-1-5\" data-name=\"reviews navigation link\" href=\"#resenas\">\n                <i class=\"ti ti-star text-[19px]\" data-kid=\"2-3-1-5-1\" data-name=\"reviews icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-5-2\" data-name=\"reviews label\">\n                    Reseñas\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
