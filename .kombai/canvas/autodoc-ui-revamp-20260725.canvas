      "html": "<link data-kid=\"1\" data-name=\"Tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .safe-bottom { padding-bottom: calc(0.75rem + env(safe-area-inset-bottom)); }\n</style>\n<style data-name=\"AppButton AppCard AppMotion treatment\">\n    [data-name=\"mobile back button\"], [data-name=\"mobile notifications button\"] { min-width:44px; min-height:44px; border-radius:999px; border:1px solid #334155; background:#141E36; color:#CBD5E1; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"mobile back button\"]:hover, [data-name=\"mobile notifications button\"]:hover { background:#1E293B; color:#81E6D9; box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"mobile back button\"]:active, [data-name=\"mobile notifications button\"]:active { transform:scale(.97); }\n  [data-name=\"mobile completed service summary\"] { overflow:hidden; border:1px solid rgba(51,65,85,.2); border-radius:16px; background:#141E36; box-shadow:0 2px 4px rgba(0,0,0,.2); }\n  [data-name=\"mobile back dashboard button\"] { min-height:48px; border-radius:999px; background:linear-gradient(135deg,#81E6D9,#6FC8BC); color:#0F172A; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"mobile back dashboard button\"]:hover { transform:scale(1.02); box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"mobile back dashboard button\"]:active { transform:scale(.97); }\n  [data-name=\"mobile view history button\"] { min-height:48px; border:1px solid #334155; border-radius:999px; background:#141E36; color:#CBD5E1; box-shadow:0 2px 4px rgba(0,0,0,.2); transition:transform 160ms cubic-bezier(.23,1,.32,1), box-shadow 150ms cubic-bezier(.23,1,.32,1), background-color 150ms cubic-bezier(.23,1,.32,1); }\n  [data-name=\"mobile view history button\"]:hover { background:#1E293B; box-shadow:0 6px 14px rgba(0,0,0,.35); }\n  [data-name=\"mobile view history button\"]:active { transform:scale(.97); }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"mobile task completion page\">\n    <header class=\"sticky top-0 z-10 flex h-[68px] items-center justify-between border-b border-[#334155] bg-[#0B1220] px-4\" data-kid=\"2-1\" data-name=\"mobile completion header\">\n        <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"2-1-1\" data-name=\"mobile brand and back group\">\n            <button aria-label=\"Volver al servicio\" class=\"flex h-11 w-11 shrink-0 items-center justify-center border border-[#475569] text-[#94A3B8]\" data-kid=\"2-1-1-1\" data-name=\"mobile back button\">\n                <i class=\"ti ti-arrow-left text-[18px] text-[#94A3B8]\" data-kid=\"2-1-1-1-1\" data-name=\"back icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"2-1-1-2\" data-name=\"mobile brand lockup\">\n                <div aria-label=\"AutoDoc\" class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] bg-[#38BDF8] text-[15px] font-heading font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-1-2-1\" data-name=\"mobile brand mark\">\n                    AD\n                </div>\n                <div class=\"min-w-0\" data-kid=\"2-1-1-2-2\" data-name=\"mobile brand text group\">\n                    <div class=\"truncate text-[11px] font-semibold text-[#94A3B8]\" data-kid=\"2-1-1-2-2-1\" data-name=\"mobile brand context\">\n                        Completar servicio\n                    </div>\n                    <div class=\"font-heading text-[14px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-1-2-2-2\" data-name=\"mobile brand name\">\n                        AutoDoc\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile header utilities\">\n            <button aria-label=\"Notificaciones\" class=\"relative flex h-11 w-11 items-center justify-center border border-[#475569] text-[#CBD5E1]\" data-kid=\"2-1-2-1\" data-name=\"mobile notifications button\">\n                <i class=\"ti ti-bell text-[17px] text-[#CBD5E1]\" data-kid=\"2-1-2-1-1\" data-name=\"bell icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-1-2\" data-name=\"notification dot\">\n                </span>\n            </button>\n            <div class=\"flex h-11 w-11 items-center justify-center rounded-full bg-[#334155] text-[12px] font-bold text-[#E2E8F0]\" data-kid=\"2-1-2-2\" data-name=\"mobile user initials\">\n                JP\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[520px] px-4 pb-[112px] pt-6\" data-kid=\"2-2\" data-name=\"mobile completion content\">\n        <nav aria-label=\"Ruta actual\" class=\"flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1\" data-name=\"mobile breadcrumb navigation\">\n            <span class=\"truncate\" data-kid=\"2-2-1-1\" data-name=\"breadcrumb parent\">\n                Taller Rápido\n            </span>\n            <i class=\"ti ti-chevron-right shrink-0 text-[13px] text-[#64748B]\" data-kid=\"2-2-1-2\" data-name=\"breadcrumb separator\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n            <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-3\" data-name=\"breadcrumb current\">\n                Confirmación\n            </span>\n        </nav>\n        <section aria-labelledby=\"completion-title\" class=\"mt-9 text-center\" data-kid=\"2-2-2\" data-name=\"mobile confirmation introduction\">\n            <div aria-label=\"Tarea completada correctamente\" class=\"mx-auto flex h-[68px] w-[68px] items-center justify-center rounded-full border border-[#34D399]/60 bg-[#064E3B] text-[32px] text-[#34D399]\" data-kid=\"2-2-2-1\" data-name=\"mobile accessible completion check\" role=\"img\">\n                <i class=\"ti ti-check text-[32px] text-[#34D399]\" data-kid=\"2-2-2-1-1\" data-name=\"completion check icon\" style=\"width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </div>\n            <p class=\"mt-6 text-[10px] font-bold uppercase tracking-[0.2em] text-[#34D399]\" data-kid=\"2-2-2-2\" data-name=\"success eyebrow\">\n                Servicio validado\n            </p>\n            <h1 class=\"mt-3 font-heading text-[28px] font-extrabold tracking-[-0.05em] text-[#F8FAFC]\" data-kid=\"2-2-2-3\" data-name=\"mobile completion title\" id=\"completion-title\">\n                Tarea completada\n            </h1>\n            <p class=\"mx-auto mt-3 max-w-[320px] text-[15px] leading-6 text-[#94A3B8]\" data-kid=\"2-2-2-4\" data-name=\"mobile completion description\">\n                El mantenimiento de tu vehículo quedó registrado.\n            </p>\n        </section>\n        <section aria-labelledby=\"service-summary-title\" class=\"mt-8 overflow-hidden border border-[#475569] bg-[#1E293B]\" data-kid=\"2-2-3\" data-name=\"mobile completed service summary\">\n            <div class=\"flex items-start justify-between gap-3 border-b border-[#334155] px-4 py-5\" data-kid=\"2-2-3-1\" data-name=\"mobile summary header\">\n                <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"2-2-3-1-1\" data-name=\"mobile summary identity\">\n                    <div aria-hidden=\"true\" class=\"flex h-11 w-11 shrink-0 items-center justify-center border border-[#38BDF8]/60 bg-[#082F49] text-[20px] text-[#38BDF8]\" data-kid=\"2-2-3-1-1-1\" data-name=\"mobile vehicle icon wrapper\">\n                        <i class=\"ti ti-car text-[20px] text-[#38BDF8]\" data-kid=\"2-2-3-1-1-1-1\" data-name=\"vehicle icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-2-3-1-1-4\" data-name=\"mobile vehicle detail wrapper\">\n                        <h2 class=\"truncate font-heading text-[17px] font-bold tracking-[-0.025em] text-[#F8FAFC]\" data-kid=\"2-2-3-1-1-2\" data-name=\"mobile vehicle title\" id=\"service-summary-title\">\n                            Toyota Corolla 2022\n                        </h2>\n                        <p class=\"mt-1 text-[11px] font-semibold tracking-[0.16em] text-[#94A3B8]\" data-kid=\"2-2-3-1-1-3\" data-name=\"mobile vehicle plate\">\n                            P 482-916\n                        </p>\n                    </div>\n                </div>\n                <span class=\"flex shrink-0 items-center gap-1.5 border border-[#34D399]/50 bg-[#064E3B]/40 px-2.5 py-2 text-[10px] font-bold text-[#6EE7B7]\" data-kid=\"2-2-3-1-2\" data-name=\"mobile completed status badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-3-1-2-1\" data-name=\"completed status dot\">\n                    </span>\n                    Registrado\n                </span>\n            </div>\n            <div class=\"divide-y divide-[#334155]\" data-kid=\"2-2-3-2\" data-name=\"mobile service metadata list\">\n                <div class=\"flex items-center justify-between gap-4 px-4 py-4\" data-kid=\"2-2-3-2-1\" data-name=\"mobile service metadata item\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-3-2-1-1\" data-name=\"service label\">\n                        Servicio\n                    </p>\n                    <p class=\"text-right text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-1-2\" data-name=\"service value\">\n                        Cambio de aceite\n                    </p>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 px-4 py-4\" data-kid=\"2-2-3-2-2\" data-name=\"mobile mileage metadata item\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-3-2-2-1\" data-name=\"mileage label\">\n                        Kilometraje\n                    </p>\n                    <p class=\"text-right text-[18px] font-bold tabular-nums text-[#38BDF8]\" data-kid=\"2-2-3-2-2-2\" data-name=\"mileage value\">\n                        48,260\n                        <span class=\"text-[12px] font-medium text-[#94A3B8]\" data-kid=\"2-2-3-2-2-2-1\" data-name=\"mileage unit\">\n                            km\n                        </span>\n                    </p>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 px-4 py-4\" data-kid=\"2-2-3-2-3\" data-name=\"mobile date metadata item\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-3-2-3-1\" data-name=\"service date label\">\n                        Fecha\n                    </p>\n                    <p class=\"text-right text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-3-2-3-2\" data-name=\"service date value\">\n                        12 jun 2026\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Próximo mantenimiento recomendado\" class=\"mt-4 border-l-4 border-[#38BDF8] bg-[#17263A] px-4 py-4\" data-kid=\"2-2-4\" data-name=\"mobile next reminder callout\">\n            <div class=\"flex items-start gap-3\" data-kid=\"2-2-4-1\" data-name=\"mobile reminder content\">\n                <i class=\"ti ti-calendar-due mt-0.5 shrink-0 text-[20px] text-[#38BDF8]\" data-kid=\"2-2-4-1-1\" data-name=\"reminder icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <div class=\"min-w-0\" data-kid=\"2-2-4-1-4\" data-name=\"mobile reminder text wrapper\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#7DD3FC]\" data-kid=\"2-2-4-1-2\" data-name=\"reminder label\">\n                        Siguiente recordatorio\n                    </p>\n                    <p class=\"mt-1 text-[14px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-4-1-3\" data-name=\"reminder value\">\n                        Revisión en\n                        <span class=\"tabular-nums text-[#F8FAFC]\" data-kid=\"2-2-4-1-3-1\" data-name=\"reminder distance\">\n                            10,000 km\n                        </span>\n                    </p>\n                    <p class=\"mt-2 text-[11px] leading-4 text-[#94A3B8]\" data-kid=\"2-2-4-2\" data-name=\"mobile reminder context\">\n                        Te avisaremos antes de que llegue el momento.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <div class=\"mt-6 flex flex-col gap-4\" data-kid=\"2-2-5\" data-name=\"mobile synchronization and actions\">\n            <div aria-live=\"polite\" class=\"flex items-center gap-2 text-[12px] text-[#94A3B8]\" data-kid=\"2-2-5-1\" data-name=\"mobile sync status\" role=\"status\">\n                <i class=\"ti ti-cloud-check text-[16px] text-[#34D399]\" data-kid=\"2-2-5-1-1\" data-name=\"sync icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                Datos guardados y sincronizados\n            </div>\n            <div class=\"flex flex-col gap-3\" data-kid=\"2-2-5-2\" data-name=\"mobile completion actions\">\n                <button aria-label=\"Volver al dashboard principal\" class=\"flex min-h-[48px] w-full items-center justify-center gap-2 bg-[#38BDF8] px-5 py-3 text-[13px] font-bold text-[#082F49]\" data-kid=\"2-2-5-2-2\" data-name=\"mobile back dashboard button\">\n                    Volver al dashboard\n                    <i class=\"ti ti-arrow-up-right text-[16px] text-[#082F49]\" data-kid=\"2-2-5-2-2-1\" data-name=\"dashboard arrow icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Ver historial del vehículo\" class=\"flex min-h-[48px] w-full items-center justify-center gap-2 border border-[#475569] px-4 py-3 text-[13px] font-semibold text-[#CBD5E1]\" data-kid=\"2-2-5-2-1\" data-name=\"mobile view history button\">\n                    <i class=\"ti ti-history text-[16px] text-[#94A3B8]\" data-kid=\"2-2-5-2-1-1\" data-name=\"history icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Ver historial\n                </button>\n            </div>\n        </div>\n        <footer class=\"mt-8 border-t border-[#334155] pt-5 text-[11px] leading-5 text-[#64748B]\" data-kid=\"2-2-6\" data-name=\"mobile completion footer\">\n            AutoDoc · Historial de mantenimiento vehicular · Registro confirmado\n        </footer>\n    </main>\n    <nav aria-label=\"Navegación principal\" class=\"fixed inset-x-0 bottom-0 z-20 border-t border-[#334155] bg-[#0B1220]/95 px-2 pt-2 backdrop-blur-sm safe-bottom\" data-kid=\"2-3\" data-name=\"mobile fixed bottom navigation\">\n        <div class=\"mx-auto flex max-w-[520px] items-center justify-around gap-1\" data-kid=\"2-3-1\" data-name=\"mobile bottom navigation items\">\n            <a aria-label=\"Inicio\" class=\"flex min-h-[44px] min-w-[44px] flex-1 flex-col items-center justify-center gap-1 border-t-2 border-[#38BDF8] bg-[#1E293B] text-[#38BDF8]\" data-kid=\"2-3-1-1\" data-name=\"active home navigation item\" href=\"#inicio\">\n                <i class=\"ti ti-home-2 text-[18px]\" data-kid=\"2-3-1-1-1\" data-name=\"home icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-semibold\" data-kid=\"2-3-1-1-2\" data-name=\"home label\">\n                    Inicio\n                </span>\n            </a>\n            <a aria-label=\"Mi garaje\" class=\"flex min-h-[44px] min-w-[44px] flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-2\" data-name=\"garage navigation item\" href=\"#garage\">\n                <i class=\"ti ti-car text-[18px]\" data-kid=\"2-3-1-2-1\" data-name=\"garage icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-2-2\" data-name=\"garage label\">\n                    Garaje\n                </span>\n            </a>\n            <a aria-label=\"Talleres\" class=\"flex min-h-[44px] min-w-[44px] flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-3\" data-name=\"workshops navigation item\" href=\"#workshops\">\n                <i class=\"ti ti-tool text-[18px]\" data-kid=\"2-3-1-3-1\" data-name=\"workshops icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-3-2\" data-name=\"workshops label\">\n                    Talleres\n                </span>\n            </a>\n            <a aria-label=\"Alertas\" class=\"flex min-h-[44px] min-w-[44px] flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-4\" data-name=\"alerts navigation item\" href=\"#alerts\">\n                <i class=\"ti ti-alert-triangle text-[18px]\" data-kid=\"2-3-1-4-1\" data-name=\"alerts icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-4-2\" data-name=\"alerts label\">\n                    Alertas\n                </span>\n            </a>\n            <a aria-label=\"Historial\" class=\"flex min-h-[44px] min-w-[44px] flex-1 flex-col items-center justify-center gap-1 text-[#94A3B8]\" data-kid=\"2-3-1-5\" data-name=\"history navigation item\" href=\"#history\">\n                <i class=\"ti ti-history text-[18px]\" data-kid=\"2-3-1-5-1\" data-name=\"history icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"2-3-1-5-2\" data-name=\"history label\">\n                    Historial\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
