        "x": 34770,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"2\" data-name=\"Onboarding dark mobile root\">\n    <header class=\"flex min-h-[72px] items-center justify-between border-b border-[#334155] bg-[#020617] px-4 py-3\" data-kid=\"2-1\" data-name=\"Mobile onboarding top bar\">\n        <div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"2-1-1\" data-name=\"Mobile AutoDoc brand group\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-[11px] bg-[#38BDF8] text-[16px] font-heading font-extrabold tracking-[-0.08em] text-[#082F49]\" data-kid=\"2-1-1-1\" data-name=\"Mobile AutoDoc logo mark\">\n                AD\n            </div>\n            <div class=\"font-heading text-[17px] font-extrabold tracking-[-0.045em]\" data-kid=\"2-1-1-2\" data-name=\"Mobile AutoDoc wordmark\">\n                Auto\n                <span class=\"text-[#38BDF8]\" data-kid=\"2-1-1-2-1\" data-name=\"Mobile AutoDoc wordmark suffix\">\n                    Doc\n                </span>\n            </div>\n            <span class=\"size-1.5 shrink-0 rounded-full bg-[#34D399]\" data-kid=\"2-1-1-3\" data-name=\"Mobile brand status dot\">\n            </span>\n        </div>\n        <div class=\"flex shrink-0 flex-col items-end gap-0.5\" data-kid=\"2-1-2\" data-name=\"Mobile onboarding progress header\">\n            <span class=\"text-[8px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"Mobile onboarding label\">\n                Configuración inicial\n            </span>\n            <span class=\"font-heading text-[12px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"2-1-2-3\" data-name=\"Mobile slide count\">\n                01\n                <span class=\"text-[#64748B]\" data-kid=\"2-1-2-3-1\" data-name=\"Mobile slide total\">\n                    / 03\n                </span>\n            </span>\n        </div>\n    </header>\n    <main class=\"pb-[104px]\" data-kid=\"2-2\" data-name=\"Onboarding mobile vertical layout\">\n        <section class=\"bg-[#0B1220] px-4 pb-6 pt-5\" data-kid=\"2-2-1\" data-name=\"Mobile automotive visual panel\">\n            <div class=\"mb-4 flex items-start justify-between gap-3\" data-kid=\"2-2-1-2\" data-name=\"Mobile visual panel header\">\n                <div class=\"min-w-0\" data-kid=\"2-2-1-2-4\" data-name=\"Mobile visual header text group\">\n                    <p class=\"text-[9px] font-semibold uppercase tracking-[0.18em] text-[#94A3B8]\" data-kid=\"2-2-1-2-1\" data-name=\"Mobile visual kicker\">\n                        Vehicle care / first scan\n                    </p>\n                    <p class=\"mt-1.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-1-2-2\" data-name=\"Mobile visual descriptor\">\n                        Una lectura clara empieza con tu garaje.\n                    </p>\n                </div>\n                <div aria-label=\"Indicador técnico octagonal\" class=\"grid size-11 shrink-0 place-items-center bg-[#B87333] text-[#0F172A] [clip-path:polygon(50%_0%,85%_15%,100%_50%,85%_85%,50%_100%,15%_85%,0%_50%,15%_15%)]\" data-kid=\"2-2-1-2-3\" data-name=\"Mobile copper octagon indicator\">\n                    <div class=\"grid size-7 place-items-center border border-[#0F172A] [clip-path:polygon(50%_0%,85%_15%,100%_50%,85%_85%,50%_100%,15%_85%,0%_50%,15%_15%)]\" data-kid=\"2-2-1-2-3-1\" data-name=\"Mobile octagon inner mark\">\n                        <span class=\"text-[9px] font-bold tabular-nums\" data-kid=\"2-2-1-2-3-1-1\" data-name=\"Mobile octagon index number\">\n                            01\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"relative h-[210px] overflow-hidden border border-[#334155] bg-[#020617]\" data-kid=\"2-2-1-3\" data-name=\"Mobile automotive image stage\">\n                <div class=\"absolute left-3 top-3 z-10 h-7 w-7 border-l border-t border-[#38BDF8]/60\" data-kid=\"2-2-1-3-1\" data-name=\"Mobile technical corner top left\">\n                </div>\n                <div class=\"absolute bottom-3 right-3 z-10 h-7 w-7 border-b border-r border-[#38BDF8]/60\" data-kid=\"2-2-1-3-2\" data-name=\"Mobile technical corner bottom right\">\n                </div>\n                <img alt=\"Sedán Hyundai en un estudio oscuro, fotografía de Hyundai Motor Group en Pexels\" class=\"h-full w-full object-cover opacity-80\" data-kid=\"2-2-1-3-3\" data-name=\"Mobile onboarding vehicle image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14696345/pexels-photo-14696345.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                <div class=\"absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 border-t border-[#334155] bg-[#020617]/90 px-3.5 py-3\" data-kid=\"2-2-1-3-4\" data-name=\"Mobile image technical caption\">\n                    <div class=\"min-w-0\" data-kid=\"2-2-1-3-4-4\" data-name=\"Mobile image caption text group\">\n                        <div class=\"text-[8px] font-semibold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"2-2-1-3-4-1\" data-name=\"Mobile image caption kicker\">\n                            Diagnóstico en tiempo real\n                        </div>\n                        <div class=\"mt-1 truncate font-heading text-[14px] font-bold text-[#E2E8F0]\" data-kid=\"2-2-1-3-4-2\" data-name=\"Mobile image caption title\">\n                            Tu vehículo, en control.\n                        </div>\n                    </div>\n                    <div class=\"flex shrink-0 items-center gap-1.5 text-[10px] text-[#94A3B8]\" data-kid=\"2-2-1-3-4-3\" data-name=\"Mobile visual status\">\n                        <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"2-2-1-3-4-3-1\" data-name=\"Mobile ready status dot\">\n                        </span>\n                        Sistema listo\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-4 flex items-center justify-between\" data-kid=\"2-2-1-4\" data-name=\"Mobile visual panel footer\">\n                <span class=\"text-[8px] font-semibold uppercase tracking-[0.16em] text-[#475569]\" data-kid=\"2-2-1-4-1\" data-name=\"Mobile visual footer code\">\n                    AUTODOC / 2026\n                </span>\n                <span class=\"text-[10px] tabular-nums text-[#64748B]\" data-kid=\"2-2-1-4-2\" data-name=\"Mobile visual footer detail\">\n                    01 — 03\n                </span>\n            </div>\n        </section>\n        <section class=\"bg-[#020617] px-4 pb-8 pt-7\" data-kid=\"2-2-2\" data-name=\"Mobile onboarding copy panel\">\n            <div class=\"flex items-center gap-2.5 text-[10px] font-semibold uppercase tracking-[0.17em] text-[#38BDF8]\" data-kid=\"2-2-2-1-1\" data-name=\"Mobile step label\">\n                <span class=\"h-px w-6 bg-[#38BDF8]\" data-kid=\"2-2-2-1-1-1\" data-name=\"Mobile step marker line\">\n                </span>\n                Paso 01 / Diagnóstico\n            </div>\n            <h1 class=\"mt-7 font-heading text-[35px] font-extrabold leading-[1.06] tracking-[-0.06em] text-[#F8FAFC]\" data-kid=\"2-2-2-1-2\" data-name=\"Mobile onboarding headline\">\n                Tu vehículo,\n                <br data-kid=\"2-2-2-1-2-1\" data-name=\"Mobile onboarding headline break\"/>\n                <span class=\"text-[#38BDF8]\" data-kid=\"2-2-2-1-2-2\" data-name=\"Mobile onboarding headline highlight\">\n                    en control.\n                </span>\n            </h1>\n            <p class=\"mt-5 text-[16px] leading-7 text-[#94A3B8]\" data-kid=\"2-2-2-1-3\" data-name=\"Mobile onboarding description\">\n                Registra el estado de tu auto y recibe recordatorios antes de que una reparación se vuelva urgente.\n            </p>\n            <div class=\"mt-7 overflow-hidden rounded-[16px] border border-[#334155]/20 bg-[#141E36] p-2 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"2-2-2-1-4\" data-name=\"mobile onboarding value list container\">\n                <div class=\"flex items-center gap-3 border-b border-[#1E293B] py-4\" data-kid=\"2-2-2-1-4-1\" data-name=\"Mobile value item one\">\n                    <span class=\"grid size-10 shrink-0 place-items-center border border-[#334155] text-[17px] text-[#34D399]\" data-kid=\"2-2-2-1-4-1-1\" data-name=\"Mobile value icon one\">\n                        <i class=\"ti ti-steering-wheel\" data-kid=\"2-2-2-1-4-1-1-1\" data-name=\"Mobile steering wheel icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div data-kid=\"2-2-2-1-4-1-2\" data-name=\"Mobile value item one text group\">\n                        <p class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-2-1-4-1-2-1\" data-name=\"Mobile value item one title\">\n                            Conoce tu auto\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-2-1-4-1-2-2\" data-name=\"Mobile value item one description\">\n                            Datos útiles, no suposiciones.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-3 border-b border-[#1E293B] py-4\" data-kid=\"2-2-2-1-4-2\" data-name=\"Mobile value item two\">\n                    <span class=\"grid size-10 shrink-0 place-items-center border border-[#334155] text-[17px] text-[#38BDF8]\" data-kid=\"2-2-2-1-4-2-1\" data-name=\"Mobile value icon two\">\n                        <i class=\"ti ti-chart-line\" data-kid=\"2-2-2-1-4-2-1-1\" data-name=\"Mobile chart line icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div data-kid=\"2-2-2-1-4-2-2\" data-name=\"Mobile value item two text group\">\n                        <p class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-2-1-4-2-2-1\" data-name=\"Mobile value item two title\">\n                            Anticípate al desgaste\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-2-1-4-2-2-2\" data-name=\"Mobile value item two description\">\n                            Recordatorios a tiempo.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-3 py-4\" data-kid=\"2-2-2-1-4-3\" data-name=\"Mobile value item three\">\n                    <span class=\"grid size-10 shrink-0 place-items-center border border-[#334155] text-[17px] text-[#B87333]\" data-kid=\"2-2-2-1-4-3-1\" data-name=\"Mobile value icon three\">\n                        <i class=\"ti ti-alert-triangle\" data-kid=\"2-2-2-1-4-3-1-1\" data-name=\"Mobile alert triangle icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                    <div data-kid=\"2-2-2-1-4-3-2\" data-name=\"Mobile value item three text group\">\n                        <p class=\"text-[13px] font-semibold text-[#E2E8F0]\" data-kid=\"2-2-2-1-4-3-2-1\" data-name=\"Mobile value item three title\">\n                            Actúa con confianza\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#64748B]\" data-kid=\"2-2-2-1-4-3-2-2\" data-name=\"Mobile value item three description\">\n                            Cada alerta tiene un siguiente paso.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-7\" data-kid=\"2-2-2-2-1\" data-name=\"Mobile accessible pager\">\n                <div class=\"mb-3 flex items-center justify-between text-[10px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"2-2-2-2-1-1\" data-name=\"Mobile pager labels\">\n                    <span data-kid=\"2-2-2-2-1-1-1\" data-name=\"Mobile pager current step text\">\n                        Paso 1 de 3\n                    </span>\n                    <span data-kid=\"2-2-2-2-1-1-2\" data-name=\"Mobile pager current activity text\">\n                        Diagnóstico\n                    </span>\n                </div>\n                <div aria-label=\"Progreso del onboarding: paso 1 de 3\" class=\"flex gap-1.5\" data-kid=\"2-2-2-2-1-2\" data-name=\"Mobile pager track\">\n                    <span class=\"h-1.5 flex-1 bg-[#38BDF8]\" data-kid=\"2-2-2-2-1-2-1\" data-name=\"Mobile active pager segment\">\n                    </span>\n                    <span class=\"h-1.5 flex-1 bg-[#334155]\" data-kid=\"2-2-2-2-1-2-2\" data-name=\"Mobile inactive pager segment\">\n                    </span>\n                    <span class=\"h-1.5 flex-1 bg-[#334155]\" data-kid=\"2-2-2-2-1-2-3\" data-name=\"Mobile inactive pager segment\">\n                    </span>\n                </div>\n            </div>\n        </section>\n    </main>\n    <nav aria-label=\"Navegación del onboarding\" class=\"fixed inset-x-0 bottom-0 z-20 border-t border-[#334155] bg-[#020617]/95 px-4 pb-[max(16px,env(safe-area-inset-bottom))] pt-3 backdrop-blur-sm\" data-kid=\"2-3\" data-name=\"Mobile fixed onboarding navigation\">\n        <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-3-1\" data-name=\"Mobile onboarding action row\">\n            <button class=\"inline-flex min-h-12 min-w-[76px] items-center justify-center rounded-full border border-[#334155] bg-[#141E36] px-4 text-[13px] font-semibold text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-3-1-1\" data-name=\"Mobile skip onboarding button\">\n                Omitir\n            </button>\n            <button class=\"flex min-h-11 flex-1 items-center justify-center gap-3 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-5 text-[13px] font-bold text-[#0F172A] shadow-[0_2px_4px_rgba(0,0,0,0.2)] transition duration-150 ease-out hover:scale-[1.02] hover:shadow-[0_6px_14px_rgba(0,0,0,0.35)] active:scale-[0.97]\" data-kid=\"2-3-1-2\" data-name=\"mobile next call-to-action button\">\n                Siguiente\n                <span class=\"text-[17px]\" data-kid=\"2-3-1-2-1\" data-name=\"Mobile next arrow icon container\">\n                    <i class=\"ti ti-arrow-right\" data-kid=\"2-3-1-2-1-1\" data-name=\"Mobile arrow right icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n            </button>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
      "created": "2026-08-17T20:18:13.889637+00:00",
      "modified": "2026-08-17T21:03:53.410004+00:00",
      "id": "var_12ce24e2f5b7"
    },
    "var_97209e3cce5f": {
      "type": "variant",
      "label": "AutoDoc Admin Users — Hadrian Light Mobile",
      "parentId": "var_c07671e33355",
      "themeId": null,
      "rect": {
        "x": 55175,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component tokens light\">\n    button { min-height:44px; min-width:44px; border-radius:999px !important; transition:transform 150ms cubic-bezier(.23,1,.32,1),box-shadow 150ms cubic-bezier(.23,1,.32,1),background-color 150ms cubic-bezier(.23,1,.32,1),color 150ms cubic-bezier(.23,1,.32,1); }\n  button:active { transform:scale(.97); }\n  button:hover { box-shadow:0 6px 14px rgba(15,23,42,.10); }\n  button[data-name*=\"primary button\"] { background:linear-gradient(135deg,#522C81,#47266F) !important; color:#FFFFFF !important; border:0 !important; box-shadow:0 2px 4px rgba(0,0,0,.05); }\n  button[data-name*=\"refresh\"], button[data-name*=\"export\"], button[data-name*=\"filter\"], button[data-name*=\"page\"] { background:#EEEDF0 !important; border:1px solid rgba(203,213,225,.40) !important; color:#0F172A !important; box-shadow:0 2px 4px rgba(0,0,0,.05); }\n  button[aria-label*=\"Notificaciones\"], button[aria-label*=\"Cambiar a modo\"], button[aria-label*=\"Actualizar\"], button[aria-label*=\"Perfil\"] { background:#EEEDF0 !important; border:1px solid rgba(203,213,225,.40) !important; }\n  section[data-name*=\"metrics\"], section[data-name*=\"panel\"], section[data-name*=\"log\"], section[data-name*=\"table\"], article[data-name*=\"user card\"] { background:#EEEDF0; border-color:rgba(203,213,225,.40) !important; border-radius:16px; box-shadow:0 2px 4px rgba(0,0,0,.05); overflow:hidden; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"admin users mobile page root\">\n    <header class=\"sticky top-0 z-20 flex h-[68px] items-center justify-between border-b border-[#CBD5E1] bg-white px-4\" data-kid=\"2-1\" data-name=\"compact admin mobile top bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-1\" data-name=\"mobile brand and context\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-10 shrink-0 place-items-center rounded-xl bg-[#1E88E5] text-[16px] font-heading font-extrabold tracking-[-0.08em] text-white\" data-kid=\"2-1-1-1\" data-name=\"mobile application logo\">\n                AD\n            </div>\n            <div class=\"min-w-0\" data-kid=\"2-1-1-2\" data-name=\"mobile breadcrumb wrapper\">\n                <p class=\"truncate text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-1-2-1\" data-name=\"mobile role context\">\n                    Admin\n                </p>\n                <p class=\"truncate font-heading text-[15px] font-bold text-[#0F172A]\" data-kid=\"2-1-1-2-2\" data-name=\"mobile current screen\">\n                    Usuarios\n                </p>\n            </div>\n        </div>\n        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"2-1-2\" data-name=\"mobile top actions\">\n            <button aria-label=\"Notificaciones\" class=\"relative grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-1\" data-name=\"mobile notifications action\">\n                <i class=\"ti ti-bell\" data-kid=\"2-1-2-1-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span class=\"absolute right-[9px] top-[9px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-2-1-2\" data-name=\"notification dot\">\n                </span>\n            </button>\n            <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-11 place-items-center rounded-lg text-[19px] text-[#64748B]\" data-kid=\"2-1-2-2\" data-name=\"mobile dark mode toggle\">\n                <i class=\"ti ti-moon\" data-kid=\"2-1-2-2-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </button>\n            <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-3\" data-name=\"mobile admin initials avatar\">\n                SA\n            </div>\n        </div>\n    </header>\n    <main class=\"px-4 pb-[124px] pt-6\" data-kid=\"2-2\" data-name=\"admin users mobile content\">\n        <div class=\"mb-6\" data-kid=\"2-2-1\" data-name=\"mobile users page heading\">\n            <p class=\"mb-2 flex items-center gap-2 text-[12px] text-[#64748B]\" data-kid=\"2-2-1-1\" data-name=\"mobile breadcrumb\">\n                <span data-kid=\"2-2-1-1-1\" data-name=\"breadcrumb parent\">\n                    Admin\n                </span>\n                <span class=\"text-[#CBD5E1]\" data-kid=\"2-2-1-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-2-1-1-3\" data-name=\"breadcrumb current\">\n                    Usuarios\n                </span>\n            </p>\n            <h1 class=\"font-heading text-[30px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-2-1-2\" data-name=\"mobile page headline\">\n                Usuarios\n            </h1>\n            <p class=\"mt-2 max-w-[310px] text-[14px] leading-5 text-[#334155]\" data-kid=\"2-2-1-3\" data-name=\"mobile page description\">\n                Gestiona acceso, roles y estado de las cuentas.\n            </p>\n            <div class=\"mt-5 grid grid-cols-2 gap-2\" data-kid=\"2-2-1-4\" data-name=\"mobile users page actions\">\n                <button class=\"inline-flex min-h-[44px] items-center justify-center gap-2 border border-[#CBD5E1] bg-white px-3 text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-2-1-4-1\" data-name=\"mobile export users button\">\n                    <i class=\"ti ti-download text-[16px] text-[#1E88E5]\" data-kid=\"2-2-1-4-1-1\" data-name=\"download icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Exportar\n                </button>\n                <button class=\"inline-flex min-h-[44px] items-center justify-center gap-2 bg-[#1E88E5] px-3 text-[12px] font-semibold text-white\" data-kid=\"2-2-1-4-2\" data-name=\"mobile new user primary button\">\n                    <i class=\"ti ti-user-plus text-[16px]\" data-kid=\"2-2-1-4-2-1\" data-name=\"user plus icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Nuevo usuario\n                </button>\n            </div>\n        </div>\n        <section class=\"border-y border-[#CBD5E1] bg-white\" data-kid=\"2-2-2\" data-name=\"mobile users search and filters\">\n            <div class=\"space-y-3 px-3 py-4\" data-kid=\"2-2-2-1\" data-name=\"mobile filter stack\">\n                <label class=\"flex min-h-[44px] items-center gap-3 border border-[#CBD5E1] bg-white px-3 text-[13px] text-[#64748B]\" data-kid=\"2-2-2-1-1\" data-name=\"mobile user search field\">\n                    <i class=\"ti ti-search shrink-0 text-[18px] text-[#64748B]\" data-kid=\"2-2-2-1-1-1\" data-name=\"search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"2-2-2-1-1-2\" data-name=\"search text placeholder\">\n                        Buscar por nombre o correo\n                    </span>\n                </label>\n                <div c