      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"font-body min-h-screen overflow-x-hidden bg-[#0F172A] text-[#F8FAFC] antialiased\" data-kid=\"1\" data-name=\"reservation detail dark mobile page\">\n    <header class=\"sticky top-0 z-30 flex min-h-[68px] items-center gap-3 border-b border-[#334155] bg-[#0B1220]/95 px-4 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"reservation detail app bar\">\n        <button aria-label=\"Volver\" class=\"flex size-11 shrink-0 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#CBD5E1] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-1-1\" data-name=\"back button\">\n            <i class=\"ti ti-arrow-left text-[18px]\" data-kid=\"1-1-1-1\" data-name=\"back arrow icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n        </button>\n        <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2\" data-name=\"page title container\">\n            <div class=\"text-[10px] font-semibold uppercase tracking-[0.18em] text-[#64748B]\" data-kid=\"1-1-2-1\" data-name=\"page breadcrumb label\">\n                Conversaciones\n            </div>\n            <h1 class=\"font-heading truncate text-[16px] font-bold tracking-[-0.03em] text-[#F8FAFC]\" data-kid=\"1-1-2-2\" data-name=\"main page title\">\n                Detalle de reserva\n            </h1>\n        </div>\n        <button aria-label=\"Más opciones\" class=\"flex size-11 shrink-0 items-center justify-center rounded-full border border-[#334155] bg-[#141E36] text-[#94A3B8] shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-1-3\" data-name=\"more options button\">\n            <i class=\"ti ti-dots text-[18px]\" data-kid=\"1-1-3-1\" data-name=\"more options dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n            </i>\n        </button>\n    </header>\n    <main class=\"mx-auto w-full max-w-[520px] px-4 pb-12 pt-6\" data-kid=\"1-2\" data-name=\"scroll-safe reservation content\">\n        <div class=\"mb-5\" data-kid=\"1-2-1\" data-name=\"reservation heading section\">\n            <p class=\"mb-2 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[#81E6D9]\" data-kid=\"1-2-1-1\" data-name=\"live status indicator\">\n                <span class=\"size-1.5 rounded-full bg-[#81E6D9]\" data-kid=\"1-2-1-1-1\" data-name=\"status dot\">\n                </span>\n                Cita en vivo\n            </p>\n            <h2 class=\"font-heading text-[26px] font-extrabold leading-[1.12] tracking-[-0.05em] text-[#F8FAFC]\" data-kid=\"1-2-1-2\" data-name=\"reservation page headline\">\n                Reserva de servicio\n            </h2>\n            <p class=\"mt-2 text-[14px] leading-5 text-[#94A3B8]\" data-kid=\"1-2-1-3\" data-name=\"reservation instruction text\">\n                Revisa los datos antes de confirmar la visita al taller.\n            </p>\n        </div>\n        <section class=\"overflow-hidden rounded-[16px] border border-[#334155] bg-[#141E36] shadow-[0_8px_24px_rgba(2,6,23,0.26)]\" data-kid=\"1-2-2\" data-name=\"loaded reservation card\">\n            <div class=\"border-b border-[#334155] p-4\" data-kid=\"1-2-2-1\" data-name=\"reservation summary header\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"summary content container\">\n                    <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"1-2-2-1-1-1\" data-name=\"icon and title container\">\n                        <div class=\"flex size-11 shrink-0 items-center justify-center rounded-[12px] bg-[#075985] text-[#7DD3FC]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"service category icon background\">\n                            <i class=\"ti ti-calendar-event text-[20px]\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"calendar icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"reservation summary details\">\n                            <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#F6AD55]\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"reservation status label\">\n                                Reserva pendiente\n                            </p>\n                            <h3 class=\"font-heading mt-1 text-[19px] font-bold leading-tight tracking-[-0.03em] text-[#F8FAFC]\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"service name title\">\n                                Cambio de pastillas\n                            </h3>\n                            <p class=\"mt-1 truncate text-[12px] text-[#94A3B8]\" data-kid=\"1-2-2-1-1-1-2-3\" data-name=\"service location and vehicle info\">\n                                Taller Rápido · Toyota Corolla 2022\n                            </p>\n                        </div>\n                    </div>\n                    <span class=\"shrink-0 rounded-full border border-[#F6AD55]/35 bg-[#F6AD55]/15 px-2.5 py-1.5 text-[10px] font-bold text-[#F6AD55]\" data-kid=\"1-2-2-1-1-2\" data-name=\"status badge\">\n                        PENDIENTE\n                    </span>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-2 divide-x divide-[#334155] border-b border-[#334155]\" data-kid=\"1-2-2-2\" data-name=\"reservation date time facts\">\n                <div class=\"px-4 py-4\" data-kid=\"1-2-2-2-1\" data-name=\"date section\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"1-2-2-2-1-1\" data-name=\"date section label\">\n                        Fecha\n                    </p>\n                    <p class=\"mt-2 font-heading text-[14px] font-bold text-[#E2E8F0]\" data-kid=\"1-2-2-2-1-2\" data-name=\"scheduled date\">\n                        Mañana\n                    </p>\n                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"1-2-2-2-1-3\" data-name=\"scheduled time\">\n                        10:00 a. m.\n                    </p>\n                </div>\n                <div class=\"px-4 py-4\" data-kid=\"1-2-2-2-2\" data-name=\"duration section\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"1-2-2-2-2-1\" data-name=\"duration section label\">\n                        Duración\n                    </p>\n                    <p class=\"mt-2 font-heading text-[14px] font-bold tabular-nums text-[#E2E8F0]\" data-kid=\"1-2-2-2-2-2\" data-name=\"scheduled duration\">\n                        45 min\n                    </p>\n                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"1-2-2-2-2-3\" data-name=\"duration details\">\n                        Servicio programado\n                    </p>\n                </div>\n            </div>\n            <div class=\"p-4\" data-kid=\"1-2-2-3\" data-name=\"reservation vehicle fact\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#64748B]\" data-kid=\"1-2-2-3-1\" data-name=\"vehicle label\">\n                    Vehículo\n                </p>\n                <div class=\"mt-2 flex items-center justify-between gap-3\" data-kid=\"1-2-2-3-2\" data-name=\"vehicle details container\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-2-3-2-1\" data-name=\"vehicle identification container\">\n                        <p class=\"font-heading truncate text-[15px] font-bold text-[#E2E8F0]\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"vehicle license plate\">\n                            P 482-916\n                        </p>\n                        <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"vehicle model name\">\n                            Toyota Corolla 2022\n                        </p>\n                    </div>\n                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1E293B] text-[#81E6D9]\" data-kid=\"1-2-2-3-2-2\" data-name=\"vehicle icon container\">\n                        <i class=\"ti ti-car text-[18px]\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"car icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-6 rounded-[16px] border border-[#334155] bg-[#141E36] p-4 shadow-[0_2px_4px_rgba(0,0,0,0.2)]\" data-kid=\"1-2-3\" data-name=\"reservation status section\">\n            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-2-3-1\" data-name=\"current status header\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"status description container\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#64748B]\" data-kid=\"1-2-3-1-1-1\" data-name=\"current status label\">\n                        Estado actual\n                    </p>\n                    <p class=\"mt-1 text-[13px] font-semibold text-[#CBD5E1]\" data-kid=\"1-2-3-1-1-2\" data-name=\"status explanation text\">\n                        Tu respuesta es necesaria\n                    </p>\n                </div>\n                <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[#F6AD55]/35 bg-[#F6AD55]/15 px-2.5 py-1.5 text-[10px] font-bold text-[#F6AD55]\" data-kid=\"1-2-3-1-2\" data-name=\"status badge with icon\">\n                    <i class=\"ti ti-clock text-[13px]\" data-kid=\"1-2-3-1-2-1\" data-name=\"clock icon\" style=\"width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Pendiente\n                </span>\n            </div>\n            <div class=\"mt-4 flex items-start gap-3 border-l-2 border-[#F6AD55] bg-[#422006]/35 px-3 py-3\" data-kid=\"1-2-3-2\" data-name=\"warning notice container\">\n                <i class=\"ti ti-info-circle mt-0.5 shrink-0 text-[17px] text-[#F6AD55]\" data-kid=\"1-2-3-2-1\" data-name=\"info icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <p class=\"text-[12px] leading-5 text-[#CBD5E1]\" data-kid=\"1-2-3-2-2\" data-name=\"warning message text\">\n                    Confirma la fecha para reservar el espacio del taller.\n                </p>\n            </div>\n        </section>\n        <section class=\"mt-6\" data-kid=\"1-2-4\" data-name=\"reservation contextual actions\">\n            <p class=\"mb-3 text-[10px] font-bold uppercase tracking-[0.18em] text-[#64748B]\" data-kid=\"1-2-4-1\" data-name=\"actions section label\">\n                Acciones de la cita\n            </p>\n            <div class=\"space-y-3\" data-kid=\"1-2-4-2\" data-name=\"actions buttons container\">\n                <button class=\"flex min-h-[52px] w-full items-center justify-center gap-2 rounded-full bg-gradient-to-br from-[#81E6D9] to-[#6FC8BC] px-5 text-[13px] font-bold text-[#0F172A] shadow-[0_6px_16px_rgba(129,230,217,0.16)]\" data-kid=\"1-2-4-2-1\" data-name=\"accept appointment button\">\n                    <i class=\"ti ti-check text-[17px]\" data-kid=\"1-2-4-2-1-1\" data-name=\"check icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Aceptar cita\n                </button>\n                <button class=\"flex min-h-[52px] w-full items-center justify-center gap-2 rounded-full border border-[#522C81] bg-[#522C81]/20 px-5 text-[13px] font-bold text-[#C4B5FD]\" data-kid=\"1-2-4-2-2\" data-name=\"reschedule appointment button\">\n                    <i class=\"ti ti-edit-calendar text-[17px]\" data-kid=\"1-2-4-2-2-1\" data-name=\"edit calendar icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Reprogramar\n                </button>\n                <button class=\"flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full px-5 text-[13px] font-bold text-[#81E6D9]\" data-kid=\"1-2-4-2-3\" data-name=\"reject appointment button\">\n                    <i class=\"ti ti-x text-[16px]\" data-kid=\"1-2-4-2-3-1\" data-name=\"close icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    Rechazar\n                </button>\n            </div>\n            <div class=\"mt-4 flex items-center gap-2 border-t border-[#334155] pt-4 text-[11px] text-[#64748B]\" data-kid=\"1-2-4-3\" data-name=\"mechanic alternative cue\">\n                <i class=\"ti ti-file-invoice text-[15px] text-[#818CF8]\" data-kid=\"1-2-4-3-1\" data-name=\"invoice icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <span data-kid=\"1-2-4-3-2\" data-name=\"mechanic view label\">\n                    Vista mecánico:\n                    <strong class=\"font-semibold text-[#94A3B8]\" data-kid=\"1-2-4-3-2-1\" data-name=\"action suggestion strong text\">\n                        Cotizar y Aceptar\n                    </strong>\n                </span>\n            </div>\n        </section>\n        <section class=\"mt-7 rounded-[16px] border border-dashed border-[#334155] bg-[#0B1220]/45 p-4\" data-kid=\"1-2-5\" data-name=\"reservation empty state alternate cue\">\n            <div class=\"flex items-start gap-3\" data-kid=\"1-2-5-1\" data-name=\"empty state container\">\n                <span class=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1E293B] text-[#94A3B8]\" data-kid=\"1-2-5-1-1\" data-name=\"empty state icon background\">\n                    <i class=\"ti ti-calendar-off text-[18px]\" data-kid=\"1-2-5-1-1-1\" data-name=\"calendar off icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </span>\n                <div data-kid=\"1-2-5-1-2\" data-name=\"empty state message container\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#64748B]\" data-kid=\"1-2-5-1-2-1\" data-name=\"alternative status label\">\n                        Estado alternativo\n                    </p>\n                    <p class=\"mt-1 text-[13px] font-semibold text-[#CBD5E1]\" data-kid=\"1-2-5-1-2-2\" data-name=\"empty state headline\">\n                        No se encontró esta cita\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#64748B]\" data-kid=\"1-2-5-1-2-3\" data-name=\"empty state subtext\">\n                        Puede que se haya cancelado o eliminado.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <footer class=\"mt-7 flex items-center gap-2 border-t border-[#334155] pt-5 text-[11px] text-[#64748B]\" data-kid=\"1-2-6\" data-name=\"reservation sync footer\">\n            <span class=\"size-1.5 rounded-full bg-[#34D399]\" data-kid=\"1-2-6-1\" data-name=\"sync status indicator dot\">\n            </span>\n            Datos sincronizados hace 4 min · Reserva de servicio\n        </footer>\n    </main>\n</div>\n",
