      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen overflow-hidden bg-(--surface) text-(--text-primary) antialiased\" data-kid=\"1\" data-name=\"standalone admin seed screen\" style=\"--surface:#0F172A;--surface-container:#141E36;--surface-variant:#1E293B;--outline:#334155;--primary:#81E6D9;--secondary:#522C81;--success:#48BB78;--text-primary:#FFFFFF;--text-secondary:#CBD5E1;font-family:'IBM Plex Sans',sans-serif\">\n    <header class=\"flex h-[76px] items-center justify-center border-b border-(--outline) bg-[#0B1220] px-8\" data-kid=\"1-1\" data-name=\"standalone configuration app bar\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"app bar title group\">\n            <span class=\"flex size-10 items-center justify-center rounded-[12px] bg-(--primary) text-(--dark-surface)\" data-kid=\"1-1-1-1\" data-name=\"configuration security icon container\" style=\"--dark-surface:#0F172A\">\n                <i class=\"ti ti-shield-lock text-[19px]\" data-kid=\"1-1-1-1-1\" data-name=\"security icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n            </span>\n            <h1 class=\"font-heading text-[18px] font-bold tracking-[-0.025em] text-(--text-primary)\" data-kid=\"1-1-1-2\" data-name=\"configuration title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                Configuración de administradores\n            </h1>\n        </div>\n    </header>\n    <main class=\"flex min-h-[724px] items-center justify-center px-6 py-16\" data-kid=\"1-2\" data-name=\"admin seed content area\">\n        <div class=\"w-full max-w-[640px]\" data-kid=\"1-2-1\" data-name=\"admin seed readable content\">\n            <section class=\"rounded-[16px] border border-(--outline) bg-(--surface-container) px-12 py-14 text-center shadow-[0_16px_34px_rgba(2,6,23,0.32)]\" data-kid=\"1-2-1-1\" data-name=\"migration completed status card\">\n                <div class=\"mx-auto flex size-[96px] items-center justify-center rounded-full border border-(--success)/40 bg-(--success)/10 text-(--success)\" data-kid=\"1-2-1-1-1\" data-name=\"migration security status icon\">\n                    <i class=\"ti ti-shield-check text-[52px]\" data-kid=\"1-2-1-1-1-1\" data-name=\"completed security icon\" style=\"width:52px;height:52px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n                <p class=\"mt-8 text-[11px] font-bold uppercase tracking-[0.22em] text-(--success)\" data-kid=\"1-2-1-1-2\" data-name=\"migration status eyebrow\">\n                    Estado de configuración\n                </p>\n                <h2 class=\"mt-3 font-heading text-[30px] font-extrabold tracking-[-0.045em] text-(--text-primary)\" data-kid=\"1-2-1-1-3\" data-name=\"migration completed heading\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    Migración Completada\n                </h2>\n                <p class=\"mx-auto mt-5 max-w-[500px] text-[16px] leading-7 text-(--text-secondary)\" data-kid=\"1-2-1-1-4\" data-name=\"migration completed explanation\">\n                    Las cuentas administrativas ya fueron configuradas y los secretos se eliminaron del código fuente por motivos de seguridad.\n                </p>\n                <div class=\"mt-10 flex items-center justify-center gap-3 border-t border-(--outline) pt-6 text-[12px] text-(--text-secondary)\" data-kid=\"1-2-1-1-5\" data-name=\"migration completion note\">\n                    <span class=\"size-2 rounded-full bg-(--success)\" data-kid=\"1-2-1-1-5-1\" data-name=\"migration success indicator\">\n                    </span>\n                    <span data-kid=\"1-2-1-1-5-2\" data-name=\"configuration verification text\">\n                        Configuración verificada en modo de desarrollo\n                    </span>\n                </div>\n            </section>\n            <aside class=\"mt-5 flex items-start gap-3 rounded-[12px] border border-(--outline) bg-(--surface-variant)/55 px-5 py-4 text-left\" data-kid=\"1-2-1-2\" data-name=\"release access denied cue\">\n                <i class=\"ti ti-lock-access text-[18px] text-(--text-secondary)\" data-kid=\"1-2-1-2-1\" data-name=\"access denied lock icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                </i>\n                <div data-kid=\"1-2-1-2-2\" data-name=\"access denied text group\">\n                    <p class=\"text-[12px] font-semibold text-(--text-primary)\" data-kid=\"1-2-1-2-2-1\" data-name=\"access denied title\">\n                        Acceso denegado fuera de debug\n                    </p>\n                    <p class=\"mt-1 text-[11px] leading-5 text-(--text-secondary)\" data-kid=\"1-2-1-2-2-2\" data-name=\"access denied description\">\n                        Esta pantalla informativa no está disponible en compilaciones de producción.\n                    </p>\n                </div>\n            </aside>\n        </div>\n    </main>\n</div>\n",
