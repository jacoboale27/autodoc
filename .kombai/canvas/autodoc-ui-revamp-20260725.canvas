        </div>\n                        </section>\n                    </div>\n                    <div class=\"space-y-7\" data-kid=\"2-1-3-2-2-2\" data-name=\"Secondary form right column\">\n                        <section aria-labelledby=\"services-heading\" class=\"border-y border-[#475569]\" data-kid=\"2-1-3-2-2-2-1\" data-name=\"Services section\">\n                            <div class=\"flex items-start justify-between border-b border-[#334155] py-5\" data-kid=\"2-1-3-2-2-2-1-1\" data-name=\"Services header\">\n                                <div data-kid=\"2-1-3-2-2-2-1-1-1\" data-name=\"Services text group\">\n                                    <h2 class=\"[font-family:'Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold text-[#F8FAFC]\" data-kid=\"2-1-3-2-2-2-1-1-1-1\" data-name=\"Services heading\" id=\"services-heading\">\n                                        Servicios ofrecidos\n                                    </h2>\n                                    <p class=\"mt-1 text-[12px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-2-1-1-1-2\" data-name=\"Services subtext\">\n                                        Aparecerán como filtros en tu ficha pública.\n                                    </p>\n                                </div>\n                                <i class=\"ti ti-list-check text-[19px] text-[#38BDF8]\" data-kid=\"2-1-3-2-2-2-1-1-2\" data-name=\"Services icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"divide-y divide-[#334155]\" data-kid=\"2-1-3-2-2-2-1-2\" data-name=\"Services list\">\n                                <label class=\"flex min-h-[58px] items-center justify-between gap-4 py-3\" data-kid=\"2-1-3-2-2-2-1-2-1\" data-name=\"Oil change item\">\n                                    <span class=\"flex items-center gap-3 text-[13px] font-medium text-[#E2E8F