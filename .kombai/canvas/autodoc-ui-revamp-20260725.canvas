      "html": "<link data-kid=\"1\" data-name=\"Tabler icon stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .font-body { font-family: 'IBM Plex Sans', sans-serif; }\n</style>\n<style data-name=\"AutoDoc shared component treatment\">\n    :root { --app-primary: #522C81; --app-surface-container: #EEEDF0; --app-outline: #CBD5E1; --app-on-primary: #FFFFFF; --app-shadow-sm: 0 2px 4px rgba(15,23,42,0.05); --app-shadow-hover: 0 6px 14px rgba(15,23,42,0.10); }\n  button { min-height: 48px; border-radius: 999px !important; transition: transform 150ms cubic-bezier(0.23,1,0.32,1), box-shadow 150ms cubic-bezier(0.23,1,0.32,1), background-color 150ms cubic-bezier(0.23,1,0.32,1), border-color 150ms cubic-bezier(0.23,1,0.32,1), color 150ms cubic-bezier(0.23,1,0.32,1); }\n  button:active { transform: scale(0.97); }\n  button:focus-visible { outline: 3px solid rgba(82,44,129,0.35); outline-offset: 2px; }\n  button[class*=\"bg-[#1E88E5]\"], button[class*=\"bg-[#38BDF8]\"] { background: var(--app-primary) !important; color: var(--app-on-primary) !important; box-shadow: var(--app-shadow-sm); }\n  button[class*=\"border-[#1E88E5]\"], button[class*=\"border-[#38BDF8]\"] { border-color: var(--app-primary) !important; color: var(--app-primary) !important; }\n  button[class*=\"bg-\"]:hover, button[class*=\"border-\"]:hover { box-shadow: var(--app-shadow-hover); }\n  button[aria-label] { min-width: 48px; min-height: 48px; padding: 0.75rem; border: 1px solid var(--app-outline) !important; background: var(--app-surface-container) !important; box-shadow: var(--app-shadow-sm); }\n  main section { border: 1px solid rgba(203,213,225,0.70); border-radius: 16px; background: var(--app-surface-container); box-shadow: var(--app-shadow-sm); overflow: hidden; }\n</style>\n<div class=\"font-body min-h-screen bg-[#F8FAFC] text-[#0F172A] antialiased\" data-kid=\"2\" data-name=\"employees page root\">\n    <div class=\"flex min-h-screen\" data-kid=\"2-1\" data-name=\"workshop application shell\">\n        <aside class=\"flex w-[72px] shrink-0 flex-col items-center bg-[#0F172A] px-3 py-5 text-white\" data-kid=\"2-1-1\" data-name=\"workshop icon rail\">\n            <div aria-label=\"AutoDoc\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[18px] font-heading font-extrabold tracking-[-0.08em]\" data-kid=\"2-1-1-1\" data-name=\"AutoDoc logo\">\n                AD\n            </div>\n            <div class=\"mt-8 flex flex-1 flex-col items-center gap-3\" data-kid=\"2-1-1-2\" data-name=\"primary rail navigation\">\n                <button aria-label=\"Panel del taller\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard rail button\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Reparaciones\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-2\" data-name=\"repairs rail button\">\n                    <i class=\"ti ti-tool\" data-kid=\"2-1-1-2-2-1\" data-name=\"tools icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Empleados\" class=\"grid size-11 place-items-center rounded-xl bg-[#1E88E5] text-[20px] text-white\" data-kid=\"2-1-1-2-3\" data-name=\"employees rail button\">\n                    <i class=\"ti ti-users\" data-kid=\"2-1-1-2-3-1\" data-name=\"users icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Buscar vehículo\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-4\" data-name=\"vehicle search rail button\">\n                    <i class=\"ti ti-search\" data-kid=\"2-1-1-2-4-1\" data-name=\"search icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Conversaciones\" class=\"grid size-11 place-items-center rounded-xl text-[20px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-2-5\" data-name=\"chat rail button\">\n                    <i class=\"ti ti-message-circle\" data-kid=\"2-1-1-2-5-1\" data-name=\"message icon\" style=\"width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex flex-col items-center gap-3 border-t border-[#334155] pt-4\" data-kid=\"2-1-1-3\" data-name=\"utility rail navigation\">\n                <button aria-label=\"Ayuda\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-1\" data-name=\"help rail button\">\n                    <i class=\"ti ti-help-circle\" data-kid=\"2-1-1-3-1-1\" data-name=\"help icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n                <button aria-label=\"Configuración\" class=\"grid size-10 place-items-center rounded-xl text-[19px] text-[#94A3B8] hover:bg-[#1E293B] hover:text-white\" data-kid=\"2-1-1-3-2\" data-name=\"settings rail button\">\n                    <i class=\"ti ti-settings\" data-kid=\"2-1-1-3-2-1\" data-name=\"settings icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n        <aside class=\"flex w-[220px] shrink-0 flex-col border-r border-[#CBD5E1] bg-white px-5 py-6\" data-kid=\"2-1-2\" data-name=\"workshop contextual sidebar\">\n            <div class=\"mb-8\" data-kid=\"2-1-2-1\" data-name=\"workshop identity header\">\n                <p class=\"font-heading text-[12px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-1-1\" data-name=\"role label\">\n                    Taller\n                </p>\n                <div class=\"mt-2 flex items-center gap-2\" data-kid=\"2-1-2-1-2\" data-name=\"workshop name status\">\n                    <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-2-1-2-1\" data-name=\"active workshop dot\">\n                    </span>\n                    <span class=\"text-[13px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-1-2-2\" data-name=\"workshop name\">\n                        Taller Rápido\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[11px] text-[#64748B]\" data-kid=\"2-1-2-1-3\" data-name=\"workshop status text\">\n                    Operación activa\n                </p>\n            </div>\n            <nav aria-label=\"Navegación del taller\" class=\"flex flex-col gap-1\" data-kid=\"2-1-2-2\" data-name=\"workshop primary navigation\">\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-1\" data-name=\"panel navigation link\" href=\"#panel\">\n                    <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"2-1-2-2-1-1\" data-name=\"dashboard icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-2-2-1-2\">\n                        Panel\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-2\" data-name=\"repairs navigation link\" href=\"#reparaciones\">\n                    <i class=\"ti ti-tool text-[17px]\" data-kid=\"2-1-2-2-2-1\" data-name=\"tools icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-2-2-2-2\">\n                        Reparaciones\n                    </span>\n                    <span class=\"ml-auto text-[11px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-2-2-3\" data-name=\"repairs count badge\">\n                        04\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-3\" data-name=\"search navigation link\" href=\"#buscar\">\n                    <i class=\"ti ti-search text-[17px]\" data-kid=\"2-1-2-2-3-1\" data-name=\"search icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-2-2-3-2\">\n                        Buscar vehículo\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-4\" data-name=\"history navigation link\" href=\"#historial\">\n                    <i class=\"ti ti-history text-[17px]\" data-kid=\"2-1-2-2-4-1\" data-name=\"history icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-2-2-4-2\">\n                        Historial\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-transparent px-3 py-2.5 text-[14px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-2-5\" data-name=\"reviews navigation link\" href=\"#resenas\">\n                    <i class=\"ti ti-star text-[17px]\" data-kid=\"2-1-2-2-5-1\" data-name=\"star icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-2-2-5-2\">\n                        Reseñas\n                    </span>\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-3\" data-name=\"workshop management navigation\">\n                <p class=\"mb-2 px-3 text-[11px] font-semibold text-[#64748B]\" data-kid=\"2-1-2-3-1\" data-name=\"management section label\">\n                    Gestión\n                </p>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-3-2\" data-name=\"catalog navigation link\" href=\"#catalogo\">\n                    <i class=\"ti ti-list-details text-[17px] text-[#1E88E5]\" data-kid=\"2-1-2-3-2-1\" data-name=\"list details icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-2-3-2-2\">\n                        Catálogo\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 border-l-[3px] border-[#1E88E5] bg-[#E8F2FD] px-3 py-2.5 text-[13px] font-semibold text-[#1E88E5]\" data-kid=\"2-1-2-3-3\" data-name=\"active employees navigation link\" href=\"#empleados\">\n                    <i class=\"ti ti-users text-[17px]\" data-kid=\"2-1-2-3-3-1\" data-name=\"users icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-2-3-3-2\">\n                        Empleados\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 px-3 py-2.5 text-[13px] font-medium text-[#64748B] hover:bg-[#F8FAFC] hover:text-[#0F172A]\" data-kid=\"2-1-2-3-4\" data-name=\"settings navigation link\" href=\"#configuracion\">\n                    <i class=\"ti ti-settings text-[17px]\" data-kid=\"2-1-2-3-4-1\" data-name=\"settings icon\" style=\"width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                    <span data-kid=\"2-1-2-3-4-2\">\n                        Configuración\n                    </span>\n                </a>\n            </div>\n            <div class=\"mt-5 border-t border-[#E2E8F0] pt-5\" data-kid=\"2-1-2-4\" data-name=\"workshop user profile\">\n                <div class=\"flex items-center gap-3\" data-kid=\"2-1-2-4-1\" data-name=\"current workshop user\">\n                    <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-2-4-1-1\" data-name=\"manager avatar\">\n                        MR\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"2-1-2-4-1-2\" data-name=\"manager profile text\">\n                        <p class=\"truncate text-[12px] font-semibold text-[#0F172A]\" data-kid=\"2-1-2-4-1-2-1\">\n                            María Rodríguez\n                        </p>\n                        <p class=\"truncate text-[11px] text-[#64748B]\" data-kid=\"2-1-2-4-1-2-2\">\n                            Administradora\n                        </p>\n                    </div>\n                    <i class=\"ti ti-chevron-down ml-auto text-[16px] text-[#94A3B8]\" data-kid=\"2-1-2-4-1-3\" data-name=\"chevron down icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"2-1-3\" data-name=\"employees main content\">\n            <header class=\"flex h-[76px] items-center justify-between border-b border-[#CBD5E1] bg-white px-8\" data-kid=\"2-1-3-1\" data-name=\"top header\">\n                <div class=\"flex items-center gap-3 text-[13px]\" data-kid=\"2-1-3-1-1\" data-name=\"breadcrumb group\">\n                    <span class=\"text-[#64748B]\" data-kid=\"2-1-3-1-1-1\">\n                        Taller\n                    </span>\n                    <span class=\"text-[#CBD5E1]\" data-kid=\"2-1-3-1-1-2\">\n                        /\n                    </span>\n                    <span class=\"font-semibold text-[#0F172A]\" data-kid=\"2-1-3-1-1-3\">\n                        Empleados\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-1-2\" data-name=\"header controls\">\n                    <span class=\"hidden text-[12px] text-[#64748B] lg:block\" data-kid=\"2-1-3-1-2-4\" data-name=\"current date text\">\n                        Sábado, 25 jul 2026\n                    </span>\n                    <button aria-label=\"Notificaciones\" class=\"relative grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-1\" data-name=\"notifications button\">\n                        <i class=\"ti ti-bell\" data-kid=\"2-1-3-1-2-1-1\" data-name=\"bell icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"absolute right-[7px] top-[6px] size-2 rounded-full border-2 border-white bg-[#EF4444]\" data-kid=\"2-1-3-1-2-1-2\" data-name=\"notifications dot\">\n                        </span>\n                    </button>\n                    <button aria-label=\"Cambiar a modo oscuro\" class=\"grid size-9 place-items-center rounded-lg text-[19px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-1-2-2\" data-name=\"theme toggle button\">\n                        <i class=\"ti ti-moon\" data-kid=\"2-1-3-1-2-2-1\" data-name=\"moon icon\" style=\"width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </button>\n                    <div class=\"h-6 w-px bg-[#E2E8F0]\" data-kid=\"2-1-3-1-2-7\">\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-1-3-1-2-3\" data-name=\"header user identity\">\n                        <div class=\"grid size-9 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-1-2-3-1\" data-name=\"user avatar\">\n                            MR\n                        </div>\n                        <span class=\"hidden text-[13px] font-semibold text-[#0F172A] xl:block\" data-kid=\"2-1-3-1-2-3-2\">\n                            María Rodríguez\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1160px] px-8 py-8\" data-kid=\"2-1-3-2\" data-name=\"employees page body\">\n                <div class=\"mb-7 flex items-end justify-between gap-6\" data-kid=\"2-1-3-2-1\" data-name=\"page heading row\">\n                    <div data-kid=\"2-1-3-2-1-1\" data-name=\"page title group\">\n                        <h1 class=\"font-heading text-[32px] font-extrabold tracking-[-0.045em] text-[#0F172A]\" data-kid=\"2-1-3-2-1-1-1\">\n                            Equipo del taller\n                        </h1>\n                        <p class=\"mt-2 text-[15px] text-[#334155]\" data-kid=\"2-1-3-2-1-1-2\">\n                            Administra quién puede trabajar en las reparaciones.\n                        </p>\n                    </div>\n                    <button class=\"inline-flex items-center gap-2 bg-[#1E88E5] px-4 py-2.5 text-[13px] font-semibold text-white hover:bg-[#176FBB]\" data-kid=\"2-1-3-2-1-2\" data-name=\"invite employee button\">\n                        <i class=\"ti ti-user-plus text-[16px]\" data-kid=\"2-1-3-2-1-2-1\" data-name=\"user plus icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        Invitar empleado\n                    </button>\n                </div>\n                <div class=\"mb-5 flex items-center justify-between gap-4 border-y border-[#CBD5E1] bg-white px-4 py-3\" data-kid=\"2-1-3-2-2\" data-name=\"employees toolbar\">\n                    <label class=\"flex min-w-0 flex-1 items-center gap-3 text-[13px] text-[#64748B]\" data-kid=\"2-1-3-2-2-1\" data-name=\"employee search field\">\n                        <i class=\"ti ti-search text-[18px] text-[#94A3B8]\" data-kid=\"2-1-3-2-2-1-1\" data-name=\"search icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                        <span class=\"sr-only\" data-kid=\"2-1-3-2-2-1-2\">\n                            Buscar empleado\n                        </span>\n                        <span data-kid=\"2-1-3-2-2-1-3\">\n                            Buscar empleado\n                        </span>\n                    </label>\n                    <div class=\"flex items-center gap-5\" data-kid=\"2-1-3-2-2-2\" data-name=\"employee toolbar metadata\">\n                        <span class=\"text-[12px] font-medium text-[#64748B]\" data-kid=\"2-1-3-2-2-2-2\" data-name=\"employee count text\">\n                            3 miembros\n                        </span>\n                        <button class=\"inline-flex items-center gap-2 border border-[#CBD5E1] bg-white px-3 py-2 text-[12px] font-semibold text-[#334155]\" data-kid=\"2-1-3-2-2-2-1\" data-name=\"role filter button\">\n                            <i class=\"ti ti-adjustments-horizontal text-[15px] text-[#1E88E5]\" data-kid=\"2-1-3-2-2-2-1-1\" data-name=\"adjustments icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Todos los roles\n                            <i class=\"ti ti-chevron-down text-[14px] text-[#64748B]\" data-kid=\"2-1-3-2-2-2-1-2\" data-name=\"chevron down icon\" style=\"width:14px;height:14px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"mb-3 flex items-center justify-between\" data-kid=\"2-1-3-2-3\" data-name=\"table introduction\">\n                    <div data-kid=\"2-1-3-2-3-1\">\n                        <h2 class=\"font-heading text-[20px] font-bold tracking-[-0.03em] text-[#0F172A]\" data-kid=\"2-1-3-2-3-1-1\">\n                            Personas con acceso\n                        </h2>\n                        <p class=\"mt-1 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-3-1-2\">\n                            Solo el propietario y la administración pueden gestionar permisos.\n                        </p>\n                    </div>\n                    <span class=\"inline-flex items-center gap-2 text-[12px] font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-3-2\" data-name=\"operation active status\">\n                        <span class=\"size-2 rounded-full bg-[#10B981]\" data-kid=\"2-1-3-2-3-2-1\">\n                        </span>\n                        Operación activa\n                    </span>\n                </div>\n                <section class=\"overflow-hidden border-y border-[#CBD5E1] bg-white\" data-kid=\"2-1-3-2-4\" data-name=\"employees data table\">\n                    <div class=\"grid grid-cols-[minmax(0,1.6fr)_180px_170px_170px_64px] items-center gap-4 border-b border-[#CBD5E1] bg-[#EDF2F7] px-5 py-3 text-[10px] font-bold uppercase tracking-[0.13em] text-[#64748B]\" data-kid=\"2-1-3-2-4-1\" data-name=\"employee table header\">\n                        <span data-kid=\"2-1-3-2-4-1-1\">\n                            Usuario\n                        </span>\n                        <span data-kid=\"2-1-3-2-4-1-2\">\n                            Rol\n                        </span>\n                        <span data-kid=\"2-1-3-2-4-1-3\">\n                            Estado\n                        </span>\n                        <span data-kid=\"2-1-3-2-4-1-4\">\n                            Último acceso\n                        </span>\n                        <span class=\"text-right\" data-kid=\"2-1-3-2-4-1-5\">\n                            Acciones\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-[minmax(0,1.6fr)_180px_170px_170px_64px] items-center gap-4 border-b border-[#E2E8F0] px-5 py-4 text-[13px]\" data-kid=\"2-1-3-2-4-2\" data-name=\"active administrator employee row\">\n                        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-3-2-4-2-1\">\n                            <div class=\"grid size-9 shrink-0 place-items-center rounded-full bg-[#DBEAFE] text-[12px] font-bold text-[#1E88E5]\" data-kid=\"2-1-3-2-4-2-1-1\" data-name=\"manager avatar\">\n                                MR\n                            </div>\n                            <div class=\"min-w-0\" data-kid=\"2-1-3-2-4-2-1-2\">\n                                <p class=\"truncate font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-2-1-2-1\">\n                                    María Rodríguez\n                                </p>\n                                <p class=\"truncate text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-4-2-1-2-2\">\n                                    maria.rodriguez@tallerrapido.co\n                                </p>\n                            </div>\n                        </div>\n                        <span class=\"font-medium text-[#334155]\" data-kid=\"2-1-3-2-4-2-2\">\n                            Administradora\n                        </span>\n                        <span class=\"flex items-center gap-2 font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-4-2-3\">\n                            <i class=\"ti ti-circle-check text-[16px]\" data-kid=\"2-1-3-2-4-2-3-1\" data-name=\"check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Activa\n                        </span>\n                        <span class=\"text-[#64748B]\" data-kid=\"2-1-3-2-4-2-4\">\n                            Hoy, 08:32\n                        </span>\n                        <button aria-label=\"Más acciones para María Rodríguez\" class=\"justify-self-end grid size-9 place-items-center rounded-lg text-[18px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-2-4-2-5\" data-name=\"actions button\">\n                            <i class=\"ti ti-dots-vertical\" data-kid=\"2-1-3-2-4-2-5-1\" data-name=\"vertical dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"grid grid-cols-[minmax(0,1.6fr)_180px_170px_170px_64px] items-center gap-4 border-b border-[#E2E8F0] px-5 py-4 text-[13px]\" data-kid=\"2-1-3-2-4-3\" data-name=\"active mechanic employee row\">\n                        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-3-2-4-3-1\">\n                            <div class=\"grid size-9 shrink-0 place-items-center rounded-full bg-[#E0F2FE] text-[12px] font-bold text-[#0284C7]\" data-kid=\"2-1-3-2-4-3-1-1\" data-name=\"mechanic avatar\">\n                                CM\n                            </div>\n                            <div class=\"min-w-0\" data-kid=\"2-1-3-2-4-3-1-2\">\n                                <p class=\"truncate font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-3-1-2-1\">\n                                    Carlos Méndez\n                                </p>\n                                <p class=\"truncate text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-4-3-1-2-2\">\n                                    carlos.mendez@tallerrapido.co\n                                </p>\n                            </div>\n                        </div>\n                        <span class=\"font-medium text-[#334155]\" data-kid=\"2-1-3-2-4-3-2\">\n                            Mecánico\n                        </span>\n                        <span class=\"flex items-center gap-2 font-semibold text-[#10B981]\" data-kid=\"2-1-3-2-4-3-3\">\n                            <i class=\"ti ti-circle-check text-[16px]\" data-kid=\"2-1-3-2-4-3-3-1\" data-name=\"check icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Activo\n                        </span>\n                        <span class=\"text-[#64748B]\" data-kid=\"2-1-3-2-4-3-4\">\n                            Hoy, 07:54\n                        </span>\n                        <button aria-label=\"Más acciones para Carlos Méndez\" class=\"justify-self-end grid size-9 place-items-center rounded-lg text-[18px] text-[#64748B] hover:bg-[#F1F5F9] hover:text-[#0F172A]\" data-kid=\"2-1-3-2-4-3-5\" data-name=\"actions button\">\n                            <i class=\"ti ti-dots-vertical\" data-kid=\"2-1-3-2-4-3-5-1\" data-name=\"vertical dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"grid grid-cols-[minmax(0,1.6fr)_180px_170px_170px_64px] items-center gap-4 bg-[#FFFBEB] px-5 py-4 text-[13px]\" data-kid=\"2-1-3-2-4-4\" data-name=\"pending invitation row\">\n                        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"2-1-3-2-4-4-1\">\n                            <div class=\"grid size-9 shrink-0 place-items-center rounded-full border border-dashed border-[#F59E0B] text-[12px] font-bold text-[#B45309]\" data-kid=\"2-1-3-2-4-4-1-1\" data-name=\"pending avatar\">\n                                CL\n                            </div>\n                            <div class=\"min-w-0\" data-kid=\"2-1-3-2-4-4-1-2\">\n                                <p class=\"truncate font-semibold text-[#0F172A]\" data-kid=\"2-1-3-2-4-4-1-2-1\">\n                                    Carlos López\n                                </p>\n                                <p class=\"truncate text-[12px] text-[#92400E]\" data-kid=\"2-1-3-2-4-4-1-2-2\">\n                                    Invitación enviada ayer · carlos.lopez@tallerrapido.co\n                                </p>\n                            </div>\n                        </div>\n                        <span class=\"font-medium text-[#334155]\" data-kid=\"2-1-3-2-4-4-2\">\n                            Técnico\n                        </span>\n                        <span class=\"flex items-center gap-2 font-semibold text-[#B45309]\" data-kid=\"2-1-3-2-4-4-3\">\n                            <i class=\"ti ti-clock text-[16px]\" data-kid=\"2-1-3-2-4-4-3-1\" data-name=\"clock icon\" style=\"width:16px;height:16px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                            Pendiente\n                        </span>\n                        <span class=\"text-[#92400E]\" data-kid=\"2-1-3-2-4-4-4\">\n                            Sin acceso\n                        </span>\n                        <button aria-label=\"Más acciones para Carlos López\" class=\"justify-self-end grid size-9 place-items-center rounded-lg text-[18px] text-[#92400E] hover:bg-[#FEF3C7] hover:text-[#78350F]\" data-kid=\"2-1-3-2-4-4-5\" data-name=\"actions button\">\n                            <i class=\"ti ti-dots-vertical\" data-kid=\"2-1-3-2-4-4-5-1\" data-name=\"vertical dots icon\" style=\"width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"flex items-center justify-between border-t border-[#E2E8F0] px-5 py-3 text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-4-5\" data-name=\"table footer\">\n                        <span data-kid=\"2-1-3-2-4-5-1\">\n                            Mostrando 3 de 3 empleados\n                        </span>\n                        <span class=\"text-[#94A3B8]\" data-kid=\"2-1-3-2-4-5-2\">\n                            Última actualización hace 4 min\n                        </span>\n                    </div>\n                </section>\n                <div class=\"mt-5 flex items-center justify-between\" data-kid=\"2-1-3-2-5\" data-name=\"employees pagination and empty hint\">\n                    <p class=\"text-[12px] text-[#64748B]\" data-kid=\"2-1-3-2-5-1\">\n                        ¿No encuentras a una persona? Ajusta el filtro o envía una nueva invitación.\n                    </p>\n                    <div class=\"flex items-center gap-1\" data-kid=\"2-1-3-2-5-2\">\n                        <button aria-label=\"Página anterior\" class=\"grid size-9 place-items-center border border-[#CBD5E1] text-[15px] text-[#94A3B8]\" data-kid=\"2-1-3-2-5-2-1\" data-name=\"previous page button\">\n                            <i class=\"ti ti-chevron-left\" data-kid=\"2-1-3-2-5-2-1-1\" data-name=\"left chevron icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                        <button aria-label=\"Página 1\" class=\"grid size-9 place-items-center bg-[#1E88E5] text-[12px] font-bold text-white\" data-kid=\"2-1-3-2-5-2-2\" data-name=\"page 1 button\">\n                            1\n                        </button>\n                        <button aria-label=\"Página siguiente\" class=\"grid size-9 place-items-center border border-[#CBD5E1] text-[15px] text-[#64748B]\" data-kid=\"2-1-3-2-5-2-3\" data-name=\"next page button\">\n                            <i class=\"ti ti-chevron-right\" data-kid=\"2-1-3-2-5-2-3-1\" data-name=\"right chevron icon\" style=\"width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <p class=\"mt-8 pb-2 text-[11px] text-[#94A3B8]\" data-kid=\"2-1-3-2-6\" data-name=\"footer copy\">\n                    AutoDoc · Gestión operativa del taller · Datos sincronizados con tu equipo\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
